# Keeps files and folders out of the Docker build context, so the build is
# faster and the image carries nothing it does not need.

# Files generated by Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django files
*.log
*.pot
*.pyc
db.sqlite3
media/

# Environment and local configuration files
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
local_settings.py

# System files
.DS_Store
Thumbs.db

# Development and IDE files
.idea/
.vscode/
*.swp
*.swo
.project
.pydevproject
.settings/

# Git files
.git
.gitignore
.gitattributes

# Docker files
.dockerignore

# Other files
*.bak
*.tmp

# Large data sets and files the build does not need
itemscraper/raw/
itemscraper/spell_images/
itemscraper/spell_icons_test/
migrated_data.json
logs/

# Generated artifacts
fashionsite/staticfiles/

# Large local environments
.venv/

# Full-size Dofus 3 and beta icons are only inputs to resize_images.py; the
# container serves the 60x60 subfolders, which these patterns leave in place.
fashionsite/chardata/static/chardata/items/*.png
fashionsite/chardata/static/chardata/items/beta/*.png
fashionsite/chardata/static/chardata/pets/*.png
fashionsite/chardata/static/chardata/pets/beta/*.png

# Git metadata
.git/
