INSERT INTO "item_descriptions" VALUES(13805,'de','Als Erster zu handeln, bedeutet auch die erste Dummheit zu begehen, als Idiot abgestempelt zu werden, als Hauptziel unerkannt zu bleiben, als letzter zu sterben und schließlich als Held gefeiert zu werden.');
INSERT INTO "item_descriptions" VALUES(13806,'de','Als Erster zu handeln, bedeutet auch die erste Dummheit zu begehen, als Idiot abgestempelt zu werden, als Hauptziel unerkannt zu bleiben, als letzter zu sterben und schließlich als Held gefeiert zu werden.');
INSERT INTO "item_descriptions" VALUES(13807,'de','Als Erster zu handeln, bedeutet auch die erste Dummheit zu begehen, als Idiot abgestempelt zu werden, als Hauptziel unerkannt zu bleiben, als letzter zu sterben und schließlich als Held gefeiert zu werden.');
INSERT INTO "item_descriptions" VALUES(13808,'de','Mit dieser Trophäe verliert ihr nie den Boden, oder besser gesagt die Erde unter den Füßen.');
INSERT INTO "item_descriptions" VALUES(13809,'de','Mit dieser Trophäe verliert ihr nie den Boden, oder besser gesagt die Erde unter den Füßen.');
INSERT INTO "item_descriptions" VALUES(13810,'de','Mit dieser Trophäe verliert ihr nie den Boden, oder besser gesagt die Erde unter den Füßen.');
INSERT INTO "item_descriptions" VALUES(13811,'de','Diese Trophäe hindert euch daran, Kampfentscheidungen zu treffen und senkt die Verletzungsgefahr, wenn ihr versucht einen Zauber zu wirken.');
INSERT INTO "item_descriptions" VALUES(13812,'de','Diese Trophäe hindert euch daran, Kampfentscheidungen zu treffen und senkt die Verletzungsgefahr, wenn ihr versucht einen Zauber zu wirken.');
INSERT INTO "item_descriptions" VALUES(13813,'de','Diese Trophäe hindert euch daran, Kampfentscheidungen zu treffen und senkt die Verletzungsgefahr, wenn ihr versucht einen Zauber zu wirken.');
INSERT INTO "item_descriptions" VALUES(13814,'de','Mit dieser Trophäe könnt ihr stets die Eisen aus dem Feuer holen.');
INSERT INTO "item_descriptions" VALUES(13815,'de','Mit dieser Trophäe könnt ihr stets die Eisen aus dem Feuer holen.');
INSERT INTO "item_descriptions" VALUES(13816,'de','Mit dieser Trophäe könnt ihr stets die Eisen aus dem Feuer holen.');
INSERT INTO "item_descriptions" VALUES(13817,'de','Mit dieser Trophäe werdet ihr wohl nie baden gehen.');
INSERT INTO "item_descriptions" VALUES(13818,'de','Mit dieser Trophäe werdet ihr wohl nie baden gehen.');
INSERT INTO "item_descriptions" VALUES(13819,'de','Mit dieser Trophäe werdet ihr wohl nie baden gehen.');
INSERT INTO "item_descriptions" VALUES(13820,'de','Mit dieser Trophäe geht euch nie die Luft aus.');
INSERT INTO "item_descriptions" VALUES(13821,'de','Mit dieser Trophäe geht euch nie die Luft aus');
INSERT INTO "item_descriptions" VALUES(13822,'de','Mit dieser Trophäe geht euch nie die Luft aus.');
INSERT INTO "item_descriptions" VALUES(13823,'de','Die Werbung für diese Trophäe ist unmissverständlich: "Fühlt ihr euch machtlos? Dann holt euch jetzt, für nur eine Handvoll Kamas, eure verlorengegangene Macht wieder!"
Nicht für Jedermann geeignet!');
INSERT INTO "item_descriptions" VALUES(13824,'de','Die Werbung für diese Trophäe ist unmissverständlich: "Fühlt ihr euch machtlos? Dann holt euch jetzt, für nur eine Handvoll Kamas, eure verlorengegangene Macht wieder!"
Nicht für Jedermann geeignet!');
INSERT INTO "item_descriptions" VALUES(13825,'de','Die Werbung für diese Trophäe ist unmissverständlich: "Fühlt ihr euch machtlos? Dann holt euch jetzt, für nur eine Handvoll Kamas, eure verlorengegangene Macht wieder!"
Nicht für Jedermann geeignet!');
INSERT INTO "item_descriptions" VALUES(13826,'de','Eure Feinde können sich an dem Nachgeschmack von altem Rost erfreuen, wenn sie sich die Zähne daran auszubeißen.');
INSERT INTO "item_descriptions" VALUES(13827,'de','Eure Feinde können sich an dem Nachgeschmack von altem Rost erfreuen, wenn sie sich die Zähne daran auszubeißen.');
INSERT INTO "item_descriptions" VALUES(13828,'de','Eure Feinde können sich an dem Nachgeschmack von altem Rost erfreuen, wenn sie sich die Zähne daran auszubeißen.');
INSERT INTO "item_descriptions" VALUES(13829,'de','Auf dem Pausenhof ward ihr der WuWulf, der die Piepmätzchen verschlang. Ihr habt Oh''Neins Liedtext in die Kirchenbank von Amakna geritzt. Ihr habt Schwächere und Kleinere in den Brunnen von Madrestam geschubst. Ihr habt Feenwerks-Körper und kleine unschuldige Tierchen in die Astruber Müllereimer geworfen und diese anschließend angezündet. Diese Trophäe ist euer neues Spielzeug!');
INSERT INTO "item_descriptions" VALUES(13830,'de','Mit dieser Trophäe findet ihr die Kraft, erwachsen zu werden und euer wohlbehütetes Familiennest zu verlassen. Nächster Schritt: Kochen lernen, außer Nudeln natürlich!');
INSERT INTO "item_descriptions" VALUES(13831,'de','Mit dieser Trophäe entgeht euch nichts, noch nicht einmal der kleinste Blobfett-Fleck auf dem Hemd des Feindes, der sich in einem Loch hinter einem Busch am anderen Ende des Hügels, der seinerseits im Nebel versinkt, versteckt hält!');
INSERT INTO "item_descriptions" VALUES(13832,'de','Dank dieser Trophäe werden sich eure Feinde schluchzend in Sicherheit bringen. Ihnen wird nämlich schnell klar, dass ihr zu allem bereit seid, vor allem aber zum Allerschlimmsten.');
INSERT INTO "item_descriptions" VALUES(13833,'de','Dank dieser Trophäe werden sich eure Feinde schluchzend in Sicherheit bringen. Ihnen wird nämlich schnell klar, dass ihr zu allem bereit seid, vor allem aber zum Allerschlimmsten.');
INSERT INTO "item_descriptions" VALUES(13834,'de','Dank dieser Trophäe werden sich eure Feinde schluchzend in Sicherheit bringen. Ihnen wird nämlich schnell klar, dass ihr zu allem bereit seid, vor allem aber zum Allerschlimmsten.');
INSERT INTO "item_descriptions" VALUES(13848,'de','Endlich mal ein ordentliches Messer, das sogar schärfer ist als ihr. Einer Legende nach, soll es die Miesen Muscheln gezwungen haben, sich noch weiter zu öffnen. Sie schenken euch also ihren größten Schatz, und zwar die Seelenperlen, die sie auf dem Meeresgrund aufgesammelt haben. Wenn ihr schon immer davon geträumt habt, einen dicken Fisch an Land zuziehen, dann bewaffnet euch mit diesem Messer und macht euch auf die Jagd von Miesen Muscheln... ihr werdet es bestimmt nicht bereuen.');
INSERT INTO "item_descriptions" VALUES(13850,'de','Die Bandenmitglieder der Schwarzen Hornisse sollen so ähnliche Masken getragen haben, wie diese. Die finsteren Gesellen der Bande wurden beschuldigt, schlimmste Untaten begangen zu haben, unter anderem gemeinschaftliche Entführungen, Zerstörungen von Brücken, Schatzfälschungen oder gar ohrenbetäubendes Gesumme. Die Gründe für diese Taten bleiben allerdings im Dunkeln.');
INSERT INTO "item_descriptions" VALUES(13851,'de','Dank ihrer Gürtel konnten sich die Schwarzen Hornissen bei Ankunft der Miliz schnurstracks aus dem Staub machen. Dadurch waren sie schier unaufhaltsam! 
Ohne diesen Gürtel hatten es andere Banditen schwer... Erst verloren sie die Hose, dann die Bewegungsfreiheit und schließlich ihre gesamte Freiheit!');
INSERT INTO "item_descriptions" VALUES(13891,'de','Die weniger gebildeten Bewohner Amaknas glauben, dass der Keisler als prähistorischer Vorfahre des Keilers eine ausgestorbene Spezies sei und es deshalb keine ethischen Probleme nach sich ziehe, wenn sie aus dessen Elfenbein Schmuck herstellen. Dieser Ring ist also ideal dafür geeignet, zu zeigen, dass ihr Frigost noch nie betreten habt und dass ihr ein wenig zurückgeblieben seid.');
INSERT INTO "item_descriptions" VALUES(13893,'de','Achtung! Lebensgefahr! Verwendet diese Keislerkruppe in Form eines Amuletts niemals als Gasmaske!');
INSERT INTO "item_descriptions" VALUES(13894,'de','Niemand weiß, wie dieser seltsame Stock zu dem dämlichen Namen kam, aber das ist ja auch unwichtig. Hauptsache der Stock beschert euch den Sieg und euren Gegnern ein(e) bittere(s) Ente...');
INSERT INTO "item_descriptions" VALUES(13896,'de','Diese Axt ist ideal, um für Recht und Ordnung zu sorgen. Besonders im Wilden Osten von Amakna wird sie daher gern eingesetzt. Meister im Umgang mit dieser Waffe erkennt man an einem silbrigen Metallstern, den sie oft tragen.');
INSERT INTO "item_descriptions" VALUES(13897,'de','Dieser seltsame Ring ist ein altes Erbstück. Allerdings wirkt er stets wie neu, da er selbsttätig seine Größe den Fingern des Trägers anpasst. Oder allgemein formuliert, den Gliedmaßen, an denen er getragen wird...');
INSERT INTO "item_descriptions" VALUES(14000,'de','Dieser Kopfschutz wurde von einem Schnitzer entworfen, der ein ausgesprochener Katzenfreund war und sich viele Jahre lang gegen Mitglieder des KEM, des Komitee zur Eindämmung der Maunzmiezen, gestellt hat. Am Ende wurde er schließlich von einem Mitglied von Ping-Freeze ermordet, der damit ein Zeichen gegen die Zerstörung des Lebensraumes der Pings setzen wollte...');
INSERT INTO "item_descriptions" VALUES(14001,'de','Augilol war ein durch und durch durchschnittlicher Allerweltssram, der seinem großen Idol, Ogivol, nacheifertie. Auf Frigost fand er stattdessen einen durch und durch durchschnittlichen und überhaupt nicht tragischen Tod. Nur dieser Umhang blieb von ihm übrig.');
INSERT INTO "item_descriptions" VALUES(14002,'de','Mit diesen Stiefeln zertrampelte Inferno seine Gegner und auch jede Form guter Manieren!');
INSERT INTO "item_descriptions" VALUES(14003,'de','Bei seinem Aufnahmeritual wurde Styx in einen Fluss getaucht. Sein Überleben verdankt er seinen Stiefeln, die problemlos an seinen Füßen blieben, als Taytisse ihn daran aus dem Wasser zog.');
INSERT INTO "item_descriptions" VALUES(14004,'de','Diese Stiefel sollen einst seinem Träger ermöglicht haben, sich an 7 Orten gleichzeitig aufzuhalten. Kein Wunder, dass Mandrin so spielend leicht mit den Perzeptauren von Konkurrenzgilden fertiggeworden ist!');
INSERT INTO "item_descriptions" VALUES(14005,'de','Wie jeder weiß, hat jeder große Kämpfe seine Tricks und Geheimwaffen. Auch Will Killson hat seine und zwar eine an jedem Fuß!');
INSERT INTO "item_descriptions" VALUES(14006,'de','Dieser Ring gehörte einst der schönsten Azubine Infernos. Sie starb gleich zweimal, mit Verbrennungen dritten Grades in der vierten Dimension des fünften Elements beim Blick in die lodernden Augen ihres Meisters.');
INSERT INTO "item_descriptions" VALUES(14007,'de','Zwei sauber abgeschnittene Finger. Das war Styx Strafe dafür, dass er diesen Ring gestohlen hatte!');
INSERT INTO "item_descriptions" VALUES(14008,'de','Als der Schädel eines Perzeptaurus dem Häckseln widerstand, legte Mandrin ihm diesen Ring um den Hals, um ihn zu erdrosseln.');
INSERT INTO "item_descriptions" VALUES(14009,'de','Keiner weiß, ob Will Killson diesen Ring von einem Kunden geschenkt bekam, oder ob er ihn einem Opfer abgenommen hatte. Aber eigentlich ist das ja auch ziemlich egal, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(14030,'de','Nachdem er von einem Steamer repariert wurde, der sich damit auszukennen schien, dürfte euch dieser Anzug vor den giftigen Schwefelgasen der Geo-Hochöfen schützen. Allerdings ist das Bullauge des Anzugs nahezu undurchsichtig. Es wäre daher eine schlechte Idee, in diesem Anzug kämpfen zu wollen oder ähnliche Aktivitäten zu unternehmen.');
INSERT INTO "item_descriptions" VALUES(14049,'de','Mit diesen Ring protzte einst Agnos herum, dessen Glaube nur sehr schwach ausgeprägt war. Er pflegte lauthals zu verkünden, er sei noch nie von den Göttern zu einem Treffen eingeladen worden und das sei der eindeutige Beweis, dass es sie gar nicht gäbe...');
INSERT INTO "item_descriptions" VALUES(14050,'de','R.Klimm hatte eindeutig einen Sinn für Mode. Aber ist es nicht normal, dass große Handwerksmeister seines Kalibers ein klein wenig exzentrisch sind?! Exzentrisch und sadistisch veranlagt. Niemand hat je R.Klimm ohne seine Maske gesehen - zumindest hat niemand davon berichten können. Jetzt fehlt nur noch, dass Carla Garfield ihrerseits damit anfängt, stets eine dunkle Sonnenbrille zu tragen...');
INSERT INTO "item_descriptions" VALUES(14051,'de','Ursprünglich war das Innenfutter dieses Umhangs gar nicht rot. Es hat nur etwas zu sehr auf dem Boden seines Hinterzimmers geschleift...');
INSERT INTO "item_descriptions" VALUES(14052,'de','Früher benutzte R.Klimm die Nadel an diesem Gürtel, um alles zusammenzunähen, was aufgegangen war. Jetzt ist es umgekehrt. R.Klimm geht auf, wenn er die Nadel mit etwas benutzen kann, was nicht zusammengehört.');
INSERT INTO "item_descriptions" VALUES(14053,'de','Diese Mütze zieht R.Klimm über, damit ihn die Schreie seiner Opfer im Hinterzimmer nicht taub machen. Schließlich muss man gut auf seine Gesundheit achtgeben, wenn man auch auf andere achtgeben möchte...');
INSERT INTO "item_descriptions" VALUES(14054,'de','Ihr wollt nicht wirklich wissen, zu welch finsteren Machenschaften dieser Ring bereits eingesetzt wurde und auch nicht an, an welchen Instrumenten er sich befand...');
INSERT INTO "item_descriptions" VALUES(14055,'de','Dieser Spaten hat die unangenehme Eigenschaft, jede Berührung mit Erdreich zu vermeiden, solange es sich nicht um echten Schlamm aus dem Assel-Meer handelt. So entstand übrigens auch die entsprechende Redewendung: "Tief im Asselschlamm stecken..."');
INSERT INTO "item_descriptions" VALUES(14056,'de','Seit seiner Ankunft auf Frigost schient R.Klimm weniger auf das Aussehen seiner Schuhmachererzeugnisse zu achten, als auf das magische Potential, das in ihnen steckt. An diesem Kriterium gemessen, sind diese Stiefel ein wahres Meisterwerk!');
INSERT INTO "item_descriptions" VALUES(14057,'de','Wenn ihr diesen Umhang tragt, läuft es euch ständig kalt den Rücken herunter...');
INSERT INTO "item_descriptions" VALUES(14058,'de','Sollten eure Hände noch nicht völlig durchgefroren sein, hilft euch dieser Ring!');
INSERT INTO "item_descriptions" VALUES(14059,'de','Man weiß zwar noch nicht genau wie dieser Gürtel funktioniert, aber er scheint besonders männliche Abenteurer dabei zu helfen, stets einen kühlen Kopf zu bewahren...');
INSERT INTO "item_descriptions" VALUES(14060,'de','Dieser Helm ist ein gutes Beispiel für Missiz Frizz großes Können als Schmiedmagierin. Er schützt so gut wie ein herkömmlicher Helm, ist aber sehr viel leichter und komfortabler!');
INSERT INTO "item_descriptions" VALUES(14061,'de','Nachdem Graf Primzahl so lange hat auf sich warten lassen, hat Missiz Frizz sich selbst diesen Ehering geschmiedet mit der Absicht ihn eifersüchtig zu machen. Leider ging ihr Plan nicht auf. Er hat ihn nämlich nicht einmal bemerkt!');
INSERT INTO "item_descriptions" VALUES(14062,'de','Auch wenn ihr nicht so stahlhart wie Missiz Frizz durchgreifen könnt, so sorgen diese Stiefel zumindest dafür, dass euch niemand mehr auf den Füßen herumtrampeln kann!');
INSERT INTO "item_descriptions" VALUES(14063,'de','Diese Kopfbedeckung wird von einer kriminellen Organisation mit Vorliebe an unbedarfte Touristen verkauft, denen man weismacht, das Tragen dieses Hutes sei Pflicht während der Passage nach Frigost. Sowas nennt man im Fachjargon: "Neue Märkte erschließen..."');
INSERT INTO "item_descriptions" VALUES(14064,'de','Links herum getragen kann Nilezas Umhang als Laborkittel dienen. Oder notfalls sogar als Sabberlätzchen...');
INSERT INTO "item_descriptions" VALUES(14065,'de','Das Symbol auf diesem Amulett spielt auf die fundamentale Bedeutung von Gleichgewichten in der Wissenschaft an. Nilezas geistiges Gleichgewicht wurde hingegen nicht erwähnt...');
INSERT INTO "item_descriptions" VALUES(14066,'de','Nilezas Stiefel gehören zu den Undurchlässigsten, die es gibt. Das ist auch bitter nötig, angesichts der Gefährlichkeit der Reagenzien, mit denen Nileza arbeitet. So eine Alchillusion am Fuß zu haben wäre wirklich ein echtes Ärgernis!');
INSERT INTO "item_descriptions" VALUES(14067,'de','Dieser Ring ist euch eindeutig zu groß. Außerdem kann er jeden Moment explodieren!');
INSERT INTO "item_descriptions" VALUES(14068,'de','Dieser Reif stört den elementaren Aufbau jeder Materie, mit der er in Berührung kommt. Also unterdrückt lieber euren Drang euch zu kratzen. Besonders an den sensiblen Körperteilen...');
INSERT INTO "item_descriptions" VALUES(14069,'de','Nein, dieser Gürtel ist nicht deshalb labil, weil er jeden Moment in die Luft gehen kann, die Schwerkraft verändert oder euch wahnsinnig macht. Er hält nur eure Hose nicht allzugut fest, das ist alles!');
INSERT INTO "item_descriptions" VALUES(14070,'de','Wenn man Sylargh seine Albernheiten, sein flegelhaftes Benehmen und seine Überheblichkeit nachsieht, dann nicht weil er diese Kapuze auf dem Kopf trägt, sondern vielmehr weil er noch ein Kind ist...');
INSERT INTO "item_descriptions" VALUES(14071,'de','In Wirklichkeit besaß Sylargh überhaupt keinen Mantel. Der wäre ihm nämlich mit Sicherheit viel zu lang, so dass er ständig darüber stolpern oder sich mit dem Mantel gar in seinen Räderwerken verwickeln würde. Nein, dies ist nichts anderes als seine Zudecke!');
INSERT INTO "item_descriptions" VALUES(14072,'de','Dieser Gürtel dient Sylargh eigentlich nicht als Gürtel, dafür wäre er nämlich viel zu weit. Es handelt sich vielmehr um eine Schnalle, die der Handwerksmeister als Universalhilfsmittel zum Basteln verwendet. 
Und ihr habt hierfür jetzt ein wahres Vermögen hingelegt...');
INSERT INTO "item_descriptions" VALUES(14073,'de','Mit den langen Zähnen und dem dicken Holzkopf steht euch der Hut wie angegossen!');
INSERT INTO "item_descriptions" VALUES(14074,'de','Hat euch denn noch niemand gefragt, ob dieser Umhang auch für Waschmaschinen geeignet sei?');
INSERT INTO "item_descriptions" VALUES(14075,'de','Ein einfaches Amulett wird leider nicht ausreichen, um aus euch eine wahre Höllenmaschine zu machen!');
INSERT INTO "item_descriptions" VALUES(14076,'de','Scheinbar hat noch nie jemand den Grafen ohne Hut zu Gesicht gekriegt. Nicht einmal vor der Eiszeit, wegen der er sich in seinen Turm zurückgezogen hatte. Was mag er nur unter seinem Hut verstecken?');
INSERT INTO "item_descriptions" VALUES(14077,'de','Mit diesem Ring war der Graf in der Lage, Energieüberschüsse behutsam nach und nach abzugeben, so dass diese Energie nicht außer Kontrolle geraten konnte. Bei euch gibt es da allerdings keine Energieüberschüsse, die außer Kontrolle geraten könnten...');
INSERT INTO "item_descriptions" VALUES(14078,'de','Im Unterschied zu seinem Schloss, seinem Geist, seiner Insel und seinen Monstern sind die Füße des Grafen das Einzige, das nicht durchgefrostet sind. Dank dieser Stiefel!');
INSERT INTO "item_descriptions" VALUES(14079,'de','Schwer vorstellbar, dass Graf Primzahl einmal diese Kopfbedeckung getragen haben soll, nicht wahr? Aber hat nicht jeder ein Anrecht darauf, irgendwann einmal eine rebellische Phase durchzumachen?');
INSERT INTO "item_descriptions" VALUES(14080,'de','Wie es scheint waren die Fortschritte im Bereich der Juwelierkunst ziemlich dürftig in den letzten Jahrhunderten...');
INSERT INTO "item_descriptions" VALUES(14081,'de','Dieser Gürtel ist einer der wenigen Ausrüstungsgegenstände, die der Graf vor und nach der Eiszeit trug... Der Verschluss ist nämlich zugefroren als Djaul seinen Fluch entfesselte. Daher kann der Graf den Gürtel nicht mehr ablegen...');
INSERT INTO "item_descriptions" VALUES(14082,'de','Wie jeder Edelmann ist auch der Obu-Bobub ein großer Fan von Maskenbällen. Leider verweigert man ihm stets den Zutritt, angeblich weil er keine Verkleidung trüge. Dabei hat er doch eine Vogelmaske auf, wie jeder deutlich sehen kann...');
INSERT INTO "item_descriptions" VALUES(14083,'de','Der Obu-Bobub ist in der Lage seinen Hals um 270 Grad zu drehen. Daher ist dieses Amulett absolut lebensnotwendig für ihn. Es sagt ihm nämlich, wo die Ausgangsstellung ist...');
INSERT INTO "item_descriptions" VALUES(14084,'de','Dieses Schwert wurde dem Obu-Bobub bei der Ritterschlagszeremonie vom Grafen höchstpersönlich verliehen. Es ist das Symbol seines höheren Ranges in der Hierarchie der Sinistros. Allerdings kommt es nie zum Einsatz, da der Obu-Bobub keine Hände hat...');
INSERT INTO "item_descriptions" VALUES(14085,'de','Dieser Umhang besteht aus sensorischen Federn. Dadurch spürt ihr selbst die geringste Berührung durch Gegner in eurem Rücken. Toll, was?');
INSERT INTO "item_descriptions" VALUES(14086,'de','Sinistrofus haben keine Hälse, wie können sie dann dieses Amulett tragen? Handelt es sich auch wirklich um ein Amulett? Manche Dinge nimmt man besser einfach fraglos hin...');
INSERT INTO "item_descriptions" VALUES(14087,'de','Die Hörmuscheln des Sinistrofus sind asymetrisch am Kopf angebracht. Dadurch kann dieser den Ursprung von Geräuschen besser orten. Nein, die Tatsache, dass einer eurer Füße länger ist als der andere, interessiert hier niemanden!');
INSERT INTO "item_descriptions" VALUES(14088,'de','Diesen Hut verwendete Graf Primzahl üblicherweise für seine Manipulation der Zeit. Aber wenn ihr ihn bereits als Schutz bei Heimwerkarbeiten verwenden könnt, ist das bereits eine Leistung.');
INSERT INTO "item_descriptions" VALUES(14089,'de','Dieser Ring ist eine frühe Erfindung Graf Primzahls. Der Träger vermag damit Kälteeinbrüche zuverlässig vorhersagen. Seltsamerweise kommt das bei den Friogostianern seit der Eiszeit nicht allzugut an...');
INSERT INTO "item_descriptions" VALUES(14090,'de','Alles, was durch das Loch dieses Amuletts gesteckt wird, kommt in einem anderen Zeitalter wieder heraus.
Nein, denkt nicht einmal dran... Der Vorgang sieht nämlich ein vollständiges Tiefkühlen des "Subjekts" vor...');
INSERT INTO "item_descriptions" VALUES(14091,'de','Wenn man das Zykloid-Auge in diesem Amulett als Monokel vors Auge hält, werden alle Störungen im Raum-Zeit-Kontinuum sichtbar. Aber intelligent wirken lässt es einen noch lange nicht!');
INSERT INTO "item_descriptions" VALUES(14092,'de','Dieser Ring zeigt die genau Uhrzeit an. Leider ist niemand in der Lage, diese zu entziffern.');
INSERT INTO "item_descriptions" VALUES(14093,'de','Diese Stiefel bewegen sich selbstständig und zwar mit einer Geschwindigkeit von einem Schritt pro Sekunde. Das mag ja toll sein, um sich ohne Anstrengung fortzubewegen, aber um dem drohenden Tod zu entrinnen wäre eine raschere Gangart angebrachter...');
INSERT INTO "item_descriptions" VALUES(14094,'de','Der Strictus des Stringids ist ein Omen des nahenden Todes. Dieses Amulett schützt davor, allerdings nicht vor der Wut der anderen Sinistros, weil ihr deren Körperteile als Amulett tragt...');
INSERT INTO "item_descriptions" VALUES(14095,'de','Stringids spießen gern auf den Spitzen dieses Gürtels schmackhafte Überreste ihrer Beute auf, um später davon zu naschen. Ihr hingegen leistet bereits etwas, wenn es euch gelingt, euch nicht wie ein Depp daran aufzuspießen!');
INSERT INTO "item_descriptions" VALUES(14096,'de','Wenn ihr mehrere Monate lang ohne Unterbrechung eure Zehenmuskulatur trainiert, dann könnt ihr euch dank der Krallen an den Stiefeln mit dem Kopf nach unten an Äste hängen. Praktisch, was?');
INSERT INTO "item_descriptions" VALUES(14097,'de','Beim Nokturnal-Amulett handelt es sich um nichts anderes, als um ein magisches Pendel, das ohne Unterlass um den Hals seines Trägers dreht. Praktisch, um Gegner zu hypnotisieren oder gar euch selbst, wenn ihr mal nicht einschlafen könnt.');
INSERT INTO "item_descriptions" VALUES(14098,'de','Schwerverdauliches Material spucken Nokturnals ins Form von Gewöllen wieder aus. Kein Wunder, dass man viele Gewölle mit Abenteurerteilen an verschiedenen Stellen des Schlosses finden kann. Schließlich sind die meisten Abenteurer von Natur aus schwerverdaulich.');
INSERT INTO "item_descriptions" VALUES(14099,'de','Während die Nokturnal-Spitzen als natürliche Blitzableiter fungieren, dienen deren Stiefel eher dazu, blitzschnelle Tritte auszuteilen!');
INSERT INTO "item_descriptions" VALUES(14130,'de','Dieser Gürtel übt einen großen Einfluss auf das tägliche Leben aus. Die Ohren fangen an zu wachsen, die Haare werden länger und die Muskeln bilden sich zurück. Außerdem wird man von einer plötzlichen, unwiderstehlichen Liebe zur Natur beseelt. Zu spät! Selbst das Ablegen kann jetzt die Wirkung nicht mehr umkehren!');
INSERT INTO "item_descriptions" VALUES(14131,'de','Diese Dolche wurden einst auf Frigost zum Ernten von Getreide eingesetzt. Bis eines Tages ein Tourist von Amakna einem Frigostianer eine Sense schenkte. Und da fragt man sich noch woher es kam, dass Frigost in landwirtschaftlichen Dingen nicht auf der Höhe war... Später stellte man dann zum Glück fest, dass die Messer neben dem Abschneiden von Getreideähren auch noch zum Abschneiden von Hälsen nützlich sein können.');
INSERT INTO "item_descriptions" VALUES(14132,'de','Zum Tragen dieser Dolche muss man sich erst einmal beweisen. Nach dem feierlichen Überreichen wollen sie dann auch noch in das Blut unzähliger Gegner getränkt werden. Nur so können sie nämlich ihren charakteristischen Geruch nach Schweiß, Tränen, Blut und Tod annehmen. Welch ein Glück, dass ihr all das jetzt endlich hinter euch habt!');
INSERT INTO "item_descriptions" VALUES(14133,'de','Auf Schritt und Tritt zeugt diese Axt von großer Wandlungsfähigkeit. Mit einem Hieb macht man nämlich aus einem Gegner einen Reituntersatz. Hier die Anleitung dazu: Dem Gegner die Axt fest in den Rücken rammen. Das geformte Haft als Sattel benutzen. Leichte Tritte in die Rippen bewirken eine Vorwärtsbewegung.');
INSERT INTO "item_descriptions" VALUES(14135,'de','Man könnte denken, dass die Untugend die Abwesenheit jeglicher Moral ist. Doch die Untugend, die wahre Untugend, die schleichende und machiavellistische Untugend ist, sich in glitzernde Outfits und Schlaghosen zu kleiden, nach Essen benannte Frisuren zu tragen, Tänzen mit seltsamen Beckenbewegungen zu frönen und einer seltsamen Neigung nachzugehen, Steine rollen zu lassen.');
INSERT INTO "item_descriptions" VALUES(14146,'de','Diese Spitzhacke erbebt beim Gedanken daran, Gestein zertrümmern zu können. Hinweis: Unrechtmäßige Verwendung ist streng verboten!');
INSERT INTO "item_descriptions" VALUES(14156,'de','Diese Waffe wird mit Vorliebe gegen die Glyphen der Fécas eingesetzt. Aber nicht aus kriegerischen Gründen, sondern um endlich die seltsamen Symbole entziffern zu können, die an der Klinge angebracht sind.');
INSERT INTO "item_descriptions" VALUES(14159,'de','Dieses Cape trug einst ein richtig dicker und somit auch schwerer Sadida. Er hatte die Angewohnheit, besiegte Gegner als Matratze zu verwenden. Üblicherweise verstarben sie unter furchtbaren Qualen, weshalb der Sadida bereits nach kurzer Zeit als eines der grausamsten Wesen in der Welt der Zwölf galt! In Wirklichkeit versuchte er mit allen Mitteln seinen Schlafbedarf von 23 Stunden täglich zu decken!');
INSERT INTO "item_descriptions" VALUES(14160,'de','Das Verlangen, friedliche Tiere grundlos zu ermorden, könnte zum Teil auf diese Halskette zurückzuführen sein. Schließlich soll sie die Fähigkeit haben, sich nach Belieben enger zu schnallen und ihre Träger (Opfer?) zu erdrosseln. Aber wenn das stimmen würde, wäre doch kein Einwohner Amaknas mehr am Leben!');
INSERT INTO "item_descriptions" VALUES(14161,'de','Dieser Pullover ist der beste Beweis dafür, dass der Schein manchmal täuscht, schließlich ist er äußerst mächtig, auch wenn er nicht viel daher macht. Umgekehrt seid ihr der beste Beweis dafür, dass das nur selten vorkommt!');
INSERT INTO "item_descriptions" VALUES(14162,'de','Habt ihr es etwa immer noch nicht geschnallt? Ein Sieg ohne Ruhm und Ehre ist leer!');
INSERT INTO "item_descriptions" VALUES(14163,'de','Diese tollen Sandalen erwecken gleich Urlaubsphantasien von Sonne, Strand und Meer! Leider werden in Amakna die meisten schönen Küstenabschnitte von gefährlichen Monstern oder gar schlimmer noch, von Touristen heimgesucht!');
INSERT INTO "item_descriptions" VALUES(14164,'de','Paradoxerweise wurde dieser Bogen so gut wie nie im Kampf eingesetzt und ist daher trotz seines Alters noch so gut wie neu!');
INSERT INTO "item_descriptions" VALUES(14166,'de','"Grab, Stock, grab!" So lauteten einst die Worte eines blinden Xélors, bevor er mit einem Laut der Überraschung nach Durchbrechen der dünnen Eisschicht im zugefrorenem See verschwand...');
INSERT INTO "item_descriptions" VALUES(14167,'de','Vorsicht! Dieser Hammer mit dem wohlklingenden Namen gaukelt einem das große Gefühl von Macht beim Tragen nur vor. Das geht so weit, dass er einen sogar dazu verleitet, auf Verbündete einzuschlagen, wenn einem mal die Gegner ausgehen!');
INSERT INTO "item_descriptions" VALUES(14168,'de','Wenn euch jemand vorschlägt auszugehen, ihr aber keine Lust dazu habt, dann sagt ihm einfach, dieser dicke Schul-Umhang würde jegliches Aus-Euch-Herausgehen verhindern... Überhaupt lässt sich der Umhang prima dazu verwenden, alles mögliche zu entschuldigen...');
INSERT INTO "item_descriptions" VALUES(14169,'de','Dieses Amulett weckt Hirngespinste und gaukelt einem eine Reihe von Dingen vor, die gar nicht wirklich existieren, wie beispielsweise die Anfertigung makelloser Forschungsarbeiten...');
INSERT INTO "item_descriptions" VALUES(14170,'de','Dieses Band hat die besondere Fähigkeit, beim Träger die Fähigkeit zum kritischen Denken völlig auszulöschen. So stellt sich dieser keine ärgerlichen Fragen mehr wie zum Beispiel die, wie es kommt, dass Geistliche in Zusammenarbeit mit Politikern einen solchen Gegenstand herstellen...');
INSERT INTO "item_descriptions" VALUES(14171,'de','Niemand hätte je gedacht, dass diese tollen Stiefel von soweit her kämen. Damit kann man wirklich große Sprünge machen und herumhüpfen wie ein Wilder!');
INSERT INTO "item_descriptions" VALUES(14271,'de','Wenn auch ihr gerne mal euer Leben für eine Wette aufs Spiel setzt, dann ist diese Halskette, die wie das Halsband der berühmt-berüchtigten Glücks-Maunzmiez aussieht, genau das Richtige für euch. Jetzt könnt ihr damit sogar beim Kamafortuna-Spiel in Kerubims Laden teilnehmen! Ihr seid ein echter Glückspilz, wisst ihr das eigentlich?!');
INSERT INTO "item_descriptions" VALUES(14273,'de','Einige kleingeistige Historiker debatieren immer noch darüber, ob es jemals einen wahren König von Bonta gegeben hat oder nicht. Hier ist der endgültige Beweis für seine Existenz! Jetzt muss nur noch geklärt werden, wann, wo und wie diese Unterhose üblicherweise getragen wurde!');
INSERT INTO "item_descriptions" VALUES(14274,'de','Einer Legende nach soll dieser ehrfurchtsgebietende Stecken von Ulgrud dem Donnerer höchstpersönlich erschaffen worden sein. Allerdings deutet das kleine Fresspäckchen, das euch schon seit Tagen folgt eher darauf hin, dass es sich um einen gewöhnlichen Hirtenstock handelt. Es sei denn, es wäre euer herber Geruch, der für diese Anziehungskraft sorgt?!...');
INSERT INTO "item_descriptions" VALUES(14277,'de','Diesen tollen Seidengürtel hat einst Meister Nabur höchstpersönlich getragen. Der ehrwürdige Martial Arts Meister soll ihn sogar mit einem Zauber belegt haben, der ihn vor Gefahr warnt. Doch von dieser Zauberei fehlt heute jede Spur. Stattdessen scheint er euch eher in Gefahr zu bringen...');
INSERT INTO "item_descriptions" VALUES(14281,'de','Dieses Amulett gibt kontinuierlich eine gewisse Wärme ab, die Nostalgie in euch weckt. Nämlich an jene heiße Sommernacht, die ihr in den Armen einer Draconixa und ihres Drachei-Kriegerfreundes verbracht habt. Es eignet sich allerdings auch hervorragend, um Moskitos zu vertreiben!');
INSERT INTO "item_descriptions" VALUES(14283,'de','Die helle Farbe des Gürtels passt nicht so ganz zur Farbe des restlichen Vulkangesteins der Insel. Darum wurde der Gürtel mit Touristenblut getränkt, mit Ruß geschwärzt und Löchern versehen, damit er authentischer aussieht!');
INSERT INTO "item_descriptions" VALUES(14285,'de','Damit sollte euer empfindlicher Kopf geschützt sein, wenn ihr es mal wieder "heiß" mögt. Alternativ könnt ihr dazu natürlich auch wie in den letzten Jahren wieder den Muttertag oder Geburtstag eurer Freundin vergessen...');
INSERT INTO "item_descriptions" VALUES(14286,'de','Eines ist sicher: Mit Hilfe dieses optischen Gerätes seht ihr die Welt mit anderen Augen! Jeder beschreibt die Wirkung anders: Die einen sehen viel heller, die anderen Schreckliches! Allen gemeinsam ist nur eine höllische Migräne!');
INSERT INTO "item_descriptions" VALUES(14287,'de','Die metaphysischen Eigenschaften dieses Kristalls bringen diesen zum Leuchten, sobald er sich in der Nähe von Arsen befindet. Vielleicht solltet ihr es daher bei eurem nächsten Festbankett als Lampe einsetzen...');
INSERT INTO "item_descriptions" VALUES(14288,'de','Die blutrünstigen Security-Typen, die für den Schutz von Vulkania eingesetzt werden, pflegen mit dieser Waffe regelmäßig die Aufstände von Touristen niederzuknüppeln. Wobei fatalerweise ihrer Definition nach ein Aufstand vorliegt, sobald ein Tourist versucht, nach einer Tracht Prügel wieder aufzustehen...');
INSERT INTO "item_descriptions" VALUES(14289,'de','Diese harmlos aussehende Axt löst all eure Probleme, wie aufdringliche Touristen oder nervende Schwiegermütter. Und wenn nicht, wozu hat man schließlich Ablassbriefe?');
INSERT INTO "item_descriptions" VALUES(14302,'de','Dieser Ring fängt an zu leuchten, wenn feindliche Pflanzen in der Nähe sind. Drum ist es wenig ratsam, damit den Versteinerten Wald infiltrieren zu wollen! Aber sollte eines Tages eure Zimmerpflanze anfangen zu mutieren, seid ihr wenigstens bestens vorgewarnt!');
INSERT INTO "item_descriptions" VALUES(14304,'de','Dieses Amulett ist bei weitem nicht so scharfkantig wie es aussieht, sehr zur Enttäuschung von vielen (Sacrieurs), die es schon in ihre Sammlung an Folterinstrumenten einreihen wollten...');
INSERT INTO "item_descriptions" VALUES(14310,'de','Diese Stiefel demonstrieren anschaulich, woher die Redewendung "Jemanden unter seine Fittiche nehmen" kommt. Damit seid ihr nämlich wunderbar mobil, wodurch ihr gegnerischen Angriffen mit Leichtigkeit ausweichen könnt!');
INSERT INTO "item_descriptions" VALUES(14311,'de','Ihr habt zwar keine Ahnung, was diese Gravur bedeutet, aber das ist ja auch egal. Fakt ist, sie hinterlässt bleibende Spuren im Gesicht eurer Gegner und erinnert nachhaltig an euren Besuch. Zugegeben, es ist etwas weniger stilvoll als das Einritzen der Initialen mit der Schwertspitze, aber wirkt genauso gut.');
INSERT INTO "item_descriptions" VALUES(14433,'de','Der Moskito Boskito wird von seinen Mitmoskitos wegen seiner Körperfülle gehänselt. Er hat sich dazu entschieden, sie zu verlassen, um ein Leben nach seinen eigenen Vorstellungen zu führen. Er baut auf eure Unterstützung, um sich an dieser grausamen Welt zu rächen, die keine Unterschiede akzeptieren will. Aber er ist und bleibt ein Moskito und könnte während eurer gemeinsam verbrachten Zeit einen bleibenden – und juckenden – Eindruck hinterlassen.');
INSERT INTO "item_descriptions" VALUES(14491,'de','Aufgrund ihres beträchtlichen Gewichtes trägt sie der Wa Wabbit nur zu ganz besonderen Anlässen. Aus diesem Grund ist diese Krone auch nichts für Schwachköpfe! Solltet ihr euch ihr nicht gewachsen fühlen, könnt ihr sie auch als Schild verwenden.');
INSERT INTO "item_descriptions" VALUES(14492,'de','Dieser Umhang sollte nicht auf die leichte Schulter genommen werden, da er mit Schuld behaftet ist... ob es sich dabei allerdings um Eure oder die des Wa Wabbits handelt, ist unklar...');
INSERT INTO "item_descriptions" VALUES(14493,'de','Dieser Gürtel ist in Wahrheit völlig ausgehöhlt, um die persönliche Kawottenreserve des Wa Wabbits beherbergen zu können. Diese könnte euch vielleicht eines Tages das Leben retten, wenn ihr euch bei einer eurer Erkundungstouren durch den Wald der verlorenen Kiefern verlaufen solltet.');
INSERT INTO "item_descriptions" VALUES(14494,'de','Einer alten Legende nach soll man mit den Ohren, die an diesem glänzenden Helm befestigt sind, Ohren wie ein Wabbit haben. Aber ganz offensichtlich war sein vorheriger Besitzer völlig taub.');
INSERT INTO "item_descriptions" VALUES(14495,'de','Dieser Gürtel wurde einst als Belohnung bei einem großen Turnier vergeben, bei dem nur die besten Wabbits mit ihren blanken Pfoten gegeneinander antraten. Nach dem Sieg des White Grand Pa kamen jedoch einige Zweifel bezüglich dieses Turniers auf. Viele Wabbits fragten sich, ob es nicht einfach nur eine riesengroße Inszinierung war, um unter dem Deckmantel Kawottensaft zu Höchstpreisen verkaufen zu können.');
INSERT INTO "item_descriptions" VALUES(14496,'de','Im Alter dünsten die White Grand Pa Wabbits alle denselben unangenehmen Geruch aus, durch den man sie nur noch sehr schwer voneinander unterscheiden kann. Also konzipierte man diesen Armreif. Da jeder Armreif einen einzigartigen Geruch absondert, ermöglicht er es, die einzelnen White Grand Pa Wabbits voneinander zu unterscheiden.');
INSERT INTO "item_descriptions" VALUES(14497,'de','Eine genetische Manipulation der Wabbit Terbös soll der Grund für das dritte Auge sein, das diesen Ring schmückt. Eventuelle Nebenwirkungen auf euren Organismus sind also nicht auszuschließen. Wenn euch ganz plötzlich ein drittes Auge, ein weitere Nase oder ein zusätzlicher Arm wachsen sollte, dann solltet ihr diesen Ring so schnell wie möglich ausziehen, bevor euch noch weitere Ohren, Finger oder gar Beine wachsen!');
INSERT INTO "item_descriptions" VALUES(14498,'de','Nur wenige trauen sich dieses Amulett zu tragen, denn auch wenn es ganz nett aussieht, ist sein Geruch extrem gewöhnungsbedürftig, besonders wenn man ihn nicht kennt. Aber das sollte für euch ja kein Problem sein, ihr habt ja oft genug bei Waldo abgehangen.');
INSERT INTO "item_descriptions" VALUES(14499,'de','Die Wabbit Terbös haben drei Pfoten. Dank dieses Phänomens haltet ihr gerade ein nagelneues Paar Stiefel in den Händen. Es bleibt allerdings noch eine Frage offen, und zwar ob der mittlere Fuß des Wabbit Terbös eurem linken oder doch eher eurem rechten Fuß entspricht?');
INSERT INTO "item_descriptions" VALUES(14500,'de','Die WerWabbits sind dafür bekannt, flink und wild zu sein. Schaut man sich jedoch diese flauschigen Stiefel an, ist davon auszugehen, dass sie keine dieser beiden Eigenschaften aufweisen... Naja, zumindest sind sie bequem. Aber seid dennoch vorsichtig, denn es ist nicht auszuschließen, dass eine mutierte Zecke sie zu ihrem neuen Zuhause erklärt hat.');
INSERT INTO "item_descriptions" VALUES(14501,'de','Dieser samtweiche Umhang wird euch bei Einbruch der Dunkelheit ganz sicherlich als Decke dienen. Versucht jedoch, dies bei Vollmondnächten zu vermeiden, wenn euch euer Leben etwas wert ist.');
INSERT INTO "item_descriptions" VALUES(14502,'de','Sollte man euch fragen, warum die Kawotte, die diesen Gürtel schmückt, violett sei, dann könnt ihr die unglaubliche Geschichte erzählen, die ihr erlebt habt. Nämlich, dass dies auf zweiköpfige Wabbits, lebendige Kawotten und Fleddermaus-Wabbits zurückgehe. Ob ihr nach dieser Geschichte jedoch noch glaubwürdig seid, ist wiederum eine andere Geschichte...');
INSERT INTO "item_descriptions" VALUES(14505,'de','Dieser Schild ist eine Imitation der Trophäe, die die Gewinner des berühmten Dracotruterrennens erhalten haben. Er ist gewiss weniger eindrucksvoll als der Originalpokal, verhindert jedoch, dass ihr euch entzweit, was sich letzendlich auch als äußerst nützlich erwiesen hat.');
INSERT INTO "item_descriptions" VALUES(14506,'de','Diese plumpe Imitiation der leuchtenden Haarpracht der lops könnte gut aus einem von Gott Ecaflip gesegneten Wollknäuel hergestellt worden sein. Das ist wahrscheinlich auch der Grund dafür, dass die Maunzwildmiezen so liebend gerne damit spielen.');
INSERT INTO "item_descriptions" VALUES(14519,'de','Zu ihrer Zeit sorgte die ehrenwerte Richterin Lu für Recht und Ordnung im Norden von Cania. Ihre Urteile wurden in letzter Instanz entschieden und das Geräusch ihres Hammers wurde von allen Kriminellen, die im Gerichtssaal von Bonta vorgeführt wurden, gefürchtet. Man erzählt sich, dass es nur Kerubim Crispinus gelungen sein soll, die Frau Richterin von der Unschuld seiner Klienten zu überzeugen. Aber wie er das gemacht hat, ist bisher noch arg umstritten.');
INSERT INTO "item_descriptions" VALUES(14545,'de','Ihr habt Glück, denn Fosfo ist, kurzfristig gesehen, einer der wenigen unschädlichen Wabbits der verlassenen Laboratorien. Er gibt zumindest eine ganz niedliche Nachttischlampe ab.');
INSERT INTO "item_descriptions" VALUES(14579,'de','Bevor dieses Gerät als Maske getragen wurde, diente es ehemals mehreren Vorbesitzern als Nachttopf. Aufgrund eines Missverständnisses setze es sich Dramak als Maske auf und zog es vor, die Maske Tag und Nacht zu Tragen, anstatt seinen Fehler einzugestehen.');
INSERT INTO "item_descriptions" VALUES(14580,'de','Die Tatsache, dass ein gewisser Levito diesen Gürtel trug, sorgte bei Dramaks Handlangern lange Zeit für große Unruhe. Ihr Meister musste viel Energie aufwenden, um ihnen zu beweisen, dass nur er ihr wahrer Herr und Meister sei...');
INSERT INTO "item_descriptions" VALUES(14581,'de','Immer wieder grübelt Dramak über die Ursachen seiner fatalen Entscheidung nach, diese magischen Armbänder gleich in solchen Massen hergestellt zu haben. Sollte das Zerstören gefährlicher, magischer Gegenstände noch nicht zu euren Lieblingsbeschäftigungen gehören, dann werdet ihr es ihm bald nachtun...');
INSERT INTO "item_descriptions" VALUES(14582,'de','Die hinterhältigsten Gauner der Welt der Zwölf nutzen gern diese Gürtel als geheimes Erkennungszeichen. Dadurch vermeiden sie, sich an Ihresgleichen zu vergreifen. Böse Zungen behaupten hingegen, sie hätten stattdessen keinen billigeren Gürtel als diesen finden können!');
INSERT INTO "item_descriptions" VALUES(14583,'de','Wolltet ihr schon immer den großen Mann markieren und alle Blicke auf euer durch und durch durchschnittliches Persönchen lenken?
Dann ist dieser Hut für euch wie gemacht. Trotz seines geringen Preises bringt er sowohl euer aufschneiderisches Gehabe, als auch eure legendäre Feigheit vorzüglich zur Geltung!');
INSERT INTO "item_descriptions" VALUES(14584,'de','Dieser Bogen wurde zwar aus diversen Einzelteilen zusammengebastelt, ist aber dennoch ziemlich effektiv. Jedenfalls effektiv genug, um am Zaap von Astrub gezielt den lautesten der vielen Schreihälse niederzustrecken.');
INSERT INTO "item_descriptions" VALUES(14585,'de','Der Schrauenverdreher setzt diesen Schlüssel nicht etwa zum Öffnen von Türen ein, sondern zum Erledigen aller Aufgaben, die ihm Dramak aufträgt. Angefangen von diversen Reparaturen des Theaters bis hin zum Zerschmettern von Dickschädeln der Abenteurer.');
INSERT INTO "item_descriptions" VALUES(14589,'de','Dieser Gürtel passt euch wie angegossen. Allerdings solltet ihr euch von nun an vor Fremden in Acht nehmen. Slipürtel scheinen nämlich voll im Visir einer seltsamen Sekte von Abenteurern zu stehen, deren Steckenpferd es ist, getragene Unterwäsche zu sammeln. Sie sollen sogar nicht davor zurückschrecken, besagte Kleidung auf offener Straße herunterzureißen, also seid stets auf der Hut...');
INSERT INTO "item_descriptions" VALUES(14593,'de','Das Konzept "Theaterstück" ist für Iops ziemlich schwierig zu begreifen. Dennoch sind sie mit großem Enthusiasmus dabei, wenn es darum geht, den Bösewicht zur Strecke zu bringen. Damit sie nicht alles und jeden verdreschen, sondern nur den Bösewicht des Stückes, hat man diesem einen solchen Ring als Markierung gegeben. Darum ein Ratschlag: Wenn ein Iop Theater macht, dann lauft!');
INSERT INTO "item_descriptions" VALUES(14597,'de','Für echte Liebhaber ist das Tragen dieses Amuletts im Monat Aperirel Pflicht. Dann kitzeln sie die wohligen Gerüche in der Nase und sie vergessen die ganze Welt um sich herum. Jedenfalls solange bis sie der Suchpfeil eines übelriechenden Ferkelchens wieder in die harte Realität zurückholt...');
INSERT INTO "item_descriptions" VALUES(14601,'de','Nur mit diesem "Gürtel" bekleidet seht ihr schon ziemlich lächerlich aus. Ja, niedlich und lächerlich zugleich. Doch seit wann ist das ein Nachteil?');
INSERT INTO "item_descriptions" VALUES(14605,'de','Im Gegensatz zu dem, was man meinen möchte, wird dieser Ring nicht am Finger getragen. Aber auch nicht dort, wo ihn einige Osamodas-Anhänger bei ihren seltsamen Zeremonien anlegten. Dieser Vorfall soll zu gewissen Komplikationen geführt haben...');
INSERT INTO "item_descriptions" VALUES(14609,'de','Niemand weiß genau, woher dieser Ring eigentlich stammt. Aber eines Tages steckte er am Quark-Quak - Stecken. Ob es da womöglich einen Zusammenhang mit einem vorausgegangenen Besuch der Bworkette gibt?');
INSERT INTO "item_descriptions" VALUES(14613,'de','Dieser Ring wird jedes Jahr aufs Neue im Rahmen einer feierlichen Zeremonie demjenigen überreicht, der in Tofoone-Verkleidung den Litneg-Wald durchquert...');
INSERT INTO "item_descriptions" VALUES(14617,'de','Man kann sagen, was man will: Weiße Ninjas sind äußerst oberflächlich und abergläubig. Sie zahlen horrende Summen an gewitzte Scharlatane für einen solchen "Schutz vor dem Bösen Blick und Üblen Flüchen" wie dieses Amulett hier!');
INSERT INTO "item_descriptions" VALUES(14621,'de','Dieses Amulett des Schwarzen Ninjas soll angeblich zahlreiche tödliche Flüche und Dunkle Kräfte aus alten Zeiten beherbergen, mit denen man die Götter selbst zur Strecken bringen könnte. Leider sind im Laufe der Zeit das Wissen darüber, sowie die Befehlswörter in Vergessenheit geraten, was den günstigen Preis des Schmuckstücks erklärt...');
INSERT INTO "item_descriptions" VALUES(14625,'de','Der für seine Schnelligkeit bekannte Bote Herr Mes trug maßgeblich zur Berühmtheit dieses Schuhwerkes bei. Seit dem Ärger mit R.Klimms übermächtigen Schuhwerk hat jedoch die Zunft der Schuhmacher beschlossen, die Werte drastisch nach unten zu korrigieren, bevor die Stiefel in Umlauf gebracht werden.');
INSERT INTO "item_descriptions" VALUES(14629,'de','Was ist praktischer als getrocknete Marschverpflegung und transportabler als eine komplette Jagdausrüstung? Richtig, es ist der Makigürtel, der beim Guerilla-Kampf der Pandikaze eine große Rolle spielt!');
INSERT INTO "item_descriptions" VALUES(14633,'de','Diese Stiefel mögen zwar nicht so stilvoll sein, wie echte, weiße Drachenschuppenstiefel, aber dafür sind bei den jungen Abenteurerinnen total angesagt, die auf der Suche nach dem gewissen Etwas sind, das zu ihrem Kawai-Set passt!');
INSERT INTO "item_descriptions" VALUES(14637,'de','Auf den ersten Blick scheint diese Medusa ganz friedlich zu sein... trotzdem solltet ihr auf der Hut sein! Einer alten Legende nach soll sie nämlich in der Lage sein, bestimmte Kreaturen zu Stein werden zu lassen. Da es sich bei diesen um Krachler handelt, wird ihre Befähigung gleich viel weniger eindrucksvoll...');
INSERT INTO "item_descriptions" VALUES(14638,'de','Mit diesem Gürtel fühlt ihr euch wie ein Fisch im Wasser! Allerdings wäre es für euch ratsam, auch dort zu bleiben. An Land würde der von diesem Gürtel ausgehende, strenge Geruch nach altem Fisch nämlich nicht gerade zu eurer Beliebtheit beitragen...');
INSERT INTO "item_descriptions" VALUES(14639,'de','Habt ihr euch auch schon immer gefragt, wie die Meerjungfrauen in den Tiefen der Ozeane ihren Weg finden? Dieser mit seiner aufwendigen Steamer-Geolokalisierungstechnologie versehene Ring könnte vielleicht des Rätsels Lösung sein.');
INSERT INTO "item_descriptions" VALUES(14640,'de','Dieser Stecken wurde speziell für Unterwasserkämpfe konzipiert. Drum werdet ihr sein volles Potenzial erst dann ausnutzen können, wenn ihr Schwimmen gelernt habt. Bis dahin solltet ihr ihn lieber so wenig wie möglich einsetzen, um euch und euer Umfeld selbst nicht unnötig zu gefährden.');
INSERT INTO "item_descriptions" VALUES(14644,'de','Die Mehrzahl aller Abenteurer würde ohne zu zögern ihre Großeltern verkaufen, ihre Familie opfern und ihr Reittier essen, um einen Blick auf das zu erhaschen, was dieser Gürtel verdeckt!');
INSERT INTO "item_descriptions" VALUES(14798,'de','Wenn dieser Gürtel nicht gerade dazu verwendet wird, um jungen, turbulenten lops den Hintern zu versohlen, dann wird er enger geschnallt, um überflüssige Speckröllchen diskret zusammenzuhalten. Dieser Gebrauch hat vor allem bei den Leibwächtern König Allisters Anklang gefunden.');
INSERT INTO "item_descriptions" VALUES(14803,'de','Diese Stiefel sind bei den traditionellen Theateraufführungen ein absolutes Muss. Schaut man jedoch genauer hin, sind es die Sicherheitskräfte, die sie tragen, um respektlose Zuschauer mit einem ordentlichen Tritt in den Hintern vor die Tür zu setzen.');
INSERT INTO "item_descriptions" VALUES(14806,'de','Mit diesem Ring könnt ihr das Herz eurer Herzdame bzw. eures Herzbuben einfach und wenig kostspielig erobern. Leider scheint dies bei den Enutrofs nicht zu funktionieren, aber wer wäre schon so blöd und würde sich darüber beklagen?');
INSERT INTO "item_descriptions" VALUES(14809,'de','Wenn ihr gerne näselt, dazu quakend euren knackigen Allerwertesten bewegt und gerne mit Entenvögeln am Rockzipfel spazieren geht, dann ist diese Kappe genau die richtige für euch. Die Farbe Rosa macht sie zudem einfach unerlässlich!');
INSERT INTO "item_descriptions" VALUES(14810,'de','Wenn ihr dieses Abzeichen tragt, werdet ihr zum Gesetzeshüter. Mit eurer schönen, blauen Uniform gekleidet, werdet ihr zum Buuhbullen, einem Agenten der Staatsgewalt. Alle aufrichtigen Bürger werden euch mit großem Respekt begegnen, alle Rechtsbrecher werden jedoch schon beim Erwähnen eures Namen terrorisiert... das ist die Theorie. In der Praxis sieht das ganze dann ein wenig anders aus.');
INSERT INTO "item_descriptions" VALUES(1014827,'de','Kwackoheit wird euren luxuriösen Ansprüchen bestimmt gerecht werden. Seine vom Wind angetriebenen Federn und sein Ledersattel sorgen für ein einzigartiges Flugerlebnis. Vorausgesetzt, ihr bekommt seine Launen in den Griff. Herr Kwack nistet nämlich nicht in irgendeinem Nest, oh nein, wo kämen wir denn da hin!');
INSERT INTO "item_descriptions" VALUES(1014833,'de','Dieser Reitbegleiter ist im wahrsten Sinne des Wortes ein Flugbegleiter. Er hat schon lange den Boden unter den Füßen verloren und träumt oft davon, weite Wüstenregionen zu überfliegen. Dort hätte er seine Ruhe vor all den lästigen Abenteurern, die ständig versuchen, ihn auf den Boden der Tatsachen zurückzuholen ... dort könnte er sich den Rücken freihalten.');
INSERT INTO "item_descriptions" VALUES(1014838,'de','Ressaw und Reuef verstehen sich trotz ihres gegensätzlichen Charakters hervorragend. Bei Reuef geht es immer heiß her, wohingegen Ressaw eher nah am Wasser gebaut ist. Das ist aber noch lange keine Grund für ihn, unterzugehen.');
INSERT INTO "item_descriptions" VALUES(1014848,'de','Im Gegensatz zu Schirocko ist Kompost sehr bodenständig. Kein Zweifel, er ist genau der richtige Begleiter für all diejenigen, die Höhenluft geschnuppert haben. Er wird sie ganz bestimmt wieder auf den Boden der Tatsachen zurückholen können.');
INSERT INTO "item_descriptions" VALUES(1014854,'de','Reuef ist sehr empfindlich und schnell Feuer und Flamme. Ihr solltet ihn also nicht unnötig reizen, sonst macht er euch nämlich ordentlich Feuer unter dem Hintern.');
INSERT INTO "item_descriptions" VALUES(14877,'de','Solltet ihr diesen Hut außerhalb von Sufokia tragen, dürfte der ein oder andere ein wenig verdutzt sein und ihr Schwierigkeiten haben, ernst genommen zu werden. Unter Wasser verleiht euch dieser Hut allerdings etwas Räuberisches, doch lasst euch davon nicht hinters Licht führen...');
INSERT INTO "item_descriptions" VALUES(14878,'de','Dieser Glücksbringer wurde ursprünglich ganz tief unten im Meer von Sufokia gefunden und soll es ermöglichen, unter Wasser zu atmen. Das, was man euch jedoch verschweigt, ist, dass ihn eine Person um den Hals trug, die qualvoll ertrunken ist. Aber wer weiß, vielleicht wurde er dieser Person ja auch erst nächträglich um den Hals gehängt?');
INSERT INTO "item_descriptions" VALUES(14879,'de','Dieser Ring soll angeblich Julie Lessko, einer Cousine von Ratzeraff gehört haben. Man erzählt, dass sie während Merkators Abwesenheit für Ordnung und Disziplin auf der Tiefseebasis gesorgt haben soll. Sie soll versucht haben, an die Oberfläche zurückzukehren, um eine politische Karriere zu starten, doch seitdem hat man nie wieder etwas von ihr gehört.');
INSERT INTO "item_descriptions" VALUES(14880,'de','Zweifel völlig ausgeschlossen! Mit diesem Helm auf dem Kopf kommt euch keiner mehr zu nahe. Seid euch aber dennoch nicht zu siegessicher! Es gibt nämlich immer wieder Spaßvögel, die Geschmack an diesem Helm finden und euch mit buntem Obst und Gemüse beschmeißen, weil es sich so prima auf eurer Helmspitze aufspießen lässt. Einen Vorteil hätte dies - das würde eurem Helm ein wenig Farbe verleihen!');
INSERT INTO "item_descriptions" VALUES(14881,'de','Diese Stiefel sollten euch nicht nur einmal den Hintern retten können. Wenn euch eure Gegner hinterrücks angreifen wollen, sollten sie sich vor euren Stiefeln in Acht nehmen, wenn sie unbeschadet davonkommen wollen. Seid aber dennoch vorsichtig, wenn ihr eure Reittiere besteigt, denn sie dürften nicht gerade Liebhaber eurer Stiefel sein.');
INSERT INTO "item_descriptions" VALUES(14882,'de','Dieser Ring ist zwar für gewisse Aufgaben denkbar ungeeignet und beschwört einen Unfall quasi wie von selbst herauf, aber er könnte sich abseits der Schlachtfelder noch als nützlich erweisen. Zum Beispiel, um bestimmte Früchte aufzufangen: So müsstet ihr euch nicht mehr selbst die Hände schmutzig machen! Dieses handliche Werkzeug wird die Welt noch revolutionieren!');
INSERT INTO "item_descriptions" VALUES(14883,'de','Dieses Band kann auch über dem Auge getragen werden. Es scheint, als würde es die Unterwasserforschung vereinfachen. Nur schade, dass es in Merkators Unterwasserkuppel völlig unwirksam ist.');
INSERT INTO "item_descriptions" VALUES(14884,'de','Mit diesem Amulett der neuesten Generation könnt ihr eure Questen von nun an mit ganz anderen Augen betrachten. Ihr werdet voller Begeisterung weit entfernte Gegenden auskundschaften und deren Bewohnern zu Hilfe eilen. Darüber hinaus leuchtet es im Dunklen!');
INSERT INTO "item_descriptions" VALUES(14885,'de','Einige Steamer haben mit diesem Umhang schon für spannende Unterhaltung gesorgt. Auf ein bestimmtes Wort hin wurden sie für alle Anwesenden vollkommen unsichtbar. Sie vergaßen natürlich zu erwähnen, dass sie bis zu ihrem erneuten Erscheinen nicht mehr würden atmen können, was sicher Anlass zu einigen geschmacklosen Streichen gegeben hat. Daher hat man sich bei der neuen Version dieses Umhangs dazu entschieden, von dieser magischen Eigenschaft Abstand zu nehmen.');
INSERT INTO "item_descriptions" VALUES(14886,'de','Einer Legende nach, sollen Krieger eines Meeresvolkes mit einer solchen Waffe einen Schiffskörper mit nur einem einzigen Schlag entzweit haben. Der berühmte Kapitän Frakass war Spezialist darin, doch leider war er auch ein wenig ungeschickt. Er ging nämlich mit seinem Schiff unter, nachdem er versucht hatte, ein Porträt seiner Gattin an die Wand seiner Kabine zu nageln.');
INSERT INTO "item_descriptions" VALUES(14929,'de','Dieses Amulett birgt ein finsteres Geheimnis in sich, das schrecklich und umwerfend zugleich ist! Aber zum Öffnen muss es geschluckt werden und dann müsst ihr zusehen, mit welchen Mitteln ihr es wieder herbekommt.');
INSERT INTO "item_descriptions" VALUES(14930,'de','Hinter diesem etwas unaussprechlichen Namen verbirgt sich ein stinknormaler Gürtel. Er hält nicht nur eure Hose, sondern verleiht euch einen unvergleichlichen Stil. Manchmal braucht man nicht mehr.');
INSERT INTO "item_descriptions" VALUES(14931,'de','Diese Schuhe sind alte Relikte, die von besonderen Todeskräften durchwirkt sind. Allerdings weiß man nicht, ob sich diese Kräfte gegen den Träger oder gegen das Ziel des Trägers richten.');
INSERT INTO "item_descriptions" VALUES(14932,'de','Dieser Ring verleiht euch die unglaubliche Macht, euren Schatten zu kontrollieren: denn dieser folgt euren eigenen Bewegungen! Dieses Verkaufsargument scheint bei nur wenigen Leuten anzuschlagen.');
INSERT INTO "item_descriptions" VALUES(14933,'de','Diese Stiefel sind sehr unbequem. Gefallen tun sie nur jenen, die noch die Werte aus früheren Zeiten vermissen, wo man noch leiden musste, um voranzukommen. Sie werden euch den ganzen Tag zu schaffen machen, aber dafür werdet ihr von einem Gefühl der Erleichterung und der Freude erfüllt, sobald ihr sie auszieht.');
INSERT INTO "item_descriptions" VALUES(14934,'de','Die zwei schwarzen Flecken in Augenhöhe sind nicht etwa Öffnungen, nur damit das klar ist. Ihr werdet also nicht viel sehen, aber dafür werden eure olfaktiven Fähigkeiten verzehnfacht. Das kann in manchen Situationen eher von Nachteil sein, besonders, wenn ihr gegen Bworks kämpft.');
INSERT INTO "item_descriptions" VALUES(14937,'de','Dieser Umhang ist ein Symbol vergangenen Ruhmes und hat bei den Abenteurern von heute nur noch einen ästhetischen Stellenwert. Die echten Ritter der Gerechtigkeit tragen ihn nicht mal mehr zu festlichen Anlässen, seit einer von ihnen damit in einer Drehtür hängenblieb und in weniger als einer Minute zerquetscht wurde.');
INSERT INTO "item_descriptions" VALUES(15009,'de','Rubrächer, der Knechter, ist ein echter Sadist. Die vielen Schellen an diesem Gürtel kündigen sein Kommen bereits von weitem an. Dadurch können die Kinder bereits lange vorher eine Riesenangst aufbauen und er eine umso größere Vorfreude, bevor er endlich seine Rute einsetzt. Für euch als armen Abenteurer, dessen tägliches Brot daraus besteht, sich an aggressiven Monstern vorbeizuschleichen, ist diese klangliche Untermalung eher kontraproduktiv...');
INSERT INTO "item_descriptions" VALUES(15010,'de','Diese Schablone ermöglicht es den Handwerksmeistern, ein Element des Rubrächer, der Knechter - Sets herzustellen.');
INSERT INTO "item_descriptions" VALUES(15011,'de','Mit diesem Ring am Finger werdet ihr euch keine Freunde machen. Der weckt nämlich Erinnerungen an all das, was Rubrächer, der Knechter, den Einwohnern der Weißnachtsinsel angetan hat. In einigen Organisationen soll das Tragen sogar schon verboten worden sein!');
INSERT INTO "item_descriptions" VALUES(15012,'de','Mauve Arrow wird von so manchen als schlechter "Mauvi-Star" verlacht und es wird gewitzelt, der Unterschied zwischen ihm und einer Mi-Maus ist genau das Tier, das er am meisten anbetet... Dabei wird oft vergessen, dass Mauve Dart ein waschechter Ritter der Gerechtigkeit ist, der sich ohne zu zögern den gefährlichsten Erzschurken der Welt der Zwölf entgegenstellt, wie dem Batofu zum Beispiel...');
INSERT INTO "item_descriptions" VALUES(15013,'de','Es heißt, Mauve Arrow würde diese Farbe tragen und lieben, weil er im Goblin-Lager aufgewachsen sei. Vielleicht erklärt das auch die Fülle an verschossenen Pfeilen, die sich dort finden lassen...');
INSERT INTO "item_descriptions" VALUES(15014,'de','Dieser Bogen gehört zu einer breiten Palette an Waffen, die Mauve Arrow zu seiner Verfügung hat. Es gibt Modelle für jeden Zweck: Bögen, die Explosivpfeile verschießen, solche mit Klebpfeilen, mit Boomerangspfeilen (etwas unpraktisch, zugegeben), mit Küwbispfeilen (hä?!?), mit Herzpfeilen (Amor lässt grüßen) und sogar mit Regenbogenpfeilen. Immer nur ein und denselben Bogen zu benutzen und nur die Pfeile zu wechseln, wäre ja langweilig...');
INSERT INTO "item_descriptions" VALUES(15015,'de','Zwiedolin denkt sich immer wieder innovative Techniken aus, um den Bauern von Amakna das Leben so richtig zur Hölle zu machen. Ein Beispiel hierfür ist diese Kopfbedeckung, durch die weit und breit kein Auge trocken bleibt...');
INSERT INTO "item_descriptions" VALUES(15016,'de','Achtung, dieser Umhang sollte nicht mit dem ebenfalls vegetarischen Tragestolz verwechselt werden. Dem Zwiedolincape entströmt ein besonderer Geruch, der auf natürlichem Wege alle gegnerischen Kreaturen in die Flucht schlägt...');
INSERT INTO "item_descriptions" VALUES(15017,'de','Der Geruch dieser Stiefel harmoniert gut mit dem eurer Füße...');
INSERT INTO "item_descriptions" VALUES(15059,'de','Ja, ihr habt richtig gesehen: Bei diesem Ring handelt es sich um einen echten Schrumpfkopf, der durch ein besonderes Verfahren extrem verkleinert wurde, bis man ihn am Finger tragen kann. Tja, Köpfchen muss man haben...');
INSERT INTO "item_descriptions" VALUES(15060,'de','Diese Art von Gürtel ist zugegebenermaßen äußerst robust und funktional, aber in erster Linie handelt es sich hierbei um ein Erkennungszeichen. Eine Gruppe revolutionärer Dissidenten führt nämlich seit kurzem einen Kaniguarillakrieg gegen die Kanigroula-getreuen Truppen. Stellt sich nur eine Frage: Auf welcher Seite steht ihr?!?');
INSERT INTO "item_descriptions" VALUES(15061,'de','Kaniguarm-Boy musste nach dem völligen Fehlschlag seiner neuesten Innovation, der handgeschnitzten Wiiddipuppe für Erwachsene, sein Vorhaben endgültig aufgeben, das im prüden Bonta äußerst populäre Konkurrenzprodukt "XY-Box" vom Markt zu verdrängen.');
INSERT INTO "item_descriptions" VALUES(15062,'de','Mit dieser Mütze auf dem Kopf ähnelt ihr einem zu einem wilden Tier mutierten Iop und verbreitet Terror und Entsetzen bei den Astrubianern und Einwohnern Amaknas. Für den großen Jäger Newark werdet ihr hingegen dadurch zu einer lohnenden Jagdbeute...');
INSERT INTO "item_descriptions" VALUES(15063,'de','Die Zahl der roten Markierungen auf diesem Gürtel ist ein sicheres Indiz für den Jagderfolg des Goldeoparden. Mit jeder gefressenen Beute muss er nämlich den Gürtel weiter schnallen, um wieder genügend Bauchfreiheit zu haben. Bei euch steht die Weite des Gürtels hingegen eher für die Anzahl Biere, die ihr gestern in der Kneipe in euch hineingegossen habt...');
INSERT INTO "item_descriptions" VALUES(15064,'de','Manch einer hat sich bereits gefragt, wo denn das zweite Auge der Goldeoparden abgeblieben sei. Die Besitzer dieses Amuletts wissen die Antwort, aber behalten sie lieber für sich...');
INSERT INTO "item_descriptions" VALUES(15099,'de','Schon bei der kleinsten Bewegung verändert das Band seine Farben. Es ist also genau das Richtige, um am großen Karnevalzer-Ball den Tanz zu eröffnen!');
INSERT INTO "item_descriptions" VALUES(15100,'de','Diese Stiefel wurden speziell für den Vertofurrückten Karneval konzipiert. Sie sind hermetisch abgeschlossen, so dass nichts herein- oder herauskommen kann. Von den üblicherweise dann geworfenen oder abgeschossenen Geschossen aller Art bleibt ihr daher verschont. Von einer bestialischen Geruchsbelästigung beim Ausziehen die anderen hingegen nicht...');
INSERT INTO "item_descriptions" VALUES(15110,'de','Wenn ihr wirklich glaubtet, hierbei ein kuschliges Schoßtier mit übertriebenem Schlafbedarf zu adoptieren, dann steht euch eine gewaltige Überraschung bevor ... Die Wildheit dieser kleiner Fellkugel ist umgekehrt proportional zu ihrer Größe. Sprich: Sie verbringt die meiste Zeit damit, alles anzuspringen, zu beißen und zu zerkratzen, war ihr unter die Pfoten kommt. Sie liebt es auch, euch höhnisch lachend anzustarren, was doch ein bisschen beleidigend ist.');
INSERT INTO "item_descriptions" VALUES(15133,'de','Der Black Tiwabbit hat aus der Not eine Tugend gemacht. Da ihm sein Stirnband ständig in die Augen rutscht, pflegt er mit gesenktem Kopf auf seine Gegner zuzurennen ... oder seine Verbündeten! In allen Fällen ein wirksames Ablenkungsmanöver ...');
INSERT INTO "item_descriptions" VALUES(15157,'de','Diese Kopfbedeckung wird meist von Personen getragen, die andere lautstark dazu auffordern, ihnen einen Dienst zu erweisen. Sie scheinen einen echten Kick daraus zu erleben, den ganzen Tag am selben Ort zu stehen und die Passanten mit dem immer gleichen Text zuzumüllen. Welch faszinierende Lebensweise!');
INSERT INTO "item_descriptions" VALUES(15183,'de','Wenn ihr eure Ruhe habe wollt, dann ist diese Maske ideal, denn sie schreckt ganz natürlich alles und jeden ab, der sich für euch interessiert und das fängt schon bei Kindern an. Gewöhnt euch aber nicht zu sehr daran, sonst werdet ihr noch verbittert.');
INSERT INTO "item_descriptions" VALUES(15184,'de','Dieser etwas altmodisch aussehende, jedoch unglaublich bequeme Umhang ist bei den Enutrofs der letzte Schrei. Seine besondere Form kaschiert auch noch den krummsten Rücken.');
INSERT INTO "item_descriptions" VALUES(15185,'de','Bartagone kommen ohne ihre Gürtel nicht aus, denn diese halten ihre Behaarung im Zaum. Sonst stehen ihnen die Haare ab und zu Berge, so wie ihre Bärte.');
INSERT INTO "item_descriptions" VALUES(15186,'de','Die Krone König Nidas'' lässt sich auch verkehrt herum aufsetzen, damit er sehen kann, was hinter dem Träger geschieht. Damit ist aber nicht unbedingt Rückendeckung gewährleistet, denn ein Shushu bleibt ein Shushu und es wäre naiv ihm über den Weg zu trauen.');
INSERT INTO "item_descriptions" VALUES(15187,'de','Dieser unruhestiftende Ring zieht am liebsten Träger vor, die sich ihrer Fäuste zu bedienen wissen.');
INSERT INTO "item_descriptions" VALUES(15188,'de','Um diese Flip-Flops zu tragen, müssen die Füße peinlichst sauber sein. Sonst werdet ihr es bitter bereuen.');
INSERT INTO "item_descriptions" VALUES(15189,'de','Dieses Amulett kontrolliert die Seelenreinheit seines Trägers: jedes Mal, wenn ihr einen unschönen Gedanken habt, dann steigen die zwei Kugeln hoch und würgen euch. Naja, es ist nur eine Frage der Zeit.');
INSERT INTO "item_descriptions" VALUES(15190,'de','Haarraff-Kugeln haben jeweils eine sehr große Bedeutung, deshalb findet man sie auch auf diesem Armreif. Aber egal, euch interessiert nur, ob sie zu eurer Augenfarbe passen.');
INSERT INTO "item_descriptions" VALUES(15191,'de','Diese Pantoffeln sind so schwer, dass man sie nicht ständig heben kann; man muss also zum Vorankommen mit den Füssen vorwärts schlurfen. Mit dieser Technik kriegt man den Boden von Enutrosor prima sauber.');
INSERT INTO "item_descriptions" VALUES(15192,'de','Wenn ihr diese Haube tragt, dann werdet ihr mit wallenden Haaren den unnachahmlichen Levitrof-Style annehmen. Ist vielleicht nicht ganz so schick, aber wenn man sich bestimmten Personen nähern möchte, wie z.B. den Enutrofs, ist das unabdinglich.');
INSERT INTO "item_descriptions" VALUES(15193,'de','Levitrofs tragen diese Ringe ab einem bestimmten Alter, da sie wissen, dass sie keine Gelegenheit mehr haben werden, echte zu tragen.');
INSERT INTO "item_descriptions" VALUES(15194,'de','Wie der Name schon sagt, die Levitrofs levitieren. Was diese Stiefel absolut nutzlos macht.');
INSERT INTO "item_descriptions" VALUES(15195,'de','Kamasterisks wissen, dass sie immer eine Schaufel brauchen. Daher haben sie eine tragbare Schaufel mit auseinanderziehbarem Griff erfunden, so müssen sie ihre Schaufel nicht ständig mit herumschleppen.');
INSERT INTO "item_descriptions" VALUES(15196,'de','Es gibt doch nichts Besseres, als Stiefel aus massivem Gold. Damit fallt ihr ganz bestimmt nicht auf!');
INSERT INTO "item_descriptions" VALUES(15197,'de','Angeblich verwenden Kamasterisks zum Formen ihres Bartes ihre Haare, um ihre Weiblichkeit zu verstecken. Dieser Umhang bekräftigt diese Theorie.');
INSERT INTO "item_descriptions" VALUES(15198,'de','Das hier sind sogenannte atmende Stiefel. Also aufgepasst: es kommt oft vor, dass sich beim laufen kleine Fremdobjekte ins Innere kommen. Außerdem niesen diese Stiefel, natürlich immer im denkbar ungünstigsten Moment und bringen euch so aus dem Gleichgewicht.');
INSERT INTO "item_descriptions" VALUES(15199,'de','Da dieser Gürtel Gold wert ist, wird er nicht sehr oft zweckentfremdet. Von seinem Gewicht mal ganz abgesehen, der den Einsatz als Waffe erheblich erschwert.');
INSERT INTO "item_descriptions" VALUES(15200,'de','Dieser Pelz ist bei den oberen Zehntausend sehr beliebt. Sie verleiht einem einen bestialischen Look, der dem von Kanigroula in nichts nachsteht, aber vor allem hält er warm.');
INSERT INTO "item_descriptions" VALUES(15201,'de','Seinem Aussehen nach zu urteilen könnte dieser Gürtel glatt aus der Shukrust stammen. Wer weiß, wie weit sich die Griesgramratten vorgegraben haben?');
INSERT INTO "item_descriptions" VALUES(15202,'de','Dieser Umhang verleiht euch ein grausiges Aussehen! Aber euren Gegnern jagt das keine Angst ein! Sie greifen euch einfach von hinten an, vor allem, wenn sie Hörner tragen.');
INSERT INTO "item_descriptions" VALUES(15203,'de','Wenn auch nicht sehr geschmackvoll, so hattet ihr bei diesem Amulett den richtigen Riecher. Naja, nicht wirklich. Denn leider bringt euch dieses Amulett entgegen landläufiger Meinung rein gar nichts Interessantes.');
INSERT INTO "item_descriptions" VALUES(15207,'de','Beim Tragen dieses Umhangs überkommt euch der unwiderstehliche Drang, alles auszusprechen, was euch durch den Kopf geht. Dieses lose Mundwerk zieht natürlich Bemerkungen von allen Seiten nach sich.');
INSERT INTO "item_descriptions" VALUES(15208,'de','Der Erfinder dieses Gürtels hatte es satt, immer nach seinem verschlampten Schlüssel suchen zu müssen. Daher verzauberte er den Gürtel, so dass nun jeder Schlüssel passt. Das macht ihn das Ganze daher etwas uninteressant, aber wenn''s Keiner weiß...');
INSERT INTO "item_descriptions" VALUES(15210,'de','Diese Stiefel schützen eure weichen Waden unter allen Umständen.');
INSERT INTO "item_descriptions" VALUES(15212,'de','Dieser Helm war schon oft Zielscheibe diverser Witze, die man hier alle gar nicht nacherzählen kann. Setz ihn einfach auf und stellt euch vor, ihr fahrt auf einem Motorrad einem Bären davon.');
INSERT INTO "item_descriptions" VALUES(15213,'de','Die Nachricht ist klar: Was sich unter diesem Gürtel verbirgt, ist wohlgehütet.');
INSERT INTO "item_descriptions" VALUES(15215,'de','Symbole der Männlichkeit, aber diese Stiefel werden in Wirklichkeit hauptsächlich von Personen getragen, die etwas zu kompensieren versuchen.');
INSERT INTO "item_descriptions" VALUES(15216,'de','Man sagt Unruhtruh nach, dass sie über ihre Armee von Truhen ständig den Stab bricht. Dieser allzu wörtlich genommene Ausdruck hat diesen Gegenstand zum Vorschein gebracht, der natürlich nicht die gewünschten Wirkungen zeigt.');
INSERT INTO "item_descriptions" VALUES(15217,'de','Griesengads Hammer ist ein Paradox an sich: er wurde von Enutrofs konzipiert, um Kamas zu prägen, aber in Wahrheit lässt er sie verschwinden. Logischerweise ist er in Enutrosor verboten, denn bereits das Abhandenkommen eines einzigen Kamas ist ein Sakrileg.');
INSERT INTO "item_descriptions" VALUES(15218,'de','Diese Schaufel ist zum Graben da, klar! Aber nicht irgendwo: nur in den Haufen unendlicher Kamas in Enutrosor.');
INSERT INTO "item_descriptions" VALUES(15235,'de','Drachenei? Kamelspatzenei? Vielleicht ein wenig von beidem?... Wenn es schon einen Schweinedrachen gibt, warum dann nicht auch einen Kamelspatzendrachen? Hahaha.');
INSERT INTO "item_descriptions" VALUES(15240,'de','Diese Schlappen hinterlassen das Kamazeichen auf dem feinen Sand. Wundert euch also nicht, wenn ihr von einer Horde Abenteurer auf Schnitzeljagd verfolgt werdet.');
INSERT INTO "item_descriptions" VALUES(15241,'de','Mit diesem Gürtel könnt ihr euch theoretisch neue Freunde machen. Freunde, die euch sofort vergessen, sobald ihnen einleuchtet, dass ihr völlig abgebrannt seid.');
INSERT INTO "item_descriptions" VALUES(1015243,'de','Der Griesbrabbel ist ein Allround-Reitbegleiter. Er kann euch überallhin transportieren und widersteht jedem Klima. Fallt ihr allerdings herunter, so hält er nicht an! Schnallt euch daher gut fest.');
INSERT INTO "item_descriptions" VALUES(15249,'de','Dieser Vertraute funktioniert wie ein Kamadetektor. So manche Einrichtung verlangt von ihren Kunden, sich vom Schnuffel beschnüffeln zu lassen, um sicher zu gehen, dass sie auch was zu bieten haben. Er kann euch aber auch verraten: Wenn euch jemand fragt, ob ihr „mal ''n Kama“ habt, solltet ihr wenigstens einmal ehrlich sein!');
INSERT INTO "item_descriptions" VALUES(15254,'de','Grieskribbel hat ein unglaubliches Talent, wenn es darum geht, seinen Weg wieder zu finden, insbesondere in Enutrosor, wo es an bekannten Gerüchen nicht mangelt. Er wird euch also beim Herumstreunen zwischen den Goldhaufen des Gottes Enutrof sehr nützlich sein.');
INSERT INTO "item_descriptions" VALUES(15282,'de','Qyu zufolge soll diese Nuggetschleuder in der Lage sein, die Reflexe der Griesgräber zu verbessern. Hat der Major etwa vor, diese friedlichen Tiere in furchterregende Kriegsbestien zu verwandeln? Ihr habt leider nicht daran gedacht, ihm diese Frage zu stellen.');
INSERT INTO "item_descriptions" VALUES(15356,'de','Dieser Hut ist äußerst mächtig. Wenn ihr damit euren Kopf in den Sand hinein steckt, dann macht er euch unsichtbar!');
INSERT INTO "item_descriptions" VALUES(15357,'de','Dies ist eine geniale Methode, um den Blick eures Gegenübers auf eure Gürtellinie zu richten. Allerdings könnte es vorkommen, dass euch böse Absichten unterstellt werden...');
INSERT INTO "item_descriptions" VALUES(15358,'de','Dieser Ring ist eine ständige Erinnerung daran, dass es auf gewisse Fragen keine klare Antwort gibt...');
INSERT INTO "item_descriptions" VALUES(15359,'de','Dieser Umhang aus echten Kranmelspatzenfedern verdoppelt sein Volumen bei Feuchtigkeit. Nutzt ihn also lieber nicht als Handtuchersatz, falls ihr vermeiden wollt, nicht mehr vom Fleck zu kommen.');
INSERT INTO "item_descriptions" VALUES(15360,'de','Diese Stiefel verursachen dieselben Laute, wie die Brunftlaute von Kamelspatzen während der Paarungszeit. Wundert euch also nicht, wenn sich alles Geflügel in der Umgebung auf einmal für euch interessiert.');
INSERT INTO "item_descriptions" VALUES(15361,'de','Mit diesem Amulett um den Hals fehlen nur noch ein paar Federn und schon könnte man euch mit einem echten Kranmelspatzen verwechseln!');
INSERT INTO "item_descriptions" VALUES(15422,'de','Also zum Putzen ist dieser Gegenstand nicht geeignet, er wurde nicht für einen so trivialen Zweck hergestellt.');
INSERT INTO "item_descriptions" VALUES(15428,'de','Diese Stiefel werden vor allem von Kriminellen bevorzugt: ausreichend leise, um sich überall unbemerkt hinschleichen zu können und ausreichend bequem, um nach einer Missetat den Erfolg mit einem improvisierten Tänzchen feiern zu können.');
INSERT INTO "item_descriptions" VALUES(15429,'de','Dieser Gürtel ist zwar sehr schlicht, aber er ist vor allem das Symbol der Zugehörigkeit seines Trägers zum Adel von Srambad. Egal wie dieser ihn an sich gebracht hat.');
INSERT INTO "item_descriptions" VALUES(15430,'de','Dieser Umhang ist leicht fluoreszierend. Damit kann sein Träger im Dunkeln leicht ausfindig gemacht werden. Außerdem ist er so leicht gewebt, dass man ihn beim Tragen nahezu unbemerkt bleibt. Diese zwei Eigenschaften machen sich so manche Übeltäter aus Srambad zunutze, um (vom Aperirel Uridnac-Fisch inspiriert) ein Opfer markieren, indem sie diesem den Umhang diskret um den Rücken legen.');
INSERT INTO "item_descriptions" VALUES(15431,'de','Man fragt sich, wie Gain überhaupt etwas sehen kann, denn sein Hut bedeckt seine Augen vollständig. Aber wenn man ihn vor sich stehen hat, ist es im Allgemeinen oft so, dass man keine Zeit hat, diese Frage zu stellen.');
INSERT INTO "item_descriptions" VALUES(15432,'de','Dieser Gürtel wird von Gain in Wirklichkeit als Hose benutzt, aber was euch betrifft, ist er für euch ein wenig zu eng.');
INSERT INTO "item_descriptions" VALUES(15433,'de','Gain ist eine Spielernatur und sein Amulett ist eine potentielle Waffe gegen ihn selbst! Man muss nur an der Kette ziehen und er wird gelähmt. Natürlich kann er es sich erlauben, solche Risiken einzugehen, denn jene sie es gewagt haben, sich ihm so nahe zu nähern haben es immer bitter bereut.');
INSERT INTO "item_descriptions" VALUES(15434,'de','Die Königin der Diebe hat ihren Anhängern einst eine Herausforderung gestellt, in der es darum ging, einen Stoffstreifen aus ihrem Gürtel zu stehlen. Da Keiner wirklich den Mumm dazu hatte, sich ihr anzunähern, gab sie die Idee aus Langeweile wieder auf. Seitdem aber hat sich auf Düsterhof eine recht seltsame Gewohnheit eingebürgert: man fing an, leicht heraushängende Schals an die eigenen Gürtel zu binden, die die anderen Nachahmer an sich nehmen konnten.');
INSERT INTO "item_descriptions" VALUES(15435,'de','Wie jeder Kriminelle, der was auf sich hält, besitzt auch die Königin der Diebe ein Paar Stiefel, die ihrem Berufstand entsprechen: praktisch und vor allem leise. Naja, ihre Stiefel sind außerdem allererste Sahne.');
INSERT INTO "item_descriptions" VALUES(15436,'de','Diese Haube ist vor allem für jene Personen interessant, die nur sehr wenig Haare haben: bei windigem Wetter verleiht es den Eindruck, das ihr Haar im Wind weht.');
INSERT INTO "item_descriptions" VALUES(15437,'de','Die Garstibös müssen sich manchmal in recht unwegsame Ecken von Srambad begeben und haben daher diese leicht erhöhten Stiefel konzipiert, um in jeder Situation gewappnet zu sein, solange sie ländliches Gebiet nicht betreten.');
INSERT INTO "item_descriptions" VALUES(15438,'de','Man sagt, dass die äußere Erscheinung der Garstibös auf die der Meister Röhrlinge zurückzuführen sind, jedenfalls ist die Ähnlichkeit verblüffend.');
INSERT INTO "item_descriptions" VALUES(15439,'de','Wenn es um eine Beschreibung dieses Umhangs geht, wäre "abgerissen" eine leichte Beschönigung.');
INSERT INTO "item_descriptions" VALUES(15440,'de','Bei Wresstelkämpfen ist dieser Ring die einzige offiziell erlaubte Waffe. Man muss zugeben, die sternförmigen Verletzungen, die sie hinterlässt, sehen wirklich schick aus!');
INSERT INTO "item_descriptions" VALUES(15441,'de','Die Haupteigenschaft dieser Stiefel liegt in ihrem Lärm, den sie veranstalten. Im Wresstling ist das ein wichtiges Element, denn es verspricht spektakuläre Auftritte der Gegner.');
INSERT INTO "item_descriptions" VALUES(15442,'de','Dies hier ist eine Maske, die der des Hauptmann Rot-Teka gleicht. In Wirklichkeit ist sich niemand wirklich sicher, dass er eine Maske trägt, auch wenn das aufgrund seiner fehlenden Gesichtsausdrücke eine wahrscheinliche Hypothese ist.');
INSERT INTO "item_descriptions" VALUES(15469,'de','Seit Generationen sind alle Mitglieder der Familie Homlet Knechte eines mächtigen Nekromanten. Sie sind ihrem Herrn sosehr ergeben, dass sie ihm sogar nach ihrem Dahinscheiden dienen - als sprechende Schädel. Das ist wahre Treue bis in den Tod. Sein oder Nichtsein, das ist keine Frage, die die Homlet sich stellen.');
INSERT INTO "item_descriptions" VALUES(15493,'de','Legenden zufolge wurden diese Dolche von Sram geordert, wobei er für seine Anhänger seine eigenen Dolche als Modell nahm.  Der Erfolg dieser Kopien veranlasste die Bewohner von Srambad dazu, ihren eigenen Handel mit Fälschungen zu treiben, wobei nicht einmal versucht wurde, diese als authentisch auszugeben.');
INSERT INTO "item_descriptions" VALUES(15494,'de','Diese Schaufel wird dazu benutzt Gegenstände zu verbuddeln, tot oder lebendig.');
INSERT INTO "item_descriptions" VALUES(15495,'de','Dieser Bogen verursacht Schaden, ohne dass die Ziele etwas davon bemerken. Da eure Gegner die Pfeile nicht spüren, werden sie sich nur schwer überleben.');
INSERT INTO "item_descriptions" VALUES(15496,'de','Dieses Schwert ist zwar recht imposant, aber dennoch handlich. Das ist der Grund, warum die Königin der Diebe es immer bei sich trägt. Manche erzählen sogar, dass sie ihm Dinge anvertrauen würde und dass sie die besten Freunde seien.');
INSERT INTO "item_descriptions" VALUES(15499,'de','Darf nur im Notfall benutzt werden. Dieses Schmuckstück enthält ein starkes Gift, das euch je nach Situation das Leben versauern oder retten kann.');
INSERT INTO "item_descriptions" VALUES(15500,'de','Diese Stiefel wurden außerhalb von Srambad durch eine Sadida-Lobby verboten, denn sie lassen alle Pflanzen verfaulen, die ihr zertretet. Auch wenn es ein paar Nebenwirkungen gibt, so ist es ein wirkungsvolles Unkrautvernichtungsmittel.');
INSERT INTO "item_descriptions" VALUES(15501,'de','Die Nekroten machen ihre Verbündeten über ihren Geruch aus und dieser Umhang ist damit durchsetzt. Das Dumme ist, das dieser Geruch von den Giften ausgeht und es eher schädlich ist, wenn man versucht, sich damit zu durchtränken.');
INSERT INTO "item_descriptions" VALUES(15502,'de','Diese Stiefel werden eurem Fusspilzproblem sicher nicht beikommen.');
INSERT INTO "item_descriptions" VALUES(15503,'de','Alle Experten behaupten, dass Dremoan essbar sei, aber so richtig probieren wollte noch niemand. Die Farbe lässt darauf schließen, Dremoan könne radioaktiv sein.');
INSERT INTO "item_descriptions" VALUES(15504,'de','Mit diesem Umhang ausgerüstet könnt ihr stolz zeigen, dass ihr die Schlimmste alle Gefahren des Versteinerten Waldes besiegt habt. Behaltet ihn aber nicht zu lange auf eurem Rücken. Niemand weiß genau, woraus Dremoan besteht und das könnte euch ins Verderben stürzen.');
INSERT INTO "item_descriptions" VALUES(15505,'de','Es liegt an euch, dafür zu sorgen, dass euch alle Nekroten ins Netz gehen!');
INSERT INTO "item_descriptions" VALUES(15506,'de','Man könnte glauben, dieser Gürtel sei dazu da, um dem Hauptmann Rot-Teka an Ort und Stelle zu halten, aber immer wieder fällt er euch von den Hüften.');
INSERT INTO "item_descriptions" VALUES(15507,'de','Bereitet euch auf unglaubliche Rutschpartien vor, denn diese Stiefel haften nur schlecht auf dem Boden und das sorgt für spektakuläre Auswirkungen. Der Hauptmann Rot-Teka ist so schon mehr als einmal aus gefährlichen Situationen herausgekommen.');
INSERT INTO "item_descriptions" VALUES(15508,'de','Diese Handschuhe verleihen ihrem Träger gleich ein beunruhigendes Aussehen. Wundert euch also nicht, wenn man euch plötzlich aus dem Weg geht.');
INSERT INTO "item_descriptions" VALUES(15514,'de','Mit diesem Helm auf dem Kopf werdet ihr zum Schrecken der Sümpfe. Der viele Rauch, der in Momenten intensiven Nachdenkens aus eurem Kopf steigt, wird aus den Nasenhöhlen kommen und euch so noch bedrohlicher erscheinen lassen.');
INSERT INTO "item_descriptions" VALUES(15518,'de','Ali Grothor wird in ganz Amakna gesucht. Daher trägt er auch diese Amulett, sozusagen als ständige Erinnerung daran, was geschehen würde, wenn er sein Exil im Moor von Otomaï verlassen würde.');
INSERT INTO "item_descriptions" VALUES(15523,'de','Ali Grothor gehörte noch nie zu den ganz Sauberen und sein Umhang ist der Beweis: es sieht so aus, als sei er als Hand- oder Taschentuch benutzt worden, um Sudeleien aller Art aufzuwischen.');
INSERT INTO "item_descriptions" VALUES(15524,'de','Wenn man diese Maske in den Händen hält, wird einem der Ruf Frakassuras bewusst: er ist ausgestopft, um ihre Kopfstöße noch mörderischer werden zu lassen.');
INSERT INTO "item_descriptions" VALUES(15525,'de','Frakassura sammelt leidenschaftlich gerne Schuhe aber liebt die Abwechslung nicht. Hier also ein Einzelstück aus ihrer enormen Sammlung. Sie besitzt davon 1337 Exemplare.');
INSERT INTO "item_descriptions" VALUES(15526,'de','Da sie sich nicht gerne die Hände schmutzig macht, trennt sich Frakassura nie von ihren Handschuhen.');
INSERT INTO "item_descriptions" VALUES(15548,'de','Nur wenige Fans würden so weit gehen und einen Gürtel in den Farben ihrer Lieblingsmannschaft tragen. Da liegt auch der Unterschied zwischen einem Fan und einem Cheerleader.');
INSERT INTO "item_descriptions" VALUES(15549,'de','Dieses recht diskrete Amulett ist vor allem für schüchterne Fans reserviert oder all jene, die sich noch nicht trauen zu ihrer Lieblingsmannschaft zu stehen: Falls sich ihr Lieblingsfressballer mal vertut, kann man das Amulett leicht verschwinden lassen.');
INSERT INTO "item_descriptions" VALUES(15607,'de','Dieser Vertraute rollt sich bei Gefahr zu einer Kugel zusammen. Je nach Bodenneigungswinkel rollt er in eine zufällige Richtung, was mitunter ein hervorragendes Ablenkungsmanöver sein kann.');
INSERT INTO "item_descriptions" VALUES(15660,'de','Diese Mininuit-Messer sind keine Kampfmesser.');
INSERT INTO "item_descriptions" VALUES(15692,'de','Diese Stiefel verströmen einen Geruch nach Meer.');
INSERT INTO "item_descriptions" VALUES(15693,'de','Diese Schuhe kommen oft bei verschneitem oder vereisten Gelände zum Einsatz: sie haben eine hohe Haftung und versinken nicht im Schnee');
INSERT INTO "item_descriptions" VALUES(15694,'de','Jetzt können Abenteurer Kidibom sogar auf dem Kopf tragen.');
INSERT INTO "item_descriptions" VALUES(15695,'de','Wie aus einer anderen Welt und noch orangefarbener als ein Küwbis, wird diese Maske an Höll O''Feen zum Renner.');
INSERT INTO "item_descriptions" VALUES(15696,'de','Mit diesem Umhang fühlt ihr euch so, wie ein Fisch im Wasser. Aber weniger hydrodynamisch, wegen dem Gewicht.');
INSERT INTO "item_descriptions" VALUES(15697,'de','Besteht aus Krobenteilchen, man sollte daher beim Tragen dieses Umhangs einen soliden Magen haben, sonst werdet ihr noch zum Hypochonder.');
INSERT INTO "item_descriptions" VALUES(15698,'de','Pol Tawnos trägt diesen Ring immer bei sich, um sich ständig vor Augen zu halten, dass selbst winzige scheinende Tiere ihre Wichtigkeit haben. Und auch weil es schwieriger war, einen Ring aus einem Fisch anzufertigen.');
INSERT INTO "item_descriptions" VALUES(15699,'de','Der Orcürtel passt eher zu grösser gebauten Taillen. Aber im Gegensatz zu anderen Gürteln, bläst sich dieser hier auf und drückt sich an seinen Träger, was ihm zusätzliches Volumen verleiht. Daher kann er auch als Rettungsring eingesetzt werden.');
INSERT INTO "item_descriptions" VALUES(15700,'de','Dieser durchsichtige Lendenschurz ist besonders bei Exhibitionisten beliebt: Man hat den Eindruck, nicht splitternackt zu sein, aber er verbirgt auch absolut nichts.');
INSERT INTO "item_descriptions" VALUES(15701,'de','Als Symbol der Seechafer wird dieses Amulett von ihrem Kapitän getragen. Angeblich kann man damit mit den mächtigen Meerestieren kommunizieren, aber letztere sind nicht sehr gesprächig.');
INSERT INTO "item_descriptions" VALUES(15737,'de','Es heißt, mit etwas Training soll der Träger dieser Kette seinen Kopf um bis zu 360° drehen können. Doch die wenigen, denen das bisher erwiesenermaßen gelungen ist, weilen inzwischen alle nicht mehr unter den Lebenden...');
INSERT INTO "item_descriptions" VALUES(15738,'de','Der Legende nach soll dieser Hut das Nonplusultra beim Sonnenschutz sein. Dummerweise lässt er sich nur nachts einsetzen, da er tagsüber seltsamerweise transparent wird.');
INSERT INTO "item_descriptions" VALUES(15739,'de','Huh, was ist das uh für ein schöner Uhumhang?!');
INSERT INTO "item_descriptions" VALUES(15740,'de','Vorsicht: Dieser Ring knabbert euch gerne die Fingerkuppen ab, ohne dass ihr etwas davon mitkriegt. Also passt gut auf, wann ihr ihn wo tragt...');
INSERT INTO "item_descriptions" VALUES(15741,'de','Mit diesen Stiefeln werdet ihr euch nicht leichter fühlen. Und schon gar nicht vom Boden abheben, um euch in die Sonne zu stürzen. Sprich: Sie haben euch soeben das Leben gerettet!');
INSERT INTO "item_descriptions" VALUES(15742,'de','Dieser Helm mit seinem klassischen Raubvogellook sollte nur dann getragen werden, wenn ihr auch wirklich bereit seid, eure wahre Natur zu offenbaren!');
INSERT INTO "item_descriptions" VALUES(15743,'de','Schon seit langem kann Vortex diesen Gürtel nicht mehr tragen. Eines Tages wird es euch sicherlich ebenfalls so gehen...');
INSERT INTO "item_descriptions" VALUES(15744,'de','Diese netten Treter ermöglichen es euch, selbst bei einem Sprung von über 20 Kametern ganz sanft zu landen. Versucht es doch auch mal!');
INSERT INTO "item_descriptions" VALUES(15745,'de','Mit dieser Kapuze seht ihr aus wie Vortex, auch wenn ihr nicht seid wie Vortex. Jetzt fehlt euch nur noch der passende Bauch, dann könnte man euch glatt mit ihm verwechseln.');
INSERT INTO "item_descriptions" VALUES(15746,'de','Dieses Amulett "sieht" die Zukunft voraus und kann auf jede Aktion entsprechend reagieren. Nur dumm, dass es nicht in der Lage ist zu kommunizieren!');
INSERT INTO "item_descriptions" VALUES(15747,'de','Es heißt, einzelnen Irrläufern seien Flügel gewachsen, nachdem sie eine zu große Menge Bettnull-Trank in sich hineingeschüttet haben. Dieser Umhang bewirkt einen teilweise ähnlichen Effekt – was euch möglicherweise nicht unbedingt besonders zuträglich ist.');
INSERT INTO "item_descriptions" VALUES(15748,'de','Dieses Schuhwerk schützt hervorragend vor den während langer Zeitreisen entstehenden Blitzen. Aber Freunde finden werdet ihr damit nicht...');
INSERT INTO "item_descriptions" VALUES(15749,'de','Wenn jemand diesen Talisman 42 Stunden ohne Unterbrechung anstarrt, dann verliert er seinen eigenen Willen und ihr kontrolliert ihn dann!');
INSERT INTO "item_descriptions" VALUES(15750,'de','Pssst. Ja, du. Nicht offen tragen! Ist nämlich kein Ring, sondern ein Gurt - wegen der Tarnung!');
INSERT INTO "item_descriptions" VALUES(15751,'de','O''Wresselnie war ein fähiger Magier, der es versteht, das Publikum seiner Vorführungen zu begeistern. Und dies sind seine Schuhe!');
INSERT INTO "item_descriptions" VALUES(15762,'de','Mit diesen Stiefeln könnt ihr Gegnern 42-mal schneller in den Hintern treten, als mit euren üblichen Tretern!');
INSERT INTO "item_descriptions" VALUES(15764,'de','In Anbetracht der außergewöhnlich spitzen Dämonenhörner dieses Gürtels, wird es niemand wagen, euch in irgendeiner Form näher zu kommen.');
INSERT INTO "item_descriptions" VALUES(15768,'de','Sobald jemand von euch die Antwort auf die Große Frage über das Leben, das Universum und den ganzen Rest verlangt, dann verpasst ihm einfach mit diesem Ring eine Ohrfeige!');
INSERT INTO "item_descriptions" VALUES(15771,'de','Je nach Blickwinkel unterstreicht dieser Gürtel entweder eure männliche oder oder lächerliche Ader!');
INSERT INTO "item_descriptions" VALUES(15773,'de','Diese Mütze verleiht euch trotz ihres dämonischen Ursprungs und der bedeutenden, ihr innewohnenden Macht das Aussehen des Sängers einer Boygroup. Naja, man kann eben nicht alles haben!');
INSERT INTO "item_descriptions" VALUES(15776,'de','Wie jeder Abenteurer, der warme Füße zu schützen weiß, geht nichts über diese gefütterten, mit Dämonenfell ausgekleideten Pantoffeln!');
INSERT INTO "item_descriptions" VALUES(15778,'de','"Dadadadada... Fraktaaaaale!" Dideldum, dideldum. Ja, wie ihr seht, hinterlassen Fraktalgegenstände nicht nur bei Mathematikern schwere geistige Schäden...');
INSERT INTO "item_descriptions" VALUES(15779,'de','Um in der Zeit zu reisen, genügt es diesen Stab bei einem schweren Gewitter einfach hochzuhalten. Alle, die das versucht haben, sind mit einem grellen Aufblitzen verschwunden. Ein Zeichen, dass es funktioniert!');
INSERT INTO "item_descriptions" VALUES(15780,'de','Dieser Gürtel besitzt faszinierende Eigenschaften wie beispielsweise jene, das eigene Mofiv unendlich oft zu  wiederholen. Äußerst praktisch, um Gegner zu hypnotisieren.');
INSERT INTO "item_descriptions" VALUES(15781,'de','Paradoxerweise lässt sich dieser Hammer am besten mit der spitzen Seite voran einsetzen.');
INSERT INTO "item_descriptions" VALUES(15782,'de','Wer diese Waffe einem Szepter gleich in der Hand hält, wird von allen Gegnern in Ruhe gelassen. Aber leider gibt es noch so viele andere Arten, durch die man ums Leben kommen kann...');
INSERT INTO "item_descriptions" VALUES(15783,'de','Diesem von Natur aus äußerst zerbrechlichen Ring entströmt eine gewaltige Macht! Passt gut auf, dass er euch nicht in tausend Stücke zerfällt!');
INSERT INTO "item_descriptions" VALUES(15784,'de','Dieser Ring wird allen anderen beweisen, dass es nur noch ein Wesen gibt, das sie fürchten müssen, nämlich euch!');
INSERT INTO "item_descriptions" VALUES(15789,'de','Ein Xélormorph, der einen mit seinen leuchtenden Augen anstarrt ist schon ein erschreckender Anblick... Jetzt stellt euch einmal vor, wie sehr eure Gegner diese Stiefel fürchten müssen!');
INSERT INTO "item_descriptions" VALUES(15791,'de','Dieser halb durchsichtige Umhang passt sich dem Aussehen seines Trägers an und lässt diesen umso eindrucksvoller erscheinen.');
INSERT INTO "item_descriptions" VALUES(15794,'de','Niemand weiß genau, warum das so ist, aber alle Träger dieses Helms verspürten bisher ein plötzliches, starkes Verlangen nach Eicheln.');
INSERT INTO "item_descriptions" VALUES(15795,'de','Ideal für Wald- und Wiesenwanderungen. Mit diesen Stiefeln werdet ihr sofort als Freund aller Tiere akzeptiert werden!');
INSERT INTO "item_descriptions" VALUES(15796,'de','Dieses Amulett wurde aus der Schwanzspitze von Scratshahorntas gefertigt. Seitdem könnt ihr nicht mehr aufhören, ständig darüberzustreicheln, so flauschig weich ist sie!');
INSERT INTO "item_descriptions" VALUES(15860,'de','Kreativgeister schwören auf dieses Gerät. Erst überkommt sie die Erleuchtung und dann sind sie in der Lage blitzschnell zu arbeiten.');
INSERT INTO "item_descriptions" VALUES(15886,'de','Der Temporal-Synchronisator im Kopf dieses Hammers ist eine bahnbrechende Erfindung von Doc "Memme" T. Braun, auch wenn er selbst nicht genau sagen kann, wozu das Ding gut sein könnte.');
INSERT INTO "item_descriptions" VALUES(15978,'de','"Du kommst nicht vorbei!" 
Bei den Worten geht diesem kleinen Vertrauten das Herz auf. Allerdings solltet ihr lieber nicht erwarten, dass er sich aufopfert, um euch vor dem sicheren Tod zu bewahren. Dazu ist er weder groß noch mutig genug.');
INSERT INTO "item_descriptions" VALUES(15990,'de','Wenn es heiß hergeht macht ihr euch lieber klein? Leidet ihr unter Größenwahn? Der Winzlingsstab ist da genau das Richtige für euch. Damit könnt ihr euch auch in unzugängliche Orte reinschlüpfen... bald werden Mäuselöcher kein Geheimnis mehr für euch sein.');
INSERT INTO "item_descriptions" VALUES(15992,'de','Wenn ihr beim Säubern dieses Ringes das Aufsteigen goldenen Staubes bemerken solltet, dann konzentriert euch schnell auf etwas Schönes! Es ist nämlich möglich, dass ihr dann anfangt zu schweben - wie durch Zauberei!');
INSERT INTO "item_descriptions" VALUES(15993,'de','Ihr habt ein Faible für Streichhölzer? Ihr seid ein Liebhaber der Bildenden Künste? Dann ist dieser Umhang genau das Richtige für euch! An rauen Oberflächen solltet ihr euch damit aber besser nicht reiben, sonst macht euch der Umhang Feuer unterm Hintern!');
INSERT INTO "item_descriptions" VALUES(15994,'de','Dieser Helm ist der letzte Schrei der Mode. Aber dem Garstinsekt hat dies trotzdem nichts genutzt... also seid auf der Hut...');
INSERT INTO "item_descriptions" VALUES(15995,'de','Auch als Halskette getragen, macht sich diese Perle sehr gut. Ein guter Weg seinen Ohrring zu recyclen, nachdem man das zweite Exemplar verloren hat.');
INSERT INTO "item_descriptions" VALUES(15996,'de','Diese spritzenförmige Halskette verleiht jedem, der sie einzusetzen vermag, die Fähigkeit, selbst schwerste Verletzungen zu heilen.');
INSERT INTO "item_descriptions" VALUES(15997,'de','Die Flüssigkeit in diesem Gürtel besitzt hervorragende Heileigenschaften. Mit ihr soll man selbst schwerste Rückenschmerzen in Nullkommanix wegheilen können.');
INSERT INTO "item_descriptions" VALUES(15998,'de','Wenn ihr mal angespannt seid, dann rubbelt einfach mit diesem Ring auf eurer Haut herum und schon lockern sich eure Muskeln, während ein angenehm leichter Duft nach frischer Minze ausströmt.');
INSERT INTO "item_descriptions" VALUES(15999,'de','Rosarosapanta pflegte einst ihre wahre Identität mit Hilfe dieser Maske zu verbergen. Doch nicht nur das, sondern auch ihre Schönheit. Andernfalls hätte sie vermutlich die Köpfe aller männlichen Kreaturen in Sichtweite verdreht.');
INSERT INTO "item_descriptions" VALUES(16003,'de','Dieses Gürtel mag zwar auf dem ersten Blick harmlos aussehen, doch gibt er eine tolle Peitsche ab!');
INSERT INTO "item_descriptions" VALUES(16004,'de','Ideal für jeden Einbruch! Denn dieser Ring ist scharf wie Diamant.');
INSERT INTO "item_descriptions" VALUES(16005,'de','Mit diesem Ring wisst ihr immer, wieviel Druck auf euch lastet. Außerhalb des Wassers ist er jedoch weniger nützlich, es sei denn ihr seid Hobby-Meteorologe!');
INSERT INTO "item_descriptions" VALUES(16006,'de','Diese Stiefel entstammen einer überlegenen Technologie. Damit bleiben eure Füße immer im Trockenen!');
INSERT INTO "item_descriptions" VALUES(16007,'de','Dank dieser Maske bringt ihr Licht ins Dunkel. Außerdem leidet ihr beim Tauchen nie unter Sauerstoffmangel.');
INSERT INTO "item_descriptions" VALUES(16061,'de','Der Schöpfer dieses Dofus hatte nur noch eine nebelhafte Vorstellung davon, wie ein authentisches Drachenei aussieht. Wer es anfasst, kann verlorene Erinnerungen wiedergewinnen. Das ist so, wie zum ersten Mal nach vielen Jahren wieder in eine Madeleine von Marcel Roust zu beißen. So könnt ihr noch einmal eure Ankunft in Incarnam erleben oder wie ihr das erste Mal ein Fresssäckchen erledigt habt ... Ach, das waren Zeiten!');
INSERT INTO "item_descriptions" VALUES(16116,'de','Das Eliotöffelchen ist ein schelmischer, geschwätziger Geist, der in der Nähe der Portale der Eliotropen erscheint. Der Legende nach soll es eine umherirrende Seele sein, die noch nicht bereit für die Reinkarnation ist. Doch obwohl das Eliotöffelchen lästig sein und einem mitunter richtig auf die Nerven fallen kann, ist es im Grunde genommen nicht bösartig ... Es gefällt ihm nur einfach, den Leuten mit seiner schrillen Stimme ständig in den Ohren zu liegen.');
INSERT INTO "item_descriptions" VALUES(16122,'de','Die Drakumpel wurden unter den Wassern von Sufokia in einer riesigen und von den Eliotropen entdeckten Höhle geboren. Diese liebesbedürftigen Mini-Drachen sind äußerst anhänglich und besonders treue Begleiter. Wenn ein Drakumpel euch auserwählt hat, weicht er euch das ganze Leben lang niemals mehr von der Seite! Beim abendlichen Umtrunk mit anderen Abenteurern wird er mit seinen Grimassen für gute Stimmung sorgen.');
INSERT INTO "item_descriptions" VALUES(16140,'de','Der Gebrauch dieser Maske ist nur schwer zu verstehen, wenn ihr noch nie ein Eliotrop-Portal benutzt habt. Und selbst, wenn das der Fall sein sollte, ist nicht ganz klar, wozu sie eigentlich gut sein soll ... Doch wenigstens kann man dahinter sein Gesicht verstecken und das muss für Leute wie euch ein Segen sein.');
INSERT INTO "item_descriptions" VALUES(16141,'de','Dieser Umhang bringt euch wie ein fliegender Teppich um die ganze Welt. Und was ist sein Geheimnis? Wenn ihr ihn liebevoll streichelt, öffnet er ein „Ortal“, das euch schnelleres Reisen ermöglicht. Es ist kein Eliotrop-Portal, aber immerhin besser als nichts.');
INSERT INTO "item_descriptions" VALUES(16142,'de','Mit diesen Stiefeln könnte ihr die Kräfte eurer eigenen zwei Beine nutzen, um von A nach B zu gelangen. Ist das nicht einfach unglaublich? Es ist so unglaublich, dass ihr dieses Geheimnis niemals jemandem verraten dürft. Nein, wirklich! Ehrenwort!');
INSERT INTO "item_descriptions" VALUES(16143,'de','Wenn ihr euch ganz schnell um die eigene Achse dreht, während ihr diesen Gürtel tragt, kann es sehr gut sein, dass euch etwas Überraschendes widerfährt. Von denen, die es ausprobiert haben, ist jedoch keiner mehr am Leben, sodass uns niemand etwas über diese Überraschung erzählen kann. Probiert es doch selber einmal aus!');
INSERT INTO "item_descriptions" VALUES(16144,'de','Dieser Ring, der grell wie die Sonne und mächtig wie eine Supernova ist, wird eure Eliotropen-Kräfte auf großartige und schreckliche Weise erhöhen. Ihr seid kein Eliotrop? Dann könnt ihr ihn einfach auf euren Nachttisch legen – er eignet sich auch sehr gut als Nachtlicht. Auch das steht in der Macht des Nova-Rings.');
INSERT INTO "item_descriptions" VALUES(16169,'de','Ein Holzschnitzer hatte zunächst damit begonnen, Bögen aus den dürren Zweigen herzustellen, die er im Düsterwald gesammelt hatte. Leider waren diese beim Spannen etwas zu lasch und erwiesen sich als ungeeignet für einen Einsatz durch die Ordnungskräfte. Der Schnitzer verlegte sich also auf die Fertigung von Knüppeln aus den Ästen von Weich-Eich. Die steinharten Waffen fanden bei den Ausbildern von Brâkmar sofort großen Anklang und werden von ihnen bis heute verwendet, um undisziplinierte Chafer zu strafen.');
INSERT INTO "item_descriptions" VALUES(16171,'de','Ein Mantel, der eigens für jene gedacht ist, die ihren Mantel lieber verbergen? Was hat man nicht schon alles gesehen! Oder in diesem Fall wohl eher nicht gesehen.');
INSERT INTO "item_descriptions" VALUES(16172,'de','Eine äußerst praktische Kopfbedeckung, damit auch alle eure opulente Haarpracht – oder beginnende Glatze – bewundern können. Wie ihr euch denken könnt, ist diese Mütze vor allem für Abenteurer gedacht, die exhibitionistisch veranlagt sind oder nicht allzu viele Hemmungen haben.');
INSERT INTO "item_descriptions" VALUES(16173,'de','Eure Schwiegermutter leidet an Arachnophobie? Herzlichen Glückwunsch, ihr habt das ideale Geschenk für ihren nächsten Geburtstag gefunden! Und mit etwas Glück wird es vielleicht ihr letzter sein...');
INSERT INTO "item_descriptions" VALUES(16174,'de','Diese weichen und geschmeidigen Stiefel sind äußerst bequem. Leider geht ihr damit das Risiko ein, dass euch des Öfteren Leute auf die Füße treten, die kleine, über den Fußboden krabbelnde Viecher hassen.');
INSERT INTO "item_descriptions" VALUES(16175,'de','Dieser Hut hat bei der letzten Haute-Couture-Modenschau, die von den Schwarzen Witwen in Brâkmar veranstaltet wurde, einen großen Erfolg erzielt.');
INSERT INTO "item_descriptions" VALUES(16176,'de','Manche behaupten, dieser Talisman helfe bei Sehstörungen; andere wiederum sagen, er sorge lediglich dafür, dass die Probleme sich vervielfachen. Wer wohl recht hat? Das ist alles eine Frage der Perspektive.');
INSERT INTO "item_descriptions" VALUES(16177,'de','Wenn ihr Newark dem Jäger über den Weg lauft, während ihr diese Kappe tragt, verwechselt er euch womöglich mit einem Anhänger von Arachneeman und verpasst euch eine kräftige Abreibung. Aber es steht euch natürlich frei, zu tun, was ihr für richtig haltet.');
INSERT INTO "item_descriptions" VALUES(16178,'de','Dieser furchterregende Gürtel, der euch das Aussehen eines vielbeinigen Spinnenmonsters verleiht, wird dafür sorgen, dass eure Feinde die Beine in die Hand nehmen!');
INSERT INTO "item_descriptions" VALUES(16182,'de','Deine Feinde werden nicht passieren! Aber es ist gut möglich, dass ihnen etwas passiert...');
INSERT INTO "item_descriptions" VALUES(16183,'de','Deine Feinde werden nicht passieren! Aber es ist gut möglich, dass ihnen etwas passiert...');
INSERT INTO "item_descriptions" VALUES(16184,'de','Deine Feinde werden nicht passieren! Aber es ist gut möglich, dass ihnen etwas passiert...');
INSERT INTO "item_descriptions" VALUES(16185,'de','Diese Trophäe wird euch bei eurer Wüstendurchquerung leider nichts bringen.');
INSERT INTO "item_descriptions" VALUES(16186,'de','Diese Trophäe wird euch bei eurer Wüstendurchquerung leider nichts bringen.');
INSERT INTO "item_descriptions" VALUES(16187,'de','Diese Trophäe wird euch bei eurer Wüstendurchquerung leider nichts bringen.');
INSERT INTO "item_descriptions" VALUES(16188,'de','Diese Trophäe wird euch helfen, eure Verbündeten zu heilen und ihnen nützliche Ratschläge zu geben: "Ein großes Glas Glühwein heilt alle Zipperlein, und eine große Schüssel Schafsurin heilt alle Frakturen."');
INSERT INTO "item_descriptions" VALUES(16189,'de','Diese Trophäe wird euch helfen, eure Verbündeten zu heilen und ihnen nützliche Ratschläge zu geben: "Ein großes Glas Glühwein heilt alle Zipperlein, und eine große Schüssel Schafsurin heilt alle Frakturen."');
INSERT INTO "item_descriptions" VALUES(16190,'de','Diese Trophäe wird euch helfen, eure Verbündeten zu heilen und ihnen nützliche Ratschläge zu geben: "Ein großes Glas Glühwein heilt alle Zipperlein, und eine große Schüssel Schafsurin heilt alle Frakturen."');
INSERT INTO "item_descriptions" VALUES(16191,'de','Besser Überlebenskünstler als verlebter Künstler.');
INSERT INTO "item_descriptions" VALUES(16192,'de','Besser Überlebenskünstler als verlebter Künstler.');
INSERT INTO "item_descriptions" VALUES(16193,'de','Besser Überlebenskünstler als verlebter Künstler.');
INSERT INTO "item_descriptions" VALUES(16194,'de','Der Schaum vor dem Mund wird euch helfen, die Spuren eines Schnelms zu imitieren, wenn ihr in den Staub beißt.');
INSERT INTO "item_descriptions" VALUES(16195,'de','Der Schaum vor dem Mund wird euch helfen, die Spuren eines Schnelms zu imitieren, wenn ihr in den Staub beißt.');
INSERT INTO "item_descriptions" VALUES(16196,'de','Der Schaum vor dem Mund wird euch helfen, die Spuren eines Schnelms zu imitieren, wenn ihr in den Staub beißt.');
INSERT INTO "item_descriptions" VALUES(16202,'de','Verbündet euch mit den Bworks, um zum Intellektuellen der Gruppe zu werden.');
INSERT INTO "item_descriptions" VALUES(16203,'de','Verbündet euch mit den Bworks, um zum Intellektuellen der Gruppe zu werden.');
INSERT INTO "item_descriptions" VALUES(16204,'de','Verbündet euch mit den Bworks, um zum Intellektuellen der Gruppe zu werden.');
INSERT INTO "item_descriptions" VALUES(16209,'de','Ursprünglich bedeutete der Besitz eines Bündnisrings der Förster, dass man sich für einen bestimmten Lebensstil entschieden hatte: unter freiem Himmel schlafen, auf die Bäume klettern, Pilze essen, sich im Moos wälzen... Aber seit manche ihn nur noch aus ästhetischen Gründen tragen, hat sich sein Gebrauch banalisiert. Dennoch ist er auch weiterhin ein Symbol der Rückkehr zur Natur.');
INSERT INTO "item_descriptions" VALUES(16239,'de','Diese Stiefel sollen das Gewicht ihres Trägers verringern. Seit ihrem Verkaufsstart ist folglich auch eine deutliche Senkung der Sterblichkeitsrate junger Sprosse durch Niedertreten zu beobachten.');
INSERT INTO "item_descriptions" VALUES(16240,'de','Von dem Finger, an den ihr diesen Ring steckt, hängt auch seine Bedeutung ab. Tragt ihr ihn beispielsweise am Mittelfinger, signalisiert ihr damit eurer Umgebung, dass ihr in Blüte steht.');
INSERT INTO "item_descriptions" VALUES(16243,'de','Dieser Ausrutscher auf einer Bananenschale war doch nur ein kleiner Stunt, mit dem ihr eure Freunde aufheitern wolltet. Zwar glaubt euch das keiner, aber alle haben herzlich gelacht.');
INSERT INTO "item_descriptions" VALUES(16244,'de','Dieser Ausrutscher auf einer Bananenschale war doch nur ein kleiner Stunt, mit dem ihr eure Freunde aufheitern wolltet. Zwar glaubt euch das keiner, aber alle haben herzlich gelacht.');
INSERT INTO "item_descriptions" VALUES(16245,'de','Dieser Ausrutscher auf einer Bananenschale war doch nur ein kleiner Stunt, mit dem ihr eure Freunde aufheitern wolltet. Zwar glaubt euch das keiner, aber alle haben herzlich gelacht.');
INSERT INTO "item_descriptions" VALUES(16246,'de','Ihr hattet eine 99%ige Chance, ein halbleeres Glas zu erhalten, und man hat euch ein halbvolles Glas serviert. Was für ein Glück!');
INSERT INTO "item_descriptions" VALUES(16247,'de','Ihr hattet eine 99%ige Chance, ein halbleeres Glas zu erhalten, und man hat euch ein halbvolles Glas serviert. Was für ein Glück!');
INSERT INTO "item_descriptions" VALUES(16248,'de','Ihr hattet eine 99%ige Chance, ein halbleeres Glas zu erhalten, und man hat euch ein halbvolles Glas serviert. Was für ein Glück!');
INSERT INTO "item_descriptions" VALUES(16249,'de','Diesem Schrecken des Sandkastens, der damals eure schöne Burg mit seiner Faust der Rache zerstört hat, habt ihr ein Trauma fürs Leben zu verdanken. Es ist an der Zeit, ihn für diesen Frevel büßen zu lassen.');
INSERT INTO "item_descriptions" VALUES(16250,'de','Diesem Schrecken des Sandkastens, der damals eure schöne Burg mit seiner Faust der Rache zerstört hat, habt ihr ein Trauma fürs Leben zu verdanken. Es ist an der Zeit, ihn für diesen Frevel büßen zu lassen.');
INSERT INTO "item_descriptions" VALUES(16251,'de','Diesem Schrecken des Sandkastens, der damals eure schöne Burg mit seiner Faust der Rache zerstört hat, habt ihr ein Trauma fürs Leben zu verdanken. Es ist an der Zeit, ihn für diesen Frevel büßen zu lassen.');
INSERT INTO "item_descriptions" VALUES(16252,'de','Die Monster werden euch in den Hintern beißen und ihr werdet in den Staub beißen. Arme Monster!');
INSERT INTO "item_descriptions" VALUES(16253,'de','Die Monster werden euch in den Hintern beißen und ihr werdet in den Staub beißen. Arme Monster!');
INSERT INTO "item_descriptions" VALUES(16254,'de','Die Monster werden euch in den Hintern beißen und ihr werdet in den Staub beißen. Arme Monster!');
INSERT INTO "item_descriptions" VALUES(16255,'de','Wo euer Dracotruter hintritt, da wächst kein Gras mehr.');
INSERT INTO "item_descriptions" VALUES(16256,'de','Wo euer Dracotruter hintritt, da wächst kein Gras mehr.');
INSERT INTO "item_descriptions" VALUES(16257,'de','Wo euer Dracotruter hintritt, da wächst kein Gras mehr.');
INSERT INTO "item_descriptions" VALUES(16258,'de','Ihr heizt eurem Gegner ja ganz schön ein und zieht wirklich alle Register: Schimpfwörter, Provokationen, schlechte Witze und Bananenschalen.');
INSERT INTO "item_descriptions" VALUES(16259,'de','Ihr heizt eurem Gegner ja ganz schön ein und zieht wirklich alle Register: Schimpfwörter, Provokationen, schlechte Witze und Bananenschalen.');
INSERT INTO "item_descriptions" VALUES(16260,'de','Ihr heizt eurem Gegner ja ganz schön ein und zieht wirklich alle Register: Schimpfwörter, Provokationen, schlechte Witze und Bananenschalen.');
INSERT INTO "item_descriptions" VALUES(16262,'de','Ihr habt es immer schon geliebt, eure Gegner nass zu machen. Aber ihr solltet aufpassen, dass daraus kein Schlag ins Wasser wird!');
INSERT INTO "item_descriptions" VALUES(16263,'de','Ihr habt es immer schon geliebt, eure Gegner nass zu machen. Aber ihr solltet aufpassen, dass daraus kein Schlag ins Wasser wird!');
INSERT INTO "item_descriptions" VALUES(16264,'de','Ihr habt es immer schon geliebt, eure Gegner nass zu machen. Aber ihr solltet aufpassen, dass daraus kein Schlag ins Wasser wird!');
INSERT INTO "item_descriptions" VALUES(16265,'de','Manchmal ist es eben doch am besten, wenn man seinem Ärger Luft macht.');
INSERT INTO "item_descriptions" VALUES(16266,'de','Manchmal ist es eben doch am besten, wenn man seinem Ärger Luft macht.');
INSERT INTO "item_descriptions" VALUES(16267,'de','Manchmal ist es eben doch am besten, wenn man seinem Ärger Luft macht.');
INSERT INTO "item_descriptions" VALUES(16269,'de','Tanuks brauchen mehrere Jahrzehnte, bevor sie in die Pubertät kommen, in dieser Zeit werden sie selbständiger und auch etwas aggressiv. Vor dieser Periode sind sie zwar so sanftmütig wie einbalsamierte Maunzmiezen, aber es ist unmöglich, die Männchen von den Weibchen zu unterscheiden, solange ihre ausgeprägten Merkmale nicht größer sind als ihr Schwanz. Wilderer, die in Pandala ihr Unwesen treiben, machen mit ihnen saftige Geschäfte und ihr macht dabei mit, indem ihr diesen oder diese Tanuk unter eure Fittiche nehmt.');
INSERT INTO "item_descriptions" VALUES(16274,'de','Ihr wollt nicht unbedingt der Allerschnellste sein; eure Taktik besteht vielmehr darin, die anderen zu bremsen, um wenigstens nicht der Langsamste zu sein. Im Verwaltungsapparat der Welt der Zwölf hat sich diese Taktik jedenfalls schon bestens bewährt.');
INSERT INTO "item_descriptions" VALUES(16275,'de','Ihr wollt nicht unbedingt der Allerschnellste sein; eure Taktik besteht vielmehr darin, die anderen zu bremsen, um wenigstens nicht der Langsamste zu sein. Im Verwaltungsapparat der Welt der Zwölf hat sich diese Taktik jedenfalls schon bestens bewährt.');
INSERT INTO "item_descriptions" VALUES(16276,'de','Er ist zwar nicht ganz so süß wie eine Konalak, aber dennoch verspürt man das gleiche dringende Bedürfnis, sich um ihn zu kümmern, ihn zu umarmen, ihm den Kopf zu streicheln und das Gesicht in sein seidiges Fell zu graben.');
INSERT INTO "item_descriptions" VALUES(16281,'de','Ihr wollt nicht unbedingt der Allerschnellste sein; eure Taktik besteht vielmehr darin, die anderen zu bremsen, um wenigstens nicht der Langsamste zu sein. Im Verwaltungsapparat der Welt der Zwölf hat sich diese Taktik jedenfalls schon bestens bewährt.');
INSERT INTO "item_descriptions" VALUES(16282,'de','Euren Kopf gegen den Kopf eures Gegners knallen zu lassen, um ihn zu betäuben, schien eigentlich eine vielversprechende Taktik zu sein. Bis euch wieder einfiel, dass er einen Helm trug und ihr nicht.');
INSERT INTO "item_descriptions" VALUES(16283,'de','Euren Kopf gegen den Kopf eures Gegners knallen zu lassen, um ihn zu betäuben, schien eigentlich eine vielversprechende Taktik zu sein. Bis euch wieder einfiel, dass er einen Helm trug und ihr nicht.');
INSERT INTO "item_descriptions" VALUES(16284,'de','Euren Kopf gegen den Kopf eures Gegners knallen zu lassen, um ihn zu betäuben, schien eigentlich eine vielversprechende Taktik zu sein. Bis euch wieder einfiel, dass er einen Helm trug und ihr nicht.');
INSERT INTO "item_descriptions" VALUES(16292,'de','Mithilfe der Steuerflucht kann man sich vor Abgaben und Gebühren schützen, die es den Armen ansonsten ermöglichen würden, die Reichen zu beklauen.');
INSERT INTO "item_descriptions" VALUES(16293,'de','Mithilfe der Steuerflucht kann man sich vor Abgaben und Gebühren schützen, die es den Armen ansonsten ermöglichen würden, die Reichen zu beklauen.');
INSERT INTO "item_descriptions" VALUES(16294,'de','Mithilfe der Steuerflucht kann man sich vor Abgaben und Gebühren schützen, die es den Armen ansonsten ermöglichen würden, die Reichen zu beklauen.');
INSERT INTO "item_descriptions" VALUES(16295,'de','Der Wuschel, Frucht der Experimente des Doktors Kuschel, ist das Ergebnis der mehrfachen Kreuzung von Angora-Maunzmiezen und teuflischen Löwenzähnen. Die Tatsache, dass er herkunftsbedingt zu Späßchen neigt, hat ihn zum Ziel so mancher Ioppigkeit gemacht.');
INSERT INTO "item_descriptions" VALUES(16300,'de','Es ist überhaupt keine Schande, wenn man die Flucht ergreift ...sofern man keine Chance hat zu siegen.');
INSERT INTO "item_descriptions" VALUES(16301,'de','Es ist überhaupt keine Schande, wenn man die Flucht ergreift ...sofern man keine Chance hat zu siegen.');
INSERT INTO "item_descriptions" VALUES(16302,'de','Es ist überhaupt keine Schande, wenn man die Flucht ergreift ...sofern man keine Chance hat zu siegen.');
INSERT INTO "item_descriptions" VALUES(16303,'de','Den Spitznamen "Der Umfaller" hat man euch verpasst, als ihr euer Mäntelchen nach dem Wind gehängt habt, ohne überhaupt ein Mäntelchen zu besitzen.');
INSERT INTO "item_descriptions" VALUES(16305,'de','Den Spitznamen "Der Umfaller" hat man euch verpasst, als ihr euer Mäntelchen nach dem Wind gehängt habt, ohne überhaupt ein Mäntelchen zu besitzen.');
INSERT INTO "item_descriptions" VALUES(16306,'de','Den Spitznamen "Der Umfaller" hat man euch verpasst, als ihr euer Mäntelchen nach dem Wind gehängt habt, ohne überhaupt ein Mäntelchen zu besitzen.');
INSERT INTO "item_descriptions" VALUES(16308,'de','Zäh, aber nicht unzerbrechlich. So haben eure Verbündeten euch beschrieben, kurz bevor sie euch die zwei großen Zehen gebrochen haben – daran war ein schlechter Witz schuld.');
INSERT INTO "item_descriptions" VALUES(16309,'de','Zäh, aber nicht unzerbrechlich. So haben eure Verbündeten euch beschrieben, kurz bevor sie euch die zwei großen Zehen gebrochen haben – daran war ein schlechter Witz schuld.');
INSERT INTO "item_descriptions" VALUES(16310,'de','Zäh, aber nicht unzerbrechlich. So haben eure Verbündeten euch beschrieben, kurz bevor sie euch die zwei großen Zehen gebrochen haben – daran war ein schlechter Witz schuld.');
INSERT INTO "item_descriptions" VALUES(16311,'de','Sterben nützt doch nichts; man muss nur rechtzeitig fliehen.');
INSERT INTO "item_descriptions" VALUES(16312,'de','Sterben nützt doch nichts; man muss nur rechtzeitig fliehen.');
INSERT INTO "item_descriptions" VALUES(16313,'de','Sterben nützt doch nichts; man muss nur rechtzeitig fliehen.');
INSERT INTO "item_descriptions" VALUES(16314,'de','Diese Trophäe kann den Schmutz in Richtung eures Nachbarn schieben. Wenn ihr sie umgekehrt verwendet, vielleicht zieht sie ja dann euren Nachbarn in den Schmutz?');
INSERT INTO "item_descriptions" VALUES(16315,'de','Diese Trophäe kann den Schmutz in Richtung eures Nachbarn schieben. Wenn ihr sie umgekehrt verwendet, vielleicht zieht sie ja dann euren Nachbarn in den Schmutz?');
INSERT INTO "item_descriptions" VALUES(16316,'de','Diese Trophäe kann den Schmutz in Richtung eures Nachbarn schieben. Wenn ihr sie umgekehrt verwendet, vielleicht zieht sie ja dann euren Nachbarn in den Schmutz?');
INSERT INTO "item_descriptions" VALUES(16318,'de','Diese Trophäe schützt euch vor all den Unentschlossenen, die sich im Kampf einfach nicht für eine Seite entscheiden können.');
INSERT INTO "item_descriptions" VALUES(16319,'de','Diese Trophäe schützt euch vor all den Unentschlossenen, die sich im Kampf einfach nicht für eine Seite entscheiden können.');
INSERT INTO "item_descriptions" VALUES(16320,'de','Diese Trophäe schützt euch vor all den Unentschlossenen, die sich im Kampf einfach nicht für eine Seite entscheiden können.');
INSERT INTO "item_descriptions" VALUES(16321,'de','Diese Trophäe gibt auch einen tollen Aschenbecher ab, wenn ihr lieber die Friedenspfeife raucht, als in den Kampf zu ziehen.');
INSERT INTO "item_descriptions" VALUES(16322,'de','Diese Trophäe gibt auch einen tollen Aschenbecher ab, wenn ihr lieber die Friedenspfeife raucht, als in den Kampf zu ziehen.');
INSERT INTO "item_descriptions" VALUES(16323,'de','Diese Trophäe gibt auch einen tollen Aschenbecher ab, wenn ihr lieber die Friedenspfeife raucht, als in den Kampf zu ziehen.');
INSERT INTO "item_descriptions" VALUES(16324,'de','Diese Trophäe schützt vor Crocodyllstränen.');
INSERT INTO "item_descriptions" VALUES(16325,'de','Diese Trophäe schützt vor Crocodyllstränen.');
INSERT INTO "item_descriptions" VALUES(16326,'de','Diese Trophäe schützt vor Crocodyllstränen.');
INSERT INTO "item_descriptions" VALUES(16327,'de','Diese Trophäe schützt euch zwar vor Zyklonen, aber nicht vor zig Klonen.');
INSERT INTO "item_descriptions" VALUES(16328,'de','Diese Trophäe schützt euch zwar vor Zyklonen, aber nicht vor zig Klonen.');
INSERT INTO "item_descriptions" VALUES(16329,'de','Diese Trophäe schützt euch zwar vor Zyklonen, aber nicht vor zig Klonen.');
INSERT INTO "item_descriptions" VALUES(16330,'de','Damit euer Hirn nicht verweichlicht, solltet ihr möglichst in starren Schablonen denken.');
INSERT INTO "item_descriptions" VALUES(16331,'de','Damit euer Hirn nicht verweichlicht, solltet ihr möglichst in starren Schablonen denken.');
INSERT INTO "item_descriptions" VALUES(16332,'de','Damit euer Hirn nicht verweichlicht, solltet ihr möglichst in starren Schablonen denken.');
INSERT INTO "item_descriptions" VALUES(16333,'de','Diese Trophäe sendet kleine Stromstöße aus, um euch ständig zum Handeln zu bewegen. Ihr könnt sie für die Bauchmuskulatur verwenden, in der Unterwäsche verbergen oder ins Aquarium stellen, wenn ihr am liebsten Fische mögt, die auf der Wasseroberfläche treiben.');
INSERT INTO "item_descriptions" VALUES(16335,'de','Ihr seht euch selbst gerne als Nomaden. Ein höflicher Ausdruck für einen Hasenfuß.');
INSERT INTO "item_descriptions" VALUES(16336,'de','Beobachter, die fern des Kampfgeschehens mit einem Fernrohr im Baum sitzen, können oft eine entscheidende Rolle für den Ausgang eines Kampfes spielen. Vor allem aber können sie als erstes die Beine in die Hand nehmen, wenn sie sehen, dass es nicht gut aussieht für die Verbündeten.');
INSERT INTO "item_descriptions" VALUES(16337,'de','Euren Freunden läuft das Wasser im Mund zusammen, wenn sie euch Blut vergießen sehen, aber von eurer Knoblauchsuppe wollen sie partout nicht kosten. Seltsam.');
INSERT INTO "item_descriptions" VALUES(16338,'de','Euren Freunden läuft das Wasser im Mund zusammen, wenn sie euch Blut vergießen sehen, aber von eurer Knoblauchsuppe wollen sie partout nicht kosten. Seltsam.');
INSERT INTO "item_descriptions" VALUES(16339,'de','Euren Freunden läuft das Wasser im Mund zusammen, wenn sie euch Blut vergießen sehen, aber von eurer Knoblauchsuppe wollen sie partout nicht kosten. Seltsam.');
INSERT INTO "item_descriptions" VALUES(16343,'de','Mit diesem äußerst seltenen Pinsel aus Astaknydenholz und MuWulf-Haar werdet ihr bei euren Freunden Eindruck schinden.');
INSERT INTO "item_descriptions" VALUES(16500,'de','Einer der wenigen Fälle, in denen man froh sein kann, wenn einem Hörner aufgesetzt werden.');
INSERT INTO "item_descriptions" VALUES(16501,'de','Indem ihr diesen Umhang tragt, könntet ihr den Chafern von Incarnam vortäuschen, ihr Vorgesetzter zu sein... Nun ja, falls diese Augen hätten.');
INSERT INTO "item_descriptions" VALUES(16502,'de','Dieser prächtige Reif aus Chaferknochen wird euer Handgelenk vor Schwerthieben abschirmen und gleichzeitig eure Armmuskulatur stärken. Ein unverzichtbarer Gegenstand für Neulinge wie euch.');
INSERT INTO "item_descriptions" VALUES(16503,'de','Dank des Lichts, das von dieser Kappe ausgeht, wird euch kein Geist überrumpeln können, wenn ihr Incarnam durchstreift. Unheimlich praktisch, oder?');
INSERT INTO "item_descriptions" VALUES(16504,'de','Sofern man nicht über geistige Frische und eine tugendhafte Natur verfügt, kann man mit Hilfe dieses Umhangs zumindest den Anschein erwecken: Die Flügel aus reinster Himmelsmaterie machen richtig was her.');
INSERT INTO "item_descriptions" VALUES(16505,'de','Der Legende nach birgt dieses Amulett die Seele eines mächtigen Magiers, der Ecaflip beim himmlischen Schafkopf herausgefordert und besiegt hat, dem populärsten Kartenspiel der Zwölf. Wenn ihr es um den Hals tragt, während ihr eine Partie spielt, erscheint er vielleicht ...');
INSERT INTO "item_descriptions" VALUES(16527,'de','Es reicht schon, diesen Hammer nur in die Hand zu nehmen, um sogleich den unbändigen Drang zu verspüren, alles zu zertrümmern. Xankipus wurde auch nicht umsonst der "Schmetterer" genannt...');
INSERT INTO "item_descriptions" VALUES(16541,'de','Zum Sammeln von Erzen unentbehrliches Werkzeug.');
INSERT INTO "item_descriptions" VALUES(16843,'de','Dieses kleine Täschchen war in Incarnam lange Zeit groß angesagt. Die Abenteurerinnen fanden es ebenso praktisch wie elegant; die Abenteurer hingegen nutzten es, um die Zähne aufzubewahren, die sie ihren Gegnern ausgerissen hatten.');
INSERT INTO "item_descriptions" VALUES(16953,'de','Wenn ihr schon euer eigenes Grab schaufeln müsst, dann könnt ihr dazu wenigstens eine Schaufel der Familie Terra Cogita verwenden. Auf diese Weise bekommt ihr garantiert ein Begräbnis erster Klasse.');
INSERT INTO "item_descriptions" VALUES(17012,'de','Ausgestattet mit Crocodyllszähnen, die scharf sind wie ein Iop-Schwert, verleiht euch dieser Gürtel den Charme eines versierten Jägers mit dem gewissen Etwas.');
INSERT INTO "item_descriptions" VALUES(17013,'de','„Stepptanzen oder Kämpfen, für eines muss man sich entscheiden!“ Jetzt könnt ihr diesem Spruch Lebewohl sagen, denn diese prachtvollen Stiefel machen viel Lärm und schützen eure Füße dabei auch vor den schwersten Gegenständen.');
INSERT INTO "item_descriptions" VALUES(17023,'de','Die Bonta wissen die Treue und Anhänglichkeit der Bontecke zu schätzen, andere finden sie äußerst aufdringlich. Sobald sie einen ins Herz geschlossen hat, ist es in der Tat sehr schwer, sie wieder loszuwerden, selbst wenn man ihr die schlimmsten Aufgaben gibt. Das bedeutet auch, dass sie euch überallhin folgt, selbst ins Badezimmer.');
INSERT INTO "item_descriptions" VALUES(17028,'de','Die Brâkmilben sind eine wahre Plage. Nachdem die Garstinsekten in Brâkmar ausgelöscht wurden, verbreiteten sie sich überall in den Häusern. Daher wimmelt es nur so von ihnen in Matratzen, Teppichen und Wäschestücken. Einige Brâks mögen ihre mürrische Natur und halten sie als Haustier.');
INSERT INTO "item_descriptions" VALUES(17078,'de','Die Kannibälle behaupten, Moons Baum sei in Wirklichkeit ein schlafender Drache. Das unsterbliche Wesen soll vom Mond gekommen sein und die Form eines großen Kokokosnussbaums angenommen haben, um einer Prinzessin Schutz vor der glühenden Sonne zu gewähren. Und danach soll er eingeschlafen sein ... Bedeutet dies nun, dass die Frucht von Moons Baum, der Dokoko, ein echter Dofus ist? Das lässt sich noch nicht mit Sicherheit sagen.');
INSERT INTO "item_descriptions" VALUES(17079,'de','Kanniball Tams ziehen die Musik der Jagd vor und tragen Masken mit weißen anstelle von schwarzen Haaren, um sich von den anderen Mitgliedern des Stamms abzuheben, was sie sehr stilvoll erscheinen lässt.');
INSERT INTO "item_descriptions" VALUES(17092,'de','Moon fand diesen magischen Hammer, als er von einem Wildererpiraten gefangen wurde. In seinen Händen erzeugt ein einziger Hammerschlag auf den Boden ein Erdbeben. Das ist besonders praktisch, um die Kokokosnüsse von den allerhöchsten Zweigen zu schütteln.');
INSERT INTO "item_descriptions" VALUES(17093,'de','Dieser Umhang wurde aus Kokoko-Blättern und Bananananas gefertigt, was seinen Liebreiz und die außergewöhnlichen Farben erklärt. Leider verströmt er einen weniger lieblichen Geruch, der alle möglichen wilden Tiere anlockt, die euch sofort für eine gigantische, köstliche Banane halten.');
INSERT INTO "item_descriptions" VALUES(17094,'de','Die Kannibälle haben diesen Gegenstand mit einem Bildnis von Moon verziert, den sie als Affengott der Insel erachten. Der Legende zufolge war es der Schlag des Affenhammers, der ihm die Form eines Halbmonds gab. Das zumindest erzählen die Angestellten des A-Touristik-Teams den Reisenden, die ihre Ferien auf der Insel verbringen möchten, wenn sie versuchen, ihnen für das Amulett ein paar Kamas abzunötigen.');
INSERT INTO "item_descriptions" VALUES(17095,'de','Dieses hervorragende Schwert kann euren Feinden Blitzschläge verpassen. Am besten klappt das während eines Gewitters, wenn das Schwert in den Himmel gereckt wird und eure Gegner die Klinge berühren.');
INSERT INTO "item_descriptions" VALUES(17096,'de','Das Seil, aus dem dieser Gürtel gefertigt wurde, besteht aus einem äußerst seltenen Material, das Blitze absorbiert und deren Energie speichert. Daher schützt er euch an stürmischen Tagen, wenn ihr mal keinen Unterschlupf finden solltet.');
INSERT INTO "item_descriptions" VALUES(17097,'de','Laut einer Legende soll der Träger des „Lichtkreises“, welcher in diesem Umhang verarbeitet wurde, die Kontrolle über Blitze erhalten. Es mag sich nur um eine Legende handeln, aber es kostet ja nichts, es mal zu probieren!');
INSERT INTO "item_descriptions" VALUES(17098,'de','Dieser Bart ist perfekt, um wie ein alter Einsiedler auszusehen, der sein ganzes Leben lang nur mit meditieren verbracht hat, um die Geheimnisse des Pandawushu zu verstehen und zu meistern.');
INSERT INTO "item_descriptions" VALUES(17099,'de','Dieser stabile Gürtel eignet sich auch für etwas weitere Taillen und erleichtert das Fortkommen, gerade auch bei etwas korpulenteren Trägern. Andererseits können damit auch die stärksten Gegner gefesselt werden.');
INSERT INTO "item_descriptions" VALUES(17100,'de','Mit diesem Stecken soll es möglich sein, Alkoholquellen in der Nähe aufzuspüren. Vielleicht handelt es sich nur um abergläubischen Unsinn, aber einen Versuch ist es sicher wert!');
INSERT INTO "item_descriptions" VALUES(17103,'de','Goldehort soll einen Teil seiner Seele in diesem Amulett versiegelt haben. Vielleicht weiß Larry Poller mehr darüber.');
INSERT INTO "item_descriptions" VALUES(17104,'de','Dieser Gürtel ist ein Zeichen der Zugehörigkeit zur Goldesort-Bruderschaft. Er soll dabei helfen, all das Gold zu verdauen, das sie verschlingen.');
INSERT INTO "item_descriptions" VALUES(17105,'de','Goldehort hatte seine Stiefel nicht mehr an, seit er gelernt hat, zu schweben. Allerdings entdeckte er an diesem schicksalsträchtigen Tag eine neue Schwäche: er war kitzlig.');
INSERT INTO "item_descriptions" VALUES(17106,'de','Kongokufell ist zwar ein erstklassiger Stoff, es könnte aber gefährlich werden, wenn man mit diesem Umhang zufällig einem Tierschützer über den Weg läuft.');
INSERT INTO "item_descriptions" VALUES(17107,'de','Dieser etwas widerspenstige Ohrring hat die ärgerliche Angewohnheit, vom rechten zum linken Ohr zu wechseln, je nachdem, in welche Richtung sein Träger gerade blickt.');
INSERT INTO "item_descriptions" VALUES(17108,'de','In Wirklichkeit trägt Kongoku diesen Gürtel als Armband, was einiges über das wahre Ausmaß dieses Monsters aussagt.');
INSERT INTO "item_descriptions" VALUES(17109,'de','Dieser Umhang gehörte einst Le Tschuck, dem berüchtigtsten Piraten, der je die Meere von Amakna besegelte, wenn man ihm Glauben schenken möchte. Und wer möchte das nicht? Nachdem ihr Schiff einem mysteriösen Fluch zum Opfer gefallen war, mussten der Pirat und seine Mannschaft angeblich bis ans Ende ihrer Tage als Geister und Skelette ausharren.');
INSERT INTO "item_descriptions" VALUES(17110,'de','Diese Piratenmütze ist weitaus eleganter als ein federverzierter Hut und weist euch den Weg zu allerlei versteckten Schätzen auf den Meeren von Amakna. Leider werdet ihr die einzigen sein, die seine Stimme vernehmen können, weshalb alle anderen denken werden, ihr hättet nicht mehr alle Rumkrüge in der Kombüse.');
INSERT INTO "item_descriptions" VALUES(17111,'de','Dieser magische Trauring, der in einem uralten Schatz entdeckt wurde, kann die Urinfarbe seines Trägers ändern. Leider ist das auf hoher See nicht sonderlich nützlich ...');
INSERT INTO "item_descriptions" VALUES(17119,'de','Der Krieger des K.Os trug diesen Gürtel, um allen zu zeigen, dass er der Champion des K.Os war. Jetzt gehört er euch und ihr dürft damit angeben!');
INSERT INTO "item_descriptions" VALUES(17120,'de','Laut der Legende soll dieses Amulett seinen Träger vor allen möglichen Todesszenarien beschützen. Angesichts dessen, was ihr seinem vorherigen Besitzer angetan habt, ist es wohl nur ein Irrglaube.');
INSERT INTO "item_descriptions" VALUES(17121,'de','Zermalmen, zerquetschen, zerbrechen, zerstampfen, zertrampeln ... Dies sind nur einige Anwendungsbeispiele für diese Stiefel. Natürlich kann man sie auch zum Herummarschieren verwenden.');
INSERT INTO "item_descriptions" VALUES(17213,'de','Diese Stiefel mit Schuhgröße 26 wurden für Ecaflips mit kleinen Füßen entworfen. Wenn ihr nicht dieselbe Schuhgröße wie Kerubim habt, taugen sie immerhin noch als Wohnzimmerdekoration.');
INSERT INTO "item_descriptions" VALUES(17214,'de','Dies ist eine exakte Nachbildung der Unterhose, die Kerubim trug. Sie wehrt sämtliche Waffen ab, mit denen euch eure Gegner traktieren.');
INSERT INTO "item_descriptions" VALUES(17292,'de','Diese Stiefel verleihen eurem Lieblingsteam seine Flinkheit. Sie eignen sich sowohl dazu, zum Sieg zu sprinten, als auch dazu, einer Tracht Prügel zu entkommen.');
INSERT INTO "item_descriptions" VALUES(17293,'de','Diese Stiefel sind stachelig wie eine Rose. Dank ihrer am Vorderfuß fest verankerten Spikes ermöglichen sie schnelles Laufen sowohl in horizontaler als auch vertikaler Lage.');
INSERT INTO "item_descriptions" VALUES(17294,'de','„Ist es ein Vogel? Ist es ein Flugzeug? Nein, es ist ein Samup!“ Dieser Schlachtruf wird von treuen Samup-Fans bei jedem Treffer des Teams skandiert.');
INSERT INTO "item_descriptions" VALUES(17295,'de','Die Zoblaks, die schneller laufen können als die schnellsten Wildtiere, verdanken ihre enorme Geschwindigkeit eben diesen prächtigen Stiefeln, die einst für Fußspitzenrennen entwickelt wurden.');
INSERT INTO "item_descriptions" VALUES(17300,'de','Diesen Gürtel ziert eine Abbildung der Belohnung, die dem Sieger der Fressball-Weltmeisterschaft zuteil wird. Er verleiht euch einen Ausdruck der Überlegenheit und Wichtigtuerei, wenn ihr den Fans des anderen Teams euren Sieg unter die Nase reibt.');
INSERT INTO "item_descriptions" VALUES(17301,'de','Dieser Gürtel schützt den Intimbereich und wurde speziell für die Fans von Redroz entwickelt, die für ihre zahlreichen Prügeleien auf den Rängen von Fressballstadien bekannt sind.');
INSERT INTO "item_descriptions" VALUES(17302,'de','Dieser Gürtel ist irgendwo zwischen Kilt und Weltmeistergürtel angesiedelt. Er wurde von zahllosen Generationen an Samup-Fans getragen. Erweist eurem Team die Ehre und tragt ihn mit Stolz!');
INSERT INTO "item_descriptions" VALUES(17303,'de','Mit diesen enganliegenden Shorts seht ihr wie kräftige Athleten mit unbändigem Willen aus, die bereit sind, sich auf alles zu stürzen, was sich bewegt. Eben genau wie echte Ollbläcks!');
INSERT INTO "item_descriptions" VALUES(17379,'de','Der Quappler gehört zu den merkwürdigsten Kreaturen in der Welt der Zwölf. Seine Glubschaugen und das flache Gesicht lassen ihn recht lächerlich erscheinen, doch der gezackte Kamm sowie der kräftige Schwanz deuten auf eine wilde Bestie hin. So viele Widersprüche in einem derart winzigen Wesen ...');
INSERT INTO "item_descriptions" VALUES(17448,'de','Diese Haube erstrahlt in einem prächtigen chromatischen Lichtspektrum. Sie reagiert auf die Macht ihres Trägers, indem sie die Intensität ihres Strahlens auf ihn abstimmt.');
INSERT INTO "item_descriptions" VALUES(17449,'de','Dieser Umhang wird traditionsgemäß bei Zeremonien oder auf Reisen getragen. Er ist von einer starken Magie durchdrungen, die seinem Träger unglaubliches Charisma, eine heldenhafte Aura und absoluten Schutz gegen Regen und Schlammspritzer verleiht.');
INSERT INTO "item_descriptions" VALUES(17450,'de','Mit diesen Stiefeln an euren Füßen werdet ihr immer der Erste sein - sei es beim Aufbruch zu neuen Abenteuern oder bei der Flucht vom Schlachtfeld.');
INSERT INTO "item_descriptions" VALUES(17451,'de','Dieser Gürtel wurde zum Katalysieren der Quadrelementarbrisenenergie entworfen und gilt als das erste Stück der traditionellen, von den Übermagiern angelegten Kleidung, das hergestellt wurde. Sein Design und seine Farben lehnen sich an denen von Bonta an, aus dem sein Erfinder stammt, der berühmte Übermagier Wotzon.');
INSERT INTO "item_descriptions" VALUES(17452,'de','Dieser Ring der Macht wurde von den Übermagiern in den Flammen geschmiedet und steckt voller Geheimnisse. In seinem Inneren erkennt man die folgende Inschrift: „Das Feuer durchnässt und das Wasser brennt, alle Piepmätze fliegen am Himmel.“, was natürlich rein gar nichts bedeutet.');
INSERT INTO "item_descriptions" VALUES(17456,'de','Kribbeln eure Füße wie tausend Nadelstiche, dann zieht diese Schlappen aus, um euch Erleichterung zu verschaffen.');
INSERT INTO "item_descriptions" VALUES(17457,'de','Egal ob als Tannenbaumdekoration oder Abenteurerschmuck, dieser Ring ist in der herannahenden Weißnachtszeit das ideale Accessoire.');
INSERT INTO "item_descriptions" VALUES(17460,'de','Dieser Zauberstab besitzt einen Zauber, mit dem man einen Durchgang zum Schattenhainbuchenwäldchen öffnen kann. Der Stab wäre noch beliebter, wenn er einen Durchgang zum Wirtshaus öffnen würde.');
INSERT INTO "item_descriptions" VALUES(17487,'de','Lehrt euren Gegnern das Fürchten, indem ihr diese Kette mit einem Totenkopf tragt, dem Symbol von Kraft und Brutalität. Was für Khan gut ist, kann für euch nicht schlecht sein!');
INSERT INTO "item_descriptions" VALUES(17488,'de','Viele Bonta glauben, dass der Bart des Monarchen aus purem Gold besteht. Allerdings handelt es sich dabei um nichts anderes als seinen Halsreif, der ein wenig zu sehr unter dem Kinn hervorsteht.');
INSERT INTO "item_descriptions" VALUES(17495,'de','Tragt diese Stiefel lieber nicht bei einem Testtraining, wenn ihr euch für die Fressball-Mannschaft bewerbt: Ihr könntet über sie stolpern und jämmerlich zu Boden gehen.');
INSERT INTO "item_descriptions" VALUES(17496,'de','Gülden wie die Sonne bezaubern diese glitzernden Stiefel alle Untertanen des Königs, die sich ihm zu Füßen werfen, um ihm zu huldigen.');
INSERT INTO "item_descriptions" VALUES(17502,'de','Dieses hautenge Höschen macht aus euch noch keinen Fressball-Champion, aber es bringt eure Vorzüge deutlich zur Geltung.');
INSERT INTO "item_descriptions" VALUES(17503,'de','Dieser Gürtel wurde nur deshalb in dieser Weite gefertigt, um das Übergewicht festzuzurren, das sich der König von Bonta während seiner Herrschaft angefressen hat. Zumindest werdet ihr euch darin nicht eingeengt fühlen!');
INSERT INTO "item_descriptions" VALUES(17504,'de','Wesen von großer Statur tragen diesen Torque als Kette. Als Kerubim ihn als Hauptbestandteil seiner Rüstung auserkor, fand er schnell heraus, dass er damit seinen ganzen Oberkörper schützen konnte.');
INSERT INTO "item_descriptions" VALUES(17506,'de','Als Leibwache des Königs muss man auf alles gefasst sein. Auch darauf, in die Weichteile getroffen zu werden.');
INSERT INTO "item_descriptions" VALUES(17507,'de','Die Flügel, die diese Stiefel zieren, sind das Symbol der Stadt, die ihr beschützt. Aber sie erinnern auch an das Motto der Wachen von Bonta: "Laufe, eile, fliege zu unserer Rettung."');
INSERT INTO "item_descriptions" VALUES(17508,'de','Diese Kette aus goldplattierten Knochen ist ein schickes Accessoire und wird für großes Aufsehen sorgen, wenn ihr damit das Sidimot-Gebiet durchstreift.');
INSERT INTO "item_descriptions" VALUES(17511,'de','Selbst wenn ihr euer Miniainkhürn mit Herzensliebe und Küssen überschüttet, kann es davon allein nicht leben.');
INSERT INTO "item_descriptions" VALUES(17524,'de','Dieses wunderschöne Paar Stiefel macht euch ein bisschen intelligenter.');
INSERT INTO "item_descriptions" VALUES(17525,'de','Mit diesem wunderschönen Strauß könnt ihr eurer Liebsten eure Bereitschaft zur Überwindung von 1.001 Gefahren unter Beweis stellen.');
INSERT INTO "item_descriptions" VALUES(17572,'de','Die Kleeblätter auf diesen Stiefeln sind leicht parfümiert, man kann sie also auch innen tragen, wo sie schlechte Gerüche überdecken oder sich mit diesen Gerüchen vermischen und etwas ganz einzigartig Unvorhergesehenes dabei herauskommt.');
INSERT INTO "item_descriptions" VALUES(17573,'de','Die wenigen ernsten Themen, die dem Spielerkönig zu Ohren kommen (hier rein und da raus), gelangen bis zu dieser Kopfbedeckung. Dieser ist daher im Laufe der Zeit durch die Ernsthaftigkeit so schwer geworden, dass die goldenen Ringe ringsum sich nicht vom Fleck wegbewegen.');
INSERT INTO "item_descriptions" VALUES(17574,'de','Der Spielerkönig benutzt seinen Siegelring dazu, seine Opfer zu markieren. Wo er bloß das Wachs dazu hernimmt?');
INSERT INTO "item_descriptions" VALUES(17575,'de','Diese bequemen Schuhe hinterlassen beeindruckende Katzenpfotenabdrücke. Man sollte sie behutsam handhaben, sonst ziehen sie bestimmte massive Monster an, wie den MuWulf.');
INSERT INTO "item_descriptions" VALUES(17576,'de','Im Inneren dieses Anhängers befindet sich das Porträt der Person, die ihr am meisten liebt. In anderen Worten: ihr selbst.');
INSERT INTO "item_descriptions" VALUES(17577,'de','Ins Innenfutter des Umhangs wurden folgende Worte gestickt: „Der Dieb muss mir diesen Umhang zurückgeben und AB MIT DEM KOPF. 
Xoxo, eure Königin.“');
INSERT INTO "item_descriptions" VALUES(17578,'de','Diese Stiefel wurden speziell für das Fortbewegen auf Spielfeldern konzipiert. In einem Labyrinth zum Beispiel sind sie allerdings völlig nutzlos.');
INSERT INTO "item_descriptions" VALUES(17579,'de','Mit diesem Helm seht ihr gleich viel ernster aus.');
INSERT INTO "item_descriptions" VALUES(17580,'de','Dieses Cape wurde vom Modeschöpfer Aleaia Ctaest entworfen und trägt seine Signatur.');
INSERT INTO "item_descriptions" VALUES(17581,'de','Denkt daran, euren Namen und den Namen eures Herrchens auf diese Marke zu schreiben. Wenn ihr euch dann verlauft, kann man euch dann wieder zum richtigen Besitzer zurück bringen.');
INSERT INTO "item_descriptions" VALUES(17582,'de','Die Form dieses Handschuhs lässt erahnen, dass es nur für drei Finger Platz hat und das ist in der Tat der Fall. Jetzt bleibt euch nur noch, auf den Schneider zu schimpfen, der sie angefertigt hat oder euch zwei Finger abzuschneiden.');
INSERT INTO "item_descriptions" VALUES(17583,'de','Das Cape sieht aus, als hingen vier Schwänze dran. Dabei müssten es doch neun sein. Wo sind die fünf anderen geblieben?');
INSERT INTO "item_descriptions" VALUES(17584,'de','Dieser Umhang lässt sich in zwei Hälften teilen. Jedes Teil lässt sich wie ein halbes Cape benutzen. Unglaublich, oder?');
INSERT INTO "item_descriptions" VALUES(17585,'de','Diese Sandalen kommen auch als Gleitschuhe zum Einsatz und man rutscht so auf manchen Oberflächen wie nur mit Socken bekleidet. Das Tragen von Socken zu diesen Sandalen verdoppelt allerdings nicht den Rutscheffekt.');
INSERT INTO "item_descriptions" VALUES(17586,'de','Die Klingen dieser Säbel sind so scharf, dass Atcham sich damit rasieren könnte, wenn er behaart wäre.');
INSERT INTO "item_descriptions" VALUES(17587,'de','Es gibt nur wenige Stoffe die so fest sind, wie der aus dem dieser Kragen hergestellt wurde. Er schützt euren Hals vor allen Schwertschlägen.');
INSERT INTO "item_descriptions" VALUES(17588,'de','Diese Stiefel sind so bequem wie Hausschuhe, aber ein Tritt mit ihnen ist so schmerzhaft, wie ein Steinschlag.');
INSERT INTO "item_descriptions" VALUES(17589,'de','Jedes einzelne von Ushs Schwertern stellt einen Teil von ihm dar. Ihr habt ihm nur seine dunkle Seite übrig gelassen, als ihr ihm seine schillernde Seit abgenommen habt.');
INSERT INTO "item_descriptions" VALUES(17590,'de','Das Tigermotiv auf diesem Werkater-Cape behindert die Sicht eurer Gegner so gut, dass sie blind werden.');
INSERT INTO "item_descriptions" VALUES(17591,'de','Da dachtet ihr, ihr müsstet nur das Symbol der Werkater um eure Taille tragen, um euch so unter sie mischen zu können, dabei dient dieser Katzenkopf nur dazu, ihre nächste Beute zu markieren. Pech für euch!');
INSERT INTO "item_descriptions" VALUES(17592,'de','Angeblich verfügt dieser Ring über die seltsame Fähigkeit, seinen Träger die seltsamsten Dinge sagen zu lassen. Zum Beispiel: „Kazamba!“ Nun ja, das funktioniert jedenfalls bei euch nicht. Wahrscheinlich schon wieder so ein Märchen, das man Abenteurern auftischt.');
INSERT INTO "item_descriptions" VALUES(17593,'de','Wenn ihr mit diesen Stiefeln herumläuft, dann hört sich das so an, als wolltet ihr ganze Städte zertreten.');
INSERT INTO "item_descriptions" VALUES(17594,'de','Mit diesem Gürtel zeigt ihr der ganzen Welt, wer bei diesem schrecklichen Kampf als Sieger hervorgegangen ist.');
INSERT INTO "item_descriptions" VALUES(17595,'de','Diese Haube wurde aus der Kopfhaut Flohzillas angefertigt und ist ganz schön abscheulich, aber falls es bei euch zu plötzlichen Haarausfall kommt, habt ihr immerhin Ersatz da.');
INSERT INTO "item_descriptions" VALUES(17596,'de','Nur ein ausgezeichneter Juwelier hat so ein Wunderwerk anfertigen können. Seht nur die unvergleichliche Feinarbeit und diese Liebe zum Detail!');
INSERT INTO "item_descriptions" VALUES(17597,'de','In den katastrophalsten Situationen bringt euch dieser geschrumpfte Pikbul als Kette getragen, Glück.');
INSERT INTO "item_descriptions" VALUES(17598,'de','Reißt ihm die Haut ab und aus einem Filzfloh wird dieses Filzcape!');
INSERT INTO "item_descriptions" VALUES(17627,'de','Denkt daran, dass ihr euch beim Ausrüsten mit diesem Schild in den Dienst der Wissenschaft stellt. Wenn also was schief geht: Schwamm drüber!');
INSERT INTO "item_descriptions" VALUES(17628,'de','Was ist weiß, riecht schlecht und hält im Winter warm? Nein, es handelt sich hierbei nicht um einen toten Wabbit, den ihr euch um den Hals gewickelt habt. Erzählt doch nicht so einen Unsinn!');
INSERT INTO "item_descriptions" VALUES(17629,'de','Die Herkunft dieser grünen, zähen Substanz, die diesen Schild bedeckt, bleibt ein Geheimnis. Man weiß nur, dass sie von den Goblins für heilig erachtet werden.');
INSERT INTO "item_descriptions" VALUES(17681,'de','Beim (normalerweise schmerzhaften) Empfang eines Pfeils aus diesem Bogen ist die Nachricht klar: Jemand hat euch gesehen.');
INSERT INTO "item_descriptions" VALUES(17682,'de','Während eines Kartenspiels mit großem Einsatz, hat dieses Zepter den König Nidas wahnsinnig werden lassen.');
INSERT INTO "item_descriptions" VALUES(17683,'de','Die drei Augen auf dieser Axt stellen Blickkontakt zwischen euch und eurem Opfer her, bei dem der Austausch von manchmal lebender Materie möglich ist.');
INSERT INTO "item_descriptions" VALUES(17684,'de','Mit diesem Gerät auf dem Kopf werdet ihr Dinge sehen können, die niemand sonst sehen kann. Man sagt, dass diese Lupe Halluzinationen hervorruft, aber die hattet ihr ja schon vorher.');
INSERT INTO "item_descriptions" VALUES(17700,'de','Flinker als ein Tofu zur Fütterungszeit, überrascht die Wuschelmaunz ihre Beute mit ihrer extremen Schnelligkeit. Das macht aus ihr zwar einen außergewöhnlichen Jäger, aber dabei ist es nahezu unmöglich, sie zu fassen. Wer es schafft, dieses Fellknäuel zu bezähmen, der wird angeblich mit dessen Flinkheit ausstaffiert.');
INSERT INTO "item_descriptions" VALUES(17733,'de','Die kleinen Raketen, die an diesen Stiefeln angebracht sind, können zwei völlig verschiedene Zwecke erfüllen: entweder reißt ihr mit ihrem Beschleunigungsvermögen in letzter Minute den Sieg an euch oder euer Dracotruter endet als Sonntagsbraten, wenn ihr verliert.');
INSERT INTO "item_descriptions" VALUES(17734,'de','Im Falle eines Unfalls schützt euch dieser Sicherheitsgürtel so gut vor Verletzungen, wie es eine eurer Unterhosen als Mütze getragen tun würde.');
INSERT INTO "item_descriptions" VALUES(17795,'de','Die Tirubims rufen bei Liebhabern niedlicher Dinge meist langwierige lautmalerische Ergüsse und heftige Hitzewallungen hervor. Es handelt sich bei ihnen um entzückende kleine Maunzmiezchen, die in der Ecaflipus-Dimension aufgezogen wurden. Niemand vermag genau zu sagen, ob die magische Aura, die diesen Ort durchdringt, etwas damit zu tun hat, dass sie Kerubim so sehr ähneln.');
INSERT INTO "item_descriptions" VALUES(17809,'de','Diesen Hammer für einen anderen Zweck zu benutzen, als die Wissenschaft voranzubringen, wäre der reinste Frevel. Das Einschlagen feindlicher Schädel kann unter Umständen in diese Kategorie fallen, sofern es unter streng wissenschaftlichen Gesichtspunkten geschieht.');
INSERT INTO "item_descriptions" VALUES(17813,'de','Direkt aus den Tiefen Sufokias emporgetaucht, verdankt der Blub seinen Namen dem Geräusch, das er ausstößt, sobald ihr ihn aus seinem natürlichen Lebensraum, einer Unterwasserhöhle herauslockt. Er ist wegen seiner Anhänglichkeit und seiner ulkigen Form bei den Trithunen als bester Freund beliebt.');
INSERT INTO "item_descriptions" VALUES(17833,'de','Die Ratzchen werden wegen ihres Schwanzes, ihrer langen Ohren und ihres haarlosen Körpers oft mit Ratten verwechselt, aber wenn man sich eines zulegt, merkt man recht schnell, wie wenig dieses kleine Raubtier mit den Nagern zu tun hat. Es knuddelt unheimlich gerne und wird euch des Öfteren das Gesicht ablecken. Und bei dieser Gelegenheit werdet ihr feststellen, dass die Ratzchen nicht völlig haarlos sind.');
INSERT INTO "item_descriptions" VALUES(17849,'de','Zeigt her eure Füße! Auch die sollen im Sommer schließlich schön braun werden.');
INSERT INTO "item_descriptions" VALUES(17961,'de','Dekks hat euch versichert, dass dieser Helm euch vor dem Einfluss der Resonanz-Kristalle bewahren würde. Ihr hofft, dass er wirkt: Wenn man sich schon so eine lächerliche Kopfbedeckung aufsetzt, sollte es auch zu etwas gut sein.');
INSERT INTO "item_descriptions" VALUES(17997,'de','Aus einem Krabthun-Leuchtorgan eine Halskette zu machen, ist schon etwas gewagt: das von ihr ausgehende Licht könnte bestimmte Personen anziehen und euer Schädel ist nicht solide genug, um mit dieser Bedrohung fertig zu werden.');
INSERT INTO "item_descriptions" VALUES(17998,'de','Dieser robuste Ring hinterlässt dort wo ihr zuschlagt, tiefe Spuren.');
INSERT INTO "item_descriptions" VALUES(18000,'de','Irrsinnige Raserei, bedeckter Wahnsinn, monströse Halluzination ... manche Dinge bleiben besser in der Tiefe verborgen.');
INSERT INTO "item_descriptions" VALUES(18001,'de','Es mag ganz interessant sein, immer einen Abfalleimer in Reichweite zu haben, und da ist dieser Anhänger hier ganz passend. Allerdings hat jeder verschlungene Gegenstand so sein Gewicht und wenn ihr ihn weiter tragen wollt, müsst ihr eure Halsmuskeln trainieren.');
INSERT INTO "item_descriptions" VALUES(18002,'de','Dieser Umhang saugt sich mit Wasser voll und nimmt so die Form eines Globusfisches an.');
INSERT INTO "item_descriptions" VALUES(18003,'de','Es ist nicht leicht, einen Namen für diese Stiefel zu finden. Daher der Name.');
INSERT INTO "item_descriptions" VALUES(18004,'de','Dieses Amulett ist eine vereinfachte Darstellung von Shokkoth. Es ist besser, man weiß wie sie aussehen: auch wenn sie ein charakteristisches Erscheinungsbild haben, können sie doch einen leicht an der Nase herumführen.
P.S.: Die Kette ist elastisch.');
INSERT INTO "item_descriptions" VALUES(18005,'de','Die Spaßvögel, die euch am Schwanz ziehen wollen, bekommen im wahrsten Sinne des Wortes einen Schlag ab.');
INSERT INTO "item_descriptions" VALUES(18006,'de','Man wundert sich über die Tentakel an diesem Lendenschurz, aber der Grund dafür geht uns nichts an.');
INSERT INTO "item_descriptions" VALUES(18007,'de','Mit diesen Flossen riecht ihr so, wie ein Fisch im Wasser.');
INSERT INTO "item_descriptions" VALUES(18008,'de','Es ist hochinteressant, eine Beschreibung für einen unbeschreiblichen Gegenstand zu finden. Manche machen es sich leicht und lassen die Beschreibung ganz weg. Aber sowas kommt bei uns nicht in Frage. Wenn ein ellenlanger Text geschrieben werden soll, dann wird er auch geschrieben! Damit ihr nur Bescheid wisst. 
Zur Natur des Unbeschreiblichen lässt sich ja so viel sagen. Das kann verschiedene Dinge bedeuten: Entweder man hat keine Worte zum Beschreiben der Sache, weil sie überraschend ist und mit nichts, was man kennt, Ähnlichkeit hat oder weil man ganz einfach nicht über die enzyklopädischen Kenntnisse verfügt, um die richtigen Worte zu finden, die dem Wesen der Sache am besten entsprechen. Dann versteckt man sich hinter Ausreden wie: „Ha ha! Es ist einfach unbeschreiblich!“ (in überzeugendem Tonfall). Doch stimmt das wirklich? 
Man kann auch in seinem tiefsten Inneren nach einer genauen und passenden Beschreibung suchen. Etwas, dass klar und gleichzeitig abstrakt genug ist, um das Begreifen der beschriebenen Sache zu erleichtern. Und wenn diese Worte unzureichend sind, vielleicht muss man dann neue dafür erfinden? Worte, die aus dem Herzen kommen, Worte, die für sich sprechen, wenn die Grenzen der Sprache erreicht sind. Das Unbeschreibliche ist letzten Endes vor allem das Unbekannte, das erfasst und verstanden werden will. Etwas, das zum besseren Verständnis die eigene Vorstellungskraft, Vernunft und die eigenen Gefühle spielen lässt, um so die nötigen Worte zu finden.
Das wäre aber viel zu viel Arbeit für einen einfachen Umhang.');
INSERT INTO "item_descriptions" VALUES(18009,'de','Dieser Gürtel gehörte nicht Meno, sondern wurde von ihm dazu benutzt, um auf seine Gefangenen zu zeigen.');
INSERT INTO "item_descriptions" VALUES(18010,'de','Dieser Stock wurde aus Trisuldreizacken angefertigt und kommt beim Trithunenfischen stark zum Einsatz.');
INSERT INTO "item_descriptions" VALUES(18011,'de','Dieser Stab ist unangenehm anzusehen und er lässt im Geist eurer Gegner Zweifel aufkommen.');
INSERT INTO "item_descriptions" VALUES(18012,'de','Der zweite aus einer langen Reihe von Bögen, deren Sehne durch ein Auge ersetzt wurde. Niemand weiß, wie er funktioniert, aber es scheint so, als stammten die verschossenen Pfeile aus einer anderen Dimension.');
INSERT INTO "item_descriptions" VALUES(18013,'de','Für alle, die auf Unterwasserschätze versessen sind und die immer überall herumgraben, in der Hoffnung etwas zu finden, für den ist diese Schaufel-Harpune genau richtig. Damit könnt ihr euch auch verteidigen, solltet ihr mal aus Versehen ein unfreundliches Krustentier ausbuddeln.');
INSERT INTO "item_descriptions" VALUES(18014,'de','Diese Axt ist mit den natürlichen Fähigkeiten eines Mantaz ausgestattet und setzt Elektrizität ein, um diese zu verbessern.');
INSERT INTO "item_descriptions" VALUES(18015,'de','Dieses Schwert schneidet direkt in die Seele eurer Gegner.');
INSERT INTO "item_descriptions" VALUES(18017,'de','Sobald sie ihr Ziel treffen, entweicht aus diesen Dolchen eine schleimige und unheimliche Flüssigkeit, so, als ob sie sie aus dem Körper ihres Opfers heraussaugen würden.');
INSERT INTO "item_descriptions" VALUES(18018,'de','Der Zweck dieses Hammers ist, euch leiden zu lassen. Erstmal ist der Hammer rein visuell eine Tortur. Dann bringt er Töne hervor, die denen einer Plastikblockflöte gleichen, was Qualen für eure Ohren bedeutet. Und dann verursacht er natürlich erheblichen physischen Schaden.');
INSERT INTO "item_descriptions" VALUES(18019,'de','Mit dem Saugnapfbund ausgerüstet seid ihr nun für jede Kletterpartie auf egal welcher Festungsmauer bereit. Jetzt braucht ihr euch nicht mehr festzukrallen, ihr müsst nur noch eure stark haftenden Hüften drankleben. Das funktioniert auch ganz gut bei anderen Lebewesen, aber dies wird allgemein als Belästigung empfunden.');
INSERT INTO "item_descriptions" VALUES(18020,'de','Zum Laufen unter Wasser ganz praktisch, diese Schlappen fixieren euch am Boden, solange ihr nicht beide Füße hochhebt.');
INSERT INTO "item_descriptions" VALUES(18021,'de','Die Krakkappe verleiht keine hellseherischen Fähigkeiten und ist nicht ganz so beliebt wie die Krakapaulhaube. Aber originell ist sie.');
INSERT INTO "item_descriptions" VALUES(18022,'de','Zwicken oder treten? Macht euch die Wahl nicht zur Qual und tut beides gleichzeitig!');
INSERT INTO "item_descriptions" VALUES(18023,'de','Diese Mütze wird mit einer Atemmaske geliefert und verleiht euch das Aussehen eines echten U-Bootkapitäns, dessen Boot gesunken ist.');
INSERT INTO "item_descriptions" VALUES(18024,'de','Manche glauben zwar, dass das Symbol auf diesem Umhang bedeutet, dass ein mächtiger Zauberer von ihm Besitz ergriffen hat. Aber es ist einfach nur Menos Zeichen.');
INSERT INTO "item_descriptions" VALUES(18025,'de','Was unaussprechlich ist, kann nicht gesagt werden.');
INSERT INTO "item_descriptions" VALUES(18026,'de','Was unaussprechlich ist, kann nicht gesagt werden.');
INSERT INTO "item_descriptions" VALUES(18028,'de','Was unaussprechlich ist, kann nicht gesagt werden.');
INSERT INTO "item_descriptions" VALUES(18029,'de','Dieser äußerst elegante Ring ist der perfekte Verlobungsring. Für einen Trithun.');
INSERT INTO "item_descriptions" VALUES(18030,'de','Mal abgesehen von der Farbe sind diese Stiefel zum Fortbewegen unter Wasser ideal: sie sind wasserfest und erleichtern das Schwimmen.');
INSERT INTO "item_descriptions" VALUES(18031,'de','Also mit dieser Maske könnt ihr immer noch nicht als Trithun durchgehen, Mariacalas und Krabthune sind für euch daher immer noch unerreichbar. Allerdings kann man damit unter Wasser atmen.');
INSERT INTO "item_descriptions" VALUES(18032,'de','Zwei Zusatzaugen kann man immer brauchen. Damit seht ihr immer sehr ernst aus oder genervt oder nachdenklich.');
INSERT INTO "item_descriptions" VALUES(18033,'de','Dieser Gürtel streckt die Zunge heraus, sobald es eng wird. Wenn ihr es also wieder mit dem Fresssackbraten und Frostizzknödeln übertreibt, dann werdet ihr vorgewarnt.');
INSERT INTO "item_descriptions" VALUES(18034,'de','Es ist sehr gefährlich, den Panzer eines Yolonistenkrebses zu tragen: seine Artgenossen zwicken sich gegenseitig mit aller Kraft, um sich zu testen.');
INSERT INTO "item_descriptions" VALUES(18035,'de','Diese Art von Anhänger verschenkt man, um seine Lieben zu beruhigen und von der wahren Natur Kutuluhs abzulenken.');
INSERT INTO "item_descriptions" VALUES(18036,'de','Dieser Helm verleiht ein ganz normales und annehmbares Erscheinungsbild. Für einen Irren.');
INSERT INTO "item_descriptions" VALUES(18037,'de','Bei jeder schlecht getroffenen Entscheidung gibt euch dieser Ring zu verstehen, dass ihr es bitter bereuen werdet.');
INSERT INTO "item_descriptions" VALUES(18043,'de','Offiziellen Quellen zufolge soll dieser ungewöhnlich aussehende Dofus von Steamern aus Sufokia erschaffen worden sein: Daraus könnte man den Schluss ziehen, dass es sich nicht um ein richtiges Drachenei handelt. Zumindest wollen die Behörden uns das glauben machen ... Denn wer weiß schon, was sich in den Tiefen wirklich verbirgt?');
INSERT INTO "item_descriptions" VALUES(1018088,'de','Die Klötmuus ist eine dümmlich aussehende Riesenfleddermaus, die als Reittier zum Einsatz kommt und wegen ihrer unerschütterlichen Treue geschätzt wird. Ihre Liebe zu euch zeichnet sich in verschiedener Art und Weise aus: manchmal leckt sie euch von Kopf bis Fuß ab, manchmal verschluckt sie auch den Kopf und nuckelt dran. Noch nie hat man ein anhänglicheres Tier gesehen, es sei denn, es hält euch für seinen nächsten Imbiss.');
INSERT INTO "item_descriptions" VALUES(18145,'de','Dieser Hut ist nicht nur im Dunkeln unsichtbar, sondern auch in hellem Licht.');
INSERT INTO "item_descriptions" VALUES(18146,'de','Dieser Umhang ist nicht nur im Dunkeln unsichtbar, sondern auch in hellem Licht.');
INSERT INTO "item_descriptions" VALUES(18229,'de','Ein entsprechender Badeanzug wäre zu gefährlich gewesen, daher habt ihr euch für diesen Gürtel entschieden, der euch außerdem dabei hilft, auf eure schlanke Linie zu achten. Ihr zieht automatisch den Bauch ein!');
INSERT INTO "item_descriptions" VALUES(18230,'de','Dieses Amulett wurde von einer Hexe von zweifelhafter Moral angefertigt und zieht sich auf ein einfaches Kommando zusammen. Seltsamerweise fehlte es dieser Hexe nie an Freiwilligen, die sich bereit erklärten, es zu tragen.');
INSERT INTO "item_descriptions" VALUES(18279,'de','Der Stab zeigt die Richtung des Nordens des Kakteen-Territoriums an.');
INSERT INTO "item_descriptions" VALUES(18290,'de','Ein Werkzeug mit fortschrittlicher Technologie, das euch helfen sollte, einem Gewitter die Stirn zu bieten.');
INSERT INTO "item_descriptions" VALUES(18350,'de','Diese Handschuhe sollte man nach dem Tragen wegwerfen, denn das synthetische Material, aus denen sie bestehen, hat starke Nebenwirkungen für die Haut.');
INSERT INTO "item_descriptions" VALUES(18375,'de','Ihr müsst diesen Stab nur noch segnen, dann könnt ihr euch auf die Suche nach dem Wasser begeben, das es nicht gibt.');
INSERT INTO "item_descriptions" VALUES(18423,'de','Wenn ihr nach einem Mittel sucht, um euch in der Wüste zu tarnen, erweist sich dieser Umhang vielleicht als nützlich.');
INSERT INTO "item_descriptions" VALUES(18424,'de','Dieser Ring fängt bei starker Hitze plötzlich zu leuchten an. Auf diese Weise kann er euch vor dramatischen Ereignissen warnen, falls ihr sie einmal nicht selbst bemerkt.');
INSERT INTO "item_descriptions" VALUES(18425,'de','Unverzichtbar für Märsche auf heißem Sand. Diese Stiefel verhindern nicht nur Senkfüße, sondern schützen euch auch davor in Treibsand zu versinken.');
INSERT INTO "item_descriptions" VALUES(18426,'de','Pelze sind normalerweise nicht gerade die empfohlene Kleidung in heißen Gefilden. Das Fell des Fennex hingegen schützt euch jedoch trotzdem vor der Hitze.');
INSERT INTO "item_descriptions" VALUES(18427,'de','Verwendet Fennexschwänze als Zöpfchen, tadaaa.');
INSERT INTO "item_descriptions" VALUES(18428,'de','„Aber es ist so heiß!“ Wenigstens diese Entschuldigung habt ihr.');
INSERT INTO "item_descriptions" VALUES(18429,'de','Das Ziel ist nicht, damit alles durchzuschlagen. Ein Kratzer ist schon gefährlich genug.');
INSERT INTO "item_descriptions" VALUES(18430,'de','Manchmal erreicht man mit Subtilität nicht das Geringste.');
INSERT INTO "item_descriptions" VALUES(18431,'de','Diesen Umhang kann man auf zweierlei Weisen einsetzen: Eine wird nur für jene empfohlen, die keine Sacrieure sind.');
INSERT INTO "item_descriptions" VALUES(18432,'de','Angesichts der Form dieses Helms könnte man versucht sein, euch auf den Kopf zu schlagen. Genau deswegen hat er euch Stacheln außen.');
INSERT INTO "item_descriptions" VALUES(18433,'de','Diesen Gürtel zu tragen ist nicht einfach, ihn abzunehmen noch viel weniger.');
INSERT INTO "item_descriptions" VALUES(18434,'de','Wer träumt nicht davon, einen solchen Sombrero zu tragen ... zumindest einige Sekunden lang?');
INSERT INTO "item_descriptions" VALUES(18435,'de','Damit dieser Ring gut passt, solltet ihr besser schmale Finger haben. Aber auch dann wird euch von zu heftigem Gestikulieren abgeraten.');
INSERT INTO "item_descriptions" VALUES(18436,'de','Dieser Kaktus-Glücksbringer ernährt sich vom Wasser eures Körpers.');
INSERT INTO "item_descriptions" VALUES(18437,'de','Mit diesen Dolchen könnt ihr schneiden, pieksen, ausreißen und betäuben. Ihr habt die Qual der Wahl.');
INSERT INTO "item_descriptions" VALUES(18438,'de','Seid ihr im Herzen ein Musiker? Dieser Degen untermalt eure Kampfchoreographien mit atmosphärischen Tönen.');
INSERT INTO "item_descriptions" VALUES(18439,'de','Bei Sonnenlicht reflektiert dieser Helm die Sonnenstrahlen und blendet eure Gegner.
Bei bedecktem Wetter blendet er sie trotzdem, denn so funktioniert dieses strahlende Gold nun einmal.');
INSERT INTO "item_descriptions" VALUES(18529,'de','Dieser Gürtel allein wird nicht ausreichen, um aus euch ein tapferes Schneiderlein zu machen, das sieben riesengroße Moskitos auf einen Streich erledigt oder Einohren einfängt.');
INSERT INTO "item_descriptions" VALUES(18530,'de','Damit schützt ihr eure Füßchen vor der Kälte und seid bereit für all die langen Winterabende, die ihr vor dem Kamin verbringen werdet.');
INSERT INTO "item_descriptions" VALUES(18584,'de','Habt ihr diesen Hut erst mal auf dem Kopf, bohren sich die Zähne ins Fleisch, damit er nicht gleich beim ersten Windhauch davonfliegt. Ihr reißt Witzchen, dass er wohl eure Gehirnmasse einsaugen will, die euch sonst eh nicht viel nützt.');
INSERT INTO "item_descriptions" VALUES(18585,'de','Sein Aussehen macht ihn effektiver als einen Keuschheitsgürtel bei der Abwehr von Verehrern.');
INSERT INTO "item_descriptions" VALUES(18586,'de','Der Händler, der euch diese Halskette verkauft hat, hat euch garantiert, dass sie harmlos ist. Trotzdem habt ihr das unangenehme Gefühl, dass sie nur darauf wartet, ihre Zähne in eurem Hals zu versenken.');
INSERT INTO "item_descriptions" VALUES(18587,'de','Diese Stiefel werden auch als Zähne des Sandmeers bezeichnet und nur die wagemutigsten Nomaden und Iops legen sie an.');
INSERT INTO "item_descriptions" VALUES(18588,'de','Dieser Umhang ist lebendig und wartet darauf, all jene zu beißen, die es wagen, ihn zu berühren. Daher ist er überaus beliebt bei Stars, die nur ungern in der Menge baden.');
INSERT INTO "item_descriptions" VALUES(18589,'de','Dieser Ring ist von der Persönlichkeit von Vater Wurm erfüllt. Seinen Eigentümer will er dazu drängen, ihn nicht nur am Finger zu tragen.');
INSERT INTO "item_descriptions" VALUES(18590,'de','Die Leute um euch herum werden derart von der Pracht eurer Haube geblendet sein, dass sie nichts anderes mehr sehen werden.');
INSERT INTO "item_descriptions" VALUES(18591,'de','Ehrgeizige Enutrofs haben schon Eroberungszüge geführt, deren einziges und alleiniges Ziel es war, an einen solch dichten Haarschweif zu gelangen.');
INSERT INTO "item_descriptions" VALUES(18592,'de','Tal Kasha ertrug es nicht, wenn man ihr auf die Zehen trat, was wiederum das Erscheinungsbild ihrer Sandalen erklärt.');
INSERT INTO "item_descriptions" VALUES(18593,'de','Diese Stiefel wurden so entworfen, dass sie bei jedem Schritt ein metallisches Klicken von sich geben. Der durchdringende Klang, der dabei auf dem Steinboden der Pyramide entsteht, wird durch den Widerhall in den langen Korridoren nur noch verstärkt. Alle Anzeichen sprechen also dafür, dass die Mumfords im Gegensatz zu den Astrubianern gerne die Aufmerksamkeit auf sich ziehen.');
INSERT INTO "item_descriptions" VALUES(18594,'de','Laut den Legenden besitzt dieser Ring seltsame Mächte ... Wie etwa jene, sich um die eigene Achse zu drehen, ohne dass sein Träger etwas tut.');
INSERT INTO "item_descriptions" VALUES(18595,'de','Dieser Torque aus massivem Gold dient im Wesentlichen dazu, den Reichtum vor aller Augen zur Schau zu stellen.');
INSERT INTO "item_descriptions" VALUES(18596,'de','Mumion wurde im Alter senil und verlor häufig seine Haube. Daher war er gezwungen, öfters die von anderen Mumfords zu stehlen.');
INSERT INTO "item_descriptions" VALUES(18597,'de','Laut einer kürzlichen Studie stellt das Symbol auf diesem Umhang einen einbeinigen Gnom mit erhobenen Armen dar.');
INSERT INTO "item_descriptions" VALUES(18598,'de','Wer schon mal einem Rykaon gegenüber stand, weiß, dass dieser Lendenschurz den gesunden Teil des Monsters vom verkümmerten Teil abtrennt. Wenn ihr ihn in Höhe des Gürtels tragt, weiß jedermann, woran er sich zu halten hat.');
INSERT INTO "item_descriptions" VALUES(18599,'de','Die Granataugen dieser Schlange können einen Enutrof stundenlang hypnotisieren.');
INSERT INTO "item_descriptions" VALUES(18601,'de','Wer auch immer diesem Stab seinen Namen verliehen hat, war genauso kreativ wie derjenige, der ihn den Sterblichen beschreiben sollte.');
INSERT INTO "item_descriptions" VALUES(18604,'de','Ursprünglich waren die Kristalle dieser Waffe weiß, aber sie füllten sich mit dem Blut jener, die ihr Träger mit der Heqaxt in Stücke zerhackte.');
INSERT INTO "item_descriptions" VALUES(18615,'de','Diesen Ring bekommen die jungen Ouginaks geschenkt, damit sie sich die Pfoten lecken, anstatt sich die Krallen abzukauen.');
INSERT INTO "item_descriptions" VALUES(18616,'de','Die Ouginaks bildeten einmal ein recht großes Rudel, bis dieses von inneren Konflikten zerrissen wurde. Daraufhin hat sich das Rudel in mehrere kleine Sippen aufgeteilt, die einander hundefeind geworden sind.');
INSERT INTO "item_descriptions" VALUES(18617,'de','Das ist der Lieblingsumhang der exhibitionistisch veranlagten Ouginaks, die ihr Fell gern unvermittelt vor Fremden enthüllen.');
INSERT INTO "item_descriptions" VALUES(18621,'de','Einige der alten Ouginaks sollen, wenn sie diesen Hut aufhaben, angeblich die Evolution des Klimas in den nächsten zehn Sekunden vorhersagen können.');
INSERT INTO "item_descriptions" VALUES(18622,'de','Dieser Gürtel könnte euch vor Vergnügen jauchzen lassen, wenn er als Peitsche dient - egal, ob ihr selbst peitscht oder gepeitscht werdet.');
INSERT INTO "item_descriptions" VALUES(18626,'de','Sollte jemand Oma unglücklicherweise in die Kakteen schubsen, nur keine Panik! Dotsch würde keine Sekunde zögern, ihr zu Hilfe zu eilen, um ihr Alleinerbe zu werden.');
INSERT INTO "item_descriptions" VALUES(18639,'de','Wie alle SchnuffWuffs habt ihr von nun an das Recht, öffentlich mit dem Schwanz zu wedeln, ohne dass die Sittenwächter euch dafür an den Pranger stellen.');
INSERT INTO "item_descriptions" VALUES(18640,'de','„Hast du das dicke Ding gesehen?“ Das waren die letzten Worte von Ronkad Dudn, Iop-Adeptin, die sie beim Besuch des Ouginak-Tempels zu ihrem Freund Lukas Kelber gesagt hat. Ob sie damit den schönen Knochen meinte, den sie gerade erblickt hatte, oder den Molosser, der ihn bewachte, wird wohl auf immer ein ungelöstes Rätsel bleiben.');
INSERT INTO "item_descriptions" VALUES(18659,'de','Dieser gelbe, saugfähige Schild mit vielen Poren wurde aus den Überresten eines Tieres gefertigt, das sich in einer Maskananas am Meeresgrund verkrochen hatte.');
INSERT INTO "item_descriptions" VALUES(18660,'de','Dieser Schild ist der Trophäe nachempfunden, die die Gewinner des berühmten Dracotruterrennens erhalten. Er ist gewiss weniger eindrucksvoll als der Originalpokal, verhindert jedoch, dass ihr entzweigehauen werdet, was sich letztendlich auch als äußerst nützlich erweisen kann.');
INSERT INTO "item_descriptions" VALUES(18661,'de','Um Tief- und Schicksalsschläge abzuwehren, ist dieser Schild aus dem Dorf Aerdala einfach perfekt geeignet.');
INSERT INTO "item_descriptions" VALUES(18662,'de','Um Tief- und Schicksalsschläge abzuwehren, ist dieser Schild aus dem Dorf Feudala einfach perfekt geeignet.');
INSERT INTO "item_descriptions" VALUES(18663,'de','Um Tief- und Schicksalsschläge abzuwehren, ist dieser Schild aus dem Dorf Teradala einfach perfekt geeignet.');
INSERT INTO "item_descriptions" VALUES(18664,'de','​Bei diesem Schild aus Stein handelt es sich in Wirklichkeit um einen Krachlerkopf, der vom Fuß eines Minotorors zermalmt wurde. Nur selten sind ein Dickkopf und übler Fußgeruch auf herrlichere Art kombiniert worden.');
INSERT INTO "item_descriptions" VALUES(18665,'de','Dieser Schild ist ganz klar eine Hommage an den Bowissen-Umhang, der wiederum einer berühmten Reliquie in Form dreier dreieckiger Fragmente nachempfunden ist. Alles in allem eine ziemlich hanebüchene Geschichte.');
INSERT INTO "item_descriptions" VALUES(18666,'de','Dieser im Grunde ziemlich nutzlose Schild ist dennoch beeindruckend – auf Grund des Gestankes, den er permanent von sich gibt. Daher ist er auch der treue Begleiter vornehmlich junger Abenteurer.');
INSERT INTO "item_descriptions" VALUES(18667,'de','Le Tschuck setzte diesen Schild äußerst geschickt ein, um die DAU-GAU-Kugeln abzuwehren, mit denen er es unerklärlicherweise immer wieder zu tun bekam. Manch einer behauptet sogar, dass einige dieser Kugeln lebendig waren.');
INSERT INTO "item_descriptions" VALUES(18668,'de','So seltsam sich das anhören mag, aber es wird behauptet, dass man mit diesem Schild aus Holz und Fellen tatsächlich über eine kurze Distanz fliegen kann. Vorausgesetzt, man ist leicht genug! Eine wunderbare Einlage, um seine Gegner ein letztes Mal zu verblüffen, bevor man auf dem Boden aufschlägt und sich zum Affen macht.');
INSERT INTO "item_descriptions" VALUES(18669,'de','Dieser enorme Schild rettete einst den Abenteurer Kloom davor, vom Gewicht eines Krachlers zerquetscht zu werden, der sich in ihn verliebt hatte. Die Geschichte verschweigt jedoch, ob er auch die Nebenwirkungen seiner leidenschaftlichen Beziehung mit dem Krachler überlebt hat.');
INSERT INTO "item_descriptions" VALUES(18670,'de','Ein junger Abenteurer meldete sich einst freiwillig zur Bonta-Miliz, um für die Unterdrückten zu kämpfen. Allerdings wurde er wegen seiner kränklichen Verfassung direkt wieder ausgemustert. Ein Alchemist aus Amakna nahm sich seiner an, um an ihm einen seiner neuen Zaubertränke auszuprobieren. Die Wirkung trat sofort ein: Der junge Abenteurer verwandelte sich in einen wahren Krieger, der vor unbändiger Kraft nur so strotzte. Allerdings ließ ihn der Trank auch komplett verblöden. Er hatte sich in einen Iop verwandelt. Er ließ sich diesen Schild anfertigen, der als unzerstörbar galt, und würde fortan bis in alle Ewigkeit als Captain Amakna bekannt sein (zu Ehren eines illustren Chafer-Offiziers, der unter äußerst mysteriösen Umständen verschwunden war).');
INSERT INTO "item_descriptions" VALUES(18671,'de','Dieser aus Leder und Häuten bestehende Schild wird euch wie eine zweite Haut begleiten, so sehr wird er euch gefallen. Ihr solltet allerdings unbedingt daran denken, seine Furunkel und Warzen von Zeit zu Zeit zu behandeln, damit er nicht reißt.');
INSERT INTO "item_descriptions" VALUES(18672,'de','Nicht alle Wabbits sind klein und ungefährlich. In Wirklichkeit sind sie garstige Kreaturen! Einige von ihnen sind sogar dermaßen skrupellos, dass sie Kawotten mit diesen enormen Schilden zu Brei schlagen, um daraus Saft zu gewinnen.');
INSERT INTO "item_descriptions" VALUES(18673,'de','Ein berühmter Abenteurer und Sammler verbrachte einst sein ganzes Leben damit, nach genau dieser Art von Schild zu suchen. Der Legende nach erwartet nämlich denjenigen, dem es gelingt, vier von diesen Schilden zu vereinen, ein besseres Leben.');
INSERT INTO "item_descriptions" VALUES(18674,'de','Wenn auch ihr immer schon davon geträumt habt, ein echter Brigandiner zu sein, dann ist dieser Schild genau das Richtige für euch. Seit langer Zeit wird er nun schon von Generation zu Generation weitergegeben. Mit seiner Hilfe könnt ihr alle jungen Abenteurer von Astrub auseinandernehmen, ohne auch nur einen einzigen Kratzer abzubekommen.');
INSERT INTO "item_descriptions" VALUES(18675,'de','Er mag zwar grünlich und übelriechend sein, doch wird euch dieser Schild gute Dienste dabei leisten, wenn ihr die Kreaturen des O''Stinkus Mons besiegen wollt.');
INSERT INTO "item_descriptions" VALUES(18676,'de','Ursprünglich diente dieser Schild Holzfällern zum Schutz vor herabfallenden Bäumen und Ästen. Allerdings wurde er sehr schnell dazu umfunktioniert, seinen Träger vor anfallenden Gegnern zu schützen, da diese manchmal die lästige Angewohnheit haben, in den ungünstigsten Momenten aufzutauchen.');
INSERT INTO "item_descriptions" VALUES(18677,'de','Dieser Schild schützt euch vor Regen und Krötensabber. Darüber hinaus zeigt er euren Gegnern, welche Stunde es geschlagen hat. Sehr nützlich, wenn ihr ihnen dabei helfen wollt, den günstigsten Zeitpunkt für ihre Niederlage zu ermitteln.');
INSERT INTO "item_descriptions" VALUES(18678,'de','Dieser Schild schützt euch vor Steinschlag und Schlammsalven. Darüber hinaus zeigt er euren Gegnern, welche Stunde es geschlagen hat. Sehr nützlich, wenn ihr ihnen dabei helfen wollt, den günstigsten Zeitpunkt für ihre Niederlage zu ermitteln.');
INSERT INTO "item_descriptions" VALUES(18679,'de','Dieser Schild schützt euch vor gefährlichen Winden eurer Gegner. Darüber hinaus zeigt er ihnen, welche Stunde es geschlagen hat. Sehr nützlich, wenn ihr ihnen dabei helfen wollt, den günstigsten Zeitpunkt für ihre Niederlage zu ermitteln.');
INSERT INTO "item_descriptions" VALUES(18680,'de','Dieser Schild schützt euch vor Meteorschlägen und Feuerspuckern. Darüber hinaus zeigt er euren Gegnern, welche Stunde es geschlagen hat. Sehr nützlich, wenn ihr ihnen dabei helfen wollt, den günstigsten Zeitpunkt für ihre Niederlage zu ermitteln.');
INSERT INTO "item_descriptions" VALUES(18681,'de','Dieser Schild ist ideal, um auf Pandala unbemerkt zu bleiben, und an jedem anderen Ort sofort aufzufallen. Er ist mit Pandawa-Haaren überzogen, denen man nachsagt, sie würden keinerlei Allergien verursachen. Daher lässt er sich diskret und völlig ohne Nebenwirkungen in eurem Lederschlüpfer verbergen.');
INSERT INTO "item_descriptions" VALUES(18682,'de','Wenn ihr euch hinter diesem Schild versteckt, werden euch die naivsten unter den Abenteurern sicher für einen gefährlichen Astaknyden halten und schreiend davonrennen. Andere hingegen könnten euch allerdings in der Hoffnung angreifen, ein wenig Bernstein zu ergattern.');
INSERT INTO "item_descriptions" VALUES(18683,'de','Dieser wunderhübsche Schild enthält Wasser aus dem Assel-Meer. Daher wird er euch nicht nur Glück bringen, sondern auch vor dem Verdursten bewahren, wenn eure Liebste wieder mal vergessen hat, euch die Feldflasche einzupacken.');
INSERT INTO "item_descriptions" VALUES(18684,'de','Dieser ungewöhnlich schöne Schild ist mit der getragenen Unterhose eines Chafers bezogen. Damit könnt ihr euren Gegnern auf anschauliche Weise vermitteln, dass ihr ihnen die Lederhosen ausziehen werdet, sollten sie sich mit euch anlegen.');
INSERT INTO "item_descriptions" VALUES(18685,'de','Ursprünglich diente dieser Schild den Sadidas als Hocker, wenn sie sich einmal ausruhen wollten. Doch mit eingeklappten Füßen kann er euch auch gut vor allen Arten von Angriffen beschützen, außer natürlich vor den Lachanfällen eurer Gegner.');
INSERT INTO "item_descriptions" VALUES(18686,'de','Wenn eure Verbündeten außer Atem geraten oder ihr die Wirkung einer Panikwelle zerstreuen wollt, so kommt euch dieser Fächer gerade recht. Ihr müsst ihn nur kräftig in alle Richtungen auf und ab schütteln, genau so, als wolltet ihr wieder einmal einen schreienden Säugling beruhigen.');
INSERT INTO "item_descriptions" VALUES(18687,'de','Um Tief- und Schicksalsschläge abzuwehren, ist dieser Schild aus dem Dorf Akwadala einfach perfekt geeignet.');
INSERT INTO "item_descriptions" VALUES(18688,'de','Der Wirt der Taverne Feubuk in Bonta muss sich sehr gelangweilt haben, als ihm plötzlich die Idee kam, die Türsteher seines Gasthauses mit Werbetafeln auszustatten.');
INSERT INTO "item_descriptions" VALUES(18689,'de','Dieser Schild ist mit zahlreichen Augen übersät. Bestimmt, um eure Gegner noch besser im Auge behalten zu können.');
INSERT INTO "item_descriptions" VALUES(18690,'de','Dieser Schild zeigt euren Gegnern deutlich, dass ihr in den Ebenen des Sidimot-Gebietes aufgewachsen seid. Das scheint bereits auszureichen, um sie in die Flucht zu schlagen.');
INSERT INTO "item_descriptions" VALUES(18691,'de','Dieser Schild schützt euch vor Steuern und einer ungerechten Vermögensverteilung.');
INSERT INTO "item_descriptions" VALUES(18692,'de','Der riesige Edelstein dieses Schildes blendet eure Gegner, funktioniert allerdings nur bei direkter Sonneneinstrahlung. Wirkt nicht gegen Zombie-Hohlköpfe und andere blinde aber gefährliche Kreaturen.');
INSERT INTO "item_descriptions" VALUES(18693,'de','Wurde von Bruce Boulgour höchstpersönlich verwendet, als er dringend ein Rettungsbrett benötigte.');
INSERT INTO "item_descriptions" VALUES(18694,'de','Keine Distel ohne Dornen.');
INSERT INTO "item_descriptions" VALUES(18695,'de','Dieses riesige Kawottenrondell wehrt die unterschiedlichsten magischen Angriffe ab, hält Wabbitbissen allerdings nicht sehr lange stand.');
INSERT INTO "item_descriptions" VALUES(18696,'de','Wenn der Bernstein im Kampf zerschlagen wird, ist es durchaus möglich, dass die kleine, miese Arachnee, die seit 53 Jahren in ihm gefangen ist, herausschießt, um euch zu beißen.');
INSERT INTO "item_descriptions" VALUES(18697,'de','Mit diesem Schild könntet ihr die Zeit zurückdrehen, wenn es ihm nicht an den nötigen Fähigkeiten mangeln würde.');
INSERT INTO "item_descriptions" VALUES(18698,'de','Dieser Schild ist nicht nur für Einbrecher eine harte Nuss.');
INSERT INTO "item_descriptions" VALUES(18699,'de','Dieser Schild widersteht allem außer der Waffe, mit der die Bestie getötet wurde, die dachte, sich mit diesem Panzer verteidigen zu können.');
INSERT INTO "item_descriptions" VALUES(18700,'de','Diesen hochmodernen Schild ziert ein eher altertümliches Ornament, das möglicherweise die vier Jahreszeiten symbolisieren soll oder die vier Finger an der Hand der Männer vom Sägewerk oder aber auch die vier Hirnzellen desjenigen, der geglaubt hat, sich mit diesem Schild verteidigen zu können.');
INSERT INTO "item_descriptions" VALUES(18701,'de','Dieser Schild besteht aus sehr zerbrechlichem Glas. Er schützt euch zwar nicht besonders lange, allerdings stellt ihr so sicher, dass euer Gegner sieben Jahre Pech hat, wenn er ihn zerschlägt. Eine angenehme Art, sich nach einer erniedrigenden Niederlage zu trösten.');
INSERT INTO "item_descriptions" VALUES(18702,'de','Eigentlich war dieser Hut als Kopfschutz gedacht, wurde allerdings von einem Abenteurer mit ausgesprochenem Dickkopf als Schild verwendet.');
INSERT INTO "item_descriptions" VALUES(18703,'de','Wenn es sehr heiß ist, öffnet sich dieser Schild und gibt einen übelriechenden Saft von sich. Ein wahres Schauspiel der Natur!');
INSERT INTO "item_descriptions" VALUES(18709,'de','Mit diesem Schild bringt ihr die Frisuren eurer Gegner durcheinander und könnt diesen Überraschungsmoment für einen Angriff nutzen.');
INSERT INTO "item_descriptions" VALUES(18710,'de','Ein Knochenjob, dem eigentlich nur ein echter Chafer-Infanterist gewachsen ist.');
INSERT INTO "item_descriptions" VALUES(18711,'de','Tut nicht so, als würdet ihr verstehen, was sich der Künstler bei diesem Werk gedacht hat.');
INSERT INTO "item_descriptions" VALUES(18712,'de','Dieser Schild schmeckt leider nicht nach Honig, sondern nach einer bevorstehenden Niederlage.');
INSERT INTO "item_descriptions" VALUES(18713,'de','Dieser Schild ist so geformt, dass man mit ihm leicht Crocodyll-Tränen auffangen kann, wenn die Gegner erst einmal geschlagen sind.');
INSERT INTO "item_descriptions" VALUES(18714,'de','Der Künstler, der für diesen Schild verantwortlich ist, wollte ihn eigentlich „Die Blume des Bösen“ nennen, aber dieser Name durfte aus rechtlichen Gründen nicht verwendet werden.');
INSERT INTO "item_descriptions" VALUES(18715,'de','Dieser Schild wurde so konzipiert, dass man ihn auf dem Rücken tragen kann. Manch einer schützt so seinen Allerwertesten, andere nehmen diese Eigenschaft zum Anlass, anderen beim kleinsten Problem den Rücken zuzukehren.');
INSERT INTO "item_descriptions" VALUES(18718,'de','Dieser Schild wurde von Larry Stotales entworfen. Zwar bewahrt er euch nicht vor dem sicheren Tod, aber er sorgt aber für eine hübsche und kurvenreiche Silhouette.');
INSERT INTO "item_descriptions" VALUES(18774,'de','Der Keiler, dessen Überreste den Gürtel von Graf Razoff zieren, nimmt einen ganz besonderen Platz unter all seinen Trophäen ein: Er war sein erstes Opfer. Dieser Keiler war äußerst aggressiv und terrorisierte die Einwohner in der Umgebung von Bonta.');
INSERT INTO "item_descriptions" VALUES(18775,'de','Die Jäger, die auf Mohnalisas Insel eingetroffen sind, hatten mit so einem Schauspiel nicht gerechnet. Einigen von ihnen drehte sich der Magen um und sie mussten die Insel sofort wieder verlassen. Graf Razoff hingegen fand sich letztendlich mit all diesen grellen Farben ab und fing sogar an, sie in seine Privatgarderobe einfließen zu lassen.');
INSERT INTO "item_descriptions" VALUES(18776,'de','Wer Graf Razoffs Auftritt nicht liebt, muss schon einen an der Glocke haben.');
INSERT INTO "item_descriptions" VALUES(18777,'de','Dieser Umhang versinnbildlicht den Wahn der Hinterwäldler, die Gefangene ihrer eigenen Leidenschaft sind – der Jagd.');
INSERT INTO "item_descriptions" VALUES(18778,'de','Von Reinigungskräften werden diese Schuhe gern bei der Art von Arbeit getragen, die sie gern als "Saubermachen" bezeichnen.');
INSERT INTO "item_descriptions" VALUES(18779,'de','Hinterwäldler sind nicht gerade sensibel und legen gerne dieses Amulett an, kurz bevor sie ihrer Beute den Todesstoß versetzen.');
INSERT INTO "item_descriptions" VALUES(18780,'de','Mätzgarghs sind nicht gerade für ihre Feinsinnigkeit bekannt. Wenn sie sauer sind, toben sie sich gerne am Hackbrett aus.');
INSERT INTO "item_descriptions" VALUES(18808,'de','Dieser Gürtel kam dank seiner bemerkenswerten Eigenschaft, ohne die geringste Anstrengung Fett zu verbrennen, schon bei unzähligen Diäten zum Einsatz.');
INSERT INTO "item_descriptions" VALUES(18853,'de','Mit dieser Klinge benötigt ihr keine Fackel mehr, um euren Weg zu erhellen, und auch kein Lagerfeuer. Ihr könnt euer Fleisch und andere Leckereien einfach dadurch grillen, dass ihr sie damit aufspießt.');
INSERT INTO "item_descriptions" VALUES(1019044,'de','Ihr raues Benehmen ist unentschuldbar, aber ihr könnt einfach nicht anders: Ihr müsst sie einfach nach jeder ihrer Dummheiten fest an euch drücken und ihr sofort alles verzeihen.');
INSERT INTO "item_descriptions" VALUES(19075,'de','Was wäre ein Vampir ohne seine geliebten Kostümbälle? Der Kostümball von Vierpfötchen scheint länger zu dauern als man es von anderen gewohnt ist: Anerice weigert sich schon seit Jahren, ihr Kostüm abzulegen.');
INSERT INTO "item_descriptions" VALUES(19076,'de','Die Ähnlichkeit mit einem Prespik ist wirklich verblüffend. Wenn ihr diesen Umhang anlegt, könnte es euch deutlich schwerer fallen, Gefährten für neue Abenteuer zu finden.');
INSERT INTO "item_descriptions" VALUES(19077,'de','In einem Anflug von Klarsicht neigen einige Ghule manchmal urplötzlich dazu, ihren Herrn und Meister anzugreifen. Anerice hat diesen Schild eigentlich konzipiert, um sich in solchen Situationen verteidigen zu können. Allerdings hat das nicht sonderlich gut funktioniert. Also begnügt sie sich bis aufs Weitere damit, ihnen den Schild einfach über die Rübe zu ziehen.');
INSERT INTO "item_descriptions" VALUES(19078,'de','Dieser Ring streckt die Zunge heraus, wenn ihr Hunger habt. Oder anders gesagt: Er streckt immer die Zunge heraus.');
INSERT INTO "item_descriptions" VALUES(19079,'de','Wer solche Stiefel an den Füßen trägt, kann nicht ganz richtig im Kopf sein.');
INSERT INTO "item_descriptions" VALUES(19080,'de','Dieser Schild gehörte einst dem berühmten General de Ghul. Dieser tapfere Ghul bereitete einst im Geheimen eine Rebellion gegen die Vampyre vor. Allerdings fiel es ihm äußerst schwer, Verbündete unter seinen Artgenossen zu finden. Letztendlich schritt er im Alleingang zur Tat, am 18. Junissidor: Heldenmutig warf er einem Vampyr eine Schaufel entgegen.
Auch wenn diese Tat keine besondere Wirkung erzielte, hat sich dieses Ereignis doch tief in die Erinnerung aller Ghule gebrannt. Sie haben sich bis heute noch nicht gänzlich davon erholt und erzählen immer wieder gerne von der heroischen Tat General de Ghuls und seiner Schaufel am 18. Junissidor.');
INSERT INTO "item_descriptions" VALUES(19081,'de','Da können diese Skorpiuten noch so gut gepanzert sein: Dieser Helm bietet euch paradoxerweise genau dort Schutz, wo sie keinen haben: am Kopf.');
INSERT INTO "item_descriptions" VALUES(19082,'de','Dieser Umhang gräbt sich in euren Rücken, was auch seine Farbe erklärt.');
INSERT INTO "item_descriptions" VALUES(19083,'de','Die Gelehrten treffen regelmäßig zusammen, um Gifte nach ihrem Gefährlichkeitsgrad einzuteilen: Die Kategorien reichen von "ein wenig tödlich" bis "mordstodbringend". Sie stützen ihre Erkenntnisse auf die Dichte der Geister, die sich bei den Quellen des jeweiligen Gifts einfinden. Anhand dieser Kategorisierung wird das Skorpiutgift als "nicht gerade wenig tödlich" eingestuft. Wenn ihr dieses Amulett tragt, kann das zwei Dinge bedeuten: Entweder interessiert euch das Ganze überhaupt nicht, oder aber ihr werdet schon bald die Bedeutung dieser Einteilung verstehen.');
INSERT INTO "item_descriptions" VALUES(19084,'de','Die Ähnlichkeit dieses Schildes mit dem von Captain Amakna beschränkt sich lediglich auf sein Aussehen: Auch Illusionen haben ihre Grenzen.');
INSERT INTO "item_descriptions" VALUES(19085,'de','Anhand dieser Stiefel könnt ihr eines der am besten gehüteten Geheimnisse von Helmukol lüften: Das hier sind nicht die Stiefel, mit denen er schweben kann. Das bringt euch also auch nicht weiter.');
INSERT INTO "item_descriptions" VALUES(19086,'de','Wenn ihr diese Maske aufsetzt, seht ihr seltsamerweise aus wie ein Nagetier. Das zeigt mal wieder, wie der Zauber der Magie auch euch verschönern kann.');
INSERT INTO "item_descriptions" VALUES(19087,'de','Manche Leute sind nicht der Meinung, dass Kleider Leute machen. Das gilt allerdings nicht für die Riktanz.');
INSERT INTO "item_descriptions" VALUES(19088,'de','Als Akrobaten wissen die Riktanz ganz genau, dass ein Umhang manchmal zu einem tödlichen Handicap werden kann. Manche können und wollen aber trotzdem nicht auf ihren Umhang verzichten, darum kürzen sie ihn weitgehend ein, um das Risiko zu mindern.');
INSERT INTO "item_descriptions" VALUES(19089,'de','Riktanz, sich selbst und andere zu amüsieren ohne Unterlass, das ist euer Credo.');
INSERT INTO "item_descriptions" VALUES(19090,'de','Traut ja nicht seinem gelassenen Aussehen und seinem leeren Blick! Der BullyWuWulf bricht die Herzen der stolzesten WollyWuWulfs ... und gern auch eure Rippen.');
INSERT INTO "item_descriptions" VALUES(19091,'de','Pfeift auf die Blicke und Vorurteile der anderen und tragt mit Stolz diesen BullyWuWulf-Pelz als Zeichen eurer Rebellion: All der Spott wird euch nur stärker machen! Früher oder später.');
INSERT INTO "item_descriptions" VALUES(19092,'de','Ein ganzes Ökosystem scheint sich entlang des Leders angesiedelt zu haben. Achtet gut darauf!');
INSERT INTO "item_descriptions" VALUES(19093,'de','In Vierpfötchen gibt es schaufelweise Ghule.');
INSERT INTO "item_descriptions" VALUES(19096,'de','Wenn Ghule anfangen, sich existenzielle Fragen zu stellen, versetzt man ihnen normalerweise einen heftigen Hieb mit diesem Hammer, um sie in ihren Normalzustand zurückzubringen.');
INSERT INTO "item_descriptions" VALUES(19105,'de','Dieses Schwert wurde irgendwann in dem Zeitraum zwischen der Erfindung der Fackel und der Erfindung der Taschenlampe geschmiedet.');
INSERT INTO "item_descriptions" VALUES(19116,'de','Dieser Schild schützt nicht vor Spott und Häme.');
INSERT INTO "item_descriptions" VALUES(19139,'de','Das Ding ist eine Hand, die denken, schreiben und selbstständig handeln kann. Sie besitzt ein äußerst hilfsbereites Wesen. Es heißt, dass sie einst in den Diensten einer angesehenen Familie aus Vierpfötchen gestanden haben soll, den Dadams. Was sie allerdings mit dieser Hand anstellten (wir können an dieser Stelle aus Gründen des Anstandes nicht näher darauf eingehen), hat sie dazu veranlasst zu fliehen, um sich einen weniger perversen Besitzer zu suchen. Nun ist sie bei euch gelandet, doch höchstwahrscheinlich seid ihr auch nicht viel besser als die Dadams. Das Ding wird vom Schicksal wirklich schwer gebeutelt.');
INSERT INTO "item_descriptions" VALUES(19165,'de','Es kommt nicht von ungefähr, dass dieser Gegenstand der Weißnachtshorror-Maske ähnelt. Er wurde nämlich vom selben Handwerksmeister hergestellt, Jack dem Sram. Dieser hatte viele Gesichter: Er war zugleich verschlagenes Skelett, exzentrischer Frigostianer und vom Pech verfolgter Scherzkeks. Das könnte erklären, warum seine Totenmasken über eine derartige Macht verfügen: Sie ermöglichen es einem Lebenden, das Reich der Toten zu betreten.');
INSERT INTO "item_descriptions" VALUES(19241,'de','Dieses Amulett symbolisiert den Mut und die Tapferkeit. Zumindest gibt es Gelehrte, die das behaupten.');
INSERT INTO "item_descriptions" VALUES(19242,'de','Diese steinernen Stiefel eignen sich perfekt für den Kampf, sofern ihr genug Kraft in den Beinen habt, um sie hochzuheben.');
INSERT INTO "item_descriptions" VALUES(19243,'de','Dieser Umhang verfügt über eine Art eingebauten Gürtel. Auf diese Weise könnt ihr ihn jederzeit um die Hüfte befestigen und so eure Feinde daran hindern, sich an ihn zu klammern, um euch das Kämpfen zu erschweren.');
INSERT INTO "item_descriptions" VALUES(19244,'de','Dieses Amulett symbolisiert den Mut und die Tapferkeit. Zumindest gibt es Gelehrte, die das behaupten.');
INSERT INTO "item_descriptions" VALUES(19245,'de','Diese steinernen Stiefel eignen sich perfekt für den Kampf, sofern ihr genug Kraft in den Beinen habt, um sie hochzuheben.');
INSERT INTO "item_descriptions" VALUES(19246,'de','Dieser Umhang verfügt über eine Art eingebauten Gürtel. Auf diese Weise könnt ihr ihn jederzeit um die Hüfte befestigen und so eure Feinde daran hindern, sich an ihn zu klammern, um euch das Kämpfen zu erschweren.');
INSERT INTO "item_descriptions" VALUES(19247,'de','Wurden diese Flügel absichtlich hier platziert, um eine bestimmte Botschaft zu vermitteln? Es liegt nun an euch, ihrer würdig zu sein.');
INSERT INTO "item_descriptions" VALUES(19248,'de','Manchmal reicht es schon, einen kurzen Blick auf die Schuhe einer Person zu werfen, um zu wissen, mit wem man es zu tun hat. Also, was sagen einem diese hier?');
INSERT INTO "item_descriptions" VALUES(19249,'de','Falls ihr noch nicht wissen solltet, was ihr beim nächsten Karneval anziehen werdet, bietet sich euch hiermit eine interessante Möglichkeit.');
INSERT INTO "item_descriptions" VALUES(19250,'de','Wurden diese Flügel absichtlich hier platziert, um eine bestimmte Botschaft zu vermitteln? Es liegt nun an euch, ihrer würdig zu sein.');
INSERT INTO "item_descriptions" VALUES(19251,'de','Manchmal reicht es schon, einen kurzen Blick auf die Schuhe einer Person zu werfen, um zu wissen, mit wem man es zu tun hat. Also, was sagen einem diese hier?');
INSERT INTO "item_descriptions" VALUES(19252,'de','Falls ihr noch nicht wissen solltet, was ihr beim nächsten Karneval anziehen werdet, bietet sich euch hiermit eine interessante Möglichkeit.');
INSERT INTO "item_descriptions" VALUES(19253,'de','Dieser diskrete und leichte Umhang eignet sich gut für Spionagemissionen, insbesondere dann, wenn man sich im Schnee verstecken muss.');
INSERT INTO "item_descriptions" VALUES(19254,'de','Diese Kapuze wird es euch ermöglichen, anonym zu bleiben. So könnt ihr die Reichen bestehlen und die Armen beschenken, ohne jeglichen Ruhm zu erwerben.');
INSERT INTO "item_descriptions" VALUES(19255,'de','Dieses Amulett wird gewöhnlich von den Spionen Bontas getragen. Aber jedermann kann sich so eines beschaffen: Auf diese Weise verwischen sie ihre Spuren.');
INSERT INTO "item_descriptions" VALUES(19256,'de','Dieser diskrete und leichte Umhang eignet sich gut für Spionagemissionen, insbesondere dann, wenn man sich im Dunkeln verstecken muss.');
INSERT INTO "item_descriptions" VALUES(19257,'de','Diese Kapuze wird es euch ermöglichen, anonym zu bleiben. So könnt ihr die Armen bestehlen und die Reichen beschenken, ohne jeglichen Ruhm zu erwerben.');
INSERT INTO "item_descriptions" VALUES(19258,'de','Dieses Amulett wird gewöhnlich von den Spionen Brâkmars getragen. Aber jedermann kann sich so eines beschaffen: Auf diese Weise verwischen sie ihre Spuren.');
INSERT INTO "item_descriptions" VALUES(19259,'de','Die Weiße Stadt stand schon mehrfach am Rande der Zerstörung und benötigt deshalb stets Krieger, Priester und Spione, die sie schützen. Hinter diesem Schild verbirgt sich einer dieser Bonta, der bereit ist, sein Leben für diese Stadt zu riskieren.');
INSERT INTO "item_descriptions" VALUES(19260,'de','Die Schwarze Stadt ist schon einige Male zerstört und wieder aufgebaut worden und benötigt deshalb stets Krieger, Priester und Spione, die sie schützen. Hinter diesem Schild verbirgt sich einer dieser Brâk, der bereit ist, sein Leben für diese Stadt zu riskieren.');
INSERT INTO "item_descriptions" VALUES(19261,'de','Man erzählt sich, dass in diesem Amulett ein kleiner Teil der Macht des Opal-Dofus stecken soll. Wenn das kein tolles Verkaufsargument ist!');
INSERT INTO "item_descriptions" VALUES(19262,'de','Ilyzaelle strahlt ein derartiges Charisma aus, dass manche Ritter sich von selbst bereit erklärt haben, ihr zu dienen. Dazu gehören nicht zuletzt auch die unbesungenen Ritter des Doziak: Die Besten unter ihnen trugen eine vergoldete Rüstung, die sie selbst angefertigt hatten, um diejenige Ilyzaelles zu imitieren, wie sie sagten.');
INSERT INTO "item_descriptions" VALUES(19263,'de','Der Handwerker, der diesen Schild geschmiedet hat, scheint ihn mit einem einfach Opal besetzt zu haben, stellvertretend für den Dofus der Könige.');
INSERT INTO "item_descriptions" VALUES(19264,'de','Wusstet ihr, dass die Brennenden Seelen danach trachten, Besitz von den Körpern der Sterblichen zu ergreifen? Vermutlich nicht, sonst würdet ihr ja wohl keinen Trauring der Brennenden Seelen tragen ...');
INSERT INTO "item_descriptions" VALUES(19265,'de','Da sie nicht von eurem Körper Besitz ergreifen konnten, haben zwei Brennende Seelen stattdessen versucht, sich dieser Schuhe zu bemächtigen. Sie sehen ganz glücklich aus.');
INSERT INTO "item_descriptions" VALUES(19266,'de','Es braucht schon einiges mehr, um genauso bedrohlich auszusehen wie eine Brennende Seele, aber das ist doch immerhin ein Anfang.');
INSERT INTO "item_descriptions" VALUES(19267,'de','Wenn ihr nicht mit einem Wurfspeer umzugehen wisst, könnt ihr ja immer noch versuchen, ihn als eine Art Stecken zu verwenden.');
INSERT INTO "item_descriptions" VALUES(19268,'de','Ilyzaelle zückt im Kampf nur selten ihre Dolche. Sie zieht es vor, diese eher wie Messer zu verwenden.');
INSERT INTO "item_descriptions" VALUES(19269,'de','Von diesem Schwert hat offenbar ein Brandrevenant Besitz ergriffen. Es empfiehlt sich daher, vorsichtig damit umzugehen und Handschuhe zu tragen, um jeden Kontakt mit der Brennenden Seele zu vermeiden.');
INSERT INTO "item_descriptions" VALUES(19270,'de','Dieser Bogen wurde von Energien aus Externam verdorben und steht mit dem Reich der Toten in Verbindung. Wenn einer seiner Pfeile sein Ziel trifft, ist es sogar sehr wahrscheinlich, dass er es geradewegs dorthin schickt!');
INSERT INTO "item_descriptions" VALUES(1019286,'de','Frestor wird schon seit seiner frühesten Kindheit für den Krieg ausgebildet. Mit einem einzigen Biss kann er eine Bierdose öffnen ... oder auch den Schädel eines Brâk.');
INSERT INTO "item_descriptions" VALUES(1019291,'de','Freslux wird schon seit seiner frühesten Kindheit für den Krieg ausgebildet. Mit einem Stoß seiner Hörner kann er Grillfleisch aufspießen ... oder auch den Kopf eines Bonta.');
INSERT INTO "item_descriptions" VALUES(19398,'de','Dieser Dofus ist trotz seines etwas ungewöhnlichen Aussehens ein echtes Drachenei. Wäre also zu schade, wenn ihr ihn versetzen würdet. In langen Winternächten wärmt er euch, auf Grillpartys im Sommer spendet er Feuer. Vermeidet es aber, damit zu nah an Heuschobern oder trockenen Holzböden vorbeizugehen. Sonst hält man euch schon bald für einen gefährlichen Pyromanen.');
INSERT INTO "item_descriptions" VALUES(19415,'de','Diese Handschuhe sind für die präzise Probenentnahme gedacht. Für den Kampf eignen sie sich nicht.');
INSERT INTO "item_descriptions" VALUES(19482,'de','Mit seinem göttlichen Hammer schuf Gobanos dieses Schwert. Mithilfe der Macht seines Nekronyx'' könnt ihr Immortalier in Stein verwandeln.');
INSERT INTO "item_descriptions" VALUES(19531,'de','Dieser Magma-SchnuffWuff kommt aus den Vulkanen von Sidimot und entstammt einer langen Ahnenreihe von Zerberussen, die alle von Ouginaks abgerichtet wurden. Einigen Legenden zufolge war es notwendig, junge unschuldige Seelen zu opfern, um seine Wildheit zu entfesseln. Aber das scheint heute nicht mehr der Fall zu sein.');
INSERT INTO "item_descriptions" VALUES(19585,'de','Ihr habt nicht nur Feuer im Hintern, sondern ab jetzt auch unter den Füßen.');
INSERT INTO "item_descriptions" VALUES(19586,'de','Euer glutheißer Blick wird jeden zum Schmelzen bringen und euren Gegnern Feuer unterm Hintern machen.');
INSERT INTO "item_descriptions" VALUES(19589,'de','Dieser feuerbeständige Umhang entfaltet sein ganzes Potential, vor allem bei heruntergebranntem Feuer.');
INSERT INTO "item_descriptions" VALUES(19590,'de','Auf der Rückseite dieses Amuletts könnt ihr folgendes Sprichwort entziffern: „Stiftest du deinem Gott eine Kerze, stifte zwei für Rushu.“');
INSERT INTO "item_descriptions" VALUES(19591,'de','Dieser Sack hilft euch dabei, über Rauchzeichen zu kommunizieren. Aber Vorsicht: Wo Rauch ist, ist auch Feuer.');
INSERT INTO "item_descriptions" VALUES(19592,'de','Diese Schuhe verfügen über eine Metallsohle, die euch leicht über alle Oberflächen gleiten lässt und dabei herrliche Funken sprüht, was eure niederen Pyromaneninstinkte befriedigt.');
INSERT INTO "item_descriptions" VALUES(19593,'de','Diese Axt ist gefährlicher als jeder Feuersturm, verheerender als jedes Sturmfeuer und raubt euren Gegnern den letzten Funken Hoffnung.');
INSERT INTO "item_descriptions" VALUES(19594,'de','Ob ihr Schädel oder Nüsse knacken wollt, mit diesem Omniknacker geht''s im Handumdrehen.');
INSERT INTO "item_descriptions" VALUES(19595,'de','Mit diesem Helm könnt auch ihr endlich mal ein breites Kreuz machen.');
INSERT INTO "item_descriptions" VALUES(19596,'de','Der verantwortliche Schuster hat sein ganzes Potential entfaltet, als er dieses Wunderwerk in aller Eile zusammengeflickt hat. Der Sinn seines Lieblingssprichworts „Was du heute kannst besorgen, pfeifen Spatzen von den Dächern morgen“ liegt bis heute im Dunkeln.');
INSERT INTO "item_descriptions" VALUES(19597,'de','Von ihm geht eine furchtbare Hitze aus. Darf nicht in falsche (Zwergen-)Hände geraten.');
INSERT INTO "item_descriptions" VALUES(19598,'de','Dieser Schild reflektiert Licht. Ihr braucht euer Spiegelbild erst gar nicht darauf zu suchen: Genau wie auf dem Schild von Solar wird es auch hier nicht erscheinen. xxx');
INSERT INTO "item_descriptions" VALUES(19599,'de','Dungeonwächter haben immer eine große Klappe, aber wenn es dann ans Töten geht, sind sie ziemlich kleinlaut.');
INSERT INTO "item_descriptions" VALUES(19600,'de','Wenn ihr euer Ohr an diese Riesenmuschel haltet, hört ihr vielleicht die Brandung des Mafroditen-Meers.');
INSERT INTO "item_descriptions" VALUES(19601,'de','Dieser unbeschreiblich große Haufen von Meeresschaum und gammeligen Korallen gibt seltsamerweise überhaupt keinen Übelkeit erregenden Gestank ab. Das ist für die Welt der Zwölf so außergewöhnlich, dass man es erwähnen sollte.');
INSERT INTO "item_descriptions" VALUES(19602,'de','Dieses doppelt genähte, wendbare Schmuckstück wurde aus unglaublich weichem Material gefertigt – innen wie außen. Wenn sie einmal dreckig sein sollte, müsst ihr sie nur umdrehen und könnt sie so noch einen Monat länger tragen.');
INSERT INTO "item_descriptions" VALUES(19603,'de','„Innen bequem, außen stachlig.“ Diese Schuhe erinnern euch an jemanden, der euch unglaubliches Leid zugefügt hat, den ihr aber trotzdem schmerzlich vermisst.');
INSERT INTO "item_descriptions" VALUES(19604,'de','Es ist schwierig zu sagen, wie genau diese Maske getragen werden soll ... Große Zähne, kleine Ohren oder andersherum. Diese Zwickmühle wird euch an langen Winterabenden genug Zerstreuung bieten.');
INSERT INTO "item_descriptions" VALUES(19605,'de','Der Künstler, der diesen Stab geschaffen hat, hat ein paar Tropfen Gischt, eine Prise Gammelzeug, eine Unze Böswilligkeit und ein Stückchen guten Willen verwendet.');
INSERT INTO "item_descriptions" VALUES(19606,'de','Dieser Wurfspeer verfügt über starke Magie, mit der er Kutteln in Zuckerstangen und gekochten Chicorée in Mäusespeck verwandeln kann. Furchtbar für Gourmets, aber eine wahre Wohltat für jüngere Generationen.');
INSERT INTO "item_descriptions" VALUES(19607,'de','Dieser Umhang gehörte einst einem gefährlichen, verbrecherischen Wasserbewohner, dem seine Sünden vergeben wurden.');
INSERT INTO "item_descriptions" VALUES(19608,'de','Dieser Ring macht euch berühmt, allerdings nur unter Krustentieren.');
INSERT INTO "item_descriptions" VALUES(19609,'de','Alten Schriften zufolge, die annähernd übersetzt werden konnten, gehörte diese seltsame Halskette einem halsstarrigen Halsabschneider, der sich immer wieder lauthals und vor allem Hals über Kopf halsbrecherische Unternehmungen aufhalste.');
INSERT INTO "item_descriptions" VALUES(19610,'de','„Der Vorteil an diesen Stiefeln aus totem Fisch ist, dass sie den Geruch meiner Füße übertünchen.“ In den Tiefen des Meeres schlummern augenscheinlich ein paar wahre Poeten.');
INSERT INTO "item_descriptions" VALUES(19622,'de','Mit diesem Ring könnt ihr sie wahrscheinlich nicht alle knechten, aber trotzdem fühlt ihr euch damit ziemlich stark. Das ist doch schon mal was.');
INSERT INTO "item_descriptions" VALUES(19629,'de','Dieses vom grauen Drachen Rattatrosk geschaffene Ei gibt wahrlich Rätsel auf. Obwohl seine Macht nicht an die eines Ur-Dofus heranreicht, scheint es doch älter als die Zeit zu sein ... Ihr solltet sehr gut darauf aufpassen. Letztlich wissen nur der Gott Xélor und die Nohrden, was die Zukunft bringen wird.');
INSERT INTO "item_descriptions" VALUES(19637,'de','Dieser Dreschflegel eignet sich eher für den Ehepartner als für Getreide.');
INSERT INTO "item_descriptions" VALUES(19639,'de','An den von diesem Schild abgewehrten Schlägen ließe sich der gesamte Verlauf aller bisherigen Kämpfe eines Abenteurers nachvollziehen.');
INSERT INTO "item_descriptions" VALUES(19641,'de','Früher wurde er nur bei religiösen Zeremonien verwendet, doch mittlerweile nutzt man ihn für alles Mögliche.');
INSERT INTO "item_descriptions" VALUES(19676,'de','Das Metall dieser Spitzhacke scheint so hart zu sein wie ein Diamant. Mit diesem Werkzeug kann man wahrscheinlich alles zerschlagen.');
INSERT INTO "item_descriptions" VALUES(19976,'de','Die Innenseite dieses Gürtels ist mit dem Flaum junger Nimbos ausgepolstert, die unwissentlich als freiwillige Spender auserkoren wurden.');
INSERT INTO "item_descriptions" VALUES(19977,'de','Dieser Ring wurde so an die Morphologie der Nimbos angepasst, dass sie ihn sich über jeden Finger und jede Zehe zwängen können.
Vielleicht könnt ihr in um euer Handgelenk tragen.');
INSERT INTO "item_descriptions" VALUES(19978,'de','Mit einem solchen Gewicht auf der Birne wird es schwer, lange den Kopf hoch zu halten.');
INSERT INTO "item_descriptions" VALUES(19979,'de','Einen Bart auf dem Rücken ist weniger praktisch als Augen am Hinterkopf.');
INSERT INTO "item_descriptions" VALUES(19980,'de','Um sein wahres Antlitz zu verbergen, geht doch nichts über einen falschen Bart.');
INSERT INTO "item_descriptions" VALUES(19981,'de','Axtkopf oder kleiner Anker? Ganz egal, euer Hals wird dieses „Schmuckstück“ der Nimbos auf jeden Fall verfluchen.');
INSERT INTO "item_descriptions" VALUES(19982,'de','Mit den kleinen Fühlern auf diesem Helm könnt ihr die komplizierte Sprache der Naskäfer entschlüsseln: „Vrrr, Brrr, Trrr, Krrr“ bedeutet „fressen, fressen, fressen und fressen“.');
INSERT INTO "item_descriptions" VALUES(19983,'de','Die großen Antennen hinten an diesem Gürtel dienen als Empfänger für Pheromone.
Sie machen euch mit wildem Zappeln darauf aufmerksam, wenn sich euch ein Wesen mit kompatiblem Erbgut nähert.
Zahlreiche Momente des Unbehagens stehen euch bevor!');
INSERT INTO "item_descriptions" VALUES(19984,'de','Dieses Amulett wurde von einem ehemaligen Naskäfer-Züchter hergestellt. Es riecht immer noch äußerst ansprechend nach Stall sowie einer Mischung aus Dung, Schweiß und viel zu schlecht bezahlter Arbeit.');
INSERT INTO "item_descriptions" VALUES(19985,'de','Durch schnelles Drehen maximieren die kleinen Flügel eure Fähigkeit, damit gestreichelte Personen zu kitzeln. Für manche ist es ein Folterinstrument, bei anderen steigert es die Lust ... Damit ihr euch selbst einen Eindruck verschaffen könnt, dürft ihr diesen Gegenstand nun an euch selbst ausprobieren.');
INSERT INTO "item_descriptions" VALUES(19986,'de','Der Fühler dient als Auflage für den Pfeil, das Horn beeindruckt die Gegner und die Flügel bringen gar nichts. Nun müsst ihr den Bogen nur noch kräftig spannen, um euer anvisiertes Ziel zu erledigen.');
INSERT INTO "item_descriptions" VALUES(20210,'de','Das legendäre Schwert, das Grougalorasalar einst seinem Sohn schenkte, befindet sich nun in eurem Besitz. Doch diese Waffe, die ihr aus dem Felsen gezogen habt, ist nur noch ein Schatten ihrer selbst ... Nun liegt es an euch, Crocobur seine Macht und Geschichte zurückzugeben.');
INSERT INTO "item_descriptions" VALUES(20213,'de','Nach einigen Anstrengungen haltet ihr endlich das Schwert des Kaisers in euren Händen, der vor langer Zeit fast einmal die ganze Welt erobert hätte. Vergesst jedoch nicht die Abmachung, die ihr mit Volkaragnar getroffen habt: Sobald ihr den Ebenholz-Dofus erhalten habt, müsst ihr Crocobur seinem Schöpfer zurückgeben. Man kann eben nicht alles haben.');
INSERT INTO "item_descriptions" VALUES(20286,'de','Als der Drache Rattatrosk den Silberdofus erschuf, während die Welt der Zwölf noch gar nicht existierte, ist ein Wunder geschehen: Die erste Phönix wurde wieder zum Leben erweckt. Seitdem ist viel Zeit vergangen, Götter sind verschwunden und Sterne erloschen. Doch auch heute noch strahlt das Ei, das ihr in euren Händen haltet, genau wie damals mit der Kraft von tausend Feuern ... wie eine verlorene Liebe, deren Flamme neu entfacht wurde.');
INSERT INTO "item_descriptions" VALUES(20353,'de','„Einige hundert Kameter vor den Toren der Stadt hatten sich tausende von Crocodylls zusammengerottet. Wir hatten uns auf den Angriff vorbereitet, die Wache hatte sich vollzählig vor dem großen Tor versammelt und die Kriegsmaschinen waren auf den Festungsmauern aufgestellt worden. Der Anblick der riesigen Reptilienarmee war bereits furchterregend, doch als wir IHN erblickten, gefror uns das Blut in den Adern. Crocoburio stand inmitten seiner Soldaten, er überragte sie alle um mehrere Köpfe und hatte sein verfluchtes Schwert drohend in unsere Richtung erhoben. Als sich die grüne Masse in Bewegung setzte, lief ein Schauder durch unsere Reihen und wir wussten, dass die Schlacht, die auf uns zukam, fürchterlich sein würde.“

– Ein Soldat aus Bonta');
INSERT INTO "item_descriptions" VALUES(20354,'de','Dieser Gegenstand ist legendär. Ihr nicht.');
INSERT INTO "item_descriptions" VALUES(20355,'de','Dieser Gegenstand ist legendär. Ihr nicht.');
INSERT INTO "item_descriptions" VALUES(20356,'de','„Es gab einmal eine Zeit, in der Schatztruhen noch völlig unbekannt waren. Die Enutrofs versteckten ihre Ersparnisse unter ihren Matratzen oder in ihren Sparstrümpfen. Die Eichhörnchen brachten ihre Nüsse im Inneren von Baumstämmen in Sicherheit, während die Drachen ihre Goldklumpen in dunklen und feuchten Höhlen aufhäuften. Dann jedoch schuf die Firma das Bankennetz. Eine echte Revolution! Endlich konnten die Zwölfianer ihr Hab und Gut hinter gepanzerten Türen aufbewahren. Natürlich gibt es immer ein paar Halsabschneider, die sich mit Dynamit den Weg freisprengen, und Kamaschmuggler, die zu raffgierige Abenteurer übers Ohr hauen. Aber all das ist nicht so schlimm. Man braucht einfach nur eine gute Versicherung.“

– Buhorado');
INSERT INTO "item_descriptions" VALUES(20357,'de','„Jeder Féca, der etwas auf sich hält, zieht mit einem Schild in die Schlacht. Aber der sicherste Schutz gegen gegnerische Angriffe, das beste Bollwerk gegen alle, die uns schaden oder uns vernichten wollen, ist die Einigkeit. Söldner! Die Zeit ist gekommen, unsere Querelen beiseitezulegen und uns unter einem gemeinsamen Banner zu versammeln. Astrub ist nur eine Handelsstadt. Sie wurde von einer Bande von Gaunern gegründet, die die Gaunerei an den Nagel gehängt haben. Astrub ist aber auch eine alte Stadt voller Kultur und Welterbe. Astrub ist eine Nation! Heute, werte Ratsmitglieder, werdet ihr einen neuen Anführer wählen. Ich habe mich selbst auf diesen Posten beworben. Werdet ihr mir euer Vertrauen schenken? Die Entscheidung liegt bei euch.“

– Fallanster, oberstes Ratsmitglied von Astrub');
INSERT INTO "item_descriptions" VALUES(20358,'de','„Der Tod ist ein notwendiges Übel, aber wenn er sich schon nicht abwenden lässt, ist es uns doch allen lieber, wenn er jemand anderen ereilt als uns, nicht wahr? Darum habe ich diesen Schild geschmiedet. Er ist unzerstörbar, unverwüstlich und zudem rostfrei. Er blockt alle Schläge ab, die euer Leben empfindlich verkürzen könnten. Trotz seiner imposanten Größe ist er leicht und überaus handlich. Außerdem wird sein makabres Aussehen all eure Gegner tief beeindrucken. Die größten Feiglinge unter ihnen werden das tiefe Schwarz seiner leeren Augenhöhlen nicht aushalten und kreischend davonlaufen. Muss ich noch mehr sagen, um euch zu überzeugen? Es folgt eine kleine Demonstration. Sergeant Racknacknock, Ihr seid dran.“

– Ein Handwerker, der lieber anonym bleiben möchte');
INSERT INTO "item_descriptions" VALUES(20359,'de','„Sie halten uns für klein und schwach. Sie machen sich über unsere Bräuche und uralten Traditionen lustig. Sie halten uns für stinkende, gierige und kulturlose Barbaren. Glauben sie denn wirklich, dass wir uns damit zufriedengeben, wie Sidoas im Dunkel unserer Minen herumzubuddeln? Die werden wir schon von ihrem hohen Ross herunterholen! Ich werde ihnen zeigen, aus welchem Holz die Nimbos geschnitzt sind. Ich werde ihre Höfe und Ernten verbrennen. Ich werde ihre Haare, ihre Wimpern und ihre Städte versengen. Ich werde ihre Fresssäcke scheren. Ich werde ihr Gold rauben, ihre Fässer leeren und ihre Banner zerfetzen. Ich bin der König unter dem Berg ... und schon bald werde ich der König der Welt sein!“

– Bram Weltbart');
INSERT INTO "item_descriptions" VALUES(20360,'de','„Wenn eine junge Seele den Tempel von Incarnam verlässt, träumt sie von dem Leben, das sie draußen erwartet. Ein Leben voll spannender Abenteuer, persönlicher Errungenschaften und erfüllendem Austausch mit Gleichgesinnten. Sie wird bald vergessen, wer sie einst gewesen ist. Vielleicht hat sie einmal über ein Reich geherrscht, von dem jetzt nur noch ein paar Ruinen übrig sind. Vielleicht war sie ein bescheidener Hirte, der über eine Herde Fresssäcke wachte. Die Vergangenheit bedeutet nur wenig, wenn wir unseren Blick in die Zukunft richten: Die Himmlischen Adler wachen darüber, dass jedes Wesen einen neuen Aufbruch wagen kann, ohne Zweifel und Bedauern, bis sich sein Schicksal erfüllt hat.“

– Meister Ganymed');
INSERT INTO "item_descriptions" VALUES(20361,'de','„Von Kindesbeinen an habe ich hart trainiert, um irgendwann gegen Drachen kämpfen zu können. Ich bin ein Ritter, und Ritter vernichten nun mal große Echsen, die Feuer spucken. Das steht immerhin in allen Geschichtsbüchern für Kinder so geschrieben. Also muss es wahr sein! Ihr könnt euch also meine Verwunderung vorstellen, als ich Bolgrot getroffen habe. Wer hätte gedacht, dass ich einmal sein bester Freund werden würde? Ich jedenfalls nicht! Mich hat es von allen am meisten überrascht. Aber man darf sich eben nicht vom Äußeren leiten lassen ... Wir sind seit Wochen unzertrennlich. Ich will ihm unbedingt Helsephine vorstellen! Ich bin sicher, dass sich die beiden gut verstehen werden.“

– Rykke Errel, Iop-Ritter');
INSERT INTO "item_descriptions" VALUES(20362,'de','„Als unsere Truppen sich versammelten, um der Armee der dunklen Stadt die Stirn zu bieten, bin ich für ein letztes Gebet auf den Gipfel des nächsten Hügels gestiegen. Am heutigen Tag werden viele Zwölfianer ihr Ende finden. Ich frage mich: Ist all diese Gewalt wirklich notwendig? Müssen wirklich tausende Seelen geopfert werden, damit die Harmonie erneut Einzug halten kann? Aber jetzt ist keine Zeit für Fragen oder Zweifel. Geist der Balance, erleuchte mich mit deinem Licht. Zeig mir den Weg der Gerechtigkeit, der zum Frieden führt. Und wenn ich dabei auf die Schlächterin von Brâkmar treffe ... gib mir die Kraft, ihr entgegenzutreten, damit in dieser Welt die Hoffnung von Neuem erblühen kann.“

– Jahash Jürgen');
INSERT INTO "item_descriptions" VALUES(20363,'de','„Man sagt, die ersten Förster seien in der Lage gewesen, ohne Unterlass die Weiten von Amakna zu durchstreifen ohne jemals auch nur die geringste Müdigkeit zu verspüren. Ihre Stiefel waren von den vier Wächterinnen verzaubert worden: Mit ihnen konnte man das Land im Handumdrehen durchqueren. Mit einem einzigen Schritt liefen die scharfäugigen Wächter von einer Grenze zur anderen, von den Ufern des Assel-Meers bis zu den felsigen Tälern, in denen es von Bworks und Goblins nur so wimmelte. Allerdings wurde die Macht dieser wundersamen Stiefel schwächer, als sich die Vier zurückzogen ... aber die Aufklärer, die das Glück haben, ein Paar zu besitzen, sind den Feinden des Reichs immer einen Schritt voraus.“

– Cornelia Streicher');
INSERT INTO "item_descriptions" VALUES(20364,'de','„Tretet näher, werte Novizen! Bleibt nicht da hinten stehen, ich werde mich nämlich nicht wiederholen. Zunächst einmal müsst ihr wissen, dass allein die Meister des Ordens die heiligen Stiefel während der offiziellen Schuhputz-Zeremonien tragen dürfen. Da muss man schon ein hohes Tier sein, das werdet ihr verstehen. Wer dieser Regel zuwiderhandelt, wird von all seinen Mitschülern zu Boden getrampelt, bevor er mit einem enormen Tritt in den Hintern nach draußen befördert wird. Haben alle ihre Polierbürste und ihr Gligli-Wachs? Sehr gut! Stellt euch also auf und betretet den Saal, aber leise! Ich will nur ein einziges Paar Absätze klacken hören!“

– Bowisse, Großmeister der Allerwertesten Treter');
INSERT INTO "item_descriptions" VALUES(20365,'de','„Wenn man ein Unglücksrabe ist, erliegt man schnell der Versuchung, gar nichts mehr zu tun, sich zu Hause einzuigeln und nervös an den Krallen zu knabbern, um keine Katastrophe heraufzubeschwören ... Aber wenn das Chaos schon hereinbrechen muss, dann sollte man wenigstens noch seinen Nutzen daraus ziehen! Wer tollkühn ist, läuft weniger Gefahr, vom Pech gelähmt zu werden. Es geht doch nichts über ein bisschen Mumm, um das böse Schicksal zu bannen. Ihr habt euch an einer Sache versucht und den totalen Reinfall erlebt? Und wenn schon! Ihr müsst es nur noch mal versuchen! Es ist immer noch besser, einen Fehlschlag aufgrund von Pech statt mangelnder Dreistigkeit zu erleiden. Es ist nur wichtig, auf allen vier Pfoten zu landen.“

– Dodge der Ecaflip');
INSERT INTO "item_descriptions" VALUES(20366,'de','„Der Weggang eines Meisters ist eine große Tragödie für seine Schüler. Als Prosperus Elementor verschwand, wurden alle Übermagier auf einen Schlag zu Waisen. Wie sollten sie angesichts der Leere, die er hinterlassen hatte, überleben? Wie sollten sie jüngeren Generationen ein würdiges Erbe hinterlassen, wenn gewisse Fragen noch immer unbeantwortet waren? Ich werde mich heute zur grünen Insel Saharach aufmachen, um ein Tor zu öffnen, mit dessen Hilfe ich unseren Anführer wiederfinden kann. Möge das Gleichgewicht mir gewogen sein ... und möge mir der Gott Xélor die nötige Zeit gewähren, um mein Ziel zu erreichen.“

– Madame Jhessica');
INSERT INTO "item_descriptions" VALUES(20391,'de','Manche halten es für barbarisch, andere für eine erhaltenswerte Tradition, die Herzen getöteter Feinde zu essen. Setzt diese Messer ein und macht euch nach Herzenslust euer eigenes Bild.');
INSERT INTO "item_descriptions" VALUES(20463,'de','Die Sandalen der Paztek-Krieger sorgen für eine gute Belüftung ihrer Füße und ermöglichen ihnen, durch das Blut ihrer getöteten Feinde zu waten, ohne dabei jämmerlich auszurutschen.');
INSERT INTO "item_descriptions" VALUES(20464,'de','Das Gebimmel der am Rand dieses Umhangs befestigten Goldstückchen begleitet die Tanzmusik bei Paztek-Ritualen, insbesondere bei Menschenopfern. Man könnte auch sagen, dieser Umhang verharmlost Mordtaten.');
INSERT INTO "item_descriptions" VALUES(20465,'de','Masken wie diese sind in der Kultur der Pazteken von großer Bedeutung. Sie schützen das Gesicht, erschrecken Feinde und böse Geister und helfen dabei, die Rolle eines Pazteken in seinem Stamm zu identifizieren, also zum Beispiel Krieger, Priester, Händler oder Arbeiter. Aber natürlich könnt ihr auch euren Freunden und Familienangehörigen die eine oder andere Maske als exotisches Souvenir mitbringen, das sich wunderbar an die Wand hängen lässt.');
INSERT INTO "item_descriptions" VALUES(20833,'de','Wenn ihr dieses wuchtige Kakaoei tragt, scheinen sich die Sorgen eures Abenteurer-Daseins in Luft aufzulösen. Das sind die Wirkungen der Schokolade, die ihr spürt: Sie spendet euch Trost, macht euch aber gleichzeitig schwerer.');
INSERT INTO "item_descriptions" VALUES(20848,'de','Mit diesem Zepter kann der Hunger desjenigen, der es benutzt, im Zaum gehalten werden. Wenn ihr es vor den Wabhängigen schwenkt, werden sie euch wahrscheinlich gehorchen.');
INSERT INTO "item_descriptions" VALUES(20850,'de','Diese Stiefel sind so lange in Schokolade getaucht worden, dass ihre Sohlen nun völlig mit Schokolade durchtränkt sind. Wohin ihr geht, hinterlasst ihr also Spuren. Nicht sehr unauffällig ...');
INSERT INTO "item_descriptions" VALUES(20851,'de','Wer sich nach einem Iop-Körper sehnt, wird an diesem Gürtel seine helle Freude haben, denn dieser lässt Schokoladenexzesse im Nu verschwinden.');
INSERT INTO "item_descriptions" VALUES(20852,'de','Ein mit Fell bedeckter Ring, der den Finger wärmt, auf den er gesteckt wird.');
INSERT INTO "item_descriptions" VALUES(20924,'de','In diesem Amulett ist ein Geheimfach verborgen, in dem ein Schokoladennugget mit enorm hohem Kakaoanteil versteckt ist. Mit diesem Nugget können Schokomanten bei einer Auseinandersetzung ihre Kraft erhöhen, aber da ihr keine Schokomantie praktiziert, kann es euch im Notfall auch als Snack dienen. Aber Vorsicht, es ist ziemlich bitter.');
INSERT INTO "item_descriptions" VALUES(20925,'de','Da Schokomanten für ihre Tätigkeit Unmengen an Schokolade verzehren müssen, können sie keinen klassischen Gürtel tragen. Der würde ihren Magen viel zu sehr einengen. Damit sie sich mit Schokolade vollstopfen können, aber nie ihre Hose verlieren, haben sie diesen speziellen, besonders dehnbaren Gürtel entwickelt.');
INSERT INTO "item_descriptions" VALUES(20926,'de','An der Wirksamkeit eines essbaren Schildes ließe sich mit Recht zweifeln, und doch hat sich dieser hier als sehr widerstandsfähig erwiesen. Wartet aber trotzdem das Ende des besagten Kampfes ab, bevor ihr euren Schild verspeist. Sonst könnte es sein, dass ihr ihn niemals werdet kosten können.');
INSERT INTO "item_descriptions" VALUES(20935,'de','Dieser riesige Spachtel ist ein Werkzeug für anspruchsvolle Arbeiten. Mit ihm kann man nicht nur riesige und äußerst leckere Schokoladenkuchen kreieren, sondern auch all jene gierigen Individuen niedermähen, die sie ohne eure Erlaubnis kosten wollen.');
INSERT INTO "item_descriptions" VALUES(20956,'de','Ausstaffiert mit dieser Maske könnt ihr jetzt versuchen, einen Kult zu unterwandern, der sich auf den übermäßigen Genuss von Schokolade gründet. Aber passt auf, dass man euch nicht demaskiert! Sonst werdet ihr noch von euren eigenen Getreuen zermalmt wie eine gewöhnliche Kakaobohne.');
INSERT INTO "item_descriptions" VALUES(20981,'de','Der Erfinder dieses Objekts war nicht gerade eine Leuchte: Damit man nicht völlig im Dunkeln (der Schokolade) tappt, muss man eine Seite des Helms aufessen.');
INSERT INTO "item_descriptions" VALUES(20982,'de','Diese Stiefel, die von den Brüdern Ahess und Emerh hergestellt wurden, erzeugen bei jedem Schritt ein herrlich schokoladiges Knackgeräusch.');
INSERT INTO "item_descriptions" VALUES(20983,'de','Dieser kleine Sack wird euch in eure Kindheit zurückversetzen: Ihr werdet an die magischen Momente zurückdenken, als euch eure Mama ein leckeres Pausenbrot zubereitete, als ihr auf dem Weg in die Schule wart – bereit, das Leben in vollen Bissen zu genießen –, als euch euer heißgeliebtes Pausenbrot von größeren und stärkeren Kindern gestohlen wurde ... Welch schöne Erinnerungen.');
INSERT INTO "item_descriptions" VALUES(20987,'de','Ihr schließt die Augen und plötzlich wird eure Nase von den schokoladigen Aromen des göttlichen Eis erfüllt. Berauscht von der Versuchung eines unbekannten kulinarischen Genusses führt ihr den mystischen Gegenstand an eure arglosen Lippen heran. Als eure Geschmacksknospen von einer Welle der Bitterkeit überschwemmt werden, erfahrt ihr am eigenen Leib, dass nicht alle göttlichen Essenzen lecker schmecken.');
INSERT INTO "item_descriptions" VALUES(21009,'de','Dank der Luft in dieser Flasche könnt ihr endlich in Ruhe atmen.');
INSERT INTO "item_descriptions" VALUES(21010,'de','Wenn ihr diesen Taucheranzug mit einer Chronoxygeniumflasche kombiniert, könnt ihr durch die Zeit reisen, ohne Überstunden machen zu müssen.');
INSERT INTO "item_descriptions" VALUES(21186,'de','Dieser Dofus stammt von einem Drachen, der lieber anonym bleiben möchte. Die Klügsten unter den Abenteurern fragen sich noch immer, warum.');
INSERT INTO "item_descriptions" VALUES(21223,'de','Mit diesem Ring werdet ihr zwar stärker, riskiert allerdings auch, euren Finger zu verlieren.');
INSERT INTO "item_descriptions" VALUES(21224,'de','Dieser Gürtel wurde von einem angehenden Stylisten entworfen. Frustriert von seinem Mangel an Inspiration warf er Schuppen und Crocodyll-Reißzähne auf den Boden, wobei dieses außergewöhnliche Gebilde entstand. Er war von diesem Ergebnis derart begeistert, dass er ab diesem Zeitpunkt alle neuen Kreationen auf dieselbe Art und Weise entwarf.');
INSERT INTO "item_descriptions" VALUES(21225,'de','Crocodyll-Schuppen sind genauso hart wie der Schädel eines Iops. Dieser Schild ist ein unerlässliches Accessoire für jeden Abenteurer, der sich gern ohne weiter darüber nachzudenken in den Nahkampf stürzt.');
INSERT INTO "item_descriptions" VALUES(21226,'de','Die Kreation dieser Stiefel war zwar nur ein kleiner Schritt für den Schuhmacher, der sie entwarf, aber ein großer für alle Zwölfianer, die sie tragen werden.');
INSERT INTO "item_descriptions" VALUES(21227,'de','Wenn man diese Halskette in Vollmondnächten trägt, wird man angeblich in einen WuWulf verwandelt.');
INSERT INTO "item_descriptions" VALUES(21228,'de','Pech für alle, die ihre Ringe gern auf dem Daumen tragen: Dieser Ring passt nur auf dem Ringfinger. Allerdings habt ihr noch immer die Wahl zwischen rechter und linker Hand.');
INSERT INTO "item_descriptions" VALUES(21229,'de','Da die Crocuzkianer oft von Torkélonia, der arkelonischen Schildkröte, herumkommandiert wurden, haben sie beschlossen, exakte Repliken dieser Waffe herzustellen, damit die Dummköpfe, die sich in Zukunft auf die Insel wagen würden, ihnen auch genug Respekt entgegenbringen. Das klappt zwar nicht immer, aber es ist der Gedanke, der zählt.');
INSERT INTO "item_descriptions" VALUES(21230,'de','Ihr solltet es vermeiden, auf den Rücken zu fallen, solange ihr diesen Panzer tragt. Es könnte sein, dass ihr nicht mehr aufstehen könnt.');
INSERT INTO "item_descriptions" VALUES(21235,'de','Manche behaupten, dass man das Alter einer arkelonischen Schildkröte an der Größe ihres Horns ablesen könne. Wenn ihr euch hiermit ausstattet, wird man euch euer Alter nicht mehr ansehen können.');
INSERT INTO "item_descriptions" VALUES(21451,'de','Dieser Prysmaradit schützt euch vor dem ersten Pfeil eines Iops, der kürzlich zum Crâ zurückkonvertiert ist.');
INSERT INTO "item_descriptions" VALUES(21452,'de','Dieser Prysmaradit schützt euch vor dem ersten Pfeil eines Iops, der kürzlich zum Crâ zurückkonvertiert ist.');
INSERT INTO "item_descriptions" VALUES(21453,'de','Dieser Prysmaradit schützt euch vor dem ersten Pfeil eines Iops, der kürzlich zum Crâ zurückkonvertiert ist.');
INSERT INTO "item_descriptions" VALUES(21506,'de','Ein süßes Tierchen in einer Kugel einzusperren und auf euren Gegner loszulassen? Das könnte der absolute Renner werden. Zu euren Lasten.');
INSERT INTO "item_descriptions" VALUES(21507,'de','Ein süßes Tierchen in einer Kugel einzusperren und auf euren Gegner loszulassen? Das könnte der absolute Renner werden. Zu euren Lasten.');
INSERT INTO "item_descriptions" VALUES(21508,'de','Ein süßes Tierchen in einer Kugel einzusperren und auf euren Gegner loszulassen? Das könnte der absolute Renner werden. Zu euren Lasten.');
INSERT INTO "item_descriptions" VALUES(21509,'de','Ein süßes Tierchen in einer Kugel einzusperren und auf euren Gegner loszulassen? Das könnte der absolute Renner werden. Zu euren Lasten.');
INSERT INTO "item_descriptions" VALUES(21510,'de','Ein süßes Tierchen in einer Kugel einzusperren und auf euren Gegner loszulassen? Das könnte der absolute Renner werden. Zu euren Lasten.');
INSERT INTO "item_descriptions" VALUES(21711,'de','Mit diesen Flügeln könnt ihr euch nicht in die Luft schwingen: Sie wurden nur angefertigt, um die Reise von Bimm, Bamm und Bumm zu verhindern.');
INSERT INTO "item_descriptions" VALUES(21712,'de','Dieser Helm wurde nur zu einem einzigen Zweck angefertigt: zu verhindern, dass Goblins sich auf die Moon-Insel begeben können. Versucht erst gar nicht, einen anderen Verwendungszweck zu finden: Ihr würdet nur enttäuscht werden.');
INSERT INTO "item_descriptions" VALUES(21878,'de','Wie soll ein so zerbrechlich wirkendes Ding vier Monster fangen können, die bösartiger sind als ein Totengräber? Es gibt nur einen Weg, um das herauszufinden ... Denkt unbedingt daran, den Alptraumfänger mitzunehmen, wenn ihr einen Horlamahr herausfordert, sonst werdet ihr es bitter bereuen.');
INSERT INTO "item_descriptions" VALUES(21996,'de','Dieser Prysmaradit wird euch gehörig unter Druck setzen. Lasst euch nicht unterkriegen!');
INSERT INTO "item_descriptions" VALUES(21997,'de','Dieser Prysmaradit wird euch gehörig unter Druck setzen. Lasst euch nicht unterkriegen!');
INSERT INTO "item_descriptions" VALUES(21998,'de','Dieser Prysmaradit wird euch gehörig unter Druck setzen. Lasst euch nicht unterkriegen!');
INSERT INTO "item_descriptions" VALUES(21999,'de','Dieser Prysmaradit macht euch zum Glückspilz! Das trifft sich gut, denn nach eurem letzten Abenteuer in Saharach könnt ihr Glück echt gut gebrauchen.');
INSERT INTO "item_descriptions" VALUES(22000,'de','Dieser Prysmaradit macht euch zum Glückspilz! Das trifft sich gut, denn nach eurem letzten Abenteuer in Saharach könnt ihr Glück echt gut gebrauchen.');
INSERT INTO "item_descriptions" VALUES(22001,'de','Dieser Prysmaradit macht euch zum Glückspilz! Das trifft sich gut, denn nach eurem letzten Abenteuer in Saharach könnt ihr Glück echt gut gebrauchen.');
INSERT INTO "item_descriptions" VALUES(22002,'de','Dieser Prysmaradit ist perfekt für langsame, nachtragende Abenteurer. Also quasi für Leute wie euch.');
INSERT INTO "item_descriptions" VALUES(22003,'de','Dieser Prysmaradit ist perfekt für langsame, nachtragende Abenteurer. Also quasi für Leute wie euch.');
INSERT INTO "item_descriptions" VALUES(22004,'de','Dieser Prysmaradit ist perfekt für langsame, nachtragende Abenteurer. Also quasi für Leute wie euch.');
INSERT INTO "item_descriptions" VALUES(22005,'de','Mit diesem Prysmaradit bleibt ihr Abenteurern und Abenteurerinnen auf den Fersen, die sich aus dem Staub machen wollen. Ihr habt eure Lektion gelernt und kennt das Geheimnis aller schwerfälligen Helden: Durchhaltevermögen.');
INSERT INTO "item_descriptions" VALUES(22006,'de','Mit diesem Prysmaradit bleibt ihr Abenteurern und Abenteurerinnen auf den Fersen, die sich aus dem Staub machen wollen. Ihr habt eure Lektion gelernt und kennt das Geheimnis aller schwerfälligen Helden: Durchhaltevermögen.');
INSERT INTO "item_descriptions" VALUES(22007,'de','Mit diesem Prysmaradit bleibt ihr Abenteurern und Abenteurerinnen auf den Fersen, die sich aus dem Staub machen wollen. Ihr habt eure Lektion gelernt und kennt das Geheimnis aller schwerfälligen Helden: Durchhaltevermögen.');
INSERT INTO "item_descriptions" VALUES(22008,'de','Dieser Prysmaradit ist fast wie ein Jungbrunnen, nur ohne Wasser ... und ohne Brunnen. Verjüngen tut er auch nicht wirklich. Der Vergleich hinkt wohl ein wenig.');
INSERT INTO "item_descriptions" VALUES(22009,'de','Dieser Prysmaradit ist fast wie ein Jungbrunnen, nur ohne Wasser ... und ohne Brunnen. Verjüngen tut er auch nicht wirklich. Der Vergleich hinkt wohl ein wenig.');
INSERT INTO "item_descriptions" VALUES(22010,'de','Dieser Prysmaradit ist fast wie ein Jungbrunnen, nur ohne Wasser ... und ohne Brunnen. Verjüngen tut er auch nicht wirklich. Der Vergleich hinkt wohl ein wenig.');
INSERT INTO "item_descriptions" VALUES(22011,'de','Dieser Prysmaradit vermittelt das Gefühl, ständig zu spät zu sein. Er entschuldigt eure Tendenz, auch wirklich zu spät zu kommen, allerdings nicht.');
INSERT INTO "item_descriptions" VALUES(22012,'de','Dieser Prysmaradit vermittelt das Gefühl, ständig zu spät zu sein. Er entschuldigt eure Tendenz, auch wirklich zu spät zu kommen, allerdings nicht.');
INSERT INTO "item_descriptions" VALUES(22013,'de','Dieser Prysmaradit vermittelt das Gefühl, ständig zu spät zu sein. Er entschuldigt eure Tendenz, auch wirklich zu spät zu kommen, allerdings nicht.');
INSERT INTO "item_descriptions" VALUES(22014,'de','Dieser Prysmaradit schärft den Geist seines Trägers, ohne ihm jedoch Anstand beizubringen. Glück gehabt.');
INSERT INTO "item_descriptions" VALUES(22015,'de','Dieser Prysmaradit lässt euren Körper die Herausforderungen des harten Abenteurerlebens überstehen.

Das ist ein Kieselstein, bitte nicht verschlucken. Wir testen unsere Produkte nicht an Ecaflips oder Ouginaks. Ohne Alkohol. Ohne Palmblumenöl.');
INSERT INTO "item_descriptions" VALUES(22016,'de','Dieser Prysmaradit verleiht euch die Dreistigkeit der heutigen Jugend, ohne dass ihr dafür den dekadenten Komfort eurer privilegierten Stellung aufgeben müsst.');
INSERT INTO "item_descriptions" VALUES(22017,'de','Dieser Prysmaradit verleiht euch die Dreistigkeit der heutigen Jugend, ohne dass ihr dafür den dekadenten Komfort eurer privilegierten Stellung aufgeben müsst.');
INSERT INTO "item_descriptions" VALUES(22018,'de','Dieser Prysmaradit verleiht euch die Dreistigkeit der heutigen Jugend, ohne dass ihr dafür den dekadenten Komfort eurer privilegierten Stellung aufgeben müsst.');
INSERT INTO "item_descriptions" VALUES(22019,'de','Dieser Prysmaradit lässt euch vorübergehend verschwinden und so die verrücktesten Erfahrungen machen. Stellt euch nur das enttäuschte Gesicht eurer Schwiegermutter vor, wenn ihr wiederauftaucht.');
INSERT INTO "item_descriptions" VALUES(22020,'de','Dieser entzaubernde Prysmaradit eignet sich perfekt, um nach einem feuchtfröhlichen Abend im Kolosseum zu trainieren. Euer Schweinepriesteratem wird euch im Nahkampf sogar von Nutzen sein.');
INSERT INTO "item_descriptions" VALUES(22022,'de','Dieser Prysmaradit eignet sich perfekt für Weinberg- und Nacktschnecken. Und dabei handelt es sich nicht nur um eine Metapher.');
INSERT INTO "item_descriptions" VALUES(22023,'de','Dieser Prysmaradit schützt Einzelgänger gegen zu große Menschenmassen.');
INSERT INTO "item_descriptions" VALUES(22024,'de','Dieser Prysmaradit wird den Abenteurern gefallen, die unter einem geringen Initiativewert leiden.');
INSERT INTO "item_descriptions" VALUES(22025,'de','Dieser Prysmaradit ist ganz schön schwer. Wirklich unglaublich für einen so kleinen Gegenstand. Er erinnert euch an jemanden.');
INSERT INTO "item_descriptions" VALUES(22027,'de','Diese Waffe wurde durch den Odem eines Drachens so verstärkt, dass sie jedes beliebige Metall biegen kann. Ihr einziger Nachteil ist, dass es sich um eine Einwegwaffe handelt. Ihr solltet sie also nur einsetzen, wenn alle Stricke reißen.');
INSERT INTO "item_descriptions" VALUES(22163,'de','Eine rudimentäre Spitzhacke, die so gut wie alles kaputt bekommt. Außer vielleicht die Stimme von Oh''Nein.');
INSERT INTO "item_descriptions" VALUES(22186,'de','Arglistig, berechnend und manipulierend: Elend ist euch immer ein, zwei oder sogar drei Schritte voraus, um zu bekommen, was sie will. Lügen liegt ihr im Blut, und ihre Intelligenz ist so ausgeprägt wie ihre Habgier.');
INSERT INTO "item_descriptions" VALUES(22187,'de','„Sie ist die Reichste auf der Welt
Denn sie ist gierig und will das Geld
Sie lebe hoch, sie ist die STEUER
Sie ist die Beste, die es gibt

Hat deshalb Stress mit jedem Typ
Sie lebe hoch, sie ist die STEUER
Sie ist die Strengste, meinen die Leute
Und wenn sie loslegt, schreit die Meute
Seit sie im Game ist, ist alles anders
Nicht, dass sie Fame ist, ich meine den Standard“


– Lied von Ecki Frech, Elends Lieblingsbarde. Es soll die Eintreiber dazu motivieren, mehr Steuern einzutreiben und die Gehälter zu kürzen.');
INSERT INTO "item_descriptions" VALUES(22188,'de','Damit die Elenden glauben, dass auch sie in einer prekären Lage ist, und weil sie die unzähligen, angehäuften Ressourcen auf keinen Fall ausgeben möchte, isst Elend nur sehr wenig. Das erklärt auch ihre skeletthafte Erscheinung.');
INSERT INTO "item_descriptions" VALUES(22189,'de','Um die Blutschmiede zu versorgen, trampeln Kriegs Soldaten mit den Füßen auf den Leichen herum. So pressen sie – wie tüchtige Weinbauern – das notwendige Blut aus den Kadavern heraus. In dieser Disziplin sind sie ungeschlagen und Krieg findet dafür auch die passenden Worte: „Ekelka. Wir zertrampeln Lebewesen.“');
INSERT INTO "item_descriptions" VALUES(22190,'de','„Krieg ist Politik mit Blutvergießen. Blut fordert Blut!“ 

– Krieg');
INSERT INTO "item_descriptions" VALUES(22191,'de','Den Gerüchten der Blutrünstigen zufolge ist Kriegs Schild ein Abbild ihrer wahren Gestalt. Überraschenderweise hat sich allerdings noch niemand getraut, sie danach zu fragen.');
INSERT INTO "item_descriptions" VALUES(22192,'de','Jeder verschafft sich auf seine Weise Respekt. Krieg verfolgt die folgende Strategie: eiserne Faust im eisernen Handschuh. Für euch gilt: seidene Hand im eisernen Handschuh.');
INSERT INTO "item_descriptions" VALUES(22200,'de','Weil er immer einen Schal trägt, hat noch nie jemand Knechtschafts Gesicht in Gänze gesehen. Vielleicht hat er Angst, sich zu erkälten. Vielleicht gleicht sein Kinn aber auch einem Hinterteil, was seiner Autorität schaden könnte.');
INSERT INTO "item_descriptions" VALUES(22201,'de','Wenn man zu viele Sklaven hat, weiß man schnell nicht mehr, wohin mit ihnen. Damit sie beschäftigt sind, hat Knechtschaft nicht weniger als 100 Gefangene mit der Pflege seines wertvollen Umhangs beauftragt. Jeder Fleck und jede Schramme zieht natürlich die Todesstrafe nach sich. Daher befindet er sich stets in tadellosem Zustand.');
INSERT INTO "item_descriptions" VALUES(22202,'de','„Du, der von großen Räumen träumte und doch nichts als Fenster hatte, wünschst du, wieder aufzuleben und diese Sklaven hinter dir zu lassen? Sicher wünschst du das. Träume kann einem ja niemand nehmen! Oder doch, muahahahaha!“

– Knechtschaft, wie er sich über einen seiner Sklaven lustig macht');
INSERT INTO "item_descriptions" VALUES(22205,'de','Diesen Ring haben verdorbene Sadidas als Zeichen ihrer Treue und Hingabe für Verderbnis geschmiedet. Eine spezielle Legierung, die sie selbst geschaffen haben, lässt den Ring auch dann nicht rosten, wenn er mit der ätzenden Haut des Reiters in Berührung kommt.');
INSERT INTO "item_descriptions" VALUES(22206,'de','Auch wenn ihr das für eine gute Idee haltet, solltet ihr diesen Trauring auf keinen Fall eurem Herzblatt schenken. Verderbnis hat ihn eigenhändig aus dem Baum des Todes gefertigt. Was vergiftete Geschenke angeht, gibt es nichts Besseres.');
INSERT INTO "item_descriptions" VALUES(22209,'de','Wie heißt doch ein obskures Sprichwort? „Stille Verderbnis ist tief und im Halbschlaf soll man nicht mit Kanonen auf Rablinge schießen“. Niemand hat je verstanden, was damit gemeint ist, aber immer schön vorsichtig mit Kanonen und Rablingen sein.');
INSERT INTO "item_descriptions" VALUES(22213,'de','Mit diesem Spaten lässt sich hervorragend euer erster verdorbener Gemüsegarten anlegen. Schluss mit klassischen Früchten oder langweiligem Gemüse, hier wachsen exotische Produkte wie Moderkürbisse und Giftpilze. Da ist für jeden Geschmack etwas dabei!');
INSERT INTO "item_descriptions" VALUES(22214,'de','Wenn ihr es zu eng tragt, lässt euch dieses Halsband sabbern.');
INSERT INTO "item_descriptions" VALUES(22215,'de','Wenn es euch an eigenen Flügeln mangelt, könnt ihr euch jederzeit mit diesen hier verkleiden und damit auf eigenen Flügeln stehen.');
INSERT INTO "item_descriptions" VALUES(22368,'de','„Als sich der Prinz von Brâkmar und der König von Bonta gegenseitig pfählten und ihre Eingeweide auf der roten Erde verteilten, empfand ich große Genugtuung. Somit endete der Krieg zwischen den beiden Städten mitten in einem Riesenberg von Leichen! Welch wunderschöner Anblick. Während die Schreie der Rablinge sich mit dem Röcheln der Sterbenden vermengten, wurde ich von Nostalgie überwältigt. Schmerzliche Erinnerungen an die erste Morgenröte stiegen in mir hoch. Der Ansturm der Raubritter von Kleppripp, das Köpfen von Menalt, der inszenierte Paukenschlag von Raval ... Dies war der Beginn eines blutigen und amüsanten Konflikts, der mich fast Tausend Jahre lang in Atem gehalten hatte! Nun ist der Vorhang gefallen. Aber das Schauspiel muss weitergehen ... Es wird immer wieder Kämpfe geben.“

– Krieg');
INSERT INTO "item_descriptions" VALUES(22412,'de','„Welch angenehmer Duft von Verzweiflung, der hier in der Luft liegt ... Einst so stolze, so mutige, so ... arrogante Söldner. Seht euch doch mal an, mit euren tränenüberfluteten Gesichtern, beim Anblick eurer geliebten Menschen im Massengrab. Diese Bindungen, diese Versprechen, diese Gefühle ... Alles in Luft aufgelöst wegen dem Wahnsinn, der sich unter eure Haut frisst. Gibt es etwas Schöneres als das Entsetzen und die Abscheu auf den Gesichtern eurer Mitmenschen bei den ersten Anzeichen eurer eigenen Pestilenz? Zittere Astrub ... flehe zu deinen Göttern, diesen Hochstaplern, die nichts für dich tun können ... Diese Fäulnis, vor der ihr euch so fürchtet ... fällt nicht vom Himmel ... sondern steckt in jedem von uns.“

– Verderbnis');
INSERT INTO "item_descriptions" VALUES(22429,'de','„Seht euch doch mal an, stolze Kanigs, wie ihr durch eure Gegner geknechtet seid ... Welch ein Niedergang! Ihr hättet ein richtiges Imperium aufbauen können, wenn ihr nicht so schwach gewesen wärt. Es gab eine Zeit, da hattet ihr noch von Ruhm und Eroberung geträumt, da arbeiteten die Häftlinge in eure Steinbrüchen und stöhnten unter euren Peitschenhieben ... Aber vom Meister zum Sklaven ist es manchmal nur ein kleiner Schritt. Katzbuckeln unter dem Gewicht der Ketten, wie Larven durch den Schlamm waten, ihr habt schon vergessen, wer ihr wirklich wart. Ihr seid pathetisch. Wenn euer Matriarch stirbt, ist euer Schicksal vollendet. Euer Opfer wird weniger unnütz als eure Existenz gewesen sein ... denn es wird die Geschichte verändern.“

– Knechtschaft');
INSERT INTO "item_descriptions" VALUES(22444,'de','„Hört ihr auch die vom Wind verwehten Klagelaute, das Brummen der Troolglodyts und das Knurren der hungrigen Mägen? Dies ist sanfte Musik in meinen Ohren ... Die Wüste breitet sich weiter aus. Sie nimmt immer mehr Dünen ein. Die Weizenkörner werden zu Sandkörnern. Die Brunnen versiegen. Die Teller leeren sich. Die Kakteen trocknen aus. Bald wird fruchtbarer Boden nur noch ein Märchen sein, das die zarten Kinder am Abend beim Zubettgehen mit unnötigen Hoffnungen erfüllt. Bald werde ich uneingeschränkter Herrscher der Saharach sein ...Dieses Land wird endlich mir gehören.“

– Elend');
INSERT INTO "item_descriptions" VALUES(23094,'de','Dieser traditionelle Schild ist erforderlich, um den Versammlungssaal des Pandarats zu betreten, wo die Würdenträger anzutreffen sind, die über die Insel Pandala herrschen. Passt also auf, dass ihr ihn nicht beschädigt. Sonst müsst ihr euch einen neuen anfertigen.');
INSERT INTO "item_descriptions" VALUES(23237,'de','So wie der Mond von dunklen Nachtwolken verborgen wird, findet sich auch manchmal das lebhafteste Licht umgeben von tiefster Dunkelheit.');
INSERT INTO "item_descriptions" VALUES(23248,'de','Dieses Stirnband symbolisiert den ersten Schritt auf dem Weg zum Pandawushuka. Geduld und Selbstbeherrschung sind erforderlich, um die langen Lehrjahre zu überstehen, die euch erwarten.');
INSERT INTO "item_descriptions" VALUES(23253,'de','Es kursieren zwar die verschiedensten Gerüchte, aber wenn man auf den Rücken eines Kwappas springt, hat man ihn noch lange nicht besiegt.');
INSERT INTO "item_descriptions" VALUES(23254,'de','Wenn ihr diese Stiefel tragt, solltet ihr besser nicht zu lange an einer Stelle stehen. Sonst könntet ihr Wurzeln schlagen.');
INSERT INTO "item_descriptions" VALUES(23255,'de','Diese Kopfbedeckung hat verschiedene Einsatzmöglichkeiten. Man kann sie natürlich als Kopfbedeckung nutzen, allerdings dient sie auch als Eimer, Nachttopf oder Spucknapf.');
INSERT INTO "item_descriptions" VALUES(23256,'de','Wenn ihr dieses Amulett schluckt, gibt es in eurem Magen ein kleines Samenkorn frei. Wenn ihr regelmäßig bei schönem Wetter den Mund öffnet und genügend Wasser trinkt, wächst vielleicht ein hübsches Gebüsch in eurem Innern.');
INSERT INTO "item_descriptions" VALUES(23257,'de','Die Betto nutzen normalerweise Gurken als Griffe für ihre Äxte. Wie man hier sieht, bestätigen Ausnahmen die Regel. Man muss schon sagen, dass ein Stiel aus Holz und Metall sich für eine Waffe sehr viel besser eignet als eine Gurke.');
INSERT INTO "item_descriptions" VALUES(23258,'de','Dank diesem Schild, werdet ihr eure Schlachten mühelos schlagen.');
INSERT INTO "item_descriptions" VALUES(23259,'de','Der Herrin über die Gewässer wird oft nachgesagt, dass sie Kinder entführt, um sie zu verschlingen oder sie zu ertränken. Dabei will sie sie nur adoptieren. Sie verwandelt sie in Kwappas, um ihnen die Sache mit dem Ertrinken zu ersparen.');
INSERT INTO "item_descriptions" VALUES(23260,'de','Wenn ihr schon immer davon geträumt habt, viele Kinder zu haben, bewaffnet euch mit diesem Umhang und schreitet mit wiegenden Hüften über die Felder. Wenn ihr im Frühling zurückkehrt, werden eure Babys geschlüpft sein.');
INSERT INTO "item_descriptions" VALUES(23261,'de','Sehr nützlich, um Schalenfrüchte aufzubrechen. Vor allem sind diese Handschuhe aber eine hervorragende Waffe gegen Gegner männlichen Geschlechts.');
INSERT INTO "item_descriptions" VALUES(23262,'de','Die Ino-Naru verwenden diese Mischung aus Nunchaku und Bumerang für all ihre Aktivitäten, zum Beispiel für die Jagd, das Angeln und natürlich zu traditionellen Zwecken.');
INSERT INTO "item_descriptions" VALUES(23263,'de','Ein Hut für jede Gelegenheit. Auch als Stauraum verwendbar.');
INSERT INTO "item_descriptions" VALUES(23264,'de','Dieser Umhang schützt euch bestens vor stürmischen Winden, verhindert allerdings nicht, dass ihr von Leuten ignoriert werdet, die ihr ansprechen wollt.');
INSERT INTO "item_descriptions" VALUES(23265,'de','Bei einem solchen Gürtel fällt es schwer, nicht daran zu denken, was sich dahinter verbirgt. Und von dem, was hinter jenem von anderen verbirgt, haben wir dabei noch gar nicht gesprochen.');
INSERT INTO "item_descriptions" VALUES(23266,'de','Wenn ihr Perlen dieser Kette verliert, könnt ihr damit einen Sturm entfesseln. Vermeidet es also lieber!');
INSERT INTO "item_descriptions" VALUES(23267,'de','Das Geheimnis dieses Baguettes? Es wurde mit Expertenwissen und viel Liebe zubereitet. Fragt den Handwerker eures Vertrauens danach!');
INSERT INTO "item_descriptions" VALUES(23268,'de','Dank dieses Steckens, der sich ausfahren lässt, konnte Hanshi viele Heldentaten vollbringen. Ja, es stimmt, seine Größe ist wirklich beeindruckend! Schämt euch bitte nicht, wenn der eure sehr viel kleiner ist: Ihr könnt damit sicher auch große Taten vollbringen.');
INSERT INTO "item_descriptions" VALUES(23269,'de','Der Künstler, der diesen Trauring kreiert hat, wollte ganz augenscheinlich die Art und Weise, wie man Schmuck trägt, revolutionieren. Wie man sehen kann, wird dieses hübsche Ding nicht um den Finger, sondern vielmehr zwischen zwei Fingern getragen. Zum Befestigen wurde eine Fellsträhne eingearbeitet.');
INSERT INTO "item_descriptions" VALUES(23270,'de','Vermeidet es, euch mit diesen Fächern Luft zufächeln zu wollen, wenn ihr nicht euer Leben oder euer Augenlicht verlieren wollt.');
INSERT INTO "item_descriptions" VALUES(23271,'de','Endlich ein Sprengstoffgürtel, der bei allen Beteiligten für Begeisterung sorgt!');
INSERT INTO "item_descriptions" VALUES(23272,'de','Diese Feuerfux-Kanone ist wie geschaffen, um Feuerwerkskörper sehr hoch und sehr weit zu schießen. Leider ist es mittlerweile verboten, sie durch nicht besonders groß gewachsene Kreaturen zu ersetzen.');
INSERT INTO "item_descriptions" VALUES(23273,'de','Dieser handgefertigte Jutesack ist ideal, um eine explosive Partie Boule mit Freunden zu spielen, denn er enthält ein hochwertiges Set Feuerfux-Kugeln. Wund- und Brandgel nicht enthalten.');
INSERT INTO "item_descriptions" VALUES(23312,'de','Von diesem Katana geht eine heftige Hitze aus, die euch aber keineswegs verbrennt. Mit diesem Katana scheint es viel einfacher zu sein, die Schwachpunkte eurer Gegner zu erkennen.');
INSERT INTO "item_descriptions" VALUES(23313,'de','Dieses Katana ist unglaublich leicht. Es lässt sich mühelos durch die Luft schwingen und wirkungsvolle Ausweichmanöver sind damit ein Kinderspiel. Wenn ihr diese Waffe niedersausen lasst, scheint sie von einem Windstoß davongetragen zu werden.');
INSERT INTO "item_descriptions" VALUES(23314,'de','Dieses Katana ist äußerst handlich, sodass euch flüssige und unberechenbare Bewegungen spielend leicht von der Hand gehen. Wenn ihr es in der Hand haltet, durchdringt euch ein Gefühl der Ruhe und Gelassenheit.');
INSERT INTO "item_descriptions" VALUES(23315,'de','Dieses Katana ist zwar extrem schwer für seine Größe, dafür aber von beispielloser Belastbarkeit. Neulinge werden ihre Schwierigkeiten mit dieser Waffe haben, die vor allem in Säbelduellen gefürchtet ist.');
INSERT INTO "item_descriptions" VALUES(23316,'de','Dieses Katana verströmt einen leichten Moosgeruch. Seine Klinge ist erstaunlich biegsam für eine Waffe dieser Art. Gewicht und Robustheit wurden gut ausbalanciert und ihr scheint ein Blätterrascheln zu vernehmen, wenn ihr es durch die Luft gleiten lasst.');
INSERT INTO "item_descriptions" VALUES(23408,'de','Man sagt, dass jede der tausend Falten des Dorigamis ein Rätsel birgt, den Widerschein einer Lüge oder einer schmerzhaften, blendend reinen Wahrheit, wie die Facetten eines Papierdiamanten.');
INSERT INTO "item_descriptions" VALUES(23501,'de','Dieser Schild ist viel zu schwer für einen Trainingsschutz. Euer Körper ist damit viel zu behäbig und eure Bewegungsfreiheit ziemlich eingeschränkt. Hat keiner behauptet, dass die Ausbildung zum Pandawushuka eine Kaffeefahrt ist.');
INSERT INTO "item_descriptions" VALUES(23522,'de','Dieser Stecken wurde von euch aus einem Ast des letzten spirituellen Bambus des Waldes angefertigt. Es war alles andere als einfach, Shinotake zu überzeugen, aber er hat sich letztlich bereiterklärt, euch einen Ast zu überlassen. Daraus werdet ihr euch einen hübschen Stecken für eure zukünftigen Trainingseinheiten anfertigen.');
INSERT INTO "item_descriptions" VALUES(23563,'de','Um euch dieses Ringes zu entledigen, tragt ihn einen Tag lang und kehrt dann dorthin zurück, wo ihr den Aufopferungsvollen Geist getroffen habt.');
INSERT INTO "item_descriptions" VALUES(23578,'de','Kein Material ist für dieses Werkzeug zu hart.');
INSERT INTO "item_descriptions" VALUES(23590,'de','Dieses Katana ist ein echtes Kunstwerk und sieht aus wie von einem Goldschmied gefertigt. Trotz der ungewöhnlichen Länge seiner Klinge ist es perfekt ausbalanciert. Um es schwingen zu können, braucht man eine außerordentliche Körperkraft, aber dafür schneidet es wie kein zweites. Wenn ihr es zieht, durchfährt euch eine wohltuende Woge, die euch vor dem Kampf mit einer sanften Gelassenheit erfüllt.');
INSERT INTO "item_descriptions" VALUES(23618,'de','Ein Jiangshi-Nobi trägt die Überreste seines mumifizierten Körpers bei sich, der sowohl in der materiellen Welt als auch in Externam existiert. Auch wenn von ihm ein hartnäckiger Verwesungsgestank ausgeht, kann dieser Totensack jahrelang aufbewahrt werden. Wenn ihr euch einsam fühlt, habt ihr immer einen Freund an eurer Seite, mit dem ihr euch unterhalten könnt.');
INSERT INTO "item_descriptions" VALUES(23619,'de','Wenn ihr diese Stiefel tragt, erscheinen euch eure Beine viel leichter! Ihr bewegt euch viel leiser und setzt bei jedem Schritt Nebelwölkchen frei. Mit ein bisschen Übung könntet vielleicht auch ihr den Titel „Nebelritter“ tragen.');
INSERT INTO "item_descriptions" VALUES(23620,'de','Zahlreiche Anläufe waren nötig, um euch diese Rüstung zu beschaffen, die die Hüften ihres Trägers schützt und ihm dabei optimale Bewegungsfreiheit bietet. Der Gürtel wurde ursprünglich für Tsukinochi entworfen, um zu verhindern, dass die komplizierten kreisförmigen Bewegungen ihrer Doppelklingen von einer zu schweren Rüstung behindert werden.');
INSERT INTO "item_descriptions" VALUES(23621,'de','Diesen Schild ziert das Bild eines Yokomainu, ein Tempelbeschützer-Yokai. Angeblich soll er böse Geister fernhalten können. Ansonsten könnt ihr mit ihm auch die nervigen Kinder verscheuchen, die an Höll O''Feen nach Süßigkeiten betteln.');
INSERT INTO "item_descriptions" VALUES(23622,'de','Die beiden Rubine, die in diesen Ring eingelassen sind, sollen die Augen der Göttin Inali darstellen. Winzige Flammen tanzen in den Juwelen. Könnte es sein, dass der Geist eines echten Kitsou diesem Ring innewohnt? Wahrscheinlich ist es doch nichts weiter als die Spiegelung eurer eigenen Gier.');
INSERT INTO "item_descriptions" VALUES(23623,'de','Diese Geta ermöglichen es euch nicht nur, euch im orientalischen Stil zu kleiden und dabei elegant zu wirken. Ihr könnt damit auch durch Ektoplasma waten, ohne den Rest eures Gewands zu beschmutzen. Wenn euch kalt ist, könnt ihr diese Pantinen auch mit Socken tragen. Traut euch ruhig! In diesen Schuhen gelten Socken nicht als schlechter Stil.');
INSERT INTO "item_descriptions" VALUES(23624,'de','Jedes Volk hat seine Kriegerkaste. Die Yokai bilden da mit ihren Onigori keine Ausnahme. Wie alle echten Rachedämonen nehmen auch sie die Rüstung der Samurais an sich, die sie niedergemetzelt haben. Trotz seines fortgeschrittenen Alters schützt dieser verstärkte Gürtel eure empfindlichen Hüften wie am ersten Tag.');
INSERT INTO "item_descriptions" VALUES(23625,'de','Man hört häufig, dass die Kaonashi Geister von Zwölfianern sind, die in vollständiger Anonymität gestorben sind. Das würde zumindest das Fehlen ihres Gesichts erklären. Das ist selbstverständlich total falsch. Aber nichts hindert euch daran, diese Maske zu tragen, und euch für den verstorbenen Urgroßvater eures furchtbar naiven Freunds auszugeben. ');
INSERT INTO "item_descriptions" VALUES(23626,'de','Die Geistreichen verwenden diese Augenbinde, um ihre Sicht zu versperren und so ihre anderen Sinne zu schärfen. Dank dieser Vorgehensweise sind sie in der Lage, die Geister, gegen die sie antreten sollen, noch leichter zu erkennen. Was euch anbelangt, so schützt sie euch vor allem davor, dass ihr in die ehrlosen Visagen eurer Gefährten blicken müsst.');
INSERT INTO "item_descriptions" VALUES(23627,'de','Nasumara, der Schmied der Grobis-Insel, hat vier lange Jahre gebraucht, um dieses Geistreichen-Katana zu schmieden, mit dem Geister verbannt werden können. Leider hat es nach einem Kampf, der aus dem Ruder gelaufen ist, seine Anti-Geister-Eigenschaften vollständig verloren. Trotzdem bleibt es natürlich eine hochwertige Waffe für all jene, die mit dieser Art von Klinge umgehen können.');
INSERT INTO "item_descriptions" VALUES(23628,'de','In diesem Behälter, der mit einem Fluchsauger verbunden ist, kann der Fluch des Dark Vlad gelagert werden, der die Gespenster der Grobis-Insel daran hindert, die Insel zu verlassen. Dieser hier konnte dem Druck der bösartigen Energie, die er enthielt, nicht standhalten. Die Überreste des Fluchs in diesem Fass stärken euch, während ihr es auf dem Rücken tragt.');
INSERT INTO "item_descriptions" VALUES(23805,'de','Dieser Panzer mit einem Gewicht von mindestens 20 Kilopods dient der Muskelstärkung im Rahmen des Trainings bei Meister Tor Tur.');
INSERT INTO "item_descriptions" VALUES(24022,'de','Dieses Tintenamulett ist fest und flüssig zugleich und stellt ein außergewöhnliches Kalligraphiewerkzeug dar. Seine Spitze ist so fein, dass ihr wunderschöne Zeichen mit absoluter Präzision zeichnen könnt, sofern ihr die Mindestanforderungen dieser subtilen Kunst erfüllt.');
INSERT INTO "item_descriptions" VALUES(24023,'de','Die altehrwürdigen Schuhmacher behaupten, dass es sehr verlockend ist, Gürtelschnanglizismen anzufertigen. Allerdings wird man allzu oft dazu verleitet, sie bei jeder Gelegenheit zu verwenden. Wenn sie nicht mehr oder zumindest sehr viel subtiler und sparsamer eingesetzt werden, liegt das daran, dass ihrem Einsatz in der Welt der Zwölf ein Image von Faulheit anlastet und man sie als äußerst unpassend wahrnimmt. Ah, Schuhmacher und ihre Prinzipien! Trotzdem bleibt diese Form der Gürtelschnalle natürlich ein Must-Have.');
INSERT INTO "item_descriptions" VALUES(24024,'de','Diese Stiefel wurden als Hommage an Kian Zhi hergestellt, den legendären stummen Träumer. Skrupellose Hersteller rühmen die Feinheit der Kianzhi, die sie nach eurem Vorbeigehen am Boden hinterlassen. Wer die Kianzhi zu lesen weiß, wird euch sagen, dass dort lediglich steht: „Handgefertigt in Pandala, Größe 38“.');
INSERT INTO "item_descriptions" VALUES(24026,'de','„Mein Konsonant dämmerte vor sich hin
Mein Vokal sagte ja
Mein Konsonantenhelm sagte Nein
Aber mein Geist wollte zu neuen Ufern aufbrechen“

– Meister Gims, seines Zeichens Zombie und Barde');
INSERT INTO "item_descriptions" VALUES(24027,'de','Vergisst du Apostrophe, ist das ne Katastrophe.');
INSERT INTO "item_descriptions" VALUES(24028,'de','Die Silbensense mäht Feinde nieder und schneidet Worte ab.');
INSERT INTO "item_descriptions" VALUES(24029,'de','Als sie noch jung war, musste Wulan sich als Samurai ausgeben, um anstelle ihres Vaters, der langsam zu alt für den Kampf war, an einer Schlacht teilzunehmen. Schließlich ist sie eine echte Samurai geworden und hat dank ihrer Verdienste und außerordentlichen Fähigkeiten alle Hürden genommen. Heutzutage befehligt sie den Samuraiorden, der in den Diensten der Daimya steht. Ein schönes Beispiel für Erfolg und Emanzipation für alle jungen Mädchen (und Jungen)!');
INSERT INTO "item_descriptions" VALUES(24030,'de','„Sei ein Iop
Ihr müsst so schnell sein wie wildes Wasser
Sei ein Iop
Ihr müsst so stark sein wie ein Taifun
Sei ein Iop
Ihr müsst so heiß sein wie Höllenfeuer
Geheimnisvoll zugleich so wie der Mond“

Trotz ihrer großen Hingabe an Pandawa hat Wulan großen Respekt vor dem Kampfgeist der Anhänger Iops und lässt sich davon inspirieren, um ihre eigenen Truppen zu begeistern.');
INSERT INTO "item_descriptions" VALUES(24031,'de','„Augen wie ein Adler und ein Herz aus Stahl. Ihr müsst alles wagen, doch der Kampf wird hart.“

- Wulan');
INSERT INTO "item_descriptions" VALUES(24032,'de','Dieser Ring wird euer bester Verbündeter sein, wenn ihr einer großen Anzahl von Dingen eine logische und schlüssige Struktur verleihen wollt. Ob das Abenteurern zum Vorteil gereicht, bleibt allerdings abzuwarten.');
INSERT INTO "item_descriptions" VALUES(24033,'de','„Die Sonne scheint bei Tag und Nacht. Eviva, Pandalusia!
Der Himmel weiß, wie sie das macht. Eviva, Pandalusia!
Die Gläser, die sind voller Wein. Eviva, Pandalusia!
Und bist du selber einmal dort, willst du nie wieder fort.“

- Ein von einem Wanderbarden komponiertes Liedchen zu Ehren Pandalusiens.');
INSERT INTO "item_descriptions" VALUES(24034,'de','Mit dieser Sense könnt ihr jedem das Wort abschneiden, der es wagt, euren herrlichen Vornamen falsch auszusprechen.');
INSERT INTO "item_descriptions" VALUES(24035,'de','„Rächtschreibunk kan schon echt wichtik sain, sonzt faschtehn di Loite nix und dass wehr doch blöt.“

-Paulor Tograf, Pandawa mit Lese-Rechtschreib-Schwäche, der sich seiner Situation allerdings mehr als bewusst ist.');
INSERT INTO "item_descriptions" VALUES(24036,'de','Wusstest du schon? In der alten Sprache der Pandawas geht das Wort „Etymologie“, wie übrigens alle anderen Wörter auch, auf die Kianzhi, die Wortgeister, zurück. „Etymo“ kommt von dem Kianzhi, das „Wahrheit“ bedeutet, und „-logie“ leitet sich von dem Kianzhi ab, das unter anderem für „Wissen“ oder „verborgener Sinn“ steht.');
INSERT INTO "item_descriptions" VALUES(24037,'de','Auf diesem Hammer steht eine mysteriöse Grabrede:

„Oh, unbekannter Krieger, der uns weder Grabstein noch Portrait zurückließ, wisse, dass das Grab der Helden das Herz der Lebenden ist.“');
INSERT INTO "item_descriptions" VALUES(25214,'de','Die wenigen Seeleute, die sich in die Nähe des Atolls gewagt haben, erzählen die seltsamsten Geschichten. Wenn man ihnen Glauben schenken darf, ist dieses monströse Korallenriff, das teilweise unter einem Nebelschleier verborgen liegt, wie von Geisterhand aufgetaucht. Durch den Nebel hindurch, der hier und da von grellen Feuern zerrissen wird, meinen sie ein beunruhigendes Wehklagen zu vernehmen, das von Kriegstrommeln und eindringlichen Litaneien unterbrochen wird. Einige wollen sogar eine riesige geisterhafte Gestalt gesehen haben, die sich im Nebel bewegt, und ein Paar glutroter Augen, das sie anstarrt und ihre Seele bis in den letzten Winkel durchdringt. Wenn diejenigen, die zurückgekehrt sind, von diesen höllischen Visionen in Todesangst versetzt wurden, was mag dann wohl aus denjenigen geworden sein, denen der Segen der Rückkehr nicht zuteil wurde ...');
INSERT INTO "item_descriptions" VALUES(25215,'de','„Hey, ihr Shushus! Heult leiser!“

– Typische Beleidigung der Besessenen für die Shushus von Rushu');
INSERT INTO "item_descriptions" VALUES(25216,'de','„Wir kennen weder Glaube noch König“, „Wir kennen weder Gott noch Priester“: Trotz dieser entschlossen anarchistischen Parolen scheinen die Besessenen zahlreiche Bräuche und Riten zu befolgen, die es ihnen erlauben, trotz des unter ihnen herrschenden Gesetzes des Stärkeren zusammenzuleben. Es gibt da übrigens noch eine andere Devise, die weniger bekannt ist: „Mamas werden nicht beleidigt“. Die Besessenen haben im Grunde genommen Respekt vor nichts und niemandem, aber wenn der Name der Mutter der sieben Meere zur Sprache kommt, dann äußern sie sich mit gedämpfter, von Respekt und Angst erfüllter Stimme.');
INSERT INTO "item_descriptions" VALUES(25217,'de','„[...] Das Atoll der Besessenen ist in zwei verschiedene Bereiche unterteilt: Da wäre einerseits der Hafen der Zerstörer, wo das verdorbene Korallenriff halbmondförmig angeordnet ist und viele Dämonenschiffe vor Anker liegen. Der Eingang dieses Halbmonds wird von zwei imposanten schwarzen Statuen bewacht, die ein Bewusstsein zu haben scheinen und jede An- und Abreise streng kontrollieren. Der andere Teil des Atolls, der den Hafen überragt, wird Pandamonium genannt und ist die wahre Hochburg der Besessenen. Was genau sie dort vorhaben und wie viele von ihnen dort hausen, ist allerdings schwer zu sagen. Im gesamten Gebiet finden sich kabbalistische Symbole und Spuren von Ritualen, was auf den Einsatz einer finsteren und mächtigen Magie hindeutet. Ihr Anführer ist ein Pandawa-Schamane mit ausgemergelten Schwingen und einem imposanten, mit Hörnern und Krallen besetzten Arm ... Der Göttin sei Dank! Um ein Haar wären wir entdeckt worden. Es tut mir leid, euch mitteilen zu müssen, Daimya Hikomi, dass auf Pandala und der Welt der Zwölf eine große Bedrohung lastet und dass uns schwere Verluste bevorstehen.“

– Alan Pafflelu, aus dem Missionsbericht an die Daimya hinsichtlich des Atolls');
INSERT INTO "item_descriptions" VALUES(25218,'de','„Warum diese zänkische Liebe, Liebe voller Hass, alles aus dem Nichts erschaffen? Oh schwere Leichtigkeit, oh ärmste Tändelei. Entstelltes Chaos, scheinbar wohlgeformt.“

– Autor unbekannt');
INSERT INTO "item_descriptions" VALUES(25219,'de','„Anarchismus und Anomie sollten nicht verwechselt werden: Die Anomie ist das Fehlen oder die Zurückweisung jedweder Gesetze und Regeln, was unausweichlich zum Zerfall einer Gesellschaft führen muss. Im Gegensatz dazu ist die Anarchie Ordnung ohne Konzentration von Macht oder einer anderen Form von Hierarchie, das bedeutet eine soziale Ordnung, die gerecht und egalitär ist, da sie gemeinsam beschlossen wird.“

– Affie Hobbmann, Auszug aus dem Buch „Stehlen Sie dieses Werk“');
INSERT INTO "item_descriptions" VALUES(25220,'de','„Es lechzen Phantome und Dämonen
Über des weiten Horizonts Leere
Nach den Seelen uns''rer Kameraden
Die gierigen Parasiten der Meere!
Wir anderen stehen an den Ufern
Die unsere Schiffe krachend rammten
Als nichts als Nebel uns umgab
Und singen für die Verdammten.“

– Lied der Pandala-Seeleute');
INSERT INTO "item_descriptions" VALUES(25221,'de','„Man stellt sich das Chaos immer wie ein Loch ohne Boden vor, einen finsteren Abgrund, eine höllische Spirale aus Zerstörung und Leid. Dabei ist es in Wirklichkeit viel komplexer, schwer greifbar und eng mit dem Leben selbst verbunden. Zu erschaffen heißt manchmal auch zu zerstören. Und umgekehrt. Keinerlei Prinzipien zu haben, ist eben auch ein Prinzip. Was wäre die Freiheit ohne die Unordnung, die sie auf ihrem Wege sät?

Was wäre unsere Welt ohne die Bewegung, die allein das Chaos zu schaffen vermag? Ein hübsches Gemälde, in dem sich alles an seinen angestammten Platz fügt, gewiss. Ein todbringendes Gemälde, bei dessen Betrachtung man in der trägen Ewigkeit einer unveränderlichen und absoluten Ordnung versinken würde – ein abgrundtiefes Loch!

Das Chaos ist kein Loch. Das Chaos ist eine Leiter. Viele, die sie zu erklimmen versuchen, scheitern. Und können es nie wieder versuchen. Sie zerbrechen an ihrem Sturz. Und manchen wird die Gelegenheit geboten, sie zu erklimmen – doch sie weigern sich. Sie klammern sich an das Reich oder die Götter oder die Liebe. An Illusionen. Nur die Leiter ist echt. Der Aufstieg ist alles!“

– Kabahal, Anführer der Besessenen');
INSERT INTO "item_descriptions" VALUES(25222,'de','„Weder Turm aus Stein noch Mauern aus Bronze, weder luftloser Kerker noch eisenschwere Ketten können die Freiheit der Seele unterjochen. Sobald sie der Fesseln dieser Welt müde wird, findet die Seele wie von selbst Kraft, aus eigenen Stücken zu entfliehen. Dies weiß ich – und von nun an soll es das ganze Universum wissen – dass ich das Joch, das ich trage, nach Belieben abschütteln kann.“

– Julliam Schekspier, am 6. Jullier 651 als vermisst gemeldeter Zwölfianer');
INSERT INTO "item_descriptions" VALUES(25235,'de','Diese Klinge gehörte der Anführerin der Geistreichen höchstpersönlich.');
INSERT INTO "item_descriptions" VALUES(25245,'de','Dieser Pinsel wurde streng nach Pandawa-Tradition gefertigt und dient dem Künstler als Verlängerung seines Körpers. Nehmt einem Kalligraphen seinen Pinsel weg und ihr bringt den Quell seiner Kreativität zum Versiegen! Ohne seinen Pinsel gelingt es ihm nicht, sich vom Joch der Stille zu befreien und seine Gedankenströme zum Fließen zu bringen.');
INSERT INTO "item_descriptions" VALUES(25248,'de','Dieser Pinsel wurde vom obersten Kalligraphen gesegnet und bildet mit euch eine fest verwachsene Einheit. Euch von ihm trennen zu müssen, wäre so, als würde man euch einen Finger, einen Arm oder einen anderen winzigen, aber umso wichtigeren Teil eures Körpers abschneiden. Das wäre sicher äußerst schmerzhaft, daher sei euch geraten, immer gut auf ihn aufzupassen und ihn nur bei besonderen Anlässen zu verwenden. Zum Retten der Welt, zum Beispiel.');
INSERT INTO "item_descriptions" VALUES(1025292,'de','Die Larven dieser charmanten Kreatur namens Taeh‘Niak verstecken sich im nicht oder wenig durchgegarten Fleisch und dienen als Nahrung für die Dämonenschiffe, die sogenannten Kar‘Draks. Dann wachsen sie im Magen der Unglücklichen, die sich dazu hinreißen lassen, davon zu probieren. Das erzählen die Bwork-Eltern jedenfalls ihren Kindern, um sie davon abzuhalten, alles anzuknabbern, was ihnen in die Hände fällt, von alten abgestandenen Kadavern bis hin zu den Ohren ihrer kleinen Kameraden. Denn vergessen wir nicht: Man ist, was man isst.');
INSERT INTO "item_descriptions" VALUES(1025293,'de','Ein schneller Blick zur Seite, um den gegnerischen Angriff zu antizipieren, ein Spannungsgefühl und dann ein heftiger Schmerz am Halsansatz. Der Schmerz breitet sich blitzschnell bis zum Kiefer aus und lässt euch qualvoll aufschreien, bis ihr euch gar nicht mehr bewegen könnt. Dank seiner Spezialrüstung und seinem überaus muskulösen Hals kann Tortikoli so etwas nicht passieren!');
INSERT INTO "item_descriptions" VALUES(25752,'de','„Kennt ihr den Unterschied zwischen einer Maus und einer Ratte? Es ist ganz einfach. Wenn der Nager bei euch zu Hause ist, handelt es sich um eine Maus. Egal wie groß oder gefräßig er ist. Wenn er wiederum bei mir zu Hause ist, egal wie klein oder scheu, dann handelt es sich um eine Ratte.“');
INSERT INTO "item_descriptions" VALUES(25753,'de','„Sagt eine Weiße Ratte zur anderen: Ich habe meinen Psychologen so gut erzogen, dass er mir jedes Mal etwas zu essen bringt, wenn ich läute.“');
INSERT INTO "item_descriptions" VALUES(25952,'de','Abenteurer, macht euch bereit für das Spiel eures Lebens!

„Einmal Fressballer, immer Fressballer!“');
INSERT INTO "item_descriptions" VALUES(26006,'de','Was ist der Unterschied zwischen einem guten Zerstörer und einem schlechten Zerstörer? Der schlechte Zerstörer hat Stacheln und Tentakeln und zerstört alles, was nicht bei drei auf den Bäumen ist. Der gute Zerstörer zerstört alles, was nicht bei drei auf den Bäumen ist, ... aber er ist ein guter Zerstörer!');
INSERT INTO "item_descriptions" VALUES(26007,'de','Der etwas zwielichtige Handwerker, der euch diesen Handschuh gefertigt hat, sagte: „Kein Kunstwerk kann ohne die Hilfe eines Dämonen entstehen.“ Glücklicherweise versteht ihr sowieso nichts von Kunst.');
INSERT INTO "item_descriptions" VALUES(26008,'de','Der Alptraum ist einfach der ideale Ort für die Zerstörer, denn hier können sie sich voll und ganz ihren niederträchtigen Gelüsten hingeben: Sie töten, zerstören, plündern, foltern und begehen andere Schandtaten derselben Art – so wie rückwärts sprechen oder alkoholfreies Bier trinken.');
INSERT INTO "item_descriptions" VALUES(26009,'de','„Engel und Dämonen trennt nur ein einziger Gedanke. Der Unterschied ist, dass der Engel diesen Gedanken noch nicht hatte.“

— Pol Léryhva, „Die Fabeln der Morgenröte“');
INSERT INTO "item_descriptions" VALUES(26010,'de','„Ob die Welt nun eines Tages zerfällt oder nicht, ob ihr auf der Seite der Engel oder des Teufels selbst steht – nehmt das Leben, wie es ist, habt Spaß und verbreitet Chaos und Freude.“

— Henri „die Mille“ Valentin, „Die Fabeln der Morgenröte“');
INSERT INTO "item_descriptions" VALUES(26011,'de','„Das echte Leben war Chaos, aber in der Fantasie lag eine schreckliche Logik.“

— Oskar Wild');
INSERT INTO "item_descriptions" VALUES(26018,'de','„Als der Morgen des 12. Septangers des Jahres 26 graute, war es sehr kalt. Das Licht mühte sich redlich darum, die Schatten der Nacht zu durchdringen. Die Bonta-Vorposten, die von den Rittern des Ordens unterstützt wurden, waren vom ersten Frost weiß gefroren, die Wachen waren von dieser frühzeitigen Kälte wie erstarrt. Sie drängten sich um die Feuerbecken, aber es gelang ihnen trotzdem nicht, sich aufzuwärmen. Der Wald, der normalerweise um diese Stunde schon vor abertausend Geräuschen widerhallte, lag vollkommen still da. Wenn da nicht dieser Schrei gewesen wäre, der in der Nacht mehrmals vernommen worden war. Die Wachen hatten sich zunächst nicht weiter darum geschert, aber jetzt schenkten sie der Dunkelheit dort unten in Richtung Süden größere Aufmerksamkeit. Der Schrei war nähergekommen und er klang nicht, als wäre er einem normalen Tier entsprungen.“

„Die Purpurne Morgenröte – Wiedergefundene Fragmente, Band IX“');
INSERT INTO "item_descriptions" VALUES(26019,'de','„Auf seinen Ruf hin erhoben sich die Geister der gefallenen Ritter vom Orden des Tapferen Herzens. Ihre Rüstungen knarrten und schepperten und sie waren nicht schön anzusehen. Jeder von ihnen trug schreckliche Wunden, manchen waren Gliedmaßen abgerissen worden und alle waren vom Feuer geschwärzt. Raval schritt durch die schweigenden Reihen und zeigte in Richtung der Armee von Brâkmar. Wo die Truppen Hyrkuls gerade die Stadttore Bontas angriffen. Trools beschleunigten große Rammen mit Wucht gegen die Tore. Innen hielt Jiva einen Wall aus schwer gepanzerten Fußsoldaten bereit, um den früher oder später erfolgenden Durchbruch des Gegners einzudämmen. Goblins versuchten bereits, sich durch die Risse der Tür durchzuzwängen, die von Sekunde zu Sekunde weiter wurden. Hyrkul, der mit einem großen Streitkolben ebenfalls die Tür bearbeitete, schaute auf einmal suchend auf, als hätte ihn jemand gerufen. Er hielt inne und drehte sich dann plötzlich um ...“

„Die Purpurne Morgenröte – Wiedergefundene Fragmente, Band X“');
INSERT INTO "item_descriptions" VALUES(26020,'de','„Mit einem Mal waren von der Nachhut seiner Armee Todes- und Schreckensrufe zu hören. Der Koloss hörte irritiert hin. Aber die Schreckensrufe beunruhigten ihn weniger. Er schaute angestrengt gen Süden. Schließlich sah er den neuen Feind. Seine Truppen wurden von Ordenskriegern dezimiert. Denselben Ordenskriegern, die er zuvor mit seinem dunklen Feuer niedergemacht hatte. Ein weißes Meer überflutete die Brâks. Genau zu diesem Zeitpunkt ertönte das Horn von Bonta. Jiva hatte ihrerseits die Zeichen der Zeit erkannt und organisierte einen Ausfall. Die Stadttore öffneten sich und unter schmetternden Trompeten blies Jiva zum Angriff.“

„Die Purpurne Morgenröte – Wiedergefundene Fragmente, Band X“');
INSERT INTO "item_descriptions" VALUES(26021,'de','„Hyrkul, so lautet mein Name. Er wird das Letzte sein, was du hörst, bevor ich dich in die andere Welt schicke, Zentaur!“, erwiderte sein Gegenüber und die beiden stürzten aufeinander zu. In weniger als einer Sekunde war der Kampf entschieden. Menalt versuchte, die weiß leuchtende Spitze seiner langen Kriegslanze zwischen Helm und Halskrause zu stoßen, dort, wo der Rüstungsschutz seines Gegners am geringsten ausfällt. Allerdings scheiterte sein Vorhaben an der perfekten Parade seines Gegners, der daraufhin seine Schattenflügeltechnik einsetzte, um den Zentaur zu blenden und zu schwächen. Dann lies er plötzlich von seinem Angriff ab, ergriff den überraschten Zentaur an der Kehle, während seine andere Hand die Lanze blockierte. Beide schrien. Der eine vor Wut, der andere vor Schmerzen! Dunkle flammende Blitze schossen aus seinem Helm und trafen Menalt mehrere lange Sekunden im Gesicht, bevor ihm schließlich schwarz vor Augen wurde. Hyrkul ließ den bewusstlosen Krieger zu Boden fallen und schwang sein schwarzes Schwert, um ihm den Todesstoß zu versetzen. Pfeifend senkte sich sein Schwert und trennte Menalt den Kopf ab.“

„Die Purpurne Morgenröte – Wiedergefundene Fragmente, Band X“');
INSERT INTO "item_descriptions" VALUES(26022,'de','„Aus dem schwarzen Schwert von Hyrkul war nun ein gewaltiger Drache aus dunklem Feuer geworden, der das Schlachtfeld überragte. Dann stürzte dieser herab und fuhr durch die Reihen der Ritter Bontas, die einer nach dem anderen brennend zu Boden stürzten. Die anderen Krieger Bontas erlagen der darauffolgenden Explosion. Pouchecot selbst überlebte den Angriff nur knapp durch Einsatz seiner mächtigsten Magie: Er hatte sich in einen gewaltigen Baum verwandelt. Die geschwärzten Rüstungen der Ordensritter säumten nun das Schlachtfeld. Ein frostiger Eisregen setzte ein. Unbeeindruckt zog die Hauptmacht der Truppen Brâkmars wieder in Richtung Bonta. Hyrkul blieb kurz neben Pouchecot in seiner Baumform stehen. Er war zwar geschützt, musste aber regungslos bleiben. Der schwarze Koloss begann hämisch zu lachen.

„Wenn ich zurückkomme, schnitze ich dir aus deinem eigenen Holz einen passenden Sarg, Pouchecot! Aber vorher ... vorher will ich noch Jivas Kopf auf deinen Ästen aufspießen!“ Er spuckte aus und eilte dann seiner vorausgegangenen Armee nach. Schließlich kam die Armee in Sichtweite der leuchtend weißen Stadtmauern Bontas an und hielt an.“

„Die Purpurne Morgenröte – Wiedergefundene Fragmente, Band X“');
INSERT INTO "item_descriptions" VALUES(26023,'de','„Mit Müh und Not gelang es Hyrkul, sich einen Weg aus dem Schlachtfeld heraus zu bahnen. Abseits des Getümmels angekommen warf er einen letzten sehnsüchtigen Blick auf Bonta. So knapp dran! Schließlich floh er in Richtung Astaknydenwald, um dort unterzutauchen. Wegen dieser seltsamen Phantomkrieger hatte er zwar keinen Sieg für Brâkmar eingefahren. Doch brachte er wichtige Informationen mit: Er war sich sicher, dass sich die Dofus nicht in Bonta befanden! Denn sonst hätten Jiva und Pouchecot sie sicher eingesetzt, um ihre Macht zu demonstrieren und die Truppen von Brâkmar in Angst und Schrecken zu versetzen ... Diese Information wog die unzähligen gefallenen Truppen Brâkmars locker auf ... Hyrkul verschwand in den Tiefen des Düsterwalds.“

„Die Purpurne Morgenröte – Wiedergefundene Fragmente, Band X“');
INSERT INTO "item_descriptions" VALUES(26058,'de','Die einfachsten Gegenstände bergen oft die größte Macht.');
INSERT INTO "item_descriptions" VALUES(26066,'de','„Die Nacht ist so dunkel, damit uns nichts von unseren Alpträumen ablenken kann“, sagte der kleine Kilvan, bevor er mit seinem Plüschtiguar im Arm beruhigt einschlief.
Warum ist die Nacht so düster? Weil sich unter ihrem Mantel all die Ängste und Mysterien der ewigen Nacht verbergen. In der Wiege von Gut und Böse, der Quelle eines ewigen Konflikts, verschmelzen abscheuliche Ängste, glühende Glut und glänzende Glyphen zu einer untrennbaren Masse.');
INSERT INTO "item_descriptions" VALUES(26085,'de','Es gibt nichts Besseres als einen dämonischen Alptraumfänger, um einen bösen Traum einzufangen, ohne seinen Einfluss zu mindern.');
INSERT INTO "item_descriptions" VALUES(26099,'de','Ayutos Nudelholz, das der Waffe der berühmt-berüchtigten Aermyne sehr stark ähnelt, soll von Maimane geschnitzt worden sein. Wer weiß, vielleicht birgt es ein belastendes Geheimnis? Das würde auch erklären, warum es so schwer ist ...');
INSERT INTO "item_descriptions" VALUES(26131,'de','Vampiren ist diese Enutrof-Schaufel äußerst verhasst. Bei Exorzisten und Betfruschen hingegen steht sie hoch im Kurs, denn sie leistet bei zahlreichen Beschwörungsritualen ausgezeichnete Dienste.');
INSERT INTO "item_descriptions" VALUES(26198,'de','Diese Spitzhacke ist nicht für den Kampf gemacht. Zum Abbauen besonders harter Materialien hingegen ist sie perfekt geeignet. Wenn sie nur nicht so umständlich zu schwingen und so zerbrechlich wäre ... Ein Schlag auf eine harte Oberfläche und sie zerspringt in tausend Stücke.');
INSERT INTO "item_descriptions" VALUES(26308,'de','Dieser Ring ist von der Macht der Malter durchdrungen – düstere Kreaturen, die mit der allgegenwärtigen Dunkelheit des Schattenwaldes verschmelzen können. Zu eurem Pech funktioniert diese Tarnfähigkeit nicht bei den Zwölfianern.
Es wird erzählt, dass ein gewisser Fressball-Spieler – ein Mannschaftsmitglied der Bonta-Blauen – versucht haben soll, mit diesem Ring in die Umkleidekabinen der Frauen einzudringen. Als er herauskam, war sein Gesicht blauer als sein Trikot.');
INSERT INTO "item_descriptions" VALUES(26309,'de','Diese Stiefel erzeugen bei jedem Schritt ein leises Geräusch von raschelndem Laub, was die entspannende Wirkung all eurer Spaziergänge noch verstärkt.');
INSERT INTO "item_descriptions" VALUES(26310,'de','Diese Pflanzensense aus verschlungenen Brombeerranken wird von den Maltern zur Bestrafung abtrünniger Malteregos benutzt. Aufgrund der Biegung ihrer Dornen ist es unmöglich, die Waffe aus dem Körper ihres Ziels zu entfernen, ohne große körperliche Leiden zu verursachen.');
INSERT INTO "item_descriptions" VALUES(26311,'de','Ihr müsst euch den Ring nur an den Finger stecken, um die brodelnde Wut Hell Minas zu spüren. Stellt euch also mal vor, wie es wäre, ihre vollständige Ausrüstung anzulegen!');
INSERT INTO "item_descriptions" VALUES(26313,'de','Dieser gut verarbeitete Umhang verleiht euch im Kampf eine triumphale Ausstrahlung, die die glühende Entschlossenheit begleitet, die in jedem eurer Schläge mitschwingt.');
INSERT INTO "item_descriptions" VALUES(26314,'de','Angeblich soll die ewige Flamme, die auf der Spitze von Hell Minas Partisane lodert, von Dark Vlad entzündet worden sein. Nachdem es euch gelungen ist, euch ein Exemplar dieser Waffe zu besorgen, solltet ihr sie regelmäßig mit Petroolleum bestreichen.');
INSERT INTO "item_descriptions" VALUES(26336,'de','Mit dieser geflickten Kopfbedeckung könnt ihr alles tun, was auch Goblinmagier können: Socken verschwinden lassen, dubiose Tränke brauen ... Und vieles mehr!');
INSERT INTO "item_descriptions" VALUES(26337,'de','Achtet auf die Reaktion des Goblins Vermo, wenn ihr mit diesen Stiefeln zum Bibliotempel geht, denn ihr könntet ihn an traumatische Erlebnisse aus seiner Jugend erinnern.
Er kann nämlich nicht aufzählen, wie oft er nach einem zu lauten Streich die Schritte von Direktor Grunob durch die Korridore der Akademie hallen hörte, bevor ihn eine unvergessliche Predigt erwartete.');
INSERT INTO "item_descriptions" VALUES(26343,'de','Ein Band aus orangefarbenem Stoff, der mit Kawottenextrakt eingefärbt wurde. Es ist mit Maunzmiez-Haaren der gleichen Farbe bedeckt. Haltet ihr es für möglich, eine Maunzmiez zu färben, um sie an euren Look anzupassen?');
INSERT INTO "item_descriptions" VALUES(26344,'de','Dank seiner Klingenform ist dieses Werkzeug wie dafür geschaffen, um Popel unter den Tischen abzukratzen.');
INSERT INTO "item_descriptions" VALUES(26366,'de','Obwohl er vor Millionen von Jahren erschaffen wurde, sieht man diesem Ring sein Alter nicht an. Er macht euch weder unsichtbar noch zu einem Herrscher. Nichtsdestotrotz wird er euch von Nutzen sein, wenn ihr den Eid des Drachen der Wälder einhalten müsst. Vermeidet also, ihn zu verlieren oder auf dem Boden eurer Tasche vergammeln zu lassen.');
INSERT INTO "item_descriptions" VALUES(27265,'de','Diese Brosche scheint das Muster für das berühmte Amulett von Bulgur zu sein, dem Schmied der Götter.');
INSERT INTO "item_descriptions" VALUES(27266,'de','Dieser Gürtel ist leicht, aber sehr zerbrechlich, da er große Angst vor dem Wasser hat. Achtet darauf, ihn nicht nass zu machen, wenn ihr nicht wollt, dass die Leute den MuWulf kennenlernen.');
INSERT INTO "item_descriptions" VALUES(27267,'de','Dieser legendäre Umhang ist überall bekannt. Wusstest ihr aber, dass es eine Ankarton-Ausführung gab, die man sogar blau lackieren konnte?');
INSERT INTO "item_descriptions" VALUES(27268,'de','Das Ankarton-Goultard-Schwert wurde mit dem Blut von Ferkelchen getränkt, wodurch es weich wurde und nun nach Wurst riecht.');
INSERT INTO "item_descriptions" VALUES(27278,'de','Diese Getas aus Karton wurden von den besten Kartonagemachern der Welt der Zwölf hergestellt. Achtet darauf, nicht durch Pfützen zu laufen, da sonst die Garantie verwirkt wird.');
INSERT INTO "item_descriptions" VALUES(27280,'de','Dieser Schild ist ein Symbol für den Neuanfang. Er wurde vollständig aus recycelter Kartonage hergestellt und kann nach seiner Zerstörung jedes Mal wieder neu gefertigt werden.');
INSERT INTO "item_descriptions" VALUES(27282,'de','Was ist denn kultiger als diese Kopfbedeckung? Mit der Karton-Version seid ihr voll der (Ver-)Knüller.');
INSERT INTO "item_descriptions" VALUES(27284,'de','Einer jener Gegenstände, die jeder kennt. Und der Gelano ist der bekannteste davon. Häufig imitiert, doch niemals gleich, ist er für einige ein unerreichbarer Meilenstein. Ihr habt eine blasse Kopie in die Hände bekommen, was für den Moment ausreichen sollte.');
INSERT INTO "item_descriptions" VALUES(27431,'de','Dieses Fresssäckchen folgt euch seit Incarnam, um euch bei euren ersten Schritten in der Welt der Zwölf zu helfen. Obwohl es noch ziemlich mickrig ist, wird es sein Bestes geben, um euch dabei zu helfen, eure ersten Waffen herzustellen.');
INSERT INTO "item_descriptions" VALUES(27510,'de','Sollte es jemand wagen, euer Hab und Gut zu stehlen, legt das Claymomore auf der Stelle den Dieb um und saugt seine Seele auf, wie ein unheimliches schwarzes Sturmbringer-Schwert. Das steht jedenfalls in Fettdruck in der mit der Waffe mitgelieferten Bedienungsanleitung, direkt über den Vorsichtsmaßnahmen bei der Anwendung und der Verantwortungslosigkeitsklausel bei versehentlichem Aufschlitzen.');
INSERT INTO "item_descriptions" VALUES(27511,'de','Nach der Maske folgt jetzt der Fliegerhelm von Cire. Besitzt dieser Helm makabre Zauberkraft, wie der blasse Lichtschein anzudeuten scheint, oder riecht er nur etwas muffig? Um dies herauszufinden, müsste man ihn anprobieren ... aber beschwert euch nicht, wenn ihr dann plötzlich anfangen müsst, herzzerrreißend zu weinen, ohne wieder aufhören zu können.');
INSERT INTO "item_descriptions" VALUES(27512,'de','Dieser finstere, gequälte Umhang wurde vermutlich aus den Schreien von Cire Momores Opfern gewebt. Wenn ihr jahrhundertelang in einer Rüstung eingesperrt wärt, wäre euch auch zum Schreien zumute.');
INSERT INTO "item_descriptions" VALUES(27513,'de','„...!“

– Cire Momore, die sechsunddreißig Kerzen');
INSERT INTO "item_descriptions" VALUES(27514,'de','„Sterben bringt nichts, man muss immer weitergehen“: Das waren die letzten Worte eines Fabeldichters erfundener Geschichten, der dem Schicksal ... und Cire Momore zum Opfer fiel.');
INSERT INTO "item_descriptions" VALUES(27515,'de','Ein Iop führte einst ein Leben voller Aufregung und Exzesse. Er prahlte damit, auf einer verfluchten Insel einen Schatz gefunden und über seinen Wächter triumphiert zu haben. Als Beweis zeigte er einen Ring herum, den er dem Monster als Trophäe vom Finger gerissen hatte.
Eines Tages fand man den verkohlten Iop inmitten der Ruine seines Anwesens. Eine entzündete Kerze hatte den Brand ausgelöst. Ein trauriges Los für einen maßlosen Tor.');
INSERT INTO "item_descriptions" VALUES(27522,'de','Habt ihr auch nur die leiseste Ahnung, wie viele Timongusten für diese Stiefel gepellt werden mussten? Viel zu viele, wie euch Racooper bezeugen würde. Viel zu viele ...');
INSERT INTO "item_descriptions" VALUES(27523,'de','In Wirklichkeit handelt es sich hier um verschiedene Pelze, die zusammengenäht wurden. Ihr könnt euch daraus also auch einen Mantel, einen Schal oder sogar einen Lendenschurz machen ...');
INSERT INTO "item_descriptions" VALUES(27524,'de','Das aufgeprägte Symbol dieses umweltfreundlichen Rings aus einem nachhaltigen Kiefernzweig stellt einen Schwerbär dar. Jetzt wisst ihr also, wie diese Kreaturen aussehen, bevor ihr euch in ihrem Revier auf die Suche nach Ressourcen begebt.');
INSERT INTO "item_descriptions" VALUES(27525,'de','Die Schmiedin B. Eule hat Tag und Nacht gearbeitet, um diesen Integralhelm herzustellen. Er ist nicht nur robust, originell und rostfrei, sondern kommt auch mit lebenslanger Garantie. Kurz gesagt, an diesem Helm stimmt einfach alles.');
INSERT INTO "item_descriptions" VALUES(27526,'de','Hartnäckigen Gerüchten zufolge wollte Barberyl um Tom Index'' Hand anhalten. Aus diesem Grund schmiedete sie einen Ring aus Metall, der diesem hier nicht unähnlich war und gleichzeitig als Geschenk und Symbol für eine vielversprechende Verbindung dienen sollte. Der Bibliothekar lehnte den Antrag jedoch ab, mit der Begründung, sie stünden auf unterschiedlichen Seiten. Frau Glockenleder kehrte unverrichteter Dinge zurück ... Doch es bleibt anzunehmen, dass in dieser Angelegenheit das letzte Wort noch nicht gesprochen ist.');
INSERT INTO "item_descriptions" VALUES(27527,'de','Diese Mütze mit dem authentischen Racooper-Schwanz ist der letzte Schrei der albueranischen Modewelt und lässt so manchen Arbeiter in der Kolonie vor Neid erblassen.');
INSERT INTO "item_descriptions" VALUES(27528,'de','Auf den ersten Blick scheint dieser Hammer direkt aus einer Schmelzhütte von der Ostewinsel zu stammen ... Doch wenn er volle Kanne auf einen Schädel niedergeht, fliegen keine Schokoladensplitter.');
INSERT INTO "item_descriptions" VALUES(27529,'de','Dank seines dicken Fells ist Racooper auf seinen langen Spaziergängen im Verschneiten Hochwald gegen die eisige Kälte geschützt. So kann er unter anderem stundenlang die Zwölfianer von den Baumwipfeln aus beobachten.');
INSERT INTO "item_descriptions" VALUES(27530,'de','Racooper trennt sich niemals von seiner XXL-Hippe, einem von seiner Familie über Generationen weitervererbten Werkzeug. Damit kann er sich durchkämpfen, die Taschen der Abenteurer durchsuchen, sich aber auch frei und ungezwungen an den steilsten Felswänden fortbewegen.');
INSERT INTO "item_descriptions" VALUES(27531,'de','Dieses Amulett ist bei der Wache von Albuera äußerst beliebt und verschafft seinem Träger einen deutlichen Vorteil in zahlreichen Scharmützeln mit der regionalen Fauna.');
INSERT INTO "item_descriptions" VALUES(27532,'de','Dieser Ring soll seinen Träger beim Kampf mit dem Speer nicht behindern. Stellt euch doch nur mal vor! Waffen dieser Größe sind so schwer, dass man sich schneller den Ringfinger verstaucht hat, als man gucken kann.');
INSERT INTO "item_descriptions" VALUES(27533,'de','Viele junge Speerschmied-Initianten erhalten diesen Speer im Laufe ihrer Ausbildung. Er ist robust, leicht und ausbalanciert, sodass man den Umgang mit der Waffe trainieren kann, bevor man sich auf einen Kampfstil spezialisiert.');
INSERT INTO "item_descriptions" VALUES(27534,'de','Diese Waffe hat schon vielen Jägern der Kolonie das Leben gerettet. Nicht nur hält sie dank ihrer Parierstange die Fingerchen ihres Trägers schön warm, sondern sie erlaubt es auch, einen Schwerbär zu bekämpfen, ohne in die Reichweite seiner Klauen zu geraten.');
INSERT INTO "item_descriptions" VALUES(27535,'de','Die Fallensteller der Kolonie von Albuera haben diesen Gürtel angefertigt, damit ihnen auch im stärksten Unwetter nicht die Hose davongeweht wird.');
INSERT INTO "item_descriptions" VALUES(27536,'de','Warme Stiefel aus robustem Leder, die eure Zehen im Schnee vor dem Erfrieren schützen.');
INSERT INTO "item_descriptions" VALUES(27537,'de','Rumgenöle nervt. Wenn ein vergrätzter alter Geizhals das Gesicht verzieht und euch angreift, weil ihr nach seinem Gold gegrabscht habt, wehrt ihr seine Gewalt am besten mit einem saugrauen Schild ab, sonst gibt''s gehörig Kloppe.');
INSERT INTO "item_descriptions" VALUES(27538,'de','Wenn ein Sauerhammer 77 Jahre alt wird, schenkt man ihm traditionsgemäß eine schwere Metallkette, um Anlass und Hals gebührend zu feiern.');
INSERT INTO "item_descriptions" VALUES(27539,'de','Diese Waffe in Form eines Croissants würde einem Bäcker-Krieger alle Ehre machen. Also macht euch keine Illusionen. Wenn euch eine Serpyn aus Ereboria französische Backwaren anbietet, hat sie dabei selten ein romantisches Frühstück im Sinn. Die Sensenfrau mag in vielerlei Gestalt erscheinen, doch überbringt sie immer nur die eine Gabe: ein Ticket ohne Rückfahrt in die Grauen Lande.');
INSERT INTO "item_descriptions" VALUES(27540,'de','Dieser vielseitig einsetzbare Hammer wird häufig von den Nimbos verwendet, die in den Ereboria-Schächten leben. Damit könnt ihr klopfen, nageln, schlagen, zerschmettern, platthauen, einstampfen, zertrümmern, pulverisieren, niederknüppeln und natürlich hämmern. Ein solches unverzichtbares Universalwerkzeug macht sich hervorragend in der Hand eines jeden Abenteuers, solange er nicht allzu sehr um seine Finger besorgt ist.');
INSERT INTO "item_descriptions" VALUES(27541,'de','Als die Abenteurer Barberyl in ihrer Bastion herausforderten, machten sie sich lautstark über sie lustig. „Na, klingen dir schon die Glocken? Dir werden wir gleich heimleuchten!“ „Gleich gibt‘s was auf die Omme – Dingeling!“ „So eine brauchen wir nicht mit Samthandschuhen anzufassen!“ Dann ließ Nimbos ihre Fäuste sprechen, und schon lachte niemand mehr. Zimperlich war die kleine noch nie.');
INSERT INTO "item_descriptions" VALUES(27542,'de','Aus welchem Grund trägt die Wächterin von Ereboria wohl Kleidung, die auch in den größten Kampfarenen von Srambad nicht fehl am Platze wäre? Haben die Nimbos eine Schwäche fürs Wressteln? Letztendlich spielt das keine Rolle. Kleider machen eben doch keine Leute und Barberyl kann anziehen, was sie möchte. Bei den Sauerhammern ist es nunmal sie, die die Hosen an! Das ist keine Frage des Bartes, sondern eine Frage des Komforts.');
INSERT INTO "item_descriptions" VALUES(27543,'de','Vor einigen Wintern, als die Sauerhammer verzweifelt nach Hause zurückkehren wollten, wagte sich eine Pandawa in die Stollen von Ereboria, um sich mit Barberyl Glockenleder anzulegen. In ihren schwarz umrandeten Augen tobte ein Sturm und sie beherrschte einen besonderen Stil des Pandawushu.
Die beiden Kriegerinnen hatten bereits viele Kämpfe ausgetragen. Ihre Auseinandersetzung dauerte lange an. Sehr lange. So lange sogar, dass die Nimbos, die sich versammelt hatten, um ihre Chefin anzufeuern, einnickten. Als sie wegen ihres eigenen Schnarchens erneut die Augen öffneten, verabschiedeten sich die Anhängerin der Großen Bärin und die Tochter des Schmieds gerade respektvoll voneinander. Außerdem tauschten sie die Waffen. Trotz des Unentschiedens erhellte ein Lächeln Barberyls Gesicht. Die quälende Mutlosigkeit war endlich verschwunden.
Seit jenem Tag bewahrt sie die Tonfas ihrer ehrenhaften Gegnerin auf – als Andenken und Trophäe. Wer hätte gedacht, dass Barberyl so sentimental ist?');
INSERT INTO "item_descriptions" VALUES(27544,'de','Schilde, ganz egal, wie schwer sie auch sein mögen, dienen nicht nur dazu, sich zu schützen oder sich von seinen Untergebenen durchs Dorf schleppen zu lassen. Hier haben wir ein Exemplar von einem Krachler, der in etwa so begabt war wie 10 Meter Mauer. Es wurde aus einem Block Brombimsstein gefertigt und ist ein wahres Prunkstück für eure Sammlung.');
INSERT INTO "item_descriptions" VALUES(27545,'de','Dem allgemeinen Volksglauben nach schwang der Henker des alten Königreichs Ephedrya eine Axt namens Potenz. Er hielt sich in der Nähe der Säulen der Gerechtigkeit auf, unpassierbar, unbeweglich wie eine Statue, und er hob seine schwere Waffe nur, um all diejenigen einen Kopf kürzer zu machen, die es wagten, der Königin die Stirn zu bieten. Ah, das waren noch Zeiten.');
INSERT INTO "item_descriptions" VALUES(27546,'de','Dieser Speer wurde den berühmten Säulen der Gerechtigkeit von Ephedrya nachempfunden. Zumindest waren sie damals berühmt, als sie noch als Galgen fungierten. Heute erinnert sich niemand mehr daran, und das süße Aroma von Leichen, die öffentlich zur Schau gestellt werden, ist dem Duft der Tollkirsche gewichen. Da die Blätter dieser Pflanze besonders faulig riechen, macht das allerdings keinen großen Unterschied.');
INSERT INTO "item_descriptions" VALUES(27547,'de','„Viele sagen, Hexen seien grausam und böse. Sie kochen kleine Kinder im Kessel, reißen Schmetterlingen die Flügel aus, rammen tapferen Kriegern Nadeln unter die Fingernägel und treiben Handel mit den Shushus. Ich hingegen bin ganz anders. Zum Beispiel liebe ich Blumen. Oleanderblätter sind eine echte Augenweide. Wenn es nach mir ginge, wären sie in allen Ziergärten zu finden.“

- Belladonna, die unheilvolle Hexe von Ephedrya');
INSERT INTO "item_descriptions" VALUES(27548,'de','„Ein gesichtsloser Gott hat bestimmt, dass wir uns dem Lauf der Zeit unterwerfen sollen. Die Sanduhr unserer Existenz läuft nach und nach ab. Letztendlich bleibt nichts mehr übrig außer ein paar Körnern Bitterkeit im Ozean des Nichts. Welch unerträgliche Verschwendung.“

- Belladonna, die unheilvolle Hexe von Ephedrya');
INSERT INTO "item_descriptions" VALUES(27549,'de','„Die Welt der Zwölf ist schön – nicht trotz all ihres Leids, sondern gerade deswegen. Ohne Schmerzen gäbe es keine Freude, und ohne Einsamkeit keine Zärtlichkeit. So ist es. Und so ist es gut.“

- Belladonna, die unheilvolle Hexe von Ephedrya');
INSERT INTO "item_descriptions" VALUES(27551,'de','Auch wenn dieser Helm dich wie einen Bösewicht aussehen lässt, so ist er dennoch das Vorrecht großer Helden, deren epische Taten echte Monster vor Angst erzittern lassen.');
INSERT INTO "item_descriptions" VALUES(27552,'de','Wenn ein Speerschmied stirbt, wird er mit einem Teil seiner Ausrüstung um sich herum bestattet, damit diese ihn im Tod begleiten. Der Umhang, der die Wunden seiner Schlachten trägt, dient ihm als Leichentuch und bezeugt sein heldenhaftes Leben.');
INSERT INTO "item_descriptions" VALUES(27553,'de','Auch wenn man dies vielleicht nicht vermuten würde, lässt dieses Wehrgehänge aus Metall sich nach Belieben anpassen, um einem jeden Träger gut zu passen. Vergessen wir nicht, dass alle Leichen schön sind und dass es auch eine würdige Heldensage ist, sich in allen vier Himmelsrichtungen der Welt den Bauch vollzuschlagen.');
INSERT INTO "item_descriptions" VALUES(27554,'de','Die Tradition schreibt vor, dass ein Speerschmied – zu Lebzeiten oder nach seinem Tod – gewisse Gegenstände einem Freund, einem Waffenbruder oder einem Familienmitglied vermachen darf. Leider passiert es bei Fußbedeckungen oft, dass die Größe nicht passt und außerdem ein gewisser durchdringender Käsegeruch erhalten bleibt ... Dennoch ist dies für die Erben eine große Ehre.');
INSERT INTO "item_descriptions" VALUES(27555,'de','Die Handschuhe der Speerschmiede haben große symbolische Bedeutung, da sie die Hände schützen, welche wiederum das Symbol dafür sind, dass die Speerschmiede ihr Schicksal am Schopf packen und die Welt nach ihren Vorstellungen gestalten, ob nun im Krieg oder im Handwerk.');
INSERT INTO "item_descriptions" VALUES(27644,'de','Dieser Bogen gehörte einst einer legendären Kriegerin, deren besondere Fähigkeit darin lag, die Automaten und andere Woboter-Monstew aufzuspüren. Es heißt, Sylargh selbst wurde durch einen einzigen Pfeil der Bogenschützin mit flammender Haarpracht verwundet und besiegt. Seit diesem Tag hätte er Schwierigkeiten, sich hinzusetzen.

„Es geht nicht um die ferne Hoffnung, eine neue Welt zu erschaffen ... Es geht darum, jene zu bewahren, die wir haben.“
- Die rothaarige Jägerin');
INSERT INTO "item_descriptions" VALUES(27645,'de','Ein Besen, den ihr im Sägewerk gefunden habt und der genutzt wird, um die Holzspäne zu beseitigen, die überall auf dem Boden liegen.');
INSERT INTO "item_descriptions" VALUES(27803,'de','Bei diesem Tannenzapfen handelt es sich um ein echtes Drachenei. Wirklich! Das hat euch ein Goblin erzählt!
...
Euch kann man ja wirklich alles erzählen.
...
Aber gut, im Zweifelsfall sollte man dieses Objekt gut bewachen. Man weiß ja nie.');
INSERT INTO "item_descriptions" VALUES(29024,'de','Diese Waffe wurde von einem Handwerker erfunden, dem es in den Ohren gesummt hat. Sie ist sehr effektiv gegen Moskitos und im Allgemeinen gegen alle, die eine Ohrfeige verdient haben.');
INSERT INTO "item_descriptions" VALUES(29110,'de','Das Menologion würde früher von Solar getragen. Es bietet nicht nur Schutz in höchster Bedrängnis, sondern ermöglicht auch die Regulierung des Kreislaufs der Jahreszeiten, was sich als unverzichtbar gegen Klimastörungen, Zeitanomalien und zeitfressende Larven erweisen könnte. Ah, und zusätzlich ist es die beste Möglichkeit, um sich gegen die Hammerschläge gereizter Beschützer zu schützen.');
INSERT INTO "item_descriptions" VALUES(29133,'de','Wenn man einer Naturgewalt entgegentreten will, die von einer Macht der Eliokalypse verderbt ist, dann ist ein göttlicher Segen ebenso wichtig wie Karamellsauce auf Vanillepudding: und zwar absolut unverzichtbar.');
INSERT INTO "item_descriptions" VALUES(29134,'de','Dieser Dofus wurde vor langer Zeit aus einem Versprechen geboren, als die Jahreszeiten noch nicht den Rhythmus im Tanz der Welt vorgaben. Könnt ihr es halten?');
INSERT INTO "item_descriptions" VALUES(29135,'de','Um einen Unsterblichen vom Befall der Verderbnis zu heilen, gibt es nichts Besseres als die Macht einer Göttin, gebunden an die Kraft eines Dofus, in den Händen eines Eier sammelnden Abenteurers.');
INSERT INTO "item_descriptions" VALUES(29136,'de','Die Frucht des Opfers sät die Samen der Erneuerung. Schmerzhafte Metamorphose, natürliche Heilung oder einfach das Fortschreiten der Zeit – das Ende des ewigen Winters ist immer ein Wunder.');
INSERT INTO "item_descriptions" VALUES(1029430,'de','In einer alten Legende, die von Historikern des dritten Zeitalters erzählt wird, heißt es, dass die Mamukils einst vier Stoßzähne hatten. Ein Märchen, ersponnen für jene, die nicht einmal bis zwei zählen können, oder Realität? Überlassen wir es den Gelehrten in den Arenen des Kolosseum, heftig darüber zu debattieren.');
INSERT INTO "item_descriptions" VALUES(1029431,'de','Nachdem er an der Spitze seiner Truppen einen Fluss durchquert hatte, schlug der Große Lexander den König Sporo und stahl ihm seine Kolifanten. Diese gewaltigen Tiere waren deutlich intelligenter als Dracotruter und litten überdies nicht an dem Auswärtsschielen der letzteren. Mit diesen Kriegsreittieren zog Lexander aus, um die Welt der Zehn zu erobern! Leider sollte es dazu nicht kommen. Er wurde nur drei Jahre später von einem schweren Fieber dahingerafft. Auch wenn man sie mit bloßem Auge nicht erkennt, können kleine und gemeine Keime ebenso gefährlich sein wie ein Kolifant.');
INSERT INTO "item_descriptions" VALUES(1029432,'de','Der Pelz, der den Körper der Kolifanten von Tarkago bedeckt, ist nicht natürlich gewachsen. Tatsächlich handelt es sich um eine dicke, maßgeschneiderte Weste. Dieser haarige Harnisch wurde auf Befehl von Kanigal gefertigt, einem brillanten Taktiker alter Zeiten. Zu jener Zeit wollte der General mit seiner Armee einen Gebirgszug überqueren. Seine riesigen Rüsseltiere hatten einen sicheren Schritt, doch sie waren besonders kälteempfindlich. Also fand Kanigal ein Mittel, das es ihm ermöglichte, seine Gegner wortwörtlich niederzutrampeln. Wenn es darum geht, eine Schlacht zu gewinnen, kennt sein militärisches Genie keine Grenzen.');
INSERT INTO "item_descriptions" VALUES(1029433,'de','In den Tavernen von Madrestam erzählt man sich, dass ein gigantischer Zenusha mit einer Insel auf seinem Rücken durch die Meere streift. Seine Beine sind dermaßen lang, dass er nicht schwimmen muss. Er tastet mit seinem Rüssel über den Grund des Meeres. Wonach sucht er? Die Krone des Piratenkönigs? Eine versunkene Truhe? Aber dieser Kolifant müsste schon ungeheures Glück haben, um einen versteckten Schatz inmitten der Wellen zu finden.');
INSERT INTO "item_descriptions" VALUES(1029434,'de','Dieses flinke Reptil wurde von den Aufklärern, die an der Grenze der Sümpfe patrouillieren, adoptiert. Es ist wilder als ein Crocodyll mit rasenden Zahnschmerzen. Unerschütterlich und verschlagen stürzt es sich furchtlos in den Kampf ... doch es kann ebenso blitzartig verschwinden, um die Sache in einem günstigen Augenblick zu Ende zu bringen.');
INSERT INTO "item_descriptions" VALUES(1029435,'de','Fällt es euch schwer, die Initiative zu ergreifen? Klettert auf den Rücken dieser imposanten Schlange, um euch durchzusetzen! Und sorgt euch nicht, dass ihr langsamer vorankommt: Die Kobrasch ist der lebende Beweis, dass eine stylische Frisur wichtiger ist als Beine.');
INSERT INTO "item_descriptions" VALUES(1029456,'de','Ein außergewöhnlicher Vogel sagte einst: „Um in Gedankenschnelle an jeden existierenden Ort zu fliegen, musst du zuerst davon überzeugt sein, dass du bereits am Ziel angekommen bist.“ Spirituelle Worte, die sich nicht mit dem Gewicht von Konventionen oder Verboten aufhalten. Vielleicht ist das der Grund, warum ihr euch auf eurer Möhve leicht wie eine Feder fühlt.');
INSERT INTO "item_descriptions" VALUES(29463,'de','Dieser Schild wird häufig von Bonta-Soldaten getragen. Seht euch doch nur die fein gearbeiteten Verzierungen, das hochwertige Holz, die perfekte Wölbung, den ... Ach nein, das ist ja nur ein täuschend echtes Imitat. Der Handwerker, der diesen Schild hergestellt hat, muss wohl Jembers Segen gehabt haben.');
INSERT INTO "item_descriptions" VALUES(30356,'de','Dank dieses Dofus, verliehen von den Wächtern von Ankama, könnt ihr „Ich war da!“ sagen, ohne den Stich der Nostalgie zu verspüren. Treffen wir uns in 20 Jahren wieder?');
CREATE TABLE item_drops (item INTEGER, monster_ankama_id INTEGER, rate REAL, conditions TEXT);
