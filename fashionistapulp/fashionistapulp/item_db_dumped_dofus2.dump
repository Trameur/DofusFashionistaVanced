INSERT INTO "item_descriptions" VALUES(13757,'es','Con este trofeo podrás demostrar que la fuerza no falta en tu familia.');
INSERT INTO "item_descriptions" VALUES(13758,'es','Con este trofeo podrás demostrar que la fuerza no falta en tu familia.');
