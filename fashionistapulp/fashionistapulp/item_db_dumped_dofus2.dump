INSERT INTO "item_descriptions" VALUES(13763,'de','Diese Trophäe ist so mächtig, dass sie alles ausgleichen kann, außer vielleicht die Zauber...');
INSERT INTO "item_descriptions" VALUES(13764,'de','Diese Trophäe ist so mächtig, dass sie alles ausgleichen kann, außer vielleicht die Zauber...');
INSERT INTO "item_descriptions" VALUES(13765,'de','Diese Trophäe ist so mächtig, dass sie alles ausgleichen kann, außer vielleicht die Zauber...');
INSERT INTO "item_descriptions" VALUES(13766,'de','Ein äußerst inspirierter Handwerker gravierte Folgendes auf die Trophäe: "Lieber Arm dran, als Arm ab"');
INSERT INTO "item_descriptions" VALUES(13767,'de','Ein äußerst inspirierter Handwerker gravierte Folgendes auf die Trophäe: "Lieber Arm dran, als Arm ab"');
INSERT INTO "item_descriptions" VALUES(13768,'de','Ein äußerst inspirierter Handwerker gravierte Folgendes auf die Trophäe: "Lieber Arm dran, als Arm ab"');
INSERT INTO "item_descriptions" VALUES(13769,'de','Diese Trophäe macht euch zu einem besseren Menschen... Sie beschützt euch vor den heimtückischsten Schlägen, verhindert jedoch, dass ihr brutal zurückschlagt.');
INSERT INTO "item_descriptions" VALUES(13770,'de','Diese Trophäe macht euch zu einem besseren Menschen... Sie beschützt euch vor den heimtückischsten Schlägen, verhindert jedoch, dass ihr brutal zurückschlagt.');
INSERT INTO "item_descriptions" VALUES(13771,'de','Diese Trophäe macht euch zu einem besseren Menschen... Sie beschützt euch vor den heimtückischsten Schlägen, verhindert jedoch, dass ihr brutal zurückschlagt.');
INSERT INTO "item_descriptions" VALUES(13772,'de','Mit dieser Trophäe bleibt ihr stets fest mit beiden Beinen auf der Erde. Solltet ihr jedoch ein fliegendes Reittier benutzen, bezahlt ihr dies mit unerträglichen Schmerzen.');
INSERT INTO "item_descriptions" VALUES(13773,'de','Mit dieser Trophäe bleibt ihr stets fest mit beiden Beinen auf der Erde. Solltet ihr jedoch die Fliege machen wollen, bezahlt ihr das mit unerträglichen Schmerzen.');
INSERT INTO "item_descriptions" VALUES(13774,'de','Mit dieser Trophäe bleibt ihr stets fest mit beiden Beinen auf der Erde. Solltet ihr jedoch ein fliegendes Reittier benutzen, bezahlt ihr dies mit unerträglichen Schmerzen.');
INSERT INTO "item_descriptions" VALUES(13775,'de','Schmubfem oder Pandrista? Diese Trophäe wird euch die Entscheidung nicht erleichtern!');
INSERT INTO "item_descriptions" VALUES(13776,'de','Schmubfem oder Pandrista? Diese Trophäe wird euch die Entscheidung nicht erleichtern!');
INSERT INTO "item_descriptions" VALUES(13777,'de','Schmubfem oder Pandrista? Diese Trophäe wird euch die Entscheidung nicht erleichtern!');
INSERT INTO "item_descriptions" VALUES(13778,'de','Dank dieser Trophäe seid ihr Feuer und Flamme.');
INSERT INTO "item_descriptions" VALUES(13779,'de','Dank dieser Trophäe seid ihr Feuer und Flamme.');
INSERT INTO "item_descriptions" VALUES(13780,'de','Dank dieser Trophäe seid ihr Feuer und Flamme.');
INSERT INTO "item_descriptions" VALUES(13781,'de','Viele junge Abenteurer glauben noch immer, von Liebe, Luft und frischem Wasser leben zu können...');
INSERT INTO "item_descriptions" VALUES(13782,'de','Viele junge Abenteurer glauben noch immer, von Liebe, Luft und frischem Wasser leben zu können...');
INSERT INTO "item_descriptions" VALUES(13783,'de','Viele junge Abenteurer glauben noch immer, von Liebe, Luft und frischem Wasser leben zu können...');
INSERT INTO "item_descriptions" VALUES(13784,'de','Man sagt dieser Trophäe nach, dass sie ihren Besitzer förmlich dazu zwingt, andere in der Luft zu zerreißen. Da bleibt euch die Luft weg, was?!');
INSERT INTO "item_descriptions" VALUES(13785,'de','Man sagt dieser Trophäe nach, dass sie ihren Besitzer förmlich dazu zwingt, andere in der Luft zu zerreißen. Da bleibt euch die Luft weg, was?!');
INSERT INTO "item_descriptions" VALUES(13786,'de','Man sagt dieser Trophäe nach, dass sie ihren Besitzer förmlich dazu zwingt, andere in der Luft zu zerreißen. Da bleibt euch die Luft weg, was?!');
INSERT INTO "item_descriptions" VALUES(13787,'de','Mit dieser Trophäe können nicht nur den vor der Hausarbeit flüchtenden Ehemännern Fussfesseln angelegt werden, sondern auch den völlig entfesselten Ehefrauen.
Endlich mal eine Trophäe für Jedermann!');
INSERT INTO "item_descriptions" VALUES(13788,'de','Mit dieser Trophäe können nicht nur den vor der Hausarbeit flüchtenden Ehemännern Fussfesseln angelegt werden, sondern auch den völlig entfesselten Ehefrauen.
Endlich mal eine Trophäe für Jedermann!');
INSERT INTO "item_descriptions" VALUES(13789,'de','Mit dieser Trophäe können nicht nur den vor der Hausarbeit flüchtenden Ehemännern Fussfesseln angelegt werden, sondern auch den völlig entfesselten Ehefrauen.
Endlich mal eine Trophäe für Jedermann!');
INSERT INTO "item_descriptions" VALUES(13790,'de','Eure Mitspieler werden jedes Mal schwach, wenn ihr mal wieder das Ziel verwechselt... Abschreckend für die einen, amüsant für die anderen.');
INSERT INTO "item_descriptions" VALUES(13791,'de','Eure Mitspieler werden jedes Mal schwach, wenn ihr mal wieder das Ziel verwechselt... Abschreckend für die einen, amüsant für die anderen.');
INSERT INTO "item_descriptions" VALUES(13792,'de','Eure Mitspieler werden jedes Mal schwach, wenn ihr mal wieder das Ziel verwechselt... Abschreckend für die einen, amüsant für die anderen.');
INSERT INTO "item_descriptions" VALUES(13793,'de','Diese Trophäe gibt in regelmäßigen Abständen kleine Blitzschläge ab, die dafür sorgen, dass sich eure Muskeln zusammenziehen.
Das ist genau das Richtige, um bei langen Familienessen nicht einzuschlafen.');
INSERT INTO "item_descriptions" VALUES(13794,'de','Diese Trophäe gibt in regelmäßigen Abständen kleine Blitzschläge ab, die dafür sorgen, dass sich eure Muskeln zusammenziehen.
Das ist genau das Richtige, um bei langen Familienessen nicht einzuschlafen.');
