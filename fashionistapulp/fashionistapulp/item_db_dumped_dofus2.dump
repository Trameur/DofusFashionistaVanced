INSERT INTO "item_descriptions" VALUES(13751,'es','Este trofeo no es responsable de la fuga de cerebros...');
INSERT INTO "item_descriptions" VALUES(13752,'es','Este trofeo no es responsable de la fuga de cerebros...');
INSERT INTO "item_descriptions" VALUES(13753,'es','Este trofeo no es responsable de la fuga de cerebros...');
INSERT INTO "item_descriptions" VALUES(13754,'es','Con este trofeo podrás jugar a los médicos con tus aliados y hasta con tus enemigos si el combate te resulta muy fácil.');
INSERT INTO "item_descriptions" VALUES(13755,'es','Con este trofeo podrás jugar a los médicos con tus aliados y hasta con tus enemigos si el combate te resulta muy fácil.');
