INSERT INTO "item_descriptions" VALUES(8230,'de','Diese Schuhe sind perfekt dazu geeignet, kleine, kriechende Kreaturen zu zertreten, die zwischen den Grashalmen herumkriechen. Aber passt auf, dass ihr nicht versehentlich Xéloren oder Eniripsas dabei erwischt.');
INSERT INTO "item_descriptions" VALUES(8231,'de','Nur wenn ihr klein genug seid, wird dieser Umhang aus zusammenbefestigten Tofufedern ausreichen, euer Hinterteil zu verbergen. Es ist zwar nur ein bescheidener Schutz, doch wird er viel dazu beitragen, die Aufmerksamkeit der anderen von euren fettigen Haaren oder dicken Warzen abzulenken');
INSERT INTO "item_descriptions" VALUES(8232,'de','Nur wenn ihr klein genug seid, wird dieser Umhang aus zusammenbefestigten Tofufedern ausreichen, euer Hinterteil zu verbergen. Es ist zwar nur ein bescheidener Schutz, doch wird er viel dazu beitragen, die Aufmerksamkeit der anderen von euren fettigen Haaren oder dicken Warzen abzulenken');
