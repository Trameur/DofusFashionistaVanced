INSERT INTO "item_descriptions" VALUES(7076,'pt','Este bravo escudo já viu batalhas demais. Neste estado, não serve mais para nada. Talvez o Buwada, no vilarejo de Pandala, possa trocá-lo para você.');
INSERT INTO "item_descriptions" VALUES(7077,'pt','Este escudo amarelo, poroso, porém absorvente, foi feito com os restos de uma criatura que costumava viver em uma Mascaxi no fundo do mar.');
INSERT INTO "item_descriptions" VALUES(7078,'pt','Este bravo escudo já viu batalhas demais. Neste estado, não serve mais para nada. Talvez o Buwada, no vilarejo de Pandala, possa trocá-lo para você.');
