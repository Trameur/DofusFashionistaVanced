INSERT INTO "item_descriptions" VALUES(13808,'es','Gracias a este trofeo no te tragará la tierra pero puede que te dé un aire.');
INSERT INTO "item_descriptions" VALUES(13809,'es','Gracias a este trofeo no te tragará la tierra pero puede que te dé un aire.');
INSERT INTO "item_descriptions" VALUES(13810,'es','Gracias a este trofeo no te tragará la tierra pero puede que te dé un aire.');
INSERT INTO "item_descriptions" VALUES(13811,'es','Debido a este trofeo no podrás tomar decisiones en combate aunque esto, a veces, hará que te veas con el agua al cuello.');
