INSERT INTO "item_descriptions" VALUES(8235,'pt','Se você for pequeno, esta capa feita de penas de Piu esconderá o seu traseiro. É uma proteção modesta, mas tem a vantagem de desviar os olhares dos passantes desse seu cabelo oleoso ou das suas verrugas gigantes.');
INSERT INTO "item_descriptions" VALUES(8236,'pt','Se você for pequeno, esta capa feita de penas de Piu esconderá o seu traseiro. É uma proteção modesta, mas tem a vantagem de desviar os olhares dos passantes desse seu cabelo oleoso ou das suas verrugas gigantes.');
INSERT INTO "item_descriptions" VALUES(8237,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um Javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8238,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um Javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8239,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um Javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8240,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um Javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8241,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um Javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8242,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um Javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8243,'pt','Com este chapéu, você ficará ridículo, mas também terrivelmente irresistível. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8244,'pt','Com este chapéu, você ficará ridículo, mas também terrivelmente irresistível. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8245,'pt','Com este chapéu, você ficará ridículo, mas também terrivelmente irresistível. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8246,'pt','Com este chapéu, você ficará ridículo, mas também terrivelmente irresistível. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8247,'pt','Com este chapéu, você ficará ridículo, mas também terrivelmente irresistível. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8248,'pt','Com este chapéu, você ficará ridículo, mas também terrivelmente irresistível. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8253,'pt','Este amuleto é normalmente confundido com uma sacola de brinquedos de sorte, quando, na verdade, é algo para você acertar como um alvo para tiro.');
INSERT INTO "item_descriptions" VALUES(8254,'pt','Oferecer uma aliança significa duas coisas: "Eu te amo" e "Vá lavar a louça". Perfeito para quem odeia repetir sempre a mesma coisa.');
INSERT INTO "item_descriptions" VALUES(8255,'pt','Muitos aventureiros iniciantes deverão se lembrar desta terrível e poderosa arma contra os montes de terra. Depois de encharcada, ela se torna leve e pode ser rolada e geralmente exige duas pessoas para isso.');
INSERT INTO "item_descriptions" VALUES(8256,'pt','Com estas botas, um Eniripsa pode caminhar sobre a água, algo bem inútil, já que eles podem voar, e isto sempre atrai a multidão. Outros podem sempre usar estas botas para arranhar os pés, enquanto caminham ou simplesmente os lavam.');
INSERT INTO "item_descriptions" VALUES(8257,'pt','Este cinto possibilitou que Vald tomasse o seu banho sem arriscar a vida. De fato, nenhum Iop aprendeu com sucesso a nadar.');
INSERT INTO "item_descriptions" VALUES(8258,'pt','Esta capa é perfeita para camuflagem em um ambiente natural, porém, só se ninguém o ver.');
INSERT INTO "item_descriptions" VALUES(8259,'pt','Nestas instruções, pode ser lido: “Ofereço este capacete ao seu marido. Junto à cabeça dele e arrastado pelos pés em sua cozinha. Você sabia que tem um chão claro e limpo”. É um resumo da concepção nova e moderna de como um casal deve ser e de como deve compartilhar as tarefas domésticas.');
INSERT INTO "item_descriptions" VALUES(8260,'pt','Esta bandana fará Iops parecerem mais belos do que nunca!');
INSERT INTO "item_descriptions" VALUES(8262,'pt','O Moolet contém uma estranha substância achada nas vísceras de um Moolobo. Alguns dizem que é a essência do monstro, mas outros dizem que é apenas alguns Kirball que ele comeu.');
INSERT INTO "item_descriptions" VALUES(8263,'pt','Tenha cuidado! Este anel fará o seu dedo feder. Um cheiro que pode encobrir outro e isso pode ser uma ótima coisa para você e seu círculo...');
INSERT INTO "item_descriptions" VALUES(8264,'pt','Estas botas ainda são movidas pelo apetite voraz do Mulobo. Se seus pés cheirarem a queijo, elas, provavelmente, os morderão.');
INSERT INTO "item_descriptions" VALUES(8265,'pt','O Mulobo tem um belo rabo longo e fofo, que se arrasta pelo chão. Cheios de inveja, alguns aventureiros o arrancaram e, agora, eles o usam na esperança de ficar mais viris.');
INSERT INTO "item_descriptions" VALUES(8266,'pt','Este cinto colorido tem um maravilhoso tufo de pêlos púrpura na frente e, se usá-lo ao contrário, você poderá passar por um Wabbit.');
INSERT INTO "item_descriptions" VALUES(8267,'pt','Enquanto desmembrava o Moolobo, caçadores descobriram que ele só tem um grande chifre cruzando seu crânio. Mas isto não parece aborrecer os Iops que orgulhosamente o usam.');
INSERT INTO "item_descriptions" VALUES(8268,'pt','Este colar protegeu o Minotoro de pegar pulgas, carrapatos e até mesmo piolhos. Pelo que parece, você realmente precisou disso.');
INSERT INTO "item_descriptions" VALUES(8269,'pt','Ao contrário do que alguns aventureiros possam pensar, este anel nunca foi usado pelo Minotoror, que era incapaz de pôr tal anel em seus cascos.');
INSERT INTO "item_descriptions" VALUES(8270,'pt','Esta pulseira protege completamente o braço de um Eniripsa, mas triplica o seu peso.');
INSERT INTO "item_descriptions" VALUES(8271,'pt','Este anel feito de couro e marfim torna fácil para você estimular seus companheiros.');
INSERT INTO "item_descriptions" VALUES(8272,'pt','Este colar protege as vértebras cervicais do Minotot dos socos letais do Wabbit.');
INSERT INTO "item_descriptions" VALUES(8273,'pt','Este colar tem uma pequena fivela, na qual o dono do Dragão-Porco podia prender uma corrente, a fim de levá-lo para um passeio noturno.');
INSERT INTO "item_descriptions" VALUES(8274,'pt','Este machado realmente decapitou um dos Minotoros mais perigosos da província de Amakna. O mais inacreditável nesta história é que você parece completamente indiferente a ela.');
INSERT INTO "item_descriptions" VALUES(8275,'pt','Este cetro, com uma cabeça de serpente feita de pedras preciosas em sua extremidade, lhe permite amedrontar jovens aventureiros e chutar seus traseiros rosados.');
INSERT INTO "item_descriptions" VALUES(8276,'pt','Estas terríveis botas feitas de couro e pêlo de Minotoror são, obviamente, muito pesadas para fazer você ganhar a lendária corrida da Baía de Amakna. Entretanto, elas permitirão que você esmague os pés dos outros competidores na linha de partida.');
INSERT INTO "item_descriptions" VALUES(8277,'pt','Estas incríveis sandálias lhe permitirão tomar banho nas águas mais perigosas sem o risco de machucar seus pés. Entretanto, tenha cuidado, dizem que elas arranham o fundo de banheiras.');
INSERT INTO "item_descriptions" VALUES(8278,'pt','Um bom par de chinelos e você se sentirá bem mais forte, mais poderoso e até mesmo mais eficiente de alguma maneira. Ainda que eles sejam apenas chinelos!');
INSERT INTO "item_descriptions" VALUES(8279,'pt','Pegue um Minotoror, amarre-o com firmeza, pegue uma plaina gigante e esfole suas costas de uma vez só. Pronto! Agora você tem uma capa do Minotoror.');
INSERT INTO "item_descriptions" VALUES(8280,'pt','Esta é a capa perfeita para sair ou para praticar seu poder de sedução no baile de máscaras do Capitão Chafer.');
INSERT INTO "item_descriptions" VALUES(8281,'pt','Este manto não o tornará um Leitão, mas lhe permitirá vestir-se bem por uma noite, então, você poderá seduzir uma bela porca.');
INSERT INTO "item_descriptions" VALUES(8282,'pt','Este cinto flexível pode ser usado para chicotear o traseiro de crianças teimosas. Sua fivela poderia até marcar a pele delas, mas isso apenas as ensinaria uma lição de uma vez por todas.');
INSERT INTO "item_descriptions" VALUES(8283,'pt','O Minotot usou este forte cinto para conter a sua enorme pança, prevenindo-o de tombar toda vez que havia uma corrente de ar.');
INSERT INTO "item_descriptions" VALUES(8284,'pt','Este capacete passou de geração em geração na família Minotot. Isto explica parcialmente o motivo de cheirar a caspas em decomposição.');
INSERT INTO "item_descriptions" VALUES(8285,'pt','Com este enorme crânio, você parecerá um Grizbola de pêlo áspero eriçado, mas sem pêlos. Seus admiradores ficarão mudos.');
INSERT INTO "item_descriptions" VALUES(8286,'pt','De acordo com a lenda, esta capa coberta por escamas o protegerá de raios, feijões e, acima de tudo, das mulheres fatais....');
INSERT INTO "item_descriptions" VALUES(8287,'pt','Um anjinho como você poderia facilmente passar por um guerreiro impiedoso com tal capacete horripilante e desproporcional. Uma vez pregado a uma parede, será um cabideiro.');
INSERT INTO "item_descriptions" VALUES(8288,'pt','Dizem os espíritos mais pervertidos de Amakna que este cinto pode servir de prótese. Ninguém entende por quê. E felizmente não é verdade, é só um cinto de Dragovo qualquer.');
INSERT INTO "item_descriptions" VALUES(8289,'pt','Este anel, esculpido diretamente em uma escama gigante de Dragovo, protegerá uma pequena parte da sua falange. Provavelmente, o mais importante.');
INSERT INTO "item_descriptions" VALUES(8290,'pt','Feito de escamas de Dragovos, este amuleto protegerá eficazmente o seu pomo-de-adão ou suas amídalas. Ele fará toda a diferença em um campo de batalha.');
INSERT INTO "item_descriptions" VALUES(8291,'pt','Estas botas são perfeitas para matar Papatudo durante uma partida de Papabol ou fazer seus inimigos sofrerem um pouco mais durante as sessões de espancamento.');
INSERT INTO "item_descriptions" VALUES(8292,'pt','Tão afiada quanto uma navalha, esta lâmina lhe permitirá se barbear de manhã, mas somente as axilas.');
INSERT INTO "item_descriptions" VALUES(8293,'pt','Este machado racha crânios tão facilmente quanto faria com uma manteiga.');
INSERT INTO "item_descriptions" VALUES(8294,'pt','Mais pesado que um crânio vazio de Munchor, porém menos sólido que um fêmur de Kirbola das cavernas, este martelo, ainda assim, é uma arma bastante perigosa.');
INSERT INTO "item_descriptions" VALUES(8295,'pt','Este arco é tão poderoso que pode mandar ovos podres de Dragovo por cima da grande muralha de Brakmar. Que desperdício maravilhoso!');
INSERT INTO "item_descriptions" VALUES(8296,'pt','Esta varinha mágica parece ser muito mais eficiente quando usada como um cacetete ou como um Mata-Moskitos!');
INSERT INTO "item_descriptions" VALUES(8297,'pt','Em uma de suas extremidades, este bastão possui uma grande ponta e ninguém sabe de onde ela veio. Entretanto, alguns aventureiros bem informados sabem para onde ela deveria ir...');
INSERT INTO "item_descriptions" VALUES(8298,'pt','Shika costumava ajudar Farle a colher pegando as orelhas mágicas que caiam sob a foice dele. Ela costumava fazer um colar das orelhas. Apesar de estarem desprovidas de suas raízes e do resto de seu caule, estas orelhas mágicas continuavam a florescer a cada ano no mesmo período.');
INSERT INTO "item_descriptions" VALUES(8299,'pt','Este bracelete cobria os braços de Shika. Desta maneira, ele protegia Shika de queimaduras do sol e de bicadas de Corvocs, que eram atraídos pela sua beleza estonteante. Os braceletes ainda estão impregnados com o doce suor dela.');
INSERT INTO "item_descriptions" VALUES(8300,'pt','Esta enxada feita sob medida permitia que Shika criasse os montes de feno mais altos de todo o reino. Reza a lenda que eles eram tão grandes que os marinheiros os usavam como marcas para saber se estavam se aproximando ou não da costa de Amakna.');
INSERT INTO "item_descriptions" VALUES(8301,'pt','Estes tamancos foram criados para Shika para que ela não pisasse no solo arado quando semeava as planícies de Snossios. Ela acrescentou saltos altos nos tamancos para facilitar a corrida no restolho sem machucar seus tornozelos ou que o orvalho molhasse seus tamancos.');
INSERT INTO "item_descriptions" VALUES(8302,'pt','Flores dos tempos de colheita foram costuradas nesta capa feita de cereais mágicos. Guiada por tal mágica poderosa, Shika usou a capa como proteção contra raios durante noites tempestuosas.');
INSERT INTO "item_descriptions" VALUES(8303,'pt','Este cinto feito de couro protegia as coxas de Shika quando ela atravessava os campos de trigo correndo para trazer de volta os Papatudos desgarrados de seu rebanho. Coberto de pólen de cereais mágicos, a lenda diz que o cinto brilhava nas noites de luar e não deixava que Farle cortasse as pernas de sua esposa enquanto faziam a colheita nos campos de cereais.');
INSERT INTO "item_descriptions" VALUES(8304,'pt','Coberto com uma grande quantidade de flores, este chapéu fez Shika parecer feliz e resplandecente quando ela saáa ao nascer do sol para lavrar as Colinas da Igreja.');
INSERT INTO "item_descriptions" VALUES(8330,'pt','Este pequeno chapéu permite ao Draguendrop atacar os inimigos sem correr o risco de sair com um galo. Ele foi usado por muito tempo nas maiores construções de Amakna. Tornou-se bastante popular depois que os Mulobos vindos da Montanha de Kruup invadiram Astrub. Essa história não tem lógica, mas e daí?');
INSERT INTO "item_descriptions" VALUES(8331,'pt','Com este chapéu, você ficará charmoso e atraente. Dizem até que você conseguirá conquistar um Astrubiano!');
INSERT INTO "item_descriptions" VALUES(8333,'pt','Esta misteriosa capa apareceu durante as temporadas frias e permite que impostores finjam ser velhos extremamente generosos.');
INSERT INTO "item_descriptions" VALUES(8334,'pt','Este chapéu permitirá que você esconda as cicatrizes em sua cabeça. Dessa forma, as crianças gostarão mais de você.');
INSERT INTO "item_descriptions" VALUES(8338,'pt','Esta espada estranha não o tornará invencível, mas pode ser usada para fatiar bolas de neve.');
INSERT INTO "item_descriptions" VALUES(8341,'pt','Estas botas tem cheiro de suco de abacaxi misturado com meias molhadas. A grande sacada é que quando você visitar seus amigos, eles nunca vão lhe pedir para tirar os sapatos.');
INSERT INTO "item_descriptions" VALUES(8366,'pt','Esta capa costumava pertencer a um famoso capão, um pássaro de penas longas que adorava pavonear em frente ao zaap de Bonta para todo o seu séquito de aves ingênuas e galinhas imaturas.');
INSERT INTO "item_descriptions" VALUES(8414,'pt','Estas adagas são ideais para cortar pontinha de ovo de Dragovo cozido. Além disso, elas são tão leves que dá para sair correndo rapidinho do resto da comunidade dos Dragovos.');
INSERT INTO "item_descriptions" VALUES(8417,'pt','Esta pequena pá foi dada de presente a um jovem Enutrof. Ele gostou tanto dela que continuou usando-a até morrer.');
INSERT INTO "item_descriptions" VALUES(8419,'pt','O capitão Machab destripou o grande Kralove Branco, conhecido como Grobill Dick, com esta pá.');
INSERT INTO "item_descriptions" VALUES(8420,'pt','Os Dragovos gostam de cavar túneis mas eles não usam pás. A comunidade Enutrof estudou e tentou responder este enigma, mas concluiu que era menos importante saber de onde isto veio do que usá-lo para bater em outra pessoa.');
INSERT INTO "item_descriptions" VALUES(8441,'pt','Bill queria uma auréola. Ele berrou tão alto, ficou com raiva e finalmente conseguiu. Um verdadeiro diabinho.');
INSERT INTO "item_descriptions" VALUES(8442,'pt','Brouce Boulgoure usou esta máscara para se infiltrar em uma guarida de ratos de Esgoto para cortar um olmo pelas raízes. Ele acabou matando todos os ratos da guarida já que ele não era tão discreto com seus tamancos de madeira.');
INSERT INTO "item_descriptions" VALUES(8443,'pt','Esta capa pode ser feita com qualquer tipo de pêlo, contanto que eles sejam os mais sujos possíveis. Eles são trançados juntos e, então, fixados graças a várias secreções. O cheiro não é uma opção.');
INSERT INTO "item_descriptions" VALUES(8444,'pt','Tão afiadas quanto danificadas, as lâminas destas adagas permitirão fatiar os membros dos seus inimigos com uma facilidade desconcertante. E tenha certeza que você levará uma quantidade impressionante de tiras de carne. Pena que elas não são enferrujadas, envenenadas nem incandescentes quando você precisar usá-las.');
INSERT INTO "item_descriptions" VALUES(8445,'pt','O rato que possuiu este colar pensou que se tornaria o chefe do seu clã. Ele foi devorado por um furioso Lenald.');
INSERT INTO "item_descriptions" VALUES(8446,'pt','Tenha cuidado ao colocar estas botas!! Ainda pode haver um pé ou dois do dono anterior dentro delas...');
INSERT INTO "item_descriptions" VALUES(8447,'pt','Diferentemente de seu primo bontariano, o Rato Negro é discreto e usa um cinto de tecido simples. Mas ele também gosta de carregar muitas armas e isso faz um barulho terrível a cada passo que dá.');
INSERT INTO "item_descriptions" VALUES(8448,'pt','Dizem que o próprio Rato Negro coçava as costas com as garras afiadas desta luva. Mas cuidado: é possível que ainda tenha pelos presos nela, e o cheiro pode não ser dos melhores. Fica até a dúvida se ele usava para coçar só as costas...');
INSERT INTO "item_descriptions" VALUES(8450,'pt','Esta arma é o símbolo do Rato Branco. Sabe-se que sua capacidade de cortar em fatias tanto inimigos como aliados com facilidade é a mesma.');
INSERT INTO "item_descriptions" VALUES(8451,'pt','Com este chapéu, o Rato Branco fica parecendo um verdadeiro mosqueteiro de Bonta. Sem, ele parece só um Rato Branco de Bonta sem chapéu.');
INSERT INTO "item_descriptions" VALUES(8452,'pt','Esta capa é o símbolo que identifica o rato branco da rede de esgoto de Bonta. É a recompensa que o rato recebe depois de uma prova longa e difícil, e ele a porta com orgulho até a morte... ou seja, nunca por muito tempo.');
INSERT INTO "item_descriptions" VALUES(8453,'pt','Se você usar como colar, ele o protegerá das emissões tóxicas dos esgotos. Mas, usando como um cinto, ele protegerá seus aliados das suas emissões tóxicas.');
INSERT INTO "item_descriptions" VALUES(8454,'pt','Esta luva pertencia a Julia Dilch, cozinheira do palácio de Bonta. Ela a usava para enfrentar os Papatudos que se recusavam a ter suas gargantas cortadas, as plantas selvagens que não queriam entrar na tigela de salada e os clientes que não queriam comer. Tudo isso com muita classe, claro, para não sujar as mãos.');
INSERT INTO "item_descriptions" VALUES(8455,'pt','Ao contrário do que o seu primo brakmariano pensa, o Rato Branco também sabe ser discreto. É por isso que este cinto é tão leve e discreto: para compensar o corpo bem chamativo.');
INSERT INTO "item_descriptions" VALUES(8456,'pt','Com estas botas, o seu equilíbrio será perfeito... até mesmo durante uma tempestade de vento.');
INSERT INTO "item_descriptions" VALUES(8457,'pt','Este chapéu não tem nada a ver com um Dora... Absolutamente nada! É inútil espalhar falsos rumores sobre o seu criador ser frouxo ou sem inspiração!!! Este chapéu tem uma bela aparência.');
INSERT INTO "item_descriptions" VALUES(8458,'pt','Esta capa colorida o transforma em um alvo ideal. Só aventureiros rápidos e espertos podem usá-la por muito tempo.');
INSERT INTO "item_descriptions" VALUES(8459,'pt','Este colar é posto em torno do pescoço do Senhor dos Ratos assim que ele nasce, para prevenir o roubo. Assim, quando ele se torna adulto, a única maneira de tirar o colar é decapitando-o. Bem, de alguma maneira, o colar ainda é roubado!');
INSERT INTO "item_descriptions" VALUES(8460,'pt','Este anel foi projetado no período em que o Senhor dos Ratos só possuía um dedo, depois de mutilar todos os outros. Os desafortunados senhores seguintes possuíam todos os dedos.');
INSERT INTO "item_descriptions" VALUES(8461,'pt','Os desenhos neste cinto realmente dão a impressão de que você está com fogo nos fundilhos. O efeito engana tão bem que quase todo mundo que o veste realmente acredita que está pegando fogo e sai gritando. Por incrível que pareça, isso corresponde exatamente ao ritual da cerimônia.');
INSERT INTO "item_descriptions" VALUES(8462,'pt','O primeiro Senhor dos Ratos morreu ao se intrometer em uma piscina de lava derretida. Para prestar tributo a ele, seus senhores usavam estas botas. Tenha cuidado, elas não são à prova de fogo.');
INSERT INTO "item_descriptions" VALUES(8463,'pt','Os cogumelos incrementados neste capacete espalham um bom odor estimulante que faz você querer pegar raízes. Eles também são bastante gostosos, mas podem mandá-lo para um caixão.');
INSERT INTO "item_descriptions" VALUES(8464,'pt','No verão, o Arvraknídeo Ancestral gosta de pegar sol, mas como sua madeira é acostumada a florestas escuras, ele não fica muito tempo. Esta capa é feita de sua casca descascada.');
INSERT INTO "item_descriptions" VALUES(8465,'pt','Ao redor de seu pescoço, este torque destacará sua barba. Se você não tiver barba, bem, a culpa é sua.');
INSERT INTO "item_descriptions" VALUES(8466,'pt','Nas noites em que beber demais, talvez você veja o Moskito embutido neste anel piscar para você. Mas não conte pra ninguém, ele vai estar só fingindo.');
INSERT INTO "item_descriptions" VALUES(8467,'pt','Com estes protetores de canela de madeira, suas pernas estarão altamente protegidas. Entretanto, você não pode usar botas com eles. Você pode usá-los quando estiver participando das competições de Papabol, eles o protegerão. Mas será difícil para você chutar a bola sem suas botas.');
INSERT INTO "item_descriptions" VALUES(8468,'pt','Este cinto deveria lhe dar a virilidade ancestral. Se isso era verdade ou não, o efeito expirou.');
INSERT INTO "item_descriptions" VALUES(8469,'pt','Este pedaço de madeira extraído bem do interior do Carvalho Mole encerra um grande poder, como o de enfurecer o Carvalho Mole.');
INSERT INTO "item_descriptions" VALUES(8470,'pt','Este anel é de fezes de Carvalho Mole, em madeira, mas o cheiro permanece o mesmo.');
INSERT INTO "item_descriptions" VALUES(8471,'pt','Aos domingos, o Carvalho Mole tira um cochilo e, quando acorda, gosta que algum Trunknid obediente traga seus calçados de couro sem perguntas. Infelizmente, ele não tem nenhum pé, então eles ainda estão novinhos em folha.');
INSERT INTO "item_descriptions" VALUES(8472,'pt','Há 200 anos, alguns tecidos ficaram enfiados nos galhos de Carvalho Mole. Conforme as árvores cresciam, ficaram impregnando o tecido com a sua mágica. Este tecido agora é uma parte integrante deste grande pedaço de madeira e o torna difícil de manusear e inflamável; seu poder não pode ser negado.');
INSERT INTO "item_descriptions" VALUES(8473,'pt','No outono, o Carvalho Mole veste seu fio-dental para proteger suas preciosas bolotas. No verão, ele gosta de ficar nu.');
INSERT INTO "item_descriptions" VALUES(8474,'pt','Você pode usar este chapéu de todas as formas possíveis, ele ainda vai parecer estar de lado.');
INSERT INTO "item_descriptions" VALUES(8513,'pt','Coletar "pedaços" de criaturas com o bisturi de Bworknroll lhe assegurará um bom trabalho, já que ele preserva a vitalidade dos membros arrancados.');
INSERT INTO "item_descriptions" VALUES(8521,'pt','A capa vermelha é o artefato favorito dos megalomaníacos. Uma vez em seus delicados ombros, eles acreditam que são o Super-Homem ou um mágico ultrapoderoso, até que encontram um Minotoror.');
INSERT INTO "item_descriptions" VALUES(8527,'pt','Estas botas feitas de pele de Duende foram criadas por Planbworksek para carregar o inimigo (se possível pelas costas) extremamente depressa. Com estas botas, ele salvou muitos companheiros Bwork em dificuldade.');
INSERT INTO "item_descriptions" VALUES(8530,'pt','Este chapéu mantém suas orelhas quentes e absorve o álcool do seu bafo. O que mais você pode pedir?');
INSERT INTO "item_descriptions" VALUES(8533,'pt','O Flud não é realmente um chapéu, e sim um parasita que se desenvolve na cabeça de pessoas muito volúveis, barulhentas ou verbalmente agressivas. Seu aspecto asqueroso faz as pessoas fugirem, obrigando seu portador a gritar ainda mais alto para ser ouvido, o que é inútil, já que ele não tem nada a dizer mesmo.');
INSERT INTO "item_descriptions" VALUES(8534,'pt','Esta capa acolchoada absorve todos os barulhos ao seu redor, obrigando seu portador a gritar o tempo todo.');
INSERT INTO "item_descriptions" VALUES(8535,'pt','Estas getas são tão leves que fazem seu proprietário correr e saltar por todos os lados quando um combate se inicia. Aventureiros experientes simplesmente odeiam estas getas, pois elas permitem que qualquer entre em um combate sem ser convidado.');
INSERT INTO "item_descriptions" VALUES(8536,'pt','Este cinto é tão apertado que ele força seu usuário a gaguejar, tremer e fazer idiotices enquanto estiver sendo usado.');
INSERT INTO "item_descriptions" VALUES(8537,'pt','Normalmente, este pequeno anel não serve para nada, mas, como é muito chamativo, pode até servir para mostrar às pessoas que você existe.');
INSERT INTO "item_descriptions" VALUES(8538,'pt','Após várias noites de trabalho duro para criar este amuleto, o maior joalheiro de Astrub, famoso por ter sido criado por Bworks, exclamou diante de uma multidão impressionada: "Esse amu aki eh d+". Nem mesmo o ilustre historiador Champo Lyon conseguiu decifrar o discurso do joalheiro.');
INSERT INTO "item_descriptions" VALUES(8561,'pt','Este adorável bebê Pandawa vai adorar acompanhá-lo por aí para descobrir o mundo com seus olhões.');
INSERT INTO "item_descriptions" VALUES(8569,'pt','Este gorro pertencia a uma pequena Xelor que tirava proveito da passagem do tempo. A lenda diz que ela roubava vários dias dos habitantes de Amakna e tinha de distribuir alguns doces para compensar esta pequena trapaça.');
INSERT INTO "item_descriptions" VALUES(8575,'pt','Um famoso guerreiro Feca que viveu na selva de Pandala costumava dizer: ‘Para ganhar a guerra, você tem que ser a guerra''.');
INSERT INTO "item_descriptions" VALUES(8596,'pt','Esta espada afiada ficou com essa cor púrpura elegante depois de estripar milhares de Bworks. Antes, sua lâmina era só violeta escuro.');
INSERT INTO "item_descriptions" VALUES(8598,'pt','Estas lâminas têm buracos por toda a parte fazendo um belo barulho de assovio quando manuseada rapidamente. Os buracos também são úteis para tirar as entranhas de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(8599,'pt','Estas adagas foram forjadas por uma Ecaflipmanicure. Ele não gostava de espadas pesadas que não se adaptavam perfeitamente às unhas pintadas.');
INSERT INTO "item_descriptions" VALUES(8604,'pt','Esta espada brilhante é perfeita para aparar flores, mesmo se elas se defenderem. Pode até mesmo cortar árvores.');
INSERT INTO "item_descriptions" VALUES(8605,'pt','Esta lâmina foi lubrificada para entrar no estojo mais facilmente. Entretanto, não pode ser limpada após uso e deve ser jogada fora, especialmente se coberta de sangue. Leve em consideração que o uso principal é protegê-lo.');
INSERT INTO "item_descriptions" VALUES(8607,'pt','É um grande cajado com pregos. Não espere por nada além de um simples cajado, ele arranca os dentes de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(8608,'pt','Rumores dizem que um Sadida chamado Fraye costumava usar este bastão para proteger sua esposa e filho de um rebanho de Papatudos irados. Que pena que ele também confundiu sua família com os monstros durante a luta.');
INSERT INTO "item_descriptions" VALUES(8609,'pt','Este arco é leve, delicado, elegante e tem cheiro de flores de cerejeira. Mas se você abusar, pode também ser letal.');
INSERT INTO "item_descriptions" VALUES(8610,'pt','Se você mantiver este arco para cima e dizer alegremente "Pampulilu!", parecerá absolutamente ridículo.');
INSERT INTO "item_descriptions" VALUES(8611,'pt','Esta varinha pertence ao famoso Lemita, que faz um excelente café, mas vive sendo descartado pelos amigos.');
INSERT INTO "item_descriptions" VALUES(8612,'pt','Com o Bidjiz, você permanecerá vivo provavelmente devido aos seus oponentes começarem a dançar quando eles verem a bola de disco no final desta varinha.');
INSERT INTO "item_descriptions" VALUES(8613,'pt','Criado como uma obra-prima de um ferreiro mágico, estas pás são muito ruins para escavar, exceto quando é a cabeça de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(8614,'pt','Esta pá é uma ótima invenção. Pode escavar um túmulo e ser deixado no topo como uma cruz, desde que só um aventureiro morre por vez.. Ou se você cavar para outros túmulos com suas mãos.');
INSERT INTO "item_descriptions" VALUES(8615,'pt','Este martelo esmaga facilmente crânios para alcançar o cérebro e agora está manchando com uma cor tomate vermelho.');
INSERT INTO "item_descriptions" VALUES(8616,'pt','Este martelo foi criado quando o Rei Stefan costumava reinar e aterrorizar milhões de pessoas.');
INSERT INTO "item_descriptions" VALUES(8617,'pt','Seu animal de estimação, nossa paixão.');
INSERT INTO "item_descriptions" VALUES(8618,'pt','Este estranha machado é criado para decapitar facilmente Bworks. A tranqüilidade com que também pode decapitar habitantes de Astrub indica que há uma ligação entre estes dois povos. Mas ninguém descobriu o que é ainda.');
INSERT INTO "item_descriptions" VALUES(8619,'pt','Graças a este chapéu de guerreiro, os Iops realmente são figuras simpáticas. O único problema é que ele esconde o campo de visão de evita de ouvir as palavras de seus inimigos. Este chapéu é desenvolvido para quem gosta de bater antes de pensar.');
INSERT INTO "item_descriptions" VALUES(8627,'pt','Colega e amigo do famoso Guy-Guy (parente próximo do Carvalho Mole), Sarr Ys é um menestrel cujas melodias encantadoras estão gravadas na memória de Amakna. Infelizmente, este brilhante artista perdeu a vida em um trágico acidente de Quaquá, durante uma bebedeira em uma noite de verão.');
INSERT INTO "item_descriptions" VALUES(8628,'pt','Este capacete dá auto-confiança e temeridade a quem usa. Graças a isso, você sempre manterá pensando que foi na verdade uma proeza. Lembre-se de tirá-lo de vez em quando para não entrar em situações inextricáveis!');
INSERT INTO "item_descriptions" VALUES(8629,'pt','Sempre que um oponente vem para encarar este capacete, ele vira quieto como um túmulo. Ninguém ousa perguntar o que acontece. Mas tudo bem, Srams não são tão sensíveis.');
INSERT INTO "item_descriptions" VALUES(8630,'pt','Este chapéu se parece muito com o Peruka e o Sulik. Mas já que é muito confortável e os Xelores nunca o tiram da cabeça - nem mesmo para dormir, ele costuma ser chamado de chapeleiro de lírio. Ele exala um agradável odor de lírio que ajuda a dormir. No entanto, os roncos provocados por ele são tão insuportáveis quanto o canto dos sapos na época de acasalamento.');
INSERT INTO "item_descriptions" VALUES(8631,'pt','Graças a este chapéu, Eniripsas sempre sabem como lidar com emergências. Assim, todas as dicas de primeiros socorros são discretamente escritas no forro. Ninguém normalmente usa um chapéu ridículo assim mesmo em uma cerimônia escolar!');
INSERT INTO "item_descriptions" VALUES(8632,'pt','Seria de imaginar que esse chapéu teria um belo tom alaranjado. Mas está longe de ser o caso. Além disso, este acessório está mais para máscara que para chapéu... Então por que os criadores o batizaram de Chapéu Ricott? Certamente para fazer o povo comentar!');
INSERT INTO "item_descriptions" VALUES(8633,'pt','As pontas afiadas saem deste gorro não só permitem machucar seu inimigo, mas também aumenta suas chances de ser golpeado na cabeça por um raio durante uma tempestade, Sacriers é a raça que adora machucar os outros tanto quanto eles mesmos. Um belho cheiro de carne grelhada: nada melhor para começar seu dia!');
INSERT INTO "item_descriptions" VALUES(8634,'pt','Graças a este chapéu, você se parecerá com uma besta excitada. Pessoas se aproximarão para admirar o grande par em sua cabeça. Este amplo item também pode manter a comida fresca como feno para Papatudo ou pão para Tofus.');
INSERT INTO "item_descriptions" VALUES(8635,'pt','Este capacete pode fazer o usuário fazer promessas que instantaneamente esquece. É devido à pressão que ele exerce em parte de seu cérebro como a memória ou fala? Ninguém sabe de verdade. O que importa é levar em conta as palavras menos extravagantes.');
INSERT INTO "item_descriptions" VALUES(8636,'pt','Robbie Hood era um famoso Craque viveu nas florestas. Isto explica a cor verde de seu gorro para se camuflar no cenário. Ele queria levar a lei por toda a parte roubando dinheiro dos ricos por uma boa causa: ele mesmo!');
INSERT INTO "item_descriptions" VALUES(8637,'pt','Com este capuz, o Feca aumenta suas chances assim como a de seus aliados. Se seu grupo é guiado por um Feca usando um Capuz da Sorte, você estará realmente seguro para chegar a um lugar quase sem nenhum arranhão. E cheira tão ruim é perfeita para se proteger também.');
INSERT INTO "item_descriptions" VALUES(8638,'pt','Este capuz pode ser usado para se proteger do mau tempo assim como cozinhar bons pratos. O meio que este chapéu se move o bastante para trazer ar e manter o fogo cozinhando a altas temperaturas. E todos sabem, uma sopa é um prato que precisa ser cozinhado por um longo tempo ... agora sabemos o motivo dos Enutrofs terem pulso forte.');
INSERT INTO "item_descriptions" VALUES(8639,'pt','A capa flutuante é essencial para dar uma aura de guerreiro, especialmente se virar as costas para um inimigo. Alguns pensam que é reforçada por uma lâmina de metal capaz de afastar ataques astutos.');
INSERT INTO "item_descriptions" VALUES(8640,'pt','Cortada de um tecido liso e forte, esta capa dá aos Ecaflips a impressão de que são sempre os melhores, não importa o que acontece. Quando eles vencem, adoram usar esta peça de roupa e reivindicar a recompensa: "E agora, dê-me o dinheiro!"');
INSERT INTO "item_descriptions" VALUES(8641,'pt','Esta capa é tão leve e fina que um pequeno vento (de todos os tipos de vendo) pode levá-la... Não é nada, porém tenha cuidado após uma refeição de vegetais e bebidas fermentadas.');
INSERT INTO "item_descriptions" VALUES(8642,'pt','A cor escura desta capa torna fácil separar de outras roupas, ou qualquer outra cor. Já que é uma capa muito ampla, também pode proteger sua cabeça e seu nariz.');
INSERT INTO "item_descriptions" VALUES(8643,'pt','A Capa Sulitis deve ser delicadamente colocada nos ombros do usuário para evitar ter tendinites e endurecimento das juntas. As propriedades curativas desta peça de roupa são invejadas pelos Pandawas quem passam muito tempo carregando inimigos e aliados. Eles adorariam uma peça de roupa também!');
INSERT INTO "item_descriptions" VALUES(8644,'pt','Este item é usado para esconder o problema de peso dos Sadidas. Devido a eles passagem muito do tempo dormindo ao invés de praticar esportes, os personagens desta raça tendem a se tornar gordos. Se as Sadidettes tivessem um suprimento anti-fome perante os olhos dos homens, os Sadidas usariam esta capa para esconder.');
INSERT INTO "item_descriptions" VALUES(8645,'pt','Esta peça de roupa é parte essencial do estilo Sacrier. Eles usam como bandagem para as feridas, para limpar o sangue, para aquecer os pés durante as épocas frias. Não podemos dizer o suficiente - esta raça tem medo de terras geladas!');
INSERT INTO "item_descriptions" VALUES(8646,'pt','Esta capa suave é algumas vezes usada por Osamodettes como um chapéu de abas largas. Osamodas masculinos usam-na como uma capa. Graças ao desenho que decora esta peça de roupa, nesta raça de personagem foi herdada a reputação de franqueza. Assim, eles não podem rir de suas mangas, já que a graça é costurar esta capa!');
INSERT INTO "item_descriptions" VALUES(8647,'pt','Pandawas usam esta capa como proteção ao mau tempo e acessório de dança. Eles colocam no chão, no meio do círculo das dançarinas. Então, começam uma coreografia improvisada enquanto seus pés não tocam o chão já que a área é limitada por uma peça de roupa.');
INSERT INTO "item_descriptions" VALUES(8648,'pt','Esta capa leva o nome do Cra original que tinha um senso particular de direção. Ele podia se perder dentro de sua própria casa, mesmo que não fosse grande! Seu maior problema foi que ele tinha uma deformação nas funções cerebrais. Assim, para todos os lugares que ele olhava pareciam iguais: uma praia vasta, ao redor de palmeiras, banhado pela luz do sol.');
INSERT INTO "item_descriptions" VALUES(8649,'pt','As cores quentes e suaves desta capa conduzem quem a usa por uma viagem imaginária, em regiões ensolaradas, repletas de desfiladeiros criados pela erosão, cenários rupestres talhados nas rochas e precipícios. É extremamente útil para esquecer dias frios, cinzentos e chuvosos.');
INSERT INTO "item_descriptions" VALUES(8650,'pt','Enutrofs têm o hábito de desenhar um mapa em sua capa. Eles vivem em uma bagunça que dificilmente podem encontrar banheiros e isto é um problema, especialmente quando deve responder a um chamado urgente da natureza.');
INSERT INTO "item_descriptions" VALUES(8651,'pt','Este belo cinto adiciona o prestígio da aparência dos Iops. Alguns dizem que a cruz no centro pode se tornar uma arma separável quando suas espadas não estão dentro de alcance. Obviamente é uma lenda. Só Srams são enganadores o bastante para estas práticas.');
INSERT INTO "item_descriptions" VALUES(8652,'pt','Quando um Ecaflip está entediado, ele normalmente leva suas cartas no cinto e começa a jogar solitária. Na luta, ele também pode usar as cartas como projéteis. Ele tira uma carta tão rápido quanto uma sombra, e sempre tem tempo para um joguinho!');
INSERT INTO "item_descriptions" VALUES(8653,'pt','O nome deste cinto vem do barulho que ele faz. Os ossos decorativos deste cinto, evitam os Srams, mesmo que invisíveis, de serem notados. Então, você pode facilmente ouvir um diálogo: "Surpreendente alguém usar o Cinto Clinkin? Você tem esperança!"');
INSERT INTO "item_descriptions" VALUES(8654,'pt','O tique-taque incessante do sistema de relojoaria deste cinto impede que os Xelores peguem no sono quando os combates são muito demorados. É altamente recomendável que você tire este cinto antes de ir dormir.');
INSERT INTO "item_descriptions" VALUES(8655,'pt','Embora acostumado a choradeira, este cinto permite a você carregar materiais médicos. As várias poções úteis para curar dor de garganta e infecções gerais são cuidadosamente dispostas. Assim, quando Eniripsas têm dor de garganta, eles não podem conjurar devidamente seus feitiços. E quando estão sem voz ... bem, são tão úteis quanto uma jaqueta de lã durante o calor.');
INSERT INTO "item_descriptions" VALUES(8656,'pt','As razões que levaram os designers deste acessório fashion a colocar uma cabeça de boneca perto da virilha são desconhecidas.
Muitas teorias ''tem sido propostas, mas todos sabem que é uma história já de conhecimento geral!');
INSERT INTO "item_descriptions" VALUES(8657,'pt','Guerreiros de uma tribo antiga famosa pela paixão pelo sangue, os Pados não poderiam ser os primeiros fiéis da deusa Sacrier. Embaixo desta aparência inofensiva, este cinto é um instrumento sofisticado real de tortura.');
INSERT INTO "item_descriptions" VALUES(8658,'pt','Osamodas são conhecidos por serem impulsivos. Eles tendem a serem mais sensíveis. As numerosas fivelas deste cinto são o significado de ajudar, então diminua sua espontaneidade. "Antes de liberar sua fúria e seus olhos expelirem sangue, toque todos os espinhos deste fantástico Cinto Diezzle!"');
INSERT INTO "item_descriptions" VALUES(8659,'pt','Este cinto ajuda Pandawas a ficar de pé (ou quase) quando estão eufóricos, na maior parte do tempo. Nestes momentos, eles tendem a se sentir como presos ao chão embora a gravidade não tenha qualquer ligação com isso. A gravidade é uma forma de manter ocupados os cientistas fazendo experiências com maçãs.');
INSERT INTO "item_descriptions" VALUES(8660,'pt','Este cinto permite a você segurar roupas largas (não se assuste com a sensibilidade das almas) e também oferece um alvo para aprendizes de Cras. Assim, eles aprenderáo a atirar direto no centro, mas nunca abaixo do cinto.');
INSERT INTO "item_descriptions" VALUES(8661,'pt','Precavidos, os Fecas mantêm seus suprimentos de sobrevivência em uma pequena sacola, que contém praticamente só pão de de pedra de Smagabola. É por isso que esta comida dura tanto tempo. O cinto prende bem a sacola em volta da cintura, pois a queda dela ainda é causa de muitos ferimentos graves, seja por negligência ou não.');
INSERT INTO "item_descriptions" VALUES(8662,'pt','Este cinto é um acessório de moda muito útil para os Enutrofs machos. Graças ao mapa que vem costurado nele, eles podem esconder certos acidentes de percurso quando se perdem a caminho do banheiro.');
INSERT INTO "item_descriptions" VALUES(8663,'pt','Com essas botas, Iops são sempre os primeiros a chegar ao campo de batalha e a começar a vida em um lugar. É de um conhecimento comum que esses personagens dessa raça adoram divertir a multidão com as façanhas de guerreiros. Mas eles nunca levam a sério, pois sua negligência é inversamente proporcional à sua força.');
INSERT INTO "item_descriptions" VALUES(8664,'pt','Dizem que os Sadidas nunca se sentem solitários, já que eles invocam muitas bonecas como companhia. Graças a estes sapatos, você também pode dizer adeus a este sentimento de solidão! Você será capaz de falar com elas, exceto se relatarem seu jogo. Após colocá-los, você se sentirá muito bem, mesmo se estiver envergonhado.');
INSERT INTO "item_descriptions" VALUES(8665,'pt','Impregnada com um produto firmador, estas botas serão perfeitas para suas pernas tortas e lutas contra a natureza morta da complexão Sram. Este creme tem efeitos especiais nas Sramettes, mas parece ser absolutamente inútil em Srams. Poderia ser um problema hormonal?');
INSERT INTO "item_descriptions" VALUES(8666,'pt','Criada por um artista Xelor, estas botas devem permitir pintar mais depressa. E bem, elas conseguem! Entretanto, tendem a distorcer a visão e especialmente o senso de distância. Com estas botas, tudo parece estar mais perto. Aprecidaas pelos Sadidas, as pinturas deste Xelor são feitas de curvas generosas da mulher popular mais gorda.');
INSERT INTO "item_descriptions" VALUES(8667,'pt','Graças a estas botas, você sempre estará protegido de toxinas vindas do chão. Nós nunca suspeitamos de micróbios e outros germes. Alguns bons observadores dizem que estas botas parecem mais um dorminhoco do que botas. Mas bem, é o que os Eniripsas dizem. É devido ao seu pequeno tamanho que elas vêem tudo de um diferente ponto de vista?');
INSERT INTO "item_descriptions" VALUES(8668,'pt','O amor pelas plantas faz os Sadidas usar os únicos sapatos equipados com reconhecimento floral. Graças a este sistema, os usuários evitam esmagar plantas raras. Entretanto, não evita de pisas em vários tipos de excrementos se não olhar por onde anda.');
INSERT INTO "item_descriptions" VALUES(8669,'pt','Diferente das outras raças, Sacriers adoram viver com um espinho no pé e não gostam de retirar. A dor que sentem lembra que estão vivos e dá energia para massacrar os inimigos. Além disso, o sangue deixado para trás permite que eles nunca se percam. Eles sempre conseguem refazer o caminho de ida, o que não seria possível com sapatos de má qualidade.');
INSERT INTO "item_descriptions" VALUES(8670,'pt','Com estes sapatos, Osamodas podem marchar por amplos continentes, incluindo os mais remotos. Além disso, nós não sabemos qual o uso principal. Alguns dizem que pode ser usada para fazer ninhos de Tofu ou belos vasos para tirar vantagem das flores selvagens. Mas não é bem convincente. De qualquer forma, Botas Wana são os sapatos principais.');
INSERT INTO "item_descriptions" VALUES(8677,'pt','Este magnífico Toelho é a mascote favorita do famoso Mestre Black Jack. Não se deixe enganar pelas aparências, ele pode ser um guerreiro implacável.');
INSERT INTO "item_descriptions" VALUES(8693,'pt','Graças a esta mascote, todos os indivíduos do sexo oposto vão passar a olhar você com outros olhos. Um conselho: não conte com os ovos antes da galinha. Você logo perceberá que seu(ua) amado(a) está apenas hipnotizado(a) por Feanor. Não espere tirar uma casquinha: agora, seu(ua) pretendente come Pesk cru e se esfrega nas suas pernas... Não é lá o suprassumo do glamour, não concorda?');
INSERT INTO "item_descriptions" VALUES(8695,'pt','Como Brice disse: "Tamanho não importa, só a forma que você lida com ele".');
INSERT INTO "item_descriptions" VALUES(8698,'pt','Fruto do amor de Khelebragon pela sacerdotiza Prometeia, este Dofus é um concentrado de nostalgia. É melhor não contemplá-lo durante muito tempo, senão pode acabar se debulhando em lágrimas... O que certamente prejudicaria a sua reputação de aventureiro com coração de pedra.');
INSERT INTO "item_descriptions" VALUES(8699,'pt','Com esse chapéu, você sempre terá uma aparência como se tivesse levantado da cama naquele instante, mesmo se passar horas penteado seu cabelo. Alguém notou que o cabelo tipo casca do Tynril enrola quando o tempo está úmido, isso demonstra como está a previsão do tempo no mundo. Entretanto, ele teme o fogo. Então, tenha muito cuidado e mantenha-o longe das chamas se não quiser se tornar uma verdadeira tocha humana.');
INSERT INTO "item_descriptions" VALUES(8701,'pt','Esta suntuosa espada costumava pertencer a um famoso ladrão, conhecido por realizar crimes a todo o momento.');
INSERT INTO "item_descriptions" VALUES(8704,'pt','Se você chacoalhar estes dois pequenos sinos, pdoerá ser capaz de jogar uma música.');
INSERT INTO "item_descriptions" VALUES(8713,'pt','Em alguns países, parece que as Getas Bernacle são jogadas nos inimigos para insultar e provocar duelos. Mesmo que isto possa parecer familiar, não é diferente de bater em seu oponente com um par de luvas. A vantagem das Getas Bernacles é a invenção olfativa. Pandawas nunca foram famosos pela higiene dos pés...');
INSERT INTO "item_descriptions" VALUES(8714,'pt','Usar este anel é uma honra. Significa que você tem fé na deusa Cra, a única que sempre revelou como caçar com velocidade e eficiência.');
INSERT INTO "item_descriptions" VALUES(8715,'pt','A tagarelice dos Ecaflips é bem conhecida. Eles podem falar com quase tudo para fazê-lo jogar. Este anel celebra esta tagarelice incansável. Também pode ser usado como dados de reserva!');
INSERT INTO "item_descriptions" VALUES(8716,'pt','As Osamodas adoram o Anel Leão, que complementa seu gingado felino com um toque de graça. De tanto andar com monstros, elas acabam se comportando às vezes como verdadeiras tigresas. Mas, bem no fundo, são tão dedicadas quanto mamães Milobas.');
INSERT INTO "item_descriptions" VALUES(8717,'pt','Fofoqueiros malévolos reivindicam este anel que é um acessório muito útil no mundo. As asas anexadas pode ser uma dor quando você precisa tirar um tecido do bolso. Agora, Iops não tem tecidos e nem bolsos ... então, é ideal. Exceto que atualmente espancam o inimigo a cada vez que passam por perto.');
INSERT INTO "item_descriptions" VALUES(8718,'pt','Fecas usam os mini escudos que estão neste anel como memorandos para escrever cartas de amor ou simplesmente lista de deveres. Esta jóia foi apelidada de escudo anti-esquecimento. Entretanto, não protege você de gaguejar ou sesear.');
INSERT INTO "item_descriptions" VALUES(8719,'pt','Graças a este item, Enutrofs podem se lembrar dos bons tempos quando quiserem. Eles só precisam extrair a pá de dentro. Para fazer a lembrança mais genuína, você precisa adicionar um cheiro específico.... Boa sorte!');
INSERT INTO "item_descriptions" VALUES(8720,'pt','A deusa Eniripsa deu este item para seus fiéis como sinal da união espiritual durante a sessão de iniciação de feitiço de raça. Incidentalmente Eniripsas também pode usá-lo como um bracelete esponja para limpar o langu de seus aliados.');
INSERT INTO "item_descriptions" VALUES(8721,'pt','Esta jóia tende a tornar Pandawas em serem zombadores, especialmente após a terceira cerveja. Eles podem até mesmo ir tão rápido quanto os insultos dos outros. Mas não importa realmente... como diz o provérbio Pandawa "Eufórico não ouve o demônio".');
INSERT INTO "item_descriptions" VALUES(8722,'pt','Esta jóia com uma caveira era tradicionalmente oferecida para todas as crianças Sram para recompensar as traições e golpes abaixo da cintura. As outras raças parecem duvidas desta prática que tende a excitar demais as crianças e transformá-las em verdadeiros diabinhos.');
INSERT INTO "item_descriptions" VALUES(8723,'pt','Este anel é só uma jóia que pode dar tempo e é perfeitamente à prova d''água. Alguns acreditam que se você alargar e modificar os planos deste item, pode transformá-lo em um veículo capaz de se mover embaixo d''água. De onde eles tiram estas idéias?');
INSERT INTO "item_descriptions" VALUES(8724,'pt','Contrário ao rumor, os Sadias não deixam o cabelo cair... Este cabelo foi ajustado em torno deste maravilhoso anel para reforçar seus benefícios. Nunca corte! Graças ao Anel Relva, você será perfeito!');
INSERT INTO "item_descriptions" VALUES(8725,'pt','Se você vê um personagem que não é um Sacrier usando o Anel Ninewonwon, leve-o diretamente para um tratamento intensivo. Assim, esta jóia é extremamente nociva. Em geral, as pessoas perdem a paz de espírito quando encaram a piscina de sangue causada por este anel.');
INSERT INTO "item_descriptions" VALUES(8726,'pt','Estes sapatos permitem ao usuário dançar a noite toda, apesar de bolhas e pedras nos sapatos! Os sapatos dançam o ritmo da noite e faz o pequeno som de  "beep beep" quando estão próximos de minérios preciosos. Por isso os Enutrofs são chamados de "Máquinas Musicais".');
INSERT INTO "item_descriptions" VALUES(8727,'pt','Quando Fecas estão envergonhados e desejam mudar de assunto, eles sempre mencionam as Botas de Ajuda. Eles falam sobre o caminho que pode marcar e todo tipo de terreno ideal para elas. Quando seus aliados estão com problemas no campo de batalha, estas confortáveis botas permitem evitar a ameaça.');
INSERT INTO "item_descriptions" VALUES(8728,'pt','As várias faixas em torno destes sapatos podem ser usadas como cordas caso arrebentem as de seu arco. Jovens Craettes também usam para cozinhar vegetais.  Cheiro dos pés não parece incomodá-las.');
INSERT INTO "item_descriptions" VALUES(8818,'pt','Feito de tecido de Rei Nojoso, esta capa tem pequenos buracos permitindo uma melhor dissipação do calor no caso de esforço excessivo, como durante ataques agressivos no pântano. Mesmo que esta capa deixe a umidade sair, ela mantém o calor. Desta forma, você fica seco, não importa a situação. Que pena que o mau cheiro é tão forte!!!');
INSERT INTO "item_descriptions" VALUES(8819,'pt','Mesmo que esta capa não seja tão poderosa quanto a do Rei Nojoso, ainda tem o mesmo sistema de evacuação de calor. Você será capaz de encarar qualquer situação com esta capa, se puder lutar enquanto prende sua respiração... o fedor é insuportável!!');
INSERT INTO "item_descriptions" VALUES(8820,'pt','Graças a esta máscara, você encarará todos os tipos de perigo, sem medo! Mas é normal já que bloqueia sua visão.');
INSERT INTO "item_descriptions" VALUES(8821,'pt','A distância, este chapéu parece com abajur com dois buracos para os olhos. E de perto... Também.');
INSERT INTO "item_descriptions" VALUES(8822,'pt','Esta máscara não pode evitar nem curar a ressaca, mas pelo menos dá a você a oportunidade de se esconder elegantemente.');
INSERT INTO "item_descriptions" VALUES(8823,'pt','Esta máscara não pode evitar nem curar a ressaca, mas pelo menos dá a você a oportunidade de se esconder elegantemente. O tom sombrio simplesmente indica que você está de mau humor e que não deve ser irritado, pois está pronto para meter o pau no primeiro engraçadinho que aparecer.');
INSERT INTO "item_descriptions" VALUES(8824,'pt','Com este capacete na cabeça, você se parecerá com um Krakol. É claro, vai proteger sua cabeça de pancadas, mas isso lá é motivo para babar desse jeito? Você não precisa disso para se locomover!');
INSERT INTO "item_descriptions" VALUES(8825,'pt','Maior, mais pesado e mais poderoso, esta maça faz um barulho grande quando esmaga os inimigos. Mas curiosamente, é mais leve e tem melhor pegada. No Coralador, nós costumávamos fazer isso, mas não tínhamos uma boa razão!');
INSERT INTO "item_descriptions" VALUES(8826,'pt','Apesar de seu pequeno tamanho a garota Zoth carrega um grande martelo. É a forma de reforçar sua estrutura muscular. Não precisa adicionar pesos para os pulsos e tornozelos para aumentar sua força. Arrastar este martelo já é o bastante!');
INSERT INTO "item_descriptions" VALUES(8827,'pt','O Guerreiro Zoth é usado para carregar dois machados, pois ele não pode ser alcançar o lado esquerdo do inimigo com sua mão direita. É difícil dizer se é um problema na imagem de seu corpo ou ser desajeitado desde o nascimento!');
INSERT INTO "item_descriptions" VALUES(8828,'pt','O Phrango é uma criatura alada e desastrada que tem tanto vigor quanto um tofu desidratado.');
INSERT INTO "item_descriptions" VALUES(8829,'pt','Este chapéu é grande o bastante para esconder a ridícula falta de cabelo da cabeça e da barba de Barbrossa. Mas não cobre cabeças muito grandes.');
INSERT INTO "item_descriptions" VALUES(8833,'pt','Este martelo pegou uma bela cor dos pedaços de Coralador usados para fazê-lo. Diferente do que as pessoas pensam, ele não foi originalmente usado para esmagar Iops ou inimigos. De fato, é um item feito à mão deixado por uma antiga civilização. Foi usado como aldrava, então as pessoas que tinham problemas de audição poderiam entender que alguém estava batendo na porta.');
INSERT INTO "item_descriptions" VALUES(8834,'pt','Este galho foi usado para esfregar algumas partes do corpo antes inacessíveis. Mas não se preocupe, a cor escura é autêntica, não tem nenhuma relação com os vários tipos de resíduos acumulados nas cavidades inacessíveis do Arvorador.');
INSERT INTO "item_descriptions" VALUES(8835,'pt','Este galho foi usado para esfregar algumas partes do corpo antes inacessíveis. Isso talvez explique o cheiro estranho...');
INSERT INTO "item_descriptions" VALUES(8836,'pt','Rotaflores usam seus caules para limpar as orelhas. Entretanto, escultores preferem usá-los como arma. É como dizem: gosto não se discute.');
INSERT INTO "item_descriptions" VALUES(8837,'pt','O Mestre Zoth pode derrotar qualquer um com este bastão. Ele não teme nenhum inimigo! E isso é normal já que ele não pode ver nada com este chapéu! Embora ele é uma técnica de luta muito útil, pode ser um problema durante as refeições. Com uma linha de visão limitada, o Mestre Zoth sempre tem problemas de comer sem se sujar todo...');
INSERT INTO "item_descriptions" VALUES(8838,'pt','Como ervas daninhas, o Tynril pode se multiplicar infinitamente graças um só pedaço de rizoma, após notar que alguns escultores criam um bastão de Tynril. Eles pensaram que podiam de forma fácil e barata vender os melhores licitantes. Mas não funcionou!');
INSERT INTO "item_descriptions" VALUES(8839,'pt','Esta máscara vodu serve principalmente para cobrir o rosto dos Kanibolas que gostam de usar estilingue (como o Eth), mas que sempre erram o alvo... Ainda assim, nunca perdem a esperança de acertar, por isso o uso da cor verde.');
INSERT INTO "item_descriptions" VALUES(8840,'pt','Os Kanibolas Jav gostam de afogar suas mágoas ouvindo blues, por isso pintam suas máscaras de azul. Será que essa tristeza toda está relacionada a uma decepção amorosa, ou teria outro motivo? É difícil saber. Mas seria bom se eles se contentassem em usar a máscara e parassem de choramingar por aí.');
INSERT INTO "item_descriptions" VALUES(8841,'pt','De tanto darem sorrisos amarelos ao errar o alvo, alguns Kanibolas acabaram pintando suas máscaras desta cor. Assim, mesmo quando dão uma risada autêntica, temos a impressão de que estão se forçando.');
INSERT INTO "item_descriptions" VALUES(8842,'pt','Os Kanibolas Arkos só conseguem se concentrar e mirar direito quando estão muito irritados. Assim, para sempre ficarem vermelhos de raiva, acabaram pintando suas máscaras desta cor.');
INSERT INTO "item_descriptions" VALUES(8843,'pt','Com este chapéu, o Crocodyl pensa que ele está muito na moda. Entretanto, se fosse possível, a moda nunca deveria ter sido tão insignificante. É melhor não tentar entender quão ridículo ele é, o Crocodyl é muito sensível...');
INSERT INTO "item_descriptions" VALUES(8844,'pt','Como um capuz real, este capuz tem as mesmas virtudes que a Capa do Rei Nojoso. Tem micro-ventilação para melhorar drenagem do calor e sempre mantém sua cabeça fresca. Infelizmente, também tem os mesmos defeitos que a capa: cheiro nojento que alguém poderia cortá-lo com uma faca.');
INSERT INTO "item_descriptions" VALUES(8845,'pt','Embora seja menos eficiente que um capuz real, ele permite uma boa drenagem do suor. Talvez boa demais, na verdade. Como resultado, esteja você usando ou não, não faz nenhuma diferença.');
INSERT INTO "item_descriptions" VALUES(8846,'pt','O chapéu da garota de Zoth tem uma particularidade estranha para fazer ver coisas em dobro, isso explica o motivo de ela cecear...');
INSERT INTO "item_descriptions" VALUES(8847,'pt','Este capacete tem as mesmas vantagens de outros chapéus Zoth: protege do sol, não importa o quão quente esteja, de pancadas na cabeça e evita o usuário de ver o perigo restringindo seu campo de visão. De qualquer forma, é um capacete perfeito para gurreiros.');
INSERT INTO "item_descriptions" VALUES(8848,'pt','O chapéu do Mestre Zoth tem uma grande vantagem para restringir o campo visual mesmo mais do que outros capacetes. Graças a isso, você pode ter acesso à famosa técnica de luta chamada "doninha". A grosso modo, você só precisa acertar em volta com toda a sua força. Então, você se torna complemente imprevisível e certamente derrotará seus oponentes (ou pelo menos os surpreenderá o bastante para infligir danos com os ataques que acertarem).');
INSERT INTO "item_descriptions" VALUES(8849,'pt','Esta vara é bem popular entre as mulheres-tronco. Entretanto, se você seduz melhor outros tipos de mulhres, também é possível (mesmo que menos eficiente).');
INSERT INTO "item_descriptions" VALUES(8850,'pt','Se você é superticioso e sempre precisa bater na madeira, escolha esta Raiz Floramor! Por outro lado, você também pode tentar ser cuidado, não ver o ramo que está sentando e especialmente não colocar seus dedos no caminho!');
INSERT INTO "item_descriptions" VALUES(8854,'pt','Você diz que um Kraken, com o hálito mais imundo que já se viu, o segue aonde quer que você vá? Bem, lide com isso: é só uma minúscula inconveniência que vem com o chapéu!');
INSERT INTO "item_descriptions" VALUES(8855,'pt','Esse escudo é certamente uma boa proteção. Mas não seja tolo, ele não vai durar muito.');
INSERT INTO "item_descriptions" VALUES(8856,'pt','Quando o Rasgabola pegava borboletas, ele colocava seu cinto Rasgabolar e as eliminava de forma saudável.');
INSERT INTO "item_descriptions" VALUES(8858,'pt','Estas botas criam um disfarça o barulho a cada passo, lembrando uma Trool no cio. Uma dolorosa lembrança de que você podia viver facilmente sem ela.');
INSERT INTO "item_descriptions" VALUES(8859,'pt','Este selo indica que o proprietário é um soberano da Turfeira Sem Fundo da ilha de Otomai. É difícil imaginar um reino mais pastoral...');
INSERT INTO "item_descriptions" VALUES(8860,'pt','Este anel foi tirado do dedo (ainda quente) de um Coralador abatido na hora. A mãe estava esperando-o para o jantar, até que descobriu que seu bebê tinha sido transformado em túmulo.  Até coral tem coração, e nem sempre é de pedra.');
INSERT INTO "item_descriptions" VALUES(8861,'pt','Apenas o Kimbo, com seus pés estranhos, pode se sentir confortável nestas sandálias. Entretanto, elas não é o único que pode se beneficiar de seus podereses. Mas tenha cuidado, não as usa de forma errada!');
INSERT INTO "item_descriptions" VALUES(8862,'pt','Parkinn Pan acreditava de verdade que ele podia voar graças a este cinto enfeitado com asas de Bitufo, mas não sabia que poucos Bitufos podem voar. Sempre que ele saltava da Árvore Hakam se esborrachava no chão. Seu apelo "Queca" veio de "cair plano como uma panqueca".');
INSERT INTO "item_descriptions" VALUES(8863,'pt','Este amuleto é apenas um pedaço de madeira com um pedaço de tecido rasgado. Mas Zoth estão absolutamente convencidos de seus poderosos. Velhos tolos!');
INSERT INTO "item_descriptions" VALUES(8864,'pt','A corda deste arco é feita de baba de Krakol mais ou menos seca. Sua elasticidade sem igual e sua textura viscosa fazem lembrar... bem, não sabemos exatamente o que fazem lembrar, mas certamente não é nada agradável.');
INSERT INTO "item_descriptions" VALUES(8865,'pt','Esculpido em uma carapaça de Krakol, este anel pode resistir a qualquer coisa ou qualquer um.');
INSERT INTO "item_descriptions" VALUES(8866,'pt','Feita de tecidos de Zoth, esta capa tem poderes extraordinários de origem desconhecida.');
INSERT INTO "item_descriptions" VALUES(8867,'pt','Com esta capa, você sentirá uma vontade irresistível de comer molho vinagrete.');
INSERT INTO "item_descriptions" VALUES(8868,'pt','O bico de Phrango nesta arma é absolutamente inútil e pode ser mais um obstáculo do que outra coisa. Felizmente, ela é bem poderosa.');
INSERT INTO "item_descriptions" VALUES(8869,'pt','Estas botas são tão pesadas e deixam seus chutes tão poderosos que deveriam ser consideradas armas letais.');
INSERT INTO "item_descriptions" VALUES(8870,'pt','Esculpido em Arvorador Sombrio, este cinto não é flexível o bastante para deixar você livre para se movimentar, mas pelo menos protege bem.');
INSERT INTO "item_descriptions" VALUES(8871,'pt','Esculpido em um Arvorador Claro, este cinto não te protege bem, mas pelo menos é flexível o bastante para deixá-lo livre para se movimentar.');
INSERT INTO "item_descriptions" VALUES(8872,'pt','Esta jóia não é preciosa, mas tem o tamanho perfeito para dosar a moorgale em uma bela belgroot saborosa com uma dica de Glaviooze.');
INSERT INTO "item_descriptions" VALUES(8873,'pt','Finalmente uma boa desculap para sentir o cheiro do mar!');
INSERT INTO "item_descriptions" VALUES(8874,'pt','Esta jóia algumas vezes tentou roubar um pouco de sua comida quando você estava comendo, então fique mais atento.');
INSERT INTO "item_descriptions" VALUES(8876,'pt','Esta capa estranha parecer ser feita de tinta preta, mas é bem estranha, comporta-se como tecido - não escorre. Parecem manchas, bem, isso não importa. Seu traseiro nunca ficará limpo novamente.');
INSERT INTO "item_descriptions" VALUES(8877,'pt','Uma vez em seu dedo, você não poderá retirá-lo jamais. Essas coisas são o caminho para o poder.');
INSERT INTO "item_descriptions" VALUES(8878,'pt','Este martelo não é útil, não é particularmente bom, não é muito ergonônico e não é poderoso. É tão leve, tão frágil, desbalanceado, brilhante demais e fedido. Mas pelo menos é colorido! Belas cores nunca machucaram ninguém neste mundo cruel!');
INSERT INTO "item_descriptions" VALUES(8879,'pt','Infelizmente, este anel só foi polido por fora: o seu interior é coberto de lascas de pedra afiadíssimas. Ideal para os Sacriers.');
INSERT INTO "item_descriptions" VALUES(8880,'pt','Este colar faz o usuário desejar gritar já que o bigode de Mufafah faz cócegas em seus mamilos.');
INSERT INTO "item_descriptions" VALUES(8881,'pt','Solo era é um inútil, como ele mesmo se descreve. Mas não tenha misericórdia, ele foi enforcado na praça principal da vila após roubar as calcinhas da mulher do chefe. Solo não era um sujeito inteligente, mas não era tão ruim assim...');
INSERT INTO "item_descriptions" VALUES(8918,'pt','Na teoria, este capacete melhorado permite cavalgar mais rápido os Escarafolhas sem você perder sua peruca. Simplesmente inestimável!');
INSERT INTO "item_descriptions" VALUES(8919,'pt','Estas asas de madeira melhoradas foram acolchoadas e deixadas mais leves, além de um tecido de alta qualidade. Mas a estrutura ainda é de madeira e é difícil não quebrar!');
INSERT INTO "item_descriptions" VALUES(8924,'pt','Era uma vez, um homem chamado Rahm se perdeu na floresta. Já ouviu sobre Viet Rham?');
INSERT INTO "item_descriptions" VALUES(8925,'pt','Este estranho arco foi esculpido por uma Sadidette durante um passeio sonâmbulo bastante produtivo. Só de olha, já faz você ficar com sono - serve tanto para o arqueiro quanto para o alvo.');
INSERT INTO "item_descriptions" VALUES(8926,'pt','Estas adagas são perfeitas para puxar bananas e moer café. Alguns até as usam para esmagar maças e peras.');
INSERT INTO "item_descriptions" VALUES(8927,'pt','Há muito tempo lá viveu um louco Sram chamado Gaga... Este sujeito roubou de um pobre para dar a um rico.');
INSERT INTO "item_descriptions" VALUES(8928,'pt','Roink leva mais jeito para beber do que para combater, e isso não melhora com o tempo. Ainda assim, é melhor não se parecer com uma rolha quando saca suas adagas.');
INSERT INTO "item_descriptions" VALUES(8929,'pt','Isto não deve ser engano para o famoso cajado de nome similar. As lâminas neste implemento derramam sangue longe.');
INSERT INTO "item_descriptions" VALUES(8930,'pt','Muitos aventureiros orgulhosos recusaram esta arma por causa da cor. Muitos morreram por esta lâmina.');
INSERT INTO "item_descriptions" VALUES(8931,'pt','Esta espada pertencia a um velho Enutrof megalomaníaco. É feito de ouro maciço, assim como o ego dele.');
INSERT INTO "item_descriptions" VALUES(8932,'pt','Sorria! Diga xis! Perfeito! Foto tirada!');
INSERT INTO "item_descriptions" VALUES(8933,'pt','Ourag''han foi um velho Pandawa com pele tão suave que era conhecido como Slippiderm. Seu odor por outro lado fez com ele ficasse conhecido por outro nome. Ele batizou seu fiel machado da mesma forma.');
INSERT INTO "item_descriptions" VALUES(8934,'pt','Cansado de ter seus grãos de arroz roubados do prato por um esquilo travesso durante suas férias na ilha de Pandala, Bruce Bulgur usou este machado para derrubar cada bambu onde o ladrão tentava se esconder, com o objetivo de capturá-lo. Os Pandawas do vilarejo tiveram que usar a metade do estoque de vinho de bambu para tentar evitar que ele destruísse toda a floresta. Ah, esse Bruce...');
INSERT INTO "item_descriptions" VALUES(8935,'pt','Mesmo como uma jovem Iopette, Mel sonhava em caçar dragões. Com uma pá como espada e uma rocha como dragão, ela afia a pele das costas. A mera menção da pá agora deixa a pobre rocha com convulsões.');
INSERT INTO "item_descriptions" VALUES(8936,'pt','Esta é uma pá selvagem que tentou morder seu dono a cada vez que ele a pegava. Faz sons incomuns quando está feliz e só pode ser pacificada com sons suaves de harmonia.');
INSERT INTO "item_descriptions" VALUES(8937,'pt','Um Enutrof esperto tornou-se um pirata após notar que há mais tesouros para serem encontrados em corpos frescos do que em túmulos podres. Sua pá vermelha de sangue era o símbolo dos marinheiros destas águas com terror.');
INSERT INTO "item_descriptions" VALUES(8941,'pt','Esta espada ensinará a você que mesmo na maior maré de sorte existe um pouco de azar.');
INSERT INTO "item_descriptions" VALUES(8956,'pt','Esta espada ensinará a você que mesmo na maior maré de sorte existe um pouco de azar.');
INSERT INTO "item_descriptions" VALUES(8957,'pt','Esta espada ensinará a você que mesmo na maior maré de sorte existe um pouco de azar.');
INSERT INTO "item_descriptions" VALUES(8958,'pt','Você pediu uma boa arma para a deusa Ecaflip, mas tudo que conseguiu foi esta garra - que nem é tão afiada assim. É, talvez Ecaflip não seja uma deusa de verdade...');
INSERT INTO "item_descriptions" VALUES(8959,'pt','Você pediu uma boa arma para a deusa Ecaflip, mas tudo que conseguiu foi esta garra - que nem é tão afiada assim. É, talvez Ecaflip não seja uma deusa de verdade...');
INSERT INTO "item_descriptions" VALUES(8960,'pt','Você pediu uma boa arma para a deusa Ecaflip, mas tudo que conseguiu foi esta garra - que nem é tão afiada assim. É, talvez Ecaflip não seja uma deusa de verdade...');
INSERT INTO "item_descriptions" VALUES(8961,'pt','Dizem os supersticiosos que pata de Lepowide dá sorte. Graças a esta espada lendária, você poderá impressioná-los. Aliás, a lâmina é extremamente afiada e o talho lembra um pouco o de outra espada que você conheceu.');
INSERT INTO "item_descriptions" VALUES(8962,'pt','Dizem os supersticiosos que pata de Lepowide dá sorte. Graças a esta espada lendária, você poderá impressioná-los. Aliás, a lâmina é extremamente afiada e o talho lembra um pouco o de outra espada que você conheceu.');
INSERT INTO "item_descriptions" VALUES(8963,'pt','Dizem os supersticiosos que pata de Lepowide dá sorte. Graças a esta espada lendária, você poderá impressioná-los. Aliás, a lâmina é extremamente afiada e o talho lembra um pouco o de outra espada que você conheceu.');
INSERT INTO "item_descriptions" VALUES(8964,'pt','"A sorte favore os destemidos", sussurrou os díscipulos de Ecaflip. Agora você está pronto, será capaz de mostrar como joga. Esta espada prestigiosa e pura é extremamente rara.');
INSERT INTO "item_descriptions" VALUES(8965,'pt','"A sorte favore os destemidos", sussurrou os discípulos de Ecaflip. Agora você está pronto, será capaz de mostrar como joga. Esta espada prestigiosa e pura é extremamente rara.');
INSERT INTO "item_descriptions" VALUES(8966,'pt','Esta espada representa a encarnação do deus da sorte Ecaflip. Ter uma dessas prova que você tem muita sorte.');
INSERT INTO "item_descriptions" VALUES(8989,'pt','Com este capacete, você pode ter a esperança de voar se girar na velocidade do som. Já para aterrissar, você terá dificuldades.');
INSERT INTO "item_descriptions" VALUES(8991,'pt','Esse anel frio e viscoso nunca se separará de seu dedo. Se você passar por uma ventania, entretanto, poderá controlar grandes poderes.');
INSERT INTO "item_descriptions" VALUES(8992,'pt','Com essa foice, você pode cortar seu inimigos como se fossem trigo, mas ela também provoca inveja em seus aliados. Esse é o destino dos poderosos...');
INSERT INTO "item_descriptions" VALUES(8993,'pt','Esta espada tem um poder impressionante, os massacres que ela augura são do tipo que aparece nos livros de história. Dizem que também existe uma foice maldita, mas apenas o mais célebre fazendeiro poderia confirmar esta história.');
INSERT INTO "item_descriptions" VALUES(9001,'pt','Este escudo lembrará seus oponentes que você cresceu nas terras de Sidimote. E que sozinho pode ser o bastante para afastá-los.');
INSERT INTO "item_descriptions" VALUES(9002,'pt','Este escudo é coberto com pimenta para permitir a você devastar os olhos dos demônios. Incontrolável.');
INSERT INTO "item_descriptions" VALUES(9003,'pt','O taberneiro da fábrica de cervejas Feubuk em Bonta estava provavelmente bastante entediado quando teve a idéia de equipar seus vigias com escudos publicitários.');
INSERT INTO "item_descriptions" VALUES(9004,'pt','Para afastar o mal ou golpes fortes, este escudo de  Akwadala deve servir.');
INSERT INTO "item_descriptions" VALUES(9005,'pt','Quando seus aliados perderem o fôlego, ou quando você quiser limpar o ar após um vento de pânico inesperado, este escudo pode salvar sua vida. A única coisa que você precisa fazer é movimentar energicamente em todas as direções, como você faz com um bebê faminto.');
INSERT INTO "item_descriptions" VALUES(9006,'pt','Originalmente este escudo foi usado como um banco pelos Sadidas para eles descansarem. Após arregaçar seus pés, ele te protegerá de muitos dos ataques, mas não da explosão de gargalhadas de seus oponentes.');
INSERT INTO "item_descriptions" VALUES(9007,'pt','Esta criação surpreendente é recoberta por uma cueca de couro do Chafer lanceiro, que é fervida, higienizada e esticada para envolver as formas vantajosas e atraentes do escudo, muito diferentes das formas do Chafer.');
INSERT INTO "item_descriptions" VALUES(9008,'pt','Este magnífico escudo contém alguns achados do Mar Mota. Não apenas traz boa sorte, mas também pode ser usado como um frasco.');
INSERT INTO "item_descriptions" VALUES(9009,'pt','Escondido atrás deste escudo, alguns aventureiros ingênuos poderiam te enganar com um Arvraknídeo e fugir gritando. Os ataques serão mais intensos, pensando que podem conseguir âmbar de você.');
INSERT INTO "item_descriptions" VALUES(9010,'pt','Perfeito se você quiser combinar com um Pandala, ou sobressair! A maior vantagem deste escudo consiste nele ser inteiramente coberto com pêlo Pandawa hipoalergênico, então você não precisa enrolar sua cueca e sua armadura em malas separadas quando for viajar nas férias.');
INSERT INTO "item_descriptions" VALUES(9011,'pt','Este escudo especial te protegerá do elemento Fogo, ao mesmo tempo em que informa a hora aos seus inimigos. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(9012,'pt','Este escudo especial te protegerá do elemento Ar, ao mesmo tempo em que informa a hora aos seus inimigos. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(9013,'pt','Este escudo especial te protegerá do elemento Terra, ao mesmo tempo em que informa a hora aos seus inimigos. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(9014,'pt','Este escudo especial te protegerá do elemento Água, ao mesmo tempo em que informa a hora aos seus inimigos. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(9015,'pt','Este escudo costumava proteger lenhadores de árvores em queda. Ele rapidamente mudou. Você pode usá-lo para se proteger de inimigos em queda quem aterrissam sem avisar!');
INSERT INTO "item_descriptions" VALUES(9016,'pt','Esverdeado e fedorento, este escudo permanece a primeira escolha de proteção quando se luta com as criaturas do Monte Kifed.');
INSERT INTO "item_descriptions" VALUES(9017,'pt','Se o seu maior sonho é se tornar um Diabrete, este é o escudo que você precisa. Passado de geração em geração, permitirá que você roube jovens aventureiros de Astrub sem se ferir.');
INSERT INTO "item_descriptions" VALUES(9018,'pt','Um famoso aventureiro passou toda a sua vida procurando as quatro partes deste escudo. Alguns dizem que quando a estiver completo, terá exatamente o efeito oposto de quebrar um espelho.');
INSERT INTO "item_descriptions" VALUES(9019,'pt','Nem todos os Wabbits são criaturinhas bonitas. De fato, todos os Wabbits são criaturas vis. Alguns esmagam Cenouwas com seus grandes escudos e tomam banho no suco.');
INSERT INTO "item_descriptions" VALUES(9020,'pt','Este escudo de pele será perfeito como uma luva. Não se esqueça de tratar suas verrugas e furúnculos de vez em quando para evitar desgastá-la.');
INSERT INTO "item_descriptions" VALUES(9021,'pt','Um jovem aventureiro uma vez sonhou em se juntar à milícia de Bonta para proteger os oprimidos. Considerado moralmente inapropriado para o serviço, ele estava em contato com um alquimista de Amakna que levou vantagem de sua boa natureza, usando-o como cobaia para as suas poções. Você ficará feliz em saber que é uma história que termina... bem, no meio é um pouco feliz. Ele se tornou tão forte que era mais conhecido como Capitão Amakna e este escudo com reputação de indestrutível foi forjado por ele. No fim.. bem, você não vai querer saber o fim.');
INSERT INTO "item_descriptions" VALUES(9022,'pt','Este enorme escudo salvou o famoso aventureiro Klum de uma morte terrível: esmagado pelo peso de um Smagador que estava apaixonado por ele. A lenda não diz se ele sobreviveu aos efeitos colaterais desta história de amor com o Smagador.');
INSERT INTO "item_descriptions" VALUES(9023,'pt','Tão estranho quanto isto pode soar, alguns dizem que este escudo feito de madeira e pêlos, permite aos mais leves aventureiros voar por um breve momento... a última tentativa de surpreender os inimigos deles antes de desfalecerem estupidamente no chão.');
INSERT INTO "item_descriptions" VALUES(9024,'pt','O Tchuke usava este escudo para proteger-se de bolas de canhão aliadas que seus amigos jogavam nele. Algumas histórias loucas dizem que estas bolas estavam vivas.');
INSERT INTO "item_descriptions" VALUES(9025,'pt','Embora inútil, este cheiro espalhará sua fama por toda a parte. Este escuro acompanhou muitos jovens aventureiros em suas primeiras missões - talvez é o motivo de poucos terem chegado aos trinta...');
INSERT INTO "item_descriptions" VALUES(9026,'pt','Este escudo é um tributo à capa do Bowis,que, por sua vez, é um tributo a uma famosa relíquia composta de três fragmentos triangulares. Mais uma história pra boi dormir.');
INSERT INTO "item_descriptions" VALUES(9027,'pt','Esta pedra é na verdade feita da cabeça de um Smagador, esmagada pelo pé de um Minotoror. Uma combinação perfeita de cabeça grande e pés fedorentos!');
INSERT INTO "item_descriptions" VALUES(9028,'pt','O escudo de Terradala deve ajudá-lo a mantê-lo salvo dos golpes fortes.');
INSERT INTO "item_descriptions" VALUES(9029,'pt','Para afastar o mal ou golpes fortes, este escudo de Akwadala deve servir.');
INSERT INTO "item_descriptions" VALUES(9030,'pt','Para afastar o mal ou golpes fortes, este escudo de Ardala deve servir.');
INSERT INTO "item_descriptions" VALUES(9031,'pt','O Mestre Jarbo foi um homem muito poderoso e possuía inúmeras riquezas e mulheres. No entanto, não tinha nenhum mérito, já que tirava todo o seu poder de seu belo anel. Um dia, ele atravessou a rua... e PAF! Desde então, seu anel vem passando de mão em mão entre pessoas pouco escrupulosas.');
INSERT INTO "item_descriptions" VALUES(9117,'pt','Era apenas uma questão de tempo antes de eles começarem a fazer martelos com a cabeça deste idiota.');
INSERT INTO "item_descriptions" VALUES(9122,'pt','Uma vez que você o coloca em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9123,'pt','Uma vez que você o coloca em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9124,'pt','Uma vez que você o coloca em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9125,'pt','Uma vez que você o coloca em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9126,'pt','Kroula tinha um plano.  Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9127,'pt','Kroula tinha um plano.  Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9128,'pt','Kroula tinha um plano.  Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9129,'pt','Kroula tinha um plano.  Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9130,'pt','Esta réplica aproximativa do grande Ugah deve ser usada em volta do pescoço, junto com um olhar sombrio e uma barba bem cuidada.');
INSERT INTO "item_descriptions" VALUES(9131,'pt','Uma jovem Cra chamada Colette perdeu a cabeça no bosque de Litneg. A pobre garota foi atingida pelo machado de Bruce Bulgur, que a confundiu com uma samambaia gigante. Ainda bem que ela morreu, senão teria ficado irada ao descobrir que foi confundida com uma samambaia.');
INSERT INTO "item_descriptions" VALUES(9132,'pt','Seus dedos são jovens demais para entrar em boas casas noturnas? Ficam nervosos perto de garotas? Bem, coloque este anel, ele adicionará alguns anos à sua idade e fará você ter auto-confiança.');
INSERT INTO "item_descriptions" VALUES(9133,'pt','Balance seus dedos diante de quaisquer inimigos que são alérgicos a cogumelos. Deixa a luta mais rápida.');
INSERT INTO "item_descriptions" VALUES(9134,'pt','Este arco foi feito de costelas afiadas, finas e flexíveis que são mais usadas para fazer camas, o que vai fazer seus inimigos dormirem por toda a eternidade.');
INSERT INTO "item_descriptions" VALUES(9135,'pt','Originalmente, bastava soprar bem forte este fungo em formato de trombeta para chamar o menestrel Grobeto Kralos. Quando ele começava a cantar, todos os monstros morriam na hora. Como era uma técnica meio roubada, os deuses bloquearam a trompa e transformaram-na em uma varinha comum.');
INSERT INTO "item_descriptions" VALUES(9136,'pt','Os três pontos deste bastão podem atrair particulas de Plasmogrina presentes na brisa quadramental. Para fazer isso, alinhe-os com os ponteiros de um relógio Xelor invertido, conte até sessenta (experimente até seis se você for um Iop) e aperte suas bochechas. Você terá cinqüenta por cento de chance de fazer um raio.. e transformar seus inimigos em Kirbolas torrados.');
INSERT INTO "item_descriptions" VALUES(9137,'pt','Estas facas foram usadas para lixar os pés de reis e rainhas, aliviando-os de vermes e fungos que pegam no pé de qualquer um.');
INSERT INTO "item_descriptions" VALUES(9138,'pt','As lâminas triplas deste machado têm sido usadas por muitos anos para cortar presunto e queijo três vezes mais rápido que o normal. Se você vir um guerreiro carregando uma, fuja o mais rápido possível... você provavelmente viu um canibal.');
INSERT INTO "item_descriptions" VALUES(9139,'pt','Estas botas são perfeitas para caminhar pelo sub-bosque sem esmagar as folhas mortas. Mas tenha cuidado, suas origens vegetais fazem com que ela acabe esmagando tudo que se parece, de longe ou de perto, com estrume.');
INSERT INTO "item_descriptions" VALUES(9140,'pt','Contrário à errada concepção popular, os buracos nestes sapatos não estão lá para seus pés respirarem, mas para permitir que a desova do fungos dos seus pés escape e infecte os pés de outros aventureiros livres e felizes.');
INSERT INTO "item_descriptions" VALUES(9141,'pt','Se não estivesse tão embolorado, faria uma ótima toalha de mesa. Não se preocupe, você sempre pode secar a louça quando seus convidados não estiver olhando.');
INSERT INTO "item_descriptions" VALUES(9142,'pt','Mais um vidro na estrada? Ah, bem, estradas são longas, e as noites são curtas. Essa capa é normalmente usada para manter os ratos em alerta enquanto concluem seus turnos noturnos infindáveis. Acabarei com todos no final, você sabe.');
INSERT INTO "item_descriptions" VALUES(9143,'pt','Como o nome sugere, esta corrente mata qualquer mosca que estiver perto o bastante de seus doces. Apenas um pequeno conselho: nunca, jamais tente arrancar com seus dentes.');
INSERT INTO "item_descriptions" VALUES(9144,'pt','Como você pode evitar fungos entre na virilha? Bem, certifique de ir para um lugar menos particular... seus quadris! Com este cinto, você não resolverá nada, apenas moverá o problema de lugar.');
INSERT INTO "item_descriptions" VALUES(9145,'pt','Pegue um olmo, retire a casca dele, deixe-a de molho em uma poça, coloque-a no lodo durante vários meses, cubra-a de esporos de cogumelos, coloque-a sob a sua cama durante uma semana, pince-le a com gordura de Blop todas as noites e pronto: agora você tem um cinto fedorento de casca de árvore. Está feliz?');
INSERT INTO "item_descriptions" VALUES(9146,'pt','A etiqueta do cinto diz: "Sentimos muito, mas usar este cinto não é garantia de que você conseguirá reproduzir o rebolado lendário do Ugah". E daí?');
INSERT INTO "item_descriptions" VALUES(9147,'pt','Leve um Dora, cubra-o com cuspe de Papatudo e suor de Iop, deixe-o cozinhar por algumas semanas e você terá uma idéia dos efeitos tóxicos do Cogu Ombrero. Tente de afastar das máquinas pesas enquanto o usa. De fato, fique longe de qualquer coisa pesada.');
INSERT INTO "item_descriptions" VALUES(9148,'pt','Ao invés de parar de tomar suco de Blop impuro, Shika Ingals tomou até ficar eufórica. Um dia, como ela estava cambaleando e caindo nos campos dourados, Shika aterrissou com estas asas. Quem disse que suco de Blop impuro deve ser tomado com moderação?');
INSERT INTO "item_descriptions" VALUES(9149,'pt','Quando Lorkos decidiu entrar no Labirinto do Minotoror, a primeira coisa que ele fez foi colocar seu Amublop. Ninguém nunca descobriu o motivo.');
INSERT INTO "item_descriptions" VALUES(9150,'pt','Este amuleto é muito mais caro que um Amublop clássico, mas veja pelo lado positivo: ele também poderá ser revendido mais caro, principalmente se você passar a perna em um habitante de Astrub.');
INSERT INTO "item_descriptions" VALUES(9151,'pt','Quando Lorkos decidiu entrar no Labirinto do Minotoror, a primeira coisa que ele fez foi colocar seu Amublop. Ninguém nunca descobriu o motivo.');
INSERT INTO "item_descriptions" VALUES(9152,'pt','Quando Lorkos decidiu entrar no Labirinto do Minotoror, a primeira coisa que ele fez foi colocar seu Amublop. Ninguém nunca descobriu o motivo.');
INSERT INTO "item_descriptions" VALUES(9153,'pt','Este amuleto é muito mais caro que um Amublop clássico, mas veja pelo lado positivo: ele também poderá ser revendido mais caro, principalmente se você passar a perna em um habitante de Astrub.');
INSERT INTO "item_descriptions" VALUES(9154,'pt','Este amuleto é muito mais caro que um Amublop clássico, mas veja pelo lado positivo: ele também poderá ser revendido mais caro, principalmente se você passar a perna em um habitante de Astrub.');
INSERT INTO "item_descriptions" VALUES(9155,'pt','Este amuleto é muito mais caro que um Amublop clássico, mas veja pelo lado positivo: ele também poderá ser revendido mais caro, principalmente se você passar a perna em um habitante de Astrub.');
INSERT INTO "item_descriptions" VALUES(9156,'pt','Este amuleto é muito mais caro que um Amublop clássico, mas veja pelo lado positivo: ele também poderá ser revendido mais caro, principalmente se você passar a perna em um habitante de Astrub.');
INSERT INTO "item_descriptions" VALUES(9157,'pt','Sem aditivos nem colorantes, este amuleto seria completamente transparente. Fique tranquilo, ninguém vai te pedir para comê-lo.');
INSERT INTO "item_descriptions" VALUES(9158,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão de suas ''Blotpas... Plobtas... Bolptas'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9159,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão de suas ''Blotpas... Plobtas... Bolptas'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9160,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão de suas ''Blotpas... Plobtas... Bolptas'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9161,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão de suas ''Blotpas... Plobtas... Bolptas'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9162,'pt','Repita a palavra "Bloptas" dezoito vezes o mais rápido possível. Pronto, agora você se parece com um Iop.');
INSERT INTO "item_descriptions" VALUES(9163,'pt','Repita a palavra "Bloptas" dezoito vezes o mais rápido possível. Pronto, agora você se parece com um Iop.');
INSERT INTO "item_descriptions" VALUES(9164,'pt','Repita a palavra "Bloptas" dezoito vezes o mais rápido possível. Pronto, agora você se parece com um Iop.');
INSERT INTO "item_descriptions" VALUES(9165,'pt','Repita a palavra "Bloptas" dezoito vezes o mais rápido possível. Pronto, agora você se parece com um Iop.');
INSERT INTO "item_descriptions" VALUES(9166,'pt','Algumas pessoas deixar a grama crescer sob seus pés. Com estas botas, você terá folhagem bastante para quatro casamentos e um funeral.');
INSERT INTO "item_descriptions" VALUES(9167,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9168,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9169,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9170,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9171,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9172,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9173,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9174,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9175,'pt','Se você apertar este cinto, pode desativar por completo seu sistema digestivo. Por que você iria querer fazer uma cosa dessas é outra história.');
INSERT INTO "item_descriptions" VALUES(9176,'pt','Grobeto Kralos criou sua última e maior música quando estava sendo abatido pelo Bworker e esta lâmina. Era algo assim - ''Eu ouvi as notícias hoje oh cara, dez mil buracos em mimmm...'' Graças aos deuses que o Bworker teve um bom senso para anotar as palavras e a música.');
INSERT INTO "item_descriptions" VALUES(9177,'pt','Os três pontos deste bracelete representam as três maiores fraquezas do Bworker: sede de vingança, sede de vitória e bem, sede por líquidos.');
INSERT INTO "item_descriptions" VALUES(9178,'pt','Este anel é coberto por alguns fragmentos de nariz de shnoz do Bworker. A criatura imunda usa o pontos afiados para conseguir esta picareta perfeita.');
INSERT INTO "item_descriptions" VALUES(9179,'pt','Quando um certo Capitão Chafer encontrou o Bworker pela primeira vez, ele tomou a liberdade de dizer ''Uau, é sua bunda ou sua casa?'' Ninguém viu mais o bom Capitão, ou seu famoso modelo de roupa debaixo. Este amuleto foi criado em sua memória.');
INSERT INTO "item_descriptions" VALUES(9180,'pt','A história diz que o Bworker costurou esta capa com pele do traseiro de Rushu. A história seria plausível se o Bworker soubesse mesmo como costurar.');
INSERT INTO "item_descriptions" VALUES(9181,'pt','Este capacete tem muitos segredos. Já foi uma criatura pura e gentil, mas após muitos anos de violentas aventuras com o Bworker, pouco a pouco se tornou amargo e deformado. Então morreu.');
INSERT INTO "item_descriptions" VALUES(9182,'pt','Há muito tempo atrás, Danous Kwaide tinha uma piada engraça com o Bworker. Danous Kwaide começava. ''Qual a diferença entre suas botas furadas e...''Antes que ele tivesse tempo de terminar, o Bworker furou um buraco na cabeça de Danous.');
INSERT INTO "item_descriptions" VALUES(9183,'pt','Este cinto era usado nos banquetes de ovos Dofus que celebravam o dom dos seis ovos, como lembrado no Biibl, um texto antigo escrito por um bontariano. Muitas pessoas apenas pintam ovos comuns para se parecerem com Dofus e dão às outras, mas algumas vão mais além, usam este cinto doloroso por quarenta dias e noite que precedem a festa.');
INSERT INTO "item_descriptions" VALUES(9186,'pt','Além de seu amor por vasilhas de porcelana, nós conhecemos Flash Gorgone. Uma lenda diz que ele sempre estava com pressa e fugia de um Tofu... Ele aprendeu sua lição quando ele estava na cama uma manhã amarrado em seu cinto pelos tornozelos. Ainda lembro de sua coleção de porcelana como se fosse ontem.');
INSERT INTO "item_descriptions" VALUES(9192,'pt','Quanto maior a gordura em seus quadris, mais atraente você ficará com este cinto.');
INSERT INTO "item_descriptions" VALUES(9193,'pt','Este amuleto lembrará você de dias felizes, dias de pique-nique, os dias antes de você se transformar .... Nisso.');
INSERT INTO "item_descriptions" VALUES(9198,'pt','Se a sua água ou a sua cerveja estiverem sem gosto, basta mergulhar esse anel nela.');
INSERT INTO "item_descriptions" VALUES(9199,'pt','Olhe o que você fez. Só olhe. Tentando esmagar as xícaras de café com suas botas... O que você pensa que está fazendo?');
INSERT INTO "item_descriptions" VALUES(9366,'pt','Este tofu rosa será ideal para colocar nas costas nas festividades de Ano Novo. Feito de algodão ancestral e musse esticado de Sponge Mob, ele é leve e confortável como uma garotinha, este pedaço pode ser o primeiro em uma linha de tutus para uma futura estrela da dança.');
INSERT INTO "item_descriptions" VALUES(9394,'pt','Este chapéu estiloso não só deixará você na última moda fúngica, como também lhe dará um cheiro de sub-bosque capaz de afastar todos os seus amigos.');
INSERT INTO "item_descriptions" VALUES(9395,'pt','Esta Bloporoa foi usada pela Kuri durante muitos anos, até que um dia ela resolveu parar de usar chapéus fora de moda.');
INSERT INTO "item_descriptions" VALUES(9396,'pt','No antigo idioma laposa, ele se intitula "Zewuan Ling", o que significa "o selo maldito dos Zewuan".');
INSERT INTO "item_descriptions" VALUES(9402,'pt','As pequenas asas acopladas a estas pantufas darão a sensação de leveza aos seus pés. Mas tenha cuidado: não os use para jogar Papabol... os Papatudo não gostariam de tomar uma espetada no traseiro.');
INSERT INTO "item_descriptions" VALUES(9408,'pt','Este anel o tornará um Porkasso que agradará seus amigos mais próximos');
INSERT INTO "item_descriptions" VALUES(9409,'pt','Este pequeno rabo em formato de saca-rolhas trará a tona o melhor das pessoas que te cercam');
INSERT INTO "item_descriptions" VALUES(9412,'pt','A fivela deste cinto é extremamente resistente. Tanto que você não será capaz de soltá-la nunca mais. Isso é prova de que você é um verdadeiro xerife!');
INSERT INTO "item_descriptions" VALUES(9413,'pt','As esporas destas botas permitirão que você fatie seu Dragoperu quando decidir comê-lo.');
INSERT INTO "item_descriptions" VALUES(9416,'pt','Se sua água se tornar sem sabor, apenas coloque o seu anel no dedo, seu dedo no copo de água e mexa vigorosamente antes que sua mão seja arrancada. Pronto! Uma deliciosa mistura de laranja-limão e sangue! O seu dedo? Ah...não se pode ter tudo na vida....');
INSERT INTO "item_descriptions" VALUES(9452,'pt','Com este anel, o seu dedo ficará mais radiante do que nunca.');
INSERT INTO "item_descriptions" VALUES(9453,'pt','Com este cinto, ninguém mais vai se atrever a beliscar o seu traseiro por medo de perder os dedos.');
INSERT INTO "item_descriptions" VALUES(9454,'pt','Este amuleto pode ser usado como um babador tanto para crianças como para os velhinhos.');
INSERT INTO "item_descriptions" VALUES(9455,'pt','Você pode usar este anel em qualquer dedo do pé se você precisar disfaeçar o mal cheiro dele.');
INSERT INTO "item_descriptions" VALUES(9461,'pt','Dizem que o Kimbo usa esta peruca para pagar tributo a um formoso, perfeitamente tosado jovem que ele encontrou na ilha. Que belo sorriso ele tinha! De qualquer forma, ele escondeu a peruca ridícula embaixo de seu coco.');
INSERT INTO "item_descriptions" VALUES(9463,'pt','Esta joia é tão poderosa que é capaz de matar um Moskito a 30 passos de distância. Isso se o seu odor p');
INSERT INTO "item_descriptions" VALUES(9464,'pt','Esse amuleto amedrontador foi escondido em uma mansão distante. Quando estava vivo, costumava sonhar com o mundo e todos os locais que pudesse ver. No final, o único lugar a que ele chegou foi seu pescoço. Pobre coisinha!');
INSERT INTO "item_descriptions" VALUES(9468,'pt','Esta perigosa pá roubará sua vitalidade, sua juventude, a água em seu corpo e seu precioso Troofles.');
INSERT INTO "item_descriptions" VALUES(9469,'pt','Feita com fungo, esta espada é perfeita para infectar o intestino de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(9542,'pt','Estes sapatos ficam muito mais brilhantes quando estão gastos. Eles são perfeitos para impressionar seus oponentes quando estiverem cara a cara.');
INSERT INTO "item_descriptions" VALUES(9543,'pt','Este pesado anel dará mais poder para as suas palmadas e mais paixão para o seu afago.');
INSERT INTO "item_descriptions" VALUES(9549,'pt','O lema do alfaiate que fez este milagre era: "Mesmo no centro da ação, suas calças devem permanecer justas, graças a alta qualidade do suspensório de linho." É, realmente não é um bom lema...');
INSERT INTO "item_descriptions" VALUES(9575,'pt','Este cinto possui estampa dos dois lados e pode ser usado de acordo com o que você deseja ocultar ou mostrar...');
INSERT INTO "item_descriptions" VALUES(9576,'pt','Feitas a partir do couro de um Black Wabbit, essas botas possuem um cheiro nada agradável, mas eles são tão confortáveis que você nem mesmo irá perceber o cheiro... Elas são ótimas para andar na mata.');
INSERT INTO "item_descriptions" VALUES(9594,'pt','Este Boloto tem uma aparência perfeitamente normal... Entretanto, sua lã parece estar escurecendo em alguns pontos... Espere um pouquinho e você terá uma surpresa!');
INSERT INTO "item_descriptions" VALUES(9617,'pt','Esta bolinha de pelo é mais resistente ao frio do que o Miaw original. É mais mansa, mas tem um temperamento ainda mais insuportável.');
INSERT INTO "item_descriptions" VALUES(9619,'pt','Esta criatura é meio burra. O único jeito de fazê-la andar é prendendo no lombo dela uma vara de pescar com uma Cenouwa na ponta. Felizmente, esta mascote foi bem domesticada e não vai tentar espalhar o pânico por aí.');
INSERT INTO "item_descriptions" VALUES(9620,'pt','Este Minimino foi criado pelo próprio Minotot. Infelizmente ele passou seu temperamento para a criatura, além de uma parte de seus odores corporais de tanto lhe acariciar o sovaco.');
INSERT INTO "item_descriptions" VALUES(9623,'pt','Não se engane: os dentes pontudos desta criatura um dia terminarão cravados no seu traseiro.');
INSERT INTO "item_descriptions" VALUES(9624,'pt','Pegue uma Draguna Rosa, pinte-a de preto, salpique-a de pó de ouro, mergulhe-a no óleo e depois na água. Pronto! Agora você tem uma Draguna Negra.');
INSERT INTO "item_descriptions" VALUES(9627,'pt','Certas aventuras escolhidas pelos deuses deverão usar este bastão para ajudar a vizinhança. Que nobre missão você tem pela frente!');
INSERT INTO "item_descriptions" VALUES(9655,'pt','As solas destas sandálias são mais robustas dos que as sandálias normais para certificar que resistirão ao peso dos  Alowas.');
INSERT INTO "item_descriptions" VALUES(9656,'pt','Estas botas têm rodinhas que fazem a sua descida ladeira a baixo muito mais rápidas, aumentando sua queda. Você escolhe!');
INSERT INTO "item_descriptions" VALUES(9658,'pt','Este amuleto é um mero colar de flores. Ele supostamente exala um cheiro mágico e transforma um Alowa em Alowaniano.');
INSERT INTO "item_descriptions" VALUES(9659,'pt','Erala usou este amuleto por todo a sua infância. Ninguém sabe o que há dentro dele, nem ela mesma.');
INSERT INTO "item_descriptions" VALUES(9662,'pt','Aventureiros gostam de colecionar este tipo de anel mas ninguém sabe de verdade o motivo.');
INSERT INTO "item_descriptions" VALUES(9667,'pt','Slait agora pode andar em sua novo piso de madeira sem arranhá-lo');
INSERT INTO "item_descriptions" VALUES(9785,'pt','Este demônio menor que acabou de sair da Shukrute acompanhará você em todas as suas peregrinações, do zaap de Astrub ao cemitério e talvez até mesmo do cemitério ao zaap de Astrub. Assim como você e todos os membros da espécie dele, esse bicho só tem uma obsessão: destruir, até não restar mais nada.');
INSERT INTO "item_descriptions" VALUES(9919,'pt','Transformar-se em uma coruja');
INSERT INTO "item_descriptions" VALUES(9921,'pt','Eles dizem que este bracelete é reluzente, mas somente quando você estiver em uma taverna no meio da noite.');
INSERT INTO "item_descriptions" VALUES(9922,'pt','Este cinto é dotado de um mecanismo magnético incrivelmente poderoso que o mantém fechado sem nenhuma fivela. Atenção: não é recomendável usá-lo ao mesmo tempo que um cinto de castidade.');
INSERT INTO "item_descriptions" VALUES(9923,'pt','Os giradores de cabeça serão pouco úteis para estes sapatos, a menos que você utilize seus pés de vez em quando - aí sim serão exatamente do que você precisa.');
INSERT INTO "item_descriptions" VALUES(9925,'pt','Este anel parece mais uma luva do que um anel de casamento, mas quem se importa, ninguem nunca mais irá mexer em sua mão da mesma maneira.');
INSERT INTO "item_descriptions" VALUES(9927,'pt','Se você vestir essas botas enquanto estiver escalando o Monte Jifu, é quase certeza que você irá ver alguns estranhos OVNI''s voando pelo céu.');
INSERT INTO "item_descriptions" VALUES(9928,'pt','Estas botas levam aproximadamente 12 horas para amarrar e um pouquinho mais de tempo para tirá-las. Isso lhe dará tempo suficiente para dormir um pouco quase todo dia, isso enquanto você for solteiro, desempregado e muito habilidoso com as mãos.');
INSERT INTO "item_descriptions" VALUES(9929,'pt','O tendão de Aquiles nem sempre fica embaixo dos joelhos, você sabe. De vez em quando fica logo abaixo da cintura. Neste caso, este pesado mas efetivo cinturão dará, a todos os fracos, uma mente serena e quilos de confiança.');
INSERT INTO "item_descriptions" VALUES(9942,'pt','Este anel é também conhecido como "Anel Negro", mas apesar de seus dois nomes, o anel não foi terminado. Mesmo assim, é poderoso o bastante para destruir um planeta de pequeno porte.');
INSERT INTO "item_descriptions" VALUES(9943,'pt','Diz a lenda que estes sapatos foram comidos por um minerador de ouro e que foi costurado devolta ao ser recuperado um tempo depois. Deve ser por isso que ele brilha tanto.');
INSERT INTO "item_descriptions" VALUES(9944,'pt','Este talismã é ao mesmo tempo um amuleto e uma gravata. Ele vai lhe deixar com um ar de cavalheiro mesmo quando você estiver na pior.');
INSERT INTO "item_descriptions" VALUES(9961,'pt','Este martelo de péssima qualidade foi criado para fazer com que os ferreiros acreditem que têm um martelo de ótima qualidade em mãos. Seu uso é altamente desaconselhado, ainda que seja para fazer nada.');
INSERT INTO "item_descriptions" VALUES(9972,'pt','Este martelo foi criado para um propósito específico, o que faz o uso dele pra qualquer outra coisa bem difícil. Apenas alguém desesperado ou nas margens da sociedade o usaria para criar armas.');
INSERT INTO "item_descriptions" VALUES(9974,'pt','Esta talhadora não serve para dar cabo dos seus adversários durante o combate, mas pode ser usada para esculpir belos cabos para as suas ferramentas.');
INSERT INTO "item_descriptions" VALUES(10054,'pt','Este anel ficou três anos imerso em excremento de Borcego. Pelo menos ainda é mágico.');
INSERT INTO "item_descriptions" VALUES(10055,'pt','Este amuleto deve evitar que Vampyros suguem o seu sangue. A idéia é que eles pensem que você é um Vampyro também.');
INSERT INTO "item_descriptions" VALUES(10056,'pt','Este cinto não somente brilha no escuro como também brilha no claro! Apesar de ser difícil de ter certeza.');
INSERT INTO "item_descriptions" VALUES(10058,'pt','Bram estava certo: é melhor não confiar em pessoas com dentes grandes, ainda mais quando estão com a Capa do Vampyro.');
INSERT INTO "item_descriptions" VALUES(10061,'pt','Dizem que a própria Elizabeth Bythora usou essas botas. Elas te deixam com umas belas pernas.');
INSERT INTO "item_descriptions" VALUES(10102,'pt','Esta máscara protegerá você do sol, pelo menos.');
INSERT INTO "item_descriptions" VALUES(10106,'pt','Esta criatura de cor pálida vai adorar sugar o sangue dos seus amigos e até do seu tornozelo, se ele estiver gordinho. Porém, a coisa de que ela mais gosta, seu ponto fraco por assim dizer, é quando você enfrenta horríveis monstros, fazendo-os sangrarem até a última gota. Portanto, você terá que ficar lutando o tempo todo... Coitado de você, é realmente terrível!');
INSERT INTO "item_descriptions" VALUES(10107,'pt','Esta mascote teve uma infância muito difícil por conta do seu nome ridículo. Isso talvez explique os surtos de raiva e o humor meio volátil dela... Quando viu que você tinha os mesmos problemas, ela acabou se apegando afetuosamente à sua pessoa. Desde então, ela não larga mais você e está determinada a atormentar o Mundo dos Doze em sua companhia.');
INSERT INTO "item_descriptions" VALUES(10155,'pt','Este amuleto lhe protegerá de qualquer perigo que lhe ameace, mas aumenta suas chances de se enforcar por qualquer motivo.');
INSERT INTO "item_descriptions" VALUES(10156,'pt','Estas pantufas são mais confortáveis do que seus calçados de costume, mas é difícil de dizer o porquê... Talvez os parasitas que a infestam massageiam seus pés.');
INSERT INTO "item_descriptions" VALUES(10157,'pt','Este cinto foi feito usando-se as sobras de carretéis de linho. Ele amarra sacos de lixo também.');
INSERT INTO "item_descriptions" VALUES(10158,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10159,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10160,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10161,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10162,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10163,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10164,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10165,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10166,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10167,'pt','Segure este troféu bem alto e com orgulho, pois ele será o único testemunho dos seus feitos quando você morrer.');
INSERT INTO "item_descriptions" VALUES(10168,'pt','Ponch polia suas botas todas as manhãs antes de montar em seu Dragoperu e sair em missões para salvar viúvas e orfãos. Principalmente viúvas... Ponch era muito charmoso.');
INSERT INTO "item_descriptions" VALUES(10171,'pt','Essas luvas de couro sem dedos são perfeitas pra uma surra de primeira-classe.');
INSERT INTO "item_descriptions" VALUES(10172,'pt','Este amuleto irá alimentar uma lesma por dois, ou talvez três dias se acompanhado de um purê em sua cabeça.');
INSERT INTO "item_descriptions" VALUES(10173,'pt','As solas destas botas estão cobertas com uma meleca pegajosa e o interior com uma meleca escorregadia. Ou seria o contrário?');
INSERT INTO "item_descriptions" VALUES(10180,'pt','Este medalhão age como chave para uma misteriosa e esquecida cidade.');
INSERT INTO "item_descriptions" VALUES(10181,'pt','Este anel foi encontrado em uma cidade misteriosa onde ninguem sabia de sua existência até que começaram a procurar freneticamente.');
INSERT INTO "item_descriptions" VALUES(10186,'pt','Esse colar com dentes de javali assustará os javalis e, com sorte, a sua sogra também!');
INSERT INTO "item_descriptions" VALUES(10189,'pt','Este anel costumava pertencer ao Rei Oxo. Ele gostava de fazer brincadeiras usando os raios solares refletidos por este anel. Costumava dizer "Olhe os raios lasers de Oxon!"');
INSERT INTO "item_descriptions" VALUES(10190,'pt','Não esqueça de colocar estas botas quando estiver com a cabeça nas nuvens, elas a manterão lá. Sabendo o quão legais elas são, não as use para dançar se quiser se manter com os pés no chão.');
INSERT INTO "item_descriptions" VALUES(10191,'pt','Este cinto é perfeito quando você precisa descansar e digerir seu velho Oxo Bucco.');
INSERT INTO "item_descriptions" VALUES(10223,'pt','Esta pá é usada principalmente para fins medicinais, embora o Enutrof Resat a utilize como arma de autodefesa, o que causou muita controvérsia na época que a história veio à tona.');
INSERT INTO "item_descriptions" VALUES(10438,'pt','Essas botas eram do inesquecível Maidarte, um gênio incompreendido, que se especializou em loopings e repetições. Ninguém entendeu exatamente o que ele estava explicando ou continuou repetindo as mesmas coisas. Assim como as ondas batem nas rochas da costa, o seu palavrório também se tornou parte do cenário.');
INSERT INTO "item_descriptions" VALUES(10544,'pt','Adestrada por seu antigo dono para comer apenas os monstros que vivem perto do lago de Cania, esta criatura vinda de terras distantes acabou diversificando seu regime alimentar. Contudo, ela está sempre com um bafo de Blop.');
INSERT INTO "item_descriptions" VALUES(10557,'pt','Essa luva velha e gasta ajudará você a pegar bolas de futebol, ou qualquer outro item redondo envolto em couro. O que você fará com isso é problema seu...');
INSERT INTO "item_descriptions" VALUES(10558,'pt','Com essas luvas em suas mãos, você poderá fingir que é um jogador famoso de Papabol.');
INSERT INTO "item_descriptions" VALUES(10559,'pt','Partidas de Papabol são brutais, e esse cinto foi feito para proteger o jogador de dores musculares. Entretanto, você também pode usá-lo como bóia enquanto nada. Mas quem faria isso?');
INSERT INTO "item_descriptions" VALUES(10560,'pt','Algumas pessoas dizem que Papabol é um jogo para homens de verdade, assim como esse cinto. Ele tem protetores que amortecem golpes.');
INSERT INTO "item_descriptions" VALUES(10561,'pt','Essas botas já foram usadas por um bom tempo, você pode facilmente sentir o mau cheiro. Vista-as e você se parecerá como um verdadeiro jogador de Papabol.');
INSERT INTO "item_descriptions" VALUES(10562,'pt','Botas elegantes alimentam o fascínio dos fãs. Quando essas botas são polidas, elas ajudam nos seus dribles e, certamente, nenhum oponente o alcançará!... Isso tudo, enquanto a torcida grita! Sim, você aprendeu o básico do Papabol.');
INSERT INTO "item_descriptions" VALUES(10623,'pt','Grute, o Bwork, não era muito esperto. Na verdade, era burríssimo. Durante anos, sua companheira tentou botar alguma coisa que não cerveja na cachola dele, mas era uma batalha perdida. Grute continuou tão burro quanto antes, mas sem espuma.');
INSERT INTO "item_descriptions" VALUES(10624,'pt','Aqueles que tiveram que enfrentar Grute, o Bwork irão dizer "Não mire na cabeça, é vazia". Esse conselho tambem se aplica aqueles que enfrentam Iops, Goblins ou sogras.');
INSERT INTO "item_descriptions" VALUES(10625,'pt','As botas de Grute dão um aroma tão pestilento que você será capaz de derrotar inimigos com apenas um rápido chute em suas cabeças. Essas botas foram proibidas em situações de combate pela Convenção de Sufokia a um longo tempo atrás, uma convença que, pelo visto, salvou muitas, muitas vidas.');
INSERT INTO "item_descriptions" VALUES(10627,'pt','Koksis tinha vários prazeres pouco saudáveis, como comer batata chips de vinagre com geleia ou, pior ainda, degustar pelo de Miaw. Muitos tentaram levá-lo para o bom caminho e se perderam no caminho de volta.');
INSERT INTO "item_descriptions" VALUES(10628,'pt','Não tem nada mais barulhento que o tamborilar dos ossos em um caixão de olmo. Graças a estas botas com isolamento, Koksis, o Chafer, podia ensaiar e dançar a Ankarmanhola a noite toda sem medo de acordar os vizinhos, os mortos e os vizinhos mortos.');
INSERT INTO "item_descriptions" VALUES(10629,'pt','Koksis tinha dois sonhos: subir a Montanha dos Smagadores e se tornar menestrel. A vida foi muito cruel com ele, pois teve que se contentar em abrir os shows de Grobeto Kralos antes de morrer. Às vezes o destino lhe prega uma peça. Em Koksis, ele pregou o caixão.');
INSERT INTO "item_descriptions" VALUES(10631,'pt','Eis um dos ditados mais populares do povo violeta: "Às vezes ser você que bater no bar e às vezes ser bar que te bater."');
INSERT INTO "item_descriptions" VALUES(10632,'pt','Gobovo, o Goblin, adorava devorar ovos em estado avançado de putrefação. Seu aparelho digestivo suportava bem esse hábito duvidoso, mas o mesmo não pode ser dito das pobres criaturas que tinham que se aproximar do bafo podre dele. Graças a esse cinto, elas podiam se segurar antes de cair no chão como Moskitos.');
INSERT INTO "item_descriptions" VALUES(10633,'pt','Gobovo adorava cuidar do jardim, principalmente quando se tratava de dar golpes de ancinho nos desavisados que se aproximassem das suas terras. Ele encontrou esse anel no dedo de um aventureiro imprudente que pisou nos seus pés de saladainha.');
INSERT INTO "item_descriptions" VALUES(10635,'pt','Quando as duas pequenas bolas neste amuleto colidem, elas produzem um pequeno som irritante, o que significa que um Kanibola está bem próximo. Quando você escuta este barulho, é normalmente muito tarde pra escapar, mas ainda há tempo para escolher o tempero com o qual você será devorado.');
INSERT INTO "item_descriptions" VALUES(10636,'pt','Este anel está cheio de temperos secretos, usados para dar sabor quando batido à mão. Os temperos são tão gostosos que assim que você colocar o anel na mão, corre o risco de morder seus próprios dedos.');
INSERT INTO "item_descriptions" VALUES(10637,'pt','O Kanibola Lektor usou essas botas durante vários anos antes de trocá-las por um turista na ilha de Moon. A fome justifica os meios.');
INSERT INTO "item_descriptions" VALUES(10639,'pt','Stroy Zemol tinha uma irmã, Faye Pworme. Ela gostava de viajar sozinha explorando os túneis escuros e fedidos.');
INSERT INTO "item_descriptions" VALUES(10640,'pt','Este cinto é supostamente reversível, só que ninguém nunca ousou experimentá-lo, pois não querem ser os primeiros a descobrir que na verdade não é reversível.');
INSERT INTO "item_descriptions" VALUES(10641,'pt','Stroy Zemol criou estas botas sozinho, com alguns blocos de madeira e um pouco de tecido. Elas podem não parecer com outras botas, mas caramba, elas certamente são mágicas.');
INSERT INTO "item_descriptions" VALUES(10643,'pt','Este anel muda de cor quando é mergulhado em caldo de peixe fervente. Isso explica porque Grisu, o Mineiro Sombrio, o amava tanto.');
INSERT INTO "item_descriptions" VALUES(10644,'pt','As solas dessas botas mágicas permitem que você quebre blocos de carvão criando as vibrações necessárias para quebrá-los. O guia de uso indica que é possível até que elas vibrem sozinhas, se música for tocada por perto.');
INSERT INTO "item_descriptions" VALUES(10645,'pt','Este cinto, reforçado com vários metais diferentes, era forte o bastante para suportar o peso de da enorme carga de Faye Erdamp, o mineiro negro. Ele deve ser tão util quanto para cargas mais leves, como a sua.');
INSERT INTO "item_descriptions" VALUES(10657,'pt','Esta estranha mascote é resultado do cruzamento entre os melhores buscadores de trufas de toda Amakna. Com seu enorme focinho, ela consegue encontrar ogrina até debaixo d''água. Parece que Otomai levou muitos anos para conseguir criar esta espécie. Dizem que ele pretendia usá-la para tentar encontrar uma coisa que teria perdido ou uma criatura que teria deixado fugir. Só ele sabe como essa história acabou...');
INSERT INTO "item_descriptions" VALUES(10685,'pt','Equipado com este capacete de ouro, sua cabeça logo estará fazendo dinheiro e valendo seu peso em ouro.');
INSERT INTO "item_descriptions" VALUES(10686,'pt','Esta capa de tecido, revestida com uma fina camada de ouro, é mágica. Ela chama atenção e reflete luz diretamente nas pupilas de tipinhos desonestos que tentam apunhalar você por trás. Indispensável se você tiver amigos Srams.');
INSERT INTO "item_descriptions" VALUES(10687,'pt','Este anel é tão pesado que aumenta em muitas vezes a inércia de seu punho quando você distribue pancadas em seus oponentes. Quando você começar a punir os camponeses, será praticamente impossível parar.');
INSERT INTO "item_descriptions" VALUES(10688,'pt','Este cinto é ideal para pendurar suas barras de ouro em torno de sua cintura, elas passam despercebidas.');
INSERT INTO "item_descriptions" VALUES(10784,'pt','Ninguem faz a menor idéia de que poderes este amuleto atrás, mas todos sabem o que ele leva: sua credibilidade.');
INSERT INTO "item_descriptions" VALUES(10785,'pt','Você já ouviu falar de Pedra Papel Tesoura, certo? Bem, este anel te protege do Papel.');
INSERT INTO "item_descriptions" VALUES(10794,'pt','Quente por dentro e fria por fora, essas botas irão permitir que você chute traseiros de bonecos de neve sem derreter suas nádegas.');
INSERT INTO "item_descriptions" VALUES(10797,'pt','Retirada de sua bainha, essa espada pode cortar presunto, Enutrofs, pernetas, dançarinos e Enutrofs pernetas enrolados em uma fatia de presunto que dançam em uma noite de lua cheia. Infelizmente, não é muito útil para fatiar monstros.');
INSERT INTO "item_descriptions" VALUES(10798,'pt','Este escudo não o protegerá de sua própria estupidez.');
INSERT INTO "item_descriptions" VALUES(10799,'pt','Tendo problemas em esconder sua adaga em sua cueca? Tudo bem, você pode guardá-la entre suas partes e este cinto!');
INSERT INTO "item_descriptions" VALUES(10800,'pt','Você poderá voar com essa capa em volta de seus ombros. Apenas feche seus olhos, feche seus punhos, abra sua boca, estique seus braços e pule de um penhasco gritando "EU POSSO VOAR!". Momentos depois, você acordará com duas pernas quebradas.');
INSERT INTO "item_descriptions" VALUES(10801,'pt','Este chapéu malfeito esconde sua calvície admiravelmente.
Infelizmente, não é grande o bastante para esconder sua falsa modéstia.');
INSERT INTO "item_descriptions" VALUES(10802,'pt','Mais dourada do que a Draguna Negra, menos rosa do que a Draguna Rosa e mais rara do que a Draguna Esqueleto, esta mascote transformará você no centro das atenções, mesmo se você for tão feio quanto um Piu.');
INSERT INTO "item_descriptions" VALUES(10818,'pt','Com essa arma de aparência básica, você irá sentir que sabe lutar.');
INSERT INTO "item_descriptions" VALUES(10828,'pt','Eles dizem que pedras e madeira podem quebrar seus ossos, mas palavras nunca machucam. Com este capacete, você poderá desafiar este conceito...');
INSERT INTO "item_descriptions" VALUES(10829,'pt','Está tendo disputas por dinheiro? Graças a esta vara, só haverá um vencedor: você!');
INSERT INTO "item_descriptions" VALUES(10830,'pt','É uma Capa de Banana no seu bolso, ou você só está feliz em me ver?');
INSERT INTO "item_descriptions" VALUES(10834,'pt','Não é preciso de muito para se parecer com um Ouginak Cuidado com as pulgas.');
INSERT INTO "item_descriptions" VALUES(10836,'pt','Você veste este amuleto com orgulho, como o símbolo da sua participação neste grande evento de esporte. Você precisa dele para continuar orgulhoso depois de um confronto contra B. C. Trool.');
INSERT INTO "item_descriptions" VALUES(10846,'pt','Levados por um estranho frenesi, qualquer Tofus que o vir vai querer se esfregar na sua perna. Você tem certeza de que é a capa que os atrai?');
INSERT INTO "item_descriptions" VALUES(10847,'pt','Lápucra colocava essas confortáveis botas em seus amplos pés uma vez por ano, mas as retirava todos os dias, o que sugere que ela seja mágica.');
INSERT INTO "item_descriptions" VALUES(10848,'pt','Essas botas também podem ser usadas como bigornas. O antigo dono pede que você não dance enquanto as vestir.');
INSERT INTO "item_descriptions" VALUES(10849,'pt','Este cinto é construído em torno de uma armação metálica magnética que atrai as bolsas dos descuidados para você');
INSERT INTO "item_descriptions" VALUES(10850,'pt','Klume tinha três fraquezas: Araknes, sentir cócegas, e Araknes que fazem cócegas.');
INSERT INTO "item_descriptions" VALUES(10851,'pt','Esse cinto está coberto com farinha, talvez porque Napizram, o Padeiro Obscuro, usou-o como avental. Ou talvez seja o pó que ele usava para aliviar uma vergonhosa coceira.');
INSERT INTO "item_descriptions" VALUES(10852,'pt','Lápucra roubou este amuleto de Gonztipay, um sujeito sem absolutamente nenhum senso de humor.');
INSERT INTO "item_descriptions" VALUES(10853,'pt','Esse amuleto permite que você massageie a pele do seu pescoço sem usar as mãos.');
INSERT INTO "item_descriptions" VALUES(10854,'pt','Gontran Klume, o ferreiro, trocou uma espada que pertencia a Dama Antium por este anel.');
INSERT INTO "item_descriptions" VALUES(10855,'pt','Esse anel passou por uma centena de fermentos diferentes. Dizem que é capaz de transformar aqueles que o usam em mofo. Alguns aventureiros não veem diferença nenhuma ao usá-lo.');
INSERT INTO "item_descriptions" VALUES(10863,'pt','Esta Arakne é mesmo muito mal educada. Ela fica pulando sem parar, grita e pica todo mundo, mas você gosta muito dela mesmo assim.');
INSERT INTO "item_descriptions" VALUES(10864,'pt','Esse Cogu Cogu único foi criado por uma alcateia de Milobos. Mesmo assim, isso não explica por que ele tem axilas tão peludas.');
INSERT INTO "item_descriptions" VALUES(10865,'pt','Este Tofu foi atingido 11 vezes por um raio quando era pequeno. Se o acariciar, você vai levar um choque. Se não o acariciar, ele vai eletrocutar você. A escolha é sua.');
INSERT INTO "item_descriptions" VALUES(10866,'pt','Esta mascote adora alcachofra com sangue de Rasgabola, endívia com pelo de Bitufo e canções de Grobeto Kralos. Ela parece gostar de sua companhia também.');
INSERT INTO "item_descriptions" VALUES(10907,'pt','Aí está, você conseguiu! Participou do maior controle de natalidade dragontina. Mas, como nada é perfeito, teve que comer omelete durante várias semanas, até não poder mais.');
INSERT INTO "item_descriptions" VALUES(10955,'pt','Não há nada incomum em um pássaro no anel.');
INSERT INTO "item_descriptions" VALUES(10956,'pt','Como o restante do conjunto do Corvo Negro, este par de botas foi passado de geração pra geração, pé a pé. Isso explica o forte cheiro de queijo podre..');
INSERT INTO "item_descriptions" VALUES(10963,'pt','A sola dessas botas são esponjosas, então ela pode absorver a sujeira de esgoto e ir soltando a cada passo, permitindo que você refaça seus passos com facilidade.');
INSERT INTO "item_descriptions" VALUES(10964,'pt','Plunder pendurava seu tesouro neste cinto. Você ver uma pequena válvula no seu interior. Essa válvula permite que o cinto encha de ar, se transformando em uma bóia. Um item essencial para se aventurar em esgotos.');
INSERT INTO "item_descriptions" VALUES(10965,'pt','Este amuleto foi especialmente criado para não ficar preso nos cabelos do pescoço de Rapina, então você pode utilizá-lo sem medo no seu suvaco ou até em sua mão.');
INSERT INTO "item_descriptions" VALUES(10971,'pt','Com essa sacola pendurada em um ângulo bem disposto em cima de seu ombro, você poderá reclamar enquanto mantém aquele sorriso charmoso em seu rosto!');
INSERT INTO "item_descriptions" VALUES(10976,'pt','Cogumelos geralmente usam colar. Já Phong Huss preferia anéis. Talvez ele quisesse se vangloriar de ter dedos.');
INSERT INTO "item_descriptions" VALUES(10977,'pt','Phong Huss tentava usar esse cinto a tiracolo para prender nele o estojo de seu sabre. Vivia espetando os mamilos, mas é o preço a se pagar para sacar a arma com certa classe.');
INSERT INTO "item_descriptions" VALUES(10978,'pt','Os pés de um fungi raramente são limpos - costumam estar cobertos de micélio. Os pés de Phong Huss não eram exceções a essa regra e ele fazia questão de escondê-los em suas botas. Elas não cheiram muito bem, mas são muito boas para criar cogumelos. Quem irá vencer, seu estômago ou seu nariz?');
INSERT INTO "item_descriptions" VALUES(10980,'pt','Um amuleto de fantasma só pode ser um objeto mágico poderosíssimo, pois brilha no escuro.');
INSERT INTO "item_descriptions" VALUES(10981,'pt','Fantasmas são imateriais. Então como é que eles podem usar anel? Nada mais irracional. Um pouco como você, na verdade.');
INSERT INTO "item_descriptions" VALUES(10982,'pt','Uma vez, o Capitão Kradoc encontrou Ektope saindo de um concurso de bebedeira na Taberna do Ripata. "Ectoplasma de rodinhas!", gritou ele. Pobre Capitão Kradoc, o álcool pregou uma peça nele. Ektope nunca teve rodinhas.');
INSERT INTO "item_descriptions" VALUES(10985,'pt','Este Miaw experimentou o inverno do extremo norte, mesmo sem nunca ter realmente visto o extremo norte. Ninguém sabe como ele chegou a Amakna, mas os anciãos dizem que ele foi trazido da ilha de Frigost para lutar contra a falta de cubos de gelo na hora de tomar um drink.');
INSERT INTO "item_descriptions" VALUES(10987,'pt','Este cinto esfria quadris, órgãos e o ardor daqueles que se atrevem a usá-lo. Para ser dado para aqueles pretendentes mais teimosos.');
INSERT INTO "item_descriptions" VALUES(10990,'pt','Pesada e dura, essas botas não parecem ser particularmente especiais, mas suas solas de gelo irão permitir que você patine sem a necessidade de gelo. É claro, você irá precisar encontrar uma superfície coberta com lâminas de patins de gelo, mas nesses tempos malucos não deve ser muito difícil de conseguir.');
INSERT INTO "item_descriptions" VALUES(11011,'pt','Mais maluca do que um Pekefox comum, mas muito menos ruiva, essa mascote pode nadar debaixo d''água sem a necessidade de tapar o nariz.');
INSERT INTO "item_descriptions" VALUES(11012,'pt','Não é porque essa mascote é tigrada que ela vai deixar de cheirar seu traseiro ou tentar se aliviar no seu tapete. O que você esperava?');
INSERT INTO "item_descriptions" VALUES(11013,'pt','Este Quaquazinho Negro feio foi rejeitado pela sua própria família por ser diferente: ele adora ouvir o canto do menestrel Grobeto Kralos. Talvez ele fosse só incompreendido...');
INSERT INTO "item_descriptions" VALUES(11014,'pt','Esta mascote passou muito tempo dormindo debaixo da chuva ácida. Ela não brilha no escuro nem é mágica, mas, se quiser fazer um vinagrete, ela vai ser muito útil.');
INSERT INTO "item_descriptions" VALUES(11015,'pt','Esta estranha criatura atravessou o oceano em um bloco de gelo para encalhar em um porto perdido. Agora ela parece achar que você é um bloco de gelo.');
INSERT INTO "item_descriptions" VALUES(11042,'pt','Este cinto foi dado ao Gultar por seu pai pelo seu quinto aniversário. É mais sólido do que a aparência sugere, e irá manter suas calças bem firmes na sua cintura. Também pode ser usado como varal ou corda de pular.');
INSERT INTO "item_descriptions" VALUES(11051,'pt','Se você molhar este amuleto em seu copo, sua água sem sabor irá se transformar em uma bebida deliciosa com sabor cítrico.');
INSERT INTO "item_descriptions" VALUES(11052,'pt','A sola dessas botas são feitas de uma dura pele de uma fruta cultivada em uma ilha cuja existência continua desconhecida a meros mortais.');
INSERT INTO "item_descriptions" VALUES(11057,'pt','Este cinto é composto de escamas arranjadas em espiral de acordo com a sequência de Vibronacci.');
INSERT INTO "item_descriptions" VALUES(11058,'pt','Quem você pretende seduzir com um anel como este?');
INSERT INTO "item_descriptions" VALUES(11080,'pt','Este versátil par de botas irá garantir total liberdade de movimento, sendo essa a razão pela qual Lonne Jenone as usa quando ele dança com Milobos.');
INSERT INTO "item_descriptions" VALUES(11082,'pt','Essas botas foram especialmente desenhadas para destruir as caneleiras de seus oponentes, e depois as canelas delas, e depois seus próprios pés.');
INSERT INTO "item_descriptions" VALUES(11083,'pt','Você pode utilizar este anel para furar a Papabola quando quiser aproveitar tranquilamente um intervalo de jogo.');
INSERT INTO "item_descriptions" VALUES(11085,'pt','Se você vestir esse cinto de cabeça para baixo e apertá-lo com força suficiente, você pode ser capaz de ativar seu sistema de módulo eletromagnético. Isso nunca funcionou, mas você pode ativá-lo mesmo assim. Ai você pode vendê-lo para alguém ainda mais ingênuo que você.');
INSERT INTO "item_descriptions" VALUES(11087,'pt','Usado há varias gerações de faz-tudos, este anel irá proteger uma falange das pancadas de martelo. Infelizmente, ele nunca é vendido em pacotes de cinco.');
INSERT INTO "item_descriptions" VALUES(11091,'pt','Grillian, o mago, trocou um anel mágico por este par de botas. Parece que ele saiu perdendo nessa troca, já que elas não eram nem acolchoadas.');
INSERT INTO "item_descriptions" VALUES(11092,'pt','Grillian usava este amuleto em seu pescoço quando... Quando... Bah, isso importa? Ele morreu e agora o amuleto é seu.');
INSERT INTO "item_descriptions" VALUES(11104,'pt','Existe uma criatura que ultrapassa o Tofu, o Papatudo e até o Iop em idiotice: o Quaquá.');
INSERT INTO "item_descriptions" VALUES(11306,'pt','Está escrito no punho: "Rouba a vida dos pobres para dar aos ricos." Pena que você é pobre.');
INSERT INTO "item_descriptions" VALUES(11343,'pt','O próprio Rapiat fabricou essas botas, sem custar nenhum Kama. Não se pode dizer o mesmo dos seus dois companheiros que pagaram com suas próprias vidas.');
INSERT INTO "item_descriptions" VALUES(11344,'pt','Para o azar desse cinto, o único prazer de Rapiat eram os pães de Danioul Garnioul, o Padeiro. Na verdade, ele era o único que continuou a comer os pães depois de saber que eles eram sovados com os pés, dizendo que era isso que dava a eles o seu gosto especial.');
INSERT INTO "item_descriptions" VALUES(11345,'pt','Esse lindo amuleto de âmbar parece ser feito de um material muito menos nobre, o que explica o seu odor nojento e seu preço baixo. Mas é o resultado que importa, não é?');
INSERT INTO "item_descriptions" VALUES(11346,'pt','Esse anel ajudou Ugiclo a parar de roer suas garras. Até hoje, ele ainda brilha com baba.');
INSERT INTO "item_descriptions" VALUES(11347,'pt','Quando era jovem, Ougicle usava esse cinto como tanga, sem calças. Ele parou com isso no dia que descobriu por que as pessoas riam deles quando ele virava as costas.');
INSERT INTO "item_descriptions" VALUES(11348,'pt','Ugiclo gostava muito de seu colar de ouro: ele amplificava tanto seus gritos que o chão à sua volta vibrava. Muito útil para afastar Kolerratos.');
INSERT INTO "item_descriptions" VALUES(11350,'pt','A Cenouwa obscura que enfeita o anel de Kerotz não é mágica e certamente não é maligna, ela só tem a mesma idade que ele.');
INSERT INTO "item_descriptions" VALUES(11351,'pt','O Amuleto de Kerotz é simplesmente uma versão luxuosa do "Amuleto de dente de Wabbit", decorado com pele. É uma pena que por isso ele seja menos poderoso.');
INSERT INTO "item_descriptions" VALUES(11352,'pt','As Botas de Kerotz são leves e forradas com pelo, o que as deixam muito confortáveis. Infelizmente, sendo um Wabbit, ele nunca conseguiu colocá-las.');
INSERT INTO "item_descriptions" VALUES(11354,'pt','Sobre o túmulo erguido em homenagem a Grullo, podemos ler que, para não morrer carbonizado com sua própria lanterna, como os outros Gárgrulas, ele apagou a sua. Ele acabou morrendo de fome, perdido na escuridão do Campo do Descanso.');
INSERT INTO "item_descriptions" VALUES(11355,'pt','As botas de Grullo o tornavam incrivelmente lento, apesar das asas presas à ela. Ninguém nunca entendeu o motivo de tanta lerdeza.');
INSERT INTO "item_descriptions" VALUES(11356,'pt','Grullo gostava de fazer seu cinto falar usando seus talentos de ventríloquo. Ninguém sabe como ele conseguia mexer a língua do cinto sem usar as mãos.');
INSERT INTO "item_descriptions" VALUES(11358,'pt','Kubitus era um Chafer muito versátil: desafiá-lo de longe significava ter que enfrentar seu grande talento com arco e flecha, enquanto abordá-lo a dez kametros significava enfrentar uma morte horrível sendo sufocado. Assim como ter as mesmas botas por décadas pode ter suas vantagens.');
INSERT INTO "item_descriptions" VALUES(11359,'pt','O osso na frente do cinto de Kubitus é parecido com a forma de um cóccix: ele pensou que tendo dois pares de traseiros, ele seria mais atraente para as mulheres. Na verdade, só o fez parecer ridículo.');
INSERT INTO "item_descriptions" VALUES(11360,'pt','Esse amuleto único, que já foi animado pela mesma magia dos Ovivmetis, insistia em chamar Kubitus de "Ulna". Este, irritado, calou-o arrancando sua mandíbula.');
INSERT INTO "item_descriptions" VALUES(11362,'pt','Piggy Pop gritou tão alto quando ele cantou isso que depois de um tempo ele ficou surdo. A magia de seu anel colocada nos ouvidos o ajudou a ouvir novamente. O focinho enfrentou o dano causado pelo seu cheiro forte.');
INSERT INTO "item_descriptions" VALUES(11363,'pt','O desconforto causado pelo cinto de Piggy Paupe fez que ele adotasse um modo de andar muito específico, sempre balançando sua pélvis para frente ou para trás. Não espere atrair o interesse do sexo oposto, você não vai parecer atraente, apenas grotesco.');
INSERT INTO "item_descriptions" VALUES(11364,'pt','O sapato que enfeita o Amuleto de Piggy Pop é o da sua mulher e musa, Yka Pop, que o deu para ele de presente. Mas Piggy sempre achou que era mais uma desculpa para parar de ir aos seus concertos do que uma prova de amor.');
INSERT INTO "item_descriptions" VALUES(11374,'pt','Há espaço para que um dos seus amigos escreva o seu nome neste amuleto de papel, ou seja, o que os criadores fazem para identificar seus Papatudos.');
INSERT INTO "item_descriptions" VALUES(11375,'pt','Esta forte e rígida roupa íntima não é muito confortável, mas também, foi feita com papel machê. Pelo que vejo, ter a saliva de um estranho na sua bunda não parece incomodá-lo nem um pouco.');
INSERT INTO "item_descriptions" VALUES(11378,'pt','Mais leve que as sandálias comuns, elas só tem um ponto negativo, não combinam com pessoas que tenham cócegas.');
INSERT INTO "item_descriptions" VALUES(11379,'pt','Este amuleto vai fazer cócegas na sua garganta e fará você tirar o que estiver preso nela.');
INSERT INTO "item_descriptions" VALUES(11384,'pt','Coloque esta argola ao redor de um pescoço de qualquer criança sob seus cuidados, e então ligue a argola a uma corda que você amarrou em uma árvore. Agora você pode relaxar e a criança não pode escapar.');
INSERT INTO "item_descriptions" VALUES(11386,'pt','Essas botas são perfeitas para dar punições com seus pés e não precisar sujar as suas mãos. As crianças vão adorar você!');
INSERT INTO "item_descriptions" VALUES(11395,'pt','Esta pequena corrente poderia se passar por um amuleto se não fosse a ponta do cadeado.');
INSERT INTO "item_descriptions" VALUES(11396,'pt','O homem que me deu este nome estúpido para o cinto estava sempre fugindo da polícia, os anos que ele passou na prisão depois que foi pego não foram suficientes para pagar pela falta de criatividade.');
INSERT INTO "item_descriptions" VALUES(11399,'pt','Você consegue ler o que foi gravado neste anel: “Para defensores da lei que não têm medo de nada”. E você achou que pudesse usá-lo.');
INSERT INTO "item_descriptions" VALUES(11400,'pt','O sapateiro que fez essas botas colocou assas de Borbat para que quem as vestisse pudesse voar. Bom, era difícil ouvir algo além daquele ruído irritante, mas é isso que você acha que o vendedor estava dizendo quando comprou as botas em Astrub Zaap.');
INSERT INTO "item_descriptions" VALUES(11416,'pt','Este par de botas foi esculpido em um troco de árvore. Ou seria o contrário?');
INSERT INTO "item_descriptions" VALUES(11417,'pt','Este anel foi feito com serragem e com mais algo bem grudento, e é melhor que você deixe assim.');
INSERT INTO "item_descriptions" VALUES(11419,'pt','Grobeto Kralos sempre colocava essas botas quando precisava fazer um depósito... em uma cabana, no fundo do jardim');
INSERT INTO "item_descriptions" VALUES(11468,'pt','Um votivo amuleto dedicado a adoração de uma deusa esquecida. "Proteja seus irmãos e irmãs" está escrito nele. Deuses... Pirralhos mimados. E se nós não tivermos um irmão ou uma irmã, heim? O que devemos fazer?!');
INSERT INTO "item_descriptions" VALUES(11469,'pt','"Anotações sobre os Dragões: dentes (enormes), garras (afiadas), hálito (flamejante), cobiça (fenomenal). Alguns dragões podem prever o tempo. Mas um dragão é mais volumoso do que um sapo". Onde será que o Conde Traspafrent conseguiu todas essas informações?');
INSERT INTO "item_descriptions" VALUES(11470,'pt','"O dono deste anel teria sido prisioneiro de um Dragão. Se minha memória não falha, nunca ouvi falar de um Dragão prendendo alguém contra sua vontade. É tão fácil para um dragão fazer um bom churrasco, por que se dar ao trabalho?" - Pensamentos do Conde Traspafrent.');
INSERT INTO "item_descriptions" VALUES(11471,'pt','"O dono dessas botas estava muito irritado com um certo Dragão. Não faça como ele, nunca se esqueça do respeito ancestral que essas criaturas merecem. E lembre-se que um Dragão é grande. Muito grande. E eles não tem o menor senso de humor." - Pensamentos do Conde Traspafrent.');
INSERT INTO "item_descriptions" VALUES(11472,'pt','"Esta capa supostamente deveria proteger seu usuário dos sonhos e ilusões da dimensão etérea. Será que ela funciona mesmo? Seria necessário ir e voltar entre dimensões para ter certeza. Com exceção do Mago Ax em seus melhores dias (ou nos dias de bebedeira), poucos foram capazes de realizar tal feito." - Pensamentos do Conde Traspafrent.');
INSERT INTO "item_descriptions" VALUES(11473,'pt','O Conde Traspafrent escreveu nesse cinto: "Aquele que usar este cinto poderá atravessar o tempo e o espaço!". Especulação teórica? Uma coisa é certa: ele realmente segura as suas calças. Já é alguma coisa...');
INSERT INTO "item_descriptions" VALUES(11474,'pt','"Em caso de perturbações no astral, coloque-o sobre a cabeça imediatamente". Um aviso de segurança gravado pelo próprio Conde Traspafrent. Você não sabe o que é astral, mas com esse chapéu você estará pronto para dar de cara com uma aventura... Ou com um muro.');
INSERT INTO "item_descriptions" VALUES(11514,'pt','Com esta arma em seus punhos cerrados, você irá gritar por vingança e buscar justiça. Vingar quem? Buscar justiça para o que? Parece que as respostas para essa pergunta não pertencem a essa era...');
INSERT INTO "item_descriptions" VALUES(11563,'pt','Com este amuleto em volta do pescoço, todo mundo saberá que você domina as quatro energiar elementares primordiais. No entanto, ele não o deixará mais rico.');
INSERT INTO "item_descriptions" VALUES(11571,'pt','Os chifres deste chapéu ficam exatamente contra a têmpora do aventureiro que ousa usá-lo. Por isso, os chifres ressoam com as ondas alfa do cérebro, permitindo que você se comunique com Gelikanos distantes sem precisar abrir a boca ou orelhas. Muito útil quando você está tentando invadir uma tribo de Gelikanos.');
INSERT INTO "item_descriptions" VALUES(11572,'pt','As quatro bolas brilhantes e enormes que adornam esta coroa são consideras por alguns especialistas em pingwinologia de Frigost como uma representação gráfica da incrível fertilidade do Pingwin Real. De onde eles tiram essas ideias malucas?');
INSERT INTO "item_descriptions" VALUES(11573,'pt','Ben, o Ripata, usava este chapéu para mostrar quem era o chefe a bordo do Grolandês Violento. Isso não impediu que seus fiéis tripulantes o apelidassem de “O Chatola na Cartola”, “Jacques Chapeuzinho”, “Cabeça de Sonia” ou, o pior de todos, “Octopus Tule”.');
INSERT INTO "item_descriptions" VALUES(11574,'pt','Você precisa admitir que este capacete não faz você parecer mais inteligente. O problema é, entretanto, que sem ele, você aparenta menos ainda.');
INSERT INTO "item_descriptions" VALUES(11575,'pt','A primeira coisa que seu oponente viu antes de roubar este colar foi como ele era brilhante. É engraçado porque também foi a última coisa que você viu antes da sua cabeça acertar o chão.');
INSERT INTO "item_descriptions" VALUES(11576,'pt','Anteriormente, os joalheiros de Frigost costumavam dar ótimos conselhos quando eles queriam vender joias maiores: dê grandes joias ao seu amor, e isso vai impedir que ela fique muito longe de você.');
INSERT INTO "item_descriptions" VALUES(11577,'pt','Uma lenda diz que um grupo de covardes de Frigost tentou jogar este anel na cratera de um vulcão para destruí-lo Felizmente para você, eles fracassaram.');
INSERT INTO "item_descriptions" VALUES(11578,'pt','Ben, o Ripata, adorava abraços e apertos de mão másculos e, às vezes, os dois ao mesmo tempo. Infelizmente para aqueles que ele amava, muitas vezes se esquecia que estava armado com um gancho grande e enferrujado. De tanto arranhar, furar, beliscar, cortar e arrancar os olhos da família, ele ganhou os seguintes apelidos: "João Sem Mão", "Ganchy Ganchy CaradeGancho" ou, às vezes, apenas "Tire o Gancho".');
INSERT INTO "item_descriptions" VALUES(11579,'pt','Os joalheiros frigostianos costumavam dar bons conselhos quanto tinham pequenas joias à venda: não dê joias muito pesadas para as mãos do seu amor ou ela pode ter problemas para limpar as prateleiras superiores.');
INSERT INTO "item_descriptions" VALUES(11580,'pt','Este manto poderia ter sido um belo lençol em uma cama, mas o alfaiate que o fez dormia em uma rede.');
INSERT INTO "item_descriptions" VALUES(11581,'pt','Um pouco rígida, um pouco pesada e de uma era completamente diferente, esta capa o lembra de um antigo colega que costumava quebrar pedras na mina.');
INSERT INTO "item_descriptions" VALUES(11582,'pt','Se você correr pela neve com essas botas no seu pé, deixará pegadas de Papamute Real. A única coisa que faltará e a marca do rabo.');
INSERT INTO "item_descriptions" VALUES(11583,'pt','As botas não fazem você andar graciosamente. Mas como seu passado nunca muito gracioso, ninguém vai notar.');
INSERT INTO "item_descriptions" VALUES(11584,'pt','Este item era usado como um cinto de castidade, o que é surpreendente quando você leva em consideração o quanto o Papamute Real gosta de colocar suas chaves em uma tigela e dar uma grande festa.');
INSERT INTO "item_descriptions" VALUES(11585,'pt','Este cinto também podia ser vestido como uma tanga. Sem ele, Ben, o Ripata não poderia esconder a sua mais preciosa, invejada e cobiçada joia. Marinheiros, com inveja de seu enorme tesouro, o apelidaram, com motivos apenas conhecidos por eles, de “visionário torto” ou o “bucaneiro devastado”. Quando ele foi enforcado pela décima terceira vez, ele berrou para o público, “Meu tesouro para alguém que me compreenda!”');
INSERT INTO "item_descriptions" VALUES(11586,'pt','Como todo verdadeiro pirata-fantasma de respeito, Ben, o Ripata, tinha uma espada para cortar todas as cabeças que via pela frente. Mas ele era tão sensível que sempre derramava uma lágrima quando fazia isso. Seus oponentes que perderam a cabeça usaram essa anedota antes de morrer para dar a ele o apelido de "O Sabre Chorão".');
INSERT INTO "item_descriptions" VALUES(11598,'pt','Você sabe como eles chamam por você na guilda? Não? Ah, bom, com este capacete, vai entender o porquê.');
INSERT INTO "item_descriptions" VALUES(11599,'pt','Não é segredo que Frighog gosta de se fazer de porco. Agora, eu posso justificar fazendo a mesma coisa.');
INSERT INTO "item_descriptions" VALUES(11600,'pt','É difícil dizer se o Yuara Pirate escolheu esta máscara de propósito, ou se ele foi vítima de uma batida marítima violenta contra uma concha. Também é difícil dizer quem é o pior nessa - a concha ou o pirata.');
INSERT INTO "item_descriptions" VALUES(11601,'pt','Às vezes chamado de “cabeça de girino”, o Harpy Pirate não gosta de piadas com frutos marinos, e ele gosta ainda menos de piadas envolvendo frutos marinhos e a mãe dele.');
INSERT INTO "item_descriptions" VALUES(11602,'pt','Popu Ry era um frigostiano famoso por esconder tudo sob o seu chapéu. Tudo mesmo, qualquer coisa. Seu chapéu tinha a mesma característica da bolsa de uma mulher aventureira: são os únicos recipientes cujo conteúdo excede o volume de capacidade, desafiando todas as leis da física frigostiana moderna.');
INSERT INTO "item_descriptions" VALUES(11603,'pt','Este chapéu combina apenas com cabelos loiros.');
INSERT INTO "item_descriptions" VALUES(11604,'pt','O alfaiate que fez este chapéu tinha certeza de que o futuro de Frigost seria muito obscuro. Como todos os profetas de climas amenos, ele estava errado. O futuro de Frigost é apenas frio.');
INSERT INTO "item_descriptions" VALUES(11605,'pt','Costureiros ingênuos de Frigost acham que esta capa é uma versão melhorada da cape Arixo. Há uma inscrição na etiqueta da capa: “Esta capa tem esse nome por conta da sua habilidade de se tornar transparente no traseiro, se este for de certa forma, grande”. Você acabou de perceber que todos podem ver as suas nádegas.');
INSERT INTO "item_descriptions" VALUES(11606,'pt','Esta capa chama a atenção e proporciona distração. Se mandarem você vesti-la no campo de batalha, estime com maior precisão a sua expectativa de vida.');
INSERT INTO "item_descriptions" VALUES(11607,'pt','Uma cantora conhecida como Van Husa usava esse colar quando era jovem. Todos os fãs dela usavam o mesmo colar. Se você decidir fazer o mesmo, não se surpreenda se até os monstros de Incarnam zombarem do seu gosto musical.');
INSERT INTO "item_descriptions" VALUES(11608,'pt','A manutenção e mantimento deste talismã salvador de vidas é financiado pelos generosos participantes da competição Blop Eater.');
INSERT INTO "item_descriptions" VALUES(11609,'pt','Toda vez que você coçar o pescoço, este amuleto fará suas cordas vocais vibrarem, produzindo o seguinte som: "Dzoing Dzoing". Se isso não ajudar a atrair um companheiro, não podemos fazer mais nada por você.');
INSERT INTO "item_descriptions" VALUES(11610,'pt','Não há dúvida. Essa tanga já pertenceu a pelo menos um Kaniglu, ou talvez a vários. Um pouco demais para você.');
INSERT INTO "item_descriptions" VALUES(11611,'pt','Essa cueca que combina com cabelos compridos e vem com um cinzeiro embutido e compartimento para palhetas. Antes da glaciação de Frigost, elas eram muito populares entre jovens rebeldes que cortavam a grama para consumo pessoal. Sem dúvida se tratavam de criadores que queriam alimentar seus Papatudos.');
INSERT INTO "item_descriptions" VALUES(11612,'pt','Se você olhar fixamente para essa cueca, movendo a cabeça da esquerda para direita durante vários dias, talvez você acabe pegando no sono.');
INSERT INTO "item_descriptions" VALUES(11617,'pt','Estas botas foram feitas para serem vestidas por frigostianos que tinham pais frigostianos, cujos pais fossem frigostianos e que os pais de seus pais fossem frigostianos. Se você não for um frigostiano, não recomendamos que você use essas botas.');
INSERT INTO "item_descriptions" VALUES(11618,'pt','Diz a lenda que estas sandálias foram batizadas em homenagem a um grande matemático frigostiano chamado Hannibal Goritmo. Ele sempre usava sandálias, mesmo depois da glaciação da ilha. Ele costumava andar em círculos na neve até encontrar a condição que o obrigaria a interromper seu passeio. Normalmente, essa condição era quando seus dedos do pé congelavam.');
INSERT INTO "item_descriptions" VALUES(11619,'pt','Em breve você poderá combinar estas sandálias com a cor do seu cabelo ou com a bandeira que você estará carregando na sua próxima luta contra um Perceptor.');
INSERT INTO "item_descriptions" VALUES(11620,'pt','Este anel poderia ter prevenido algumas das decepções marítimas de Ben, o Ripata. Em vez de beber em um copo, ele poderia abrir garrafas de Cocadapreta, a famosa bebida que faz você se sentir um rei.');
INSERT INTO "item_descriptions" VALUES(11621,'pt','Se você não colocar em um dedo, este anel irá embora por conta própria. Também pode lhe servir como desculpa se você não conseguir ficar com a mão parada e sempre colocar os dedos em lugares que não couberem.');
INSERT INTO "item_descriptions" VALUES(11622,'pt','O artista frigostiano que fez este anel quase morreu de cansaço tentando escrever algo interessante no seu rótulo. Ele preferiu “ir fazer outra coisa". O que, traduzido para frigostiano, significa “vá até todos os lugares e perambule pelo vilarejo".');
INSERT INTO "item_descriptions" VALUES(11623,'pt','Esta típica criação frigostiana foi feita por um artista cujo sangue jamais ficou frio, nem nas mãos.');
INSERT INTO "item_descriptions" VALUES(11624,'pt','A lâmina deste sabre foi feita especialmente para abrir caminho no campo de batalha com sucesso. Quando é enfeitado com plumas coloridas, ele também faz sucesso no carnaval.');
INSERT INTO "item_descriptions" VALUES(11625,'pt','Este machado era muito usado pelos açougueiros de Frigost, que cortavam as carnes em pedaços minúsculos para que ninguém percebesse que estava comprando cloaca de Gelikano. Esta prática provocou a morte de muitos clientes, o que explica a má reputação da gastronomia frigostiana hoje em dia.');
INSERT INTO "item_descriptions" VALUES(11626,'pt','É difícil dizer se isso é um machado ou uma âncora. O próprio Talklyka Pirate não sabe a resposta para essa pergunta. Quando está com dúvida, ele usa como um machado contra todos os aventureiros que encontra.');
INSERT INTO "item_descriptions" VALUES(11627,'pt','Este arco usa uma matemática frigostiana muito simples para calcular a altura de alguns prédios com muita eficiência. Infelizmente, não dá nenhuma indicação da unidade de medida usada no resultado.');
INSERT INTO "item_descriptions" VALUES(11628,'pt','Esta pá pertencia a um bardo. Seu estilo de música pioneiro - pressionando as teclas do instrumento deles com uma pá - não foi rapidamente recebido pelos moradores de Frigost. Ele também tinha uma bela coleção de perucas e óculos.');
INSERT INTO "item_descriptions" VALUES(11629,'pt','Essas adagas pertenciam a um famoso Sram que amava se exibir na frente dos corajosos do vilarejo. Ele era renomado por seus títulos no Campeonato de Arremesso de Cidra. Arremesso de Cridra é um jogo bem estúpido que consiste em beber muito café na casa de um amigo, tentar pegar um pedaço de madeira e jogar a maior quantidade deste líquido no chão daquele que está organizando o jogo. Um jogo patrocinado com muito carinho pelos donos de loja de tapete de Frigost.');
INSERT INTO "item_descriptions" VALUES(11630,'pt','Este martelo foi feito com o único propósito de poder dar tapas no YeCh''Ti. Sua função original se perdeu um pouco depois que os frigostianos descobriram que ele funciona bem em todas as criaturas que apresentam pelo menos alguma destas características: pelos longos, bafo de arenque, cara de idiota e olhar ameaçador. Agora você já sabe por que foi atingido por este martelo no passado.');
INSERT INTO "item_descriptions" VALUES(11631,'pt','O Vigi Pirata tinha um estilo de combate bastante peculiar. Ele começava descrevendo seu martelo, tipo: “É pesado, machuca e flutua”. Seus inimigos então perguntavam: “E daí que ele flutua?”. Isso dava ao Vigi Pirata tempo suficiente para esmagar seu advers... *splat*');
INSERT INTO "item_descriptions" VALUES(11632,'pt','Esta vara foi feita por um frigostiano especialista em discrição e furtividade. No manual de instruções está escrito: "Se você surpreender seu inimigo chegando por trás para dar um bom golpe de varinha bem no traseiro dele e, de repente, sentir vontade de espirrar, enfie rapidamente a varinha na sua narina e conte até três".
Você tem que pagar pelo guia do usuário para saber qual das narinas deve ser tapada.');
INSERT INTO "item_descriptions" VALUES(11633,'pt','É bem macio e todos sabem que tacos bem-sucedidos são difíceis. O que pode ser feito com um soft stick. Provavelmente a mesma coisa com uma baguete macia');
INSERT INTO "item_descriptions" VALUES(11634,'pt','É difícil acreditar que a magia deste bastão vem da decomposta cabeça de peixe que está pendurada na extremidade. O mistério por trás disso tudo também ajuda a explicar as boas ideias vindas da sua cabeça.');
INSERT INTO "item_descriptions" VALUES(11635,'pt','Esta lança, munida um pedaço de concha afiada, pode ser usada como arpão, dardo e até como suporte para barraca. Se você esbarrar com um Arpirata, nunca peça uma demonstração.');
INSERT INTO "item_descriptions" VALUES(11667,'pt','Estas botas foram feitas para serem vestidas por frigostianos que tinham pais frigostianos, cujos pais fossem frigostianos e que os pais de seus pais fossem frigostianos. Se você não for um frigostiano, recomendamos que você não use essas botas.');
INSERT INTO "item_descriptions" VALUES(11686,'pt','Não há dúvida. Essa tanga já pertenceu a pelo menos um Kaniglu, ou talvez a vários. Um a menos, agora.');
INSERT INTO "item_descriptions" VALUES(11706,'pt','Este chapéu combina apenas com cabelos loiros.');
INSERT INTO "item_descriptions" VALUES(11707,'pt','Se você usar este chapéu, boa parte da população feminina do Mundo dos Doze vai achar que você parece um brinquedinho fofinho de apertar. Se sua intenção é aterrorizá-las com os restos mortais de um monstro tão feroz quanto o Tengu Gelifox, não vai dar certo.');
INSERT INTO "item_descriptions" VALUES(11708,'pt','O Tengu Gelifox e seus primos Gelifox não têm um rabo triplo, então por que você pediu para o alfaiate costurar uma capa com três partes? Você deve ter um profundo complexo de inferioridade.');
INSERT INTO "item_descriptions" VALUES(11709,'pt','Ao pegar bandagens suficientes do Tengu Gelifox para fazer esse cinto, você mesmo precisará de gesso.');
INSERT INTO "item_descriptions" VALUES(11710,'pt','Feitas de pele de Gelifox, esses chinelos são bastante confortáveis para você colocar seus dedos dentro. Mas coloque só três deles.');
INSERT INTO "item_descriptions" VALUES(11711,'pt','Você não acha um pouco sádico cortar madeira com um machado de madeira? Provavelmente sim, por isso você não consegue parar de matar todos aqueles pobres Papatudos.');
INSERT INTO "item_descriptions" VALUES(11712,'pt','O slogan dessa capa dizia: “Nunca copiada, mas frequentemente igualada, esta capa se distingue principalmente por suas costuras duplas que a tornam mais resistente que as capas que não a copiam, mas se igualam a ela". De repente, você tem a impressão de que foi enganado.');
INSERT INTO "item_descriptions" VALUES(11713,'pt','Este amuleto era muito popular em Frigost. Mas isso foi há séculos.');
INSERT INTO "item_descriptions" VALUES(11714,'pt','O fedor desse anel faz você pensar que alguém o usava em seus dedos do pé.');
INSERT INTO "item_descriptions" VALUES(11715,'pt','A expressão “cara de bunda” descreve perfeitamente você usando esse capacete.');
INSERT INTO "item_descriptions" VALUES(11716,'pt','Esse cinto coberto de pelo mantém suas coxas quentes, então queima a gordura de seus pneuzinhos um pouco mais rápido.');
INSERT INTO "item_descriptions" VALUES(11717,'pt','Piotre nasceu em uma velha fazenda coletiva em Frigost, perto do Lago Congelado. Ele criou esse anel achando que tinha conseguido reinventar o cortador de grama de dedo. Ele cortou sua mão só 3 vezes.');
INSERT INTO "item_descriptions" VALUES(11718,'pt','Quando o Glurseleste quer fazer um lanchinho fora de sua colmeia, ele veste essa máscara para se passar por um Glursomel. Infelizmente, sua barriga o denuncia.');
INSERT INTO "item_descriptions" VALUES(11719,'pt','Quando a Colmeia dos Glursos está meio parada, os Glursos utilizam essa capa como trenó por diversão. Um estudo Frigostiano completo sobre suas características e comportamento mostrou que eles são péssimos para evitar obstáculos e geralmente protegem suas mãos com suas cabeças.');
INSERT INTO "item_descriptions" VALUES(11720,'pt','Um mel delicioso, mas assustadoramente grudento, escorre desse amuleto. Se você colocá-lo em seu pescoço, ganhará uma moderna depilação grátis em todo o seu busto. Se você realmente quiser colocá-lo em sua boca, é aconselhável que faça isso antes de colocá-lo em seu pescoço, a não ser que você goste de receitas baseadas em pelo corporal.');
INSERT INTO "item_descriptions" VALUES(11721,'pt','Há alguns caçadores Frigostianos que dizem ter visto o Glurseleste colocar esse cinto em cima de sua barriga por engano, mas são os mesmos caçadores que dizem ter visto um YeCh''Ti em Frigost.');
INSERT INTO "item_descriptions" VALUES(11722,'pt','Os Glursos estão trabalhando há gerações para produzir a sola perfeita: uma que não grude no mel.');
INSERT INTO "item_descriptions" VALUES(11723,'pt','Todos acham que você fica ridículo quando usa isso, mas ninguém fala nada. Mas agora você sabe o que eles estão pensando, apesar de eles não saberem que você sabe o que eles estão pensando. O mais importante é que você sabe que eles não sabem que você sabe o que eles estão pensando.');
INSERT INTO "item_descriptions" VALUES(11724,'pt','Usado antigamente por homens Frigostianos de má reputação, esse chapéu agora se tornou um item indispensável da moda. Na etiqueta, está escrito: “Esse chapéu atrairá todo tipo de criatura selvagem que quer seu corpo e não o seu ouro.” Mas não está claro se estão falando das Frigostianas mulheres da Vila Frigost ou das criaturas que moram na floresta.');
INSERT INTO "item_descriptions" VALUES(11725,'pt','Sonolento, preguiçoso, desinteressado, vagabundo - são todos adjetivos que podem ser usados para quem usa essa toca. Preste atenção, ela certamente irá acalmar as pessoas em uma falsa noção de segurança. Seus inimigos abaixarão sua guarda, os monstros vão ignorá-lo e atacar seus amigos em seu lugar, as pessoas tratarão você como um vadio, você não vai conseguir nenhum trabalho, sua parceira lhe abandonará, todos esquecerão de você. E na hora pareceu ser uma ótima ideia usá-la :(');
INSERT INTO "item_descriptions" VALUES(11726,'pt','Use essa capa sobre seus ombros e depois conspire contra o Rei Allister, o que fará que você, entre outras coisas, coma mais Salada de Porco mais frequentemente, ou até mesmo arme um guarda-sol. Mas então você não pode deixar que ele o veja!');
INSERT INTO "item_descriptions" VALUES(11727,'pt','Essa criação muito bruta não tem forma igual, nenhum apelo estético e parece que vai desmoronar com o mais leve dos toques. Entretanto, ela é muito poderosa. Aposto que por essa você não esperava.');
INSERT INTO "item_descriptions" VALUES(11728,'pt','Antes da glaciação, o Conde Traspafrent teria dito que se todas a capas Picultor desaparecessem da ilha de Frigost, o Mundo dos Doze sobreviveria por apenas mais quatro anos. Na verdade, ele nunca disse isso, é apenas um boato espalhado por Picultor, o criador da capa, que estava prestes a abrir falência. Depois disso, ele ficou extremamente rico.');
INSERT INTO "item_descriptions" VALUES(11729,'pt','Cetera era um guerreiro terrivelmente poderoso, mas ele não pôde concluir o que começou. Ele mutilava seus oponentes às dúzias sem nunca matar nenhum deles.  Ele morreu no dia em que decidiram se juntar contra ele para se vingarem. Agora, você vai pensar duas vezes antes de poupar a vida de alguém, não vai?');
INSERT INTO "item_descriptions" VALUES(11730,'pt','O joalheiro que criou esse amuleto era um pouco louco e o montou sem respeitar as regras básicas da joalheria Frigostiana, usando cada componente individual mais diferente que o outro. Por algum milagre desconhecido, ele teve muito sucesso.');
INSERT INTO "item_descriptions" VALUES(11731,'pt','Pegue seu Amuleto Bandeira de Guerra, monte no seu Dragoperu mais fogoso, use sua arma mais brilhante, segure seu escudo para o alto e leve seus homens à vitória com a maior demonstração de cavalheirismo que o Mundo dos Doze já viu! A diante! Mas veja bem, tome cuidado para não assustar muito as pessoas se você não quiser acabar na fogueira.');
INSERT INTO "item_descriptions" VALUES(11732,'pt','Há muito tempo, os caçadores Frigostianos pensam sobre o significado da frase escrita nessa tanga. Depois de muito debate, eles concluíram que deve ser um aviso sobre o odor que ele deve esconder.');
INSERT INTO "item_descriptions" VALUES(11733,'pt','Se você estiver parado em uma brisa ou atravessando uma forte corrente, você vai gerar uma quantidade enorme de energia se estiver usando esse cinto. O que fará com ela é você quem sabe.');
INSERT INTO "item_descriptions" VALUES(11734,'pt','Esse cinto, que radia uma luz florescente verde, murchará qualquer flor à sua volta, fará suas invocações parecerem originais e matará seus inimigos (muito) lentamente. Garantia de 4,47 bilhões de anos.');
INSERT INTO "item_descriptions" VALUES(11735,'pt','O joalheiro que fez esse anel que você passa de geração em geração não era lá muito talentoso. O “N" que orna seu sinete aparece ao contrário quando você sela um envelope com ele.');
INSERT INTO "item_descriptions" VALUES(11736,'pt','Esse anel extremamente poderoso fará que você manipule como uma marionete a pessoa que usá-lo. Este é o momento perfeito para você salvar o seu casamento.');
INSERT INTO "item_descriptions" VALUES(11737,'pt','Esse anel, que parece ter tendências suicidas, necessita da sua atenção constante. Se você parar de observá-lo, há uma grande chance de ele rolar inexoravelmente até o penhasco mais próximo e se jogar.');
INSERT INTO "item_descriptions" VALUES(11738,'pt','O nome estranho desse anel vem da exclamação de surpresa que ele tira de jovens aventureiros quando o veem pela primeira vez, uma exclamação entre outras como "zomghax”, “revoltoso! chocante! escandaloso!” e “sai daqui”. Os habitantes do Mundo dos Dozes agem misteriosamente.');
INSERT INTO "item_descriptions" VALUES(11739,'pt','Quando estiver correndo, essas botas vão ajudar você a manter uma velocidade constante sem esforço extra de sua parte, desde que ninguém tente parar você. Infelizmente, elas são tão pesadas que você não consegue colocar um pé na frente do outro. Você será um excelente saco de pancadas. Muito estável.');
INSERT INTO "item_descriptions" VALUES(11740,'pt','O sapateiro que confeccionou estas botas era muito inovador. Ele a cobriu com muitos buraquinhos para que odores desagradáveis escapassem em vez de ficarem impregnados nas próprias botas. Como resultado, você vai feder como nunca, mas suas botas não terão o menor cheiro.');
INSERT INTO "item_descriptions" VALUES(11741,'pt','Essas sandálias têm uma falha grave em seu modelo: elas podem ser perfeitas para escalar os picos mais altos de Frigost, mas não são nada mais do que meias com uma sola grossa e seus dedos podem muito bem cair se você tentar escalar o Monte Tórrido com elas.  Mas elas ainda são ótimas para dar golpes baixos em seus oponentes.');
INSERT INTO "item_descriptions" VALUES(11742,'pt','Essa espada é tão pequena que você vai ter que se esticar se quiser atingir pessoas com ela. Claro, será quase impossível para você ferir seus inimigos, mas tente ver pelo lado positivo para variar. Pelo menos, você não vai mais machucar seus aliados.');
INSERT INTO "item_descriptions" VALUES(11743,'pt','Essa lâmina é a arma favorita de dentistas, caçadores de porcos do mato e caçadores dentistas de porcos do mato.');
INSERT INTO "item_descriptions" VALUES(11744,'pt','A lâmina desta arma fica mole quando as suas pernas começam a tremer, dando a você um ótimo pretexto para fugir como um covarde.');
INSERT INTO "item_descriptions" VALUES(11745,'pt','Supõe-se que esse estranho martelo possa fazer seus inimigos verem seu futuro quando você os atinge na cabeça com ele. Parece que ele não está funcionando direito, pois a única coisa que eles veem é sangue. Talvez você esteja batendo neles forte demais.');
INSERT INTO "item_descriptions" VALUES(11746,'pt','Esse martelo emana virilidade, força bruta, suor e ao contrário do que se espera, cabelo. Ele lhe lembra do Minotoror mais que tudo. É evidente que, com essa pequena maravilha em suas mãos, até mesmo os bezerros mais delicados seriam capazes de criar uma carnificina jamais vista.');
INSERT INTO "item_descriptions" VALUES(11747,'pt','Esse grande martelo coberto com mel atrai os gulosos e alimenta os moribundos.');
INSERT INTO "item_descriptions" VALUES(11748,'pt','Thanos praticou todo tipo de ocupações desagradáveis: sargento instrutor, banqueiro, agiota, contador de história e ocasionalmente profeta do S.L.I.P. Ele usava seu bastão para punir seus aprendizes e qualquer um que o ouvisse, um habito diário que certamente o manteve em forma.');
INSERT INTO "item_descriptions" VALUES(11749,'pt','Esse é o cajado perfeito para se proteger do sol e também para causar debates calorosos entre seus colegas. É realmente um guarda-sol ou é um guarda-chuva?');
INSERT INTO "item_descriptions" VALUES(11750,'pt','Se você decidiu se tornar um furtivo distribuidor noturno da justiça, então esse cajado foi feito para você! Combina muito bem com visuais negros e ânimos ainda mais escuros, ele tem o poder mágico extraordinário de ser completamente invisível na escuridão total.');
INSERT INTO "item_descriptions" VALUES(11751,'pt','Com este par de adagas, você poderá realizar duas boas ações de uma só vez: distribuir doces e se livrar de crianças irritantes.');
INSERT INTO "item_descriptions" VALUES(11752,'pt','Estas adagas são incrivelmente incômodas: provocam arrepios, mal-estar irritação... Se parecem muito com a sua sogra. Você já está ansioso com a possibilidade de compartilhar essas sensações com o seu pior inimigo.');
INSERT INTO "item_descriptions" VALUES(11753,'pt','Aguirre Godswrath era um aventureiro em busca de conquistas e um conquistador em buscas de aventuras. Ele não achou o que procurava em Frigost, mas acabou encontrando tudo que ele não estava procurando. Ele era conhecido por gritar seu nome toda vez que matava um inimigo. Ele perdeu sua voz depois de atacar uma hidra. Você quer saber como? Bem, suas cabeças não paravam de crescer de volta.');
INSERT INTO "item_descriptions" VALUES(11754,'pt','Ao mesmo tempo atual e efêmero, este arco é considerado uma obra de arte com por uma pequena minoria de aventureiros, devido ao seu formato e cor extremamente raros. Eles se chamam de artistas, vanguardistas ou incompreendidos, depende da situação. Se você deixá-los quebrando suas cabeças para descobrir uma maneira de serem úteis no combate, terá tempo suficiente para parti-los em dois.');
INSERT INTO "item_descriptions" VALUES(11755,'pt','O criador desse arco era muito famoso, pois dedicou sua vida à criação de armas de excelente qualidade, apesar de serem muito básicas. Ao fim de sua vida, ele se arrependeu por nunca ter criado nada de especial e esculpiu esse arco, sua primeira e única obra criativa. Pode parecer estranho, mas você com certeza vai achar que ele é muito útil.');
INSERT INTO "item_descriptions" VALUES(11756,'pt','Esse arco vem de antes da glaciação de Frigost. Por ser antigo, ele caiu no desuso até muito recentemente, quando uma pequena criança que achou uma cópia antiga em um sótão devastou um exército de Papamutes que se preparavam para invadir o Burgo.');
INSERT INTO "item_descriptions" VALUES(11757,'pt','Essa varinha permitia que Frigostianos conhecidos que estavam estudando as características sociais e culturais dos habitantes de Frigost identificassem facilmente uns aos outros. Também era um sinal identificável para monstros que procuravam presas com mais cérebro do que músculos.');
INSERT INTO "item_descriptions" VALUES(11758,'pt','No cabo de madeira dessa varinha, está escrita a seguinte inscrição: “A desonra dessa sobrinha durará por toda a eternidade”. Deve ser alguma mensagem em código, a não ser que o entalhador quisesse escrever: “A honra dessa varinha durará por toda a eternidade”.');
INSERT INTO "item_descriptions" VALUES(11759,'pt','Esta varinha é a arma ideal para repreender os  seus adversários ou designar os aliados que deverão lutar primeiro.');
INSERT INTO "item_descriptions" VALUES(11760,'pt','Esse machado era de um famoso assassino que tinha o prazer perverso de pular sobre palheiros do topo das torres do Castelo de Allister.');
INSERT INTO "item_descriptions" VALUES(11761,'pt','As chances de cruzar um campo do Machado Teroid com sucesso são de uma em três milhões setecentas e vinte.');
INSERT INTO "item_descriptions" VALUES(11762,'pt','Essa pá vem de um lugar mítico em que se acredita que o ouro seja abundante. Dizem que o próprio Aguirre procurou esse país por anos. Ele acabou a sua vida em uma jangada com apenas essa mísera pá para usar como remo.');
INSERT INTO "item_descriptions" VALUES(11763,'pt','Essa pá combina muito com cabelos compridos e orelhas pontudas e vai acordar a mágica que dorme dentro de você. Ela também faz maravilhas ao seu lado feminino.');
INSERT INTO "item_descriptions" VALUES(11765,'pt','Esta bolinha felpuda odeia ser acariciada a contrapelo. Pelo sim, pelo não, é melhor não irritá-la.');
INSERT INTO "item_descriptions" VALUES(11771,'pt','Não adianta perguntar nada, ela boia.');
INSERT INTO "item_descriptions" VALUES(11777,'pt','Esta pequena mascote sabe esconder as suas nozes para protegê-las. Não espere encontrá-las de novo, já que ela vive esquecendo onde as esconde.');
INSERT INTO "item_descriptions" VALUES(11783,'pt','Mais rabugenta que um Pekefox, mas com axilas bem menos peludas, esta mascote é famosa por ter mordido a Dama Antium sem quebrar nem um dente.');
INSERT INTO "item_descriptions" VALUES(11792,'pt','Você se destaca no domínio das quatro energias elementares primordiais e quer que todos saibam.  Mas tome cuidado, pois este amuleto pode lhe pregar peças.');
INSERT INTO "item_descriptions" VALUES(11794,'pt','Duas cópias dessa raiz foram criadas por um famoso biólogo Frigostiano e elas deveriam ajudar os habitantes da Vila Snowbound a se livrarem das criaturas vegetais da Floresta Petrificada.
Os biólogos desapareceram sem deixar nenhum tipo de instrução sobre como usá-las e seu filho, que saiu para procurá-lo, nunca encontrou nenhum vestígio. Os habitantes da ilha, os Frigostianos, tentaram recriar os efeitos das duas raízes e o que você tem em suas mãos é apenas uma cópia tosca do original.');
INSERT INTO "item_descriptions" VALUES(11811,'pt','Um par de belas botas para caminhadas em Brakmar.');
INSERT INTO "item_descriptions" VALUES(11816,'pt','Você não tem certeza se esse cinto pinica ou coça. Mas não importa, porque a não ser que você use algo por baixo na Festa da Cueca do Capitão Chafer, ele vai enlouquecer você.');
INSERT INTO "item_descriptions" VALUES(11819,'pt','Este martelo, que é tão pesado quanto o humor do Ratodogue, é perfeito para esmagar os cascos do Minotoror. Também é eficaz se você quiser esmagar outras partes do corpo igualmente sensíveis.
Ele pode ser trocado com Latem Sa, no ateliê dos ferreiros de Astrub.');
INSERT INTO "item_descriptions" VALUES(11820,'pt','Demorou alguns séculos para construírem essa pá feita de pó de barra de ouro, mas valeu a pena esperar. Ela é muito útil para cortar fora a cabeça de monges ou para cortar um pedaço de torta de Zoug.');
INSERT INTO "item_descriptions" VALUES(11850,'pt','Este slip é o traje cerimonial dos profetas do S.L.I.P. Eles são os únicos que podem usá-lo sem o risco de terem suas cabeças (ou qualquer outra parte sensível de sua anatomia) cortadas.');
INSERT INTO "item_descriptions" VALUES(11855,'pt','Essas sandálias têm bastante espaço para você conseguir pegar Kamas com seus dedos dos pés. Seu formato também é apropriado para dar golpes nos sacos de seus inimigos para você recuperar as joias de suas famílias mais facilmente.');
INSERT INTO "item_descriptions" VALUES(11856,'pt','Você pode guardar as joias de sua família com segurança nos dois sacos enormes desse cinto.');
INSERT INTO "item_descriptions" VALUES(11857,'pt','Esta pá pode fazer de tudo: cavar a terra, coletar kamas, bater em bandidos e até mesmo repelir a sua sogra. Como você pode ver, ela é indispensável.
Ela pode ser trocada com Latem Sa, no ateliê dos ferreiros de Astrub.');
INSERT INTO "item_descriptions" VALUES(11858,'pt','Este Tofu caiu em um caldeirão de queijo quando era pequeno. Desde então, ele ficou mais rechonchudo e é motivo de piada entre os outros. Não seja por isso: ele decidiu se assumir e comer todos os recursos que lhe entregarem.');
INSERT INTO "item_descriptions" VALUES(11947,'pt','Não se deixe levar pelas aparências. Este machado pode não ser muito sofisticado, mas é capaz de cortar duas vezes mais árvores e turistas congelados do que um machado comum.');
INSERT INTO "item_descriptions" VALUES(11950,'pt','Temido por outras mascotes pelos seus dentes de meter medo em vampiro, ele passou a infância inteira isolado dos outros e teve problemas de socialização, até você adotá-lo.');
INSERT INTO "item_descriptions" VALUES(11955,'pt','Depois de adulto, este bichinho dará um charme frigostiano incrível. Como seu primo de Amakna, ele adora carinho. Enquanto não cresce, ele vai cobrir você de beijos para demonstrar sua afeição.');
INSERT INTO "item_descriptions" VALUES(11966,'pt','O pelo desse pequeno e doce Texmen é macio como o bumbum de uma Mamãe Bwork, mas não se engane: sua aparência fofa tranquilizava seus companheiros, dando-lhes uma falsa noção de segurança, e ele os devorava enquanto dormiam. Porém, o humor dele melhorou desde que você o adotou. Agora, ele parte para cima de qualquer criatura, esteja ela acordada ou não.');
INSERT INTO "item_descriptions" VALUES(11971,'pt','Este filhote de Glurso escapou do laboratório do professor Coração de Obsidiana e foi resgatado pela Vovó Laisol. Muito carente, ele vai tentar beijá-lo sempre que tiver oportunidade. É melhor passar protetor labial nele para que seus lábios não ressequem.');
INSERT INTO "item_descriptions" VALUES(11976,'pt','A maioria dos aventureiros achará que esse amuleto é bastante difícil de usar, não por causa de seu peso, nem porque seus requisitos são muito exigentes, nem por ser muito fraco, mas por causa do bigode que o enfeita. É provavelmente por ele usar seu bigode tão bem que Boostache é um monstro tão respeitado.');
INSERT INTO "item_descriptions" VALUES(11977,'pt','O Kanibola Phora teve muitas mulheres, uma mais bonita que a outra. Ele chegou ao ponto de dizer que elas eram deliciosas. Ninguém sabe o que aconteceu com elas.');
INSERT INTO "item_descriptions" VALUES(11978,'pt','Não importa como Boostache perdeu o seu anel, ele não tem nenhum dedo. A única coisa que importa para ele é o seu bigode. É um belo tesouro esse que você está segurando.');
INSERT INTO "item_descriptions" VALUES(11979,'pt','O Kanibola Phora só usa essas botas quando está lutando com os guerreiros mais corajosos do Mundo dos Doze. Vai demorar um pouco até que você o veja usando para lutar contra você.');
INSERT INTO "item_descriptions" VALUES(11980,'pt','Essa capa, assim como o Boostache, brilha no escuro. Como resultado, você vai fracassar toda vez que tentar invadir a casa de sua ex-namorada, não vai mais conseguir dormir à noite e vai irritar todos os membros de sua guilda. Exatamente o que você precisa para animar a sua existência tediosa.');
INSERT INTO "item_descriptions" VALUES(11981,'pt','Quando criança, Boostache adorava brincar de Salada Mista. Ele ainda adora assustar aventureiros, os parando bruscamente se eles dão as costas. Olhando como se nada tivesse acontecendo, ele os ataca violentamente quando finalmente os alcança. Pode ser infantil e irritante, mas funciona.');
INSERT INTO "item_descriptions" VALUES(11982,'pt','Agora que você sabe que o Kanibola Phora usa um capuz por baixo de seu capacete, um capuz com dois buracos para os olhos, você de repente percebe que essa máscara ciclóptica deve ter deixado o coitado completamente cego.');
INSERT INTO "item_descriptions" VALUES(11983,'pt','Nas mãos do Kanibola Phora, este cetro libera estranhos poderes mágicos capazes de fazer com que totens enormes caiam na cabeça de seus adversários. Nas suas mãos, ele fica ridículo e não chama a atenção nem dos seus aliados.');
INSERT INTO "item_descriptions" VALUES(12009,'pt','Tão velho e estiloso quanto um Enutrof e tão carinhoso quanto a Deusa Eliatrope, este Ornito brilha dia e noite. As histórias infantis contam que ele é originário de Sufokia e o último vestígio de uma antiga civilização, mas a veracidade dessas informações nunca foi comprovada.');
INSERT INTO "item_descriptions" VALUES(12018,'pt','Seguindo o exemplo dado pelos seus súditos, os Kwaks, o Kwakwa tem uma lâmina com o seu mesmo.  Apesar de não sabermos por que, ou para qual ocasião, um pássaro usaria uma espada, ela parece ser muito mais leve e fácil de usar do que uma Kwakblade. Seus inimigos podem ficar bem e completamente depenados.');
INSERT INTO "item_descriptions" VALUES(12019,'pt','Apesar de não ter um mestre, o Kwakwa tem um anel de identificação. Ele usa os anéis de Kwaks para identificar e encontrá-los quando eles se perdem, para eles poderem ser levados de volta ao ninho em segurança. Ele usa esse anel para que ele possa encontrá-lo quando ele se perde procurando por Kwaks perdidos. Eles andam tanto em círculos que nunca saíram da montanha dos Smagadores.');
INSERT INTO "item_descriptions" VALUES(12020,'pt','Para seduzir as Kwakeres, o Kwakwa faz seu ritual de acasalamento que consiste em mostrar as penas do seu rabo. Fazendo isso, ele faz um baita papel de bobo, já que ele só tem cinco penas. Esse é um exemplo perfeito do antigo provérbio, “faça uma mulher gargalhar que com sua vara ela brincará”.');
INSERT INTO "item_descriptions" VALUES(12021,'pt','Além de cobrir o seu pequeno cérebro de pássaro, esse chapéu dará a você uma postura soberba e pode até fazer você esquecer que é um cabeça de ovo. O que mais pode desejar?');
INSERT INTO "item_descriptions" VALUES(12023,'pt','O cinto de Traçon, bem preso à barriga por duas faixas, absorvia as vibrações. Somado à gordura da pança, ele o deixava completamente imune aos efeitos de seus próprios ataques.');
INSERT INTO "item_descriptions" VALUES(12024,'pt','Estas pesadas botas quadradas de metal forçavam Traçon, que conseguia manipular as vibrações, a empregar toda a sua energia para atenuar o barulho dos passos. Sem isso, ele poderia ser ouvido a quilokâmetros de distância. E ainda por cima elas atrapalhavam no papabol.');
INSERT INTO "item_descriptions" VALUES(12025,'pt','Como tinha o ouvido muito sensível, Traçon tirou a engrenagem principal de seu relógio para acabar com o tique-taque incessante e usá-la de amuleto. Depois disso, toda pessoa que ele encontrava fazia questão de dizer ele não chegou na hora certa, o que o irritava mais do que se batessem nele com o martelo de Xelor.');
INSERT INTO "item_descriptions" VALUES(12027,'pt','Como bom percussionista, Mirh batuca em tudo, até quando dorme. Vai ter dificuldade de encontrar uma parceira que consiga continuar viva perto dele.');
INSERT INTO "item_descriptions" VALUES(12028,'pt','Mirh nunca conseguiu invocar a Kasha de Pandora. Para compensar, ele equipou uma pequena caixa no cinto, na qual guarda venenos que causam todo tipo de males. Infelizmente nunca conseguiu usá-los direito nos adversários... Acabam servindo de sonífero quando ele tem insônia.');
INSERT INTO "item_descriptions" VALUES(12029,'pt','Mirh às vezes usava o amuleto de pêndulo para pegar no sono mais rápido. Só que ele sempre deixava cair quando adormecia e o baque no chão o acordava com um susto.');
INSERT INTO "item_descriptions" VALUES(12031,'pt','Logram sempre cuidava de tirar as getas antes de um combate. Esse hábito vinha da época em que ele se metamorfoseava, pois as patas dele ficavam dez vezes maiores... A dor é uma grande professora.');
INSERT INTO "item_descriptions" VALUES(12032,'pt','Logram dominava a arte do origami e confeccionou a maior parte de seu equipamento dobrando papel. Apesar disso, não é usando o colar dele que você vai conseguir controlar o fogo como um Fogofox. Então tente não coçar o pescoço se não quiser virar carvão... Todo mundo sabe que os amuletos de Logram são meio incendiários.');
INSERT INTO "item_descriptions" VALUES(12033,'pt','A cabeça de origami de Fox no anel de Logram permite que ele projete uma ilusão de si mesmo, mas isso nunca lhe foi muito útil em combate, pois ele precisava ficar perto da sua ilusão e não se mexer. Você pode conseguir impressionar uns gatos pingados que estiverem assistindo, mas não vai passar disso.');
INSERT INTO "item_descriptions" VALUES(12035,'pt','Ninguém sabe que força misteriosa impede que a grande cueca de Kalkâneo escorregue por aquelas perninhas ossudas. Algumas pessoas têm suposições, mas ninguém nunca quis verificá-las.');
INSERT INTO "item_descriptions" VALUES(12036,'pt','Como Kalkâneo usava perna de pau, ele só tinha um pé de bota. Então basta calçá-la para adotar o mesmo passo desengonçado que ele.');
INSERT INTO "item_descriptions" VALUES(12037,'pt','Apesar de Kalkâneo só ter um braço, uma perna e um olho, ele fazia muito sucesso com as mulheres. Nunca chegava a explicar que ele nasceu assim e a única coisa que perdeu em combate foram as calças.');
INSERT INTO "item_descriptions" VALUES(12039,'pt','Hichete já foi casado. Infelizmente não durou: ele pressionava demais a esposa. Contra a parede e se sentindo encurralada, ela preferiu deixá-lo. Pressionar, encurralar... isso resume um pouco a vida (e a morte) de Hichete.');
INSERT INTO "item_descriptions" VALUES(12040,'pt','Embora aparentasse ser um simples Barbrossa, ele superava a todos em perfídia e megalomania. Nem este cinto conseguia segurar as calças dele quando se contorcia de rir e zombar dos adversários.');
INSERT INTO "item_descriptions" VALUES(12041,'pt','Hichete, desonesto e mau perdedor como era, trapaceava até em guerra de dedos. Ele usava duas mãos. Uma para prender o dedão do oponente e, se isso não funcionasse, uma para cortá-lo com sua adaga.');
INSERT INTO "item_descriptions" VALUES(12043,'pt','Haku nunca foi um Zoth muito comunicativo, preferindo mil vezes as atividades internas às externas. Talvez seja por isso que viveu tanto, sobrevivendo aos ataques incessantes dos aventureiros à caça de pele de Zoth e kristalita. Mas ele acabou deixando a peteca cair.');
INSERT INTO "item_descriptions" VALUES(12044,'pt','Haku não era considerado um Mestre Zoth por causa de seu status social, estudos ou aptidão no combate, mas por causa do número interminável de noites que ele passava mestrando RPG com seus amigos Zoths. Só que ele não saía espalhando por aí.');
INSERT INTO "item_descriptions" VALUES(12045,'pt','Haku jamais conseguiu ficar com uma namorada por muito tempo. Cada vez que uma aventureira se apresentava a ele, ele achava que ela só estava falando com ele por causa do Voo do Mestre Zoth, uma ideia que representava bem algumas pessoas.');
INSERT INTO "item_descriptions" VALUES(12057,'pt','Thanos praticou todo tipo de ocupações desagradáveis: sargento instrutor, banqueiro, agiota, contador de história e ocasionalmente profeta do S.L.I.P. Ele usava seu bastão para punir seus aprendizes e qualquer um que o ouvisse, um hábito diário que certamente o manteve em forma.');
INSERT INTO "item_descriptions" VALUES(12068,'pt','Se você estiver parado em uma brisa ou atravessando uma forte corrente, você vai gerar uma quantidade enorme de energia se estiver usando esse cinto. O que fará com ela é você quem sabe.');
INSERT INTO "item_descriptions" VALUES(12069,'pt','Há aqueles que falarão com felicidade que a palavra ‘''branquelada'''' não existe, e que a ‘''Presa Branquelada'''' deveria, na verdade, se chamar ‘''Presa Branca''''. Mostre esse amuleto a eles, feito com presas que não são brancas, nem amarelas, nem cinzas ou pretas, e veja se eles ficarão um pouco quietos.
Provavelmente não.');
INSERT INTO "item_descriptions" VALUES(12070,'pt','Pensando nisso, você se pergunta se esse casaco, que você pensou que era uma peça autêntica de pele de Nelween, não é, na verdade, o que parecia ser em primeiro lugar. Você não se lembra de Nelween ser azul, marrom, muito menos estar cortada em duas partes da última vez em que você a viu. Ainda assim, combina com o papel de parede do seu quarto, não?');
INSERT INTO "item_descriptions" VALUES(12071,'pt','Estas adoráveis botas de couro se tornaram menos atraentes quando você descobriu que o pelo do qual elas são feitas vieram do corpo ainda quente de um Komenoz morto-vivo.');
INSERT INTO "item_descriptions" VALUES(12072,'pt','A Fumaça de Nelween presa na fivela deste cinto ainda está carregada com magia. Irá ajudá-lo a realizar pequenos milagres, como iluminar o seu caminho à noite, ou impedindo que você prenda aquelas partes enquanto você voa. Você sabe o que eles dizem – ‘''isso deve doer'''', e dói. De verdade, mesmo.');
INSERT INTO "item_descriptions" VALUES(12084,'pt','Os pelos saindo do punho desse martelo vão garantir a você uma excelente pegada, mesmo entre uma horda de Papamutes.');
INSERT INTO "item_descriptions" VALUES(12085,'pt','Esse anel é insuportável por duas razões: ele fede a Papamute molhado, e ele está coberto de pelos que fazem cócegas constantemente em seus dedo. Provavelmente não é o melhor presente para sua amada.');
INSERT INTO "item_descriptions" VALUES(12086,'pt','Feito com o ouro mais fino extraído dos chifres de Papamute Real, este anel sem dúvidas tocará o coração de quem sabe apreciar de verdade os esforços necessários à sua fabricação.');
INSERT INTO "item_descriptions" VALUES(12087,'pt','Se for corretamente arrastada pela neve, esta capa deixará marcas de chifres capazes de assustar os monstros mais fracos. No entanto, não enganará um Papamute Real furioso, que irá automaticamente atrás de você assim que vir essas marcas.');
INSERT INTO "item_descriptions" VALUES(12088,'pt','Varinhas são a especialidade dos Frigostinos. Esta, no entanto, parece diferente das outras - tome cuidado para não morder mais do que consegue mastigar!');
INSERT INTO "item_descriptions" VALUES(12089,'pt','Com este amuleto ao redor do seu pescoço, o cheiro delicioso de pastas extremamente quentes vão envolver os seus sentidos e lhe dar a ilusão de força. Porém, é só uma ilusão.');
INSERT INTO "item_descriptions" VALUES(12090,'pt','Quando você descobrir que o principal ingrediente do creme Frigostino é gordura de Pingwin, você vai se sentir menos encorajado a lamber este anel.');
INSERT INTO "item_descriptions" VALUES(12091,'pt','Este cinto vai atrair a atenção dos seus adversários para os seus pneuzinhos.');
INSERT INTO "item_descriptions" VALUES(12092,'pt','Essas botas permitiram que Frigostina esmagasse pão em migalhas. Eles também eram úteis em turistas que não deixavam uma gorjeta. Se há algo que você deve saber sobre Frigost, é que em Frigost não se brinca com respeito.');
INSERT INTO "item_descriptions" VALUES(12093,'pt','Esse manto, costurado com fios de ouro por um grande artesão, vai lhe dar a credibilidade que tanto lhe está faltando.');
INSERT INTO "item_descriptions" VALUES(12094,'pt','Este anel é certamente nobre, mas provavelmente sua amada preferirá algo mais brilhante.');
INSERT INTO "item_descriptions" VALUES(12095,'pt','Após várias catastrofes provocadas por agulhas que eram afiadas demais, a prefeita Berna criou o hábito de premiar os artesãos mais habilidosos de Frigost com esse amuleto.');
INSERT INTO "item_descriptions" VALUES(12096,'pt','Estas botas são tão barulhentas que dizem por aí que a Marilu Brificanty, mais conhecida como "Lulu", as encheu de chumbo para poder seguir a prefeita Berna por todo canto e nunca perdê-la de vista.');
INSERT INTO "item_descriptions" VALUES(12097,'pt','Segundo os profetas do S.L.I.P., o poder combinado de cinco aneis como este permitiria invocar o Senhor de Lava Incompreendido pelo Público de slip. Mais uma elucubração do Ecaflip Lebar...');
INSERT INTO "item_descriptions" VALUES(12098,'pt','Este cinto é um suporte indispensável a todo profeta do S.L.I.P. que se preze.');
INSERT INTO "item_descriptions" VALUES(12099,'pt','Este bastão, extraído das entranhas  do Obsidemônio, é uma verdadeira relíquia. Sua localização e o método de obtenção fazem parte dos segredos mais bem guardados dos profetas do S.L.I.P.');
INSERT INTO "item_descriptions" VALUES(12100,'pt','O joalheiro que produziu esse anel teve tempo suficiente para começar a esculpir a cabeça do Tengu Gelifox em um pedaço de madeira, antes de ser atropelado pelo indivíduo.');
INSERT INTO "item_descriptions" VALUES(12101,'pt','Dizem que esse foi o anel de noivado que Guten Tak ofereceu para sua amada Kami Gelifox quando se encontraram. Aparentemente, quando ela recusou, seu pelo ficou branco de raiva.');
INSERT INTO "item_descriptions" VALUES(12102,'pt','A história diz que um dia um Frigostiano tentou domar um bebê Gelifox colocando este amuleto em seu pescoço. Isso provavelmente funcionaria, se o Gelifox que ele escolheu não fosse um dos filhotes de Guten Tak.');
INSERT INTO "item_descriptions" VALUES(12103,'pt','Mesmo se as origiens desse arco continuarem desconhecidas, alguns Frigostianos dizem ter visto Guten Tak usá-lo, para trapacear em competições de arremesso de estalactite.');
INSERT INTO "item_descriptions" VALUES(12104,'pt','Apesar do fato de isso ser um mineral composto muito raro, e de requerir anos de polimento, Waldo FieldChester Potcobble nunca teve coragem de oferecê-lo para Aurora Boreal.');
INSERT INTO "item_descriptions" VALUES(12105,'pt','Aurora da muita importância as suas medidas, e mede as sobras das cordas de seu cinto toda manhã. Até agora, ninguém teve a coragem de avisá-la que o couro estica com o tempo...');
INSERT INTO "item_descriptions" VALUES(12106,'pt','Graças a sua educação aristocrata, Aurora ficou horrorizada quando ela viu que o chapéu que o alfaiate líder fez para ela - ele foi dispensado imediatamente. Mas, com a glaciação de Frigost, parece que ele conseguiu o emprego de volta.');
INSERT INTO "item_descriptions" VALUES(12107,'pt','Encantada com a ideia de criar um hotel completamente rodeado de gelo, as botas da Aurora foram criadas especificamente para manter o seu delicado pé longe do gelo. Quanto a não escorregar, ainda há trabalho a ser feito.');
INSERT INTO "item_descriptions" VALUES(12108,'pt','Este manto pode não ser muito elaborado, mas ele foi encantado pelo grande Mago Ax para sempre ondular heróicamente, mesmo quando não há vento. Isso significa que é perfeito para se exibir, apesar do Professor Xa ter escolhido porque ele sabia que ela não prenderia em suas rodas.');
INSERT INTO "item_descriptions" VALUES(12109,'pt','Dizem que o Professor Xa, que é mais conhecido por ser um sovina, criou este anel usando um parafuso que caiu de sua cadeira.');
INSERT INTO "item_descriptions" VALUES(12110,'pt','O sapateiro que fez essas botas foi o tipo de pessoa que sempre tinha algum tipo de piadinha semg raça em sua manga.
O Professor Xa despediu ele na hora e jurou nunca utilizar essas botas.');
INSERT INTO "item_descriptions" VALUES(12111,'pt','Não seja enganado pela aparência simplistica desse amuleto, pois ele é na verdade a chave para a reserva secreta do cereal favorito do Professor Xa, o Cerebios.');
INSERT INTO "item_descriptions" VALUES(12112,'pt','Você deve estar aí se perguntando o que o Professor Xa poderia fazer com uma pá. Bom, além de disciplinar seus Wolvexugos, parece que ele também a usava para escavar a rocha, mas na horizontal, não na vertical. Obviamente não teve muito sucesso.');
INSERT INTO "item_descriptions" VALUES(12113,'pt','Preguiçoso demais para extrair diamantes, o Glurseleste preferiu lapidar o cubo de gele de um pobre Aperiglurso para colocá-lo em um anel de mel. É evidente que não lhe ocorreu que a sua criação iria derreter assim que fosse utilizada.');
INSERT INTO "item_descriptions" VALUES(12114,'pt','Uma versão miniatura da coroa tão cobiçada pelo Glurseleste, você devia pensar duas vezes antes de utilizá-la quando ele está por perto, ou você corre o risco de soltar a sua furia. Coisa que ele possiu de sobra...');
INSERT INTO "item_descriptions" VALUES(12115,'pt','Nesta espada está escrito que só quem conseguir tirá-la de seu pedestal de mel poderá ser rei dos Glursos. Dizem que os Glurselestes convocaram a ajuda de vários Glursornados, mas o resultado está aí.');
INSERT INTO "item_descriptions" VALUES(12116,'pt','Essas folhas são maiores do que qualquer outra já encontrada na área ao redor do Monte Tórrido, que é o porque dessa peça ser tão rara.');
INSERT INTO "item_descriptions" VALUES(12117,'pt','Dado a não saudável quantia de pêlo crescendo nas costas da Fuji Gelifox, a pequena fração necessária para essa capa não vai fazer muita diferença para a sua massa corporal.');
INSERT INTO "item_descriptions" VALUES(12118,'pt','Com este capacete, você pode ter certeza que vai atrair todas as Maho Gelifox durante a época de acasalamento. Se isso é bom ou não, depende de você.');
INSERT INTO "item_descriptions" VALUES(12119,'pt','O couro de Gelifox é conhecido por ser extremamente resistente, mas seu odor insuportável tende a afastar até mesmo os sapateiros mais experientes. Utilizando o coro da Fuji Gelifox ajuda a aliviar esse problema, mas podem haver efeitos colaterais...');
INSERT INTO "item_descriptions" VALUES(12120,'pt','Antes de ser a genitora de todos os Gelifox, a Fuji Gelifox costumava utilizar este anel como um cinto. Hoje em dia ela cabe perfeitamente em seus dedos. Talvez caibam nos seus.');
INSERT INTO "item_descriptions" VALUES(12133,'pt','A Mãe Natureza não foi muito gentil com a Serpeta. Além de ser motivo de chacota por ter apenas um olho, ela só tem uma presa, o que, por um lado, acaba sendo prático na hora de colher flores, plantas e o crânio de quem se atreve a zombar dela.');
INSERT INTO "item_descriptions" VALUES(12177,'pt','Pode parecer paradoxal, mas Tofuma é um Tofu Maléfico bonzinho. Sem piedade nem remorso, ele exterminará junto com você tudo o que rasteja, anda, voa ou nada, com o maior prazer. Os iguais se atraem: vocês têm a mesma concepção da bondade, então é natural que simpatizem um com o outro.');
INSERT INTO "item_descriptions" VALUES(12237,'pt','Confeccionado por Wamor Stanoar, este amuleto simboliza o amor passional. Ao usá-lo, você passará de Rosadim por um dia para Rosadim todo dia.');
INSERT INTO "item_descriptions" VALUES(12238,'pt','Confeccionado por Wamor Stanoar, este amuleto simboliza o amor passional. Ao usá-lo, você passará de Rosadinha por um dia para Rosadinha todo dia.');
INSERT INTO "item_descriptions" VALUES(12370,'pt','Empurre. Empurre com mais força. Sem sorte ainda? Você tem certeza de que está tentando colocar o amuleto em seu pescoço...?');
INSERT INTO "item_descriptions" VALUES(12371,'pt','Enrolada ao redor de sua cintura e entre suas pernas, essa capa vai realmente enfatizar seu revestimento extra.');
INSERT INTO "item_descriptions" VALUES(12372,'pt','Excelente para proteger suas mãos durante uma partida de boxe, essa luva pode ser usada para coletar a gordura de dragão-porco em conserva.');
INSERT INTO "item_descriptions" VALUES(12373,'pt','Ao usar essas botas, você pode fazer o chão tremer batendo seus pés, o que, com certeza, fará os Porkassos das redondezas pularem. Uma forma barata, mas perigosa, de encontrar um parceiro.');
INSERT INTO "item_descriptions" VALUES(12379,'pt','Ao colocar este bracelete, você terá a impressão de reviver seu último encontro com a Fuji, mas sem a umidade. Ah, ele também pode ser usado no pulso.');
INSERT INTO "item_descriptions" VALUES(12380,'pt','Você não vê nenhuma diferença entre essas botas e o seus pés, mas é bem óbvio: as botas tem um cheiro bom.');
INSERT INTO "item_descriptions" VALUES(12385,'pt','O crânio desenhado nos lenços de cabeça dos Ladinos permite que eles finjam estar mortos para pegar de surpresa os inimigos burros, como os Tofus e lops. Mas fique avisado: foram relatados efeitos colaterais indesejados por pessoas que usaram esses lenços em cemitérios durante a época de acasalamento do Chafer.');
INSERT INTO "item_descriptions" VALUES(12386,'pt','A Máscara Arpone, que se baseia na Máscara do Fedor, tem um odor mais fraco, mas também é bem menos poderosa. É por isso que ela é mais bem usada junto com outro equipamento. Por que não tentar a Tiara Misu?');
INSERT INTO "item_descriptions" VALUES(12387,'pt','Vil Smisse foi o primeiro a usar esse manto como subterfúgio. Na verdade, ele o salvou muitas vezes, inclusive quando estava dependurado pelos dedos do pé. Desde então, os Ladinos condenados à morte têm seguido seu exemplo.');
INSERT INTO "item_descriptions" VALUES(12388,'pt','Os Zobais gostam de lutar ao som de música, e usam esta capa para bater o ritmo. Eles também a usam para bater em seus filhos quando não se comportam.');
INSERT INTO "item_descriptions" VALUES(12389,'pt','Os Ladinos são tão furtivos que eles escondem seus planos e missões maquiavélicos em suas botas. Quero dizer, quem é corajoso o suficiente para encarar o fedor mortal de um cadáver e verificar as botas de um Ladino morto?');
INSERT INTO "item_descriptions" VALUES(12390,'pt','Você já venceu uma luta atirando dardos às cegas, usando tamancos disfarçados de sapatos? Você não gostaria de tentar?');
INSERT INTO "item_descriptions" VALUES(12391,'pt','Útil para armazenar bombas, tente não dançar muito quando estiver usando esse cinto, se não você vai ter uma surpresa de arrepiar.');
INSERT INTO "item_descriptions" VALUES(12392,'pt','Para saber se um Zobal era digno de usar sua primeira máscara, um antigo costume consistia em amarrar dois candidatos e mergulhá-los de cabeça para baixo em um barril de cerveja Bwork. O primeiro a escapar recebia sua máscara e conservava as cordas na cintura como símbolo desse ritual de passagem à vida adulta. Embora a tradição tenha morrido, os Zobais continuam confeccionando esses cintos como lembrança.');
INSERT INTO "item_descriptions" VALUES(12393,'pt','Essas luvas foram usadas por muitos anos pela feiticeira Ladina Lina, que aperfeiçoou suas bombas usando magia negra para poder criar explosivos poderosos o bastante para matar dragões. Até hoje, elas ainda contêm o poder dela.');
INSERT INTO "item_descriptions" VALUES(12394,'pt','Dizem que este bracelete vai lhe garantir um lugar na história. Dizem também que vai transformar você no Zobal mais popular de todos. Dizem até que alguns idiotas acreditam em toda essa baboseira.');
INSERT INTO "item_descriptions" VALUES(12407,'pt','Este amuleto é o troféu que prova que você dizimou hordas de Kaskas que mal tiveram tempo de crescer. Agora, sua missão é esconder esse infanticídio em massa de seus pais, Grozilla e Grasmera que, definitivamente, não são fracos e nem estão na puberdade.');
INSERT INTO "item_descriptions" VALUES(12408,'pt','Quando você pediu ao joalheiro para fazer este amuleto, pensou que seu bezoar, no final das contas, iria cessar. Infelizmente, continua tão ardente como sempre. Pega fogo com qualquer brisa e vai ferver você  vivo caso se esqueça de tirá-lo antes de tomar banho. Por outro lado, é seu troféu de batalha, não é?');
INSERT INTO "item_descriptions" VALUES(12409,'pt','A bússola embutida neste anel será muito útil para encontrar o caminho de volta para sua casa de campo pequena e acolhedora, após todos os seus amigos serem massacrados por Kaskas furiosas.');
INSERT INTO "item_descriptions" VALUES(12410,'pt','No passado, este bracelete era dado aos turistas que visitavam Vulkânia para garantir que eles não viessem à ilha duas vezes, registrando-se apenas uma vez. Os Agentes de Turismo Classe A logo acabaram com isso quando perceberam que ninguém nunca voltava a Vulkânia. Isso é, se não tivessem acabado no cemitério mais populoso da ilha, talvez voltassem.');
INSERT INTO "item_descriptions" VALUES(12411,'pt','Estas botas, feitas dos restos de dúzias de Kaskas Juvenis, estão na moda fora de Vulkânia. Em Vulkânia, elas são perfeitas para missões suicidas entre Kaskas Veneráveis, que vão se encarregar de vingar seus irmãos menores, sem hesitação.');
INSERT INTO "item_descriptions" VALUES(12412,'pt','O fato de Grozilla ter botas com o seu nome pode parecer irônico, considerando o ócio que ele tem cultivado desde que se estabeleceu em Vulkania com Grasmera. Mas, quem não ficaria ocioso em uma ilha paradisíaca com companhias encantadoras e todos os pratos exóticos que poderia desejar?');
INSERT INTO "item_descriptions" VALUES(12413,'pt','A capa do Kaskador é um deleite para os artesãos de Vulkânia, que acham o máximo ver um aventureiro usando uma. A capa é dura e pesada, arrebenta suas panturrilhas, desgasta suas omoplatas e, frequentemente, os deixa sem equilíbrio.');
INSERT INTO "item_descriptions" VALUES(12414,'pt','Com esta mochila em suas costas você estará preparado para explorar Vulkânia nas suas horas de lazer. Aviso - Os artesãos vulkanianos não garantem sua eficiência, caso você deixe a ilha... Contudo, alguns dizem que um PLVB bem guardado é melhor do que outras bolsas, quando tudo que você quer fazer é sentar em um cantinho e descansar.');
INSERT INTO "item_descriptions" VALUES(12415,'pt','O cinto do Kaskador é, tradicionalmente, apresentado aos adolescentes vulkanianos e torna-se impossível retirá-lo quando se tornam adultos. Dessa forma, eles têm de permanecer em forma se não quiserem ser cortados ao meio. Quanto a você, talvez possa prendê-lo na coxa ou, mais realisticamente, na panturrilha.');
INSERT INTO "item_descriptions" VALUES(12416,'pt','A depravação de Grozilla e Grasmera com as Dragosas sempre foi um tema polêmico, escandalizando aventureiras e intimidando seus companheiros. Este cinto é enorme... a fivela tornou-se um meio de os garotos mencionados viverem de acordo com as mesmas regras. Obviamente, eles estão mentindo.');
INSERT INTO "item_descriptions" VALUES(12417,'pt','Este chapéu fará com que você pareça um caçador da selva mais escura, fazendo com que seus inimigos se sintam como crianças. Ou, pelo menos, é isso o que certo Pan Velt diria a qualquer um que quisesse ouvir.');
INSERT INTO "item_descriptions" VALUES(12418,'pt','Ao usar este capacete você estará dizendo a todo mundo que derrotou o terrível Grozilla. Na prática, tudo o que você realmente consegue fazer com ele é aterrorizar criancinhas e/ou arrumar um emprego como mascote do seu time favorito de Papabol.');
INSERT INTO "item_descriptions" VALUES(12421,'pt','Ao contrário da capa ou do martelo Tetrista, este amuleto parece sempre ter a mesma forma, não importa o quanto você se virar. Cuidado para não ficar com torcicolo!');
INSERT INTO "item_descriptions" VALUES(12423,'pt','Este anel é mágico, se você o deixar  cair, retardará sua queda.');
INSERT INTO "item_descriptions" VALUES(12463,'pt','Ninguém sabe por que as tiras desta sunga são tão longas. Será que ela pertenceu ao corpulento Rushu? Será que foi usada como catapulta na batalha da Aurora Púrpura? Seja o que for, todos concordam que há algo de errado com ela.');
INSERT INTO "item_descriptions" VALUES(12465,'pt','Estes sapatos envernizados são a mais nova moda em algum dos países menos desenvolvidos do Mundo dos Doze. Em Amakna, no entanto, você pode ser confundido com algum imigrante mal educado.');
INSERT INTO "item_descriptions" VALUES(12466,'pt','O Boracelete é realmente um bracelete simples feito de plástico. Seu criador, no entanto, conseguiu transformá-lo em um grande sucesso comercial ao inventar várias e várias maneiras de usá-lo. Algumas delas eram de gosto tão duvidoso que preferimos não entrar em detalhes. E isso já diz  alguma coisa.');
INSERT INTO "item_descriptions" VALUES(12502,'pt','Este cinto foi criado para combinar perfeitamente com a arma favorita da Pandaysa, o Sabre Triste. Apesar da sua decoração simples, o sabre se mostrou muito eficaz no combate. O mesmo não pode ser dito deste cinto decorado com peças de ouro e da barulheira que faz cada vez que seu portador dá um passo.');
INSERT INTO "item_descriptions" VALUES(12512,'pt','Qualquer Masticator que se preze sabe que não deve tentar extrair resina de árvore Sinuosa com as próprias mãos, a menos que queira grudar suas mãos na casca... para sempre. E “para sempre” quer dizer coceiras insuportáveis e inalcançáveis.');
INSERT INTO "item_descriptions" VALUES(1012541,'pt','Uma recompensa para os aventureiros que provaram seu valor derrotando Grozilla e Grasmera inúmeras vezes durante seus períodos de torpor. A população de Astrub é louca por este Dragoloko.');
INSERT INTO "item_descriptions" VALUES(12598,'pt','Este anel era o sinete do general do exército de um país distante que queria invadir Amakna. A suposta ameaça foi neutralizada facilmente devido a seus grandes defeitos táticos: as tropas se deslocavam de um lado para outro do campo de batalha, avançando muito pouco, ao invés de avançar em linha reta. O exército de Allister nunca viu alvos tão fáceis.');
INSERT INTO "item_descriptions" VALUES(12599,'pt','Quando esse cinto é equipado, você se sente como um verdadeiro herói, capaz de destruir sozinho qualquer exército. Agora, só precisa de um exército disposto a deixar você tentar isso.');
INSERT INTO "item_descriptions" VALUES(12622,'pt','Esse troféu mantém os covardes mais perto de você. Para que você possa esmagá-los mais facilmente.');
INSERT INTO "item_descriptions" VALUES(12623,'pt','Esse troféu mantém os covardes mais perto de você. Para que você possa esmagá-los mais facilmente.');
INSERT INTO "item_descriptions" VALUES(12624,'pt','Esse troféu mantém os covardes mais perto de você. Para que você possa esmagá-los mais facilmente.');
INSERT INTO "item_descriptions" VALUES(12625,'pt','Esse troféu permite que você escape quando o momento oportuno se apresentar.');
INSERT INTO "item_descriptions" VALUES(12626,'pt','Esse troféu permite que você escape quando o momento oportuno se apresentar.');
INSERT INTO "item_descriptions" VALUES(12627,'pt','Esse troféu permite que você escape quando o momento oportuno se apresentar.');
INSERT INTO "item_descriptions" VALUES(12628,'pt','Esse troféu permite que você reduza os movimentos do seu inimigo para capturá-lo mais facilmente e o humilhe apropriadamente, arrancando sua cueca, por exemplo.');
INSERT INTO "item_descriptions" VALUES(12629,'pt','Esse troféu permite que você reduza os movimentos do seu inimigo para capturá-lo mais facilmente e o humilhe apropriadamente, arrancando sua cueca, por exemplo.');
INSERT INTO "item_descriptions" VALUES(12630,'pt','Esse troféu permite que você reduza os movimentos do seu inimigo para capturá-lo mais facilmente e o humilhe apropriadamente, arrancando sua cueca, por exemplo.');
INSERT INTO "item_descriptions" VALUES(12631,'pt','Esse troféu permite que você oprima seus agressores mais facilmente. Ele parece funcionar em qualquer um.');
INSERT INTO "item_descriptions" VALUES(12632,'pt','Esse troféu permite que você oprima seus agressores mais facilmente. Ele parece funcionar em qualquer um.');
INSERT INTO "item_descriptions" VALUES(12633,'pt','Esse troféu permite que você oprima seus agressores mais facilmente. Ele parece funcionar em qualquer um.');
INSERT INTO "item_descriptions" VALUES(12634,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando evitar que você chegue a algum lugar. Mas ele não funciona contra aqueles que estão tentando evitar que você chegue ao seu destino.');
INSERT INTO "item_descriptions" VALUES(12635,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando evitar que você chegue a algum lugar. Mas ele não funciona contra aqueles que estão tentando evitar que você chegue ao seu destino.');
INSERT INTO "item_descriptions" VALUES(12636,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando evitar que você chegue a algum lugar. Mas ele não funciona contra aqueles que estão tentando evitar que você chegue ao seu destino.');
INSERT INTO "item_descriptions" VALUES(12637,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando limitar suas ações. Ele não funciona contra advogados.');
INSERT INTO "item_descriptions" VALUES(12638,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando limitar suas ações. Ele não funciona contra advogados.');
INSERT INTO "item_descriptions" VALUES(12639,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando limitar suas ações. Ele não funciona contra advogados.');
INSERT INTO "item_descriptions" VALUES(12640,'pt','Com este troféu, você poderá infligir um pouco mais de danos aos seus adversários quando empurrá-los contra uma árvore, uma placa de mármore ou contra outro adversário imberbe.');
INSERT INTO "item_descriptions" VALUES(12641,'pt','Com este troféu, você poderá infligir um pouco mais de danos aos seus adversários quando empurrá-los contra uma árvore, uma placa de mármore ou contra outro adversário imberbe.');
INSERT INTO "item_descriptions" VALUES(12642,'pt','Com este troféu, você poderá infligir um pouco mais de danos aos seus adversários quando empurrá-los contra uma árvore, uma placa de mármore ou contra outro adversário imberbe.');
INSERT INTO "item_descriptions" VALUES(12643,'pt','Esse troféu diminui um pouco o seu sofrimento quando seus adversários empurram você contra uma árvore, pessoa, animal ou qualquer um que seja grande e fortão. Ele não o protege contra socos, nem mesmo aqueles desferidos por mãos cheias de calos.');
INSERT INTO "item_descriptions" VALUES(12644,'pt','Esse troféu diminui um pouco o seu sofrimento quando seus adversários empurram você contra uma árvore, pessoa, animal ou qualquer um que seja grande e fortão. Ele não o protege contra socos, nem mesmo aqueles desferidos por mãos cheias de calos.');
INSERT INTO "item_descriptions" VALUES(12645,'pt','Esse troféu diminui um pouco o seu sofrimento quando seus adversários empurram você contra uma árvore, pessoa, animal ou qualquer um que seja grande e fortão. Ele não o protege contra socos, nem mesmo aqueles desferidos por mãos cheias de calos.');
INSERT INTO "item_descriptions" VALUES(12646,'pt','Esse troféu protege você contra acertos críticos, em locais críticos e momentos críticos. Quando equipá-lo, você vai sofrer um efeito colateral que, com certeza, vai deixar seus amigos nervosos: não aceitará críticas.');
INSERT INTO "item_descriptions" VALUES(12647,'pt','Esse troféu protege você contra acertos críticos, em locais críticos e momentos críticos. Quando equipá-lo, você vai sofrer um efeito colateral que, com certeza, vai deixar seus amigos nervosos: não aceitará críticas.');
INSERT INTO "item_descriptions" VALUES(12648,'pt','Esse troféu protege você contra acertos críticos, em locais críticos e momentos críticos. Quando equipá-lo, você vai sofrer um efeito colateral que, com certeza, vai deixar seus amigos nervosos: não aceitará críticas.');
INSERT INTO "item_descriptions" VALUES(12649,'pt','Esse troféu protege você contra ataques aéreos, mas não contra passarinhos.');
INSERT INTO "item_descriptions" VALUES(12650,'pt','Esse troféu protege você contra ataques aéreos, mas não contra passarinhos.');
INSERT INTO "item_descriptions" VALUES(12651,'pt','Esse troféu protege você contra ataques aéreos, mas não contra passarinhos.');
INSERT INTO "item_descriptions" VALUES(12652,'pt','Esse troféu protege você contra ataques de água, mas não contra torneiras quebradas.');
INSERT INTO "item_descriptions" VALUES(12653,'pt','Esse troféu protege você contra ataques de água, mas não contra torneiras quebradas.');
INSERT INTO "item_descriptions" VALUES(12654,'pt','Esse troféu protege você contra ataques de água, mas não contra torneiras quebradas.');
INSERT INTO "item_descriptions" VALUES(12657,'pt','É estranho, mas o joalheiro que criou esse amuleto cabeludo (com nariz de rato e orelhas) se recusou a assinar seu nome nele. Não se pode culpar o sujeito.');
INSERT INTO "item_descriptions" VALUES(12658,'pt','Apenas alguns aventureiros de determinada idade entendem porque o símbolo nesse bracelete é o de uma pata de gato,  já que o item todo parece estar relacionado a ratos. E por serem sorrateiros, eles continuam guardando segredo sobre isso. Ou será  por que já estão velhos?');
INSERT INTO "item_descriptions" VALUES(12659,'pt','Esse troféu protege você contra ataques de fogo, mas não contra fogo de ataque.');
INSERT INTO "item_descriptions" VALUES(12660,'pt','Com esse escudo todos podem ver que você saiu de Incarnam e se juntou ao Mundo dos Doze para partir em busca dos Dofus.');
INSERT INTO "item_descriptions" VALUES(12661,'pt','Essa pequena bolsa criada pela Possyvel é a mais radical em Incarnam. Os aventureiros acham que ela é prática, além de elegante. Os mais experientes guardam nela os dentes que arrancam dos inimigos caídos.');
INSERT INTO "item_descriptions" VALUES(12671,'pt','A nota musical no cinto de Vandja é na verdade um botão que, depois de ativado, lança um sinal de SOS no céu, avisando a todos os seres espaciais que um terrestre está em apuros. Alguém lá em cima gosta de você.');
INSERT INTO "item_descriptions" VALUES(12672,'pt','Sujo e levemente surrealista, mas sempre antenado com a moda sertaneja, Vandja inventou essa mistura de tamancos com botas que combina elementos sólidos e rústicos do tamanco com a proteção e praticidade das botas.  Ele nunca parou de tentar popularizar sua invenção, chegando ao cúmulo de dizer que o produto era resultado de seu suor e lágrimas. O que provavelmente fez com que muitas pessoas as comprassem.');
INSERT INTO "item_descriptions" VALUES(12674,'pt','Você agora tem o mesmo chapéu que Daigoro costumava usar desde que era um garotinho. Infelizmente, não tem a mesma desculpa que ele tinha: ninguém o avisou que isso estava fora de moda há quase dez anos.');
INSERT INTO "item_descriptions" VALUES(12675,'pt','O Daigoro tirou este colar de pérolas cor de sangue do corpo sem vida do chefe dos Kitsus que atacou seu vilarejo no passado. Tomara que ninguém lhe pergunte onde você conseguiu o seu, pois se você confessar que ele não passa de uma cópia feita pelo seu joalheiro, ninguém vai acreditar que você é um mestre Pandawushu.');
INSERT INTO "item_descriptions" VALUES(12676,'pt','Esta tanga traz as marcas dos vários anos de intenso treinamento pelo qual o Daigoro passou para poder um dia derrotar Zatoishwan. O estranho é que ela só está soltando esse cheiro depois que você a vestiu.');
INSERT INTO "item_descriptions" VALUES(12677,'pt','Depois de destruir sua vila, Daigoro fez esse bastão com os restos dela ainda fumegantes. Ele quase foi capaz de fazer outro.');
INSERT INTO "item_descriptions" VALUES(12678,'pt','Esse troféu protege você contra ataques de fogo, mas não contra fogo de ataque.');
INSERT INTO "item_descriptions" VALUES(12679,'pt','Esse troféu protege você contra ataques de fogo, mas não contra fogo de ataque.');
INSERT INTO "item_descriptions" VALUES(12680,'pt','Esse troféu protege você contra ataques de terra, a não ser que esteja na Terra Média.');
INSERT INTO "item_descriptions" VALUES(12681,'pt','Esse troféu protege você contra ataques de terra, a não ser que esteja na Terra Média.');
INSERT INTO "item_descriptions" VALUES(12682,'pt','Esse troféu protege você contra ataques de terra, a não ser que esteja na Terra Média.');
INSERT INTO "item_descriptions" VALUES(12683,'pt','Esse troféu protege você contra ataques neutros, mas não vai deixar seus inimigos nem um pouco neutros quando as hostilidades começarem.');
INSERT INTO "item_descriptions" VALUES(12684,'pt','Esse troféu protege você contra ataques neutros, mas não vai deixar seus inimigos nem um pouco neutros quando as hostilidades começarem.');
INSERT INTO "item_descriptions" VALUES(12685,'pt','Esse troféu protege você contra ataques neutros, mas não vai deixar seus inimigos nem um pouco neutros quando as hostilidades começarem.');
INSERT INTO "item_descriptions" VALUES(12686,'pt','Este troféu aumenta os danos do elemento Ar. Perfeito para quem nunca perdem o fôlego.');
INSERT INTO "item_descriptions" VALUES(12687,'pt','Este troféu aumenta os danos do elemento Ar. Perfeito para quem nunca perdem o fôlego.');
INSERT INTO "item_descriptions" VALUES(12688,'pt','Este troféu aumenta os danos do elemento Ar. Perfeito para quem nunca perdem o fôlego.');
INSERT INTO "item_descriptions" VALUES(12689,'pt','Este troféu aumenta os danos do elemento Água, mas não transforma água em vinho.');
INSERT INTO "item_descriptions" VALUES(12690,'pt','Este troféu aumenta os danos do elemento Água, mas não transforma água em vinho.');
INSERT INTO "item_descriptions" VALUES(12691,'pt','Este troféu aumenta os danos do elemento Água, mas não transforma água em vinho.');
INSERT INTO "item_descriptions" VALUES(12692,'pt','Este troféu aumenta os danos do elemento Fogo. A etiqueta dele dizia: "Feito para aqueles que adoram ver o circo pegar fogo."');
INSERT INTO "item_descriptions" VALUES(12693,'pt','Este troféu aumenta os danos do elemento Fogo. A etiqueta dele dizia: "Feito para aqueles que adoram ver o circo pegar fogo."');
INSERT INTO "item_descriptions" VALUES(12694,'pt','Este troféu aumenta os danos do elemento Fogo. A etiqueta dele dizia: "Feito para aqueles que adoram ver o circo pegar fogo."');
INSERT INTO "item_descriptions" VALUES(12695,'pt','Este troféu aumenta os danos do elemento Neutro. Ele foi criado pelo célebre alquimista Pea Ganeutro.');
INSERT INTO "item_descriptions" VALUES(12696,'pt','Este troféu aumenta os danos do elemento Neutro. Ele foi criado pelo célebre alquimista Pea Ganeutro.');
INSERT INTO "item_descriptions" VALUES(12697,'pt','Este troféu aumenta os danos do elemento Neutro. Ele foi criado pelo célebre alquimista Pea Ganeutro.');
INSERT INTO "item_descriptions" VALUES(12698,'pt','Este troféu aumenta os danos do elemento Terra. Você só vai conseguir impressionar as minhocas com ele.');
INSERT INTO "item_descriptions" VALUES(12701,'pt','Esse troféu aumenta a iniciativa em vez de diminuí-la.');
INSERT INTO "item_descriptions" VALUES(12702,'pt','Esse troféu aumenta a iniciativa em vez de diminuí-la.');
INSERT INTO "item_descriptions" VALUES(12703,'pt','Esse troféu aumenta a iniciativa em vez de diminuí-la.');
INSERT INTO "item_descriptions" VALUES(12704,'pt','Este troféu aumenta o peso máximo que você pode carregar, mas ele não é poderoso o suficiente para ajudá-lo a suportar o peso da sua consciência.');
INSERT INTO "item_descriptions" VALUES(12705,'pt','Este troféu aumenta o peso máximo que você pode carregar, mas ele não é poderoso o suficiente para ajudá-lo a suportar o peso da sua consciência.');
INSERT INTO "item_descriptions" VALUES(12706,'pt','Este troféu aumenta o peso máximo que você pode carregar. Mas não é poderoso o suficiente para ajudá-lo a suportar o peso da sua consciência.');
INSERT INTO "item_descriptions" VALUES(12707,'pt','Esse troféu aumenta as curas. Mas não vai fazer você ficar mais bonito.');
INSERT INTO "item_descriptions" VALUES(12708,'pt','Esse troféu aumenta as curas. Mas não vai fazer você ficar mais bonito.');
INSERT INTO "item_descriptions" VALUES(12709,'pt','Esse troféu aumenta as curas. Mas não vai fazer você ficar mais bonito.');
INSERT INTO "item_descriptions" VALUES(12712,'pt','Este troféu aumenta a sua Agilidade. Você finalmente vai conseguir subir uma escada sem cair.');
INSERT INTO "item_descriptions" VALUES(12713,'pt','Este troféu aumenta a sua Agilidade. Você finalmente vai conseguir subir uma escada sem cair.');
INSERT INTO "item_descriptions" VALUES(12714,'pt','Este troféu aumenta a sua Agilidade. Você finalmente vai conseguir subir uma escada sem cair.');
INSERT INTO "item_descriptions" VALUES(12715,'pt','Esse troféu aumenta a sua Chance. Mas não parece ter nenhum outro efeito quando você digita coisas bregas nos bate-papos.');
INSERT INTO "item_descriptions" VALUES(12716,'pt','Esse troféu aumenta a sua Chance. Mas não parece ter nenhum outro efeito quando você digita coisas bregas nos bate-papos.');
INSERT INTO "item_descriptions" VALUES(12717,'pt','Esse troféu aumenta a sua Chance. Mas não parece ter nenhum outro efeito quando você digita coisas bregas nos bate-papos.');
INSERT INTO "item_descriptions" VALUES(12718,'pt','Este troféu aumenta a Inteligência. Por que será que eles não são oferecidos aos vendedores ambulantes do Zaap de Astrub?');
INSERT INTO "item_descriptions" VALUES(12719,'pt','Este troféu aumenta a Inteligência. Por que será que eles não são oferecidos aos vendedores ambulantes do Zaap de Astrub?');
INSERT INTO "item_descriptions" VALUES(12720,'pt','Este troféu aumenta a Inteligência. Por que será que eles não são oferecidos aos vendedores ambulantes do Zaap de Astrub?');
INSERT INTO "item_descriptions" VALUES(12722,'pt','Esse troféu aumenta a sua Força. Infelizmente, ele não aumenta o poder da sua mente.');
INSERT INTO "item_descriptions" VALUES(12723,'pt','Esse troféu aumenta a sua Força. Infelizmente, ele não aumenta o poder da sua mente.');
INSERT INTO "item_descriptions" VALUES(12724,'pt','Esse troféu aumenta a sua Força. Infelizmente, ele não aumenta o poder da sua mente.');
INSERT INTO "item_descriptions" VALUES(12725,'pt','Este troféu aumenta a sua Vitalidade. Sua eficácia contra a impotência nunca foi comprovada.');
INSERT INTO "item_descriptions" VALUES(12726,'pt','Este troféu aumenta a sua Vitalidade. Sua eficácia contra a impotência nunca foi comprovada.');
INSERT INTO "item_descriptions" VALUES(12727,'pt','Este troféu aumenta a sua Vitalidade. Sua eficácia contra a impotência nunca foi comprovada.');
INSERT INTO "item_descriptions" VALUES(12747,'pt','Este troféu aumenta os danos do elemento Terra. Você só vai conseguir impressionar as minhocas com ele.');
INSERT INTO "item_descriptions" VALUES(12748,'pt','Este troféu aumenta os danos do elemento Terra. Você só vai conseguir impressionar as minhocas com ele.');
INSERT INTO "item_descriptions" VALUES(12753,'pt','A bola entre as duas bordas do Pongcinto se movem ao redor do cinto o tempo todo, mexendo sem parar em seus pneuzinhos. Resumindo, é bem ridículo, desagradável e definitivamente sem glamour. Mas, dizem que ajuda a perder peso, então você deveria pelo menos tentar.');
INSERT INTO "item_descriptions" VALUES(12754,'pt','O amuleto em seu pescoço é uma versão miniatura do Ponguleto original, que era grande e largo como uma Arvraknídeo. Após vários pescoços quebrados e uma resposta azeda da crítica, seu criador decidiu fazer uma versão portátil, que foi um enorme sucesso.');
INSERT INTO "item_descriptions" VALUES(12756,'pt','Nunca dê este amuleto a uma criança: ela certamente morderia os fantasmas que o ornam, e isso a mataria instantaneamente. Mas o estranho mesmo é que mascar um tipo especial de chiclete transforma esses perigosos fantasmas em um doce inofensivo e saboroso.');
INSERT INTO "item_descriptions" VALUES(12757,'pt','Essas botas são capazes de acabar com tudo que você chuta. Um chute nos países baixos com essa Pacmabota é o pior pesadelo de um aventureiro.');
INSERT INTO "item_descriptions" VALUES(12774,'pt','Essa botas com raquetes de madeira serão suas companheiras aonde quer que você vá. Elas são resistentes a sucos digestivos e humor cáustico.');
INSERT INTO "item_descriptions" VALUES(12775,'pt','Esse cinto de madeira é perfeito para segurar grandes estomagos e proteger barriguinhas de acertos críticos.');
INSERT INTO "item_descriptions" VALUES(12848,'pt','Este manto, em si, já é uma contradição. Decerto, vestem-no para não tremer mais de frio, mas tremem de qualquer maneira por causa dos inúmeros guizos pendurados nas extremidades.');
INSERT INTO "item_descriptions" VALUES(12849,'pt','Com este gorro na cabeça, você dará a seus companheiros uma boa desculpa para você chamar atenção.');
INSERT INTO "item_descriptions" VALUES(12850,'pt','Esta cueca samba-canção manterá sua virilidade bem quentinha e, graças aos guizos sabiamente colocados, quando uma moça lhe agradar, ela avisará quem estiver à sua volta.');
INSERT INTO "item_descriptions" VALUES(12851,'pt','Os Gluendes transformaram este chocalho de bebê em um magnífico bracelete. Ao sacudi-lo com força, talvez você consiga abafar os gritos dos turistas Astrubianos.');
INSERT INTO "item_descriptions" VALUES(12852,'pt','Jack gostaria de ter sido um vampiro, porém teve de se contentar, por toda sua vida, com o fato de ser relegado à posição de esqueleto. Para ter um mínimo de classe, ele mandou confeccionar esta capa.');
INSERT INTO "item_descriptions" VALUES(12853,'pt','A dissimulação de Jack era tal que ele tivera a ideia disparatada de se disfarçar de si mesmo para realizar seus malefícios e bagunçar o coreto. Com esta máscara, você poderá fazer o mesmo, desde que seja um Sram.');
INSERT INTO "item_descriptions" VALUES(12854,'pt','Jack era um Sram que gostava muito de doces e travessuras. Por isso, ele passava a maior parte do tempo batendo às portas das casas para conseguir balas, até o dia em que bateu à porta doTengu Gelifox, enquanto ele recebia a visita da Fuji Gelifox. Do infeliz Jack, só encontraram este amuleto.');
INSERT INTO "item_descriptions" VALUES(12855,'pt','Jack era considerado excêntrico pelos outros Frigostianos. É por essa razão que só um sapateiro de Amakna, membro da Ordem do Bota-Fora, aceitou lhe confeccionar estas botas. A forma delas é especialmente concebida para amplificar as técnicas secretas da Ordem.');
INSERT INTO "item_descriptions" VALUES(12856,'pt','A facilidade de acesso às garrafas propiciada em combate torna esta mochila muito popular entre os aventureiros Pandawas.');
INSERT INTO "item_descriptions" VALUES(12857,'pt','Este capacete é um bom meio de mostrar para os rivais que você procura um desafio à sua altura. É também uma forma simples de enviar uma mensagem explícita a todas as meninas, ainda que o resultado não seja garantido.');
INSERT INTO "item_descriptions" VALUES(12858,'pt','Use esse cabresto se você tiver medo de se perder e jamais ser encontrado. Este truque foi testado e aprovado pelos criadores de Papatudo.');
INSERT INTO "item_descriptions" VALUES(12859,'pt','Estes tamancos são dotados de solas antiderrapantes. O sapateiro que os fabrica afirma que é para evitar o escorregão sobre o gelo, mas todo mundo sabe que, na verdade, é para não escorregar nas poças de álcool durante as noitadas regadas à bebida.');
INSERT INTO "item_descriptions" VALUES(12882,'pt','Calçado com estes tamancos, perceberão que você está chegando com um "clop clop" muito atraente. Seguido, a maior parte do tempo, de um "PUF" forte quando você tiver caído no chão, porque estes tamancos redondos e rígidos não são mesmo bons para o equilíbrio.');
INSERT INTO "item_descriptions" VALUES(12883,'pt','Penteie-se novamente em um instante com este Penteativo que permitirá que você enfrente qualquer situação um pouco embaraçante demais. Por outro lado, não são os fracos poderes conferidos por ele que permitirão que você despenteie seus adversários.');
INSERT INTO "item_descriptions" VALUES(12887,'pt','Este Gladialção, usado com mais nada, serve maravilhosamente aos combatentes viris e musculosos. Você acertou em cheio porque, com ele, no melhor dos casos, você se passará por alguém realmente bizarro, ou pior, por um louco pervertido e perigoso.');
INSERT INTO "item_descriptions" VALUES(12888,'pt','Estas botas amortecem os seus chutes para evitar que você machuque seu adversário. É muito gentil da sua parte, mas isso não impedirá que os Papatudos cravem os dentes na sua perna. E sem moderação dessa vez.');
INSERT INTO "item_descriptions" VALUES(1012963,'pt','Fiel companheiro de caça dos Gluendes que percorrem a taiga, o Metiodent está sempre com fome, o que o deixa meio irritadiço.');
INSERT INTO "item_descriptions" VALUES(12969,'pt','Este bracelete é tão enorme que poderia servir de cinto para você ou para colocar em seus tornozelos de tão inchados que estão. Ele também pode servir de coroa para os cabeções do seu tipo. O joalheiro que o concebeu realmente tem senso prático.');
INSERT INTO "item_descriptions" VALUES(12975,'pt','Este Tofu Congelado tem realmente um bico, diferenciando-se assim das Bobolas de Neve. Cansado da ilha dos Gluendes e dos hinos de Nataw, ele decidiu seguir você para explorar novos horizontes. A presença dele ao seu lado não é o mais maravilhoso dos presentes?');
INSERT INTO "item_descriptions" VALUES(12982,'pt','A Ratazete é a vegetariana mais voraz de toda Amakna. Dentre seus passatempos favoritos estão: fazer seus inimigos comerem dentes-de-leão diabólicos pela raiz, mandá-los regar as rosas demoníacas, e depois degustar tudo numa salada de Cogu Cogu com óleo de girassol selvagem. E dizem que os carnívoros são sanguinários...');
INSERT INTO "item_descriptions" VALUES(12988,'pt','O Scarakiri tem um conceito de honra elevado ao extremo. Por não suportar mais a agressividade injustificável de seus irmãos da ilha do Minotoror, ele se resignou a servir você para pagar pelos erros de seus semelhantes e restabelecer a honra de sua longa linhagem de respeitáveis Scaratos. Se ele fracassar, só lhe restará morrer.');
INSERT INTO "item_descriptions" VALUES(12994,'pt','O Raulor é o menorzinho de todos os Raul Mops e sofre muito por isso. Até os Pesks são maiores do que ele e adoram ridicularizá-lo. Reclamando constantemente dos que o ofendem, ele decidiu provar que tamanho não é documento: o importante, quando alguém quer impor respeito, é se tornar o melhor amigo de um brutamontes.');
INSERT INTO "item_descriptions" VALUES(13000,'pt','Ao contrário do que você pensava quando escolheu adotar o Mulerdo, ele não tem esse nome porque anda lentamente, e sim porque não é lá muito inteligente. Jamais engraçado, sempre maçante e de gosto duvidoso, Mulerdo é tão lerdo que acabou sendo banido da Toca do Mulobo e das Estepes de Sidimote.');
INSERT INTO "item_descriptions" VALUES(13017,'pt','Este cinto emplumado acompanhará às mil maravilhas sua barriga que engordou muito ultimamente.');
INSERT INTO "item_descriptions" VALUES(13018,'pt','Estas botas felpudas dão a impressão de que você tem pés de Dragoperu que dariam excelentes pantufas. Você conhece o tipo com o qual seus convidados se divertem quando veem você calçando em sua casa. Fala sério, você espera usá-las fora de casa?');
INSERT INTO "item_descriptions" VALUES(13020,'pt','Por causa de suas origens modestas, Cal nunca conseguiu usar nada nos pés a não ser tamancos rústicos. Assim, para manter sua postura de diva, ela pediu a um dos maiores sapateiros de Frigost que encontrasse uma solução para deixar os tamancos rosa dela mais chiques. Ele acabou se suicidando por não suportar o fato de ter criado um monstro desses.');
INSERT INTO "item_descriptions" VALUES(13022,'pt','O cristal que enfeita o colar de Cal pode entrar em sintonia com as cordas vocais dela e criar ondas de choque devastadoras. Em compensação, elas nunca serão tão destrutivas quanto a própria voz de Cal, que pode facilmente perfurar os tímpanos e até mesmo trincar um iceberg.');
INSERT INTO "item_descriptions" VALUES(13063,'pt','Durante muito tempo, Arty carregou esse bastão consigo. Uma extremidade era coberta de melaço de cana para atrair os rebanhos desgarrados de Papatudo e a outra era coberta de madeira áspera para puni-los melhor. É a ferramenta perfeita para os pais que lutam para conseguir o respeito dos filhos. Esse bastão parece ter um defeito de fabricação e é inutilizável. O assistente de Unde Dossó, o fabricante de esquis do burgo de Frigost, pode trocá-lo por uma versão funcional.');
INSERT INTO "item_descriptions" VALUES(13064,'pt','Esta touca é maldita, Katar, seu antigo proprietário, perdeu a cabeça duas vezes: ele ficou louco e acabou decapitado.');
INSERT INTO "item_descriptions" VALUES(13071,'pt','O Mekaranguejo é o fruto (do mar) da primeiríssima tentativa de criação de uma forma de vida completamente mecânica. Assim como todas as cobaias de experiências meio loucas, ele não deu muito certo. Ele passou a buscar de forma obsessiva o sentido da vida, por mais artificial que ela seja. Logo, chegou à conclusão de que quem o ajudaria a encontrar respostas seria você, que vive morrendo repetitivamente sem entrar em crise existencial.');
INSERT INTO "item_descriptions" VALUES(13091,'pt','Se os ossos do Chafer Ronin estão escurecidos é por causa de centenas de anos de vagabundagem sem mestre, guiados apenas por intenções obscuras. Se você for um é unicamente porque você não se lava há quinquênios.');
INSERT INTO "item_descriptions" VALUES(13092,'pt','Ao confiar em uma lenda obscura ouvida sobre os Chafers Draugr, certos aventureiros imaginam que se lançarem este martelo em seus inimigos, ele retornará para a mão tal como um bumerangue. Nunca se soube se isso era verdade, ninguém nunca conseguiu lançá-lo além dos próprios dedos do pé.');
INSERT INTO "item_descriptions" VALUES(13093,'pt','O Chafer Ronin, desprovido de qualquer carne, não veste roupas de baixo sob sua tanga, aberta na parte da frente: a vista de seu cóccix nunca chocou ninguém. A vista do seu, pelo contrário...');
INSERT INTO "item_descriptions" VALUES(13094,'pt','O sapateiro que criou estas botas se enganou e as fez à imagem das botas do Chafer Ronin. Certamente, ele pensou que você parecia bastante primitivo sem isso.');
INSERT INTO "item_descriptions" VALUES(13095,'pt','A bandana que você usará, na qualidade de Pandawushuka de nível Rokwa, possui inúmeros usos: em sua testa, mostrará para todos que você é um adepto das artes marciais; em seus olhos, permitirá que você faça a sesta em plena luz do dia; em sua boca, ela impedirá que você diga qualquer coisa.');
INSERT INTO "item_descriptions" VALUES(13099,'pt','Pulp é perfeitamente inofensivo, mas nunca foi aceito pelas outras criaturas aquáticas de Sufokia. Elas tremem só de pensar na possibilidade de Pulp crescer e ficar tão terrível quanto o Kralamor Gigante, primo distante dele. Você acha essa injustiça e esses preconceitos todos muito repugnantes, por isso decidiu estender a mão para o pequeno molusco, que imediatamente a segurou com os tentáculos.');
INSERT INTO "item_descriptions" VALUES(13114,'pt','Este cinturão foi confeccionado para que Brouce Boulgoure possa se requebrar corretamente quando cantar seu famoso refrão "Mama Amakna, a minha mãe é mãe solteira, Mama Amakna, e tem que fazer minha mamadeira".');
INSERT INTO "item_descriptions" VALUES(13115,'pt','Este anel possui uma extremidade afiada que permite marcar as árvores a serem cortadas. Dizem que Bruce Bulgur, depois de uma noitada regada à bebida, acariciou os ombros e o braço da amada esposa, Kassiopeia Baine, com este anel, deixando-lhe a terrível marca das árvores a serem cortadas. Por causa da infeliz tendência que ela tinha de utilizar o machado sem pedir permissão; no fim das contas, Bruce teve duas boas razões para cortar-lhe um ombro e um braço. Não se brinca com os lenhadores.');
INSERT INTO "item_descriptions" VALUES(13116,'pt','Estas botas foram especialmente concebidas por Bruce Bulgur com a ajuda de Hogmeiser e de Bowis para arrancar os tocos dos freixos e das nogueiras. Você não quer conhecer seus efeitos colaterais no traseiro.');
INSERT INTO "item_descriptions" VALUES(13117,'pt','Otomai é um alquimista famoso, particularmente por ter criado a poção contra a myxomawose. No entanto, ele não é tão famoso por sua teoria contestada sobre as Cenouwas, segundo a qual elas melhoram a vista, já que se sabe muito bem que os Wabbits nunca usam óculos.');
INSERT INTO "item_descriptions" VALUES(13118,'pt','Estas botas do renomado alquimista, Otomai, têm uma sola de esponja para absorver e limpar os líquidos derrubados no chão de seu laboratório. É bem verdade que elas são um pouco caras, porém, tenha em mente que elas permitem economizar, a cada mês, o salário de uma empregada ou de um empregado. Retorno garantido do investimento em menos de 248 anos.');
INSERT INTO "item_descriptions" VALUES(13119,'pt','Esta espada cortou muitas criaturas inocentes.
Mas foi pela Ciência.');
INSERT INTO "item_descriptions" VALUES(13120,'pt','De acordo com alguns rumores, Danathor teria mandado envenenar Rimaraf, o melhor amigo de Amayiro, ao lhe presentear com um bolo mortal cheio de Blops. Aqui está uma história engraçada para contar a seus filhos antes de colocá-los para dormir, explicando que não se devem aceitar alimentos de um desconhecido, principalmente quando estes têm cheiro de Blop.');
INSERT INTO "item_descriptions" VALUES(13121,'pt','O anverso deste amuleto é equipado com uma pedra abrasiva para depilar o torso daqueles que o usam. O vendedor que vendeu para você deve ter se esquecido de deixar claro que não era necessário dormir com isto.');
INSERT INTO "item_descriptions" VALUES(13122,'pt','Danathor foi escolhido por Jiva para ser o intendente da cidade de Bonta. Ele era tão pérfido e manipulador que a plebe achava que ele administrava em Brakmar.');
INSERT INTO "item_descriptions" VALUES(13123,'pt','Allister era um simples pastor, antes de criar — se acreditarmos na lenda — a primeira guilda da história do Mundo dos Doze. Em seguida, ele capturou o demônio Obarue''Tod''Adiuk enchendo-o de sangue de Papatudo, depois prendeu-o em Amakna. Esses feitos fizeram de Allister um rei muito estimado por seus súditos: um exemplo a ser seguido por nossa juventude transviada que prefere jogar a ir atrás de aventuras.');
INSERT INTO "item_descriptions" VALUES(13124,'pt','Este anel teria sido dado a Allister por seu velho amigo Amayiro. Certos fuxiqueiros com pouco escrúpulo gostariam de ver nisso um romance escondido e não assumido ou uma tentativa de corrupção. Os fiéis de Allister o veem como uma marca inabalável de amizade. Os idiotas do vilarejo, simplesmente como um anel.');
INSERT INTO "item_descriptions" VALUES(13125,'pt','Era nessas botas que o Allister escondia seu antigo trocarte que outrora ele utilizava para resolver os problemas de temperamento de seus Papatudos. Dizem que, depois que se tornou rei, ele passou a utilizá-lo nele mesmo após os banquetes que ele organizava no castelo de Amakna.');
INSERT INTO "item_descriptions" VALUES(13127,'pt','Esta capa torna seu portador invisível, assim que ele se esconder dentro de um armário escuro. Para ser furtivo, não se esqueça de se movimentar sempre com seu armário escuro.');
INSERT INTO "item_descriptions" VALUES(13128,'pt','Lethaline Sigisbul é uma mercenária de Astrub inescrupulosa que vende suas habilidades para quem oferecer mais. O tamanho de sua bolsa demonstra que você não tem nada a ver com isso.');
INSERT INTO "item_descriptions" VALUES(13129,'pt','Couro, saltos e mais couro. Do que adianta enlouquecer com isto.');
INSERT INTO "item_descriptions" VALUES(13130,'pt','Ogivol Scalarcin foi condenado a seis meses de prisão por seu desprezo pela autoridade e pela infeliz tendência de roubar tudo o que encontra, mas, principalmente, aquilo que não lhe pertence. Os jovens astrubianos o consideram um herói revolucionário dos tempos modernos, o qual defende a liberdade de pensamento, de empréstimo e de partilha, de forma definitiva, dos bens alheios.');
INSERT INTO "item_descriptions" VALUES(13131,'pt','O difícil é saber se os ossos que compõem a capa do Ogivol Scafurtado são os de suas vítimas ou somente peças de reposição para este velho Sram com artrite.');
INSERT INTO "item_descriptions" VALUES(13132,'pt','A cada dia que passa, os ossos de Ogivol Scalarcin se separam um pouco mais uns dos outros. É a punição da artrite que Xelor escolheu. Este cinto permite que ele mantenha seus ossos no lugar quando está dançando a Akmanarena.');
INSERT INTO "item_descriptions" VALUES(13135,'pt','Quando você veio vê-lo pela primeira vez, franzininho e de baixa estatura como você era, Kin Mordemetal se abriu com o Mestre das Chaves: "Se aquele ali der a volta ao mundo, eu comerei meu chapéu". Levaria tempo, e voltar a dar forma ao capacete não era algo tão fácil, porém valia totalmente a pena.');
INSERT INTO "item_descriptions" VALUES(13136,'pt','Com sua cabeça no interior, nunca o conteúdo de um cofre teria sido tão decepcionante.');
INSERT INTO "item_descriptions" VALUES(13137,'pt','Uma vez vestido com este cinto, torna-se impossível retirá-lo sem a chave. Por isso ele é, logicamente, vestido pelas mulheres que têm os maridos mais ciumentos, pelas jovens que têm os pais mais preocupados com suas vidas íntimas, e por você, para o bem da humanidade. (já imaginou se a chave fosse jogada fora)');
INSERT INTO "item_descriptions" VALUES(13138,'pt','A chave deste pingenfre não abre nem o Capakofre, nem as Bofres Cota, nem o Cinto de Cofredade. Aliás, nem nenhum dos ferrolhos que você já tenha visto alguma vez. Por isso ela só tem razão de existir na esperança de que, um dia, sirva para alguma coisa. Um pouco como você.');
INSERT INTO "item_descriptions" VALUES(13139,'pt','Estas botas são as mais seguras do Mundo dos Doze. Com isso nos pés, você vai ter certeza de que ninguém mais virá roubar seus sapatos. Não protege seus dedinhos de pancadas de mesas baixas, de cadeiras e de outros móveis assassinos.');
INSERT INTO "item_descriptions" VALUES(13170,'pt','Se você usar esse amuleto logo abaixo do queixo, as asinhas deixarão o seu humor mais leve.');
INSERT INTO "item_descriptions" VALUES(1013182,'pt','Tão estúpido quanto um Dragoperu de armadura, o Kramkram tem todas as suas vantagens e ainda mais algumas. Alguns criadores dizem que ele poderia ser a raiz do gene kramaleônico nos Dragoperus, mas todas as tentativas de reprodução entre as duas espécies foram malsucedidas. Talvez Otomai esteja por trás desse milagre, mas ele ainda não quis se pronunciar a respeito.');
INSERT INTO "item_descriptions" VALUES(13194,'pt','Usar este chapéu é sempre uma boa desculpa para largar um quentinho. Também é muito útil para afastar inimigos, mas os Agentes de Charlie desaconselham seu uso aos clientes que pretendam ir para as terras de Sidimote.');
INSERT INTO "item_descriptions" VALUES(13197,'pt','Esta capa é a mais recente criação de Justin Dwa e com ela você vai suportar melhor as temperaturas glaciais de Frigost. Grossa, quente e perfumada, ele vai fazer lembrar, com um toque de nostalgia, os carinhos de uma mamãe Bwork.');
INSERT INTO "item_descriptions" VALUES(13230,'pt','Considerando a vida no arquipélago de Vulkânia como injusta demais, essa criatura decidiu sair do ovo e seguir você para lutar por um mundo melhor.');
INSERT INTO "item_descriptions" VALUES(13245,'pt','Durante muito tempo Arty carregou esse bastão com ele. Uma extremidade era revestida de melado de cana para atrair os rebanhos desgarrados de Papatudo e a outra era coberta de madeira áspera para puni-los melhor. É a ferramenta perfeita para os pais que lutam para conseguir o respeito dos filhos.');
INSERT INTO "item_descriptions" VALUES(13261,'pt','Com este escafandro na cabeça, ninguém vai saber se você é homem ou mulher. Seus novos amigos se sentirão muito desconfortáveis e não ousarão perguntar, com medo de ofendê-lo. E esse seu corpo em forma de tábua não vai ajudar em nada.');
INSERT INTO "item_descriptions" VALUES(13262,'pt','É suposto este saco-garrafa de mergulho conter ar comprimido para explorar as profundezas. Mas em vez disso, você o encheu de cerveja à pressão. Uma idéia de génio ou da bebedeira.');
INSERT INTO "item_descriptions" VALUES(13263,'pt','Estas botas pesadas de mergulho são um concentrado de tecnologia Steamer. Um autômato lhes permite andar em seu lugar, reduzindo a fadiga causada pelas suas deslocações apesar do lastro. Mesmo assim, considere ter à mão o fato de mergulho pois elas estão programadas para se deslocarem em direção ao mar.');
INSERT INTO "item_descriptions" VALUES(13264,'pt','Este cinto de mergulho funciona mas você não pode deixar de sentir um arrepio de repulsa só de pensar na morfologia do inventor deste cinto hexagonal rígido, com olhos para ver debaixo de água. Ver com quê?');
INSERT INTO "item_descriptions" VALUES(13265,'pt','Este anel, como o próprio nome indica, é essencial para os Steamers: ele permite monitorar a pressão do ar e o tempo que lhe resta durante seus mergulho submarinos. E, especialmente, permitem perder os imbecis que o tomam por uma bússola.');
INSERT INTO "item_descriptions" VALUES(13297,'pt','As peças metálicas deste anel são cravadas mas dobradas sobre si mesmas no interior dele. Ideal para Sacriers sensíveis querendo sugerir que gostam de dor.');
INSERT INTO "item_descriptions" VALUES(13298,'pt','Você fez muito bem em mudar o seu bracelete, já que tem o hábito de roê-los. Este, pelo menos, vai fazer você perder um ou dois kilopods dos 30 que você tem a mais.');
INSERT INTO "item_descriptions" VALUES(13301,'pt','Especialidade típica dos sapateiros que fazem boinas e pólos com listras, as Botófe são ideais para o treino: elas vão garantir um fluxo contínuo de monstros jogando-se para devorar suas botas... e deixar o resto que é muito menos gostoso.');
INSERT INTO "item_descriptions" VALUES(13302,'pt','Estas botas de couro enrugado o deixariam feio o suficiente para que parem de pedir sua mão em casamento.');
INSERT INTO "item_descriptions" VALUES(13303,'pt','Dizem que se você usar este cinto e disser as palavras mágicas "Tournicoti Tournicotão" da maneira mais ridícula possível, você será transportado para a Terra do Bosque Lindo. E que isso fará rir as testemunhas da cena.');
INSERT INTO "item_descriptions" VALUES(13304,'pt','Este cinto de escamas é lindo e poderoso mas seu uso é constrangedor: ao mínimo perigo, seu portador é tomado por uma vontade irrefreável de fugir para casa. Nada prático quando se vive em Pandala e se está em viagem por Frigost.');
INSERT INTO "item_descriptions" VALUES(13320,'pt','Este anel funciona também como pincel mágico. Com ele, basta um gesto para criar lindas gravuras. Para manter uma aparência de credibilidade, é melhor nunca ser visto no ato, pois você ficaria ridículo gesticulando em todas as direções.');
INSERT INTO "item_descriptions" VALUES(13321,'pt','Consideradas pelos críticos da arte da sapataria (sim, isso existe), como uma prova de que pode ser considerada uma arte, essas botas vão levar você a pensar que essa palavra já não quer dizer nada hoje em dia.');
INSERT INTO "item_descriptions" VALUES(13326,'pt','Pena que você não seja um iluminado, você seria uma bela lanterna.');
INSERT INTO "item_descriptions" VALUES(13327,'pt','As sementes de Abóbowa na parte de trás desta capa foram guardadas por Relouin, que foi quem a concebeu, para semear as Abóbowas e espalhar sua maldição pelo mundo inteiro. Enquanto isso, pode petiscar.');
INSERT INTO "item_descriptions" VALUES(13328,'pt','Relouin usava esse cinto até que ele ganhou vida devido a sua maldição e atacou os cintos de toda a gente que se cruzava com ele, sem que ele fosse capaz de o retirar. Isso foi muito embaraçoso e lhe deu a reputação de ser obsceno.');
INSERT INTO "item_descriptions" VALUES(13329,'pt','Relouin tem tanto cabelo que é mestre em pentear macacos.');
INSERT INTO "item_descriptions" VALUES(13344,'pt','Este Dofus muda de cor com as estações. Quente e dourado no pico do verão, torna-se frio como gelo com a vinda do inverno. Ele teria sido posto por um dragão apaixonado de um vendedor que se teria apresentado na entrada de sua caverna para lhe vender um velho calendário.');
INSERT INTO "item_descriptions" VALUES(13423,'pt','A autêntica cueca em couro modelador do Capitão Chafer desapareceu ao mesmo tempo que seu proprietário. No entanto, o célebre dançarino de tango deixou inúmeras roupas íntimas usadas​​ que serviram de modelo a alguns alfaiates fetichistas. Confortável, flexível e barata, a Cueca Sobressalente está ao alcance de todas as bolsas. Além disso, ela é reversível.');
INSERT INTO "item_descriptions" VALUES(13424,'pt','Esse chapéu pertencia ao velho John, o famoso pirata dos 107 oceanos. Diz a lenda que, em uma noite de tempestade, seu papagaio morreu dentro desse chapéu. Desde aquele dia fatídico, quem o usa começa a falar um pouco como o velho John.');
INSERT INTO "item_descriptions" VALUES(13459,'pt','Este amuleto gera interferências mágicas que alteram o funcionamento de suas cordas vocais e você não consegue parar de cantar "Di di di di di di".
Infelizmente, é parecido com o canto do ritual de acasalamento dos Kidos. Nunca é tarde demais para aprender a chocar.');
INSERT INTO "item_descriptions" VALUES(13460,'pt','Este anel colorido lembra sua infância despreocupada e ingênua em que seus braços estavam cobertos de pulseiras baratas e coloridas. A moda não poupa ninguém.');
INSERT INTO "item_descriptions" VALUES(1013465,'pt','O Javóquero, primo do Javali, é maior que ele e, principalmente, mais robusto e bem mais dócil. Contanto que você consiga diminuir o seu consumo de salames, ele carregará com o maior prazer tudo o que você não conseguir enfiar nos seus bolsos já ridiculamente cheios.');
INSERT INTO "item_descriptions" VALUES(13480,'pt','Não gostaria de usar o Arakapacete? Então, muito menos o Arakapacete peludo! Acolchoado com teia de Arakne, feito com mais pedaços dela e perfumado com seus feromônios para que uma Arakne apaixonada o siga sempre. Ofereça-o a um araknofóbico: ou ele supera o medo ou ele morre de pavor. É para o bem dele.');
INSERT INTO "item_descriptions" VALUES(13485,'pt','A fivela desse cinto tem uma abertura para poder armazenar seus pontos GG. Seu sapateiro colocou-o ao contrário porque ele sabe muito bem que você tende mais a perder pontos do que a ganhá-los.');
INSERT INTO "item_descriptions" VALUES(13486,'pt','Na falta de ocasiões de o fazer durante o torneio Krosmaster, com estes sapatos pelo menos você pode chutar a bunda de seus inimigos em combate. Só não vale chutar o balde!');
INSERT INTO "item_descriptions" VALUES(13582,'pt','Estes magníficos sapatos de pontas acolchoadas são um convite à dança. Eles podem ser usados com um tutu, ou com outra roupa se você não tiver medo do ridículo.');
INSERT INTO "item_descriptions" VALUES(13583,'pt','Esta varinha engana e se parece com um galho do Grande Glucid, uma árvore mítica que cresce na Geléia Dimensional. É sem dúvida por essa razão que ela atrai os Pequenos Geléias de Morango doces e tremelicantes.');
INSERT INTO "item_descriptions" VALUES(13584,'pt','Este cofre que é usado como um saco é uma invenção muito prática. Infelizmente, parece que atrai jovens Koalaks e os aborrecimentos. Só os aventureiros com as costas suficientemente largas podem usá-lo sem serem perseguidos pela má sorte.');
INSERT INTO "item_descriptions" VALUES(1013603,'pt','Dizem que o Cicatorpe é um dos Javalis mais velhos do Mundo dos Doze. Lutador lendário, considerado como um deus pelos pequenos Javalinos, ele sempre foi de uma honestidade exemplar. Combateu durante longos anos os piores patifes, como por exemplo os Pandidos e os aventureiros sem escrúpulos que vivem tentando enganar os outros.');
INSERT INTO "item_descriptions" VALUES(13629,'pt','Este anel em forma de roda dentada gira lentamente sobre si mesma, no sentido dos ponteiros do relógio. Só Henual compreende a importância desse movimento quase imperceptível. Uma coisa é certa: o anel não deve parar por nenhum motivo. Tenha muito cuidado, o destino de todo Krosmoz pode bem estar em seus dedos.');
INSERT INTO "item_descriptions" VALUES(13630,'pt','Este cinto é desenhado para proteger seu portador contra paradoxos temporais, raios krósmicos, atrasos sucessivos e sentimentos de déjà-vu. Em teoria, pelo menos. É melhor usá-lo apenas para não perder as calças, isso já será um bom começo.');
INSERT INTO "item_descriptions" VALUES(13631,'pt','Este martelo está equipado com um aquecedor cronomágico. Quando você o faz girar acima de sua cabeça e ele atinge a velocidade de 88 kamilhas por hora, ele te leva de volta para o futuro. No entanto, se a velocidade não for suficiente, você será transformado em um monte de estrume. Tanto faz né?');
INSERT INTO "item_descriptions" VALUES(13632,'pt','Usando este capacete, você terá um ar de Au-au magoado. Com uma focinho assim, você se arrisca a encontrar um osso, mas você também pode encontrar amigos dos animais que começarão gostando de você. Se você tiver sorte, eles acabarão por adotá-lo, quem sabe?');
INSERT INTO "item_descriptions" VALUES(13633,'pt','Um colar que se usa quando se é fiel e obediente. Se este não for seu caso, pode sempre mostrar os dentes e fazer cara feia.');
INSERT INTO "item_descriptions" VALUES(13634,'pt','Com estas botas que deixam pegadas muito peculiares, você vai poder zoar com seus amigos baralhando-lhes as pistas. Cuidado, você pode apanhar com uma flecha perdida à passagem.');
INSERT INTO "item_descriptions" VALUES(13635,'pt','Resistente quente e auto-limpeza, esta capa também é muito elegante. Como o que pode ser o maior lutador de Mundo dos Doze e um senso de moda.');
INSERT INTO "item_descriptions" VALUES(13636,'pt','O dente que adorna este amuleto foi arrancado de um monstro lendário. É um dragão, um Yech''Ti ou uma sogra? Só Nevark sabe, e ele vai levar esse segredo para o túmulo.');
INSERT INTO "item_descriptions" VALUES(13637,'pt','Diz-se que quem usa este cinto é capaz de atingir um Moskito em voo a três kilokâmetros. No entanto, não é aconselhável atravessar um campo de tiro com este acessório em torno da cintura.');
INSERT INTO "item_descriptions" VALUES(13638,'pt','A primeira manta deste gênero foi usada pelo Sargento Sombrinha. O militar teria oferecido sua capa a Tesodorante Ax para lhe agradecer a assistência na redação de suas memórias. É preciso dizer que a vida caótica de um oficial brakmariano sempre faz correr muita tinta.');
INSERT INTO "item_descriptions" VALUES(13639,'pt','Segundo a lenda, este amuleto permite apagar todos os erros cometidos ao longo da vida de um aventureiro. No seu caso, você precisaria de uns mil exemplares.');
INSERT INTO "item_descriptions" VALUES(13640,'pt','Estas botas tendem a deixar marcas pretas em tapetes e azulejos, o que irá desesperar seus funcionários, a menos que eles sejam Goblins.');
INSERT INTO "item_descriptions" VALUES(13641,'pt','Este capacete se assemelha à cabeça do último Scarachefe Marfim, esmagado por Nondome durante sua juventude. O comerciante que o vendeu garantiu-lhe que era o original. O mistério da etiqueta "Produzido em 10.000 exemplares" permanece intacto.');
INSERT INTO "item_descriptions" VALUES(13642,'pt','Por muito tempo, os sábios se dividiram sobre como usar um anel tão grande. Os primeiros diziam que o anel se usava no polegar, os outros diziam que era no dedão do pé. A verdade foi apenas descoberta recentemente, com a confirmação de um boato que diz que Nondome só pode usar esse anel nos dias de plena forma.');
INSERT INTO "item_descriptions" VALUES(13643,'pt','Nondome é o campeão indiscutível do esmagamento do crânio em chinelos. Não espere ultrapassá-lo com este calçado. No máximo, você pode igualá-lo se se fizer de morto para ganhar sapato novo!');
INSERT INTO "item_descriptions" VALUES(13644,'pt','Como qualquer chapéu mágico que se preze, este não inspira confiança, mas ... Ele já serviu de copo, de saco de vômito e de penico do grande Hel Munster quando ele ainda era um jovem aprendiz, ávido de conhecimento. Ainda hoje, poucos chapéus se podem vangloriar por cumprir tantas funções simultaneamente.');
INSERT INTO "item_descriptions" VALUES(13645,'pt','Quando Hel Munster perguntou ao seu mestre sobre como lutar contra o frio, este último disse-lhe que a resposta estava nas páginas de seu livro. Arrancou-as uma a uma e coseu-as para fazer esta capa original.');
INSERT INTO "item_descriptions" VALUES(13646,'pt','A pedra preciosa desse amuleto contém um concentrado de Brisa Quadramental e isso é todo o problema. Na verdade, a fim de se desfrutar plenamente de seus poderes mágicos, ela devia ser libertada mas apenas uma moça loira, bela, inteligente, peituda e com o sentido de orientação é capaz disso. Contente-se então com seus poderes básicos.');
INSERT INTO "item_descriptions" VALUES(13647,'pt','Este chapéu passou de moda há muito tempo, principalmente para as donas de casa com menos de 50 anos. No entanto, ninguém ainda ousou dizê-lo a Armyna. Bem... a verdade é que quem tentou dizê-lo, teve problemas.');
INSERT INTO "item_descriptions" VALUES(13648,'pt','As donas de casa com mais de 50 anos compram esse avental a baixo preço no salão de cozinha. Como você não sabe nada dessa matéria, você comprou-o a um alfaiate que o vendeu como sendo a última moda. No entanto, já o tínhamos avisado de que um bom comerciante é acima de tudo um bom mentiroso.');
INSERT INTO "item_descriptions" VALUES(13649,'pt','Originalmente concebida para preparar tortas, este rolo serve agora para distribui-las. Então você pode ficar feliz quando seu filho convidar os amigos para sua festa de aniversário.');
INSERT INTO "item_descriptions" VALUES(13657,'pt','Esta capa foi usada originalmente pelo profeta Sylkauf, o Merida da hibernação. A ideia surgiu-lhe quando viu os Krakóis arrastarem suas casas sobre as costas. Cansado de dormir em lugares desconfortáveis​​, ele compreendeu imediatamente o lado prático de andar sempre com seu colchão.');
INSERT INTO "item_descriptions" VALUES(13658,'pt','Estes chinelos são muito populares entre a nova geração que ama o seu conforto mas se recusa a fazer qualquer esforço para o merecer. Ao experimentá-los, você percebe que eles se adaptam às mil maravilhas.');
INSERT INTO "item_descriptions" VALUES(13659,'pt','Estes tamancos são à imagem de sua vida, você pode exibi-los orgulhosamente em seus pés para afastar as poucas pessoas que ainda têm pena de você. Eles também são eficazes para esmagar os dedos de mendigos e chutar os traseiros das crianças.');
INSERT INTO "item_descriptions" VALUES(13661,'pt','Você virou melhor amigo desse inseto com olhos inocentes. O bichinho tem uma carinha tão simpática que você quase vai conseguir esquecer que ele também é muito mala. Porque Kafarsa é um grande brincalhão e está sempre disposto a pregar peças em você. É melhor rir do que chorar.');
INSERT INTO "item_descriptions" VALUES(13667,'pt','Como seu nome indica, a Bulbenxerta foi criada a partir de um enxerto. Isso significa que ela é um clone, geneticamente idêntica à mãe. Então por que é diferente de todos os outros bulbos? Determinada a desvendar o mistério de suas origens, ela resolveu percorrer o Mundo dos Doze para colher o máximo de amostras possível de todos os seres vivos. Pode ser que os espécimes não sobrevivam, mas não importa: tudo em nome da ciência.');
INSERT INTO "item_descriptions" VALUES(13673,'pt','Kokulto é um Krakol fascinado pelas ciências ocultas. Como não possui mãos, fica difícil ele efetuar encantamentos, portanto o bicho acaba não sendo muito perigoso.');
INSERT INTO "item_descriptions" VALUES(13679,'pt','Tukaos faz jus ao seu nome: ele era muito bagunceiro na escola dos Kidos. Você não sabe direito como lidar com ele. O bicho vai lhe dar a maior trabalheira, mas no fundo ele é bonzinho e terá grande utilidade em combate se você ajudá-lo a preencher as lacunas que acumulou. Afinal, você também não era o melhor da sua classe na escola e mesmo assim conseguiu se sair bem, né?');
INSERT INTO "item_descriptions" VALUES(13748,'pt','Com esse troféu, você pode colar brutamontes nas suas botas, ou vice-versa. Não se esqueça de amarrar bem o cadarço.');
INSERT INTO "item_descriptions" VALUES(13749,'pt','Com esse troféu, você pode colar brutamontes nas suas botas, ou vice-versa. Não se esqueça de amarrar bem o cadarço.');
INSERT INTO "item_descriptions" VALUES(13750,'pt','Com esse troféu, você pode colar brutamontes nas suas botas, ou vice-versa. Não se esqueça de amarrar bem o cadarço.');
INSERT INTO "item_descriptions" VALUES(13751,'pt','Este troféu não é responsável pela fuga de cérebros.');
INSERT INTO "item_descriptions" VALUES(13752,'pt','Este troféu não é responsável pela fuga de cérebros.');
INSERT INTO "item_descriptions" VALUES(13753,'pt','Este troféu não é responsável pela fuga de cérebros.');
INSERT INTO "item_descriptions" VALUES(13754,'pt','Com esse troféu, você poderá brincar de médico com seus aliados ou inimigos, caso o combate esteja muito fácil.');
INSERT INTO "item_descriptions" VALUES(13755,'pt','Com esse troféu, você poderá brincar de médico com seus aliados ou inimigos, caso o combate esteja muito fácil.');
INSERT INTO "item_descriptions" VALUES(13756,'pt','Com esse troféu, você poderá brincar de médico com seus aliados ou inimigos, caso o combate esteja muito fácil.');
INSERT INTO "item_descriptions" VALUES(13757,'pt','Com esse troféu, você vai poder provar que a Força é forte na sua família.');
INSERT INTO "item_descriptions" VALUES(13758,'pt','Com esse troféu, você vai poder provar que a Força é forte na sua família.');
INSERT INTO "item_descriptions" VALUES(13759,'pt','Com esse troféu, você vai poder provar que a Força é forte na sua família.');
INSERT INTO "item_descriptions" VALUES(13760,'pt','Esse troféu vai te deixar mais inteligente e, assim, você poderá alcançar o nível 3 na escala de inteligência Bwork, cujos limites se situam entre menos infinito e 1.');
INSERT INTO "item_descriptions" VALUES(13761,'pt','Esse troféu vai te deixar mais inteligente e, assim, você poderá alcançar o nível 3 na escala de inteligência Bwork, cujos limites se situam entre menos infinito e 1.');
INSERT INTO "item_descriptions" VALUES(13762,'pt','Esse troféu vai te deixar mais inteligente e, assim, você poderá alcançar o nível 3 na escala de inteligência Bwork, cujos limites se situam entre menos infinito e 1.');
INSERT INTO "item_descriptions" VALUES(13763,'pt','Este troféu tem o poder de equilibrar todas as coisas. Menos os feitiços, talvez.');
INSERT INTO "item_descriptions" VALUES(13764,'pt','Este troféu tem o poder de equilibrar todas as coisas. Menos os feitiços, talvez.');
INSERT INTO "item_descriptions" VALUES(13765,'pt','Este troféu tem o poder de equilibrar todas as coisas. Menos os feitiços, talvez.');
INSERT INTO "item_descriptions" VALUES(13766,'pt','Um artesão inspirado gravou na base desse troféu a frase: "Eu tenho, você não tem".');
INSERT INTO "item_descriptions" VALUES(13767,'pt','Um artesão inspirado gravou na base desse troféu a frase: "Eu tenho, você não tem".');
INSERT INTO "item_descriptions" VALUES(13768,'pt','Um artesão inspirado gravou na base desse troféu a frase: "Eu tenho, você não tem".');
INSERT INTO "item_descriptions" VALUES(13769,'pt','Este troféu te protegerá contra os golpes mais sujos, mas também te impedirá de aplicá-los. Aproveite a oportunidade para agir como uma pessoa de bem.');
INSERT INTO "item_descriptions" VALUES(13770,'pt','Este troféu te protegerá contra os golpes mais sujos, mas também te impedirá de aplicá-los. Aproveite a oportunidade para agir como uma pessoa de bem.');
INSERT INTO "item_descriptions" VALUES(13771,'pt','Este troféu te protegerá contra os golpes mais sujos, mas também te impedirá de aplicá-los. Aproveite a oportunidade para agir como uma pessoa de bem.');
INSERT INTO "item_descriptions" VALUES(13772,'pt','Este troféu faz com que você mantenha sempre os pés no chão. Atenção: ele pode provocar dores terríveis se você utilizar uma montaria voadora.');
INSERT INTO "item_descriptions" VALUES(13773,'pt','Este troféu faz com que você mantenha sempre os pés no chão. Atenção: ele pode provocar dores terríveis se você utilizar uma montaria voadora.');
INSERT INTO "item_descriptions" VALUES(13774,'pt','Este troféu faz com que você mantenha sempre os pés no chão. Atenção: ele pode provocar dores terríveis se você utilizar uma montaria voadora.');
INSERT INTO "item_descriptions" VALUES(13775,'pt','Gribe ou Pandrista? Este troféu não te ajudará a tomar uma decisão.');
INSERT INTO "item_descriptions" VALUES(13776,'pt','Gribe ou Pandrista? Este troféu não te ajudará a tomar uma decisão.');
INSERT INTO "item_descriptions" VALUES(13777,'pt','Gribe ou Pandrista? Este troféu não te ajudará a tomar uma decisão.');
INSERT INTO "item_descriptions" VALUES(13778,'pt','Com este troféu, você vai poder ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(13779,'pt','Com este troféu, você vai poder ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(13780,'pt','Com este troféu, você vai poder ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(13781,'pt','Muitos jovens aventureiros acham que podem viver de amor e água fresca. Se eles fossem plantas, talvez.');
INSERT INTO "item_descriptions" VALUES(13782,'pt','Muitos jovens aventureiros acham que podem viver de amor e água fresca. Se eles fossem plantas, talvez.');
INSERT INTO "item_descriptions" VALUES(13783,'pt','Muitos jovens aventureiros acham que podem viver de amor e água fresca. Se eles fossem plantas, talvez.');
INSERT INTO "item_descriptions" VALUES(13784,'pt','Dizem que esse troféu força seu dono a lutar com o traseiro pro ar. Você mal pode esperar para testá-lo.');
INSERT INTO "item_descriptions" VALUES(13785,'pt','Dizem que esse troféu força seu dono a lutar com o traseiro pro ar. Você mal pode esperar para testá-lo.');
INSERT INTO "item_descriptions" VALUES(13786,'pt','Dizem que esse troféu força seu dono a lutar com o traseiro pro ar. Você mal pode esperar para testá-lo.');
INSERT INTO "item_descriptions" VALUES(13787,'pt','Com este troféu, você vai poder impedir o ataque de uma esposa raivosa ou a fuga de um marido que se recusa a lavar a louça.');
INSERT INTO "item_descriptions" VALUES(13788,'pt','Com este troféu, você vai poder impedir o ataque de uma esposa raivosa ou a fuga de um marido que se recusa a lavar a louça.');
INSERT INTO "item_descriptions" VALUES(13789,'pt','Com este troféu, você vai poder impedir o ataque de uma esposa raivosa ou a fuga de um marido que se recusa a lavar a louça.');
INSERT INTO "item_descriptions" VALUES(13790,'pt','Este troféu paralisa seus aliados de vergonha cada vez que você erra o alvo. Dissuasivo para alguns, divertido para outros.');
INSERT INTO "item_descriptions" VALUES(13791,'pt','Este troféu paralisa seus aliados de vergonha cada vez que você erra o alvo. Dissuasivo para alguns, divertido para outros.');
INSERT INTO "item_descriptions" VALUES(13792,'pt','Este troféu paralisa seus aliados de vergonha cada vez que você erra o alvo. Dissuasivo para alguns, divertido para outros.');
INSERT INTO "item_descriptions" VALUES(13793,'pt','Este troféu envia pequenas descargas elétricas em intervalos regulares, fazendo com que os músculos se contraiam. 
É ideal para não pegar no sono durante os almoços de família.');
INSERT INTO "item_descriptions" VALUES(13794,'pt','Este troféu envia pequenas descargas elétricas em intervalos regulares, fazendo com que os músculos se contraiam. 
É ideal para não pegar no sono durante os almoços de família.');
INSERT INTO "item_descriptions" VALUES(13795,'pt','Este troféu envia pequenas descargas elétricas em intervalos regulares, fazendo com que os músculos se contraiam. 
É ideal para não pegar no sono durante os almoços de família.');
INSERT INTO "item_descriptions" VALUES(13796,'pt','Desse troféu escorre um líquido viscoso muito útil na hora de se esquivar de um obstáculo imposto por um adversário. E seus carinhos serão muito menos ásperos agora.');
INSERT INTO "item_descriptions" VALUES(13797,'pt','Desse troféu escorre um líquido viscoso muito útil na hora de se esquivar de um obstáculo imposto por um adversário. E seus carinhos serão muito menos ásperos agora.');
INSERT INTO "item_descriptions" VALUES(13798,'pt','Desse troféu escorre um líquido viscoso muito útil na hora de se esquivar de um obstáculo imposto por um adversário. E seus carinhos serão muito menos ásperos agora.');
INSERT INTO "item_descriptions" VALUES(13799,'pt','Com este troféu, você poderá irritar todos os aventureiros que cruzarem o seu caminho.
Agora você sabe por que nunca conseguiu segurar uma namorada por muito tempo.');
INSERT INTO "item_descriptions" VALUES(13800,'pt','Com este troféu, você poderá irritar todos os aventureiros que cruzarem o seu caminho.
Agora você sabe por que nunca conseguiu segurar uma namorada por muito tempo.');
INSERT INTO "item_descriptions" VALUES(13801,'pt','Com este troféu, você poderá irritar todos os aventureiros que cruzarem o seu caminho.
Agora você sabe por que nunca conseguiu segurar uma namorada por muito tempo.');
INSERT INTO "item_descriptions" VALUES(13802,'pt','Quando a pressão fica forte demais, quando os pesados se tornam muito pesados e quando o peso da sua consciência ultrapassa o peso dos seus anos, é porque chegou a hora de usar esse troféu.');
INSERT INTO "item_descriptions" VALUES(13803,'pt','Quando a pressão fica forte demais, quando os pesados se tornam muito pesados e quando o peso da sua consciência ultrapassa o peso dos seus anos, é porque chegou a hora de usar esse troféu.');
INSERT INTO "item_descriptions" VALUES(13804,'pt','Quando a pressão fica forte demais, quando os pesados se tornam muito pesados e quando o peso da sua consciência ultrapassa o peso dos seus anos, é porque chegou a hora de usar esse troféu.');
INSERT INTO "item_descriptions" VALUES(13805,'pt','Ao agir primeiro, você terá a oportunidade de fazer a primeira burrada, de fazer papel de idiota, de ser ignorado como alvo prioritário, de morrer por último e, assim, ser considerado um herói.');
INSERT INTO "item_descriptions" VALUES(13806,'pt','Ao agir primeiro, você terá a oportunidade de fazer a primeira burrada, de fazer papel de idiota, de ser ignorado como alvo prioritário, de morrer por último e, assim, ser considerado um herói.');
INSERT INTO "item_descriptions" VALUES(13807,'pt','Ao agir primeiro, você terá a oportunidade de fazer a primeira burrada, de fazer papel de idiota, de ser ignorado como alvo prioritário, de morrer por último e, assim, ser considerado um herói.');
INSERT INTO "item_descriptions" VALUES(13808,'pt','Esse troféu te protegerá contra as quedas de terra. Muito útil se você trabalha cavando túneis subterrâneos.');
INSERT INTO "item_descriptions" VALUES(13809,'pt','Esse troféu te protegerá contra as quedas de terra. Muito útil se você trabalha cavando túneis subterrâneos.');
INSERT INTO "item_descriptions" VALUES(13810,'pt','Esse troféu te protegerá contra as quedas de terra. Muito útil se você trabalha cavando túneis subterrâneos.');
INSERT INTO "item_descriptions" VALUES(13811,'pt','Esse troféu te impedirá de tomar decisões em combate e você não se machucará mais quando tentar lançar um feitiço.');
INSERT INTO "item_descriptions" VALUES(13812,'pt','Esse troféu te impedirá de tomar decisões em combate e você não se machucará mais quando tentar lançar um feitiço.');
INSERT INTO "item_descriptions" VALUES(13813,'pt','Esse troféu te impedirá de tomar decisões em combate e você não se machucará mais quando tentar lançar um feitiço.');
INSERT INTO "item_descriptions" VALUES(13814,'pt','Este troféu poderá protegê-lo do fogo de palha.');
INSERT INTO "item_descriptions" VALUES(13815,'pt','Este troféu poderá protegê-lo do fogo de palha.');
INSERT INTO "item_descriptions" VALUES(13816,'pt','Este troféu poderá protegê-lo do fogo de palha.');
INSERT INTO "item_descriptions" VALUES(13817,'pt','Não jogue esse troféu pelo ralo.');
INSERT INTO "item_descriptions" VALUES(13818,'pt','Não jogue esse troféu pelo ralo.');
INSERT INTO "item_descriptions" VALUES(13819,'pt','Não jogue esse troféu pelo ralo.');
INSERT INTO "item_descriptions" VALUES(13820,'pt','Com este troféu, você vai se sentir como se estivesse nas nuvens.');
INSERT INTO "item_descriptions" VALUES(13821,'pt','Com este troféu, você vai se sentir como se estivesse nas nuvens.');
INSERT INTO "item_descriptions" VALUES(13822,'pt','Com este troféu, você vai se sentir como se estivesse nas nuvens.');
INSERT INTO "item_descriptions" VALUES(13823,'pt','A propaganda desse troféu já diz tudo: "Por apenas um punhado de Kamas, vença a impotência e recupere o seu vigor de antigamente."');
INSERT INTO "item_descriptions" VALUES(13824,'pt','A propaganda desse troféu já diz tudo: "Por apenas um punhado de Kamas, vença a impotência e recupere o seu vigor de antigamente."');
INSERT INTO "item_descriptions" VALUES(13825,'pt','A propaganda desse troféu já diz tudo: "Por apenas um punhado de Kamas, vença a impotência e recupere o seu vigor de antigamente."');
INSERT INTO "item_descriptions" VALUES(13826,'pt','Seus inimigos poderão saborear o gosto de ferrugem velha quando quebrarem os dentes ao mordê-lo.');
INSERT INTO "item_descriptions" VALUES(13827,'pt','Seus inimigos poderão saborear o gosto de ferrugem velha quando quebrarem os dentes ao mordê-lo.');
INSERT INTO "item_descriptions" VALUES(13828,'pt','Seus inimigos poderão saborear o gosto de ferrugem velha quando quebrarem os dentes ao mordê-lo.');
INSERT INTO "item_descriptions" VALUES(13829,'pt','Nas brincadeiras do recreio, você era o Moolobo que devorava os Pius. Você gravou com uma faca as letras das músicas de Grobeto Kralos nos bancos da igreja de Amakna. Você jogou criaturas mais fracas que você na fonte de Madrestam. Você botou fogo nas lixeiras de Astrub, depois de enchê-las com fadas de artifício e pequenos animais inocentes. Esse troféu é o seu novo brinquedo.');
INSERT INTO "item_descriptions" VALUES(13830,'pt','Esse troféu te ajudará a se emancipar e deixar o ninho. Próxima etapa: aprender a cozinhar qualquer coisa além de miojo.');
INSERT INTO "item_descriptions" VALUES(13831,'pt','Graças a esse troféu, você não deixará passar nenhum detalhe, nem mesmo a minúscula mancha de gordura de Blop na camisa do seu inimigo que está escondido atrás de um arbusto, dentro de um buraco, do outro lado da colina encoberta pela neblina.');
INSERT INTO "item_descriptions" VALUES(13832,'pt','Com esse troféu, seus inimigos fugirão de você chorando. Eles entenderão que você é capaz tanto do melhor quanto do pior. Principalmente do pior.');
INSERT INTO "item_descriptions" VALUES(13833,'pt','Com esse troféu, seus inimigos fugirão de você chorando. Eles entenderão que você é capaz tanto do melhor quanto do pior. Principalmente do pior.');
INSERT INTO "item_descriptions" VALUES(13834,'pt','Com esse troféu, seus inimigos fugirão de você chorando. Eles entenderão que você é capaz tanto do melhor quanto do pior. Principalmente do pior.');
INSERT INTO "item_descriptions" VALUES(13848,'pt','Essa faca, ao contrário de você, não é ordinária. Segundo uma velha lenda, ela faz com que os memexilhões se abram mais do que qualquer outra faca. Eles te oferecerão seu maior tesouro: as pérola de alma que recolheram no fundo do mar. Se você sempre sonhou em ter um rabo de peixe, vá pescar memexilhões com esta faca em punho. Você não vai se arrepender.');
INSERT INTO "item_descriptions" VALUES(13850,'pt','Os membros do bando da Vespa Negra usavam máscaras parecidas com essa. Esses indivíduos sinistros foram acusados de cometer os piores crimes: sequestro, destruição de pontes, tesouros fraudulentos e zumbidos inoportunos nos ouvidos. No entanto, até hoje não se sabe qual era a motivação desses canalhas.');
INSERT INTO "item_descriptions" VALUES(13851,'pt','Graças aos seus cintos, os Vespas Negras escaparam pelos ares quando a milícia chegou. Ninguém foi capaz de alcançá-los. É verdade que, sem um bom cinto, o bandido pode acabar perdendo as calças, a liberdade de movimento e a liberdade de uma maneira geral.');
INSERT INTO "item_descriptions" VALUES(13891,'pt','Os habitantes de Amakna menos informados pensam que o Javali Glacial, ancestral pre-histórico do Javali, é uma espécie extinta e que, por essa razão, não há problema algum em usar o marfim para confeccionar joias. Esse anel é ideal para mostrar que você jamais pôs os pés em Frigost e que você é meio idiota.');
INSERT INTO "item_descriptions" VALUES(13893,'pt','Cuidado! Perigo de morte! Esse amuleto foi feito a partir da garupa de um Javali Glacial. Nunca tente usá-lo como máscara de gás.');
INSERT INTO "item_descriptions" VALUES(13894,'pt','Se você for pequeno e feio, esse bastão foi feito para você! Mas não abuse, pois pato novo não mergulha fundo.');
INSERT INTO "item_descriptions" VALUES(13896,'pt','É o machado ideal para fazer reinar a paz nas pequenas cidades do oeste de Amakna. Se você se sair bem, vai ganhar um belo instintivo em forma de estrela.');
INSERT INTO "item_descriptions" VALUES(13897,'pt','Este anel é capaz de se adaptar à morfologia de quem o usa. Por conta disso, ele sempre acaba indo parar em locais duvidosos...');
INSERT INTO "item_descriptions" VALUES(14000,'pt','Esse chapéu foi criado por um alfaiate amante de gatos e opositor ferrenho do Comitê Contra os Miaws. Ele foi assassinado por membros da Sociedade Protetora dos Pingwins, opositores ferrenhos da exterminação da fauna do Lago Congelado.');
INSERT INTO "item_descriptions" VALUES(14001,'pt','Ogilol era um Sram meríocre que passou a sua vida miserável na sombra do Ogivol. Na época da descoberta da Ilha de Frigost, ele correu para lá na esperança de encontrar fama e glória, mas encontrou apenas um destino trágico. Dele só restou essa capa.');
INSERT INTO "item_descriptions" VALUES(14002,'pt','Era com essas botas que o Inferno pisoteava seus aprendizes e todos os princípios da boa conduta.');
INSERT INTO "item_descriptions" VALUES(14003,'pt','Durante seu trote, Styx foi jogado nas águas de um rio. Ele sobreviveu graças essas botas, que continuaram presas a seus pés quando Taytisse tentou puxá-lo para a margem.');
INSERT INTO "item_descriptions" VALUES(14004,'pt','Com essas botas, seu portador poderia estar em 7 lugares diferentes ao mesmo tempo. Isso explicaria a velocidade com a qual Mandrin se livrava dos coletores das guildas concorrentes.');
INSERT INTO "item_descriptions" VALUES(14005,'pt','Todo mundo sabe que todo grande combatente tem uma bota secreta. Will Killson tinha até duas! Ainda bem, porque andar com um pé descalço não é nada prático.');
INSERT INTO "item_descriptions" VALUES(14006,'pt','Esse anel pertencia a mais bela aprendiz de Inferno. Ela pereceu duas vezes, com queimaduras de terceiro grau na quarta dimensão da quinta emenda, ao cruzar o olhar ardente de seu mestre.');
INSERT INTO "item_descriptions" VALUES(14007,'pt','Dois dedos fatiados finamente. Esse foi o castigo que Styx sofreu por ter roubado esse anel.');
INSERT INTO "item_descriptions" VALUES(14008,'pt','Quando o crânio de um coletor resistia ao moedor, Mandrin usava esse anel para sufocá-lo.');
INSERT INTO "item_descriptions" VALUES(14009,'pt','Presente de um cliente ou espólio de uma vítima? Ninguém sabe como Will Killson conseguiu esse anel e ninguém liga.');
INSERT INTO "item_descriptions" VALUES(14030,'pt','Com esse escafandro, consertado por um Steamer que parecia saber o que estava fazendo, você deve conseguir atravessar a porta das Geofornalhas sem morrer asfixiado pelos vapores de enxofre. Em compensação, como o visor é quase opaco, é melhor não usar o capacete durante o combate, ou em qualquer atividade que requeira uma boa visão. Isso quer dizer que você não vai poder catar piolho na cabeça da sua sogra se estiver usando o seu escafandro magmático. Uma pena!');
INSERT INTO "item_descriptions" VALUES(14049,'pt','Esse anel é a marca de reconhecimento dos aventureiros de pouca fé que, como nunca viram seu deus com os prórpios olhos, não se pronunciam sobre sua existência.');
INSERT INTO "item_descriptions" VALUES(14050,'pt','Klim tem um inegável senso de moda, mas é preciso reconhecer que os grandes estilistas como ele costumam ser bastante excêntricos. Sem mencionar suas tendências sádicas, ninguém nunca viu o Klim sem sua máscara, ou então não viveu para contar a história. Só falta agora a Carla Garfield começar a usar óculos escuros o tempo todo.');
INSERT INTO "item_descriptions" VALUES(14051,'pt','A princípio, o forro da capa do Klim não era vermelho-sangue, mas ela passou muito tempo no chão de seus salões privados...');
INSERT INTO "item_descriptions" VALUES(14052,'pt','Há muito tempo atrás, o Klim usava a agulha do seu cinto para consertar tudo que estivesse em mau estado. Hoje em dia, ele a usa para destruir tudo que está em bom estado.');
INSERT INTO "item_descriptions" VALUES(14053,'pt','Klim usa essa touca para não ficar surdo com os gritos das vítimas que ele leva para os salões privados atrás da sua butique e para não ficar descabelado com todo esse esforço. É preciso saber se cuidar em todas as circunstâncias, independente dos outros.');
INSERT INTO "item_descriptions" VALUES(14054,'pt','É melhor nem saber para que tipo de tortura esse anel foi usado, nem a quais instrumentos cruéis ele pode ter sido anexado.');
INSERT INTO "item_descriptions" VALUES(14055,'pt','As Pás Tife são conhecidas por sua teimosia ao se recusarem de fazer seu trabalho, independente do tipo de solo, o que é um pouco inconveniente para uma pá. Mas foi encontrada uma nova utilidade para elas: ao colocar uma sob cada pé quando for caminhar pela praia, você não vai afundar na areia!');
INSERT INTO "item_descriptions" VALUES(14056,'pt','Desde que chegou a Frigost, Klim parece negligenciar o aspecto estético de sua sapataria para se concentrar no poder das suas criações a à magia lúgubre que elas possuem. Vendo por esse lado, essas botas são esplêndidas.');
INSERT INTO "item_descriptions" VALUES(14057,'pt','Com essa capa, você vai sentir tanto frio que vai pensar que não tem nada sobre as costas.');
INSERT INTO "item_descriptions" VALUES(14058,'pt','Caso suas mãos ainda não tenham sido congeladas pelas temperaturas extremas de Frigost.');
INSERT INTO "item_descriptions" VALUES(14059,'pt','Não se sabe ao certo como, mas ao usar esse cinto os homens são capazes de manter a cabeça fria em todas as circunstâncias. Pelo visto o cérebro deles não fica lá onde a gente pensava.');
INSERT INTO "item_descriptions" VALUES(14060,'pt','O capacete da Missiz Frizz é o símbolo do seu grande talento em forjamagia e modificação de objetos: ele é tão bem feito que protege tão bem quanto um capacete clássico, mas é muito menor e menos incômodo.');
INSERT INTO "item_descriptions" VALUES(14061,'pt','Cansada de esperar que o Conde Traspafrent coloque um anel no seu dedo, Missiz Frizz forjou ela mesma esta aliança para deixá-lo com ciúmes. O plano não deu certo, ele nem reparou.');
INSERT INTO "item_descriptions" VALUES(14062,'pt','Já que você não tem um caráter de aço temperado como o da Missiz Frizz, estas botas reforçadas farão com que sofra menos quando pisarem nos seus pés.');
INSERT INTO "item_descriptions" VALUES(14063,'pt','Esse chapéu é vendido aos aventureiros inocentes por uma organização criminosa, que os faz acreditar que se trata de um item obrigatório para entrar na Ilha de Frigost. É um negócio muito mais lucrativo que o anterior: extorsão em troca de proteção.');
INSERT INTO "item_descriptions" VALUES(14064,'pt','Se usada do avesso, a capa do Nileza pode servir de jaleco. Ou de babador.');
INSERT INTO "item_descriptions" VALUES(14065,'pt','O símbolo do amuleto do Nileza é uma referência à ciência, à inteligência, ao conhecimento e, sobretudo, ao equilíbrio dos elementos. Pena que não diga nada sobre o equilíbrio psicológico.');
INSERT INTO "item_descriptions" VALUES(14066,'pt','As botas do Nileza são as mais impermeáveis que existem. Compreende-se o motivo para tanta impermeabilidade quando um simples respingo faz crescer Alquilusões nos pés.');
INSERT INTO "item_descriptions" VALUES(14067,'pt','Essa aliança é grande demais para você e fica caindo do dedo, o que é muito inconveniente. Para piorar, ela pode explodir a qualquer momento.');
INSERT INTO "item_descriptions" VALUES(14068,'pt','Esse anel perturba a estrutura atômica de tudo que ele toca. Evite de se coçar com ele, sobretudo em áreas particularmente sensíveis.');
INSERT INTO "item_descriptions" VALUES(14069,'pt','Não, esse cinto não é considerado instável porque pode se autodestruir, alterar a gravidade ou te deixar louco. Ele só não consegue manter as calças no lugar.');
INSERT INTO "item_descriptions" VALUES(14070,'pt','Se a gente perdoa as bobagens, a canalhice e a impertinência do Sylargh, não é porque ele é mascarado, e sim porque é uma criança. Agora pare de fazer besteiras!');
INSERT INTO "item_descriptions" VALUES(14071,'pt','Na verdade, o Sylargh não tem capa. Esta aqui é grande demais, ele viveria tropeçando e ela se prenderia nas engrenagens das suas máquinas mortais. Você simplesmente roubou o lençol dele.');
INSERT INTO "item_descriptions" VALUES(14072,'pt','Este cinto não é um cinto, na verdade. Ele seria grande demais para o Sylargh. Trata-se de uma correia e de uma engrenagem, os principais instrumentos de trabalho do Diabrete. E você ainda pagou uma fortuna a um sapateiro por isso...');
INSERT INTO "item_descriptions" VALUES(14073,'pt','Com esses dentes longos e a cabeça de madeira, nenhum outro chapéu cairia tão bem em você.');
INSERT INTO "item_descriptions" VALUES(14074,'pt','Uma hora ou outra alguém vai te perguntar  se a sua capa vai na máquina.');
INSERT INTO "item_descriptions" VALUES(14075,'pt','Este amuleto não é o suficiente para transformar essa sua maquininha em uma máquina infernal.');
INSERT INTO "item_descriptions" VALUES(14076,'pt','Parece que nenhuma alma viva jamais viu o rosto do Conde Traspafrent, nem mesmo antes da glaciação que o forçou a viver em reclusão. O que será que ele esconde debaixo deste chapéu e que transformações seu rosto pode ter sofrido ao longo de todos esses anos?');
INSERT INTO "item_descriptions" VALUES(14077,'pt','Este anel permite que o Conde canalize o excesso de energia provocado por seus grandes poderes e que poderia destrui-lo se fugisse ao seu controle. Felizmente, você não precisa canalizar nada.');
INSERT INTO "item_descriptions" VALUES(14078,'pt','Entre seu castelo, seu espírito, sua ilha e seus monstros, os pés do Conde Traspafrent são os únicos que não foram congelados, graças a essas botas.');
INSERT INTO "item_descriptions" VALUES(14079,'pt','É difícil imaginar o Conde Traspafrent com um chapéu desses. Todo mundo tem o direito de passar por uma fase rebelde, mas a dele já dura mais de um século.');
INSERT INTO "item_descriptions" VALUES(14080,'pt','Pelo visto, o setor da joalheria não evoluiu tanto no último século.');
INSERT INTO "item_descriptions" VALUES(14081,'pt','Esse cinto é o único equipamento que o Conde usava antes da glaciação e que continua usando ainda hoje. A fivela congelou quando o Djaul lançou sua maldição e, desde então, ele não pode mais tirá-lo.');
INSERT INTO "item_descriptions" VALUES(14082,'pt','O Bububo, como todo bom aristocrata, é um grande fã de bailes de máscaras. Para seu desespero, ele é sempre barrado na entrada por não acreditarem que ele está fantasiado.');
INSERT INTO "item_descriptions" VALUES(14083,'pt','O Bububo consegue girar seu pescoço em um ângulo de 270º. Seu amuleto é vital quando ele se perde em suas rotações e não sabe mais onde está a frente do seu corpo.');
INSERT INTO "item_descriptions" VALUES(14084,'pt','O Conde Traspafrent ofereceu essa espada ao Bububo quando este foi ordenado cavaleiro. Ela é o símbolo de seu status entre os Sinistros, mas, como o Bububo não tem mãos, ela não serve para nada.');
INSERT INTO "item_descriptions" VALUES(14085,'pt','Esta capa é feita de receptores sensoriais chamados filoplumas, que lhe permitem sentir até o mínimo movimento de um inimigo atrás de você, mesmo se eles não derem um pio.');
INSERT INTO "item_descriptions" VALUES(14086,'pt','Se o Sinistrofu não tem pescoço, como ele pode usar um amuleto? É realmente um amuleto? Você prefere não saber.');
INSERT INTO "item_descriptions" VALUES(14087,'pt','As orelhas do Sinistrofu não são simétrcas, e é exatamento isso que permite que ele detecte a origem dos sons à sua volta com precisão. Não tente encontrar uma razão similar para explicar por que você tem um pé maior que o outro, não vai colar.');
INSERT INTO "item_descriptions" VALUES(14088,'pt','Com esse chapéu, o Conde Traspafrent podia manipular o tempo. Se você conseguir usá-lo ao menos como um capacete de soldador já será um grande feito.');
INSERT INTO "item_descriptions" VALUES(14089,'pt','O Conde Traspafrent inventou esse anel para poder prever com antecedência os dias muito frios. O anel nunca foi muito popular em Frigost. Por que será...');
INSERT INTO "item_descriptions" VALUES(14090,'pt','Tudo que atravessa o buraco desse amuleto reaparece em outra época. Não, nem pense nisso. O processo envolve a criogenização completa do "sujeito".');
INSERT INTO "item_descriptions" VALUES(14091,'pt','Se você usar esse amuleto de olho de Cicloide como monóculo, poderá observar as perturbações no continuum espaço-tempo, mas vai ficar com cara de idiota.');
INSERT INTO "item_descriptions" VALUES(14092,'pt','Esse anel informa a hora. Infelizmente, ninguém sabe lê-lo.');
INSERT INTO "item_descriptions" VALUES(14093,'pt','Essas botas avançam sozinhas ao ritmo de um passo por segundo. Prática para se locomover com pouco esforço, mas nem tanto para escapar da morte iminente.');
INSERT INTO "item_descriptions" VALUES(14094,'pt','O Strictus do Strígido é agouro de morte. Com esse amuleto, você pode se prevenir, mas ele não irá protegê-lo se os outros Sinistros tentarem matá-lo por ter usado os restos de um dos irmãos deles para fazer um colar.');
INSERT INTO "item_descriptions" VALUES(14095,'pt','O Strígido coloca garras no cinto para prender os restos de suas presas, assim ele tem sempre alguma coisa para beliscar quando bate a fome. Você, que vive com as mãos nos bolsos, tente não enganchar os braços.');
INSERT INTO "item_descriptions" VALUES(14096,'pt','Se você malhar os dedos dos pés diariamente durante vários meses, poderá se pendurar de cabeça para baixo nos galhos das árvores com a ajuda dessas garras. É muito útil!');
INSERT INTO "item_descriptions" VALUES(14097,'pt','O amuleto do Nocturlábio é também um pêndulo mágico, que se balança ao redor do pescoço sem parar. Pode ser usado para hipnotizar seus adversários ou a si mesmo, se você tiver tendências narcisistas.');
INSERT INTO "item_descriptions" VALUES(14098,'pt','Quando os Strígidos não conseguem digerir certos elementos de suas refeições, eles os regurgitam em forma de bola. Essas bolas são encontradas em todo canto no castelo do Conde. Se você dissecá-las, encontrará restos de ossos de aventureiros, quantidades enormes de pelos e muitas frustrações.');
INSERT INTO "item_descriptions" VALUES(14099,'pt','Já que as pontas do Nocturlábio são para-raios, essas botas são ideais para chutar seus adversários com toda a segurança mesmo durante tempestades.');
INSERT INTO "item_descriptions" VALUES(14130,'pt','A Correia Inglesa tem efeitos incompreensíveis sobre o comportamento. Ela te faz sentir vontade de comer linguiça no café da manhã, de tomar chá às 17h e de comer quantidades enormes de peixe empanado com batatas fritas, além de te deixar com um senso de humor esquisito. Mas os seus hábitos também são meio bizarros, então... Sei lá.');
INSERT INTO "item_descriptions" VALUES(14131,'pt','As adagas Grícola eram muito utilizadas na colheita de cereais em Frigost, antes mesmo da glaciação. Até que, um dia, um Amakniano apareceu com uma foice. E há ainda quem se pergunte por que Frigost era atrasada... Enfim, essas adagas se revelaram muito úteis para ceifar vidas, na falta de trigo.');
INSERT INTO "item_descriptions" VALUES(14132,'pt','Para a confecção dessas adagas, é preciso permanecer invicto durante dezenas de combates, para que elas adquiram o odor característico de sangue, suor e lágrimas. Ainda bem que você não teve que fabricá-las sozinho.');
INSERT INTO "item_descriptions" VALUES(14133,'pt','Esse machado pode transformar qualquer adversário em montaria. É só encravá-lo nas costas da sua vítima e depois usar o cabo como sela, sem esquecer de dar umas chicotadas para que ele avance mais rápido.');
INSERT INTO "item_descriptions" VALUES(14135,'pt','Tem quem pense que o vício é se mostrar totalmente desprovido de moral. Mas o vício, o verdadeiro vício, o vício galopante e maquiavélico, é vestir ternos de paetês, calças pata de elefante, dançar fazendo movimentos estranhos com a pelve e ter uma estranha obsessão em fazer as pedras rolarem.');
INSERT INTO "item_descriptions" VALUES(14146,'pt','Nada deixa essa picareta mais animada do que a ideia de quebrar pedras. Seu uso para outros fins é estritamente proibido.');
INSERT INTO "item_descriptions" VALUES(14156,'pt','Dizem que se você usar essa espada no glifo de um Feca, vai compreender os símbolos indecifráveis entalhados no centro. Além disso, parece que ela corta muito bem a pedra, a roseta e até o champignon.');
INSERT INTO "item_descriptions" VALUES(14159,'pt','Diposo era um Sadida obeso que tinha o hábito de usar seus inimigos derrotados como colchão. As marcas funestas em sua capa são testemunhas da terrível execução que eles sofreram. Diposo era considerado uma das criaturas mais cruéis do Mundo dos Doze.
Na verdade, ele só fazia isso porque necessitava de 23 horas de sono por dia. Haja colchão!');
INSERT INTO "item_descriptions" VALUES(14160,'pt','Dizem por aí que sentir prazer ao matar animais sem motivo poderia revelar os poderes sinistros desse amuleto e faria com que ele se enrolasse ao redor do pescoço para estrangular seu portador. Se fosse verdade, não existiria mais uma alma viva em Amakna.');
INSERT INTO "item_descriptions" VALUES(14161,'pt','O poder da capa Probe prova que as aparências às vezes enganam. Você é a prova de que elas não enganam.');
INSERT INTO "item_descriptions" VALUES(14162,'pt','Com esse cinto, você se sentirá superpoderoso mesmo após os combates menos perigosos. Afinal, vencer sem perigo é triunfar sem glória.');
INSERT INTO "item_descriptions" VALUES(14163,'pt','As sandálias Uzia são perfeitas para as férias em um lugar ensolarado, com praias de areia fina intermináveis e o mar na temperatura ideal. Pena que em Amakna esses lugares sejam infestados de monstros sanguinários ou, pior, turistas.');
INSERT INTO "item_descriptions" VALUES(14164,'pt','Pode parecer estranho, mas o poderosíssimo Arco Honte, que só os grandes dirigentes do Mundo dos Doze podem manusear, jamais foi usado em combate. Isso porque, para eles, não pegava bem ficar de longe durante a batalha usando um arco ao invés de se misturar com os soldados. Mesmo naquela época, guerras eram perdidas por causa do ego.');
INSERT INTO "item_descriptions" VALUES(14166,'pt','Uma maneira simples de parecer carismático é gritar: "Esse Bastumba será a sua tumba!", logo antes de dar um golpe fatal. Todo mundo adora uma frase de efeito.');
INSERT INTO "item_descriptions" VALUES(14167,'pt','Atenção: A sensação de poder experimentada quando esse bastão se abate sobre um adversário é tamanha que ela pode levar ao isolamento: na falta de inimigos, você vai acabar batendo em seus amigos.');
INSERT INTO "item_descriptions" VALUES(14168,'pt','Se alguém te convidar para sair e você não estiver muito a fim, é só dizer que está usando uma Capa de Sculpa. Sua aparência é tão peculiar que ela é a desculpa perfeita para recusar um convite com legitimidade.');
INSERT INTO "item_descriptions" VALUES(14169,'pt','Este amuleto tem o poder extraordinário de te fazer sonhar com coisas que não são reais.');
INSERT INTO "item_descriptions" VALUES(14170,'pt','Essa faixa é capaz de suprimir todo o espírito crítico de quem a porta, além de evitar que façam perguntas sobre o fato de ela ter sido concebida por figuras políticas e religiosas.');
INSERT INTO "item_descriptions" VALUES(14171,'pt','Apesar de seu nome ser bastante óbvio, ninguém jamais acreditou que as botas Rotedogue sejam realmente feitas com carne de Ouginak de procedência duvidosa. Seria uma pena se questões éticas impedissem a confecção dessas botas tão populares. Elas são tão práticas!');
INSERT INTO "item_descriptions" VALUES(14271,'pt','Se você gosta de apostar até a sua mãe num jogo de dados, você precisa desse colar, parecido com aquele usado pelo Miaw Sortudo. Com ele, você também poderá jogar na máquina de Kama Baraka, instalada na loja do Kerubim. Mas que sorte!');
INSERT INTO "item_descriptions" VALUES(14273,'pt','Alguns historiadores pobres de espírito afirmam que nunca houve um monarca em Bonta. Eis aqui a prova irrefutável de que eles estão enganados. A pesquisa minuciosa dos arquivos parece confirmar que a cueca real era usada tanto na cabeça quanto no traseiro, o que era muito prático durante os banquetes regados a bebida.');
INSERT INTO "item_descriptions" VALUES(14274,'pt','Reza a lenda que essa arma carregada de poder teria sido criada pelo Ulgrude do Trovão, o Protetor de Martalo. Na verdade, talvez seja um simples cajado de pastor... A Gobbette que te segue parece acreditar na segunda versão, a menos que a criatura tenha sido atraída pelo seu odor corporal.');
INSERT INTO "item_descriptions" VALUES(14277,'pt','Dizem que esse cinto de seda pertencia ao célebre Nabur, mestre das artes marciais. Nabur teria encantado o cinto para que le soasse em caso de perigo. Infelizmente, essa magia parece ter desaparecido. Que pena, pois teria sido útil para você em algumas situações.');
INSERT INTO "item_descriptions" VALUES(14281,'pt','Esse amuleto libera um calor suave que te fará lembrar com nostalgia da noite tórrida passada nos braços de uma Dragostess e de um guerreiro Dragovo. Você também pode utilizá-lo durante a noite para atrair mosquitos.');
INSERT INTO "item_descriptions" VALUES(14283,'pt','A cor muito clara desse cinto não combinava muito com o estilo vulkaniano. Por isso, ele foi imerso em sangue de turista, coberto de fuligem e depois furado, para ficar com um aspecto mais autêntico.');
INSERT INTO "item_descriptions" VALUES(14285,'pt','Pronto, agora sim sua cabeça está protegida do calor. Infelizmente, ela continua vulnerável às correntes de ar que certamente farão com que você esqueça do seu aniversário de casamento.');
INSERT INTO "item_descriptions" VALUES(14286,'pt','Com esse binóculo, você terá uma visão fragmentada do mundo que o cerca. Assim, talvez você conseguirá encontrar provas da existência dos deuses. De qualquer maneira, uma coisa é certa: você vai ficar com enxaqueca.');
INSERT INTO "item_descriptions" VALUES(14287,'pt','As propriedades metafísicas desse cristal fazem com que ele se ilumine na presença de arsênico. Você poderá utilizá-lo como lâmpada halógena no próximo banquete da sua aliança.');
INSERT INTO "item_descriptions" VALUES(14288,'pt','As companhias repressivas sanguinárias que formam o serviço de segurança do parque de Vulkânia utilizam esses bastões nos turistas em suas horas vagas. Isso acabou resultando em jogos como "Porradoleta", "Chuta carniça", "Cabo no burro", entre outros.');
INSERT INTO "item_descriptions" VALUES(14289,'pt','Esse machado, apesar do aspecto primitivo, é uma poderosa arma capaz de cortar em dois um turista imprudente ou uma sogra intrometida.');
INSERT INTO "item_descriptions" VALUES(14302,'pt','Esse anel brilha intensamente quando detecta a presença de vegetais hostis nos arredores. Sendo assim, você não deve utilizá-lo durante missões de infiltração na Floresta Petrificada. O problema é que, assim, você estará exposto aos riscos de uma invasão de plantas mutantes.');
INSERT INTO "item_descriptions" VALUES(14304,'pt','Este amuleto não é tão cortante quanto parece, o que pode decepcionar alguns. Ainda assim, ele é muito apreciado por Sacriers que se interessam por tudo que se parece, nem que seja de longe, com um instrumento de tortura.');
INSERT INTO "item_descriptions" VALUES(14310,'pt','Estas botas dão um novo significado à expressão "colocar alguém debaixo das suas asas". Elas também dão ao seu portador certas liberdades de movimento suplementares, o que é muito prático na hora de desviar dos golpes.');
INSERT INTO "item_descriptions" VALUES(14311,'pt','Você não sabe o que significa o símbolo gravado aqui, mas não importa. Este anel deixa traços notáveis da sua passagem no rosto dos seus adversários. Não é tão estiloso quanto gravar as suas iniciais com a ponta da sua espada, mas dá pro gasto.');
INSERT INTO "item_descriptions" VALUES(14433,'pt','Boskito é um Moskito que sofre com as gozações de seus colegas por ser corpulento. Ele decidiu, então, abandoná-los para viver sua vida como bem entendesse e está contando com você para se vingar desse mundo cruel que não aceita as diferenças. Porém, ele não deixa de ser um Moskito e, assim, pode lhe deixar algumas lembranças, irritantes, dos momentos que vocês passarão juntos.');
INSERT INTO "item_descriptions" VALUES(14491,'pt','Esta coroa é tão pesada que o Wei Wabbit só a usa em ocasiões especiais. Recomendada aos cabeças-duras, ela também pode ser usada como escudo, se você não quiser ficar com dor no pescoço.');
INSERT INTO "item_descriptions" VALUES(14492,'pt','Esta capa pesa muito sobre os seus ombros. Será que é o peso da consciência do Wei Wabbit ou da sua?');
INSERT INTO "item_descriptions" VALUES(14493,'pt','Este cinto é completamente oco e esconde umas das reservas pessoais de cenouwa do Wei Wabbit. Isso pode lhe salvar a vida se algum dia você se perder nas profundezas da floresta dos pinheiros perdidos.');
INSERT INTO "item_descriptions" VALUES(14494,'pt','Dizem que o par de orelhas preso a esse capacete reluzente permite ouvir como um Wabbit. Pelo visto, seu antigo proprietário era surdo como uma porta.');
INSERT INTO "item_descriptions" VALUES(14495,'pt','Este cinto era a recompensa de um grande torneio no qual os Wabbits, escolhidos a dedo, se enfrentavam a patas nuas. Após a vitória de um Vovô Wabbit Branco, uma nuvem de dúvida pairou sobre o torneio: os Wabbits se perguntavam se não se tratava na realidade de uma armação com o objetivo de vender suco de cenouwa, oferecido por um preço exorbitante durante o evento.');
INSERT INTO "item_descriptions" VALUES(14496,'pt','Com a idade, todos os Wabbits acabam exalando o mesmo cheiro, o que dificulta a tarefa de distingui-los uns dos outros. Então, seus congêneres desenvolveram estes braceletes para identificar os Vovôs Wabbits Brancos: cada bracelete tem um cheiro diferente.');
INSERT INTO "item_descriptions" VALUES(14497,'pt','O terceiro olho desse anel é resultado de uma manipulação genética sofrida pelos Wabbits Céfalos. É bem provável que ele provoque efeitos colaterais no seu organismo: se você sentir que está nascendo um novo olho, um nariz ou um braço, é melhor tirar o anel antes que a situação piore.');
INSERT INTO "item_descriptions" VALUES(14498,'pt','Poucas pessoas se atrevem a usar esse amuleto: apesar de fofinho, o rabo do Wabbit Céfalo libera um cheiro que pode ser desagradável para aqueles que não estão acostumados. Já para você, que tem o hábito de sassaricar pela zona do Waldo, não vai ser um problema.');
INSERT INTO "item_descriptions" VALUES(14499,'pt','Os Wabbits Céfalos têm três patas. Graças a duas delas, você tem um novo par de botas. Mas ainda resta um mistério a ser solucionado: o pé do meio do Wabbit Céfalo corresponde ao seu pé esquerdo ou direito?');
INSERT INTO "item_descriptions" VALUES(14500,'pt','Os Lobiwabbits são conhecidos por sua ferocidade e agilidade. Só de olhar para essas botas felpudas, dá para ver que elas não herdaram essas qualidades, mas pelo menos são confortáveis. Ainda assim, é bom tomar cuidado, pois pode haver alguns carrapatos mutantes morando aí dentro.');
INSERT INTO "item_descriptions" VALUES(14501,'pt','Esta capa macia pode ser usada como cobertor durante a noite. Mas se você pretende continuar vivo, lembre-se de não usá-la nas noites de lua cheia.');
INSERT INTO "item_descriptions" VALUES(14502,'pt','Se alguém lhe perguntar por que a cenouwa que enfeita esse cinto é violeta, você terá a oportunidade de contar a sua incrível história que envolve wabbits de duas cabeças, cenouwas vivas e wabbits-morcegos. Talvez você consiga manter um pouco de credibilidade depois disso. Talvez.');
INSERT INTO "item_descriptions" VALUES(14505,'pt','Este escudo é uma réplica do troféu levado pelos ganhadores da célebre corrida de dragoperus. Claro que ele não tem tanto prestígio quanto a taça original, mas, ainda assim, poderá evitar que você seja cortado em dois durante um combate. Nada mau.');
INSERT INTO "item_descriptions" VALUES(14506,'pt','Esta imitação grosseira da cabeleira flamejante dos Iops foi fabricada a partir de um novelo de lã abençoado pelo deus Ecaflip. Deve ser por isso que os Miaws Selvagens adoram brincar com ela.');
INSERT INTO "item_descriptions" VALUES(14519,'pt','Na sua época, a honorável juíza Lu fazia reinar a lei ao norte de Cania. Suas sentenças não tinham apelação e o barulho do seu martelo era temido por todos os criminosos que passavam pela sala de audiências do tribunal de Bonta. Dizem que só o Kerubim Crepim teria sido capaz de convencer a senhora juíza da inocência dos seus clientes, o bando dos Gordinos. No entanto, o método que ele usou para convencê-la é bastante controverso.');
INSERT INTO "item_descriptions" VALUES(14545,'pt','Para a sua sorte, o Fosfo é um dos poucos Wabbits originários dos laboratórios abandonados que não é prejudicial à saúde. Bom, pelo menos não em curto prazo. De qualquer forma, ele daria uma bela luminária para colocar no criado-mudo.');
INSERT INTO "item_descriptions" VALUES(14579,'pt','Antes de virar uma máscara, esse item foi usado como penico durante muito tempo e por muitas pessoas diferentes. Após um mal-entendido, o Dramak o colocou na cabeça e, orgulhoso demais para admitir seu erro, recusou-se a tirá-lo até hoje.');
INSERT INTO "item_descriptions" VALUES(14580,'pt','O uso desse cinto por um tal Levito causou muita polêmica entre os servos de Dramak, que precisou gastar muita energia para convencê-los de que ele era o único e verdadeiro chefe.');
INSERT INTO "item_descriptions" VALUES(14581,'pt','O Dramak não cansa de repetir as razões que o levaram a fabricar vários exemplares desse bracelete. Se destruir itens mágicos é um dos seus passatempos favoritos, você não vai demorar muito a fazer o mesmo com esse.');
INSERT INTO "item_descriptions" VALUES(14582,'pt','Os habitantes mais pérfidos do Mundo dos Doze usam esse cinto como meio de reconhecimento, para se assegurar de que não serão vítimas de seus companheiros. Dizem as más línguas que eles escolheram esse cinto simplesmente porque foi o mais barato que encontraram.');
INSERT INTO "item_descriptions" VALUES(14583,'pt','Quer dar uma de fanfarrão e atrair todos os olhares para a sua medíocre pessoa? Então esse chapéu foi feito pra você. Ele irá realçar a sua vaidade e covardia legendárias por um preço bem modesto.');
INSERT INTO "item_descriptions" VALUES(14584,'pt','Apesar de estar todo remendado, este arco continua sendo uma arma eficaz, capaz de atravessar um imbecil escondido no zaap de Astrub no meio dos vendedores ambulantes.');
INSERT INTO "item_descriptions" VALUES(14585,'pt','O Diboka não usa essa chave para abrir portas, mas para realizar todo tipo de tarefas exigidas pelo Dramak, como consertar seu teatro ou quebrar a cabeça dos aventureiros.');
INSERT INTO "item_descriptions" VALUES(14589,'pt','Este cinto proporciona o maior conforto para as suas nádegas, mas tome cuidado com os desconhecidos: pode ser que um deles faça parte da seita de colecionadores de calcinha liderada pelo Rando. É sabido que os membros dessa seita costumam agredir as vítimas para se apoderar de suas roupas íntimas, então proteja bem a sua retaguarda!');
INSERT INTO "item_descriptions" VALUES(14593,'pt','Os Iops não são mesmo muito inteligentes. Eles não conseguem ver qual é a diferença entre o "e" e o "a", o que pode criar situações embaraçosas se resolverem oferecer um anel a alguém.');
INSERT INTO "item_descriptions" VALUES(14597,'pt','Este amuleto é muito usado no mês de Aperirel pelos naturalistas. A fragrância invade suas narinas e permite que suportem o fedor enquanto estudam o sistema de reprodução dos Porkassos. Pois é, os naturalistas são um bando de voyeurs!');
INSERT INTO "item_descriptions" VALUES(14601,'pt','Se você só estiver vestindo isso, vai parecer um idiota. Um idiota fofo, claro, mas ainda assim um idiota. Ah, mas e daí? Você não precisa ser inteligente para ser bonito.');
INSERT INTO "item_descriptions" VALUES(14605,'pt','Ao contrário do se pode pensar, esse anel não deve ser usado no dedo. Alguns Osamodas tentaram usá-lo em outro lugar durante a cerimônia de entronização, mas acabaram se dando mal.');
INSERT INTO "item_descriptions" VALUES(14609,'pt','Ninguém sabe exatamente de onde veio esse anel. Tudo que se sabe é que ele caiu da ponta de um Quabastão durante um encontro com a Bworka.');
INSERT INTO "item_descriptions" VALUES(14613,'pt','Todos os anos, este anel é oferecido como recompensa ao primeiro imbecil que sair vivo do bosque de Litneg fantasiado de Tofuna');
INSERT INTO "item_descriptions" VALUES(14617,'pt','O ninja branco é extremamente superficial e supersticioso. Como prova disso, temos esse belo amuleto que supostamente serve para protegê-lo, pelo qual ele pagou uma fortuna.');
INSERT INTO "item_descriptions" VALUES(14621,'pt','O amuleto do ninja negro contém poderes terríveis e sombrios, herdados de tempos antigos. Reza a lenda que esses poderes são capazes de matar até os deuses. O único problema é que a fórmula para usá-lo caiu no esquecimento há muito tempo, o que explica por que ele pode ser comprado por uma pechincha hoje em dia.');
INSERT INTO "item_descriptions" VALUES(14625,'pt','Dizem que o mensageiro Ermiss podia voar graças ao primeiro modelo dessas botas. Os sapateiros de Amakna, sempre muito cautelosos depois do incidente com as botas superpoderosas do Klim, decidiram reduzir drasticamente os seus efeitos antes de comercializá-las.');
INSERT INTO "item_descriptions" VALUES(14629,'pt','Mais prático que as rações secas e menos incômodo que o material de caça, esse cinto ainda é utilizado durante algumas operações de guerrilha dos Pandikazes.');
INSERT INTO "item_descriptions" VALUES(14633,'pt','Estas botas não são tão chiques quanto aquelas feitas com escamas de dragão branco, mas são muito populares entre os adolescentes, que buscam equipamentos que combinem com seu conjunto Kawaii.');
INSERT INTO "item_descriptions" VALUES(14637,'pt','À primeira vista, essa medusa parece ser bastante dócil... Mas tome cuidado! Uma velha lenda diz que ela teria o poder de transformar certas criaturas em pedra. No entanto, parece que essa habilidade só é eficaz contra os Smagadores, então, no fim das contas, ela não possui nenhuma utilidade fenomenal.');
INSERT INTO "item_descriptions" VALUES(14638,'pt','Ao usar este cinto, você se sentirá como um peixe na água. Essa expressão pode ser usada quase que literalmente, devido ao forte cheiro de gobião que ele exala.');
INSERT INTO "item_descriptions" VALUES(14639,'pt','Você sempre quis saber como as sereias fazem para não se perder nas profundezas do oceano? Este anel equipado com a mais nova tecnologia steamer de Geolocalização nas Profundezas de Sufokia pode ser a resposta.');
INSERT INTO "item_descriptions" VALUES(14640,'pt','Este bastão foi especialmente concebido para os combates submarinos. Logo, você não poderá usufruir de todo o seu potencial enquanto não aprender a nadar. Até lá, é melhor deixá-lo guardado, pelo bem dos seus companheiros e do seu também.');
INSERT INTO "item_descriptions" VALUES(14644,'pt','Muitos aventureiros estão dispostos a vender seus pais, sacrificar suas mascotes e comer suas montarias só para dar uma espiadinha no que se esconde debaixo desse avental.');
INSERT INTO "item_descriptions" VALUES(14798,'pt','Às vezes usado para castigar jovens Iops malcriados, este cinto resistente costuma ser usado bem apertado para conter a pança. Ele é muito popular entre a guarda pessoal do rei Allister.');
INSERT INTO "item_descriptions" VALUES(14803,'pt','Estas botas são indispensáveis nas apresentações teatrais tradicionais. Elas são usadas pelos seguranças do estabelecimento na hora de expulsar a pontapés os espectadores desrespeitosos.');
INSERT INTO "item_descriptions" VALUES(14806,'pt','Oferecer esse anel à pessoa desejada é uma maneira simples, eficaz e barata de alcançar seus objetivos. Infelizmente, parece que não funciona com os Enutrofs, mas quem seria louco o suficiente para reclamar?');
INSERT INTO "item_descriptions" VALUES(14809,'pt','Se você gosta de abrir o biquinho, sacudir as asinhas e remexer o rabicho, esse quacapacete foi feito para você. Além do mais, ele é rosa, o que o torna simplesmente indispensável.');
INSERT INTO "item_descriptions" VALUES(14810,'pt','Ao usar esta insígnia, você se tornará um Guardião da Paz. Com seu belo uniforme azul, você será um Papamaik, um agente da força pública. Os cidadãos honestos demonstrarão grande respeito por você e os delinquentes tremerão na base só de ouvir o seu nome. Bom, pelo menos na teoria. Na prática é o contrário.');
INSERT INTO "item_descriptions" VALUES(1014827,'pt','Kwalteza satisfará seu pendor pelo luxo: penas ao vento e sela de couro lhe proporcionarão uma experiência de voo única. A condição é que você satisfaça os caprichos dela: fique sabendo que não é em qualquer ninho que o senhor Kwak dorme, não.');
INSERT INTO "item_descriptions" VALUES(1014833,'pt','Esta montascote plana completamente. Incapaz de manter os pés no chão, ela vive sonhando com zonas desertas onde poderia ficar sem fazer nada sem ser perturbada por esses aventureiros inescrupulosos que só querem ser carregados nas costas.');
INSERT INTO "item_descriptions" VALUES(1014838,'pt','Alagah e Kema se entendem muito bem, apesar de terem personalidades completamente diferentes. Nas situações em que Kema costuma se esquentar, Alagah prefere deixar as coisas fluírem. Mas isso não o impede de mergulhar de cabeça, quando necessário.');
INSERT INTO "item_descriptions" VALUES(1014848,'pt','Ao contrário do Siroko, Oduba é muito pé no chão. Sem dúvidas é o companheiro ideal para quem vive com a cabeça nas nuvens, pois ele sabe trazer seu dono de volta à realidade, nem que precise usar a força.');
INSERT INTO "item_descriptions" VALUES(1014854,'pt','Kema é muito suscetível e fica de cabeça quente muito rápido. É melhor não irritá-lo se não quiser ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(14877,'pt','Se você usar esse chapéu fora de Sufokia, ninguém vai te levar a sério, porque vai fazer papel de idiota. No entanto, em baixo d''água, ele te deixa com um aspecto de predador. Mas não se empolgue, é apenas uma impressão.');
INSERT INTO "item_descriptions" VALUES(14878,'pt','Este talismã foi encontrado nas profundezas das águas de Sufokia e, com ele, seu portador seria capaz de respirar debaixo d''água. O que ninguém lhe disse é que ele foi encontrado no pescoço de uma vítima de afogamento. Mas, quem sabe, de repente o talismã só foi colocado depois do acidente...');
INSERT INTO "item_descriptions" VALUES(14879,'pt','Parece que esse anel pertencia ao Glifakir responsável por manter a ordem na ausência do Merkator. Como nenhum de seus colegas respeitava a sua autoridade e o chamavam de puxa-saco do chefe, ele acabou sendo demitido e caiu no ostracismo.');
INSERT INTO "item_descriptions" VALUES(14880,'pt','Agora não há mais dúvidas, ninguém mais vai querer chegar perto de você. Mas não vá pensando que este capacete é à prova de tolos. Há muitos engraçadinhos por aí que vão se divertir às suas custas, jogando frutas e legumes em você para que fiquem presos nos espinhos. Pelo menos vai enfeitá-lo um pouco!');
INSERT INTO "item_descriptions" VALUES(14881,'pt','Eis aqui uma bela proteção para o seu traseiro. Qualquer adversário que tentar atacá-lo pelas costas vai ter uma bela surpresa. Mas tenha cuidado, pois suas montarias podem não gostar muito dessas botas.');
INSERT INTO "item_descriptions" VALUES(14882,'pt','Apesar de ser pouco prático para algumas tarefas, podendo provocar acidentes, este anel pode ser muito útil fora dos campos de batalha. Para pegar alguns tipos de frutas, por exemplo: você não precisa mais sujar as mãos! O que seria de nós sem esse tipo de utensílio revolucionário?');
INSERT INTO "item_descriptions" VALUES(14883,'pt','Esta faixa também pode ser colocada sobre os olhos. Parece que isso facilita a exploração submarina. Pena que não seja tão eficaz na base abissal do Merkator!');
INSERT INTO "item_descriptions" VALUES(14884,'pt','Com este amuleto de nova geração, você poderá ver suas missões sob um novo ângulo. De agora em diante, você vai sentir uma enorme satisfação ao explorar lugares distantes e ajudar seus habitantes. E ainda por cima ele brilha no escuro!');
INSERT INTO "item_descriptions" VALUES(14885,'pt','Alguns Steamers usavam esta capa para impressionar as meninas. Bastava dizer "chirrion" para eles desaparecerem completamente diante do olhar fascinado dos espectadores. O único problema é que eles tinham que prender a respiração até reaparecerem, o que acabou dando origem a algumas brincadeiras de mau gosto. Desde então, as novas versões desta capa não possuem mais essa propriedade mágica.');
INSERT INTO "item_descriptions" VALUES(14886,'pt','Diz a lenda que os guerreiros do mar eram capazes de quebrar com um só golpe o casco de um navio usando essa arma. O célebre Capitão Anrevak era um especialista no assunto. Infelizmente, ele também era muito estabanado. Ele afundou com seu navio após tentar pregar um retrato de sua esposa na parede da sua cabine.');
INSERT INTO "item_descriptions" VALUES(14929,'pt','Este amuleto guarda um enorme segredo, algo ao mesmo tempo terrível e surpreendente! Mas, para abri-lo, é preciso engoli-lo. Depois, fica ao seu critério decidir como irá recuperá-lo.');
INSERT INTO "item_descriptions" VALUES(14930,'pt','Por trás desse nome esquisito, se enconde um cinto perfeitamente normal. Além de segurar as suas calças no lugar, ele dá um toque de estilo à sua indumentária. Às vezes, isso é tudo o que você precisa.');
INSERT INTO "item_descriptions" VALUES(14931,'pt','Estas botas são relíquias antigas impregnadas de um poder ligado à morte. No entanto, não se sabe ao certo sobre quem esse poder tem efeito: quem as calça ou o alvo de quem as calça?');
INSERT INTO "item_descriptions" VALUES(14932,'pt','Este anel lhe dará o incrível poder de controlar a sua própria sombra, para que ela imite todos os seus movimentos! Esse argumento de venda não parece convencer muita gente.');
INSERT INTO "item_descriptions" VALUES(14933,'pt','Essas botas não são nada confortáveis. Elas agradarão aqueles que acham que tudo era melhor antigamente, na época em que ainda era preciso sofrer para progredir. Com elas, você sofrerá o dia inteiro, mas sentirá uma grande sensação de alívio e prazer quando tirá-las à noite.');
INSERT INTO "item_descriptions" VALUES(14934,'pt','Não se engane: as duas manchas negras desse capacete, à altura dos olhos, não são aberturas. Você não vai conseguir ver muita coisa com ele, mas, em compensação, suas habilidades olfativas serão multiplicadas por dez. Isso pode ser uma desvantagem em algumas situações, principalmente se você entrar em um combate contra os bworks.');
INSERT INTO "item_descriptions" VALUES(14937,'pt','Esta capa, símbolo de um passado glorioso, é usada hoje em dia como um mero acessório pelos aventureiros em busca de reconhecimento. Na verdade, os verdadeiros Justiceiros pararam de usá-la quando um deles morreu esmagado em menos de um minuto depois de prendê-la em uma porta giratória.');
INSERT INTO "item_descriptions" VALUES(15009,'pt','Graças aos guizos pendurados neste cinto, é possível saber quando o Papai Cruel está chegando antes mesmo de vê-lo. Dessa maneira, a tensão vai aumentando à medida que o barulho se intensifica, indicando sua aproximação. Até que, no final, você se dá conta de que era apenas um papatudo desgarrado da Allisteria.');
INSERT INTO "item_descriptions" VALUES(15010,'pt','Estas botas ridículas cairão muito bem em você. Todo mundo sabe que o preto combina com tudo.');
INSERT INTO "item_descriptions" VALUES(15011,'pt','Se você usar este anel, vai pegar muito mal: ele representa todo o mal que o Papai Cruel fez aos habitantes da Ilha de Nataw. Algumas organizações estão até se mobilizando para proibi-lo.');
INSERT INTO "item_descriptions" VALUES(15012,'pt','Muita gente duvida da masculinidade do Arqueiro Violeta só por causa da cor que ele escolheu... Mas saiba que ele é um Justiceiro do Krosmoz muito viril, capaz de enfrentar os piores supervilões do Mundo dos Doze, como o Batofu, por exemplo!');
INSERT INTO "item_descriptions" VALUES(15013,'pt','Dizem que o Arqueiro Violeta gosta tanto dessa cor porque foi criado por Goblins. Isso explicaria o número incalculável de flechas cravadas no acampamento deles.');
INSERT INTO "item_descriptions" VALUES(15014,'pt','Este arco faz parte do arsenal do Arqueiro Violeta, mas ele tem muitos outros! Tem para todos os gostos: arcos que disparam flechas explosivas, flechas pegajosas, flechas bumerangue, abóbowas, corações e até arco-íris! Porque simplesmente trocar de flechas é muito convencional.');
INSERT INTO "item_descriptions" VALUES(15015,'pt','Não satisfeito em aterrorizar os fazendeiros com a sua corpulência imponente, o Cebonoso também é o único monstro capaz de fazer chorar instantaneamente qualquer adversário. Este chapéu guarda parte desse misterioso poder e, ainda por cima, é comestível.');
INSERT INTO "item_descriptions" VALUES(15016,'pt','Não deve ser confundida com a Cepocapa que, apesar de também ser 100% natural, é muito mais dura e áspera, além de ter um formato cilíndrico desconfortável.');
INSERT INTO "item_descriptions" VALUES(15017,'pt','Com essas botas, você finalmente terá uma desculpa para esse seu chulé horroroso.');
INSERT INTO "item_descriptions" VALUES(15059,'pt','Trata-se de uma verdadeira cabeça reduzida à escala 1:20 graças a um procedimento exclusivo que permite colocá-la no dedo como se fosse um anel. Um pesquisador anônimo conseguiu fazer o mesmo com o traseiro dos Bitufos, mas sua invenção não teve o mesmo sucesso. Sem dúvidas ele estava muito à frente do seu tempo.');
INSERT INTO "item_descriptions" VALUES(15060,'pt','Reza a lenda que Eltux, o Merida da Cor Azul, pintou os Kaniblus para homeagear a Blu, a Merida da Umidade. Ninguém sabe quais eram suas verdadeiras intenções e nem se ele conseguiu o que queria, mas todo mundo concorda que essa é a origem do humor de cão dos Kaniblus.');
INSERT INTO "item_descriptions" VALUES(15061,'pt','O alfaiate Kaniblu Ray inventou essa capa depois do fracasso de vendas da sua réplica de Boneca Ayped para adultos, que deram muito menos lucros que as caixas X vendidas nos distritos duvidosos de Bonta.');
INSERT INTO "item_descriptions" VALUES(15062,'pt','Com este chapéu, você ficará parecendo um Iop bestial, capaz de aterrorizar os astrubianos e talvez até os amaknianos. No entanto, vai precisar de muito mais do que isso para impressionar o Nevark.');
INSERT INTO "item_descriptions" VALUES(15063,'pt','A quantidade de marcas vermelhas nesse cinto servem para determinar se o Orfelino é um bom caçador ou não. Cada vez que ele devora uma presa viva, ele tem de afrouxar o cinto para não comprimir a pança. Já você pode usá-lo para contar quantas cervejas bebeu na taberna.');
INSERT INTO "item_descriptions" VALUES(15064,'pt','Todo mundo se pergunta o que aconteceu com o segundo olho dos Orfelinos, exceto os que possuem esse amuleto: eles conhecem a resposta, mas preferem guardá-la para si.');
INSERT INTO "item_descriptions" VALUES(15099,'pt','Este cinto muda de cor quando você mexe o quadril. É uma boa desculpa para sair por aí rebolando freneticamente.');
INSERT INTO "item_descriptions" VALUES(15100,'pt','Estas botas foram concebidas para tornar o dia do Karnaval dos Tofuliões o mais agradável possível. Por isso, elas são totalmente herméticas: não há o menor risco de que um dos projéteis lançados durante a celebração consiga se introduzir furtivamente nelas. Em compensação, na hora de tirá-las, o cheiro deve ser de matar.');
INSERT INTO "item_descriptions" VALUES(15110,'pt','Se você acha que adotou um bichinho que passa a maior parte do dia dormindo junto da lareira, vai ter uma surpresa.  A ferocidade da Miawyena é inversamente proporcional ao seu tamanho: ela morde, arranha e dilacera tudo que cai entre suas patas. Ela também adora olhar fixamente nos olhos do seu dono enquanto dá risadinhas, o que é meio desconcertante.');
INSERT INTO "item_descriptions" VALUES(15133,'pt','Graças à faixa que cobre os seus olhos, o Black Pekewabbit pode partir pra cima dos seus inimigos (ou aliados) sem pensar duas vezes. É ótimo para desviar a atenção!');
INSERT INTO "item_descriptions" VALUES(15157,'pt','O chapéu missioneiro costuma ser usado por pessoas que precisam de favores. Essas pessoas passam o dia no mesmo lugar, repetindo o mesmo discurso a qualquer um que estiver disposto a ouvi-lo. Que vida emocionante!');
INSERT INTO "item_descriptions" VALUES(15183,'pt','Se você quer um pouco de paz e tranquilidade, esta máscara é a solução ideal. Ela funciona como um repelente natural, afastando qualquer um que poderia se interessar por você, a começar pelas crianças. Cuidado para não se acostumar, senão vai acabar se tornando uma pessoa amarga.');
INSERT INTO "item_descriptions" VALUES(15184,'pt','Muito popular entre os Enutrofs, esta capa de aparência desgastada é bastante confortável. Além do mais, sua forma peculiar permite esconder uma eventual protuberância disforme nas costas.');
INSERT INTO "item_descriptions" VALUES(15185,'pt','Os Barbastrelas não podem abrir mão do cinto. Este acessório é responsável pela contenção de seus pelos, que costumam crescer em todas as direções, assim como a barba.');
INSERT INTO "item_descriptions" VALUES(15186,'pt','A coroa de Nidas também pode ser colocada do avesso, assim você poderá saber o que andam tramando pelas suas costas. Mas isso não quer dizer que ela protegerá a sua retaguarda: um Shushu continua sendo um Shushu e seria muito ingênuo da sua parte confiar nele.');
INSERT INTO "item_descriptions" VALUES(15187,'pt','Bastante encrenqueiro, este anel aprecia os hóspedes que sabem usar bem os punhos e não perde a ocasião de zombar daqueles que não sabem.');
INSERT INTO "item_descriptions" VALUES(15188,'pt','Para usar estes chinelos é preciso ter uma higiene dos pés impecável. Caso contrário, eles te farão pagar por isso.');
INSERT INTO "item_descriptions" VALUES(15189,'pt','Este amuleto serve para controlar a pureza da alma do seu portador: as duas bolas sobem cada vez que você tem um pensamento maldoso, até estrangulá-lo. Em geral, é só uma questão de tempo.');
INSERT INTO "item_descriptions" VALUES(15190,'pt','Cada uma das bolas do Pelutrof tem um significado muito importante, e é por isso que as encontramos também neste bracelete. Mas não importa, pois você só quer saber se elas combinam com a cor dos seus olhos.');
INSERT INTO "item_descriptions" VALUES(15191,'pt','Estas pantufas são pesadas demais para serem levantadas com frequência. Sendo assim, é preciso arrastar os pés para andar. É uma técnica tão boa quanto qualquer outra para limpar o chão de Enutropia.');
INSERT INTO "item_descriptions" VALUES(15192,'pt','Com os cabelos ao vento, você adotará o estilo incomparável de um Levitrof ao usar este chapéu. Isso pode não parecer um elogio, mas é uma vantagem importante na hora de se aproximar de certos tipos de pessoas. Como os Enuforts, por exemplo.');
INSERT INTO "item_descriptions" VALUES(15193,'pt','Os Levitrofs usam essa aliança a partir de uma certa idade, quando se dão conta de que jamais terão a oportunidade de usar uma verdadeira.');
INSERT INTO "item_descriptions" VALUES(15194,'pt','Como o nome indica, os Levitrofs levitam. Sendo assim, estas botas são totalmente inúteis.');
INSERT INTO "item_descriptions" VALUES(15195,'pt','Como os Kamasteriskos não são bobos nem nada, eles sabem que podem precisar de uma pá a qualquer momento. Por isso, eles inventaram esta pá portátil com cabo retrátil para não terem que transportar as suas o tempo todo.');
INSERT INTO "item_descriptions" VALUES(15196,'pt','Não há nada melhor do que botas de ouro maciço para passar despercebido, não é mesmo?');
INSERT INTO "item_descriptions" VALUES(15197,'pt','Parece que os Kamasteriskos usam seus cabelos para formar a barba e esconder sua feminilidade. Com esta capa, você poderá comprovar esta teoria.');
INSERT INTO "item_descriptions" VALUES(15198,'pt','Estas botas respiram! Sendo assim, tome cuidado ao andar: é normal que alguns pequenos objetos sejam aspirados por elas. Além disso, às vezes elas espirram, o que costuma acontecer no pior momento possível, fazendo com que você perca o equilíbrio.');
INSERT INTO "item_descriptions" VALUES(15199,'pt','Dado o seu valor em ouro, este cinto é raramente utilizado para outras funções além da original. Isso sem mencionar o seu peso, que o torna difícil de ser usado como arma.');
INSERT INTO "item_descriptions" VALUES(15200,'pt','Esta capa de pele é muito apreciada pela burguesia. Ela dá um aspecto bestial para Kanígrula nenhuma botar defeito. E o melhor: ela ainda serve para proteger do frio.');
INSERT INTO "item_descriptions" VALUES(15201,'pt','A julgar pela aparência dele, poderíamos pensar que este cinto veio diretamente da Shukrute. Afinal, quem sabe até onde os Papatrozes foram capazes de cavar?');
INSERT INTO "item_descriptions" VALUES(15202,'pt','Esta capa lhe dará um aspecto horripilante! Mas, ao invés de se assustarem, é mais provável que seus adversários o ataquem pelas costas, principalmente se forem chifrudos.');
INSERT INTO "item_descriptions" VALUES(15203,'pt','Ainda que não seja de muito bom gosto, ninguém mais poderá acusá-lo de não ter um bom faro, mas procure não meter este amuleto onde não é chamado.');
INSERT INTO "item_descriptions" VALUES(15207,'pt','Se você usar esta capa, sentirá uma vontade incontrolável de dizer tudo o que passar pela sua cabeça. Vai combinar muito bem com a sua língua solta.');
INSERT INTO "item_descriptions" VALUES(15208,'pt','O criador deste cinto, cansado de perder a chave, decidiu encantá-lo de maneira que ele possa ser aberto com qualquer chave. Isso o torna muito menos interessante, mas nem todo mundo sabe disso!');
INSERT INTO "item_descriptions" VALUES(15210,'pt','Estas botas agem como um cofre e protegerão essas suas panturrilhas flácidas em todas as circunstâncias.');
INSERT INTO "item_descriptions" VALUES(15212,'pt','Este capacete deu origem a muitas piadinhas de mau gosto. Ao usá-lo, não se espante se ouvir coisas do tipo: "Se você me apresentar à sua mulher, vai descobrir de onde vieram os seus chifres!". Basta ignorá-los.');
INSERT INTO "item_descriptions" VALUES(15213,'pt','A mensagem é clara: o que se esconde por trás deste cinto está muito bem guardado.');
INSERT INTO "item_descriptions" VALUES(15215,'pt','Símbolo de virilidade, estas botas costumam ser usadas principalmente por pessoas que têm algo a compensar.');
INSERT INTO "item_descriptions" VALUES(15216,'pt','O Malefisko sempre sonhou em ser maestro. Até hoje ele se tranca no banheiro e usa esta varinha para fazer de conta que está conduzindo uma orquestra na frente do espelho.');
INSERT INTO "item_descriptions" VALUES(15217,'pt','O martelo do Perfuror é um verdadeiro paradoxo: concebido pelos Enutrofs para cunhar kamas, na verdade ele faz com que desapareçam. Sendo assim, seu uso foi proibido em Enutropia, onde perder um kama, ainda que seja só unzinho, é considerado sacrilégio.');
INSERT INTO "item_descriptions" VALUES(15218,'pt','Esta pá foi feita para cavar, é claro. Mas não em qualquer lugar: apenas nas infinitas montanhas de kamas de Enutropia.');
INSERT INTO "item_descriptions" VALUES(15235,'pt','Ovo de dragão ou de truz? Talvez um pouco dos dois... Afinal, já existe um Dragão-Porco, por que não um Dragão-Truz? Ha ha ha.');
INSERT INTO "item_descriptions" VALUES(15240,'pt','Estes chinelos deixam a marca do Kama na areia da praia. Não se espante se começar a ser seguido por uma horda de aventureiros caçadores de tesouros.');
INSERT INTO "item_descriptions" VALUES(15241,'pt','Este cinto pode ajudá-lo a fazer amigos. Amigos que provavelmente desaparecerão quando descobrirem que na verdade você não tem nem onde cair morto.');
INSERT INTO "item_descriptions" VALUES(1015243,'pt','O Perforror é uma montascote adaptada a todos os tipos de terreno: ele pode transportá-lo para qualquer lugar e resiste a qualquer clima. No entanto, ele não parará se você cair, então é melhor se segurar bem.');
INSERT INTO "item_descriptions" VALUES(15249,'pt','Esta mascote funciona como um detector de kamas. Alguns estabelecimentos exigem que os clientes se deixem snuflar antes de entrar, para se certificarem de que eles têm dinheiro para gastar. Mas ela também pode entregar você: se um mendigo lhe pedir dinheiro, procure ser honesto pelo menos uma vez na vida!');
INSERT INTO "item_descriptions" VALUES(15254,'pt','O Perfofo tem um talento nato para encontrar seu caminho, principalmente em Enutropia, onde o que não falta são cheiros conhecidos. Logo, ele lhe será muito útil quando quiser vagabundear entre os montes de ouro do deus Enutrof.');
INSERT INTO "item_descriptions" VALUES(15282,'pt','Segundo Qiu, o lançador de pepitas deve ser capaz de aguçar os reflexos dos Perfuratrozes. Será que o major está pensando em transformar esses animais em terríveis monstros de guerra? Isso nem passou pela sua cabeça.');
INSERT INTO "item_descriptions" VALUES(15356,'pt','Este chapéu pode torná-lo invisível se você enfiar a cabeça no chão.');
INSERT INTO "item_descriptions" VALUES(15357,'pt','Este é o objeto ideal para atrair a atenção dos seus interlocutores para a sua cintura. Tendo dito isso, não se espante se eles demonstrarem más intenções.');
INSERT INTO "item_descriptions" VALUES(15358,'pt','Este anel serve para lembrá-lo de que algumas perguntas constrangedoras não devem ter resposta.');
INSERT INTO "item_descriptions" VALUES(15359,'pt','Esta capa feita de penas de Guindastruz costuma aumentar de volume com a umidade, podendo se tornar tão volumosa a ponto de impedir que você se locomova. Sendo assim, evite usá-la para se secar.');
INSERT INTO "item_descriptions" VALUES(15360,'pt','Estas botam emitem os mesmos ruídos que os Truzes durante o período de acasalamento. Sendo assim, não se espante se acabar levando uma cabeçada bem dada de um Guindastruz quando usá-las.');
INSERT INTO "item_descriptions" VALUES(15361,'pt','Com este amuleto ao redor do pescoço, só lhe faltarão as penas para que seja confundido com um Guindastruz!');
INSERT INTO "item_descriptions" VALUES(15422,'pt','Nem adianta tentar usar este item para fazer faxina, ele não foi fabricado para ser usado de maneira tão trivial.');
INSERT INTO "item_descriptions" VALUES(15428,'pt','Eis aqui as botas do criminoso por excelência. Elas são suficientemente silenciosas para que seu dono possa se locomover sorrateiramente e suficientemente confortáveis para que ele possa comemorar suas maldades com alguns passos de dança improvisados.');
INSERT INTO "item_descriptions" VALUES(15429,'pt','Este cinto simples é, antes de mais nada, um símbolo de que seu proprietário pertence à nobreza de Sramvil. A maneira como você o conseguiu não importa.');
INSERT INTO "item_descriptions" VALUES(15430,'pt','Esta capa é ligeiramente fluorescente, o que permite detectar seu portador no escuro. Além disso, ela é tão leve que é possível usá-la sem se dar conta. Estas duas particularidades a tornam muito interessante aos olhos de alguns malfeitores de Sramvil, que, inspirados pelo Pesk de Aperirel, a colocam discretamente nas costas de seus alvos em potencial.');
INSERT INTO "item_descriptions" VALUES(15431,'pt','Muita gente se pergunta como é que o Gein consegue ver alguma coisa se seu chapéu cobre totalmente seus olhos. De qualquer maneira, ninguém nunca teve tempo de fazer a pergunta ao se encontrar face a face com ele.');
INSERT INTO "item_descriptions" VALUES(15432,'pt','Na verdade, o Gein usa este cinto como calça, mas pode ser que fique meio apertado em você.');
INSERT INTO "item_descriptions" VALUES(15433,'pt','O Gein gosta de apostar, e seu amuleto é uma arma em potencial contra si mesmo: para imobilizá-lo, basta puxar a corrente. É claro que, se ele se expõe a esse tipo de risco, é porque todos aqueles que tentaram se aproximar muito dele acabaram se arrependendo amargamente.');
INSERT INTO "item_descriptions" VALUES(15434,'pt','A Rainha dos Ladrões uma vez lançou um desafio aos seus partidários: eles teriam que roubar uma das faixas de tecido do seu cinto. Como ninguém teve coragem de se aproximar, ela acabou abandonando a ideia. No entanto, desde então, a Corte Tenebrosa pratica uma atividade bastante peculiar: eles prendem um lenço em seu cinto, deixando um pedaço à mostra para que os outros participantes tentem pegá-lo.');
INSERT INTO "item_descriptions" VALUES(15435,'pt','Como todo criminoso que se preze, a Rainha dos Ladrões também possui botas dignas da sua pofissão: práticas e, principalmente, silenciosas. A diferença é que as dela são muito mais estilosas.');
INSERT INTO "item_descriptions" VALUES(15436,'pt','Este chapéu é particularmente interessante para quem tem pouco cabelo: nos dias de ventania, eles terão a impressão de que seus cabelos acompanham o movimento.');
INSERT INTO "item_descriptions" VALUES(15437,'pt','Os Malevigiantes às vezes precisam ir a alguns cantos pouco praticáveis de Sramvil, por isso desenvolveram estas botas ligeiramente elevadas. Com elas, eles estão preparados para qualquer situação, desde que não saiam da cidade.');
INSERT INTO "item_descriptions" VALUES(15438,'pt','Dizem que os Malevigiantes herdaram sua aparência dos Mestres Boletos. Seja como for, a semelhança é impressionante.');
INSERT INTO "item_descriptions" VALUES(15439,'pt','"Descosida" é apenas um leve eufemismo para descrever esta capa.');
INSERT INTO "item_descriptions" VALUES(15440,'pt','Este anel é a única arma oficialmente autorizada durante os combates de Ketch. Ele certamente deixa belas marcas em forma de estrela no corpo do adversário.');
INSERT INTO "item_descriptions" VALUES(15441,'pt','A principal característica destas botas é que elas fazer muito barulho. Isto as torna um elemento indispensável à luta de Ketch, pois garante aos competidores uma entrada espetacular.');
INSERT INTO "item_descriptions" VALUES(15442,'pt','Esta máscara é igual à do Capitão Skarlat. Na verdade, ninguém sabe ao certo se ele realmente usa uma máscara, embora seja a hipótese mais provável, dada a sua total falta de expressões faciais.');
INSERT INTO "item_descriptions" VALUES(15469,'pt','Há gerações, todos os membros da família Homlett trabalham como criados de um poderoso necromante. Eles são tão dedicados que continuam servindo a seu mestre mesmo após a morte, sob a forma de crânios falantes. Mortos ou vivos, eles nunca deixam de respeitar seu compromisso. Ser ou não ser: eis a questão que nem passa pela cabeça dos Homletts.');
INSERT INTO "item_descriptions" VALUES(15493,'pt','Reza a lenda que o próprio Sram teria encomendado estas adagas, do mesmo modelo que as suas, para distribuí-las entre seus discípulos. Essas cópias fizeram tanto sucesso que os habitantes de Sramvil começaram a contrabandeá-las sem nem mesmo tentar convencer os clientes de que se tratam de peças autênticas.');
INSERT INTO "item_descriptions" VALUES(15494,'pt','Esta pá serve para enterrar objetos, mortos ou vivos.');
INSERT INTO "item_descriptions" VALUES(15495,'pt','Este arco é capaz de infligir danos sem que seus alvos percebam. Apesar de não poderem sentir as flechas, seus adversários dificilmente conseguirão sair dessa.');
INSERT INTO "item_descriptions" VALUES(15496,'pt','Esta espada, apesar de imponente, é bastante maneável, tanto que a Rainha dos Ladrões a carrega sempre consigo. Alguns dizem até que ela é a principal confidente e melhor amiga da monarca.');
INSERT INTO "item_descriptions" VALUES(15499,'pt','Só deve ser usado em caso de emergência. Esta joia contém um veneno muito poderoso, capaz de estragar a sua vida ou de salvá-la, dependendo da situação.');
INSERT INTO "item_descriptions" VALUES(15500,'pt','Proibidas fora de Sramvil por um lobby de Sadidas, estas botas costumam fazer com que a vegetação apodreça ao entrar em contato com ela. São muito eficazes para erradicar as ervas daninhas, apesar dos efeitos colaterais.');
INSERT INTO "item_descriptions" VALUES(15501,'pt','Os Entomortis identificam seus aliados principalmente graças ao seu odor, e esta capa está impregnada. O único problema é que este odor está diretamente relacionado aos venenos que secretam, então pode acabar sendo bastante nocivo.');
INSERT INTO "item_descriptions" VALUES(15502,'pt','Estas botas não ajudarão em nada o seu problema de micose.');
INSERT INTO "item_descriptions" VALUES(15503,'pt','Todos os especialistas afirmam que o Dermoan é realmente comestível, mas ninguém nunca se atreveu a prová-lo, já que a sua cor leva a crer que ele pode ser radioativo.');
INSERT INTO "item_descriptions" VALUES(15504,'pt','Com esta capa, você poderá mostrar com orgulho que venceu a pior ameaça da Floresta Petrificada. Mas cuidado para não deixá-la muito tempo sobre os ombros, pois ninguém sabe exatamente do que o Dermoan é feito, e isso poderá lhe custar caro.');
INSERT INTO "item_descriptions" VALUES(15505,'pt','Com esta rede, você poderá capturar um Entomortis enfraquecido.');
INSERT INTO "item_descriptions" VALUES(15506,'pt','Você poderia até pensar que este cinto servia para manter o Capitão Scarlat no lugar, mas, assim como ele, o cinto costuma deslizar pela sua cintura.');
INSERT INTO "item_descriptions" VALUES(15507,'pt','Prepare-se para escorregar sem parar: estas botas não aderem bem ao solo, garantindo assim um efeito espetacular. É assim que o capitão Skarlat consegue escapar de situações perigosas.');
INSERT INTO "item_descriptions" VALUES(15508,'pt','Estas luvas dão um ar inquietante a quem as usa: não se espante se as pessoas começarem a evitá-lo, mas também não se acostume com isso.');
INSERT INTO "item_descriptions" VALUES(15514,'pt','Com este capacete na cabeça, você se transformará no terror dos pântanos. Além do mais, a fumaça que sai da sua cabeça durante seus momentos de intensa reflexão passará a sair pelo seu nariz, lhe dando uma aparência ainda mais ameaçadora.');
INSERT INTO "item_descriptions" VALUES(15518,'pt','Procurado em toda Amakna, o Ali Grothor guarda este amuleto para se lembrar do que pode acontecer com ele caso não ponha um fim ao seu exílio nas turfeiras da ilha de Otomai.');
INSERT INTO "item_descriptions" VALUES(15523,'pt','O Ali Grothor nunca foi muito limpo, e esta capa não é diferente. Parece até que ele a usava como toalha ou lenço para retirar as sujeiras mais evidentes.');
INSERT INTO "item_descriptions" VALUES(15524,'pt','Ao examinar esta máscara, podemos entender melhor a reputação da Kebra: ela possui um forro especial que torna as suas cabeçadas ainda mais letais.');
INSERT INTO "item_descriptions" VALUES(15525,'pt','A Kebra é uma grande colecionadora de sapatos, mas não gosta muito de mudar de estilo. Sendo assim, esta é o único modelo da sua extraordinária coleção. Ela possui 1337 exemplares.');
INSERT INTO "item_descriptions" VALUES(15526,'pt','Como ela costuma sujar as mãos com frequência, a Kebra não se separa nunca de suas luvas.');
INSERT INTO "item_descriptions" VALUES(15548,'pt','Usar um cinto com as cores da seleção não é pra qualquer um. Talvez seja essa a linha tênue entre um torcedor e uma líder de torcida.');
INSERT INTO "item_descriptions" VALUES(15549,'pt','Este discreto amuleto é destinado principalmente aos torcedores tímidos ou pouco confiantes em relação ao seu time do coração: o acessório pode ser facilmente escondido caso seus papabolistas favoritos façam besteira em campo.');
INSERT INTO "item_descriptions" VALUES(15607,'pt','Ao menor sinal de perigo, esta mascote se enrola, adquirindo o formato de uma bola. Dependendo da inclinação do solo, ela rolará em uma determinada direção e poderá servir para distrair seus adversários.');
INSERT INTO "item_descriptions" VALUES(15660,'pt','Estas facas Mini Nuit não foram feitas para o combate.');
INSERT INTO "item_descriptions" VALUES(15692,'pt','A boca dessas botas pode se abrir, mas seu hálito não é nada agradável.');
INSERT INTO "item_descriptions" VALUES(15693,'pt','Estes sapatos costumam ser usados para caminhar em terrenos com neve ou gelo: eles têm uma ótima aderência e não afundam na neve.');
INSERT INTO "item_descriptions" VALUES(15694,'pt','Depois de ter passado tanto tempo na cabeça dos aventureiros, o Kidibom agora pode ser usado sobre ela.');
INSERT INTO "item_descriptions" VALUES(15695,'pt','Com uma aparência de outro mundo e tão laranja a ponto de deixar uma Abóbowa com inveja, esta máscara faria muito sucesso durante o Relouin.');
INSERT INTO "item_descriptions" VALUES(15696,'pt','Com esta capa nas costas, você se sentirá como um peixe na água. A única diferença é que você será muito menos ágil, devido ao grande peso deste item.');
INSERT INTO "item_descriptions" VALUES(15697,'pt','É melhor se certificar de que seu organismo é resistente antes de usar esta capa feita de pedaços de króbios. Senão, você acabará descobrindo como se sente um hipocondríaco.');
INSERT INTO "item_descriptions" VALUES(15698,'pt','Pow Uatisson leva este anel consigo para nunca se esquecer de que mesmo os animais menos imponentes têm sua importância. E também porque era mais complicado fazer um anel de peixe.');
INSERT INTO "item_descriptions" VALUES(15699,'pt','O cintáceo é mais adaptado aos tipos físicos mais corpulentos. Ao contrário dos outros cintos, no entanto, este aqui se infla para apertar seu portator, dando uma ilusão de volume. Pelos mesmos motivos, ele também pode ser usado como boia.');
INSERT INTO "item_descriptions" VALUES(15700,'pt','Esta tanga translúcida é muito apreciada pelos exibicionistas: apesar de não estarem completamente nus, ela não esconde nada.');
INSERT INTO "item_descriptions" VALUES(15701,'pt','O capitão do Chafer Marítimo sempre carrega este amuleto, símbolo da sua embarcação. Parece que, com ele, é possível se comunicar com os poderosos animais marinhos, mas eles não têm muito a dizer.');
INSERT INTO "item_descriptions" VALUES(15737,'pt','Dizem que este amuleto permite que seu portador gire a cabeça 360º, com um pouco de treinamento. Até agora, parece que os únicos que realmente conseguiram realizar este feito não estão mais entre nós, o que deixa uma dúvida no ar.');
INSERT INTO "item_descriptions" VALUES(15738,'pt','Segundo a lenda, este chapéu é a melhor proteção contra a insolação, mas parece que só funciona à noite. Durante o dia, ele fica completamente transparente, e ninguém ainda conseguiu compreender o motivo.');
INSERT INTO "item_descriptions" VALUES(15739,'pt','A Caporuja é o acessório essencial à todas as corujas que desejarem estar na huuu-última moda.');
INSERT INTO "item_descriptions" VALUES(15740,'pt','Este anel é capaz de arrancar um pedaço do seu dedo sem que você se dê conta. Alguns o usam indevidamente para manter as unhas sempre bem aparadas.');
INSERT INTO "item_descriptions" VALUES(15741,'pt','Estas botas não farão com que se sinta mais leve, muito menos quando você se der conta de que elas são incapazes de fazê-lo voar.');
INSERT INTO "item_descriptions" VALUES(15742,'pt','Este capacete, cuja semelhança com uma ave de rapina é bastante óbvia, só deve ser usado se você não tiver medo de revelar sua verdadeira natureza.');
INSERT INTO "item_descriptions" VALUES(15743,'pt','Há muito tempo o Vórtex não pode mais usar seu cinto. Pelo visto, um dia você também não poderá mais usá-lo da maneira convencional.');
INSERT INTO "item_descriptions" VALUES(15744,'pt','Estes pequenos tamancos permitem uma aterrissagem suave, mesmo para saltos de mais de 20 kametros de altura. Experimente!');
INSERT INTO "item_descriptions" VALUES(15745,'pt','Esta é a melhor maneira de se parecer com o Vórtex sem ser o Vórtex. Agora só falta deixar a barriga crescer um pouco mais para que comecem a pensar que vocês dois são gêmeos.');
INSERT INTO "item_descriptions" VALUES(15746,'pt','Este pingente prevê o futuro e é capaz de antecipar qualquer ação. É uma pena que os pingentes não possam se comunicar.');
INSERT INTO "item_descriptions" VALUES(15747,'pt','Dizem que as asas dos Perdidos surgiram depois que eles ingurgitaram enormes quantidades da poção Redy Buh. Esta capa simula em parte os efeitos dessa poção, mas pode ser que não lhe faça muito bem.');
INSERT INTO "item_descriptions" VALUES(15748,'pt','Com estes sapatos, você poderá fazer suas viagens temporais tranquilamente, sem medo de ser eletrocutado.');
INSERT INTO "item_descriptions" VALUES(15749,'pt','Se uma pessoa olhar atentamente para este pingente durante 42 horas seguidas, ela ficará totalmente sob o seu controle.');
INSERT INTO "item_descriptions" VALUES(15750,'pt','Se você estava pensando em usar este anel no dedo, fique sabendo que se trata de um cinto!');
INSERT INTO "item_descriptions" VALUES(15751,'pt','Owesli é mais um mago que talvez entre para a história. Mas, antes de mais nada, ele é a pessoa que emprestou seu nome a estas botas, para criar um trocadilho à altura de seu talento.');
INSERT INTO "item_descriptions" VALUES(15762,'pt','Com estas botas, você poderá chutar o traseiro dos seus inimigos 42 vezes mais rápido que o normal.');
INSERT INTO "item_descriptions" VALUES(15764,'pt','Equipado com chifres de demônio bastante pontudos, este cinto pode ser usado para repelir as tentativas de aventureiros presunçosos demais com um simples movimento de quadril.');
INSERT INTO "item_descriptions" VALUES(15768,'pt','Se alguém perguntar a você qual é a resposta à grande questão da vida, do universo e tudo mais, um tapa bem dado com este anel no dedo deve ser suficiente.');
INSERT INTO "item_descriptions" VALUES(15771,'pt','Este cinto é capaz de aumentar o seu lado viril, ou o seu lado ridículo, dependendo do ponto de vista.');
INSERT INTO "item_descriptions" VALUES(15773,'pt','Este chapéu de origens demoníacas e poderes assombrosos lhe dará a aparência de integrante de uma banda para adolescentes. Pois é, nem tudo é perfeito.');
INSERT INTO "item_descriptions" VALUES(15776,'pt','Não há nada melhor que um bom par de botas forradas de tufos de cabelos de demônio para manter os pés aquecidos em qualquer circunstância!');
INSERT INTO "item_descriptions" VALUES(15778,'pt','"Nananananana Fraktaaaaal!" Não há dúvidas: ao usar este chapéu, você terá motivos de sobra para achar que é um super-herói.');
INSERT INTO "item_descriptions" VALUES(15779,'pt','Se você levantar esta varinha durante uma tempestade, poderá viajar no tempo. Até o momento, todos os que tentaram fazer isso realmente desapareceram, então deve funcionar mesmo.');
INSERT INTO "item_descriptions" VALUES(15780,'pt','Este cinto possui propriedades impressionantes, como a capacidade de reproduzir seu motivo infinitamente, o que é muito prático na hora de hipnotizar os inimigos.');
INSERT INTO "item_descriptions" VALUES(15781,'pt','Paradoxalmente, este martelo funciona melhor se usado do lado pontudo.');
INSERT INTO "item_descriptions" VALUES(15782,'pt','Se você achava que as penas não eram capazes de cortar, este machado vai fazê-lo mudar de ideia rapidinho.');
INSERT INTO "item_descriptions" VALUES(15783,'pt','De natureza bastante frágil, este anel lhe dará um poder enorme. Cuidado para não quebrá-lo em pedaços.');
INSERT INTO "item_descriptions" VALUES(15784,'pt','Este anel mostrará ao mundo que é você quem deve ser temido (ou quase).');
INSERT INTO "item_descriptions" VALUES(15789,'pt','Não há nada mais assustador que um Xelomorfo te encarando com seus olhos brilhantes... Imagine só o medo que seus inimigos sentirão ao vê-lo com estas botas!');
INSERT INTO "item_descriptions" VALUES(15791,'pt','A aparência desta capa quase transparente se adapta à de seu portador para lhe dar um ar ainda mais impressionante.');
INSERT INTO "item_descriptions" VALUES(15794,'pt','Ninguém sabe se é por causa da sua aparência, mas todo mundo que usa esse chapéu sente uma vontade irresistível de comer nozes.');
INSERT INTO "item_descriptions" VALUES(15795,'pt','Ideal para um passeio no campo, este par de botas fará de você um verdadeiro amigo dos animais.');
INSERT INTO "item_descriptions" VALUES(15796,'pt','Este amuleto, confeccionado a partir de uma cauda de Nozoiado, é tão macio que você não vai conseguir parar de esfregá-lo no seu corpo.');
INSERT INTO "item_descriptions" VALUES(15860,'pt','Não há nada melhor que um pouco de energia para combater o desânimo.');
INSERT INTO "item_descriptions" VALUES(15886,'pt','O convector temporal incrustado na cabeça deste martelo é uma invenção do Doc Temme Braun. Agora só resta descobrir para que ele serve.');
INSERT INTO "item_descriptions" VALUES(15978,'pt','"Você não passará!" 
Essa é a frase preferida desta mascote. No entanto, não espere que ela se coloque entre você e a morte certa, pois ela não tem nem coragem e nem físico para isso.');
INSERT INTO "item_descriptions" VALUES(15990,'pt','Você é daquele tipo que se encolhe em uma discussão? Tem ilusões de grandeza? A Varinha Miúda é perfeita para você. Use-a para entrar em áreas inacessíveis... e, em breve, nenhuma toca de rato será desconhecida para você.');
INSERT INTO "item_descriptions" VALUES(15992,'pt','Se, ao limpar este anel, você perceber uma poeira dourada saindo dele, pense em algo bom; talvez você consiga voar, como em um passe de mágica...');
INSERT INTO "item_descriptions" VALUES(15993,'pt','Você gosta de brincar com fósforos? É fã de arte contemporânea? Então esta capa foi feita para você! Mas tenha cuidado para não esfregá-la em superfícies ásperas, senão pode acabar ficando com fogo no rabo.');
INSERT INTO "item_descriptions" VALUES(15994,'pt','Alguém já disse que sua cabeça é dura como uma casca de noz? Bem, com este capacete, essa afirmação nunca foi tão verdadeira.');
INSERT INTO "item_descriptions" VALUES(15995,'pt','Usada como colar, esta pérola é uma linda joia. É uma maneira criativa de reaproveitar um brinco se você perdeu o outro.');
INSERT INTO "item_descriptions" VALUES(15996,'pt','Este pingente em forma de agulha dá o poder de curar até a mais séria das feridas... se você souber como usá-lo.');
INSERT INTO "item_descriptions" VALUES(15997,'pt','O líquido que flui neste cinto tem excelentes propriedades de cura e dá alívio instantâneo para aquela dor nas costas que sempre volta!');
INSERT INTO "item_descriptions" VALUES(15998,'pt','Sente-se tenso? Esfregue este anel na sua pele e sinta seus músculos relaxarem instantaneamente. O cheirinho refrescante de mentol também será um grande aprimoramento para seu odor habitual.');
INSERT INTO "item_descriptions" VALUES(15999,'pt','Panterrosa costumava esconder seu rosto atrás dessa máscara. E não apenas quando ela estava aprontando uma das suas! Sua beleza era tanta, que levaria até o mais resistente dos homens à loucura...');
INSERT INTO "item_descriptions" VALUES(16003,'pt','Pode parecer inofensivo, mas a ponta deste cinto pode ser usada como um temível chicote contra todos aqueles que estiverem em seu caminho.');
INSERT INTO "item_descriptions" VALUES(16004,'pt','Um acessório ideal para qualquer roubo! Nenhuma janela será obstáculo com este anel, que é afiado como diamante.');
INSERT INTO "item_descriptions" VALUES(16005,'pt','Usando este bracelete, você receberá informações instantâneas sobre as forças da pressão agindo sobre seu corpo. Agora, isso não parece ser muito útil se você não estiver nas profundezas do oceano... e de fato não é.');
INSERT INTO "item_descriptions" VALUES(16006,'pt','Produto dos mais avançados desenvolvimentos tecnológicos, estas sandálias à prova d''água manterão seus pés secos em qualquer circunstância.');
INSERT INTO "item_descriptions" VALUES(16007,'pt','Esta máscara ajuda você a enxergar claramente, mesmo nas áreas mais escuras, e fornecerá todo o oxigênio necessário para mergulho em profundidade.');
INSERT INTO "item_descriptions" VALUES(16061,'pt','Este Dofus foi criado com base nas vagas lembranças de alguém que um dia viu um autêntico ovo de dragão. Só de tocá-lo, suas lembranças voltam com força total... É como saborear um bolo do Zalencar depois de muitos anos. Você se lembra do dia em que chegou a Incarnam, da primeira vez que matou um Paparneiro... Ah, bons tempos!');
INSERT INTO "item_descriptions" VALUES(16116,'pt','O Eliotasma é um espírito tagarela e brincalhão, que se manifesta perto dos portais criados pelos Eliotropes. Dizem que ele é uma alma perdida que ainda não está pronta para reencarnar. Embora irritante, o Eliotasma não é mau de verdade... Ele só gosta de gritar nos ouvidos das pessoas com sua vozinha aguda.');
INSERT INTO "item_descriptions" VALUES(16122,'pt','Os Drakomparsas nascem nas águas de Sufokia, em uma imensa caverna submarina descoberta pelos Eliotropes. Esses minidragões carentes são companheiros muito fiéis. Quando um Drakomparsa adota você, é para a vida toda! Nas suas noitadas entre aventureiros, pode contar com ele para aquecer o ambiente ou dar uma descontraída no clima fazendo caretas.');
INSERT INTO "item_descriptions" VALUES(16140,'pt','É difícil compreender a utilidade desta máscara se você nunca usou o portal de um Eliotrope. E, mesmo que tenha usado, é bem complicado de entender para que ela serve... Pelo menos você pode usá-la para esconder o rosto, e isso é uma dádiva divina para alguém como você.');
INSERT INTO "item_descriptions" VALUES(16141,'pt','Assim como um tapete voador, esta capa levará você para ver o mundo! Seu poder secreto? Se você fizer carinho nela, surgirá um "Ortal", que você poderá tentar usar para viajar mais rápido. Não chega a ser um portal Eliotrope, mas dá para o gasto.');
INSERT INTO "item_descriptions" VALUES(16142,'pt','Com essas botas, você poderá ir do ponto A ao ponto B usando o poder dos seus pés. Não é incrível?! É tão impressionante que você não poderá revelar este segredo a ninguém. É sério! Está ouvindo?!');
INSERT INTO "item_descriptions" VALUES(16143,'pt','Se você girar em círculos enquanto estiver usando esse cinto, presenciará um acontecimento inacreditável. Mas ninguém até hoje sobreviveu a esse acontecimento... então não temos como saber o que de fato acontece. Bem, só há uma maneira de descobrir!');
INSERT INTO "item_descriptions" VALUES(16144,'pt','Tão brilhante quanto o sol e potente como uma supernova, este anel aumentará seus poderes de Eliotrope de forma espantosa. Você não é um Eliotrope? Então coloque-o no criado mudo para servir de abajur. Viu como este anel é poderoso?');
INSERT INTO "item_descriptions" VALUES(16169,'pt','Um escultor começou a esculpir arcos usando galhos mortos encontrados na Floresta Sombria. Infelizmente, eles eram moles demais e se mostraram inutilizáveis pelas autoridades. Então, o escultor tentou a sorte com cassetetes feitos de galhos de Carvalho Mole. Surpreendentemente rígidos como pregos, eles foram imediatamente adotados por instrutores brakmarianos, que os usam até hoje para acertar a cabeça dos Chaferes rebeldes.');
INSERT INTO "item_descriptions" VALUES(16171,'pt','Uma capa desenvolvida especialmente para aqueles que preferem esconder sua capa? É cada uma que aparece... Ou melhor, não aparece, no caso.');
INSERT INTO "item_descriptions" VALUES(16172,'pt','Um meio muito prático de cobrir a cabeça e garantir que todos vejam seus incríveis folículos capilares, ou a falta deles. Como você deve ter percebido, este chapéu é para exibicionistas e aventureiros desinibidos.');
INSERT INTO "item_descriptions" VALUES(16173,'pt','Sua sogra sofre de araknofobia? Parabéns, você acaba de encontrar o presente ideal para o próximo aniversário dela... Com um pouco de sorte, será o último.');
INSERT INTO "item_descriptions" VALUES(16174,'pt','Macias e suaves ao toque, essas botas são incrivelmente confortáveis. Mas se prepare para ficar descalço a pedido de quem detesta essas patinhas de inseto rastejando pelo chão.');
INSERT INTO "item_descriptions" VALUES(16175,'pt','Este chapéu foi um estouro no último desfile de moda organizado pela Associação de Viúvas-Negras de Brakmar.');
INSERT INTO "item_descriptions" VALUES(16176,'pt','Alguns afirmam que este talismã cura problemas de visão. Outros garantem que ele apenas os multiplica. A verdade, como costuma ser o caso, depende do seu ponto de vista.');
INSERT INTO "item_descriptions" VALUES(16177,'pt','Se você cruzar o caminho de Nevark, o caçador, vestindo esta capa, ele pode acabar confundindo você com o acólito do Arakneman e lhe dar uma surra. Mas a vida é sua, você é livre para fazer o que bem entender.');
INSERT INTO "item_descriptions" VALUES(16178,'pt','Este cinto assustador lhe dará um aspecto de psico-patas.');
INSERT INTO "item_descriptions" VALUES(16182,'pt','Mesmo se os seus inimigos não passarem mal, daqui eles não passam.');
INSERT INTO "item_descriptions" VALUES(16183,'pt','Mesmo se os seus inimigos não passarem mal, daqui eles não passam.');
INSERT INTO "item_descriptions" VALUES(16184,'pt','Mesmo se os seus inimigos não passarem mal, daqui eles não passam.');
INSERT INTO "item_descriptions" VALUES(16185,'pt','Este troféu não terá nenhuma utilidade durante a sua travessia do deserto.');
INSERT INTO "item_descriptions" VALUES(16186,'pt','Este troféu não terá nenhuma utilidade durante a sua travessia do deserto.');
INSERT INTO "item_descriptions" VALUES(16187,'pt','Este troféu não terá nenhuma utilidade durante a sua travessia do deserto.');
INSERT INTO "item_descriptions" VALUES(16188,'pt','Este troféu o ajudará a curar seus aliados ao distribuir bons conselhos: "um grande copo d''água cura qualquer mágoa, um grande prato de fritura cura qualquer fratura".');
INSERT INTO "item_descriptions" VALUES(16189,'pt','Este troféu o ajudará a curar seus aliados ao distribuir bons conselhos: "um grande copo d''água cura qualquer mágoa, um grande prato de fritura cura qualquer fratura".');
INSERT INTO "item_descriptions" VALUES(16190,'pt','Este troféu o ajudará a curar seus aliados ao distribuir bons conselhos: "um grande copo d''água cura qualquer mágoa, um grande prato de fritura cura qualquer fratura".');
INSERT INTO "item_descriptions" VALUES(16191,'pt','É melhor ser miraculado do que encurralado.');
INSERT INTO "item_descriptions" VALUES(16192,'pt','É melhor ser miraculado do que encurralado.');
INSERT INTO "item_descriptions" VALUES(16193,'pt','É melhor ser miraculado do que encurralado.');
INSERT INTO "item_descriptions" VALUES(16194,'pt','Ao ser derrotado e cair de cara no chão, a saliva em seus lábios permite simular um rastro de Krakol.');
INSERT INTO "item_descriptions" VALUES(16195,'pt','Ao ser derrotado e cair de cara no chão, a saliva em seus lábios permite simular um rastro de Krakol.');
INSERT INTO "item_descriptions" VALUES(16196,'pt','Ao ser derrotado e cair de cara no chão, a saliva em seus lábios permite simular um rastro de Krakol.');
INSERT INTO "item_descriptions" VALUES(16202,'pt','Alie-se aos Bworks para se tornar o intelectual do grupo.');
INSERT INTO "item_descriptions" VALUES(16203,'pt','Alie-se aos Bworks para se tornar o intelectual do grupo.');
INSERT INTO "item_descriptions" VALUES(16204,'pt','Alie-se aos Bworks para se tornar o intelectual do grupo.');
INSERT INTO "item_descriptions" VALUES(16209,'pt','Originalmente, usar a aliança dos Florestais simbolizava o compromisso com um estilo de vida: dormir sob o céu estrelado, subir em árvores, comer cogumelos, rolar pelo feno, etc. Hoje em dia, porém, alguns usam o anel por motivos puramente estéticos, desvalorizando o seu significado. Apesar disso, ele ainda representa um desejo de retorno à natureza.');
INSERT INTO "item_descriptions" VALUES(16239,'pt','Estas botas foram especialmente concebidas para deixar seu portador mais leve. Assim, desde que começaram a ser comercializadas, a taxa de mortalidade por pisoteamento dos jovens brotos vem diminuindo drasticamente.');
INSERT INTO "item_descriptions" VALUES(16240,'pt','O significado deste anel muda de acordo com o dedo no qual você o usa. Por exemplo, quando o coloca no dedo médio, quer dizer que você está desabrochando.');
INSERT INTO "item_descriptions" VALUES(16243,'pt','Aquela escorregada na casca de banana era só uma acrobacia para fazer seus amigos rirem. Ninguém acreditou, mas todo mundo achou engraçado.');
INSERT INTO "item_descriptions" VALUES(16244,'pt','Aquela escorregada na casca de banana era só uma acrobacia para fazer seus amigos rirem. Ninguém acreditou, mas todo mundo achou engraçado.');
INSERT INTO "item_descriptions" VALUES(16245,'pt','Aquela escorregada na casca de banana era só uma acrobacia para fazer seus amigos rirem. Ninguém acreditou, mas todo mundo achou engraçado.');
INSERT INTO "item_descriptions" VALUES(16246,'pt','Você tinha 99% de chances de ter um copo meio vazio, mas lhe serviram um copo meio cheio. Que sorte!');
INSERT INTO "item_descriptions" VALUES(16247,'pt','Você tinha 99% de chances de ter um copo meio vazio, mas lhe serviram um copo meio cheio. Que sorte!');
INSERT INTO "item_descriptions" VALUES(16248,'pt','Você tinha 99% de chances de ter um copo meio vazio, mas lhe serviram um copo meio cheio. Que sorte!');
INSERT INTO "item_descriptions" VALUES(16249,'pt','Aquele valentão do parquinho que destruiu seu castelo de areia o deixou traumatizado. Chegou a hora da vingança.');
INSERT INTO "item_descriptions" VALUES(16250,'pt','Aquele valentão do parquinho que destruiu seu castelo de areia o deixou traumatizado. Chegou a hora da vingança.');
INSERT INTO "item_descriptions" VALUES(16251,'pt','Aquele valentão do parquinho que destruiu seu castelo de areia o deixou traumatizado. Chegou a hora da vingança.');
INSERT INTO "item_descriptions" VALUES(16252,'pt','Monstros vão morder seu traseiro e você vai comer poeira. Pobres monstros.');
INSERT INTO "item_descriptions" VALUES(16253,'pt','Monstros vão morder seu traseiro e você vai comer poeira. Pobres monstros.');
INSERT INTO "item_descriptions" VALUES(16254,'pt','Monstros vão morder seu traseiro e você vai comer poeira. Pobres monstros.');
INSERT INTO "item_descriptions" VALUES(16255,'pt','Por onde o seu Dragoperu passa, a grama não volta a crescer.');
INSERT INTO "item_descriptions" VALUES(16256,'pt','Por onde o seu Dragoperu passa, a grama não volta a crescer.');
INSERT INTO "item_descriptions" VALUES(16257,'pt','Por onde o seu Dragoperu passa, a grama não volta a crescer.');
INSERT INTO "item_descriptions" VALUES(16258,'pt','Ao ser atacado, você revidará com qualquer coisa: maldições, insultos, piadas ruins e cascas de banana. Admita: você gosta mesmo de ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(16259,'pt','Ao ser atacado, você revidará com qualquer coisa: maldições, insultos, piadas ruins e cascas de banana. Admita: você gosta mesmo de ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(16260,'pt','Ao ser atacado, você revidará com qualquer coisa: maldições, insultos, piadas ruins e cascas de banana. Admita: você gosta mesmo de ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(16262,'pt','Você sempre quis viver de amor e água fresca, mas ficar sem banho quente no inverno seria muito difícil.');
INSERT INTO "item_descriptions" VALUES(16263,'pt','Você sempre quis viver de amor e água fresca, mas ficar sem banho quente no inverno seria muito difícil.');
INSERT INTO "item_descriptions" VALUES(16264,'pt','Você sempre quis viver de amor e água fresca, mas ficar sem banho quente no inverno seria muito difícil.');
INSERT INTO "item_descriptions" VALUES(16265,'pt','Acho que você está precisando de novos ares.');
INSERT INTO "item_descriptions" VALUES(16266,'pt','Acho que você está precisando de novos ares.');
INSERT INTO "item_descriptions" VALUES(16267,'pt','Acho que você está precisando de novos ares.');
INSERT INTO "item_descriptions" VALUES(16269,'pt','Os Tanuks levam décadas para atingir a puberdade, o período de suas vida em que eles adquirem independência e uma certa agressividade. Antes disso, eles são tão dóceis quanto Miaw empalhado, mas é impossível diferenciar os machos das fêmeas enquanto o tamanho de seus atributos não ultrapassa o do rabo. Os caçadores clandestinos que agem em Pandala são responsáveis pelo tráfico bastante lucrativo destas criaturas, e você aceitou fazer parte disso quando pegou este ou esta Tanuk.');
INSERT INTO "item_descriptions" VALUES(16274,'pt','Sua técnica pode não ser a mais rápida, mas você procura atrasar todo mundo só para não ser o mais lento. Esta é uma técnica testada e aprovada por todos os serviços administrativos do Mundo dos Doze.');
INSERT INTO "item_descriptions" VALUES(16275,'pt','Sua técnica pode não ser a mais rápida, mas você procura atrasar todo mundo só para não ser o mais lento. Esta é uma técnica testada e aprovada por todos os serviços administrativos do Mundo dos Doze.');
INSERT INTO "item_descriptions" VALUES(16276,'pt','Apesar de não ser tão bonitinho quanto um Konalak, você sente a necessidade de cuidar dele, de abraçá-lo, acariciá-lo e esfregar o rosto em seu pelo macio.');
INSERT INTO "item_descriptions" VALUES(16281,'pt','Sua técnica pode não ser a mais rápida, mas você procura atrasar todo mundo só para não ser o mais lento. Esta é uma técnica testada e aprovada por todos os serviços administrativos do Mundo dos Doze.');
INSERT INTO "item_descriptions" VALUES(16282,'pt','Bater a sua cabeça contra a do seu adversário a fim de atordoá-lo parecia ser uma tática interessante... Até você se dar conta de que ele tinha um capacete e você não.');
INSERT INTO "item_descriptions" VALUES(16283,'pt','Bater a sua cabeça contra a do seu adversário a fim de atordoá-lo parecia ser uma tática interessante... Até você se dar conta de que ele tinha um capacete e você não.');
INSERT INTO "item_descriptions" VALUES(16284,'pt','Bater a sua cabeça contra a do seu adversário a fim de atordoá-lo parecia ser uma tática interessante... Até você se dar conta de que ele tinha um capacete e você não.');
INSERT INTO "item_descriptions" VALUES(16292,'pt','Com a evasão fiscal, é possível se proteger dos impostos e taxas que permitiriam que os pobres roubassem dos ricos.');
INSERT INTO "item_descriptions" VALUES(16293,'pt','Com a evasão fiscal, é possível se proteger dos impostos e taxas que permitiriam que os pobres roubassem dos ricos.');
INSERT INTO "item_descriptions" VALUES(16294,'pt','Com a evasão fiscal, é possível se proteger dos impostos e taxas que permitiriam que os pobres roubassem dos ricos.');
INSERT INTO "item_descriptions" VALUES(16295,'pt','Fruto das experiências do doutor Noturcita, o Juba é o resultado de vários cruzamentos entre Miaws Angorás e Dentes-de-Leão Diabólicos. Sua personalidade travessa herdada geneticamente o tornou alvo de muitas ioperias.');
INSERT INTO "item_descriptions" VALUES(16300,'pt','Não há vergonha alguma em fugir... quando não há a menor chance de vencer.');
INSERT INTO "item_descriptions" VALUES(16301,'pt','Não há vergonha alguma em fugir... quando não há a menor chance de vencer.');
INSERT INTO "item_descriptions" VALUES(16302,'pt','Não há vergonha alguma em fugir... quando não há a menor chance de vencer.');
INSERT INTO "item_descriptions" VALUES(16303,'pt','Você ganhou o apelido de "Virador" por causa do seu hábito de virar a casaca mesmo quando não está vestindo uma casaca.');
INSERT INTO "item_descriptions" VALUES(16305,'pt','Você ganhou o apelido de "Virador" por causa do seu hábito de virar a casaca mesmo quando não está vestindo uma casaca.');
INSERT INTO "item_descriptions" VALUES(16306,'pt','Você ganhou o apelido de "Virador" por causa do seu hábito de virar a casaca mesmo quando não está vestindo uma casaca.');
INSERT INTO "item_descriptions" VALUES(16308,'pt','Sólido, mas não inquebrável. É com estas palavras que seus aliados descrevem você logo antes de quebrar seus dois dedões do pé por causa de uma piada de mau gosto.');
INSERT INTO "item_descriptions" VALUES(16309,'pt','Sólido, mas não inquebrável. É com estas palavras que seus aliados descrevem você logo antes de quebrar seus dois dedões do pé por causa de uma piada de mau gosto.');
INSERT INTO "item_descriptions" VALUES(16310,'pt','Sólido, mas não inquebrável. É com estas palavras que seus aliados descrevem você logo antes de quebrar seus dois dedões do pé por causa de uma piada de mau gosto.');
INSERT INTO "item_descriptions" VALUES(16311,'pt','Às vezes, antes nunca é melhor do que tarde.');
INSERT INTO "item_descriptions" VALUES(16312,'pt','Às vezes, antes nunca é melhor do que tarde.');
INSERT INTO "item_descriptions" VALUES(16313,'pt','Às vezes, antes nunca é melhor do que tarde.');
INSERT INTO "item_descriptions" VALUES(16314,'pt','Este troféu pode ajudar a transformar os inimigos em pó. Se for usado de cabeça para baixo, podemos supor que transforme pó em inimigos.');
INSERT INTO "item_descriptions" VALUES(16315,'pt','Este troféu pode ajudar a transformar os inimigos em pó. Se for usado de cabeça para baixo, podemos supor que transforme pó em inimigos.');
INSERT INTO "item_descriptions" VALUES(16316,'pt','Este troféu pode ajudar a transformar os inimigos em pó. Se for usado de cabeça para baixo, podemos supor que transforme pó em inimigos.');
INSERT INTO "item_descriptions" VALUES(16318,'pt','Este troféu protege você de todos os indecisos que não escolhem um lado na batalha.');
INSERT INTO "item_descriptions" VALUES(16319,'pt','Este troféu protege você de todos os indecisos que não escolhem um lado na batalha.');
INSERT INTO "item_descriptions" VALUES(16320,'pt','Este troféu protege você de todos os indecisos que não escolhem um lado na batalha.');
INSERT INTO "item_descriptions" VALUES(16321,'pt','Este troféu pode ser usado como cinzeiro se você preferir usar o cachimbo da paz ao invés de lutar.');
INSERT INTO "item_descriptions" VALUES(16322,'pt','Este troféu pode ser usado como cinzeiro se você preferir usar o cachimbo da paz ao invés de lutar.');
INSERT INTO "item_descriptions" VALUES(16323,'pt','Este troféu pode ser usado como cinzeiro se você preferir usar o cachimbo da paz ao invés de lutar.');
INSERT INTO "item_descriptions" VALUES(16324,'pt','Este troféu protege você das lágrimas de Crocodyl.');
INSERT INTO "item_descriptions" VALUES(16325,'pt','Este troféu protege você das lágrimas de Crocodyl.');
INSERT INTO "item_descriptions" VALUES(16326,'pt','Este troféu protege você das lágrimas de Crocodyl.');
INSERT INTO "item_descriptions" VALUES(16327,'pt','Este troféu protege você do vento e dos gases, mas não impede o seu próprio corpo de produzi-los. Isso pode causar certo desconforto estomacal.');
INSERT INTO "item_descriptions" VALUES(16328,'pt','Este troféu protege você do vento e dos gases, mas não impede o seu próprio corpo de produzi-los. Isso pode causar certo desconforto estomacal.');
INSERT INTO "item_descriptions" VALUES(16329,'pt','Este troféu protege você do vento e dos gases, mas não impede o seu próprio corpo de produzi-los. Isso pode causar certo desconforto estomacal.');
INSERT INTO "item_descriptions" VALUES(16330,'pt','Você levou ao pé da letra quando ela disse ''se joga!''.');
INSERT INTO "item_descriptions" VALUES(16331,'pt','Você levou ao pé da letra quando ela disse ''se joga!''.');
INSERT INTO "item_descriptions" VALUES(16332,'pt','Você levou ao pé da letra quando ela disse ''se joga!''.');
INSERT INTO "item_descriptions" VALUES(16333,'pt','Este troféu emite pequenos choques elétricos para manter você ativo. Você pode usá-lo no abdômen, nas roupas de baixo ou em um aquário, se gostar de ver os peixes boiando.');
INSERT INTO "item_descriptions" VALUES(16335,'pt','Você gosta de se definir como um nômade, o que não passa de um eufemismo para “covarde”.');
INSERT INTO "item_descriptions" VALUES(16336,'pt','Munido de uma luneta, empoleirado em uma árvore e longe do combate, o observador costuma ter um papel decisivo em uma batalha. O mais importante é que ele é o primeiro a conseguir fugir quando percebe que a situação está desfavorável aos seus aliados.');
INSERT INTO "item_descriptions" VALUES(16337,'pt','Seus amigos ficam com água na boca ao verem você sangrar, mas se recusam a tomar sua deliciosa sopa de alho. Que estranho.');
INSERT INTO "item_descriptions" VALUES(16338,'pt','Seus amigos ficam com água na boca ao verem você sangrar, mas se recusam a tomar sua deliciosa sopa de alho. Que estranho.');
INSERT INTO "item_descriptions" VALUES(16339,'pt','Seus amigos ficam com água na boca ao verem você sangrar, mas se recusam a tomar sua deliciosa sopa de alho. Que estranho.');
INSERT INTO "item_descriptions" VALUES(16343,'pt','Com este pincel raro, feito de madeira de Arvraknídeo e pelos de Mulobo, você poderá divertir e emocionar seus amigos.');
INSERT INTO "item_descriptions" VALUES(16500,'pt','Com este par de chifres em seu capacete, ninguém mais poderá dizer que você não tem nada na cabeça.');
INSERT INTO "item_descriptions" VALUES(16501,'pt','Com esta capa, você poderia fazer com que os Chafers pensem que é o capitão deles. Pena que eles não têm olhos para ver isso!');
INSERT INTO "item_descriptions" VALUES(16502,'pt','Feito com ossos de Chafer, este magnífico bracelete protege o seu pulso dos golpes de espada ao mesmo tempo em que o deixa mais musculoso. É o item ideal para um iniciante como você.');
INSERT INTO "item_descriptions" VALUES(16503,'pt','Graças à luz emanada por este acessório, nenhum espírito poderá pegar você de surpresa. É muito útil para andar por Incarnam tranquilamente.');
INSERT INTO "item_descriptions" VALUES(16504,'pt','Já que você não tem uma mente afiada ou uma alma virtuosa, pelo menos terá uma aparência graciosa graças a estas asas feitas de material celeste.');
INSERT INTO "item_descriptions" VALUES(16505,'pt','Diz a lenda que este amuleto contém a alma de um poderoso mágico que desafiou e derrotou Ecaflip em uma partida de tranca celeste, o jogo de cartas preferido dos Doze. Se você usar este amuleto no pescoço enquanto joga cartas, pode ser que ele se manifeste.');
INSERT INTO "item_descriptions" VALUES(16527,'pt','Basta segurar este martelo para sentir uma vontade incontrolável de sair quebrando tudo. Não é à toa que o apelido do Fenrigor era Destruidor...');
INSERT INTO "item_descriptions" VALUES(16541,'pt','Ferramenta indispensável à extração de minérios.');
INSERT INTO "item_descriptions" VALUES(16843,'pt','Esta bolsa faz muito sucesso em Incarnam. As aventureiras a consideram prática e elegante. Já os aventureiros a utilizam para guardar os dentes que arrancam de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(16953,'pt','Já que é pra cavar a própria cova, é melhor usar uma pá fabricada pelo clã de Terra Cogita. Assim, pelo menos você terá um enterro de primeira.');
INSERT INTO "item_descriptions" VALUES(17012,'pt','Fornecido com dentes de Crocodyl mais afiados que uma espada de Iop, este cinto dará a você a aparência de um velho caçador experiente com quem os outros não devem se meter.');
INSERT INTO "item_descriptions" VALUES(17013,'pt','Estas botas farão tanto barulho durante o combate que seus adversários ficarão atordoados.');
INSERT INTO "item_descriptions" VALUES(17023,'pt','Os bontarianos apreciam a fidelidade e o apego do Bontarrapato, enquanto as outras pessoas normais o consideram muito pegajoso. Realmente, depois que se apega a alguém, ele não solta mais, aconteça o que acontecer. Isso significa que ele o seguirá aonde você for, inclusive ao banheiro.');
INSERT INTO "item_descriptions" VALUES(17028,'pt','Os Brákaros são uma verdadeira praga. Depois de exterminar os Vilinsetos de Brakmar, eles se infiltraram em cada cantinho de todas as casa, por isso podem ser encontrados em tapetes, colchões, roupas de cama... Alguns brakmarianos apreciam seu temperamento hostil e os adotam como animais de estimação.');
INSERT INTO "item_descriptions" VALUES(17078,'pt','Os Kanibolas fingem que a Árvore de Moon é, na verdade, um dragão adormecido. Vindo da lua, o ser imortal teria adotado a forma de um grande kokeiro para dar sombra à uma princesa que sofria com o calor do sol. Ele teria adormecido logo depois... O Dokoko, fruto da Árvore de Moon, seria então um autêntico Dofus? Nós ainda não estamos muito certos disso.');
INSERT INTO "item_descriptions" VALUES(17079,'pt','Como preferem a música à caça, os Kanibolas Tam se diferenciam dos outros membros de sua tribo por uma máscara de cabelos brancos ao invés de pretos, o que lhes confere um estilo incomparável.');
INSERT INTO "item_descriptions" VALUES(17092,'pt','Moon encontrou este martelo mágico quando foi capturado por um pirata que, para o seu azar, também era caçador clandestino. Nas mãos de Moon, um único golpe no chão era suficiente para provocar um terremoto, o que é muito prático para derrubar os Kokokos dos kokeiros.');
INSERT INTO "item_descriptions" VALUES(17093,'pt','Esta capa de cores exóticas e cheia de charme foi feita com folhas de Kokoko e bananagrume. Infelizmente, o cheiro que ela exala atrai todos os animais selvagens que você encontra pelo caminho, pois as pobres criaturas pensam que você é uma banana gigante e deliciosa.');
INSERT INTO "item_descriptions" VALUES(17094,'pt','Os Kanibolas confeccionaram este objeto à imagem de Moon, que eles consideram o deus-símio da ilha. É preciso dizer que, segundo a lenda, foi um dos golpes do martelo de Moon que deu esta forma de lua crescente ao amuleto. Enfim, isso é o que os funcionários da Agência de Turismo Classe A contam aos viajantes que vêm passar as férias aqui, tentando arrancar alguns kamas deles em troca deste amuleto.');
INSERT INTO "item_descriptions" VALUES(17095,'pt','Esta espada extremamente poderosa fará com que raios caiam sobre seus adversários. Note que isso funciona melhor em dias de tempestade, com a espada levantada e apontando para o céu. Ah, se seu inimigo estiver segurando-a pela lâmina é melhor ainda.');
INSERT INTO "item_descriptions" VALUES(17096,'pt','A corda deste cinto é feita de um material extremamente raro que absorve os raios e armazena sua potência. Ideal para se proteger em dias de tempestade quando não há um abrigo por perto.');
INSERT INTO "item_descriptions" VALUES(17097,'pt','Diz a lenda que aquele que usar o "círculo do raio" contido nesta capa será capaz de manipular os relâmpagos como bem entender. Pode até ser só uma lenda, mas não custa nada tentar!');
INSERT INTO "item_descriptions" VALUES(17098,'pt','Ideal se quiser ficar parecido com um velho eremita, esta barba lhe dará o aspecto de alguém que passou a vida meditando para compreender e dominar os mistérios do Pandawushu.');
INSERT INTO "item_descriptions" VALUES(17099,'pt','Este cinto enorme facilitará seus deslocamentos e reduzirá seu esforço se você estiver acima do peso. Se não for o caso, você ainda poderá usá-lo para amarrar seus adversários mais rechonchudos.');
INSERT INTO "item_descriptions" VALUES(17100,'pt','Dizem que o poder deste bastão permite encontrar todas as fontes de álcool mais próximas. Superstição ou não, você deveria tentar a sorte!');
INSERT INTO "item_descriptions" VALUES(17103,'pt','Dizem que o Vouromort guardou parte de sua alma neste amuleto. Talvez o Larry Poller saiba mais a respeito dessa história.');
INSERT INTO "item_descriptions" VALUES(17104,'pt','Este cinto é usado pelos Devoradouros. Dizem que ele permite digerir corretamente todo o ouro ingerido.');
INSERT INTO "item_descriptions" VALUES(17105,'pt','Vouromort não usa mais suas botas desde que aprendeu a levitar. Desde então, ele tem um ponto fraco: as cócegas.');
INSERT INTO "item_descriptions" VALUES(17106,'pt','A pele de Kongoku é de ótima qualidade, mas usar esta capa pode ser muito perigoso se você cruzar o caminho de um defensor dos animais.');
INSERT INTO "item_descriptions" VALUES(17107,'pt','Este brinco meio rebelde tem a péssima mania de passar da orelha direita à orelha esquerda, seguindo a direção do olhar de seu portador.');
INSERT INTO "item_descriptions" VALUES(17108,'pt','Na verdade, o Kongoku usa este cinto no pulso. Isso diz muita coisa a respeito da musculatura da criatura.');
INSERT INTO "item_descriptions" VALUES(17109,'pt','Esta capa pertencia ao grande Tchuke, o mais famoso pirata que já cruzou os vastos mares de Amakna, segundo a sua autobiografia. Dizem que ele e sua tripulação foram condenados a serem transformados em fantasmas e esqueletos após seu barco ser atingido por uma misteriosa maldição...');
INSERT INTO "item_descriptions" VALUES(17110,'pt','Mais chique que um chapéu de plumas, este chapéu de pirata lhe revelará a localização de diversos tesouros escondidos nos mares de Amakna. Infelizmente, como você é o único que pode ouvir a voz dele, todo mundo vai pensar que você ficou louco.');
INSERT INTO "item_descriptions" VALUES(17111,'pt','Esta aliança mágica encontrada em um tesouro ancestral tem o poder de mudar a cor da urina de seu portador. Pena que ela não seja útil no mar...');
INSERT INTO "item_descriptions" VALUES(17119,'pt','O Guerreiro do K.O. usava este cinto para mostrar para todo mundo que ele era o campeão do K.O. Agora que o cinto é seu, chegou a sua vez de se exibir!');
INSERT INTO "item_descriptions" VALUES(17120,'pt','Segundo a lenda, este amuleto deveria proteger seu portador de todos os tipos de morte possíveis. Mas, a julgar pelo que você fez ao seu antigo proprietário, deve ser apenas uma lenda.');
INSERT INTO "item_descriptions" VALUES(17121,'pt','Esmagar, esmigalhar, quebrar, pisotear, estraçalhar... Com estas botas nos pés, você poderá fazer tudo isso e muito mais.');
INSERT INTO "item_descriptions" VALUES(17213,'pt','Estas botas de tamanho 24 foram feitas para Ecaflips de pés pequenos. A menos que você calce o mesmo número que o Kerubim, só poderá usá-las como objeto de decoração para a sua sala.');
INSERT INTO "item_descriptions" VALUES(17214,'pt','Esta réplica exata da cueca usada por Kerubim irá protegê-lo de todas as armas que seus inimigos lançarem na direção das suas partes íntimas.');
INSERT INTO "item_descriptions" VALUES(17292,'pt','Estas botas são responsáveis pela rapidez da sua equipe preferida, ideais para correr em direção à vitória ou fugir da derrota.');
INSERT INTO "item_descriptions" VALUES(17293,'pt','Espinhosas como uma rosa, estas botas de corrida servem para percorrer grandes distâncias, tanto horizontal quanto verticalmente.');
INSERT INTO "item_descriptions" VALUES(17294,'pt','"É um pássaro? É um avião? Não, é um Pamu!" Isto é o que todo bom torcedor dos Pamus grita quando um jogador do seu time marca um gol.');
INSERT INTO "item_descriptions" VALUES(17295,'pt','Os Olbleks correm mais rápido que animais selvagens. Eles devem sua agilidade em parte a este suntuoso par de botas feito especialmente para corridas.');
INSERT INTO "item_descriptions" VALUES(17300,'pt','Este cinto foi feito à imagem da recompensa entregue aos vencedores da copa do mundo de Papabol. Com ele, você poderá se vangloriar excessivamente diante dos torcedores dos outros times com um ar superior e zombeteiro.');
INSERT INTO "item_descriptions" VALUES(17301,'pt','Este cinto que protege as partes íntimas foi feito especialmente para os torcedores dos Redenrose, que costumam se envolver em inúmeras brigas nos estádios de Papabol.');
INSERT INTO "item_descriptions" VALUES(17302,'pt','Este cinto, a meio caminho entre um kilt e um cinturão de campeão, foi usado por várias gerações de torcedores dos Pamus. Chegou a sua vez de usá-lo para honrar o seu time!');
INSERT INTO "item_descriptions" VALUES(17303,'pt','Com este short apertado, você parecerá uma pessoa vivaz e saudável, pronta para pular em cima de tudo o que se move, como um verdadeiro Olblek.');
INSERT INTO "item_descriptions" VALUES(17379,'pt','O Girinim é um dos animais mais peculiares do Mundo dos Doze: seus grandes olhos e sua cabeça chata lhe dão uma aparência ridícula, enquanto sua crista espinhosa e sua longa cauda o deixam com um ar de animal feroz. Quanta contradição em uma criaturinha tão pequena...');
INSERT INTO "item_descriptions" VALUES(17448,'pt','Este chapéu emana uma luz cromática de cores suntuosas e regula a intensidade de seu brilho de acordo com o poder do seu portador.');
INSERT INTO "item_descriptions" VALUES(17449,'pt','Esta capa, tradicionalmente usada em cerimônias e viagens, está impregnada de uma poderosa magia que dá ao seu portador um carisma incrível, uma atitude heroica e uma proteção contra a chuva e respingos de lama.');
INSERT INTO "item_descriptions" VALUES(17450,'pt','Com estas botas nos pés, você será sempre o primeiro em tudo, tanto para partir em uma aventura quanto para fugir de um combate.');
INSERT INTO "item_descriptions" VALUES(17451,'pt','Criado para catalisar a energia da brisa quadramental, este cinto foi a primeira peça do traje tradicional dos Huppermagos a ser produzida. Seu estilo e suas cores foram inspirados em Bonta, cidade de origem de seu criador, o célebre Huppermago Uátissom.');
INSERT INTO "item_descriptions" VALUES(17452,'pt','Criado pelo fogo dos Huppermagos, este anel poderoso está cheio de mistérios. Em seu interior, podemos ler a seguinte inscrição: "Sou Piu de fogo que canta ao teu ouvido, vou ganhar esse combate." Vai saber o que isso significa...');
INSERT INTO "item_descriptions" VALUES(17456,'pt','A frase "tirar um espinho do pé" fará muito mais sentido quando você calçar estes sapatos.');
INSERT INTO "item_descriptions" VALUES(17457,'pt','Decoração para a árvore ou bijuteria para aventureiros, este anel é o acessório ideal agora que o Nataw está se aproximando.');
INSERT INTO "item_descriptions" VALUES(17460,'pt','Esta varinha mágica possui um encantamento que lhe permite abrir uma passagem para o bosque dos cárpinos sombrios. Ela seria muito mais popular se permitisse abrir uma passagem para a taberna.');
INSERT INTO "item_descriptions" VALUES(17487,'pt','Espalhe o terror entre seus adversários ao usar este colar de caveira, símbolo de força e brutalidade. Se o Khan faz isso, é porque deve funcionar!');
INSERT INTO "item_descriptions" VALUES(17488,'pt','Muitos bontarianos pensam que a barba do monarca é feita de ouro, mas trata-se apenas de seu torque que não para no lugar e acaba subindo para o queixo.');
INSERT INTO "item_descriptions" VALUES(17495,'pt','Evite usar estas botas se for realizar um teste de recrutamento em um time de Papabol: você correria o risco de se estatelar no chão no meio de uma corrida.');
INSERT INTO "item_descriptions" VALUES(17496,'pt','Estas botas cintilantes, douradas como o sol, ofuscam todos os súditos do monarca que se ajoelham a seus pés para saudá-lo.');
INSERT INTO "item_descriptions" VALUES(17502,'pt','Usar esta cueca apertada não fará de você um campeão de Papabol, mas valorizará os seus atributos.');
INSERT INTO "item_descriptions" VALUES(17503,'pt','Este cinto é grande para conter a barriguinha saliente adquirida pelo Rei de Bonta durante seu reinado. Pelo menos não vai ficar apertado em você!');
INSERT INTO "item_descriptions" VALUES(17504,'pt','Este torque, que costuma ser usado como colar por pessoas grandes, constitui a peça principal da armadura do Kerubim e protege toda a parte superior de seu corpo.');
INSERT INTO "item_descriptions" VALUES(17506,'pt','Como guarda pessoal do rei, você deve estar preparado para o que der e vier. Isto inclui levar um golpe nas partes íntimas.');
INSERT INTO "item_descriptions" VALUES(17507,'pt','As asas desta bota são o símbolo da cidade que você protege, mas também um lembrete do lema dos guardas de Bonta: "em cima, embaixo, Bonta e vai!"');
INSERT INTO "item_descriptions" VALUES(17508,'pt','Este colar cheio de ossinhos folheados a ouro está na moda e causará furor se você desfilar com ele nas estepes de Sidimote.');
INSERT INTO "item_descriptions" VALUES(17511,'pt','Mesmo se você encher seu Minikrônio de beijos coloridos que vêm do fundo do coração, isso não será suficiente para alimentá-lo.');
INSERT INTO "item_descriptions" VALUES(17524,'pt','Este magnífico par de botas vai deixar você um pouco mais inteligente.');
INSERT INTO "item_descriptions" VALUES(17525,'pt','Com este maravilhoso buquê, você mostrará à sua cara-metade que está disposto(a) para encarar mil e um perigos por seus belos olhos.');
INSERT INTO "item_descriptions" VALUES(17572,'pt','Os trevos destas botas são perfumados, então podem ser colocados no interior delas para disfarçar certos maus odores, ou então se misturar com esses odores para criar algo único e imprevisível.');
INSERT INTO "item_descriptions" VALUES(17573,'pt','Os raros assuntos graves que entram por um ouvido do Rei Jogador saem pelo outro e acabam chegando nesta coroa. Por isso, hoje em dia ela está carregada de gravidade, o que explica por que os anéis dourados que a rodeiam se mantêm no lugar e por que ela não cai quando você dá cambalhotas.');
INSERT INTO "item_descriptions" VALUES(17574,'pt','O Rei Jogador usa seu sinete para marcar suas vítimas. De onde será que vem a cera que ele usa para isso?');
INSERT INTO "item_descriptions" VALUES(17575,'pt','Estas pantufas confortáveis deixam impressionantes pegadas de gato no chão. Devem ser usadas com precaução, pois poderiam atrair monstros caninos enormes, como o Mulobo.');
INSERT INTO "item_descriptions" VALUES(17576,'pt','Dentro deste pingente está o retrato da pessoa que você mais ama. Em outras palavras, você mesmo.');
INSERT INTO "item_descriptions" VALUES(17577,'pt','Há uma mensagem escrita no interior desta capa:
"O ladrão deve me devolver esta capa, e que CORTEM-LHE A CABEÇA.
Xoxo, sua rainha."');
INSERT INTO "item_descriptions" VALUES(17578,'pt','Estas botas foram concebidas e aprimoradas para que você possa se mover pelas casas do tabuleiro. No entanto, elas não terão a melhor utilidade em um labirinto, por exemplo.');
INSERT INTO "item_descriptions" VALUES(17579,'pt','Este capacete lhe dará uma aparência muito mais séria.');
INSERT INTO "item_descriptions" VALUES(17580,'pt','Como as barras de chocolate nas costas não fazem muito efeito, esta capas às vezes pode ser usada como avental.');
INSERT INTO "item_descriptions" VALUES(17581,'pt','Não se esqueça de escrever o seu nome e o do seu mestre neste colar. Se você se perder, pode ser útil para devolvê-lo à pessoa certa.');
INSERT INTO "item_descriptions" VALUES(17582,'pt','Se a aparência dessas luvas leva a crer que há apenas 3 buracos para os dedos, é porque é verdade. Agora você só tem duas opções: amaldiçoar o alfaiate que as costurou ou arrancar dois dedos.');
INSERT INTO "item_descriptions" VALUES(17583,'pt','Você sempre sonhou em ter quatro caudas? Pois seus sonhos acabam de se tornar realidade!');
INSERT INTO "item_descriptions" VALUES(17584,'pt','Esta capa pode se dividir em dois. Assim, cada parte pode ser usada como uma meia-capa. Impressionante, não?');
INSERT INTO "item_descriptions" VALUES(17585,'pt','Estas sandálias também podem ser usadas como patins, permitindo que você deslize sobre certas superfícies como se estivesse só de meias. Atenção: o uso de meias junto com estas sandálias não multiplica o efeito de deslizamento.');
INSERT INTO "item_descriptions" VALUES(17586,'pt','Estes sabres são tão afiados que, se o Atcham não fosse careca, seria difícil manejá-los sem danificar sua pelagem.');
INSERT INTO "item_descriptions" VALUES(17587,'pt','Poucos materiais são tão resistentes quanto o tecido usado para fabricar este colarinho, que protegerá você de todos os golpes de espada direcionados ao seu pescoço.');
INSERT INTO "item_descriptions" VALUES(17588,'pt','Estas botas são tão confortáveis quanto pantufas quando usadas nos pés e duras como pedra quando vão de encontro às suas partes íntimas.');
INSERT INTO "item_descriptions" VALUES(17589,'pt','Cada uma das espadas do Ush representa uma parte dele mesmo. Ao arrancar seu lado flamejante, você o deixou só com sua parte sombria.');
INSERT INTO "item_descriptions" VALUES(17590,'pt','Com sua estampa tigrada, a capa dos Lobichanos lhe permitirá ofuscar a visão dos seus adversários com tanta eficácia que eles ficarão cegos.');
INSERT INTO "item_descriptions" VALUES(17591,'pt','Você pensava que poderia se camuflar entre os Lobichanos usando o símbolo deles em volta da cintura, mas esta cabeça de gato só serve para marcar a próxima presa deles. Que azar o seu!');
INSERT INTO "item_descriptions" VALUES(17592,'pt','Este anel teria a estranha peculiaridade de fazer com que as frases de seu portador comecem com a palavra "Miawnossa". No entanto, isto não funciona com você. Deve ser mais uma lenda de aventureiros...');
INSERT INTO "item_descriptions" VALUES(17593,'pt','É impressionante que você consiga calçar essas botas apesar de terem pertencido a uma pulga. Seu pé deve ser mesmo muito pequeno...');
INSERT INTO "item_descriptions" VALUES(17594,'pt','Assim como um cinturão de campeão, o cinto do Repulgnante mostrará ao mundo quem foi que triunfou no combate contra essa criatura imunda.');
INSERT INTO "item_descriptions" VALUES(17595,'pt','Este chapéu, feito com o couro cabeludo do Repulgnante, é horroroso, mas tem a vantagem de deixar os carecas com alguns fios de cabelo na cabeça sem precisar de implante.');
INSERT INTO "item_descriptions" VALUES(17596,'pt','Só um joalheiro excepcional poderia ter concebido tal maravilha, fruto de um trabalho extremamente minucioso e uma atenção aos detalhes sem igual.');
INSERT INTO "item_descriptions" VALUES(17597,'pt','Usado como colar, este Pikbul reduzido lhe trará sorte nas situações mais desastrosas.');
INSERT INTO "item_descriptions" VALUES(17598,'pt','Arranque a pele de um Carracac e faça uma Carracapa!');
INSERT INTO "item_descriptions" VALUES(17627,'pt','Não se esqueça de que, ao usar este escudo, você estará se colocando a serviço da ciência. Não pense que vai ser moleza só porque ele é feito de espuma.');
INSERT INTO "item_descriptions" VALUES(17628,'pt','O que é branco, tem um cheiro horroroso e aquece no inverno? Não, não é um Wabbit morto enrolado no seu pescoço. Quando é que você vai parar de dizer besteiras?');
INSERT INTO "item_descriptions" VALUES(17629,'pt','A origem da matéria verde e elástica que recobre o escudo ainda é desconhecida. Tudo o que se sabe é que ela é considerada sagrada pelos Goblins.');
INSERT INTO "item_descriptions" VALUES(17681,'pt','Ao receber dolorosamente uma flecha deste arco, a mensagem é clara: alguém viu você.');
INSERT INTO "item_descriptions" VALUES(17682,'pt','Este cetro teria feito o rei Nidas perder a cabeça durante uma partida de jogo de cartas com apostas elevadas.');
INSERT INTO "item_descriptions" VALUES(17683,'pt','Deu tá dado, quem perdeu foi o machado.');
INSERT INTO "item_descriptions" VALUES(17684,'pt','Com este aparelho na cabeça, você poderá ver coisas que ninguém mais consegue ver. Daí a dizer que a lupa provoca alucinações é um pulo... Pulo este que você já deu há muito tempo.');
INSERT INTO "item_descriptions" VALUES(17700,'pt','Mais ágil que um Tofu na hora do almoço, o Gatzgrila surpreende suas presas com sua extrema rapidez, o que faz dele um predador excepcional, mas também uma criatura elusiva. Dizem que aquele que conseguir domesticá-lo desfrutará de sua celeridade...');
INSERT INTO "item_descriptions" VALUES(17733,'pt','Os foguetes instalados nestas botas podem ter duas utilidades completamente diferentes: ou elas lhe permitirão sair vitorioso graças à aceleração que lhe conferem ou transformarão seu Dragoperu em um assado se perder a corrida.');
INSERT INTO "item_descriptions" VALUES(17734,'pt','Este cinto de segurança é tão eficaz para protegê-lo em caso de acidente quanto uma cueca usada na cabeça como se fosse um capacete.');
INSERT INTO "item_descriptions" VALUES(17795,'pt','Os Tirubins são Miawzinhos fofos que dão vontade de apertar até fazer suquinho de tão cuti-cuti que são. Eles podem ser encontrados na dimensão Ecafliperama. Ninguém sabe se a aura mágica que envolve esse lugar é responsável por sua semelhança com Kerubim.');
INSERT INTO "item_descriptions" VALUES(17809,'pt','É uma heresia usar este martelo para outra coisa que não seja o progresso da ciência. Quebrar o crânio dos seus inimigos pode entrar nesta última categoria se for feito com um objetivo científico.');
INSERT INTO "item_descriptions" VALUES(17813,'pt','Saído diretamente das profundezas de Sufokia, o Glub deve seu nome ao som que ele emite quando você o retira de uma cavidade submarina, que é seu habitat natural. Seu lado carinhoso e sua forma engraçada fazem dele o melhor amigo dos Triatuns.');
INSERT INTO "item_descriptions" VALUES(17833,'pt','É fácil confundir os Tichans com ratos por causa de sua cauda, suas longas orelhas e seus corpos pelados, mas basta adotar um para se dar conta de que o pequeno predador não tem nada a ver com um roedor. Carinhoso como ele só, ele lamberá seu rosto o tempo todo. Isso se você aguentar seu mau hálito, claro.');
INSERT INTO "item_descriptions" VALUES(17849,'pt','Bote seus pés para pegar um bronzeado e aproveite o verão!');
INSERT INTO "item_descriptions" VALUES(17961,'pt','Deks garantiu que este capacete te permitiria resistir à influência dos cristais de ressonância. Tomara que seja eficaz mesmo: se é pra ficar ridículo, que não seja à toa.');
INSERT INTO "item_descriptions" VALUES(17997,'pt','Transformar uma lanterna de Trianguejo em colar é um ato bastante ousado: a luz emitida pode atrair certas pessoas, e você não tem necessariamente um crânio resistente o suficiente para enfrentar a ameaça.');
INSERT INTO "item_descriptions" VALUES(17998,'pt','Bastante robusto, este anel deixa marcas profundas em tudo o que você golpeia.');
INSERT INTO "item_descriptions" VALUES(18000,'pt','Demência furiosa, loucura mascarada, alucinação monstruosa... Certas coisas devem ser deixadas nos abismos, é melhor assim.');
INSERT INTO "item_descriptions" VALUES(18001,'pt','Ter uma lixeira sempre ao alcance da mão para jogar toda tralha e porcaria é uma ideia interessante, e este pingente pode desempenhar essa função. No entanto, ele vai ficando mais pesado toda vez que ingurgita um item. Você vai precisar fortalecer os músculos do pescoço para poder continuar usando-o.');
INSERT INTO "item_descriptions" VALUES(18002,'pt','Esta capa aspira água para inflar e tomar a forma de um baiacu.');
INSERT INTO "item_descriptions" VALUES(18003,'pt','Encontrar um nome para estas botas não é tarefa fácil. Sendo assim, optamos pelo óbvio.');
INSERT INTO "item_descriptions" VALUES(18004,'pt','Este amuleto representa uma versão simplificada de um Shokkoth. É melhor se lembrar da aparência deles: embora seja bastante característica, eles podem lhe passar a perna facilmente.
P.S.: o colar é elástico.');
INSERT INTO "item_descriptions" VALUES(18005,'pt','Os engraçadinhos que tentarão puxar seu rabo correm o risco de serem fulminados, literalmente.');
INSERT INTO "item_descriptions" VALUES(18006,'pt','Nós até gostaríamos de saber por que esta tanga possui tentáculos, mas não é da nossa conta.');
INSERT INTO "item_descriptions" VALUES(18007,'pt','Com estas barbatanas, você se sentirá como um peixe dentro d''água.');
INSERT INTO "item_descriptions" VALUES(18008,'pt','Encontrar uma descrição para um objeto indescritível é um exercício interessante. Alguns poderiam optar pela solução mais fácil e mais econômica: não descrever o objeto. Mas não é assim que fazemos as coisas por aqui. Se é para escrever textão, então vamos escrever textão! Senta que lá vem história. 
Há realmente muito a se dizer sobre a natureza do indescritível. Isto pode ter vários sentidos: pode ser que não tenhamos palavras para descrever a coisa em questão porque ela é surpreendente, porque ela não se parece com nada que conhecemos, ou, ainda, porque não temos o conhecimento lexical para encontrar as palavras certas que exprimiriam da melhor forma possível o caráter indescritível da coisa. É aí que nos escondemos atrás deste tipo de frase: "Haha! É indescritível!", pronunciada em um tom altamente persuasivo. Será mesmo o caso? 
Se procurarmos lá no fundo, talvez possamos nos deparar com uma descrição exata e apropriada. Algo suficientemente claro e ao mesmo tempo abstrato poderia facilitar a compreensão do que é a coisa descrita. Se as palavras não bastam, talvez seja necessário inventar palavras novas, quem sabe? Palavras que venham do coração, que falem por si só quando os limites da linguagem forem alcançados. O indescritível, no fim das contas, é acima de tudo um desconhecido que só quer que façamos o esforço de compreendê-lo, de deixar fluir a imaginação, a razão e os sentimentos para melhor apreendê-lo e, assim, encontrar as palavras que poderão descrevê-lo.
Seria muito trabalho para uma simples descrição de capa.');
INSERT INTO "item_descriptions" VALUES(18009,'pt','O capitão Meno só usava este cinto para marcar seus prisioneiros, nada mais.');
INSERT INTO "item_descriptions" VALUES(18010,'pt','Feito a partir dos tridentes dos Trydes, este bastão é muito usado na pesca aos Triatuns.');
INSERT INTO "item_descriptions" VALUES(18011,'pt','Visualmente desconfortável, esta varinha semeará a dúvida na mente dos seus adversários.');
INSERT INTO "item_descriptions" VALUES(18012,'pt','Este é o segundo de uma longa linha de arcos que tem um olho no lugar da corda. Ninguém entende como ele funciona, mas parece que as flechas usadas vêm de outra dimensão.');
INSERT INTO "item_descriptions" VALUES(18013,'pt','Para os amantes dos tesouros submarinos que não conseguem resistir à tentação de sair cavando por aí na esperança de encontrar alguma coisa, esta pá-arpão permitirá que se defendam se desalojarem acidentalmente um crustáceo nada amistoso.');
INSERT INTO "item_descriptions" VALUES(18014,'pt','Este machado, que possui as características naturais de uma Taserraia, usa a eletricidade para melhorar seu desempenho.');
INSERT INTO "item_descriptions" VALUES(18015,'pt','Esta espada corta diretamente a alma dos seus inimigos.');
INSERT INTO "item_descriptions" VALUES(18017,'pt','Quando acertam o alvo, estas adagas deixam escapar um líquido viscoso e inquietante, como se o aspirassem do corpo da vítima.');
INSERT INTO "item_descriptions" VALUES(18018,'pt','Este martelo foi criado para fazer sofrer. Primeiro faz sofrer os olhos, por causa de sua aparência. Depois castiga os ouvidos, emitindo sons que imitam uma flauta doce. E, por fim, pode infligir danos físicos importantes.');
INSERT INTO "item_descriptions" VALUES(18019,'pt','Com o Cintosa, você estará pronto para escalar qualquer muralha. Não precisa mais se agarrar com todas as forças para não cair, basta colar o seu quadril altamente adesivo na superfície que deseja escalar. Isso também funciona em outros seres vivos, mas aí já é considerado assédio.');
INSERT INTO "item_descriptions" VALUES(18020,'pt','Muito práticos para andar debaixo d''água, estes tamancos fixarão você ao solo, desde que não levante os dois pés.');
INSERT INTO "item_descriptions" VALUES(18021,'pt','Não é tão popular quanto o chapéu de Popol, o polvo, e também não dá o poder da clarividência. Dizem que ele poderia ajudar a resolver problemas de proporções tentaculares.');
INSERT INTO "item_descriptions" VALUES(18022,'pt','Por que escolher entre pinçar e chutar quando você pode fazer os dois ao mesmo tempo?');
INSERT INTO "item_descriptions" VALUES(18023,'pt','Equipado com uma máscara de mergulho, este quepe lhe dará a aparência de um verdadeiro capitão de um submarino naufragado.');
INSERT INTO "item_descriptions" VALUES(18024,'pt','Há quem acredite que o símbolo gravado nesta capa significa que um poderoso feiticeiro tomou posse dela, mas é simplesmente o sinal de Meno.');
INSERT INTO "item_descriptions" VALUES(18025,'pt','O que é indizível não pode ser dito.');
INSERT INTO "item_descriptions" VALUES(18026,'pt','O que é indizível não pode ser dito.');
INSERT INTO "item_descriptions" VALUES(18028,'pt','O que é indizível não pode ser dito.');
INSERT INTO "item_descriptions" VALUES(18029,'pt','Muito elegante, esta joia é perfeita para ser usada como anel de noivado... por um Triatum.');
INSERT INTO "item_descriptions" VALUES(18030,'pt','Se não levarmos em consideração as cores, estas botas são perfeitas para os passeios submarinos: são impermeáveis e facilitam o nado.');
INSERT INTO "item_descriptions" VALUES(18031,'pt','Esta máscara não é suficiente para que você possa se passar por um Triatum, então as Polnecas e os Trianguejos continuarão fora do seu alcance. Por outro lado, ela lhe permitirá respirar debaixo d''água.');
INSERT INTO "item_descriptions" VALUES(18032,'pt','Dois olhos adicionais são sempre bem-vindos. Eles lhe darão um ar sério, irritado ou pensativo.');
INSERT INTO "item_descriptions" VALUES(18033,'pt','Este cinto bota a língua pra fora quando está muito apertado. Sua função é alertá-lo quando você cometer excessos durante as refeições.');
INSERT INTO "item_descriptions" VALUES(18034,'pt','Usar uma carapaça de caranguejo Yolonista é muito perigoso: eles costumam pinçar seus semelhantes com toda a força para testá-los.');
INSERT INTO "item_descriptions" VALUES(18035,'pt','Este é o pingente que damos para tranquilizar os entes queridos, uma forma de desviá-los da verdadeira natureza de Katulu.');
INSERT INTO "item_descriptions" VALUES(18036,'pt','Este capacete lhe dará uma aparência perfeitamente normal e aceitável... para um fanático.');
INSERT INTO "item_descriptions" VALUES(18037,'pt','A cada má decisão tomada, este anel dá uma mordida no seu dedo.');
INSERT INTO "item_descriptions" VALUES(18043,'pt','Segundo fontes oficiais, este Dofus de aparência incomum seria uma criação dos Steamers de Sufokia. Podemos concluir, então, que não se trata de um verdadeiro ovo de dragão. Bom, pelo menos é isso que as autoridades querem nos fazer acreditar... Quem sabe realmente o que se esconde nos abismos, afinal?');
INSERT INTO "item_descriptions" VALUES(1018088,'pt','Borcego gigante com um ar não muito inteligente, o Katomor é uma montaria muito fiel. Seu amor pelo seu dono é demonstrado de diversas maneiras: às vezes ele o lambe dos pés à cabeça, mas também pode mordiscar e até tentar devorar algumas partes do corpo. Não há animal mais afetuoso que este, exceto quando ele te confunde com seu lanchinho da tarde.');
INSERT INTO "item_descriptions" VALUES(18145,'pt','Invisível no escuro e também em locais iluminados.');
INSERT INTO "item_descriptions" VALUES(18146,'pt','Invisível no escuro e também em locais iluminados.');
INSERT INTO "item_descriptions" VALUES(18229,'pt','Como a versão biquíni era muito perigosa, sua opção foi este cinto, que obriga você a cuidar da silhueta para manter a barriga chapada.');
INSERT INTO "item_descriptions" VALUES(18230,'pt','Criado por uma bruxa de moral duvidosa, este amuleto pode se retratar facilmente, basta dar a ordem. Estranhamente, essa bruxa nunca ficou sem voluntários dispostos a usar o amuleto.');
INSERT INTO "item_descriptions" VALUES(18279,'pt','A varinha aponta para o norte do Território Cacterra.');
INSERT INTO "item_descriptions" VALUES(18290,'pt','Uma ferramenta de tecnologia avançada que ajudará você a enfrentar uma tempestade.');
INSERT INTO "item_descriptions" VALUES(18350,'pt','Estas luvas devem ser descartadas após serem usadas devido aos efeitos colaterais provocados pelo material sintético que as compõe.');
INSERT INTO "item_descriptions" VALUES(18375,'pt','Agora você só precisa abençoar esta varinha e, em seguida, ir em busca da água que não existe.');
INSERT INTO "item_descriptions" VALUES(18423,'pt','Se você está procurando uma maneira de se camuflar no deserto, esta capa pode ser útil.');
INSERT INTO "item_descriptions" VALUES(18424,'pt','Este anel começa a brilhar de repente para avisar que está fazendo muito calor, caso você não seja capaz de perceber por conta própria.');
INSERT INTO "item_descriptions" VALUES(18425,'pt','Indispensáveis para caminhar na areia quente sem prejudicar as solas dos pés, estas botas também impedirão que você fique preso na areia movediça.');
INSERT INTO "item_descriptions" VALUES(18426,'pt','Embora a pele não seja um material recomendado para o clima árido, a capa de pele de Fenexo protege do calor externo.');
INSERT INTO "item_descriptions" VALUES(18427,'pt','Usar caudas de Fenexo na cabeça... O que mais vão inventar?');
INSERT INTO "item_descriptions" VALUES(18428,'pt','"Mas está calor!" – Você tem esta desculpa, pelo menos.');
INSERT INTO "item_descriptions" VALUES(18429,'pt','O objetivo aqui não é cortar: uma simples picada já é suficientemente perigosa.');
INSERT INTO "item_descriptions" VALUES(18430,'pt','Às vezes, a sutileza não adianta de nada.');
INSERT INTO "item_descriptions" VALUES(18431,'pt','Esta capa pode ser usada de duas maneiras, sendo que uma delas é recomendada apenas para quem não é Sacrier.');
INSERT INTO "item_descriptions" VALUES(18432,'pt','O formato deste capacete pode dar aos seus adversários vontade de bater na sua cabeça, e é aí que entram os espinhos.');
INSERT INTO "item_descriptions" VALUES(18433,'pt','Usar este cinto não é fácil, e retirá-lo também não.');
INSERT INTO "item_descriptions" VALUES(18434,'pt','Quem nunca sonhou em usar um sombreiro como este, pelo menos por alguns segundos?');
INSERT INTO "item_descriptions" VALUES(18435,'pt','Este anel fica mais confortável em dedos pequenos, mas, ainda assim, movimentos bruscos são desaconselhados.');
INSERT INTO "item_descriptions" VALUES(18436,'pt','Este cacto da sorte se alimenta da água contida no corpo de quem o usa.');
INSERT INTO "item_descriptions" VALUES(18437,'pt','Estas adagas cortam, perfuram, arrancam e atordoam. Basta escolher.');
INSERT INTO "item_descriptions" VALUES(18438,'pt','Sempre sonhou em ser músico? Este sabre criará um som ambiente para acompanhar suas coreografias de combate.');
INSERT INTO "item_descriptions" VALUES(18439,'pt','Em dias claros, este capacete cegará seus adversários ao refletir os raios de sol.
Em dias nublados, ele também os cegará porque é assim que funciona esta cor dourada deslumbrante.');
INSERT INTO "item_descriptions" VALUES(18529,'pt','Este cinto não bastará para transformar você em um valente alfaiate capaz de derrotar sete Moskitos gigantes de uma só vez e capturar Unikrônios.');
INSERT INTO "item_descriptions" VALUES(18530,'pt','Com seus pezinhos protegidos do frio, você está pronto para enfrentar as longas noites de inverno prostrado na frente da lareira.');
INSERT INTO "item_descriptions" VALUES(18584,'pt','Quando colocado na cabeça, este capacete finca os dentes na pele de quem o usa para não sair voando quando bater um ventinho. Você nem liga se ele aproveitar para aspirar a sua massa cinzenta, já que ela não serve para nada mesmo!');
INSERT INTO "item_descriptions" VALUES(18585,'pt','Seu aspecto o torna mais eficaz que um cinto de castidade para afastar os pretendentes.');
INSERT INTO "item_descriptions" VALUES(18586,'pt','O comerciante que vendeu este colar lhe garantiu que ele era inofensivo. No entanto, você vive com a desagradável sensação de que ele pode fincar os dentes no seu pescoço a qualquer instante.');
INSERT INTO "item_descriptions" VALUES(18587,'pt','Apelidadas de dentes do mar de areia, estas botas só são usadas pelos nômades mais intrépidos e pelos Iops.');
INSERT INTO "item_descriptions" VALUES(18588,'pt','Esta capa ainda está viva e disposta a morder quem ousar tocá-la, o que faz com que ela seja muito popular entre as celebridades que detestam contato com fãs.');
INSERT INTO "item_descriptions" VALUES(18589,'pt','Este anel está impregnado com a personalidade do Ver Medo, por isso incita seu dono a usá-lo não no dedo, mas sim em outro lugar.');
INSERT INTO "item_descriptions" VALUES(18590,'pt','Quando o sol bater na janela do seu quarto, as pessoas ao seu redor ficarão ofuscadas pelo brilho do seu toucado.');
INSERT INTO "item_descriptions" VALUES(18591,'pt','Ambiciosos Enutrofs realizaram várias conquistas com o único objetivo de obter uma cabeleira tão farta quanto esta.');
INSERT INTO "item_descriptions" VALUES(18592,'pt','Tal Kasha não suportava que pisassem em seus pés, por isso suas sandálias evoluíram até ficarem assim.');
INSERT INTO "item_descriptions" VALUES(18593,'pt','Estas botas foram estudadas para produzirem um barulho metálico a cada passo. O som estridente que elas provocam quando batem no chão de pedra da pirâmide é amplificado ao ecoar nos vastos corredores. Portanto, tudo leva a crer que, assim como os astrubianos, as Mumístikas adoram chamar a atenção.');
INSERT INTO "item_descriptions" VALUES(18594,'pt','Conta a lenda que este anel possui estranhos poderes, como por exemplo a capacidade de rodopiar sem a intervenção de quem o usa.');
INSERT INTO "item_descriptions" VALUES(18595,'pt','Este torque de ouro maciço serve essencialmente para ostentar riqueza na frente de geral.');
INSERT INTO "item_descriptions" VALUES(18596,'pt','Mussum-Rá está ficando gagá com a idade, por isso vive perdendo seu capuz, o que o obriga a roubar o das outras Mumístikas.');
INSERT INTO "item_descriptions" VALUES(18597,'pt','De acordo com um estudo recente, o símbolo nesta capa representaria um gnomo perneta de braços abertos.');
INSERT INTO "item_descriptions" VALUES(18598,'pt','Quem já enfrentou um Riseko sabe que esta tanga delimita a parte sã da parte atrofiada do monstro. Como você a usa na cintura, todo mundo sabe o que tem por baixo.');
INSERT INTO "item_descriptions" VALUES(18599,'pt','Os olhos de granada desta serpente são capazes de hipnotizar um Enutrof durante horas.');
INSERT INTO "item_descriptions" VALUES(18601,'pt','Quem inventou o nome desta varinha não estava com muita inspiração, assim como quem ficou encarregado de descrevê-la para os reles mortais.');
INSERT INTO "item_descriptions" VALUES(18604,'pt','Inicialmente, os cristais do Heqachado eram brancos, mas ficaram embebidos com o sangue das pessoas guiadas à base de heqachadadas pelo dono desta arma.');
INSERT INTO "item_descriptions" VALUES(18615,'pt','Este anel é oferecido aos jovens Kilorfs para que eles lambam as patas em vez de roerem as garras.');
INSERT INTO "item_descriptions" VALUES(18616,'pt','Os Kilorfs formavam uma enorme matilha, até que conflitos internos acabaram enfraquecendo-a. A matilha acabou se dividindo em diversas tribos independentes, que vivem rosnando umas paras as outras.');
INSERT INTO "item_descriptions" VALUES(18617,'pt','É a capa preferida dos Kilorfs exibicionistas que adoram mostrar sua pelagem aos desconhecidos.');
INSERT INTO "item_descriptions" VALUES(18621,'pt','Dizem que, ao usarem este chapéu, alguns velhos Kilorfs conseguem realizar a previsão do tempo para os próximos dez segundos.');
INSERT INTO "item_descriptions" VALUES(18622,'pt','Quando usado como chicote, este cinto fará com que você grite de prazer, seja você o chicoteador ou o chicoteado.');
INSERT INTO "item_descriptions" VALUES(18626,'pt','Alguém empurrou uma senhorinha em uma plantação de cactos? Não tem problema! Dógui irá correndo salvá-la para, em seguida, tornar-se seu herdeiro exclusivo.');
INSERT INTO "item_descriptions" VALUES(18639,'pt','Como todos os Awaws, você agora também poderá balançar o rabo em público sem ofender a moral e os bons costumes.');
INSERT INTO "item_descriptions" VALUES(18640,'pt','"Você viu o meu osso?" Essas foram as últimas palavras de uma devota de Iop a seu amigo durante uma visita ao templo Kilorf. Ninguém nunca descobriu se ela estava se referindo ao osso que acabara de encontrar ou ao molosso a quem tal osso pertencia.');
INSERT INTO "item_descriptions" VALUES(18659,'pt','Este escudo amarelo e poroso, mas absorvente, foi feito com os restos de uma criatura que morava em uma Mascaxi no fundo do mar.');
INSERT INTO "item_descriptions" VALUES(18660,'pt','Este escudo é uma réplica do troféu levado pelos ganhadores da famosa corrida de Dragoperus. Claro que ele não tem tanto prestígio quanto a taça original, mas, ainda assim, poderá evitar que você seja cortado ao meio durante um combate. Nada mau.');
INSERT INTO "item_descriptions" VALUES(18661,'pt','Este escudo, oriundo do vilarejo de Ardala, deve servir para evitar os golpes sujos e baixos.');
INSERT INTO "item_descriptions" VALUES(18662,'pt','Este escudo, oriundo do vilarejo de Fogodala, deve servir para evitar os golpes sujos e baixos.');
INSERT INTO "item_descriptions" VALUES(18663,'pt','Este escudo, oriundo do vilarejo de Terradala, deve servir para evitar os golpes sujos e baixos.');
INSERT INTO "item_descriptions" VALUES(18664,'pt','Este escudo de pedra é, na verdade, a cabeça de um Smagador esmagada pelo pé de um Minotoror. É a combinação perfeita entre cabeça grande e pés fedorentos.');
INSERT INTO "item_descriptions" VALUES(18665,'pt','Este escudo é claramente uma homenagem à capa do Bowis, que, por sua vez, é uma homenagem a uma famosa relíquia composta de três fragmentos triangulares. Mais uma história pra boi dormir.');
INSERT INTO "item_descriptions" VALUES(18666,'pt','Este escudo inútil, embora impressionante devido ao fedor que exala, será o companheiro de muitos jovens aventureiros.');
INSERT INTO "item_descriptions" VALUES(18667,'pt','O Tchuke usava este escudo para se proteger das inúmeras bolas de canhão que eram lançadas na direção dele. Alguns boatos loucos dizem que essas bolas de canhão eram, na verdade, seres vivos.');
INSERT INTO "item_descriptions" VALUES(18668,'pt','Por mais estranho que pareça, dizem que este escudo feito de madeira e pelos permite que os aventureiros mais leves voem por alguns instantes a fim de impressionar os adversários pela última vez antes de se estatelarem no chão feito jaca podre.');
INSERT INTO "item_descriptions" VALUES(18669,'pt','Este enorme escudo uma vez salvou o famoso aventureiro Klum de uma morte terrível: esmagado pelo peso de um Smagador que se apaixonou por ele. Até hoje, ninguém sabe se ele sobreviveu aos efeitos colaterais dessa história de amor com o Smagador.');
INSERT INTO "item_descriptions" VALUES(18670,'pt','Um jovem aventureiro queria se alistar na milícia de Bonta para defender os fracos e oprimidos. Embora tenha sido rejeitado por ser muito fraco, ele foi contatado por um alquimista de Amakna, que estava determinado a usá-lo como cobaia para testar uma de suas novas poções mágicas. O efeito foi imediato, e o jovem aventureiro transformou-se rapidamente em um verdadeiro guerreiro dotado de uma força extraordinária, mas também completamente estúpido. Na verdade, ele foi transformado em Iop. Ele encomendou este escudo, considerado indestrutível, e dali em diante ficou conhecido como Capitão Amakna (em homenagem ao ilustre Capitão Chafer, que desapareceu sob circunstâncias pra lá de suspeitas).');
INSERT INTO "item_descriptions" VALUES(18671,'pt','Você vai gostar tanto deste escudo que não vai mais querer se separar dele. Não se esqueça de tratar suas verrugas e furúnculos de vez em quando para evitar que ele se estrague.');
INSERT INTO "item_descriptions" VALUES(18672,'pt','Nem todos os Wabbits são criaturinhas inofensivas. Na verdade, todos os Wabbits são criaturas vis. Os mais bárbaros dentre eles gostam de esmagar Cenouwas com seus grandes escudos para fazer suco.');
INSERT INTO "item_descriptions" VALUES(18673,'pt','Um ilustre aventureiro colecionador passou a vida inteira em busca deste tipo de escudo. Segundo a lenda, se você conseguir reunir quatro escudos como este, terá uma vida melhor.');
INSERT INTO "item_descriptions" VALUES(18674,'pt','Se seu sonho sempre foi tornar-se um verdadeiro Diabrete, este escudo foi feito para você. Passado de geração em geração, ele permitirá que você roube os jovens aventureiros de Astrub sem se machucar.');
INSERT INTO "item_descriptions" VALUES(18675,'pt','Embora esteja esverdeado e fedorento, este escudo continua sendo a melhor proteção na hora de enfrentar as criaturas do Monte Kifed.');
INSERT INTO "item_descriptions" VALUES(18676,'pt','Antigamente, este escudo servia para proteger os lenhadores da queda das árvores. Com o tempo, começou a ser usado para outros fins e, hoje em dia, serve para proteger da queda dos inimigos, que às vezes têm a péssima mania de partir para cima de você sem avisar.');
INSERT INTO "item_descriptions" VALUES(18677,'pt','Este escudo protegerá você da chuva e da baba de sapo, além de informar a hora a seus adversários. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(18678,'pt','Este escudo protegerá você dos lançamentos de pedra e projeções de lama, além de informar a hora a seus adversários. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(18679,'pt','Este escudo protegerá você dos ventos dos seus adversários, além de informar-lhes a hora. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(18680,'pt','Este escudo protegerá você dos meteoritos e dos cuspidores de fogo, além de informar a hora a seus adversários. Muito útil para ajudá-los a cronometrar suas derrotas.');
INSERT INTO "item_descriptions" VALUES(18681,'pt','Este escudo é ideal para passar despercebido em Pandala e ser notado em todos os outros lugares. O melhor de tudo é que ele é revestido de pelos de Pandawas, que nunca provocam alergias. Sendo assim, você pode guardá-lo tranquilamente dentro da sua cueca de couro.');
INSERT INTO "item_descriptions" VALUES(18682,'pt','Se você se esconder atrás deste escudo, os aventureiros mais ingênuos poderão pensar que se trata de um Arvraknídeo e sair correndo. Os outros atacarão você na esperança de conseguir alguns âmbares.');
INSERT INTO "item_descriptions" VALUES(18683,'pt','Este magnífico escudo contém alguns achados do Mar Mota. Não apenas traz boa sorte, mas também pode ser usado como um frasco.');
INSERT INTO "item_descriptions" VALUES(18684,'pt','Este escudo de aparência incomum é coberto com uma cueca usada que pertencia a um Chafer. É, sem dúvida, a melhor maneira de mostrar aos seus adversários que você tem a intenção de infligir-lhes uma boa surra.');
INSERT INTO "item_descriptions" VALUES(18685,'pt','Originalmente, este escudo era usado como banco pelos Sadidas quando queriam descansar um pouco. Se dobrar os pés dele, este equipamento protegerá você de muitos ataques, mas não da zombaria dos seus adversários.');
INSERT INTO "item_descriptions" VALUES(18686,'pt','Quando seus aliados começarem a perder o fôlego ou quando você quiser dissipar os efeitos de um Vento de Pânico, este escudo poderá salvar a sua vida. Basta sacudi-lo vigorosamente em todas as direções, como se estivesse tentando acalmar um bebê barulhento.');
INSERT INTO "item_descriptions" VALUES(18687,'pt','Este escudo, oriundo do vilarejo de Akwadala, deve servir para evitar os golpes sujos e baixos.');
INSERT INTO "item_descriptions" VALUES(18688,'pt','O taberneiro da fábrica de cervejas Fogobuk, em Bonta, devia estar bastante entediado quando teve a brilhante ideia de equipar seus seguranças com esses escudos publicitários.');
INSERT INTO "item_descriptions" VALUES(18689,'pt','Este escudo é coberto de globos oculares para que seu dono possa olhar nos olhos dos adversários com mais facilidade.');
INSERT INTO "item_descriptions" VALUES(18690,'pt','Este escudo serve para lembrar seus adversários de que você cresceu nas Estepes de Sidimote. Parece que isso é o suficiente para assustá-los.');
INSERT INTO "item_descriptions" VALUES(18691,'pt','Este escudo defenderá você com unhas e dentes (principalmente dentes).');
INSERT INTO "item_descriptions" VALUES(18692,'pt','Este escudo só funciona quando usado de frente para o sol, para que sua enorme pedra preciosa possa ofuscar os adversários. Não funciona contra as abóboras zumbis ou criaturas cegas, porém perigosas.');
INSERT INTO "item_descriptions" VALUES(18693,'pt','Agora não há mais dúvidas: Bruce Bulgur é mesmo casca-grossa.');
INSERT INTO "item_descriptions" VALUES(18694,'pt','Cuidado com os espinhos.');
INSERT INTO "item_descriptions" VALUES(18695,'pt','Esta rodela de Cenouwa gigante pode absorver inúmeros ataques mágicos, mas não resistirá por muito tempo às mordidas dos Wabbits.');
INSERT INTO "item_descriptions" VALUES(18696,'pt','Se este âmbar se quebrasse durante um combate, a pequena Arakne imunda que está presa lá dentro há 53 anos provavelmente tentaria morder você.');
INSERT INTO "item_descriptions" VALUES(18697,'pt','Este escudo poderia ajudar você a voltar no tempo se seu sistema para voltar no tempo não estivesse quebrado.');
INSERT INTO "item_descriptions" VALUES(18698,'pt','A fechadura deste escudo é ideal para proteger você das chaves de braço.');
INSERT INTO "item_descriptions" VALUES(18699,'pt','Este escudo pode resistir a todos os ataques, exceto ao da arma usada para matar a criatura que achava que poderia se proteger com esta carapaça.');
INSERT INTO "item_descriptions" VALUES(18700,'pt','Uma versão muito mais barata e indigesta do mil-folhas, este escudo talvez simbolize as quatro estações, os quatro dedos da mão de um metalúrgico azarado ou ainda os quatro neurônios daqueles que acham que vão sobreviver só porque estão usando um escudo.');
INSERT INTO "item_descriptions" VALUES(18701,'pt','Este escudo, composto de um espelho muito frágil, não protegerá você por muito tempo, mas, se seu adversário quebrá-lo, ele terá sete anos de azar. Isso pode servir de consolo após uma derrota humilhante.');
INSERT INTO "item_descriptions" VALUES(18702,'pt','Embora tenha sido projetado para proteger o crânio, este chapéu era usado como escudo por um aventureiro cabeça-dura.');
INSERT INTO "item_descriptions" VALUES(18703,'pt','Quando faz muito calor, este escudo se abre e libera um líquido fedorento. É a natureza em todo o seu esplendor.');
INSERT INTO "item_descriptions" VALUES(18709,'pt','Você pode usar a hélice deste escudo para despentear seus adversários e, assim, ganhar vantagem para realizar um ataque surpresa.');
INSERT INTO "item_descriptions" VALUES(18710,'pt','Este escudo é única coisa que impede o Chafer de Infantaria de desmoronar durante o combate. São os ossos do ofício.');
INSERT INTO "item_descriptions" VALUES(18711,'pt','Não faça de conta que compreende o que o artesão quis expressar por meio desta obra.');
INSERT INTO "item_descriptions" VALUES(18712,'pt','Infelizmente, este escudo não tem gostinho de mel, só de derrota iminente.');
INSERT INTO "item_descriptions" VALUES(18713,'pt','O formato deste escudo permite recolher facilmente as lágrimas de Crocodyl dos adversários após a sua vitória.');
INSERT INTO "item_descriptions" VALUES(18714,'pt','O artesão que criou este escudo queria chamá-lo de "A flor do macho", mas foi impedido pela censura local.');
INSERT INTO "item_descriptions" VALUES(18715,'pt','Este escudo foi concebido para ser usado nas costas. Algumas pessoas o utilizam para proteger o traseiro, enquanto outras preferem usá-lo para virar as costas ao menor sinal de perigo.');
INSERT INTO "item_descriptions" VALUES(18718,'pt','Este escudo foi concebido por Ary Stotles. Embora não proteja você da morte certa, ele dará belas curvas à sua silhueta.');
INSERT INTO "item_descriptions" VALUES(18774,'pt','Dentre os inúmeros troféus do Conde Razof, o javali cujos restos mortais estão expostos neste cinto tem um lugar especial: foi a primeira vítima dele. Era um javali muito agressivo que aterrorizava os camponeses nos arredores de Bonta.');
INSERT INTO "item_descriptions" VALUES(18775,'pt','Os caçadores que chegaram à ilha da Conchita não esperavam tamanho espetáculo. Alguns tiveram uma overdose de cores e precisaram ir embora rapidamente. Já o Conde Razof acabou se acostumando com todas essas cores vivas a ponto de integrá-las ao seu guarda-roupa pessoal.');
INSERT INTO "item_descriptions" VALUES(18776,'pt','Por quem os sinos dobram? O Conde Razof parece conhecer a resposta.');
INSERT INTO "item_descriptions" VALUES(18777,'pt','Esta capa simboliza a loucura dos Caçamadores, prisioneiros de sua própria paixão: a caça.');
INSERT INTO "item_descriptions" VALUES(18778,'pt','Alguns técnicos usam estes sapatos para fazer o que chamam de "faxina".');
INSERT INTO "item_descriptions" VALUES(18779,'pt','Como os Caçamadores não são muito sensíveis, eles colocam este amuleto pouco antes de desferir o golpe fatal em sua presa.');
INSERT INTO "item_descriptions" VALUES(18780,'pt','Nada sutis, os Carnarghs costumam usar o moedor para acalmar os nervos.');
INSERT INTO "item_descriptions" VALUES(18808,'pt','Este cinto de magma foi adotado em muitos regimes por ser capaz de queimar gorduras sem exigir o menor esforço.');
INSERT INTO "item_descriptions" VALUES(18853,'pt','Graças a esta espada, você não precisará mais de tochas nem de fogueiras. Se desejar assar carne ou legumes, basta empalá-los.');
INSERT INTO "item_descriptions" VALUES(1019044,'pt','Sua personalidade atroz não tem desculpas, mas você não consegue ficar bravo com ele por muito tempo e sempre acaba enchendo-o de beijos toda vez que ele apronta uma.');
INSERT INTO "item_descriptions" VALUES(19075,'pt','O que seria de um Vampyro sem sua dose de baile de máscaras? O de Dezist parece estar durando um pouco mais do que o normal: já faz muitos anos que Anerrais se recusa a tirar a fantasia.');
INSERT INTO "item_descriptions" VALUES(19076,'pt','Esta capa se parece muito com um Prespic, então você poderá ter dificuldade de encontrar companheiros de aventura se decidir usá-la.');
INSERT INTO "item_descriptions" VALUES(19077,'pt','Alguns Carniçais, em um momento de lucidez, podem atacar seu mestre de uma hora para a outra. Anerrais criou este escudo para se defender nesse tipo de situação, mas isso nunca deu muito certo. Até hoje, o objeto só serviu para nocautear as criaturas.');
INSERT INTO "item_descriptions" VALUES(19078,'pt','Este anel bota a língua pra fora quando você está com fome. Ou seja, ele está sempre com a língua pra fora.');
INSERT INTO "item_descriptions" VALUES(19079,'pt','A expressão "pé frio" nunca fez tanto sentido.');
INSERT INTO "item_descriptions" VALUES(19080,'pt','Este escudo pertenceu a Pedro Álvares Carniçal. Era um Carniçal corajoso, que navegou muito e descobriu uma nova terra, do outro lado do ossoano. O que ninguém sabe é que, no meio do caminho, ele decidiu organizar um motim contra os Vampyros que governavam as naus.
Pedro Álvares Carniçal conseguiu afogar os inimigos em alto-mar. Quando chegou ao novo mundo, pediu para Pero Vaz de Carninha escrever uma carta relatando o ocorrido ao Conde Crápula, na época chefe supremo dos Vampyros.');
INSERT INTO "item_descriptions" VALUES(19081,'pt','Os Scorbutos podem até ser os monstros mais bem armados que há, mas, paradoxalmente, este capacete protege você no único lugar em que eles são vulneráveis: a cabeça.');
INSERT INTO "item_descriptions" VALUES(19082,'pt','Esta capa se fixa nas suas costas, o que explica a cor dela.');
INSERT INTO "item_descriptions" VALUES(19083,'pt','Alguns eruditos se reúnem regularmente para classificar os venenos em função do grau de perigo, que pode ir de "um pouco mortal" a "mortal como a Mortfataw". Para isso, eles se baseiam na densidade dos fantasmas presentes ao redor das fontes desses diferentes venenos. De acordo com esses dados, o veneno de Scorbuto foi considerado "um pouco muito mortal". Usar este amuleto pode significar duas coisas: ou você não está nem aí ou vai entender o significado dessa classificação em breve.');
INSERT INTO "item_descriptions" VALUES(19084,'pt','A semelhança deste escudo com o do Capitão Amakna não vai além da aparência: o ilusionismo também tem limite.');
INSERT INTO "item_descriptions" VALUES(19085,'pt','Com estas botas, você descobrirá um dos segredos mais bem guardados por Couvefield: não é graças a elas que ele consegue levitar. Que decepção.');
INSERT INTO "item_descriptions" VALUES(19086,'pt','Que estranho... Ao colocar esta máscara, você fica com a aparência de um roedor. É, a magia é mesmo capaz de embelezar as coisas...');
INSERT INTO "item_descriptions" VALUES(19087,'pt','Para alguns, o hábito não faz o homem. Este ditado não se aplica aos Riktus.');
INSERT INTO "item_descriptions" VALUES(19088,'pt','Como acrobatas, os Riktus sabem que uma capa às vezes pode ser um empecilho fatal. Ainda assim, alguns não conseguem abrir mão delas, então a encurtam o máximo possível para limitar os riscos.');
INSERT INTO "item_descriptions" VALUES(19089,'pt','Riktus, divertir e divertir-se sem parar: este é o seu lema.');
INSERT INTO "item_descriptions" VALUES(19090,'pt','Não se deixe enganar pelo ar indiferente e o olhar vazio do Milobandido, pois ele deixa todas caidinhas: tanto as Milonokes quanto as suas costelas.');
INSERT INTO "item_descriptions" VALUES(19091,'pt','Não importam os olhares e preconceitos dos outros, você pode escolher usar esta pele de Milobandido como símbolo de rebeldia: ser ridicularizado só vai deixar você mais forte. Talvez.');
INSERT INTO "item_descriptions" VALUES(19092,'pt','Um ecossistema inteiro parece ter se desenvolvido em torno desses pelos. Cuide bem deles!');
INSERT INTO "item_descriptions" VALUES(19093,'pt','Em Dezist, caçar Carniçais é um pega pra cá pá geral.');
INSERT INTO "item_descriptions" VALUES(19096,'pt','Quando um Carniçal começa a fazer perguntas existenciais, ele costuma ser golpeado na cabeça com este martelo até voltar ao normal.');
INSERT INTO "item_descriptions" VALUES(19105,'pt','A criação desta espada se situa entre a invenção da tocha e da lanterna elétrica.');
INSERT INTO "item_descriptions" VALUES(19116,'pt','Este escudo não protegerá você da sua própria estupidez.');
INSERT INTO "item_descriptions" VALUES(19139,'pt','Mãozinha é uma mão inteligente capaz de pensar, escrever e agir sozinha. Costuma ser muito prestativa. Dizem que, antigamente, ela trabalhava na casa de uma prestigiosa família de Dezist, os Dadams. No entanto, a maneira como Mãozinha era tratada por eles, que não pode ser descrita aqui por motivos de decoro, acabou obrigando-a a fugir para encontrar um novo proprietário menos doentio. Acabou sobrando para você, mas aposto que não é melhor que os Dadams. Que fim trágico teve a Mãozinha.');
INSERT INTO "item_descriptions" VALUES(19165,'pt','Se você acha que este item se parece com a Máscara do Pesadelo de Nataw, é porque ele foi criado pelo mesmo artesão: Jack, o Sram. Esqueleto traiçoeiro, frigostiano excêntrico e trapaceiro azarado, Jack tinha muitas facetas. Isso talvez explique o poder excepcional que possuem as máscaras mortuárias dele: o poder de permitir que um vivo entre no reino dos mortos.');
INSERT INTO "item_descriptions" VALUES(19241,'pt','Este amuleto é um símbolo de coragem e bravura. Bom, isso é o que certos eruditos pensam.');
INSERT INTO "item_descriptions" VALUES(19242,'pt','Estas botas de pedra são perfeitas para os combates, desde que você tenha força suficiente nas pernas para levantá-las.');
INSERT INTO "item_descriptions" VALUES(19243,'pt','Esta capa tem uma espécie de cinto integrado. Dessa maneira, você pode amarrá-la ao redor do quadril para impedir que seus inimigos o agarrem para tentar derrubá-lo.');
INSERT INTO "item_descriptions" VALUES(19244,'pt','Este amuleto é um símbolo de coragem e bravura. Bom, isso é o que certos eruditos pensam.');
INSERT INTO "item_descriptions" VALUES(19245,'pt','Estas botas de pedra são perfeitas para os combates, desde que você tenha força suficiente nas pernas para levantá-las.');
INSERT INTO "item_descriptions" VALUES(19246,'pt','Esta capa tem uma espécie de cinto integrado. Dessa maneira, você pode amarrá-la ao redor do quadril para impedir que seus inimigos o agarrem para tentar derrubá-lo.');
INSERT INTO "item_descriptions" VALUES(19247,'pt','Será que essas asas foram estrategicamente colocadas ali para mandar uma mensagem? Cabe a você ser digno delas.');
INSERT INTO "item_descriptions" VALUES(19248,'pt','Às vezes, basta dar uma olhada nos sapatos de uma pessoa para saber com quem estamos lidando. O que dizem esses aqui?');
INSERT INTO "item_descriptions" VALUES(19249,'pt','Se você ainda não escolheu sua fantasia para o próximo Karnaval, esta é uma boa opção.');
INSERT INTO "item_descriptions" VALUES(19250,'pt','Será que essas asas foram estrategicamente colocadas ali para mandar uma mensagem? Cabe a você ser digno delas.');
INSERT INTO "item_descriptions" VALUES(19251,'pt','Às vezes, basta dar uma olhada nos sapatos de uma pessoa para saber com quem estamos lidando. O que dizem esses aqui?');
INSERT INTO "item_descriptions" VALUES(19252,'pt','Se você ainda não escolheu sua fantasia para o próximo Karnaval, esta é uma boa opção.');
INSERT INTO "item_descriptions" VALUES(19253,'pt','Leve e discreta, esta capa é ideal para as missões de espionagem, principalmente quando é preciso se esconder na neve.');
INSERT INTO "item_descriptions" VALUES(19254,'pt','Com este capuz, você poderá preservar seu anonimato. E, assim, roubar dos ricos para dar aos pobres sem ser reconhecido.');
INSERT INTO "item_descriptions" VALUES(19255,'pt','Este amuleto costuma ser usado pelos espiões de Bonta. Mas qualquer pessoa pode conseguir um: é uma boa maneira de afastar as suspeitas.');
INSERT INTO "item_descriptions" VALUES(19256,'pt','Leve e discreta, esta capa é ideal para as missões de espionagem, principalmente quando é preciso se esconder no escuro.');
INSERT INTO "item_descriptions" VALUES(19257,'pt','Com este capuz, você poderá preservar seu anonimato. E, assim, roubar dos pobres para dar aos ricos sem ser reconhecido.');
INSERT INTO "item_descriptions" VALUES(19258,'pt','Este amuleto costuma ser usado pelos espiões de Brakmar. Mas qualquer pessoa pode conseguir um: é uma boa maneira de afastar as suspeitas.');
INSERT INTO "item_descriptions" VALUES(19259,'pt','Muitas vezes ameaçada de destruição, a cidade branca está sempre precisando de guerreiros, sacerdotes e espiões para protegê-la. Por trás deste escudo se esconde um desses bontarianos dispostos (um dia, quem sabe) a pôr a vida em risco por sua cidade.');
INSERT INTO "item_descriptions" VALUES(19260,'pt','Às vezes destruída, às vezes reconstruída, a cidade negra está sempre precisando de guerreiros, sacerdotes e espiões para protegê-la. Por trás deste escudo se esconde um desses brakmarianos dispostos (um dia, quem sabe) a pôr a vida em risco por sua cidade.');
INSERT INTO "item_descriptions" VALUES(19261,'pt','Dizem que parte do poder do Dofus Opalino está concentrada neste amuleto. É um ótimo argumento de venda!');
INSERT INTO "item_descriptions" VALUES(19262,'pt','Ilyzaelle é tão carismática que alguns cavaleiros se ofereceram espontaneamente para servi-la. Este é o caso, principalmente, dos desconhecidos cavaleiros do Dozíaco: os melhores dentre eles vestiam uma armadura dourada para, segundo diziam, imitar a da Ilyzaelle.');
INSERT INTO "item_descriptions" VALUES(19263,'pt','O artesão que forjou este escudo parece ter incrustado nele uma simples opala em vez do Dofus dos Reis.');
INSERT INTO "item_descriptions" VALUES(19264,'pt','Você sabia que os Almardentes tentam possuir os corpos dos mortais? Provavelmente não, senão não estaria usando uma Aliança de Almardente.');
INSERT INTO "item_descriptions" VALUES(19265,'pt','Já que não conseguiram possuir seu corpo, dois Almardentes tentaram possuir esses sapatos. Eles parecem felizes.');
INSERT INTO "item_descriptions" VALUES(19266,'pt','É preciso muito mais do que isso para parecer tão ameaçador quanto um Almardente, mas já é alguma coisa.');
INSERT INTO "item_descriptions" VALUES(19267,'pt','Se você não sabe manejar uma lança direito, pode tentar usá-la como se fosse um bastão.');
INSERT INTO "item_descriptions" VALUES(19268,'pt','Ilyzaelle raramente usa essas adagas no combate. Ela prefere usá-las como facas.');
INSERT INTO "item_descriptions" VALUES(19269,'pt','Parece que esta espada está possuída por um Kemalma. Sendo assim, tome cuidado ao manipulá-la e não se esqueça de usar luvas para evitar entrar em contato com o Almardente.');
INSERT INTO "item_descriptions" VALUES(19270,'pt','Corrompido pelas energias vindas de Externam, este arco está ligado ao reino dos mortos. Tanto é que, se uma das flechas atingir o alvo, é bem provável que ele vá parar lá!');
INSERT INTO "item_descriptions" VALUES(1019286,'pt','Pacastor foi treinado para a guerra desde pequeno. Com uma única mordida, ele é capaz de abrir uma garrafa de cerveja ou a cabeça de um brakmariano.');
INSERT INTO "item_descriptions" VALUES(1019291,'pt','Papólux foi treinado para a guerra desde pequeno. Com uma simples chifrada, ele é capaz de fazer espetinho de carne para churrasco ou de bontariano.');
INSERT INTO "item_descriptions" VALUES(19398,'pt','Apesar do aspecto insólito, este Dofus é um autêntico ovo de dragão. Seria um desperdício não aproveitá-lo. Ele vai aquecer você nas longas noites de inverno e, no verão, vai assar a carne do churrasco. Mas procure não passar muito perto de montes de feno ou pilhas de lenha seca para não ser confundido com um piromaníaco perigoso.');
INSERT INTO "item_descriptions" VALUES(19415,'pt','Estas luvas foram planejadas para realizar coletas precisas, mas não são adequadas ao combate.');
INSERT INTO "item_descriptions" VALUES(19482,'pt','Com esta espada nascida do martelo divino de Gobanos, você pode usar o poder do Necrônix para transformar os Nantamortos em pedra.');
INSERT INTO "item_descriptions" VALUES(19531,'pt','Originário dos vulcões de Sidimote, este Awaw de magma vem de uma longa linhagem de cérberos criados por Kilorfs. Algumas lendas dizem que era necessário sacrificar jovens almas inocentes para atiçar sua ferocidade, mas isso mudou hoje.');
INSERT INTO "item_descriptions" VALUES(19585,'pt','Além de ter fogo no rabo, você vai ficar com fogo nos pés.');
INSERT INTO "item_descriptions" VALUES(19586,'pt','Seu olhar de brasa vai derreter qualquer um, e seus inimigos aprenderão a não brincar com fogo.');
INSERT INTO "item_descriptions" VALUES(19589,'pt','Esta capa ignifugada revela todo o seu potencial no calor da inação.');
INSERT INTO "item_descriptions" VALUES(19590,'pt','No verso deste amuleto, está escrito o seguinte provérbio: "Se acender uma vela para o seu Deus, acenda duas para Rushu."');
INSERT INTO "item_descriptions" VALUES(19591,'pt','Com esta bolsa, será facílimo se comunicar por sinais de fumaça. Só tome cuidado: onde há fumaça, há fogo.');
INSERT INTO "item_descriptions" VALUES(19592,'pt','Com a sola metálica destes tamancos, você poderá deslizar em tudo quanto é superfície e soltar faíscas que vão satisfazer seus instintos piromaníacos mais primitivos.');
INSERT INTO "item_descriptions" VALUES(19593,'pt','Mais perigoso que uma bola de fogo e mais assustador que ferramentas comuns, este machado vai sugar toda a coragem dos seus adversários.');
INSERT INTO "item_descriptions" VALUES(19594,'pt','Para quebrar crânios ou nozes, basta usar a Açoclava.');
INSERT INTO "item_descriptions" VALUES(19595,'pt','Com este capacete, talvez você finalmente ponha a cabeça no lugar.');
INSERT INTO "item_descriptions" VALUES(19596,'pt','O coureiro responsável por esta maravilha só manifestava todo o seu potencial quando trabalhava com prazos apertados. Seu ditado favorito, "Deixe para amanhã o que você pode fazer hoje", ainda não é completamente compreendido.');
INSERT INTO "item_descriptions" VALUES(19597,'pt','Ele emite um calor terrível. Mantenha fora do alcance dos anões.');
INSERT INTO "item_descriptions" VALUES(19598,'pt','Este escudo reflete as luzes. Então não procure enxergar o seu reflexo nele: assim como o de Solar, o seu não aparece.');
INSERT INTO "item_descriptions" VALUES(19599,'pt','Guardiões de calabouços são os que mais cantam de galo e os que menos matam.');
INSERT INTO "item_descriptions" VALUES(19600,'pt','Se encostar o ouvido neste búzio gigante, talvez você escute a ressaca do mar Frodita.');
INSERT INTO "item_descriptions" VALUES(19601,'pt','Por incrível que pareça, este bolo indescritível de espuma e corais em decomposição não fede. No Mundo dos Doze, isso é tão surpreendente que merece menção.');
INSERT INTO "item_descriptions" VALUES(19602,'pt','A costura é reforçada, e o material é tão macio por dentro quanto por fora. Depois de suja, basta virá-la do avesso e usá-la mais uma vez.');
INSERT INTO "item_descriptions" VALUES(19603,'pt','"Confortáveis por dentro, espinhentas por fora." Lembram uma pessoa que fez você sofrer muito, mas deixou saudades mesmo assim.');
INSERT INTO "item_descriptions" VALUES(19604,'pt','Difícil saber de que lado é... Dentões e orelhinhas virados para cima ou para baixo? Um dilema que vai fazer você passar as longas noites de inverno em claro.');
INSERT INTO "item_descriptions" VALUES(19605,'pt','O artesão que criou esta varinha usou algumas gotas de espuma, uma pitada de recursos em decomposição, um punhado de má-fé e um pedaço de boa vontade.');
INSERT INTO "item_descriptions" VALUES(19606,'pt','Esta lança mágica foi encantada com um poderoso feitiço capaz de transformar tripas em doce de cevada e alcachofra cozida em marshmallow. Maldição para os paladares apurados, bênção para as gerações mais jovens.');
INSERT INTO "item_descriptions" VALUES(19607,'pt','Esta capa pertenceu a um temido criminoso aquático cujos pecados foram perdoados.');
INSERT INTO "item_descriptions" VALUES(19608,'pt','Ele vai deixar você famoso, mas só entre os crustáceos.');
INSERT INTO "item_descriptions" VALUES(19609,'pt','Segundo uma tradução meio livre dos escritos antigos, este estranho colar pertenceu a um padre penhorante, participativo a ponto de se privar de tudo para passar seu conhecimento aos pupilos que moravam nos prados perto dele.');
INSERT INTO "item_descriptions" VALUES(19610,'pt','"A vantagem destas botas de peixe morto é que elas disfarçam o fedor dos meus pés." Realmente, o que não falta no fundo do mar é poeta.');
INSERT INTO "item_descriptions" VALUES(19622,'pt','Com este anel, você não poderá a todos governar, mas vai se sentir mais poderoso. Já é um começo.');
INSERT INTO "item_descriptions" VALUES(19629,'pt','Criado por Rathrosk, o dragão cinza, este ovo é um enigma. Por mais que não se equipare a um Dofus Primordial, ele aparenta ser mais antigo que tudo... Guarde-o com muito cuidado. Afinal de contas, só as Moirnas e o deus Xelor sabem o que o futuro reserva.');
INSERT INTO "item_descriptions" VALUES(19637,'pt','Este mangual é mais eficaz para bater em gente chata do que para malhar cereais.');
INSERT INTO "item_descriptions" VALUES(19639,'pt','Dá para ver o histórico dos combates de um aventureiro pelos golpes recebidos por este escudo.');
INSERT INTO "item_descriptions" VALUES(19641,'pt','Muito usada antigamente em cerimônias religiosas, esta veste serve para qualquer coisa hoje.');
INSERT INTO "item_descriptions" VALUES(19676,'pt','O metal desta picareta parece tão duro quanto diamante. Eis uma ferramenta que pode quebrar praticamente qualquer coisa.');
INSERT INTO "item_descriptions" VALUES(19976,'pt','Este cinto é forrado com os pelos de jovens Brutanões escolhidos para serem doadores voluntários por livre e espontânea pressão.');
INSERT INTO "item_descriptions" VALUES(19977,'pt','Adaptado à morfologia dos Brutanões, este anel cabe em qualquer dedo gordinho, tanto da mão quanto do pé.
Você pode usá-lo como pulseira.');
INSERT INTO "item_descriptions" VALUES(19978,'pt','Com um peso desses na cachola, fica difícil não baixar a cabeça.');
INSERT INTO "item_descriptions" VALUES(19979,'pt','Barba nas costas consegue ser ainda menos prático que olhos na nuca.');
INSERT INTO "item_descriptions" VALUES(19980,'pt','Nada melhor que uma barba postiça para disfarçar a cara de pau.');
INSERT INTO "item_descriptions" VALUES(19981,'pt','Cabeça de machado ou âncora miudinha? Tanto faz. O importante é que seu pescoço vai xingar o Brutanão que confeccionou esta "joia".');
INSERT INTO "item_descriptions" VALUES(19982,'pt','Graças às anteninhas deste capacete, você poderá decifrar o complexo idioma dos Vulkórnios, formado pelos vocábulos Vrrr, Brrr, Trrr, Krrr – comer, comer, comer e comer, respectivamente.');
INSERT INTO "item_descriptions" VALUES(19983,'pt','As grandes antenas na parte de trás do cinto servem de receptores de feromônios.
Elas se agitarão quando uma entidade de patrimônio genético compatível com o seu se aproximar.
Prepare-se para muito climão!');
INSERT INTO "item_descriptions" VALUES(19984,'pt','Feito por um antigo criador de Vulkórnios, este amuleto ainda tem um delicioso cheirinho de estábulo, uma mistura de estrume, suor e trabalho mal remunerado.');
INSERT INTO "item_descriptions" VALUES(19985,'pt','As asinhas batem rapidamente para maximizar sua capacidade de fazer cócegas nas pessoas que você acaricia. Para alguns, instrumento de tortura. Para outros, de prazer... Enquanto não forma uma opinião, você pode usá-lo em si mesmo.');
INSERT INTO "item_descriptions" VALUES(19986,'pt','A antena serve de descanso para flecha, o chifre serve para impressionar os adversários, e as asas não servem para nada. Não se esqueça de puxar a corda com firmeza para disparar bem.');
INSERT INTO "item_descriptions" VALUES(20210,'pt','A espada lendária que Grugalorasalar ofereceu a seu filho agora está em suas mãos. Mas, embora a espada que você tirou da pedra seja realmente a Crocálibur, ela não é nem sombra do que já foi... É sua missão devolver-lhe seus poderes e sua história.');
INSERT INTO "item_descriptions" VALUES(20213,'pt','Depois de muito esforço, você finalmente tem em mãos a espada do imperador que quase conquistou o mundo em um passado longínquo. Contudo, não se esqueça do trato que fez com Vulkaragnar: depois que obter o Dofus Ébano, você deverá devolver a Crocálibur a seu criador. Não se pode ter tudo nessa vida...');
INSERT INTO "item_descriptions" VALUES(20286,'pt','Quando o dragão Rathrosk criou o Dofus Prateado, na época em que o Mundo dos Doze ainda nem existia, aconteceu um milagre: a primeira fênix ressurgiu das próprias cinzas. O tempo foi passando, os deuses foram desaparecendo e as estrelas, morrendo. Hoje, o ovo que você tem em mãos cintila como outrora... Como um amor perdido cuja chama arde novamente.');
INSERT INTO "item_descriptions" VALUES(20353,'pt','"Havia milhares de Crocodyls a algumas centenas de kametros das portas da cidade. Nós estávamos preparados para o ataque, a guarda inteira estava reunida em frente à grande porta e as máquinas de guerra estavam instaladas sobre as muralhas. A visão do gigantesco exército de répteis já era aterrorizante por si só, mas o pior foi quando percebemos. Crocoburio estava em meio aos soldados, muito mais alto que todos eles, brandindo sua espada amaldiçoada em nossa direção. Quando a massa verde começou a marchar, nós sentimos um calafrio. Assim soubemos que a batalha que viria a acontecer seria terrível."

- Um soldado bontariano.');
INSERT INTO "item_descriptions" VALUES(20354,'pt','Este item é lendário. Você, não.');
INSERT INTO "item_descriptions" VALUES(20355,'pt','Este item é lendário. Você, não.');
INSERT INTO "item_descriptions" VALUES(20356,'pt','"Antigamente, não existiam cofres. Os Enutrofs escondiam as economias na meia ou embaixo do colchão, os esquilos guardava nozes no oco das árvores, os dragões empilhavam suas moedas de ouro em cavernas escuras e úmidas. Então a Sociedade criou a rede bancária. Uma verdadeira revolução! Finalmente os dozeanos podiam deixar seus bens protegidos atrás de portas blindadas. Claro que sempre tem um Ladino para explodir bombas e traficantes de kamas para ludibriar aventureiros gananciosos, mas não é nada muito sério. Basta fazer um bom seguro."

- Buhorado');
INSERT INTO "item_descriptions" VALUES(20357,'pt','"Todo Feca que vai ao combate precisa levar um escudo. Mas a melhor proteção contra a adversidade, a melhor muralha contra todos os que querem nos aniquilar, é a união. Mercenários! Chegou a hora de deixarmos nossas diferenças de lado e nos reunirmos sob um só estandarte. Astrub é mais que um burgo mercantil fundado por um bando de bandoleiros que se acomodou. Astrub é também uma cidade antiga, com patrimônio e cultura. Astrub é uma nação! Hoje, membros do conselho, vocês elegerão um novo líder. Eu oficializei minha candidatura. Poderei contar com a sua confiança? A escolha é de vocês."

- Fallanster, chefe do Conselho de Astrub');
INSERT INTO "item_descriptions" VALUES(20358,'pt','"A morte é um mal necessário, mas, pelo sim, pelo não, é preferível que ela leve outra pessoa, não é? Foi por isso que eu forjei esse escudo. Ele é indestrutível, inesgotável e inoxidável. Detém todos os golpes que fariam você passar para o outro lado. Apesar das dimensões imponentes, é leve e fácil de manusear. Além disso, seu aspecto macabro impressionará os adversários: os mais covardes não suportarão o negrume abissal das órbitas vazias e fugirão aos berros. Ainda não se convenceu? Então vamos demonstrar na prática. Sargento Koksis, é com você."

- Um artesão que preferiu se manter no anonimato');
INSERT INTO "item_descriptions" VALUES(20359,'pt','"Eles acham que nós somos pequenos e fracos. Zombam dos nossos costumes, das nossas tradições ancestrais. Eles nos tomam por bárbaros sujos, vorazes e incultos. Acham que vamos nos contentar em ficar nas nossas minas, cavando no escuro como Gwaimos? Vão ter uma surpresa! Eu vou mostrar quem são os Brutanões. Vou queimar suas fazendas e colheitas. Vou rapar seus cabelos, suas sobrancelhas, suas cidades. Vou tosar seus Papatudos. Vou tomar seu ouro, esvaziar as barricas, rasgar os estandartes. Eu sou o rei debaixo da montanha... e, em breve, serei o rei do mundo!"

- Bram Barba-Mundo');
INSERT INTO "item_descriptions" VALUES(20360,'pt','"Quando uma alma jovem deixa o templo de Incarnam, ela sonha com a vida que a espera lá fora. Uma vida de aventuras palpitantes, de realizações pessoais, de trocas enriquecedoras e de partilha com os outros. Ela já esqueceu quem foi. Talvez tenha reinado sobre um império do qual só resta pedra. Talvez tenha sido um humilde pastor que guardava um rebanho de Papatudos. O passado é insignificante quando olhamos para o futuro: as Águias Celestes cuidam para que cada ser possa recomeçar, sem temores nem arrependimentos, até seu destino se cumprir."

- Mestre Ganimede');
INSERT INTO "item_descriptions" VALUES(20361,'pt','"Desde pequeno, eu fui treinado para lutar contra dragões. Eu sou um cavaleiro, e cavaleiros exterminam os grandes lagartos cuspidores de fogo. É o que está escrito em todos os livros infantis, então só pode ser verdade! Qual não foi minha surpresa, então, quando conheci Bolgrot. Quem iria imaginar que ele se tornaria o meu melhor amigo? Não eu! Eu fui o primeiro a se surpreender. Quem diria? As aparências enganam... Já faz semanas que a gente está unha e carne. Mal posso esperar para apresentá-lo a Helsefina! Tenho certeza de que eles vão se dar bem."

- Rykke Errel, cavaleiro iop');
INSERT INTO "item_descriptions" VALUES(20362,'pt','"Enquanto nossas tropas se reuniam para enfrentar o exército da cidade sombria, eu subi ao pico da colina mais próxima para fazer uma última oração. Neste dia, muitos dozeanos morrerão. Eu me pergunto: toda essa violência é mesmo necessária? Será mesmo preciso sacrificar milhares de almas para que haja uma chance de a harmonia voltar a reinar? Mas o momento já não é para dúvidas e hesitação. Espírito da Balança, ilumine-me com a sua luz. Mostre-me o caminho de justiça que leva à paz. E se eu ficar frente a frente com a Açougueira de Brakmar... Dê-me forças para enfrentá-la para que a esperança renasça neste mundo."

- Jahash Jurgen');
INSERT INTO "item_descriptions" VALUES(20363,'pt','"Dizem que os primeiros lenhadores cruzavam Amakna de ponta a ponta sem sentir um pingo de cansaço. Eles calçavam botas encantadas pelas quatro guardiãs: com elas, atravessavam as terras em um piscar de olhos. De uma só pernada, as sentinelas de olhos penetrantes iam de uma fronteira a outra, das praias do mar Mota aos vales rochosos tomados por Bworks e Goblins. Ai de nós, o poder dessas botas milagrosas se esvaneceu quando as Quatro se retiraram... mas os batedores que têm a sorte de dispor de um par estão sempre um passo à frente dos inimigos do reino."

- Cornélia Largopasso');
INSERT INTO "item_descriptions" VALUES(20364,'pt','"Aproximem-se, novatos! Não fiquem no fundo, eu não vou me repetir. Antes de mais nada, saibam que só os mestres da ordem têm autorização para calçar as botas sagradas nas cerimônias oficiais pomposas. Vejam bem, tem que ser uma autoridade. Os eventuais transgressores serão pisoteados pelos condiscípulos e expulsos com um pontapé nos fundilhos. Todo mundo com escova de engraxate e cera de java? Ótimo! Façam fila e entrem na sala sem algazarra. Não quero ouvir um barulhinho de sola!"

- Bowis, grão-mestre do Bota-Fora');
INSERT INTO "item_descriptions" VALUES(20365,'pt','"Quando se é azarado, é muito tentador não fazer nada, ficar enclausurado em casa roendo as garras para não provocar uma catástrofe... Mas, já que a gente já tá zicado mesmo, é melhor aproveitar! É preciso ter audácia para não se deixar paralisar pela desdita. Nada como um pouco de ousadia para afastar o azar. Tentou fazer um negócio e se deu mal? Grande coisa! É só tentar de novo. É melhor errar por falta de sorte do que por falta de fibra. O importante é cair sempre de pé."

- Dodge, o Ecaflip');
INSERT INTO "item_descriptions" VALUES(20366,'pt','"A perda de um mestre é uma tragédia para seus discípulos. Quando Prosperus Elementor faleceu, todos os Huppermagos ficaram órfãos da noite para o dia. Como sobreviver ao vazio que ele deixou? Como transmitir um legado às novas gerações quando algumas perguntas permanecem sem resposta? Hoje, eu partirei para a ilha verdejante de Espetárida a fim de abrir uma porta para reencontrar nosso guia. Que a Balança penda em meu favor... e que o deus Xelor me conceda o tempo de que eu preciso para atingir meu objetivo."

- Lady Jhéssica');
INSERT INTO "item_descriptions" VALUES(20391,'pt','Comer o coração dos inimigos: prática selvagem do passado ou tradição ancestral que merece ser preservada? Utilizar estas facas em alguém é um bom ponto de partida para elaborar um recorte da questão.');
INSERT INTO "item_descriptions" VALUES(20463,'pt','As sandálias usadas pelos guerreiros melaztecas permitem manter os pés ao ar livre e caminhar sobre o sangue dos inimigos sem escorregar.');
INSERT INTO "item_descriptions" VALUES(20464,'pt','O tilintar das moedas de ouro que estão fixadas na ponta desta capa proporciona música às danças dos rituais melaztecas, incluindo o de sacrifício humano. Daí a dizer que esta capa banaliza o assassinato, é um pulo.');
INSERT INTO "item_descriptions" VALUES(20465,'pt','As máscaras são um elemento muito importante na cultura melazteca. Elas protegem o rosto, espantam os inimigos e espíritos maus e até identificam a função de um Melazteca na tribo: guerreiro, sacerdote, comerciante ou operário, por exemplo. Elas também podem ser usadas para decorar as paredes de casa de uma forma bem exótica, o que faz delas ótimos presentes para seus conhecidos que moram no continente.');
INSERT INTO "item_descriptions" VALUES(20833,'pt','As preocupações da sua vida de aventureiro parecem desaparecer quando você carrega este ovo de cacau maciço. Só nisso já se manifestam os efeitos do chocolate: você se sente reconfortado e, ao mesmo tempo, mais pesado.');
INSERT INTO "item_descriptions" VALUES(20848,'pt','Este cetro é capaz de aplacar a fome de quem o empunha. Se você brandi-lo na frente dos Waddicts, é bem provável que eles comecem a obedecer você.');
INSERT INTO "item_descriptions" VALUES(20850,'pt','De tanto pisar em chocolate, as solas destas botas estão todas lambuzadas e vão deixar pegadas por onde você for. Não é lá muito discreto...');
INSERT INTO "item_descriptions" VALUES(20851,'pt','Para conquistar um corpo de Iop, não tem nada melhor que este cinto, que vai compensar qualquer excesso chocolatístico.');
INSERT INTO "item_descriptions" VALUES(20852,'pt','Um anel peludo que vai aquecer o seu dedo.');
INSERT INTO "item_descriptions" VALUES(20924,'pt','Este amuleto tem um compartimento secreto no qual está escondida uma pepita de chocolate com alta concentração de cacau. Ela é usada pelos Chocomantes quando precisam reforçar seus poderes para uma luta, mas, como você não é iniciado em chocomancia, só vai lhe servir de lanchinho de emergência. Olha que é meio amargo, hein.');
INSERT INTO "item_descriptions" VALUES(20925,'pt','Como a chocomancia requer a ingestão de grandes quantidades de chocolate, os cintos clássicos acabam apertando muito a barriga dos praticantes e os impede de abrigar o precioso cacau. A elasticidade deste cinto é tão espantosa que, com ele, dá para se entupir de chocolate sem perder a calça.');
INSERT INTO "item_descriptions" VALUES(20926,'pt','Ninguém iria imaginar que um escudo comestível seria útil em combate, mas este aqui é muito resistente. Só espere o fim da luta para começar a comê-lo, senão talvez você nunca mais possa degustá-lo.');
INSERT INTO "item_descriptions" VALUES(20935,'pt','Esta espátula gigante é uma ferramenta de trabalho muito completa. Com ela, é possível preparar quantidades enormes de doces de chocolate deliciosos e, depois, fatiar sem dó nem piedade os gulosos que tentarem comer o seu bolo sem a sua permissão.');
INSERT INTO "item_descriptions" VALUES(20956,'pt','Usando esta máscara, você pode tentar fundar um culto baseado no consumo exagerado de chocolate. Cuidado para não ser desmascarado, senão você vai acabar sendo triturado feito uma reles fava de cacau pelos seus próprios fiéis.');
INSERT INTO "item_descriptions" VALUES(20981,'pt','Quem projetou este item não era muito esperto: para não ficar no (chocolate) escuro, é obrigatório comer uma das faces do capacete.');
INSERT INTO "item_descriptions" VALUES(20982,'pt','Fabricadas por dois irmãos, Aessi e Emierri, estas botas produzem um delicioso som crepitante achocolatado a cada passo que você dá.');
INSERT INTO "item_descriptions" VALUES(20983,'pt','Esta mochilinha fará você voltar à infância, relembrando aqueles maravilhosos momentos em que a sua mãe preparava deliciosos lanches, você pegava o caminho da escola feliz da vida e acabava tendo sua preciosa merenda roubada por crianças mais fortes que você... Quantas boas lembranças!');
INSERT INTO "item_descriptions" VALUES(20987,'pt','Você fecha os olhos e, de repente, os aromas achocolatados do ovo divino invadem suas narinas. Você leva, então, o objeto mítico aos seus lábios ingênuos, inebriado pela tentação de um prazer culinário desconhecido. Quando suas papilas são tomadas por uma onda de amargor, você aprende da pior forma possível que nem todas as essências divinas têm gosto bom.');
INSERT INTO "item_descriptions" VALUES(21009,'pt','Graças ao ar neste cilindro, você finalmente poderá parar um pouquinho para respirar.');
INSERT INTO "item_descriptions" VALUES(21010,'pt','Quando ligado a um cilindro de cronoxigênio, este escafandro possibilita que o portador volte no tempo sem medo de ter que fazer hora extra.');
INSERT INTO "item_descriptions" VALUES(21186,'pt','Este Dofus foi colocado por um dragão que decidiu permanecer anônimo. Mesmo os aventureiros mais sábios ainda se perguntam por quê.');
INSERT INTO "item_descriptions" VALUES(21223,'pt','Você ficará mais forte se equipar-se com este anel, mas também corre o risco de perder o dedo.');
INSERT INTO "item_descriptions" VALUES(21224,'pt','Este cinto foi criado por um estilista novato. Frustrado com sua falta de inspiração, ele arremessou algumas escamas e presas de Crocodyl, que compuseram este emaranhado tão singular ao caírem no chão. O estilista gostou tanto do resultado que, desde então, passou a seguir apenas este método para elaborar novas coleções.');
INSERT INTO "item_descriptions" VALUES(21225,'pt','As escamas de um Crocodyl são tão duras quanto a cabeça de um Iop. Este escudo revestido é um acessório indispensável para qualquer aventureiro que adore se atirar no meio da pancadaria sem pensar duas vezes.');
INSERT INTO "item_descriptions" VALUES(21226,'pt','A invenção destas botas é um pequeno passo para o sapateiro que as fabricou, mas um grande passo para os dozeanos que as usarão.');
INSERT INTO "item_descriptions" VALUES(21227,'pt','Dizem que, se você usar este colar em noites de lua cheia, transforma-se em Milobo.');
INSERT INTO "item_descriptions" VALUES(21228,'pt','Problema seu se gosta de usar anel no polegar, pois este anel só pode ser colocado no anular. Agora, tanto faz se é o da mão direita ou esquerda.');
INSERT INTO "item_descriptions" VALUES(21229,'pt','De tanto serem cutucados com vara curta por Torkelônia, a tartaruga arkelona, os crocuzkenhos decidiram fabricar réplicas exatas desta arma para impor respeito aos paspalhos que quisessem se aventurar pela ilha. O resultado nem sempre é fabuloso, mas o que conta é a intenção.');
INSERT INTO "item_descriptions" VALUES(21230,'pt','Evite cair de costas quando estiver usando esta carapaça, pois você corre o risco de nunca mais conseguir se levantar.');
INSERT INTO "item_descriptions" VALUES(21235,'pt','Dizem que dá para saber a idade de uma tartaruga arkelona pelo tamanho do chifre. Ao colocar este na cabeça, você não parecerá mais ter a idade que tem.');
INSERT INTO "item_descriptions" VALUES(21451,'pt','Esta prismaradita protegerá você da primeira flecha de um Iop recém-reconvertido em Cra.');
INSERT INTO "item_descriptions" VALUES(21452,'pt','Esta prismaradita protegerá você da primeira flecha de um Iop recém-reconvertido em Cra.');
INSERT INTO "item_descriptions" VALUES(21453,'pt','Esta prismaradita protegerá você da primeira flecha de um Iop recém-reconvertido em Cra.');
INSERT INTO "item_descriptions" VALUES(21506,'pt','Prender um bichinho fofinho em uma bola e mandá-lo para cima do seu adversário? A receita de uma grande franquia. Fica por sua conta.');
INSERT INTO "item_descriptions" VALUES(21507,'pt','Prender um bichinho fofinho em uma bola e mandá-lo para cima do seu adversário? A receita de uma grande franquia. Fica por sua conta.');
INSERT INTO "item_descriptions" VALUES(21508,'pt','Prender um bichinho fofinho em uma bola e mandá-lo para cima do seu adversário? A receita de uma grande franquia. Fica por sua conta.');
INSERT INTO "item_descriptions" VALUES(21509,'pt','Prender um bichinho fofinho em uma bola e mandá-lo para cima do seu adversário? A receita de uma grande franquia. Fica por sua conta.');
INSERT INTO "item_descriptions" VALUES(21510,'pt','Prender um bichinho fofinho em uma bola e mandá-lo para cima do seu adversário? A receita de uma grande franquia. Fica por sua conta.');
INSERT INTO "item_descriptions" VALUES(21711,'pt','Estas asas não vão levar você muito longe: elas só foram feitas para estragar a viagem de Ans, Fits e Crutz.');
INSERT INTO "item_descriptions" VALUES(21712,'pt','Este capacete foi criado com um único objetivo: impedir os Goblins de chegar à ilha de Moon. Se procurar outra utilidade, você vai se decepcionar.');
INSERT INTO "item_descriptions" VALUES(21878,'pt','Como uma coisa de aparência tão frágil vai conseguir capturar quatro monstros mais sinistros que um coveiro? Só há um jeito de saber... Equipe um apanhador de pesadelos antes de desafiar um Horladelo, senão pode acabar se arrependendo.');
INSERT INTO "item_descriptions" VALUES(21996,'pt','Esta prismaradita vai meter pressão. Cuidado para não perder a cabeça.');
INSERT INTO "item_descriptions" VALUES(21997,'pt','Esta prismaradita vai meter pressão. Cuidado para não perder a cabeça.');
INSERT INTO "item_descriptions" VALUES(21998,'pt','Esta prismaradita vai meter pressão. Cuidado para não perder a cabeça.');
INSERT INTO "item_descriptions" VALUES(21999,'pt','Esta prismaradita dá sorte! Vem bem a calhar. Depois da sua última aventura em Espetárida, você está precisando urgentemente.');
INSERT INTO "item_descriptions" VALUES(22000,'pt','Esta prismaradita dá sorte! Vem bem a calhar. Depois da sua última aventura em Espetárida, você está precisando urgentemente.');
INSERT INTO "item_descriptions" VALUES(22001,'pt','Esta prismaradita dá sorte! Vem bem a calhar. Depois da sua última aventura em Espetárida, você está precisando urgentemente.');
INSERT INTO "item_descriptions" VALUES(22002,'pt','Esta prismaradita é perfeita para os aventureiros lentos e rancorosos. Um pouco como você, na verdade.');
INSERT INTO "item_descriptions" VALUES(22003,'pt','Esta prismaradita é perfeita para aventureiros lentos e rancorosos. Um pouco como você, na verdade.');
INSERT INTO "item_descriptions" VALUES(22004,'pt','Esta prismaradita é perfeita para aventureiros lentos e rancorosos. Um pouco como você, na verdade.');
INSERT INTO "item_descriptions" VALUES(22005,'pt','Esta prismaradita é perfeita para aproximar você dos aventureiros que tentam abrir distância. Em suma, você sabe o segredo dos aventureiros pesados: a perseverança.');
INSERT INTO "item_descriptions" VALUES(22006,'pt','Esta prismaradita é perfeita para aproximar você dos aventureiros que tentam abrir distância. Em suma, você sabe o segredo dos aventureiros pesados: a perseverança.');
INSERT INTO "item_descriptions" VALUES(22007,'pt','Esta prismaradita é perfeita para aproximar você dos aventureiros que tentam abrir distância. Em suma, você sabe o segredo dos aventureiros pesados: a perseverança.');
INSERT INTO "item_descriptions" VALUES(22008,'pt','Esta prismaradita é um pouco como uma fonte da juventude, só que sem água... e sem fonte. Na verdade, ela também não rejuvenesce. É, não foi uma comparação muito boa.');
INSERT INTO "item_descriptions" VALUES(22009,'pt','Esta prismaradita é um pouco como uma fonte da juventude, só que sem água... e sem fonte. Na verdade, ela também não rejuvenesce. É, não foi uma comparação muito boa.');
INSERT INTO "item_descriptions" VALUES(22010,'pt','Esta prismaradita é um pouco como uma fonte da juventude, só que sem água... e sem fonte. Na verdade, ela também não rejuvenesce. É, não foi uma comparação muito boa.');
INSERT INTO "item_descriptions" VALUES(22011,'pt','Esta prismaradita dá a sensação de se estar sempre atrasado. Infelizmente, ela não explica seu atraso mental.');
INSERT INTO "item_descriptions" VALUES(22012,'pt','Esta prismaradita dá a sensação de se estar sempre atrasado. Infelizmente, ela não explica seu atraso mental.');
INSERT INTO "item_descriptions" VALUES(22013,'pt','Esta prismaradita dá a sensação de se estar sempre atrasado. Infelizmente, ela não explica seu atraso mental.');
INSERT INTO "item_descriptions" VALUES(22014,'pt','Esta prismaradita eleva o espírito do portador, mas não o faz tomar vergonha na cara. Dessa você escapou.');
INSERT INTO "item_descriptions" VALUES(22015,'pt','Esta prismaradita dará ao seu corpo o necessário para resistir às provações da vida de aventureiro.

Isto é uma pedra, favor não ingerir. Nossos produtos não são testados em Ecaflips e Kilorfs. Não contém álcool. Não contém óleo de palma.');
INSERT INTO "item_descriptions" VALUES(22016,'pt','Esta prismaradita vai deixar você com um ar insolente sem ter que abrir mão da sua situação privilegiada.');
INSERT INTO "item_descriptions" VALUES(22017,'pt','Esta prismaradita vai deixar você com um ar insolente sem ter que abrir mão da sua situação privilegiada.');
INSERT INTO "item_descriptions" VALUES(22018,'pt','Esta prismaradita vai deixar você com um ar insolente sem ter que abrir mão da sua situação privilegiada.');
INSERT INTO "item_descriptions" VALUES(22019,'pt','Esta prismaradita fará você passar por experiências loucas com o desaparecimento temporário. Imagine a cara de decepção da sua sogra, por exemplo, quando ela vir você reaparecer.');
INSERT INTO "item_descriptions" VALUES(22020,'pt','Esta prismaradita desencantadora é perfeita para você treinar no Koliseu depois de pegar pesado na noite anterior. Seu bafo de Porkasso inclusive vai ser um aliado no combate aproximado.');
INSERT INTO "item_descriptions" VALUES(22022,'pt','Esta prismaradita é perfeita para caracóis e lesmas. Não é uma metáfora.');
INSERT INTO "item_descriptions" VALUES(22023,'pt','Esta prismaradita protege os introvertidos de aglomerações.');
INSERT INTO "item_descriptions" VALUES(22024,'pt','Esta prismaradita vai cair no gosto daqueles aventureiros que são incapazes de tomar a iniciativa.');
INSERT INTO "item_descriptions" VALUES(22025,'pt','Esta prismaradita é um chumbo. Para uma coisinha tão pequena, é difícil de acreditar. Lembra certas pessoas.');
INSERT INTO "item_descriptions" VALUES(22027,'pt','Esta arma foi fortificada pelo sopro de um dragão para conseguir dobrar qualquer tipo de metal. O único problema é que ela só pode ser utilizada uma vez. Sendo assim, procure usá-la apenas como último recurso.');
INSERT INTO "item_descriptions" VALUES(22163,'pt','Uma picareta de aspecto rudimentar, mas que parece capaz de quebrar qualquer coisa, exceto, talvez, os maus hábitos.');
INSERT INTO "item_descriptions" VALUES(22186,'pt','Pérfida, calculista e manipuladora: Miséria está sempre um, dois ou até três passos à frente a fim de conseguir o que quer. A mentira é algo natural para ela, e sua inteligência só não é maior que sua cobiça.');
INSERT INTO "item_descriptions" VALUES(22187,'pt','Se eu quiser ostentar
qual é o problema?
Nosso imposto é poema
O dia da coleta

faz Miséria gamar
Pegar todos os recursos
e mais um pouco
É o imposto que compensa
Só coletor responsa
que vem pra ficar"


- Canção escrita por Emici Mêgui, o trovador preferido de Miséria, para motivar os coletores de impostos a cobrarem mais para ganharem menos.');
INSERT INTO "item_descriptions" VALUES(22188,'pt','Para que os Míseros acreditem que ela também vive em condições difíceis, mas principalmente para não gastar os inúmeros recursos que ela acumula, Miséria come muito pouco. Isso explica por que ela é tão esquelética.');
INSERT INTO "item_descriptions" VALUES(22189,'pt','Para alimentar a Forjasangue, os soldados de Guerra pisoteiam os cadáveres para extrair o sangue necessário, como fazem os viticultores com as uvas. Essa é uma prática que eles dominam, por isso Guerra sempre diz: "Assim como o vinho, nosso talento para esmagar os outros só melhora com o tempo."');
INSERT INTO "item_descriptions" VALUES(22190,'pt','"A guerra é um jogo cruel que se paga com sangue. Mas é muito bom, sangue bom!" 

- Guerra');
INSERT INTO "item_descriptions" VALUES(22191,'pt','De acordo com um rumor que corre entre os Sanguinários, o escudo de Guerra é uma representação de sua verdadeira aparência. Surpreendentemente, ninguém nunca se atreveu a perguntar a ela.');
INSERT INTO "item_descriptions" VALUES(22192,'pt','Cada um tem um jeito de impor respeito. Para Guerra, é uma mão de ferro em uma luva de ferro. Para você, é uma mão aveludada em uma luva muito pesada.');
INSERT INTO "item_descriptions" VALUES(22200,'pt','Ninguém nunca conseguiu ver o rosto inteiro de Servidão por causa desta echarpe. Talvez ele tenha medo de pegar um resfriado, ou então esteja tentando esconder um queixo em forma de traseiro que poderia prejudicar sua credibilidade.');
INSERT INTO "item_descriptions" VALUES(22201,'pt','Quando se têm muitos escravos, às vezes você fica sem saber o que fazer com eles. Para que se mantenham ocupados, Servidão deu a nada menos que 100 prisioneiros a tarefa de cuidar de sua preciosa capa. Qualquer mancha ou marca é punida com a morte, claro. Nem é preciso dizer que ela está sempre impecável.');
INSERT INTO "item_descriptions" VALUES(22202,'pt','"Você, que sonhava com espaços amplos e só conseguiu janelas: gostaria de nascer de novo e abandonar essa vida de escravo? Claro que sim, você tem o direito de sonhar! Ou não, muahahaha!"

- Servidão, zombando de um de seus escravos.');
INSERT INTO "item_descriptions" VALUES(22205,'pt','Este anel foi forjado pelos Sadidas corrompidos em homenagem a Corrupção, para provar sua lealdade e devoção a ele. Uma liga especial criada por eles impede que o anel apodreça ao entrar em contato com a pele extremamente tóxica do Cavaleiro.');
INSERT INTO "item_descriptions" VALUES(22206,'pt','Embora possa parecer uma boa ideia, evite dá-la de presente à sua cara-metade. Foi o próprio Corrupção quem a fabricou usando a Árvore da Morte: em matéria de presente envenenado, não há nada melhor.');
INSERT INTO "item_descriptions" VALUES(22209,'pt','Como diz um provérbio obscuro, "onde há Corrupção há Miaw escaldado que não põe a mão no fogo". Ninguém nunca entendeu direito o que isso quer dizer, mas, na dúvida, nunca confie em um Miaw.');
INSERT INTO "item_descriptions" VALUES(22213,'pt','Esta enxada é a ferramenta ideal para começar sua primeira horta corrompida. Chega de frutas e legumes comuns e sem graça, vamos dar lugar aos produtos exóticos: de abóbora estragada a cogumelos venenosos, tem para todos os gostos!');
INSERT INTO "item_descriptions" VALUES(22214,'pt','Também pode ser usado como babador.');
INSERT INTO "item_descriptions" VALUES(22215,'pt','Se você sempre sonhou em ter asas, hoje é o seu dia de sorte. Mas não tente voar com elas, senão vai acabar quebrando a cara. Literalmente.');
INSERT INTO "item_descriptions" VALUES(22368,'pt','"Quando o príncipe de Brakmar e o rei de Bonta trespassaram um ao outro, espalhando entranhas no solo avermelhado, senti uma grande satisfação. Assim se encerrava a guerra entre as duas cidades, em meio a uma montanha de cadáveres! Era uma cena de grande beleza. Enquanto os gritos dos Corvocs se misturavam às lamúrias dos agonizantes, fui levada por uma nostalgia. Lembranças comoventes da primeira Aurora Púrpura me vieram à memória. A investida dos cavaleiros de karne, a decapitação de Menalt, o golpe teatral orquestrado por Raval... Era o início de um conflito mortífero e edificante, que me deixou vidrada por quase mil anos! Hoje desceu a cortina. Mas o espetáculo deve continuar... Sempre haverá outras batalhas."

- Guerra');
INSERT INTO "item_descriptions" VALUES(22412,'pt','"Como é agradável sentir esse perfume de desespero no ar... Mercenários, antes tão altivos, tão valentes, tão... arrogantes. Observem como vocês, com o rosto coberto de lágrimas, atiram seus entes queridos na vala comum. Relações, promessas, sentimentos... Tudo varrido pela loucura que rasteja debaixo da sua pele. Tem coisa mais saborosa que ver o terror e a repugnância surgirem no olhar dos seus irmãos ao menor sinal da sua própria pestilência? Trema, Astrub... Implore aos seus deuses, esses impostores que nada podem fazer por você... A gangrena que vocês tanto temem... não vem do céu... mas de cada um de vocês."

- Corrupção');
INSERT INTO "item_descriptions" VALUES(22429,'pt','"Olhem para vocês, altivos Kanigs, escravizados pelos seus inimigos... Que decadência! Vocês poderiam ter erigido um verdadeiro império se não fossem tão fracos. Houve um tempo em que vocês tinham sonhos de glória e conquista, em que os prisioneiros trabalhavam nas suas pedreiras sob o estalo dos chicotes... Mas, de senhor a escravo, às vezes basta um passo. Curvando-se com o peso das correntes, rastejando na lama como larvas, vocês esqueceram quem são. Vocês são patéticos. Quando sua matriarca morrer, seu destino estará cumprido. Seu sacrifício será menos vão que sua existência... pois ele mudará a História."

- Servidão');
INSERT INTO "item_descriptions" VALUES(22444,'pt','"Está ouvindo as lamúrias carregadas pelo vento, os grunhidos dos Troolgloditas e o roncar de ventres famintos? É uma sinfonia tão doce para os meus ouvidos... O deserto ganha terreno. Ele avança, duna a duna. Os grãos de areia substituem os grãos de trigo. Os poços secam. Os pratos se esvaziam. Os Cacterras murcham. Em breve, as terras férteis serão um mero conto que embalará as esperanças vãs de crianças raquíticas no lusco-fusco. Em breve, eu retomarei Espetárida por inteiro... Essa terra finalmente será minha."

- Miséria');
INSERT INTO "item_descriptions" VALUES(23094,'pt','Este escudo tradicional é imprescindível para entrar na sala da Pandassembleia, onde atuam os dignitários que governam a ilha de Pandala. Portanto, trate de não estragá-lo, senão você terá que fabricar outro.');
INSERT INTO "item_descriptions" VALUES(23237,'pt','Assim como a lua se cobre com o véu das nuvens escuras da noite, a mais intensa das luzes muitas vezes se esconde na mais preta das tintas.');
INSERT INTO "item_descriptions" VALUES(23248,'pt','Esta faixa representa a primeira etapa para se tornar um Pandawushuka. Paciência e autocontrole são qualidades necessárias ao longo aprendizado que vem pela frente.');
INSERT INTO "item_descriptions" VALUES(23253,'pt','Ao contrário do que dizem certos rumores, não dá para derrotar um Kwapa apenas pulando nas costas dele.');
INSERT INTO "item_descriptions" VALUES(23254,'pt','Com estas botas nos pés, evite ficar parado, senão você corre o risco de criar raízes.');
INSERT INTO "item_descriptions" VALUES(23255,'pt','Este capacete pode ser utilizado de várias maneiras. Para proteger a cabeça, claro, mas também como balde, penico ou ainda escarrador.');
INSERT INTO "item_descriptions" VALUES(23256,'pt','Se você engolir este amuleto, ele liberará uma sementinha no seu estômago. Depois, abra a boca regularmente quando fizer sol e beba bastante água: talvez um lindo arbusto cresça dentro da sua barriga!');
INSERT INTO "item_descriptions" VALUES(23257,'pt','Os Idiotôs têm o hábito de utilizar pepinos para fabricar os cabos de seus machados, mas este visivelmente foge à regra. Porém, devemos admitir que um cabo de madeira ou metal é mais adequado do que um pepino para compor uma arma.');
INSERT INTO "item_descriptions" VALUES(23258,'pt','Com este escudo, você vencerá batalhas contra quem não é flor que se cheire!');
INSERT INTO "item_descriptions" VALUES(23259,'pt','Acusada de sequestrar crianças para devorá-las ou afogá-las, a Dama das Águas na verdade só quer adotá-las. Ela as transforma em Kwapas para evitar que se afoguem.');
INSERT INTO "item_descriptions" VALUES(23260,'pt','Se você sempre sonhou em ter muitos filhos, vista esta capa e vá sacudir o esqueleto em algum campo por aí. Volte na primavera: seus bebês terão desabrochado.');
INSERT INTO "item_descriptions" VALUES(23261,'pt','Muito práticas para quebrar ovos e até mesmo nozes, estas luvas são acima de tudo maravilhosas armas contra adversários do sexo masculino.');
INSERT INTO "item_descriptions" VALUES(23262,'pt','Os Ino-Narus utilizam esse cruzamento entre nunchaku e bumerangue em todas as atividades deles, como por exemplo caça, pesca e, obviamente, tradições diversas.');
INSERT INTO "item_descriptions" VALUES(23263,'pt','Se você por acaso tiver roubado este chapéu de alguém de forma mesquinha, fique sabendo que um dia vai pagar por isso.');
INSERT INTO "item_descriptions" VALUES(23264,'pt','Esta capa é capaz de proteger perfeitamente contra os ventos mais violentos. Mas, se você a usar, ficará no maior vácuo toda vez que tentar falar com alguém.');
INSERT INTO "item_descriptions" VALUES(23265,'pt','Com um cinto desses, é difícil não pensar no que se situa logo abaixo dele. Difícil também não pensar no que há abaixo do cinto dos outros.');
INSERT INTO "item_descriptions" VALUES(23266,'pt','Evite deixar cair as pérolas desse colar, senão elas podem exalar um gás muito forte.');
INSERT INTO "item_descriptions" VALUES(23267,'pt','O segredo de um Baspão Benhassado? Mão na massa e muito amor. Peça um na padaria do seu bairro!');
INSERT INTO "item_descriptions" VALUES(23268,'pt','Com este bastão alongável, Hanshi realizou inúmeras proezas. O comprimento dele pode ser realmente impressionante, mas não fique acanhado se o seu for menor: tamanho não é documento.');
INSERT INTO "item_descriptions" VALUES(23269,'pt','O artesão que fabricou esta aliança queria visivelmente revolucionar a maneira de usar joias. Como podemos ver, não dá para colocar este belo item em volta do dedo. Ele deve ser inserido entre dois dedos e fixado através do pavio habilmente posicionado para essa finalidade.');
INSERT INTO "item_descriptions" VALUES(23270,'pt','Evite se abanar sem vergonha com esses leques se não quiser perder a vida ou a visão.');
INSERT INTO "item_descriptions" VALUES(23271,'pt','Taí um cinto de explosivos que não vai estragar a festa!');
INSERT INTO "item_descriptions" VALUES(23272,'pt','Apesar de este canhão Fogofox ser uma maravilha para soltar fogos de artifício bem longe e bem alto ao mesmo tempo, infelizmente é proibido usar pessoas de tamanho pequeno como explosivos.');
INSERT INTO "item_descriptions" VALUES(23273,'pt','Ideal para improvisar uma partida de bocha explosiva com os seus amigos, este saco de juta feito à mão contém um conjunto completo de bolas Fogofox da mais alta qualidade. Unguento antiqueimadura não incluído.');
INSERT INTO "item_descriptions" VALUES(23312,'pt','Esta katana emite um calor intenso, mas que nem por isso queima a sua pele. Utilizando-a, parece mais fácil detectar os pontos fracos dos seus adversários.');
INSERT INTO "item_descriptions" VALUES(23313,'pt','Esta katana é extremamente leve, permitindo-lhe efetuar movimentos aéreos e esquivas eficientes. Quando você desfere um golpe com esta arma, ela parece sumir como um sopro de vento.');
INSERT INTO "item_descriptions" VALUES(23314,'pt','Esta katana é incrivelmente fácil de manejar, o que lhe permite realizar movimentos fluidos e imprevisíveis. Quando você a carrega, sente um profundo sentimento de calma e serenidade.');
INSERT INTO "item_descriptions" VALUES(23315,'pt','Esta katana é extremamente pesada para seu tamanho, mas também apresenta uma solidez infalível. Como é difícil de manejar para um novato, esta arma é particularmente perigosa em um duelo de sabres.');
INSERT INTO "item_descriptions" VALUES(23316,'pt','Esta katana exala um sutil aroma de musgo, e a lâmina é incrivelmente flexível para uma arma deste tipo. Com um ótimo equilíbrio entre peso e solidez, ela parece produzir um farfalhar de folhas quando corta o ar.');
INSERT INTO "item_descriptions" VALUES(23408,'pt','Dizem que cada uma das milhares de dobraduras do Dorigami esconde um mistério, o reflexo de uma mentira ou verdade com brilho doloroso e pureza ofuscante, assim como as facetas de um diamante de papel.');
INSERT INTO "item_descriptions" VALUES(23501,'pt','Este escudo é excessivamente maciço para uma proteção de treinamento. O seu corpo fica consideravelmente mais pesado, e cada um dos seus movimentos perde vivacidade. Ninguém disse que o treinamento dos Pandawushukas era moleza.');
INSERT INTO "item_descriptions" VALUES(23522,'pt','Este bastão foi fabricado por você com um galho do último Bambu Espiritual da floresta. Não foi fácil convencer Shinotake, mas ele acabou aceitando lhe conceder um galho. É um belo bastão para os seus futuros treinos.');
INSERT INTO "item_descriptions" VALUES(23563,'pt','Para se livrar deste anel, use-o durante um dia e depois volte ao lugar em que você encontrou o Espírito de Sacrifício.');
INSERT INTO "item_descriptions" VALUES(23578,'pt','Nenhum material resiste a esta ferramenta.');
INSERT INTO "item_descriptions" VALUES(23590,'pt','Esta katana é uma verdadeira obra de ourives: ela permanece perfeitamente equilibrada apesar do comprimento inabitual da lâmina. É necessária uma grande força física para manejá-la corretamente. Mas, em compensação, o corte dela é inigualável. Além disso, quando você saca esta arma, uma onda benéfica percorre todo o seu corpo, preenchendo-o com uma suave serenidade antes do combate.');
INSERT INTO "item_descriptions" VALUES(23618,'pt','Um Jiangshi-Nobi transporta a relíquia de seu corpo mumificado, que reside ao mesmo tempo no mundo material e em Externam. Embora exale um cheiro de putrefação bastante forte, este saco mortuário foi feito para ser conservado durante anos. Quando você se sentir sozinho, sempre terá um amigo com quem conversar.');
INSERT INTO "item_descriptions" VALUES(23619,'pt','Quando você usa estas botas, suas pernas parecem mais leves, e você se move mais discretamente, liberando volutas de bruma a cada passo que dá. Com um pouco de treino, você talvez possa herdar também o título de Cavaleiro de Bruma.');
INSERT INTO "item_descriptions" VALUES(23620,'pt','Foram necessários muitos testes para obter esta peça de armadura capaz de proteger o quadril de quem a estiver usando e lhe oferecer ao mesmo tempo uma excelente mobilidade. Inicialmente, ele foi concebido para as Tsukinoichis, a fim de evitar que os complexos movimentos circulares de suas lâminas duplas fossem atrapalhados por uma armadura mais pesada.');
INSERT INTO "item_descriptions" VALUES(23621,'pt','Este escudo foi feito à imagem de um Yokomainu, Yokai protetor dos templos. Segundo a tradição, ele é capaz de afastar espíritos malignos. Fora isso, ele permite afugentar aqueles pirralhos chatos que ficam pedindo doce no período do Relouin.');
INSERT INTO "item_descriptions" VALUES(23622,'pt','Os dois rubis engastados neste anel compõem o olhar de uma representação da deusa Inali. Minúsculas chamas dançam na joia. Será que o espírito de um verdadeiro Kitsu reside neste anel? Provavelmente é apenas o reflexo da sua própria ganância.');
INSERT INTO "item_descriptions" VALUES(23623,'pt','Além de conferirem um elegante estilo oriental, estas sandálias lhe permitem pisar em ectoplasma sem manchar o resto da sua roupa. Se estiver com frio, você pode muito bem usar estas getas com meias. Aproveite, pois desta vez não ficará brega.');
INSERT INTO "item_descriptions" VALUES(23624,'pt','Cada povo possui sua casta de guerreiros. Os Yokais não fogem à regra, pois têm os Onigoris. Estes verdadeiros demônios vingativos se equipam com armaduras tiradas dos samurais que eles massacram. Apesar de ser muito antigo, este cinto reforçado protegerá o seu delicado quadril com tanta eficiência quanto no primeiro dia em que foi fabricado.');
INSERT INTO "item_descriptions" VALUES(23625,'pt','Sempre dizem que os Kaonashis são espíritos de dozeanos mortos em total anonimato, o que explicaria a ausência de rosto deles. Óbvio, isso está completamente errado, mas não é nada que impeça você de usar esta máscara para se fazer passar pelo falecido tataravô daquele seu amigo meio ingênuo. ');
INSERT INTO "item_descriptions" VALUES(23626,'pt','Os Assassispíritos usam esta faixa para tapar a visão e desenvolver os outros sentidos. Através deste procedimento, eles conseguem identificar mais facilmente os fantasmas que prometeram combater. No seu caso, isso apenas lhe poupará de ter que olhar para as caras feias dos seus companheiros.');
INSERT INTO "item_descriptions" VALUES(23627,'pt','Para ficar pronta, esta Katana de Assassispírito, que tem a capacidade de banir fantasmas, exigiu quatro longos anos de trabalho de Nasumara, o ferreiro de Grobe. Infelizmente, ela perdeu suas propriedades antifantasma após um combate que acabou mal. No entanto, continua sendo uma arma de excelente qualidade para quem sabe manejar esse tipo de espada.');
INSERT INTO "item_descriptions" VALUES(23628,'pt','Este reservatório, que faz parte de um Aspirassino, permite armazenar a maldição do Dark Vlad, que retém os espectros de Grobe na ilha. Este aqui se quebrou por causa da pressão da energia maléfica que ele continha. Os resíduos da maldição presentes neste recipiente fortalecerão o seu corpo quando você o carregar nas costas.');
INSERT INTO "item_descriptions" VALUES(23805,'pt','Pesando pelo menos 20 quilopods, este casco serve para reforço muscular no programa de treinamento do Mestre Tartaruga.');
INSERT INTO "item_descriptions" VALUES(24022,'pt','Este amuleto feito de tinta ao mesmo tempo sólida e líquida dá uma excelente ferramenta de caligrafia. Inclusive a ponta finíssima é capaz de formar caracteres extraordinários com precisão, mesmo que você só tenha um treinamento mínimo nessa arte sutil.');
INSERT INTO "item_descriptions" VALUES(24023,'pt','Segundo sapateiros de respeito, fabricar Cinto Hãglicismo pode parecer tentador, mas é muito fácil perder a mão e sair espalhando por aí. Eles não fazem isso, ou pelo menos fazem com mais sutileza e parcimônia, porque consideram seu uso preguiçoso e inadequado ao Mundo dos Doze. Ah, sapateiros e seus princípios! Mesmo assim, este cinto é um must have.');
INSERT INTO "item_descriptions" VALUES(24024,'pt','Estas botas foram feitas em homenagem a Kian Zhi, o lendário sonhador mudo. Os fabricantes pouco escrupulosos se gabam da elegância dos Kianzhis que elas deixam no chão após sua passagem. Qualquer um que saiba ler Kianzhi vê logo que está escrito "Fabricado em Pandala, número 38".');
INSERT INTO "item_descriptions" VALUES(24026,'pt','"Minha consoante dormitava
Minha vogal aconselhava
Meu Casco Soante reprovava
Mas meu espírito queria voar"

Mestre Jins, zumbi e trovador.');
INSERT INTO "item_descriptions" VALUES(24027,'pt','Se esquecer uma Capa Óstrofo, calma, não precisa fazer tempestade em copo dágua.');
INSERT INTO "item_descriptions" VALUES(24028,'pt','A Foice Nema corta os inimigos tão bem quanto as palavras.');
INSERT INTO "item_descriptions" VALUES(24029,'pt','Quando era mais nova, Wulan precisou se disfarçar de samurai para lutar em uma batalha no lugar do pai, já idoso. Ela acabou se tornando uma verdadeira samurai e subiu na hierarquia por mérito próprio. Hoje, comanda nada menos que a ordem dos samurais a serviço da Daimya. Um belo exemplo de sucesso e emancipação para todas as meninas (e para os meninos também)!');
INSERT INTO "item_descriptions" VALUES(24030,'pt','"Iop ser!
Seremos rápidos como um rio
Iop ser!
Com força igual à de um tufão
Iop ser!
Na alma sempre uma chama acesa
Que a luz do luar nos traga inspiração"

Apesar da sua devoção a Pandawa, Wulan admira muito a combatividade dos discípulos de Iop e se inspira neles para incitar suas tropas.');
INSERT INTO "item_descriptions" VALUES(24031,'pt','"Calmo como a brisa, chamas no olhar, uma vez centrado, você vai ganhar."

Wulan');
INSERT INTO "item_descriptions" VALUES(24032,'pt','Este anel será seu melhor aliado quando você precisar dar nome a uma grande quantidade de coisas seguindo uma estrutura lógica e coerente. Não é lá muito útil para a maioria dos aventureiros.');
INSERT INTO "item_descriptions" VALUES(24033,'pt','"Você, minha bela Pandaluza
Quando você dança o tempo abusa
Você, minha Ginju, quando você dança com ardor
Eu não vejo mais o mundo, talvez seja amor"

Canção escrita por um bardo itinerante em homenagem à rainha Ginju, primeira soberana da Pandaluzia.');
INSERT INTO "item_descriptions" VALUES(24034,'pt','Com ela, você poderá cortar a palavra de todos que pronunciarem errado seu belo nome.');
INSERT INTO "item_descriptions" VALUES(24035,'pt','"Ortografia eh muitu importantchi, purque quandu a gentchi ixcrevi erradu ninguém intendi i issu eh muitu sériu."

Victor Togafia, pandawa disléxico porém consciente da sua situação.');
INSERT INTO "item_descriptions" VALUES(24036,'pt','Você sabia? Na língua ancestral dos Pandawas, a palavra "timologia", assim como todas as outras, tem origem nos Kianzhis, as palavras-espírito. Timo- vem do Kianzhi de "verdade", enquanto -logia vem do Kianzhi que exprime, entre outros significados, "saber" e "sentido oculto".');
INSERT INTO "item_descriptions" VALUES(24037,'pt','Entre as juntas do martelo, você consegue decifrar uma misteriosa homenagem:

"Devia ter amado mais, ter chorado mais, ter visto o Sol nascer."');
INSERT INTO "item_descriptions" VALUES(25214,'pt','Os raros marinheiros que ousam se aproximar do Atoll voltam contando boatos muito estranhos. Segundo eles, esse recife de coral monstruoso surgiu como que por mágica, com uma parte coberta por um sudário de bruma. Em meio à névoa, rompida aqui e ali por fogos crepitantes, eles alegam ouvir um clamor inquietante, ritmado por tambores de guerra e litanias hipnóticas. Tem até quem diga que viu um vulto gigantesco e fantasmagórico passar na bruma e um par de olhos vermelhos feito brasa, que penetram até a alma. Se os que conseguiram voltar ficaram apavorados com essas visões infernais, que dizer dos que não tiveram a mesma sorte?');
INSERT INTO "item_descriptions" VALUES(25215,'pt','"Shushus? Estão mais para Shushinhas!"

— Provocação típica que os Possuídos fazem aos Shushu de Rushu');
INSERT INTO "item_descriptions" VALUES(25216,'pt','"Sem fé nem rei", "nem deus, nem padre": por trás dessas divisas anarquistas, os Possuídos observam inúmeros costumes e ritos que os ajudam a coexistir, apesar da lei do mais forte que impera entre eles. Aliás, existe também outra divisa, menos conhecida: "Mãe não se xinga". Realmente, os Possuídos não respeitam nada nem ninguém, mas é só tocar no nome da Mãe dos Sete Mares que a voz deles baixa, com uma mistura de respeito e temor.');
INSERT INTO "item_descriptions" VALUES(25217,'pt','"...o Atol dos Possuídos se constitui de duas partes distintas: o Porto dos Devastadores, onde o recife de coral forma uma meia-lua e no qual atracam inúmeros navios demoníacos. A entrada é vigiada por duas imponentes estátuas pretas que parecem ter consciência, controlando o ir e vir. A outra parte do Atol, que se ergue sobre o porto e é conhecida como Pandamonium, é o verdadeiro bastião dos Possuídos, embora não se saiba ao certo quantos eles são e o que fazem lá. Toda a zona é coberta de sinais cabalísticos e vestígios de rituais, o que sugere o uso de uma magia poderosa e sinistra. Para encerrar, o chefe deles é um xamã Pandawa dotado de asas descarnadas e de um braço imponente, coberto de garras e chifres... Graças à Deusa não nos notaram, mas foi por pouco. É com pesar que venho lhe anunciar, Damya Hikomi, que a ameaça que paira sobre Pandala e o Mundo dos Doze é grande e que há perdas significativas no horizonte."

— Atal Dazroccos, relatório à Daimya a respeito do Atol.');
INSERT INTO "item_descriptions" VALUES(25218,'pt','"Por que esse amor odiento, esse ódio amoroso, esse tudo criado do nada, essa densa leveza, essa vaidade séria, esse caos deformado de bela aparência?"

— Autor desconhecido');
INSERT INTO "item_descriptions" VALUES(25219,'pt','"Não confundir anarquismo e anomia: a anomia é a ausência ou recusa de qualquer lei ou regra, o que inevitavelmente conduz à desagregação da sociedade. Por sua vez, o anarquismo é a ordem sem concentração do poder ou de outra forma de hierarquia, ou seja, uma ordem social justa e igualitária, pois decidida coletivamente."

— Affy Hobman, trecho do livro "Furte este tomo"');
INSERT INTO "item_descriptions" VALUES(25220,'pt','"Sobre o mar se arvoram
Fantasmas e assombração
Corsários que a onda apavoram
Livres, devoram nosso irmão
Nós, fincados à margem
Pela névoa lançados
Em nosso barco selvagem
Cantamos os condenados."

— Canção de marinheiros pandalianos');
INSERT INTO "item_descriptions" VALUES(25221,'pt','"Sempre imaginamos o caos como um buraco sem fundo, um abismo de trevas, uma espiral infernal de destruição e sofrimento. Na verdade, trata-se de uma noção bem mais complexa, elusiva e intimamente ligada à própria vida. Criar às vezes é destruir, e vice-versa. Não ter regras já é uma regra em si, e o que seria da liberdade sem o rastro de desordem que ela deixa ao passar?

Sem o movimento que engendra o caos, como seria o mundo? Sem dúvida uma bela tela, na qual cada coisa estaria em seu lugar. Uma tela mortífera que contemplaríamos para nos afogar na preguiçosa eternidade de uma ordem imutável e absoluta: eis aí um buraco profundo.

O caos não é um buraco. O caos é uma escada. Muitos que tentam subi-la falham e nunca mais se recuperam. A queda os estilhaça. Alguns ganham uma oportunidade de subir, mas se recusam. Eles se prendem ao reino, ou aos deuses, ou ao amor. Meras ilusões. Só a escada é real. Subi-la é tudo o que existe."

— Kabaal, chefe dos Possuídos');
INSERT INTO "item_descriptions" VALUES(25222,'pt','"Não há torre de pedra nem muralha de bronze, nem calabouço infecto ou fortes elos que possam resistir à força da alma. À alma, quando lassa dos entraves deste mundo, poder não falta para se expandir sozinha. Eis o que sei, e que agora todo o universo também saiba que posso retirar de mim a parcela de jugo que carrego."

— Julliam Céspire, dozeano dado como desaparecido em 6 de julho de 651');
INSERT INTO "item_descriptions" VALUES(25235,'pt','Esta espada pertence a ninguém menos que a chefe dos Assassispíritos.');
INSERT INTO "item_descriptions" VALUES(25245,'pt','Confeccionado de acordo com a tradição pandawa, o pincel é um prolongamento do corpo do artista. Tire o pincel do calígrafo e você lhe cortará as asas. Incapaz de se libertar do jugo do silêncio, o pensamento dele não alçará mais voo.');
INSERT INTO "item_descriptions" VALUES(25248,'pt','Abençoado pelo primeiro calígrafo, este pincel faz parte do seu corpo. Separar-se dele seria como cortar um dedo, braço ou qualquer outra parte ínfima mas importante do seu ser. Seria duplamente doloroso, então é melhor deixá-lo guardado para sempre e só usar em ocasiões especiais, como para salvar o mundo, por exemplo.');
INSERT INTO "item_descriptions" VALUES(1025292,'pt','As larvas desta charmosa criatura que é a Teh''Niak se escondem na carne crua da qual os Kar''draks, os barcos demoníacos, se alimentam. Elas crescem na barriga dos azarados que cometem o erro de comê-las. Pelo menos é o que os pais Bworks contam aos filhos para que eles não saiam mordendo tudo o que veem pela frente, de velhas carcaças ressequidas às orelhas dos coleguinhas. Afinal, a gente é o que come.');
INSERT INTO "item_descriptions" VALUES(1025293,'pt','Uma olhadinha rápida para prever o ataque adversário, uma sensação de tensão e, em seguida, uma dor insuportável na nuca. Ela se espalha com uma rapidez alucinante até a mandíbula, arranca um gemido de sofrimento e pronto, você está paralisado. Com sua armadura especial e seu pescoço musculoso, não é com Tarticoli que isso vai acontecer!');
INSERT INTO "item_descriptions" VALUES(25752,'pt','"Sabe qual é a diferença do rato para o camundongo? É muito simples. Se o roedor estiver na sua casa, mesmo que seja enorme e feroz, é um camundongo. Por outro lado, se estiver na minha, por menor e mais manso que seja, é um rato."');
INSERT INTO "item_descriptions" VALUES(25753,'pt','"Um rato branco disse para o outro: ''Eu treinei tão bem meu psicólogo que, toda vez que eu toco a campainha, ele traz alguma coisa para eu comer.''"');
INSERT INTO "item_descriptions" VALUES(25952,'pt','Aventureiro, prepare-se para o jogo da sua vida!

"Papabolista um dia, Papabolista sempre!"');
INSERT INTO "item_descriptions" VALUES(26006,'pt','Qual é a diferença entre o bom Devastador e o mau? O mau Devastador tem espetos e tentáculos e, quando vê alguma coisa se mexendo, ele devasta O bom Devastador, quando vê alguma coisa se mexendo, ele devasta... mas é um bom Devastador!');
INSERT INTO "item_descriptions" VALUES(26007,'pt','Segundo o artesão meio suspeito que fez esta luva, "não existe obra de arte sem a colaboração do demônio". Felizmente você não entende nada de arte.');
INSERT INTO "item_descriptions" VALUES(26008,'pt','O Pesadelo é paraíso para os Devastadores, que nele podem se entregar a seus impulsos mais vis: eles matam, destroem, pilham torturam e realizam outros atos do mesmo naipe, como falar de trás para frente e beber cerveja sem álcool.');
INSERT INTO "item_descriptions" VALUES(26009,'pt','"A única diferença do anjo para o demônio é uma reflexão que ainda não lhe ocorreu."

— Pol Leryhva, "Contos da Aurora"');
INSERT INTO "item_descriptions" VALUES(26010,'pt','"Quer o mundo esteja caindo aos pedaços ou não, quer você esteja do lado dos anjos ou do próprio diabo, aceite a vida como ela é, divirta-se, espalhe alegria e confusão."

— Henri "Me Ler" Valentine, "Contos da Aurora"');
INSERT INTO "item_descriptions" VALUES(26011,'pt','"A vida real é um caos, mas uma lógica terrível orienta a imaginação."

— Oskar Selvaj');
INSERT INTO "item_descriptions" VALUES(26018,'pt','"12 de septange do ano 26. O amanhecer foi frio, e a luz mal conseguiu penetrar na tristeza da manhã. Os postos avançados bontarianos, de propriedade dos Cavaleiros da Ordem, estavam brancos com os primeiros sinais de congelamento, e suas sentinelas entorpecidas pelo inverno que chegou mais cedo. Elas se amontoavam ao redor dos seus braseiros, tentando se aquecer em vão. A floresta, cuja diversidade de pequenos barulhos geralmente começava a ganhar vida nas primeiras horas da manhã, estava completamente em silêncio, com exceção de um grito que tinha sido ouvido várias vezes durante a noite. A princípio, as sentinelas não lhe deram importância, mas agora elas olhavam ao longe para o sul, em direção da aparente fonte. O grito — eles duvidavam que viesse da garganta de um animal comum — tinha se aproximado."

"A Aurora Púrpura - Os Fragmentos Encontrados, Tomo IX"');
INSERT INTO "item_descriptions" VALUES(26019,'pt','"Ao seu comando, os fantasmas dos cavaleiros da Ordem do Coração Valente se ergueram. Suas armaduras foram jogadas no chão com barulhos metálicos. Queimadas, rasgadas e cortadas, todas tinham buracos de ferimentos. Raval andou pelas fileiras em silêncio, e então apontou em direção ao exército brakmariano. As tropas de Hyrkul tinham chegado aos portões de Bonta. A qualquer momento, eles cederiam ao martelar uniforme dos Trools. Os milicianos reunidos por Jiva formavam uma parede de armaduras. Mas os goblins tentavam penetrar em todas as aberturas na porta, que se alargavam a cada segundo. Hyrkul tinha colocado sua espada de volta na bainha e revidava os golpes ao seu redor usando uma maça. Repentinamente, ele parou no meio de um movimento e girou como se alguém o estivesse chamando..."

"A Aurora Púrpura - Os Fragmentos Encontrados, Tomo X"');
INSERT INTO "item_descriptions" VALUES(26020,'pt','"Gritos de socorro estavam vindo lá de trás. O enorme guerreiro, surpreendido, escutou com atenção. Não eram os gritos de medo que o preocupavam. Ele estava com seus olhos voltados para o sul. E lá ele viu suas tropas, incapazes de lidar com os cavaleiros da Ordem — os mesmos cavaleiros que ele tinha acabado de matar com seu raio negro! Uma maré branca rolou por sobre os brakmarianos. Naquele momento, soou a corneta de Bonta. Jiva tinha aberto os portões e a milícia se movia na direção das tropas brakmarianas retomando o terreno que tinham perdido, metro após metro."

"A Aurora Púrpura - Os Fragmentos Encontrados, Tomo X"');
INSERT INTO "item_descriptions" VALUES(26021,'pt','"Meu nome é Hyrkul, e ele o seguirá até o outro mundo, centauro!", gritou o outro, e ambos correram para o ataque. Em menos de um segundo, estava tudo terminado. Menalt brandiu sua lança, cuja ponta brilhava com um fogo branco. Ele se inclinou para a frente, mirando no espaço da garganta onde as placas da armadura negra deixavam espaço suficiente para ele desferir o seu golpe mortal. Mas o guerreiro se esquivou e a lança investiu inutilmente contra a escuridão. As asas sombrias e enormes giraram para cortar e cegar o centauro. Antes que o centauro pudesse lançar um segundo ataque, Hyrkul agarrou sua lança em uma mão e sua garganta na outra. Ambos se curvaram, um em fúria e o outro em dor. Um raio de luz surgiu do elmo negro, atingindo Menalt no rosto por vários segundos. Então, o guerreiro atordoou e empurrou o centauro de volta para desfechar um golpe mortal. Ele girou sua espada, a lâmina girou com um som sibilante e cortou rapidamente de cima para baixo. Menalt caiu no chão sem qualquer ruído."

"A Aurora Púrpura - Os Fragmentos Encontrados, Tomo X"');
INSERT INTO "item_descriptions" VALUES(26022,'pt','"Em seguida, um dragão de luz negra se materializou na extremidade da espada de Hyrkul. A fera os observava lá do alto. Ela se lançou na direção das tropas bontarianas, que se incendiaram instantaneamente. Os cavaleiros caíram um após o outro, e os demais guerreiros de Bonta foram dizimados pela explosão. Puchecot só sobreviveu graças à sua magia. Assim como uma árvore centenária, ele se enraizou profundamente na terra. O campo de batalha estava manchado com as armaduras partidas dos cavaleiros caídos. Uma chuva gelada começou a cair. As tropas Brakmarianas começaram a avançar em direção a Bonta. Hyrkul pôs-se diante de Puchecot, que havia sido transformado em uma árvore enorme. Sua transformação o protegeu do perigo, mas impediu que ele falasse ou se movesse. O gigante negro rugiu com uma gargalhada de arrepiar a espinha.

''Eu vou esculpir seu caixão com a sua própria madeira, Puchecot! Mas, primeiro... eu quero ver a cabeça de Jiva pendurada em seus galhos!'' Ele cuspiu e foi juntar-se ao seu exército. As muralhas fortificadas de Bonta eram visíveis a distância, tão pálidas quanto giz."

"A Aurora Púrpura - Os Fragmentos Encontrados, Tomo X"');
INSERT INTO "item_descriptions" VALUES(26023,'pt','"Ele lutou para se desvencilhar da luta, e sabendo que a batalha estava perdida, Hyrkul olhou para Bonta uma última vez, enquanto fugia em direção à Floresta dos Arvraknídeos. Ele pode não ter sido vitorioso, mas agora sabia com certeza que Bonta não possuía nenhum Dofus. Jiva e Puchecot não teriam hesitado em usá-los no momento mais crítico da batalha para mostrar seu poder e assustar as tropas brakmarianas... Aquela simples informação foi suficiente para compensar as perdas sofridas entre as tropas de Brakmar... Hyrkul desapareceu na floresta sombria."

"A Aurora Púrpura - Os Fragmentos Encontrados, Tomo X"');
INSERT INTO "item_descriptions" VALUES(26058,'pt','Às vezes os objetos mais humildes escondem os mais preciosos poderes.');
INSERT INTO "item_descriptions" VALUES(26066,'pt','"A noite é escura para que nada possa nos distrair dos nossos pesadelos": essas foram as palavras do jovem Kilvan antes de cair no sono, agarrado a seu Tigraxé de pelúcia.
Por que a noite é tão sombria? Porque ela esconde todos os medos e todos os mistérios da noite eterna. Medos pálidos, brasas vermelhas e glifos acobreados se unem no berço do bem e do mal, origem de um conflito eternamente renovado.');
INSERT INTO "item_descriptions" VALUES(26085,'pt','Para capturar um sonho ruim sem diminuir a influência dele, nada como um apanhador de pesadelos demoníaco.');
INSERT INTO "item_descriptions" VALUES(26099,'pt','Parecida com a arma brandida pela famigerada Armyna, acredita-se que o rolo de Ayuto foi esculpido por Maimane. Será que ele contém um grande segredo? Isso explicaria o peso.');
INSERT INTO "item_descriptions" VALUES(26131,'pt','Detestada pelos vampiros, esta pá enutrof é muito valorizada por exorcistas e beatos. Sua utilidade em inúmeros ritos de conjuração está mais que provada.');
INSERT INTO "item_descriptions" VALUES(26198,'pt','Esta picareta não é feita para o combate. Contudo, ela é muito eficaz para extrair materiais mais robustos, só que é muito difícil de manusear e muito frágil. Basta um golpe em uma superfície dura para ela se partir.');
INSERT INTO "item_descriptions" VALUES(26308,'pt','Este anel está impregnado do poder dos Malters, criaturas sombrias capazes de se camuflar na escuridão onipresente da Floresta Maléfica. Infelizmente para você, esse poder de furtividade não funciona em dozeanos.
Dizem inclusive que certo jogador de papabol dos azuis de Bonta tentou se infiltrar no vestiário feminino com ele no dedo. Ele voltou com mais azul de pancada do que no uniforme.');
INSERT INTO "item_descriptions" VALUES(26309,'pt','Essas botas fazem um ligeiro barulhinho de folha seca a cada passo seu, amplificando o aspecto relaxante dos seus passeios.');
INSERT INTO "item_descriptions" VALUES(26310,'pt','Esta foice vegetal composta de sarças entrelaçadas é utilizada pelos Malters para punir os Malteregos dissidentes. A direção dos espinhos torna a arma impossível de retirar do corpo do alvo sem provocar um enorme sofrimento físico.');
INSERT INTO "item_descriptions" VALUES(26311,'pt','Basta colocar este anel no dedo para sentir o furor ardente de Hell Mina. Imagina como deve ser com o equipamento completo!');
INSERT INTO "item_descriptions" VALUES(26313,'pt','Esta capa de boa qualidade deixa você com um ar triunfante no meio da batalha, como que para acompanhar a determinação ardente contida em cada um dos seus golpes.');
INSERT INTO "item_descriptions" VALUES(26314,'pt','Dizem que a chama eterna que crepita na ponta da partazana de Hell Mina foi acendida pelo Dark Vlad. Embora você tenha conseguido uma cópia, recomendamos fortemente untar esta arma de petrool com regularidade para fazer a manutenção.');
INSERT INTO "item_descriptions" VALUES(26336,'pt','Com este chapéu remendado, você será capaz de realizar todas as proezas atribuídas aos magos goblins: sumiço de meias, preparo de poções duvidosas... E muito mais!');
INSERT INTO "item_descriptions" VALUES(26337,'pt','Cuidado com a reação de Damônika quando for entrar no Bibliotemplo com estas botas: ele pode acabar se lembrando de alguns episódios traumáticos da adolescência.
Já perdeu a conta de quantas vezes, após uma brincadeira barulhenta, ele ouvu os passos do Diretor Grunob ecoando nos corredores da Akademia, prenunciando a bronca memorável que o aguardava.');
INSERT INTO "item_descriptions" VALUES(26343,'pt','Uma faixa de pano alaranjada tingida com extrato de cenouwa. Está coberta de pelos de Miaw da mesma cor. Será que dá para tingir um Miaw para realçar o seu look?');
INSERT INTO "item_descriptions" VALUES(26344,'pt','A forma desta lâmina é ideal para raspar a meleca grudada nas mesas.');
INSERT INTO "item_descriptions" VALUES(26366,'pt','Criado há milhares de anos, este anel mágico ainda está novinho. Ele não deixará você invisível nem fará de você um senhor. Contudo, ele será útil se você tiver que honrar o juramento do dragão das florestas. Sendo assim, procure não perdê-lo nem deixá-lo rolando no fundo da mochila');
INSERT INTO "item_descriptions" VALUES(27265,'pt','Esse broche parece ser o modelo do célebre amuleto confeccionado por Boulgur, o ferreiro dos deuses.');
INSERT INTO "item_descriptions" VALUES(27266,'pt','Este cinto é leve e muito frágil, pois é muito sensível à água. Cuidado para não molhá-lo se não quiser que as pessoas vejam o Mulobo.');
INSERT INTO "item_descriptions" VALUES(27267,'pt','Esta capa lendária é bem conhecida por todos. Mas sabia que existe uma versão Ankarton que você pintar de azul?');
INSERT INTO "item_descriptions" VALUES(27268,'pt','A espada Gultar Ankarton foi mergulhada em sangue de leitão, é por isso que ela é mole tem cheiro de salsicha.');
INSERT INTO "item_descriptions" VALUES(27278,'pt','Estas tamancas de papelão foram confeccionadas pelos melhores papeleiros dos Mundo dos Doze. Evite pisar nas poças, senão elas perdem a garantia.');
INSERT INTO "item_descriptions" VALUES(27280,'pt','Este escudo é símbolo de uma revitalização. Inteiramente fabricado em papelão reciclado, ele pode ser reconstruído toda vez que é destruído.');
INSERT INTO "item_descriptions" VALUES(27282,'pt','Tem coisa mais clássica que este chapéu? Com a versão em papelão, você não vai fazer um papelão.');
INSERT INTO "item_descriptions" VALUES(27284,'pt','É um item que todo mundo conhece. E o Gelano mais célebre de todos eles. Frequentemente imitado, mas nunca igualado, ele representa para alguns um patamar inatingível. Você conseguiu meter a mão numa cópia fajuta, e por enquanto deve ser o bastante.');
INSERT INTO "item_descriptions" VALUES(27431,'pt','Este Paparneiro seguiu você desde Incarnam para acompanhar seus primeiros passos no Mundo dos Doze. Embora ainda seja meio magrinho, ele fará o possível para ajudar você nesse começo.');
INSERT INTO "item_descriptions" VALUES(27510,'pt','Se alguém tentar roubar seus pertences, a Claymomore vai matá-lo e aspirar a alma dele, como uma sinistra espada negra portadora de tempestades. Bom, era o que estava escrito em negrito no bilhete que foi entregue com a arma, logo acima das instruções de uso e da declaração de exclusão de responsabilidade em caso de evisceração involuntária.');
INSERT INTO "item_descriptions" VALUES(27511,'pt','Depois da máscara, aqui está o capacete de Cire. Este elmo carrega uma magia macabra, como parece indicar seu brilho pálido, ou será que está apenas com cheiro de mofo? Vai ter que usá-lo para descobrir... Mas se você começar a chorar largado sem conseguir parar, não reclame.');
INSERT INTO "item_descriptions" VALUES(27512,'pt','Parece que esta capa sombria e atormentada foi confeccionada a partir dos gritos das vítimas de Cire Momore. Experimente passar séculos preso em uma armadura para ver se você não fica com vontade de gritar.');
INSERT INTO "item_descriptions" VALUES(27513,'pt','"...!"

— Cire Momore, vendo estrelas.');
INSERT INTO "item_descriptions" VALUES(27514,'pt','"Não vale a pena morrer, é necessário correr sem parar": essas foram as últimas palavras de um fabulista fabulador que caiu nas garras do destino... e do Cire Momore.');
INSERT INTO "item_descriptions" VALUES(27515,'pt','Um Iop levava uma vida frenética, botando fogo no parquinho. Ele se vangloriava de ter encontrado um tesouro escondido em uma ilha amaldiçoada e derrotado o guardião dele. Como prova, ele usava um anel que arrancou do dedo do monstro à guisa de troféu.
Um dia, o Iop foi encontrado calcinado nas ruínas de sua mansão: uma vela acesa teria sido a causa do incêndio. Uma triste sina selada para um triste traste.');
INSERT INTO "item_descriptions" VALUES(27522,'pt','Você consegue imaginar quantos Timangustos foram descascados para confeccionar estas botas? Muitos, do ponto de vista de Rakooper. Muitos mesmo, além da conta...');
INSERT INTO "item_descriptions" VALUES(27523,'pt','Na verdade, é apenas um grande arranjo de pelagens costuradas entre si. Você pode usá-la para fazer um casaco, um cachecol ou até mesmo uma tanga...');
INSERT INTO "item_descriptions" VALUES(27524,'pt','Feita de maneira grosseira com um galho de pinheiro, esta aliança eco-friendly recebeu um símbolo que representa um Grurso. Assim, você saberá como são essas criaturas antes de se aventurar no território deles em busca de tesouros.');
INSERT INTO "item_descriptions" VALUES(27525,'pt','A ferreira Elisama Assar trabalhou duro para fazer este capacete. Ele é sólido, original, antioxidante e tem garantia vitalícia. Ou seja, não há nada que ele não cubra.');
INSERT INTO "item_descriptions" VALUES(27526,'pt','Anão param os boatos de que Barberila teria tentado colocar uma aliança no dedo de Tom Níndice. Para isso, ela forjou um anel de metal parecido com este, servindo como oferenda e símbolo de uma união promissora. Infelizmente, o bibliotecário teria dito "não", alegando que os dois não estavam na mesma página. A dona Sinocobre foi embora de mãos abanando... mas pode apostar que ela ainda vai tentar reescrever essa história.');
INSERT INTO "item_descriptions" VALUES(27527,'pt','Na vanguarda da moda albuerana, este boné com um autêntico rabo de Rakooper vai fazer inveja aos operários da colônia.');
INSERT INTO "item_descriptions" VALUES(27528,'pt','À primeira vista, esta maça parece ter saído direto de uma forja da ilha de Paskwak, mas, quando ela acerta sua cabeça em cheio, não é chocolate que sai voando para todo lado.');
INSERT INTO "item_descriptions" VALUES(27529,'pt','A espessura da pelagem de Rakooper permite que ele resista ao frio polar durante suas longas caminhadas habituais nas alturas da Floresta Nevada. Isso permite que ele consiga, entre outras coisas, passar muitas horas escondido em cima das árvores espiando os dozeanos.');
INSERT INTO "item_descriptions" VALUES(27530,'pt','Rakooper não larga sua podadeira tamanho XXL, uma ferramenta passada de geração em geração na sua família. Com ela, ele pode lutar, limpar os bolsos dos aventureiros e também se deslocar à vontade pelos terrenos mais íngremes.');
INSERT INTO "item_descriptions" VALUES(27531,'pt','Este amuleto superpopular entre a guarda de Albuera dá ao dono uma vantagem certa nas inúmeras escaramuças com a fauna local.');
INSERT INTO "item_descriptions" VALUES(27532,'pt','Este anel foi criado especificamente para que o usuário possa manejar sua lança sem restrições de movimentos. Tem cabimento?! Pelo peso das armas desse gabarito, pode esperar uma entorse no dedo.');
INSERT INTO "item_descriptions" VALUES(27533,'pt','Inúmeros jovens iniciados Forjalanças recebem esta lança durante o treinamento deles. Robusta, leve e balanceada, esta arma é ideal para você se acostumar ao manejo de lanças e poder se especializar em uma via marcial distinta.');
INSERT INTO "item_descriptions" VALUES(27534,'pt','Esta arma já salvou a vida de muito caçador da colônia: além de ter uma guarda que mantém os dedos quentinhos, ela pode atingir um Grurso sem pôr o dono ao alcance das garras dele.');
INSERT INTO "item_descriptions" VALUES(27535,'pt','Um cinto confeccionado por caçadores da colônia de Albuera com o objetivo de manter suas calças bem firmes, mesmo em caso de tempestade.');
INSERT INTO "item_descriptions" VALUES(27536,'pt','Botas de couro robustas e quentinhas, ideais para que seus dedos não congelem na neve.');
INSERT INTO "item_descriptions" VALUES(27537,'pt','Para evitar um gosto amargo na boca, use um escudo amargo: assim ninguém vai mandar você para a rua da amargura.');
INSERT INTO "item_descriptions" VALUES(27538,'pt','Quando um Martelo Amargo completa 77 anos, é costume dar um torque de metal pesado para marcar a ocasião.');
INSERT INTO "item_descriptions" VALUES(27539,'pt','Esta arma em forma de crescente faria a alegria de qualquer guerreiro-padeiro. Porém, não se engane: se uma Podadera de Ereboria anunciar que você tem um encontro com a lua, não é para forrar a barriga. A Ceifadora pode assumir muitas aparências, mas o resultado é sempre o mesmo: uma passagem só de ida para a Terra Cinza.');
INSERT INTO "item_descriptions" VALUES(27540,'pt','Típico dos Brutanões que vivem nas galerias de Ereboria, este martelo tem várias utilidades. Você pode bater, surrar, romper, quebrar, pregar, pulverizar, fulminar, detonar e, claro, martelar. Uma ferramenta indispensável e universal que pode ser colocada em qualquer mão, desde que ela não faça muita questão dos dedos.');
INSERT INTO "item_descriptions" VALUES(27541,'pt','Quando os aventureiros desafiam Barberila em seu bastião, as brincadeiras não param. "Essa chefe não é muito badalada!", "A gente vai te assassinar"... Quando a Brutanã parte para a violência, ficam todos quietinhos. Pode-se dizer que a delicadeza foi assassinada.');
INSERT INTO "item_descriptions" VALUES(27542,'pt','Pode-se perguntar o que levou a guardiã de Ereboria a adotar um traje digno dos maiores ringues de Sramvil... Será que os Brutanões são adeptos do ketch? No fundo, anão importa. O hábito não faz o monge, e Barberila faz o que ela quiser. Entre os Martelos Amargos, é ela que veste as calças! Não veja como questão de barba, e sim de conforto.');
INSERT INTO "item_descriptions" VALUES(27543,'pt','Há alguns invernos, enquanto os Martelos Amargos estavam desesperados para voltar para casa, uma Pandawa se aventurou pelas galerias de Ereboria para enfrentar Barberila Sinocobre. Em seu olhar escurecido, uma tempestade se aproximava. Ela dominava uma via particular da arte do Pandawushu.
As duas guerreiras já haviam travado muitos combates no passado. O confronto durou muito tempo. Muito tempo mesmo. Tanto tempo que os Brutanões que estavam lá para torcer pela chefe acabaram pegando no sono. Quando abriram os olhos, acordados pelo barulho dos próprios roncos, a discípula da Grande Ursa e a filha do Forjador se cumprimentavam com respeito. Elas trocaram suas armas. O encontro terminou empatado. Porém, um sorriso iluminava o rosto de Barberila. Os tormentos do desânimo desapareceram.
Desde então, Barberila guarda com todo o cuidado as tonfas de sua honorável adversária para ter uma lembrança e um troféu daquele dia. Quem diria que ela tem sentimentos?');
INSERT INTO "item_descriptions" VALUES(27544,'pt','Os escudos, por mais pesados que sejam, não servem apenas para se proteger ou para se exibir quando você é o chefe do vilarejo. Como prova, aqui está um que parece ter sido feito por um Smagador que levou muita pancada na cabeça. Extraído de um bloco de pedra-sarça, ele será o melhor da sua coleção.');
INSERT INTO "item_descriptions" VALUES(27545,'pt','Segundo uma crença popular, o carrasco do antigo reino de Ephedrya empunhava um machado chamado Potência. Ele ficava de pé entre os pilares da justiça, impassível, imóvel feito estátua, e só erguia a arma pesada para decapitar todos os cabeças-duras que ousavam bater cabeça com a rainha. Ah, bons tempos.');
INSERT INTO "item_descriptions" VALUES(27546,'pt','Esta lança foi esculpida em homenagem aos famosos pilares da justiça de Ephedrya. Bom, nem mais tão famosos assim... Isso foi quando eles eram usados como forcas. Ninguém mais se lembra deles hoje em dia, e a doce fragrância dos cadáveres expostos à vista de todos foi substituída pelo perfume da beladona. Como o odor das folhas dessa planta é bastante fétido, acaba que não faz tanta diferença assim.');
INSERT INTO "item_descriptions" VALUES(27547,'pt','"Dizem que feiticeiras são malvadas e cruéis. Elas cozinham criança no caldeirão, arrancam asa de borboleta, enfiam agulha debaixo da unha de gente de bem e fazem pacto com os Shushus. Só que eu não sou como as outras. Sou louca por flores, por exemplo. As pétalas do loureiro-rosa são um bálsamo para os olhos. Se dependesse de mim, todo jardim teria um."

— Beladona, a feiticeira maligna de Ephedrya.');
INSERT INTO "item_descriptions" VALUES(27548,'pt','"Um deus sem rosto decretou que devemos nos submeter à passagem do tempo. A clepsidra da nossa existência se esvazia pouco a pouco. No fim, não resta nada senão alguns grãos de amargor no oceano do vazio. Que desperdício insuportável."

— Beladona, a feiticeira maligna de Ephedrya.');
INSERT INTO "item_descriptions" VALUES(27549,'pt','"O Mundo dos Doze é belo, não apesar do sofrimento, mas com ele. Não poderia haver alegria se não houvesse dor, ternura se não houvesse solidão. É assim. E assim está bom."

— Beladona, a feiticeira maligna de Ephedrya.');
INSERT INTO "item_descriptions" VALUES(27551,'pt','Embora este elmo dê uma aparência de vilão, não deixa de ser digna de grandes heróis, cujas façanhas épicas farão os verdadeiros monstros feios tremerem.');
INSERT INTO "item_descriptions" VALUES(27552,'pt','Quando um Forjalança morre, ele é enterrado com uma parte de seus equipamentos dispostos ao redor de si, para que o acompanhem na morte. Assim, a capa, que carrega as feridas desses combates, serve de sudário e é testemunha de uma vida heroica.');
INSERT INTO "item_descriptions" VALUES(27553,'pt','Ao contrário do que pode parecer, este cinto de metal pode ser ajustado à vontade para se adaptar à morfologia do usuário. Não podemos esquecer que há beleza em todos os tipos de corpo e que se empanturrar nos quatro cantos do mundo também é uma epopeia digna de ser contada.');
INSERT INTO "item_descriptions" VALUES(27554,'pt','Como quer a tradição, um Forjalança pode legar, em vida ou após a morte, alguns dos seus pertences a um amigo, parente ou companheiro de armas. Infelizmente, quando se trata de calçados, às vezes acontece de não caber, além de vir com um chulé poderoso. Nem por isso deixam de ser motivo de orgulho para quem herda.');
INSERT INTO "item_descriptions" VALUES(27555,'pt','Os Forjalanças atribuem um simbolismo especial a suas luvas por protegerem as mãos, que representam a capacidade de agarrar o destino e moldar o mundo de acordo com suas ambições, seja pela guerra ou pelo artesanato.');
INSERT INTO "item_descriptions" VALUES(27644,'pt','Este arco pertenceu a uma guerreira lendária cujo forte era caçar autômatos e monstwos wobóticos. Dizem que o próprio Sylargh foi derrotado, ferido por uma única flecha da arqueira de cabelos rubros. Desde esse dia, ele tem dificuldade de sentar.

"O importante não é a esperança distante de se criar um mundo novo... é preservar o que temos."
— A caçadora ruiva');
INSERT INTO "item_descriptions" VALUES(27645,'pt','Um vassoura encontrada na serraria, usada para limpar a serragem do chão.');
INSERT INTO "item_descriptions" VALUES(27803,'pt','Esta pinha é um autêntico ovo de dragão. É sim, foi um Goblin que disse!
...
Você acredita em tudo que falam.
...
Bom, por via das dúvidas, é melhor guardar com cuidado. Nunca se sabe.');
INSERT INTO "item_descriptions" VALUES(29024,'pt','Inventada por um artesão que estava com um zumbido no ouvido, esta arma é boa contra Moskito e, de forma geral, tudo que merece uns tabefes.');
INSERT INTO "item_descriptions" VALUES(29110,'pt','Antes portado por Solar, o Menológio permite não apenas cuidar do mais urgente, como também controlar o ciclo das estações, o que pode ser crucial contra as mudanças climáticas, as anomalias temporais e as larvas cronófagas. Ah, e, de quebra, também é a melhor forma de se prevenir das marteladas dos Protetores irritados.');
INSERT INTO "item_descriptions" VALUES(29133,'pt','Quando estamos nos preparando para enfrentar uma força da natureza corrompida por uma potência eliocalíptica, um bênção divina é tão importante quando calda de caramelho em pudim de baunilha: é absolutamente indispensável.');
INSERT INTO "item_descriptions" VALUES(29134,'pt','Este Dofus nasceu de uma promessa feita há muito, antes que as estações ditassem o ritmo da dança do mundo. Será que você vai conseguir cuidar dele?');
INSERT INTO "item_descriptions" VALUES(29135,'pt','Para curar um imortal corroído pela corrupção, nada melhor que o poder de uma deusa somado à força de um Dofus nas mãos de um aventureiro colecionador de ovos.');
INSERT INTO "item_descriptions" VALUES(29136,'pt','O fruto do sacrifício espalha as sementes da renovação. Dolorosa metamorfose, cura natural ou simples passagem do tempo, o fim do interminável inverno é sempre um milagre.');
INSERT INTO "item_descriptions" VALUES(1029430,'pt','Uma velha lenda difundida pelos historiadores de terceira idade alega que os Mamukils já foram dotados de quatro defesas. Fábula destinada a quem não sabe contar até dois ou realidade? Deixemos os eruditos debatê-la com força nas arenas do Koliseu.');
INSERT INTO "item_descriptions" VALUES(1029431,'pt','Após atravessar um rio à frente de suas tropas, o Grande Lexandre conseguiu derrotar o rei Sporo e roubar seus Kolifantes. As criaturas colossais eram muito mais inteligentes que os Dragoperus, além de não sofrerem de estrabismo divergente. Com montarias de guerra como essas, Lexandre iria conquistar o Mundo dos Dez! Infelizmente ele não teve tempo: faleceu três anos depois com uma febre fortíssima. Criaturinhas invisíveis a olho nu podem ser tão temíveis quanto Kolifantes.');
INSERT INTO "item_descriptions" VALUES(1029432,'pt','O pelo que recobre o corpo dos Kolifantes de Tarkago não é natural: é uma espessa peruca feita sob medida. Essa carapaça capilar foi confeccionada por ordens de Kanigal, estrategista brilhante de tempos idos. Na época, o general queria atravessar uma cadeia montanhosa com seu exército. Seus mastodontes tinham passada firme, mas eram especialmente friorentos. Assim, Kanigal encontrou uma resposta que permitiu que esmagasse os adversários. Quando é para ganhar a guerra, o gênio militar não conhece limites.');
INSERT INTO "item_descriptions" VALUES(1029433,'pt','Nas tabernas de Madrestam, dizem que um gigantesco Zenusha singra os mares com uma ilha nas costas. Suas patas são tão longas que ele não precisa nadar. Ele tateia o fundo do oceano com a trompa. O que procura? A coroa do rei dos piratas? Um baú afundado? Para encontrar um tesouro escondido bem no meio das ondas, este Kolifante teria que ser extremamente sortudo.');
INSERT INTO "item_descriptions" VALUES(1029434,'pt','Adotado pelos batedores que patrulham na fronteira dos pântanos, este réptil ágil é mais feroz que um crocodilo com dor de dente. Tenaz e traiçoeiro, ele não teme começar o combate... mas sabe fugir rapidinho para voltar para terminar o trabalho no momento oportuno.');
INSERT INTO "item_descriptions" VALUES(1029435,'pt','Você tem dificuldade para tomar a iniciativa? Suba no dorso desta serpente imponente para se impor! E não tenha medo de ficar com movimentos mais lentos: a Kobrápida é a prova de que uma cabeça bem penteada é mais importante que pernas.');
INSERT INTO "item_descriptions" VALUES(1029456,'pt','Um pássaro incomum já dizia: "Para voar como um raio rumo a qualquer lugar, é preciso se convencer de que você já chegou ao seu destino." Palavras sábias sem o peso de tabus e convenções. Talvez seja por isso que você se sente leve como uma pluma na sua Taivoga.');
INSERT INTO "item_descriptions" VALUES(29463,'pt','Frequentemente visto nos braços dos soldados bontarianos, você pode admirar os detalhes finos desse escudo, a qualidade de sua madeira, sua curva perfeita, sua... Ah... não, desculpe... este aqui é apenas uma imitação especialmente bem-feita. O artesão que fabricou deve ter sido abençoado por Jember.');
INSERT INTO "item_descriptions" VALUES(30356,'pt','Graças a este Dofus dado pelos guardiões da Ankama, você poderá dizer "Eu fui!" sem ficar saudosista. Até daqui a vinte anos!');
INSERT INTO "item_descriptions" VALUES(44,'de','Dieses Schwert einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(49,'de','Dieses liebevoll geschmiedete Schwert ist besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(55,'de','Mit diesem Schwert, das bei jungen Iops große Beliebtheit genießt, könnt ihr vielleicht eure Fähigkeiten unter Beweis stellen. Schließt es aber besser nicht allzu sehr ins Herz, denn das Schwert Ragen bleibt nie lange bei einem Besitzer.');
INSERT INTO "item_descriptions" VALUES(58,'de','Dieses Schwert wurde in den Tränen eines jungen WuWulfs getränkt. Viele Krieger glauben, das bringe ihnen Glück und Mut auf dem Schlachtfeld. Sie sind ja so naiv...');
INSERT INTO "item_descriptions" VALUES(62,'de','Dieses Schwert wurde von einem doppelt sehenden Schmied entworfen und ist in Brâkmar sehr beliebt. Die doppelte Klinge macht es unglaublich vielseitig: Zum Kämpfen, Flaschen öffnen, Kartoffeln schälen ... Selbst die tapfersten Gegner schielen neidisch darauf.');
INSERT INTO "item_descriptions" VALUES(65,'de','Da es gleich nach dem Schmieden im Blut eines Schweinedrachens abgeschreckt wurde, hat das Goultard einen eigentümlichen Geruch an sich.  Riecht es nach Drachendung? Nach Schweineurin? Schwer zu sagen. Hat sich jedoch der Träger erst einmal an den Gestank gewöhnt, kann er sich mit diesem mächtigen Schwert mit den besten aller Kämpfer messen.');
INSERT INTO "item_descriptions" VALUES(66,'de','Dieses Schwert gehörte einst dem tapferen Badoul, der nach einem Kopftreffer geistig umnachtet ist.');
INSERT INTO "item_descriptions" VALUES(67,'de','Höllisch scharf: so äußerte sich der Succubus zufrieden mit seinem Werk nach Erschaffung dieser Waffe. Vielleicht waren das aber auch die Worte, mit denen Vald seine Schwester beschrieb. So genau weiß man das nicht mehr.');
INSERT INTO "item_descriptions" VALUES(70,'de','Dieses Amulett erhöht die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(77,'de','Dieses Amulett erhöht die Stärke seines Trägers.');
INSERT INTO "item_descriptions" VALUES(84,'de','Dieses Amulett erhöht die Vitalität seines Trägers.');
INSERT INTO "item_descriptions" VALUES(91,'de','Dieser Bogen einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(97,'de','Diese Dolche einfachster Machart werden aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(103,'de','Dieser Ring erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(112,'de','Dieser Ring erhöht das Glück seines Trägers.');
INSERT INTO "item_descriptions" VALUES(121,'de','Dieser Ring erhöht die Flinkheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(127,'de','Diese außergewöhnlichen Stiefel erhöhen eure Bewegungsrate im Kampf. Doch hütet euch vor dem furchtbaren Gestank, den sie absondern. Sie haben nämlich einst dem berüchtigten Bowissen gehört.');
INSERT INTO "item_descriptions" VALUES(130,'de','Diese Stiefel sind einfach ideal, wenn es mal wieder darum geht, einem Gegner den Gnadenstoß zu verpassen.');
INSERT INTO "item_descriptions" VALUES(134,'de','Dieser Stab einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(140,'de','Dieser Stock einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(147,'de','Dieser Hammer einfachster Machart wird aus eurem Charakter keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(153,'de','Diese Schaufel einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(156,'de','Dieser Gürtel erhöht erheblich die Kampfkraft seines Trägers. Leider wirkt sich sein hohes Gewicht dabei ein wenig negativ auf dessen Flinkheit aus. Aber wer will schon vor dem Gegner weglaufen?');
INSERT INTO "item_descriptions" VALUES(157,'de','Das Geschnapsel wurde aus einem Stück Mondstein gefertigt, welches über 5.000 Jahre in einem Fass Schnaps verbracht hatte. Da ist fast vorprogrammiert, dass dies dem Amulett große Macht verleiht.');
INSERT INTO "item_descriptions" VALUES(158,'de','Die goldene Zukunft erhöht erheblich die Flinkheit und Vitalität ihres Trägers.');
INSERT INTO "item_descriptions" VALUES(159,'de','Man sagt, diese Brosche sei vom berühmten Schmied Bulgur höchstpersönlich gefertigt worden, dem man nachsagt, sogar die mächtigen Waffen der Götter zu schmieden.');
INSERT INTO "item_descriptions" VALUES(160,'de','Dieser seltene Gegenstand wurde aus einer Mischung aus Sternenstaub der Milchstraße und Himmelseiern hergestellt. Daher immer kühl aufbewahren!');
INSERT INTO "item_descriptions" VALUES(161,'de','Dieses mächtige Amulett wird mit Sicherheit den Träger zu einer Berühmt-Berüchtigtheit machen.');
INSERT INTO "item_descriptions" VALUES(165,'de','Ein wohlgeschnitzter Stab, der besonders für Anfänger interessant ist.');
INSERT INTO "item_descriptions" VALUES(180,'de','Dieser Stab stammt aus dem tiefsten Limbo von Syrastass. Der Legende nach kann er auf bloßen Wunsch seines Trägers ganze Felder von Osterglocken zum Erblühen bringen.');
INSERT INTO "item_descriptions" VALUES(181,'de','Dieser Stab wurde von Helle aus den obersten Himmelsphären gesegnet. Er verleiht daher seinem Träger Flinkheit und Vitalität im Kampf.');
INSERT INTO "item_descriptions" VALUES(183,'de','Dieser schön zurechtgeschnitzte Stock ist besonders für Anfänger gut geeignet.');
INSERT INTO "item_descriptions" VALUES(188,'de','Dieser Stab erhöht die Weisheit seines Trägers. Risiken und Nebenwirkungen: Kann zu einer Hypertrophie führen, daher nur in Maßen verwenden.');
INSERT INTO "item_descriptions" VALUES(194,'de','Dieser Stock erhöht nicht nur die Vitalität seines Trägers, er kann notfalls sogar gegessen werden.');
INSERT INTO "item_descriptions" VALUES(200,'de','Der Gott-Stock ist eine extrem mächtige Waffe. Selbst wenn ihr gerade mal eine kleine Schwäche verspürt, dann wird seine große Macht euch immer noch den Besten der Besten mindestens ebenbürtig sein lassen.');
INSERT INTO "item_descriptions" VALUES(201,'de','Hook wurde bei einer Leiche gefunden, die direkt neben den Überresten eines gewaltigen, halb-verwesten Crocodylls lag.');
INSERT INTO "item_descriptions" VALUES(202,'de','Dieses Schwert wurde durch die Tränen des Engels Raziel geweiht. Es ist einfach nur himmlisch zerstörerisch und seine Macht reicht aus, um auch die mächtigsten aller Gegner mühelos besiegen zu können.');
INSERT INTO "item_descriptions" VALUES(203,'de','Wenn ihr diesen großartigen Gürtel um die Taille tragt, dann seid ihr einer der glücklichsten Helden dieses Universums. Dieser Gürtel gehörte nämlich einst einem bärtigen Riesen, dem stärksten und unwiderstehlichsten Helden aller Zeiten.');
INSERT INTO "item_descriptions" VALUES(204,'de','Dieser lebende Stecken hängt immer an den düsterlichsten Orten von ganz Amakna herum. Alle 300 Jahre ändert er Ort und Besitzer, wobei er es vorzieht, immer möglichst dunkle und übelriechende Tunnel und Gänge zu nehmen.');
INSERT INTO "item_descriptions" VALUES(208,'de','Diese liebevoll geschmiedeten Dolche sind besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(214,'de','Diese hervorragend gearbeiteten Dolche werden aus euch einen tapferen Kämpfer machen. Bestimmt!');
INSERT INTO "item_descriptions" VALUES(218,'de','Basher sind fürchterliche Waffen, gut geeignet für jeden Meuchelmörder. Ihr Träger wird mit ihnen manch einem blutrünstigen Kämpfer mindestens ebenbürtig sein.');
INSERT INTO "item_descriptions" VALUES(219,'de','Die Blessurdolche gehörten einst dem berüchtigten Dunkelhand-Oger, der umkam, als er einen Bimd Oul-Paladin angriff. Man munkelt, sein Blut würde nun diese bösartigen Dolche beleben, doch konnte das bis heute noch niemand beweisen.');
INSERT INTO "item_descriptions" VALUES(220,'de','Chakra Style sind zwei Schwesterdolche, die einst einer berüchtigten Diebin Amaknas gehörten. Sie war so gut, dass sie es sogar schaffte, die Schlösser der Türen zum Tempel Osaroths zu knacken und einige der wertvollsten Reliquien von dort mitgehen zu lassen!');
INSERT INTO "item_descriptions" VALUES(224,'de','Ein wohlgeschmiedeter Hammer, der gerade für Anfänger sehr interessant ist.');
INSERT INTO "item_descriptions" VALUES(230,'de','Dieser Hammer erhöht die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(233,'de','Kaiser ist der Name des Schweinedrachens, welcher einst das Dorf Bounkaïda dem Erdboden gleichmachte.  Nachdem ihn die Milizen endlich überwältigt hatten, nutzten viele Schmiede Teile des Drachens, um daraus Waffen zu machen. U.a. entstand dabei dieser Hammer.');
INSERT INTO "item_descriptions" VALUES(234,'de','Ragnarok ist ein wirklich sehr mächtiger Hammer, der in der Lage ist Unwetter auszulösen... oder vor Wut blitzende Augen bei euren Verbündeten, falls diese versehentlich von ihm getroffen wurden.');
INSERT INTO "item_descriptions" VALUES(235,'de','Dieser Hammer hat einst dem Wächter zum Tor der Hölle gehört. Er verhinderte damit, dass die Lebenden dort hineingehen, die Toten herauskommen und sich die lebenden Toten überhaupt vom Fleck bewegen.');
INSERT INTO "item_descriptions" VALUES(236,'de','Barabas ist wirklich furchterregend: Er ermöglicht es dem Träger, sich leichtfüßig zu bewegen und ist sehr wirkungsvoll im Nahkampf.');
INSERT INTO "item_descriptions" VALUES(237,'de','Sargass befand sich einst in den Händen eines Kindes mit furchterregenden Kräften. Allerdings weiß niemand, wer diese Waffe nun besitzt, seitdem das Kind sie bei einem Abenteurer gegen einen Sack Murmeln eingetauscht hat.');
INSERT INTO "item_descriptions" VALUES(241,'de','Eine gut ausgewogene Schaufel, die besonders für Anfänger gut geeignet ist.');
INSERT INTO "item_descriptions" VALUES(247,'de','Diese Schaufel hervorragender Machart wird aus eurem Charakter bestimmt einen tapferen Kämpfer machen.');
INSERT INTO "item_descriptions" VALUES(250,'de','Ares mit seinem seltsamen Aussehen auf halbem Wege zwischen einer Axt und einer Schaufel war eine der sieben Waffen, die der Dämon Kajlir zum Besiegen der "Bruderschaft der Purpur-Dofus sammelnden Enutrofs" verwendet hat.');
INSERT INTO "item_descriptions" VALUES(251,'de','Graubart war die Lieblingswaffe des Dämonenzwerges (oder Zwergdämonen?), der viele Dorfbewohner terrorisierte. Ohne "Vorsicht" zu rufen griff er ihre Dörfer an und zwar ohne Rücksicht, so dass sie danach die Nachsicht hatten.');
INSERT INTO "item_descriptions" VALUES(255,'de','Dieser Gürtel erhöht die Lebenskraft seines Trägers und garantiert so eine geringfügig längere Lebensdauer im Kampf.');
INSERT INTO "item_descriptions" VALUES(259,'de','Dieser Gürtel erhöht die Stärke seines Trägers.');
INSERT INTO "item_descriptions" VALUES(263,'de','Dieser Gürtel erhöht die Flinkheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(267,'de','Dieser Bogen mag zwar sehr einfach gehalten sein, doch ist er trotzdem sehr nützlich.');
INSERT INTO "item_descriptions" VALUES(270,'de','Der Xaveur ist ein sehr wirkungsvoller Bogen. Er gehörte einst Xaver, dem Bäcker. Dieser pflegte immer an alle Monstern in der Umgebung seiner Bäckerei Brote zu vergeben, bevor er die nächste Fuhre in den Ofen schub.');
INSERT INTO "item_descriptions" VALUES(271,'de','Diese schöne und faszinierende Waffe erlaubt epische Schlachten im Nahkampf, wie ein echter Chafer sie führen würde.');
INSERT INTO "item_descriptions" VALUES(272,'de','Dieser Bogen hat sogar genug Zugkraft, um Pfeile bis auf den Mond zu schießen.');
INSERT INTO "item_descriptions" VALUES(273,'de','Yamatos Sehne hat bereits mehr als ein Monsterherz zum Vibrieren gebracht. Mit dieser feinen Waffe lässt sich ein Pfeil selbst in die verborgensten Stellen platzieren.');
INSERT INTO "item_descriptions" VALUES(278,'de','In diesen Ring ist ein sehr seltener geschliffener Stein eingelegt. Der Felsenring trägt seinen Namen aufgrund der vielen unterschiedlichen Gesteine und Metalle, die zu seiner Anfertigung nötig sind.');
INSERT INTO "item_descriptions" VALUES(279,'de','Laut Bericht eines bekannten Abenteurers enthält dieses Amulett eine Fresssackträne, deren Geruch und Eigenschaften denen von abgekochtem Fresssackleder ähnelt.');
INSERT INTO "item_descriptions" VALUES(280,'de','Diese Halskette ist von Sammlern heiß begehrt und bringt bestimmt viel Geld ein.');
INSERT INTO "item_descriptions" VALUES(296,'de','Das einzige, was genauso hart ist wie ein Krachler, ist ein Krachler. Genau aus diesem Grund wurde diese speziell für die Krachler-Jagd entwickelte Schaufel aus Krachlergestein hergestellt.');
INSERT INTO "item_descriptions" VALUES(298,'de','Diese Sandalen bestehen aus zermahlenen Tofu-Federn und die Sohle aus unabnutzbaren Tofuschnäbeln. Allerdings kann es aus noch ungeklärter Ursache manchmal vorkommen, dass ihr Träger mitunter ein wenig schwach im Kopf wird... wie ein Tofu eben.');
INSERT INTO "item_descriptions" VALUES(299,'de','Die beste Verteidigung ist immer noch der Angriff! Diese Schuhe werden es euch ermöglichen, ganze Gruppen von Aggressoren ohne Probleme aus dem Weg zu treten.');
INSERT INTO "item_descriptions" VALUES(320,'de','Dieser Stock diente ursprünglich den Hirten Amaknas dazu, ihre Tabiherden zu dirigieren. Er ist nämlich so leicht, dass der Träger jedem entlaufenen Tabi nachrennen kann, ohne jemals müde zu werden.');
INSERT INTO "item_descriptions" VALUES(323,'de','Dieses Amulett verleiht dem Träger außergewöhnliche Fähigkeiten. Er wird förmlich spüren können, wie eine mysteriöse Aura seinen Körper umhüllt, welche alle Grenzen seiner physischen Kräfte sprengt.');
INSERT INTO "item_descriptions" VALUES(324,'de','Dieses Amulett färbt sich rosa, wenn der Träger guter Laune ist. Man sagt ihm ebenfalls nach, die Chancen für das Finden guter Gegenstände zu erhöhen.');
INSERT INTO "item_descriptions" VALUES(325,'de','Dieses Amulett enthält kleine Schädelchen, die von einem der größten Sram-Juweliere aus Knochen herausgearbeitet wurden. Es erlaubt dem Träger, leichter aus einer gefährlichen Lage zu entkommen.');
INSERT INTO "item_descriptions" VALUES(326,'de','Diese Halskette stammt aus dem Norden Amaknas. Sie erleichtert dem Träger das Beschwören von Kreaturen.');
INSERT INTO "item_descriptions" VALUES(327,'de','Diese Klinge wurde ursprünglich für Gobtrotter geschmiedet, war diesen schwächlichen Goblins letztendlich aber zu schwer. Für jemanden mit normalem Körperbau ist sie jedoch ziemlich leicht und erlaubt sehr schnelle Hiebe.');
INSERT INTO "item_descriptions" VALUES(328,'de','Dieses Schwert mit doppelter Klinge diente ursprünglich dazu, Äste von Bäumen abzuschneiden, um sich einen Weg durch den Dschungel zu bahnen. Allerdings stellten die Holzfäller sehr schnell fest, dass sie der ideale Begleiter war, um mit jeglicher Art von Bedrohung auf dem Weg fertigzuwerden.');
INSERT INTO "item_descriptions" VALUES(329,'de','Wie der Name besagt, lässt sich mit diesem Bogen leicht jeder Kampf gewinnen. Ein bekannter und phantasieloser Crâ-Architekt hat später diesen Namen übernommen, um ihn einer seiner Bauten zu verleihen.');
INSERT INTO "item_descriptions" VALUES(331,'de','Dies ist einer der meistgesuchtesten Bögen ganz Amaknas. Der Legende nach soll man nämlich an der Stelle, wo der Pfeil landet, einen Schatz finden können. Seltsamerweise scheint dies nur dann zu funktionieren, wenn Regen fällt und Sonnenstrahlen das Ganze bescheinen.');
INSERT INTO "item_descriptions" VALUES(332,'de','Jeanne war ein wenig verrückt. Sie hörte ständig in Ihrem Kopf Tabis rülpsen. Um zu verhindern, dass sie sich mit ihrem Bogen selbst verletzt, wurde er ihr abgenommen und man beschloß, sie anläßlich der Einweihung der Taverne lebendig zu verbrennen, um die Atmosphäre etwas zu aufzulockern.');
INSERT INTO "item_descriptions" VALUES(333,'de','Dieses einfache Stockbrot wurde zu einer gefürchteten Waffe, nachdem es Xaver der Bäcker während des Monsterfütterns zum Warmhalten in den tiefsten Punkt seines Ofens geschoben hatte und erst 234 Jahre später aus Zufall dort wiederfand.');
INSERT INTO "item_descriptions" VALUES(334,'de','Dieser Stab gehörte einer Eniripsa namens Liriel, die nach einer Überdosis Erdbeeren in furchtbarer Agonie ihr Leben aushauchte. Beim Ausfallen ihrer Flügel stieß sie einen schrecklichen Schmerzenschrei aus, der einem durch Mark und Bein ging Nun ist dieser angeblich verfluchte Stab bei Sammlern heiß begehrt.');
INSERT INTO "item_descriptions" VALUES(335,'de','Ohne ihren Stab sind die Bworks-Magier genauso friedlich wie die Tofus ohne ihre Knutscher. Das spricht Bände über diesen Stab.');
INSERT INTO "item_descriptions" VALUES(336,'de','Dieser Stock hat die Fähigkeit, Kawotten schweben zu lassen. Da fragt man sich doch, was in aller Welt das bringen soll...');
INSERT INTO "item_descriptions" VALUES(337,'de','Dieser Bogen ist sehr einfach zu gebrauchen. Er wurde schließlich auch bei der Entwicklung an die Intelligenz des Bwork-Bogenschützen angepasst, weshalb er beinahe schon von einem Tofu gehandhabt werden kann. Im Gegenzug braucht man allerdings die Stärke eines Krachlers, um ihn zu spannen.');
INSERT INTO "item_descriptions" VALUES(339,'de','Dieses Schwert benutzte Buh Tscher, der Metzger, um damit Knochen zu spalten. Doch dem Chafer gelang es einst, ihm dieses Werkzeug zu rauben. In seinen Händen stellt das Schwert nun eine äußerst gefährliche Waffe dar, auf deren Konto schon mehrere Dutzend Totalamputationen gehen.');
INSERT INTO "item_descriptions" VALUES(340,'de','Der Legende nach kann man mit diesen Dolchen alles Mögliche stehlen. Man kann einfach irgendjemandem irgendwas wegnehmen und umgekehrt. Niemand erinnert sich mehr genau an die Legende.');
INSERT INTO "item_descriptions" VALUES(341,'de','Diese legendären Dolche sind ein echtes Sammlerstück für jeden Sram, der etwas auf sich hält. Sie werden von manchen sogar so sehr verehrt, dass sie gar nicht versuchen, diese Dolche zu stehlen. Das will etwas heißen!');
INSERT INTO "item_descriptions" VALUES(342,'de','Dieser eigentümliche Hammer wurde ganz aus Kwack-Schnäbeln gebaut, was auch erklärt, warum es so sehr sticht, wenn man Schläge damit abbekommt.');
INSERT INTO "item_descriptions" VALUES(346,'de','Wenn man gewissen Geschichten Glauben schenken darf, sollen diese Ringe den Träger vor Unwettern schützen. Jedoch konnte dies bisher noch nicht nachgewiesen werden, da es in Amakna niemals regnet.');
INSERT INTO "item_descriptions" VALUES(347,'de','Diese Gartenschaufel ist besonders tauglich, wenn es darum geht, Rhizome, wie sie bei vielen Unkräutern vorkommen, abzutrennen. Allerdings ist sie gleichfalls hervorragend dazu geeignet, alles andere von allem anderen abzutrennen.');
INSERT INTO "item_descriptions" VALUES(348,'de','Diese Stiefel gehörten einst einem Koch, der ständig alle Angestellten in der Gegend herumscheuchte... "Nächster Gang, gebt alles!", weil er ein schauderhaftes Organisationstalent hatte. Man hörte ihn immer bereits von Weitem krakelen: "Y''arriva,y''arriva, es kommt gleich!"');
INSERT INTO "item_descriptions" VALUES(354,'de','Diese Schwertart wurde speziell für die Leibgarde eines reichen und berüchtigten Händlers angefertigt. Sie sollte zwar mehr zur Abschreckung dienen als zum echten Kampf, doch war sie dennoch gut geeignet, etwaige Diebe oder manchmal auch ehrliche Kunden niederzustrecken, was auf Dauer allerdings recht anstrengend ist.');
INSERT INTO "item_descriptions" VALUES(355,'de','Dieser Ring bringt seinem Träger Stärke und Mut.');
INSERT INTO "item_descriptions" VALUES(356,'de','Dieser Gürtel erhöht die Ausdauer seines Trägers im Kampf und damit meist auch seine Lebensdauer.');
INSERT INTO "item_descriptions" VALUES(357,'de','Dieses Schwert symbolisiert das Körperteil, auf das Ecaflips am stolzesten sind. Warum, dürfte nun klar sein.');
INSERT INTO "item_descriptions" VALUES(358,'de','Der Höllenschwanz macht einem das Leben zur Hölle... und mit ihm könnt ihr Freund wie Feind in den Wahnsinn treiben. Mitunter lässt sich damit auch leicht Freund zu Feind machen - das Umgekehrte ist allerdings scheinbar noch nicht vorgekommen.');
INSERT INTO "item_descriptions" VALUES(359,'de','Vor langer, langer Zeit wurde Isidor dieser Ring vom König Alister Snoc verliehen, der die unvergleichliche Flinkheit dieses Ecaflips erkannt hatte.');
INSERT INTO "item_descriptions" VALUES(436,'de','Dieser Stock, der aus einer dicken Astaknydenwurzel herausgearbeitet wurde, ist sehr effektiv im Nahkampf. Allerdings sollte man dabei immer aufpassen, dass er nicht nass wird, da er sich sonst wieder im Boden verwurzelt und den Träger angreift.');
INSERT INTO "item_descriptions" VALUES(455,'de','Dieser lächerliche kleine Hammer diente dem Bauern Zokrim dazu, die Zaunpfähle für seine Weiden bei Einsetzen der Morgenröte in den Boden zu schlagen. Warum er dies immer nur bei Einsetzen der Morgenröte zu tun pflegte, weiß niemand, aber der Legende nach hatte er einen sehr guten Grund dafür.');
INSERT INTO "item_descriptions" VALUES(456,'de','Mit dieser Axt lassen sich leicht Bäume fällen - sogar die Dicksten ohne große Mühe. Doch wird sie vor allem für ihr großes Gewicht geschätzt. Mit ihr lässt sich beispielsweise ein Bwork in drei Teile schlagen, ehe es dieser überhaupt mitbekommt. Man müsste jetzt nur noch schaffen, diese Waffe hochzubekommen.');
INSERT INTO "item_descriptions" VALUES(458,'de','Der Chafer ist ein sehr feinfühliges und vornehmes Wesen, weshalb er immer ein Amulett mit den Schädeln seiner im Kampf gefallenen Cousins bei sich trägt. Seltsam ist nur, dass niemand jemals von diesen Cousins des Chafers gehört hat.');
INSERT INTO "item_descriptions" VALUES(462,'de','Da das Holz eines Astaknyden selbst abgeschnitten noch lebendig ist, ist es nicht einfach, diesen Bogen zu gebrauchen. Doch gibt es nichts besseres um einen Astaknyden zu verspotten, als ihn mit einem Bogen zu töten, der aus den Wurzeln der eigenen Brüder gemacht wurde.');
INSERT INTO "item_descriptions" VALUES(469,'de','Die Macht dieses Stabes beruht auf den magischen Eigenschaften der noch lebendigen Astaknydenwurzeln. Darum solltet ihr immer auf der Hut sein vor üblen Überraschungen. Der Stab kann sich nämlich manchmal auch gegen den Träger wenden.');
INSERT INTO "item_descriptions" VALUES(478,'de','Der Ursprung des Namens dieser Axt ist auf die Holzfällerin Woodee Woodschrecker zurückzuführen, die ihren ganzen Charme dafür aufwandte, die Aufmerksamkeit der anderen Holzfäller zu erregen, um so die Position der letzten Hainbuchen geheimzuhalten, deren Existenz sie schützen wollte.');
INSERT INTO "item_descriptions" VALUES(484,'de','Ein Enutrof, der wohl in der Taverne ein wenig über seinen Durst getrunken hatte, stellte eines Tages fest, dass sich diese ursprünglich zum Ausheben unterirdischer Gänge konzipierte Schaufel auch hervorragend dazu eignet, die dicken Schädel von Gegnern zu bearbeiten.');
INSERT INTO "item_descriptions" VALUES(489,'de','Dank dieser Lupe könnt ihr die Innenausstattung von Räumen untersuchen, um Spuren von Schätzen zu entdecken.');
INSERT INTO "item_descriptions" VALUES(502,'de','Diese Axt ist eine der wenigen, die in der Lage sind, auch verzauberte Bäume zu fällen. Das bedeutet, dass sie alles zerschneidet, was magisch ist – ganz gleich, ob lebendig oder nicht.');
INSERT INTO "item_descriptions" VALUES(515,'de','Diese Axt gehörte einmal dem berühmten Holzfäller Bruce Bulgour, der Kassiopoe Benn, die Tochter eines anderen großen Holzfällers, geheiratet hatte. Mit dieser Waffe pflegte er sich des Nachts zu verteidigen, wenn er loszog, um ganze Wälder niederzumähen.');
INSERT INTO "item_descriptions" VALUES(592,'de','Dieser Bogen gehörte Ivan Hau, einem kampferprobten Crâ, der bereits mehr als einen entlaufenen Tofu niedergestreckt hat. Dieser Bogen hat die Besonderheit, den Gegner durch besondere Trickschüsse zu überraschen, die ihn erst perplex machen und dann sterbend zu Boden fallen lassen.');
INSERT INTO "item_descriptions" VALUES(610,'de','Dieses weißliche Amulett wurde aus Krebsschalen gefertigt, was es zwar sehr zerbrechlich, aber auch originell erscheinen lässt.');
INSERT INTO "item_descriptions" VALUES(616,'de','Dieser Halskette aus großen Fischschuppen sagt man nach, dass sie den Träger selbst bei stürmischem Seegang vor Unheil bewahren soll.');
INSERT INTO "item_descriptions" VALUES(617,'de','Dieses furchterregende Amulett hat bereits mehr als einen Seemann beeindruckt. Schon das bloße Tragen verbreitet Angst und Schrecken.');
INSERT INTO "item_descriptions" VALUES(619,'de','Mit diesem Stecken konnte der Fresssackhirte Farle Ingalsse Tofus beschwören, die seine Herden bewachten. Im Laufe der Zeit stellte sich heraus, dass dieser Stecken gleichfalls eine hervorragende Waffe im Kampf abgibt.');
INSERT INTO "item_descriptions" VALUES(620,'de','Mit diesem Säbel konnte der berühmte Seemann Mobbly Dickmann die Tentakel des für das Ersticken betrunkener Seebären berüchtigten Riesenkrakamors der Moon-Insel in Scheiben tranchieren.');
INSERT INTO "item_descriptions" VALUES(629,'de','Wenn ihr mit diesem Hut zum Karneval erscheint, werden alle Anwesenden vor Neid erblassen. Helau und Alaaf!');
INSERT INTO "item_descriptions" VALUES(638,'de','Einen Somoon zu fischen ist kaum machbar, doch mit diesem Amulett ist für den Träger nichts mehr unmöglich.');
INSERT INTO "item_descriptions" VALUES(639,'de','Dieses Amulett wurde im auf Grund gelaufenen Wrack des bekannten Krakamor-Fischers, Moby Drifftick, gefunden, der in einem großen Umkreis für seine lausigen Witze in der Piratenbar bekannt war.');
INSERT INTO "item_descriptions" VALUES(640,'de','Dieser Bogen wurde für Fischer entwickelt, welche die Küste von herumlungerndem Ungeziefer befreien wollten, ohne dafür von ihrem Sitz aufstehen zu müssen. Und dies auch noch durch das Fenster ihrer Lieblingskneipe hindurch. Wahnsinn!');
INSERT INTO "item_descriptions" VALUES(657,'de','Mit diesem Stecken kann die Tofuhirtin Shika Ingalsse Tofus beschwören, welche die Herden bewachen. Im Laufe der Zeit stellte sich heraus, dass dieser Stecken gleichfalls eine hervorragende Waffe im Kampf abgibt.');
INSERT INTO "item_descriptions" VALUES(658,'de','Mit diesem Stecken kann die Tabihirtin Gramine Ingalsse Tofus beschwören, welche die Herden bewachen. Im Laufe der Zeit stellte sich heraus, dass dieser Stecken gleichfalls eine hervorragende Waffe im Kampf abgibt.');
INSERT INTO "item_descriptions" VALUES(673,'de','Diese Axt ist in keinster Weise außergewöhnlich, außer dass ihr Schaft aus Kastanienholz besteht, welches für sein geringes Gewicht sehr geschätzt wird. Dadurch liegt diese Axt so leicht in der Hand wie die Feder eines jungen Schattentofus.');
INSERT INTO "item_descriptions" VALUES(674,'de','"Diese Axt hat alles, was eine gute Axt haben muss", lobte sie einmal der bekannte Holzfäller Bruce Bulgour. In der Tat. Sie lässt sich leicht und kontrolliert durch die Luft schwingen und der Griff aus echtem Vogelkirschenholz absorbiert die auftretenden Vibrationen beim Spalten massiver Baumstämme oder dicker Bworkschädel.');
INSERT INTO "item_descriptions" VALUES(675,'de','Diese gewöhnlich erscheinende Axt ist sehr wirkungsvoll. Mit ihr gewann Bruce Bulgour nämlich einst den Wettkampf im Bworkzwergspalten. Das nur als kleine Erinnerung an die Wirksamkeit dieser Axt.');
INSERT INTO "item_descriptions" VALUES(676,'de','Diese Axt hat den großen Vorteil, nicht zu rosten. Das vermeidet sicherlich unliebsame Überraschungen bei allen Naschkatzen unter den Holzfällern, die gern am Ende ihres anstrengenden Tagewerkes den süßen Ahornsirup von den Axtblättern ablecken.');
INSERT INTO "item_descriptions" VALUES(677,'de','Dieser Umhang gehörte einst einem alten Piraten namens Zokrim. Er soll ein ganz schöner Pechvogel gewesen sein ...');
INSERT INTO "item_descriptions" VALUES(694,'de','Dieses Ei wurde vom Feuerdrachen Ignemikhal gelegt. Das Mindeste, was man von ihm behaupten kann, ist, dass es mächtig nach Schwefel stinkt. Aber das ist auch bloß das Mindeste...');
INSERT INTO "item_descriptions" VALUES(696,'de','Das Grobianium macht zwar den Anschein, die letzten 10 Modewechsel übersprungen zu haben, aber dafür ist es sehr wirkungsvoll im Kampf... für einen simplen Strohhut jedenfalls.');
INSERT INTO "item_descriptions" VALUES(697,'de','Der Makroute ist ein sehr anhänglicher Hund... So anhänglich, dass er denjenigen, welchen er als sein neues Herrchen auserkoren hat, nie wieder verlässt... Inzwischen dürfte er dieserart wohl an die 30 Millionen Herrchen gefunden haben.');
INSERT INTO "item_descriptions" VALUES(698,'de','Sprehs Hut enthält mächtige Magie. Lebendig und doch unsterblich hat er daher bereits die größten Magier aller Zeiten kennengelernt, wie beispielsweise Meinerve Mons Goanidgähr, Rumpelmore von der Alm und den berühmten haarigen Zocker.');
INSERT INTO "item_descriptions" VALUES(699,'de','Der Troma ist genauso zwielichtig und furchterregt wie ein Krallkopf mit Tschwantzfehdern. (Alle, die nicht wissen, was ein Krallkopf mit Tschwantzfehdern ist, können dies im großen Buch des Tschuftmann Gurus nachlesen.)');
INSERT INTO "item_descriptions" VALUES(700,'de','Ah, der Pandawa! Hat er nicht ein ziemlich aufgedunsenes Gesicht? Wie sein Freund Makroute verbringt er am Liebsten einen Großteil seiner Zeit auf dem Kopf seines Herrchens. Wenn er einmal eine bequeme Stellung gefunden hat, bleibt er dort. Nahrung und alles Weitere bezieht er dann von seinem Träger. Sehr praktisch.');
INSERT INTO "item_descriptions" VALUES(701,'de','Der Oiram hat bereits viele Anhänger auf allen Teilen der Welt gefunden, da er einfach klasse aussieht...Bevor er in eure Hände kam, wurde er lange Zeit von einem durchgeknallten Klempner getragen, der es liebte, damit durch die Gegend zu rennen und zu hüpfen.');
INSERT INTO "item_descriptions" VALUES(702,'de','Dieser Dämonenschädel, der aus den unterschiedlichsten Knöchelchen zusammengefügt wurde, wird seinen  Träger mit Anmut und Eleganz verleihen... Eure Freundinnen werden vor Neid platzen.');
INSERT INTO "item_descriptions" VALUES(703,'de','Dieser Hut ist nichts anderes als ein umgedrehter, magischer Früchtekorb. Damit werdet ihr bestimmt eure gesamte Umgebung beeindrucken können, vor allem, wenn es sich dabei um junge Bwork Magus-Lehrlinge handelt.');
INSERT INTO "item_descriptions" VALUES(704,'de','Mit diesem Hut aus miteinander verknoteten Chafer-Lederunterhosen seid ihr der neue Star... Zumindest bei den weiblichen Bwork Magi mit ihren roten Bärten und ihrer überwältigenden Weiblichkeit...');
INSERT INTO "item_descriptions" VALUES(705,'de','Wenn ihr auf der Suche nach extremen Erfahrungen seid, wird euch diese tromatisierende Gesichtsmaske den echten Kick geben. Aber keine Sorge, es ist gar nicht so schlimm, wie es aussieht. Das Innere ist gepolstert und sogar mit einem Strohhalm und Cocktails versehen.');
INSERT INTO "item_descriptions" VALUES(706,'de','Hugne, der Gedächtnislose, besaß einst eine wunderschöne Kristallkugel, die er von seinem Großvater geerbt hatte. Da er sie zur Erinnerung stets bei sich tragen wollte, befestigte er sie an der Spitze seines Hutes, auf dass sie ihn immer begleiten würde... Doch dann vergaß er sie und starb an Erschöpfung beim Versuch, sie wiederzufinden.');
INSERT INTO "item_descriptions" VALUES(707,'de','Dieser Hut aus Minotororhörnern ist sehr praktisch, um Gegnern vorzutäuschen, man sei ein gefährlicher Minotoror. Doch leider funktioniert diese List nur bei geistig etwas beschränkten Gegnern. Bei Iops und Tofus sollte das demnach gut klappen.');
INSERT INTO "item_descriptions" VALUES(708,'de','Dieser Hut aus der Haut magischer grüner Larven wird seinen Träger stets munter und fidel aussehen lassen, wenn auch gleichzeitig ziemlich albern. Man kann eben nicht alles haben im Leben. Der Träger dieses Hutes ist übrigens ein sehr gutes Beispiel hierfür.');
INSERT INTO "item_descriptions" VALUES(709,'de','Dieser Helm aus verzauberter Baumrinde gehörte einst Lorko, einem berühmten Holzfäller, der es sogar wagte, den gefürchteten Holzfäller Bruce Bulgour zu einem Ulmen-Entwurzelungsduell mit bloßen Händen bei der Lichtung von Liroye Merlin herauszufordern.');
INSERT INTO "item_descriptions" VALUES(710,'de','Do Korko Klako is o Huto und o sehr bo. So genioso, so tollo, so praktiko, doso och die bosten oller Sadidos do Korko Klako ofsetzoen wolln.');
INSERT INTO "item_descriptions" VALUES(711,'de','Diese hübsche Ledermaske gehörte einst Jouik Krampe, dem Cousin von Zeurks. Beide pflegten stets in hautenger Lederkleidung herumzulaufen. In etwa so wie der Chafer-Offizier, nur ein kleines bisschen weniger pervers.');
INSERT INTO "item_descriptions" VALUES(712,'de','Dieser Hut aus zusammengenähten Ohren ist so originell, dass ihr damit nur einzigartig aussehen könnt. Man erzählt, dass ihn einst Rakmar Bilgout getragen haben soll, um die Königin der Fresssäcke damit zu verführen. Sobald er sein Ziel erreicht hatte, soll er ihr die Kehle durchgeschnitten haben.');
INSERT INTO "item_descriptions" VALUES(732,'de','Dieser wunderschöne Ehering wurde der Bierbrauerin Silimelle während eines feucht-fröhlichen Gelages in der Taverne gestohlen. Das kommt davon, wenn man sich Unbekannten gegenüber spendabel zeigt...');
INSERT INTO "item_descriptions" VALUES(733,'de','Ragalde gehörte mit zu den tollkühnsten Iops, falls man bei Iops diesen Begriff überhaupt benutzen kann. Mit diesen Stiefeln hat er eine große Anzahl von Kreaturen aller Art niedergestreckt, die sich bei ihm unbeliebt gemacht hatten.');
INSERT INTO "item_descriptions" VALUES(734,'de','Dieser Gürtel erlaubt es, den Wächtern des Schlosses von Amakna alle Unruhestifter bei Unruhen oder Volksfesten direkt in Gewahrsam zu nehmen. Wie praktisch, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(737,'de','Dieser Dofus ist noch grüner als ein kranker Tofu. Das Ei wurde von Aerafal, dem Luftdrachen gelegt. Doch damit es so grün wurde, muss dieser ganz schön Luftkrank gewesen sein... Der Gipfel der Seltsamkeit, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(739,'de','Dieser Dofus wurde von Aguabrial, dem Wasserdrachen gelegt. Wahnsinn, was ein Drache mit Wasser alles anstellen kann...');
INSERT INTO "item_descriptions" VALUES(742,'de','"Alles wird vorübergehen... Es wird alles mal vorübergehen", schrien voller Angst "Die Rot Behosten", eine berühmt-berüchtigte Gruppe fahrender, mit dem gehörnten Stecken bewaffneter Sänger. Damit versuchten sie sich Mut zu machen, bevor sie vom gigantischen Ei eines Riesentofus zermalmt wurden.');
INSERT INTO "item_descriptions" VALUES(744,'de','Dieser Umhang verhält sich wie sein Träger: er ist absolut einzigartig und wird häufig völlig unterschätzt. 
Er besteht aus vielen zusammengenähten Häuten grüner Larven, was ihm einen pelzigen Eindruck verleiht, der den Umhang so richtig sympathisch macht.');
INSERT INTO "item_descriptions" VALUES(754,'de','Dieser blutrote Umhang wurde jahrelang in Blut getaucht. Darum ist er auch so begehrt im Rahmen des HelloTeeny - Festes.');
INSERT INTO "item_descriptions" VALUES(758,'de','Dieser Umhang kann nur von den großen Rittern der Gerechtigkeit von Bontas getragen werden, d. h. von kaum jemandem.');
INSERT INTO "item_descriptions" VALUES(759,'de','Dieser fein gearbeitete Umhang wurde aus den Federn des letzten Heenchens von Amakna gefertigt. Eine echte Seltenheit also, die von vielen Sammlern heiß begeht wird.');
INSERT INTO "item_descriptions" VALUES(765,'de','Diese Sense hat Farle Ingalsse höchstpersönlich benutzt. Ursprünglich für das Mähen jeglicher Art von Getreide konzipiert, kann man mit ihr gleichzeitig alle Arten von Monstern ummähen, die sich in den Getreidefeldern versteckt halten.');
INSERT INTO "item_descriptions" VALUES(766,'de','Dieses Amulett kratzt ein wenig am Hals, aber es wird eure Neugier reizen.');
INSERT INTO "item_descriptions" VALUES(767,'de','Trotz dieses pompösen Namens macht einen dieser Ring bloß ein wenig stärker und ein wenig dümmer.');
INSERT INTO "item_descriptions" VALUES(768,'de','Dieser Ring beeinflusst euer Schicksal. Er macht euch widerstandsfähiger, bringt euch aber dafür auch weniger Glück. Im Klartext: Er erhöht eure Chancen, länger zu leben, verringert jedoch gleichzeitig eure Chancen, glücklich zu sein.');
INSERT INTO "item_descriptions" VALUES(769,'de','Diese Stiefel bringen Glück. Dummerweise senken sie auch eure Fähigkeit, Schläge im Kampf einzustecken.');
INSERT INTO "item_descriptions" VALUES(771,'de','Diese Axt ist ja an und für sich nichts Besonderes, doch wird sie von angehenden Holzhackern gern verwendet, da sie sehr einfach zu gebrauchen ist.');
INSERT INTO "item_descriptions" VALUES(772,'de','Mit diesem legendären Mantel wird man so gut wie unbesiegbar, wenn man ihn mit der legendärsten Waffe aller Fechtmeister, dem Dart Tagnan des Muskeltieres, und der berühmten Baronen-Kugel des Mönches von Hausen kombiniert.');
INSERT INTO "item_descriptions" VALUES(773,'de','Dieser Umhang kommt aus dem fernen Land Pastatalieni, einem seltsamen Ort, wo man mit den Händen spricht. Das erklärt auch zu einem Großteil, warum er einem soviel Bewegungsfreiheit erlaubt. Zudem ist er auch noch überraschend leicht.');
INSERT INTO "item_descriptions" VALUES(774,'de','Dieser vom Mont Agues stammende Mantel führte letztendlich dazu, dass der frühere Besitzer vergiftet wurde und verstarb. Dabei soll der Mantel doch eigentlich die Lebenskraft seines Trägers stärken. Seltsam.');
INSERT INTO "item_descriptions" VALUES(775,'de','Dieser auf magische Art und Weise mit großer Sorgfalt gewobene Mantel gibt dem Träger die Fähigkeit, selbst die kleinsten Schwachstellen des Gegners aufzudecken und seine zerstörerischen Schläge genau dorthin zu plazieren.');
INSERT INTO "item_descriptions" VALUES(776,'de','Dieser Umhang gehörte einst einer gewissen Mulba, die damit beschwerliche Gegenstände transportierte, die im Rahmen ihrer Suche nach den Sieben Kristalldoubeln überirdischen Ursprunges anfielen. Man sagt außerdem, dass dieser Umhang auch erheblich die Stärke seines Trägers erhöhen soll.');
INSERT INTO "item_descriptions" VALUES(777,'de','Morgenappell auf der Hühnerfarm: "All'' inn'' Rei'' "! Da sich der alte Hahn auch nach 20 "Rei'' "-Rufen nicht blicken ließ, sollte er gerupft werden. Doch er entging der Strafe, da er nach 3 Tagen Hetzjagd tot umfiel. "...Rei'' "schrie der Besitzer.');
INSERT INTO "item_descriptions" VALUES(778,'de','Dieser echte Mantel des Grauens ist das Beweisstück für eure Angehörigkeit zu der Bande des diabolischen und genialen Professors M. Man sagt, allein sein ständiges Pech wäre seiner unglaublichen Intelligenz ebenbürtig. Dieser Mantel kann nur von den bösesten aller Bösewichte getragen werden.');
INSERT INTO "item_descriptions" VALUES(779,'de','Dieser gewöhnlich erscheinende Mantel ist keineswegs gewöhnlich. Denn er kann seinen Träger vor den Augen all derer verstecken, die ihn gerade nicht ansehen. Wahrlich beeindruckend!');
INSERT INTO "item_descriptions" VALUES(781,'de','Dieser wunderschöne Umhang wurde speziell für den großen Strategen General Itou Lascione angefertigt. Doch kaum zog er seinen Umhang an, schon gab er seine Pläne zur Beherrschung des Universums auf und begann seine neue Laufbahn als Gärtner. Seltsam, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(782,'de','Diese Axt ist recht außergewöhnlich. Sie diente zwar ursprünglich dazu, jungen Holzhackern das Handwerk beizubringen, doch wenn sie korrekt gehandhabt wird, kann sie sogar junge, unerfahrene Astaknyden in zwei Teile spalten. Das ist doch ziemlich bemerkenswert, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(783,'de','Dieses Amulett besteht einzig und allein aus seltenen Edelhölzern und wird besonders von Holzfällern sehr geschätzt. Diese messen ihm allerdings oftmals mehr Kräfte bei, als es in Wirklichkeit hat.');
INSERT INTO "item_descriptions" VALUES(784,'de','Der "geprügelte Kater" ist der Spitzname, der einem berühmten Ecaflip gegeben wurde. Kein anderer Ecaflip war dickköpfiger als er. Allein schieres Glück rettete ihm bei mehr als einem Kampf das Leben, welches er aufgrund eines bedenklichen Mangels an Intelligenz zu verlieren drohte.');
INSERT INTO "item_descriptions" VALUES(785,'de','Dieser Ring wurde von Großvater Enutrof an Vater Enutrof vermacht und verleiht seinem Träger große Macht. Dieses Exemplar ist nur eine schwache Kopie, die nichtsdestotrotz Sammlerherzen höher schlagen lässt, egal, ob Enutrof oder nicht.');
INSERT INTO "item_descriptions" VALUES(786,'de','Dieser Anhänger, der durch Zufall bei einem falschen Handgriff des Juweliers entstanden ist, erhöht die Intelligenz seines Trägers. Allerdings verursacht er ebenfalls dröhnende Kopfschmerzen, die seine körperliche Verfassung verschlechtern.');
INSERT INTO "item_descriptions" VALUES(787,'de','Dieser seltsame kleine Ring besitzt die Fähigkeit, die Flinkheit seines Trägers zu hören, doch scheint er auch gleichzeitig Unglück anzuziehen.');
INSERT INTO "item_descriptions" VALUES(789,'de','Dieser Gürtel ist besonders bei der Jugend von Amakna sehr beliebt. Das liegt am hervorragenden Werbespruches des Sadida-Schusters bei dessen Verkauf: "Das Leben ist so kurz, bleibt hart am Ball". Inwieweit dies inspirieren soll, ist allerdings fraglich.');
INSERT INTO "item_descriptions" VALUES(790,'de','Die magische Kraft dieses Mantels wurde lange Zeit hinweg zu Unrecht überbewertet, was zum Verschwinden von so manch einem Abenteurer geführt hat, unter anderem auch des berühmt-berüchtigten Minnesänger Oh''Neins.');
INSERT INTO "item_descriptions" VALUES(791,'de','Dieser Stab besteht aus lebendigen Astaknydenwurzeln. Vorsicht, diese haben die ärgerliche Angewohnheit, sich manchmal gegen ihren Träger zu wenden. Doch wenn sie sich mal dazu entscheiden, dasselbe Ziel wie der Träger anzugreifen, kann dieser Stecken sehr effektiv sein.');
INSERT INTO "item_descriptions" VALUES(821,'de','Dies ist ein heiliges Schwert, das jungen Kriegern im Laufe ihrer Ausbildung gegeben wird.');
INSERT INTO "item_descriptions" VALUES(824,'de','Das Schwert des Ritters ist stabil und wirksam. Darum fügt es euren Gegnern auch großen Schaden zu.');
INSERT INTO "item_descriptions" VALUES(827,'de','Diese grobe Klinge ist wegen ihrer Einfachheit sehr beliebt bei den Dümmsten aller Bworks, die noch nicht einmal die Funktionsweise eines Bogens oder eines Stockes verstehen. Trotzdem verwechseln einige von ihnen hin und wieder das Heft mit der Klinge, was meist starke Lachanfälle ihrer Gegner zur Folge hat.');
INSERT INTO "item_descriptions" VALUES(828,'de','Dieser Bogen verschießt so schnelle Pfeile, dass man sie bereits von Weitem anfliegen hört. Denkt also immer daran, einen Schalldämpfer zu verwenden, wenn ihr unbemerkt bleiben möchtet.');
INSERT INTO "item_descriptions" VALUES(829,'de','Aufgrund der geringen Reichweite ist dieser Bogen nicht sehr wirkungsvoll. Dennoch kann man mit ihm die Gegner genügend schwächen, bevor man ihnen mit einer anderen Waffe oder mit Magie den Gnadenstoß verpasst.');
INSERT INTO "item_descriptions" VALUES(832,'de','Dieser Stab erhöht die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(835,'de','Dieser Stab erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(836,'de','Dieser Ring, der aus Astaknydenrinde gefertigt wurde, besitzt große Kräfte und legt damit dem Träger auch große Verantwortung auf. Doch trotz seines großen Wertes gibt es Gerüchte, die besagen, er sei verflucht.');
INSERT INTO "item_descriptions" VALUES(837,'de','Diese Stiefel erhöhen beachtlich die Stärke seines Trägers, doch verdummt dieser im Laufe der Zeit dabei auch ein wenig. Bei regelmäßiger, langjähriger Verwendung endet er dann letzten Endes als Iop.');
INSERT INTO "item_descriptions" VALUES(841,'de','Dieser Ring erhöht die AP seines Trägers im Austausch gegen seine Stärke und Intelligenz.');
INSERT INTO "item_descriptions" VALUES(849,'de','Dieser kleine Ring erhöht die Stärke seines Trägers.');
INSERT INTO "item_descriptions" VALUES(850,'de','Seltsamerweise stürzen sich die Sammler Amaknas auf diesen Ring, obwohl er keinen Pfifferling wert ist.');
INSERT INTO "item_descriptions" VALUES(851,'de','Dieser kleine Ring erhöht die Lebenskraft seines Trägers.');
INSERT INTO "item_descriptions" VALUES(852,'de','Dieser kleine Ring erhöht die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(853,'de','Dieser kleine Ring erhöht das Glück seines Trägers.');
INSERT INTO "item_descriptions" VALUES(856,'de','Dieses kleine Amulett erhöht die Flinkheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(860,'de','Dieser ärmlich aussehende Gürtel erhöht geringfügig das Glück seines Trägers. Aber immerhin besser als nichts, oder?');
INSERT INTO "item_descriptions" VALUES(861,'de','Diese Stiefel erhöhen die Stärke ihres Trägers, machen ihn aber nicht gerade schlauer. Wenn man‘s nicht im Kopf hat, muss man‘s eben in den Fäusten haben.');
INSERT INTO "item_descriptions" VALUES(862,'de','Diese Stiefel erhöhen die Intelligenz ihres Trägers und verleihen ihm dabei auch noch einen modischen Touch. Das Kirschbaumholz der Sohlen passt sich einfach nur wunderbar dem Schuhbett an.');
INSERT INTO "item_descriptions" VALUES(863,'de','Diese Stiefel erhöhen die Flinkheit ihres Trägers. Da kann man ihn doch glatt mit einem Tofu verwechseln, vor allem wenn er sich mal wieder durch seine eigene Dummheit vor allen anderen lächerlich gemacht hat.');
INSERT INTO "item_descriptions" VALUES(864,'de','Diese Stiefel erhöhen das Glück ihres Trägers. Dadurch wird dieser leichter an seltene Gegenstände herankommen, wie zum Beispiel Fresssackspeichel.');
INSERT INTO "item_descriptions" VALUES(867,'de','Dieses herrliche Amulett wurde aus den Überresten von Dracheiern handgefertigt und verfügt über eine solch eindrucksvolle Macht, dass der größte Teil der alltäglichen Gegner lieber den Rückzug antritt.');
INSERT INTO "item_descriptions" VALUES(889,'de','Diese Stiefel nehmen ihrem Träger einige geistige Arbeit ab, weshalb sie ein Muss für jeden Iop sind.');
INSERT INTO "item_descriptions" VALUES(892,'de','Diese Stiefel bestehen ganz aus Fresssackleder. Dank des Geruches, der ihnen entströmt, können sich Fresssackzüchter auch leichter den Fresssäcken nähern, um sie zu töten.');
INSERT INTO "item_descriptions" VALUES(896,'de','Einst waren diese Dolche speziell dazu geschaffen worden, Wurzeln und junge Triebe zu stutzen, doch dann bemerkte man, dass sie auch als nahezu tödliche Waffe taugen...');
INSERT INTO "item_descriptions" VALUES(900,'de','Diese gewöhnlich erscheinenden Dolche sind extrem scharf. Sie sind leicht zu verstecken, weshalb sie auch eine bevorzugte Waffe für Meuchelmörder sind.');
INSERT INTO "item_descriptions" VALUES(905,'de','Der Legende nach wurden diese Stiefel gegen andere, ebenfalls übermächtige, aber defekte Stiefel ausgetauscht, die von einem ungeschickten Schuhmacher nach vielen Monaten der Schlaflosigkeit angefertigt worden waren.');
INSERT INTO "item_descriptions" VALUES(909,'de','Diese Stiefel erlaubt es Hogmeiser, die einzigen Wesen Amaknas zu verfolgen, die er nicht ausstehen konnte, nämlich Kinder. Zum Glück für diese waren die Stiefel allerdings so schwer, dass er ihnen damit noch nicht mal einen Tritt in den Allerwertesten verpassen konnte.');
INSERT INTO "item_descriptions" VALUES(910,'de','Diese Stiefel hat Hogmeiser jahrelang getragen, doch verlor er sie eines Tages aufgrund einer dummen Wette mit Griesgrahm. Und die Moral von der Geschicht: Spiel niemals mit den Ecaflips nicht.');
INSERT INTO "item_descriptions" VALUES(911,'de','Diese Stiefel hat Hogmeiser jahrelang getragen, bis sie völlig abgenutzt waren. Nun sind sie nicht mehr verwendbar, da sie den Träger eher behindern. Doch ein sehr guter Schuhmacher sollte sie mit etwas Glück wieder flicken können.');
INSERT INTO "item_descriptions" VALUES(912,'de','Diese wunderschönen Hogmeiser Stiefel sind voll vergoldet und von einer dünnen Schicht aus Edelsteinen bedeckt, die sie unempfindlich gegen bestimmte magischen Angriffe machen. Übrigens war es genau ein solches Stiefelpaar, welches Bruce Bulgour benutzte, als er anläßlich der Eröffnung des Jahrmarktes des Trools den Kopf des Königs der Astaknyden zermalmte.');
INSERT INTO "item_descriptions" VALUES(916,'de','Silikat fertigte dieses Amulett an einem Wintermorgen für einen berühmten Abenteurer namens Rimb Vardi an. Dieser machte Jagd auf einen alten Bwork Magus, der für mehrere durch grobe Magie ausgelöste Naturkatastrophen verantwortlich war.');
INSERT INTO "item_descriptions" VALUES(917,'de','Diese Brosche wurde eines Morgens inmitten eines großen Laubwaldes aus Buchen und Ulmen in der Nähe der Insel von Olag-Lacustre erschaffen. In den Augen vieler Holzfäller ist sie eine echte Reliquie.');
INSERT INTO "item_descriptions" VALUES(919,'de','Diese äußerst mächtigen Dolche, die nach altem Wissen mit Hilfe von uraltem Bernstein geschmiedet wurden, haben ihrem Träger bei der Kolonisierung der Moon-Insel gut gedient. Doch letzten Endes wurde die Insel dann wieder der Verwilderung überlassen. Urig, aber wahr.');
INSERT INTO "item_descriptions" VALUES(923,'de','Diese Kriegsaxt wurde von Kademlia Boulgour geschmiedet, um die gefährlichsten aller Astaknyden niederstrecken zu können. Der Legende nach soll sie mit dieser legendären Waffe eines Nachts mehr Astaknyden niedergestreckt haben, als es in ganz Amakna Bäume gibt!');
INSERT INTO "item_descriptions" VALUES(924,'de','Die Flinkheit, die er mit diesen Stiefeln erlangte, ermöglichte es dem Schuhmacher R.Klimm, problemlos auf den Rücken eines jeden Fresssackes zu klettern. Leider verstarb er ziemlich früh, weil er nach einer durchzechten Nacht in der Taverne einen Fresssack mit einem Gelee verwechselte.');
INSERT INTO "item_descriptions" VALUES(927,'de','Diese Kriegsaxt wurde von Kademlia Boulgour geschmiedet, um die gefährlichsten aller Astaknyden, nämlich die Ur-Astaknyden, niederstrecken zu können. Nur die besten aller Krieger sind in der Lage, diese Waffe überhaupt zu führen.');
INSERT INTO "item_descriptions" VALUES(928,'de','Ogralimde war ein großer Krieger. Seine Ausbildung hatte er seinem Meister Adyol, einem mächtigen und erschreckend intelligenten Bwork Magus, zu verdanken. Jedoch hat im Gegensatz zu den üblichen Erzählungen hier niemals der Schüler seinen Meister übertroffen.');
INSERT INTO "item_descriptions" VALUES(934,'de','Dieser Umhang erhöht die Lebenspunkte seines Trägers.');
INSERT INTO "item_descriptions" VALUES(937,'de','Dieser Umhang erhöht das Glück seines Trägers.');
INSERT INTO "item_descriptions" VALUES(940,'de','Poupsi beschützt den Träger vor körperlichem Schaden.');
INSERT INTO "item_descriptions" VALUES(941,'de','Dieses schöne Stirnband erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(942,'de','Lizzy beschützt den Träger vor magischem Schaden.');
INSERT INTO "item_descriptions" VALUES(947,'de','Dieser Umhang erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(948,'de','Solchermaßen gewappnet könnt ihr glatt durch den ganzen Wald stolzieren, ohne erkannt zu werden. Doch seht euch vor! Es kann schnell passieren, dass den Astaknyden bei eurem Anblick der Saft in die Krone schießt.');
INSERT INTO "item_descriptions" VALUES(949,'de','Dieses Stirnband erhöht die Vitalität seines Trägers.');
INSERT INTO "item_descriptions" VALUES(952,'de','Dieser Umhang wurde aus dem Fell und diversen anderen organischen Teilen von tollwütigen WuWülfen angefertigt ... Darum kann man von ihm durchaus behaupten, er würde im wahrsten Sinne des Wortes eine Aura der Macht verbreiten.');
INSERT INTO "item_descriptions" VALUES(953,'de','Dieser mit Tofu-Federn besetzte Umhang erlaubt es seinem Träger, sehr schnell zu rennen und sehr leicht aus Gerangeln mit Angreifern zu entkommen. Jedoch sollte man damit nicht erwarten, einen heldenhaften Eindruck zu hinterlassen...');
INSERT INTO "item_descriptions" VALUES(954,'de','Das Samttuchai ist ein legendärer Umhang, der von den besten Schneidern ausschließlich für eine Gruppe von Kriegern angefertigt wird, die einen eigenen Kampfstil entwickelt haben und nur den Nahkampf für ehrenvoll halten.');
INSERT INTO "item_descriptions" VALUES(955,'de','Hillar Cape ist besonders bei Frisören besonders beliebt, da sie sich und ihre Kunden gern darin einrollen. Dadurch sollen angeblich die Haare widerstandsfähiger und kräftiger werden.');
INSERT INTO "item_descriptions" VALUES(956,'de','Dieser Mantel erhöht die Reichweite seines Trägers, wodurch selbst weit entfernte Ziele durch seine Zauber erfasst, oder die naiven Anfänger unter den Abenteurer gehörig beeindruckt werden können.');
INSERT INTO "item_descriptions" VALUES(957,'de','Das Fresssacktuch erhöht den durch seinen Träger angerichteten Schaden und seine Vitalität. Dummerweise sondert es einen strengen Geruch ab. Daher könnte es durchaus vorkommen, dass ein Fresssack euch mit einem seiner Artgenossen verwechselt.');
INSERT INTO "item_descriptions" VALUES(958,'de','Dieser Umhang gehört ohne Zweifel zu den mächtigsten der ganzen Welt. Es verstärkt alle Elementarattribute seines Trägers.');
INSERT INTO "item_descriptions" VALUES(967,'de','Dieser wunderschöne Umhang erhöht die AP, Vitalität und Weisheit seines Trägers. Ein Feuerwerk der Sinne eben!');
INSERT INTO "item_descriptions" VALUES(968,'de','Dieser wunderschöne Gürtel erhöht die AP seines Trägers, sowie dessen Vitalität und Weisheit.');
INSERT INTO "item_descriptions" VALUES(969,'de','Diese wunderschöne Krone gehörte einst dem berühmt-berüchtigten Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'de','Dieser Stecken gehörte einst dem berüchtigten Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(971,'de','Dieses königliche Gewand hat einmal der berühmte Wa Wabbit besessen. Vollgesogen mit seinem Schweiß und anderen Absonderungen wird es euch beim Tragen immer an ihn erinnern... Wie schön!');
INSERT INTO "item_descriptions" VALUES(972,'de','Wenn dieses Ei tatsächlich von einem Drachen gelegt wurde, dann wäre dieser bestimmt sehr freundlich. Naja, auf jeden Fall freundlicher als der Wa Wabbit, der sich dieses Dofus bedient, um haufenweise Abenteurer auf seine Insel zu locken, um sie dort um ihre Ausrüstung und nebenbei auch um ihren Stolz zu bringen. Das ist eine geniale und wenig kostspielige Lösung, um sich immer die neuesten Sets zu besorgen, ohne dabei die Insel verlassen zu müssen.');
INSERT INTO "item_descriptions" VALUES(976,'de','Ein Küwbiss hat die eigentümliche Eigenschaft, magische Partikel zu zerstreuen und abzulenken. Daher ist er auch ein guter magischer Isolator. Vielleicht tragen deswegen manche Krieger dieses Gemüse auf ihrem Kopf mit sich herum, wer weiß.');
INSERT INTO "item_descriptions" VALUES(1019,'de','Mit diesem Fliegerhelm auf dem Kopf seht ihr wirklich einzigartig aus... auf halbem Wege zwischen "einfach nur lächerlich" und "zum Totlachen".');
INSERT INTO "item_descriptions" VALUES(1021,'de','All diejenigen, die schon immer davon geträumt haben wie ein Kwack durch die Lüfte zu segeln – hört endlich auf zu träumen! Denn diese lächerlichen Holzflügel machen aus euch nur eine Gefahr für die Allgemeinheit sowie euch zum Gespött derselben.');
INSERT INTO "item_descriptions" VALUES(1029,'de','Der verrückte Erfinder Stek Dardar soll diese seltsamen und äußerst gefährlichen Messer bestellt haben. Niemand wußte wozu, bis er eines Tages seinem Gott einen riesigen Haufen blutigen Fleisches opferte.');
INSERT INTO "item_descriptions" VALUES(1030,'de','Dieses Paar Dolche ist in Wirklichkeit ein magisches Spielzeug, welches ursprünglich für junge Ecaflips gedacht war. Nachdem jedoch einmal der Sohn eines Sram-Anhängers mitspielte, wurden die dreißigschwänzigen Katzendolche allerdings schnell wieder verboten.');
INSERT INTO "item_descriptions" VALUES(1031,'de','Diese fein gearbeiteten Dolche sollen einmal der grausamsten Sram von ganz Amakna gehört haben. Jedenfalls einer der Grausamsten... Naja, ein wenig grausamer als alle anderen oder zumindest genauso grausam wie sie, was bereits nicht schlecht ist.');
INSERT INTO "item_descriptions" VALUES(1035,'de','Dieser Dolch wurde einst vom geheimen Orden Unta deMer gebraucht. Man sagt, dieser Orden habe beabsichtigt, Amakna ins Chaos zu stürzen. Doch seit dem Zeitpunkt, an dem angeblich Teile Sufokias untergingen, ward keiner mehr von ihnen gesehen.');
INSERT INTO "item_descriptions" VALUES(1039,'de','Diese Sram-Dolche haben eine besonders schurkenhafte Form. So schurkenhaft, dass man sich fragen könnte, ob es überhaupt Dolche sind. Wenn man die Antwort gefunden hat, ist es meist zu spät ...');
INSERT INTO "item_descriptions" VALUES(1040,'de','Ortimus Contrari ist selbst unter Meuchelmördern eine Legende. Denn Insider wissen, dass er seine Aufträge stets auf eine Art und Weise erledigt, die sich grundlegend von den traditionellen Methoden unterscheidet. Mehr solltet ihr zu eurer eigenen Sicherheit darüber jedoch nicht wissen, da ihr sonst sofort sterben müsstet!');
INSERT INTO "item_descriptions" VALUES(1041,'de','Dieses Schwert wurde dem jungen Iop Blackcat zu seinem Ritterschlag verliehen. Leider stürzte dieser gleich bei seiner ersten Mission als Ritter und zerschmetterte sein Schwert. Er hatte nämlich einen Krachler für einen harmlosen Stein gehalten.');
INSERT INTO "item_descriptions" VALUES(1045,'de','Diese Schaufel besteht aus einem sehr seltenen Dornenholz. Einer Legende nach soll jede junge Frau beim bloßen Berühren dieser Schaufel in einen ewig andauernden Schlaf fallen. Was hingegen nicht in der Legende erwähnt wird, ist das *gähn*... jeder andere auch *gähn*... bei *gähn*... längerem Kontakt... zzzZZZzzz.');
INSERT INTO "item_descriptions" VALUES(1049,'de','Die Mischmaschschaufel ist DIE Lösung für all eure kleinen Gärtnereiproblemchen. Mit ihr könnt ihr sämtliche Radieschen aus dem Garten ausbuddeln und stolz euren Gegnern zeigen, und zwar mit der Wurzel voraus!');
INSERT INTO "item_descriptions" VALUES(1053,'de','Diese Schaufel wurde vom Familienbetrieb "Wookil Ltd." im Laufe des internen Kleinkrieges zwischen den Gruppierungen der G-Stanck Wookil Ltd. und den A-Stanck Schwarzbrader entwickelt, deren langjährige Fehde auf einen Streit an den Rechten zum Export von gegrillten Tofus zurückgeht. Es ist eine sehr gefährliche Waffe. Ihr einziger Nachteil sind die ewig fettigen Hände bei ihrem Gebrauch.');
INSERT INTO "item_descriptions" VALUES(1054,'de','Ursprünglich diente diese Kreuzung aus Schaufel und Maurerkelle als praktisches Multifunktionswerkzeug beim Bau von neuen Gebäuden. Doch dies änderte sich schnell, als sie Kill-Schrill in die Hände fiel. Dank ihrer geringen Größe und hervorrangenden Handlichkeit ist es eine perfekte und sehr überraschende Mordwaffe. Zumindest für einen ständig zugedröhnten Enutrof mit Nervenzuckungen.');
INSERT INTO "item_descriptions" VALUES(1058,'de','Die Einwohner der Insel Kutuluh pflegen schon seit langer Zeit das Handwerk, diese hässlichen Schaufeln aus Schnicks und Schnacks (besonders aus Schnacks) herzustellen. Sie taugen absolut nicht zum Graben, sollen aber angeblich lebensnotwendig auf dieser Insel sein. Vermutlich wieder einmal nur, um Geistern und unartigen Kindern Angst einzujagen. Die Einwohner der Insel Kutuluh pflegen schon seit langer Zeit das Handwerk, diese hässlichen Schaufeln aus Schnicks und Schnacks (besonders aus Schnacks) herzustellen. Sie taugen absolut nicht zum Graben, sollen aber angeblich lebensnotwendig auf dieser Insel sein. Vermutlich wieder einmal nur, um Geistern und unartigen Kindern Angst einzujagen.');
INSERT INTO "item_descriptions" VALUES(1059,'de','Diese Schaufel ist der Liebling aller Gärtner und Bauern. Sie ist beispielsweise hervorragend dazu geeignet, Kartoffeln auszugraben. Doch nichts hindert euch daran, damit auch Radieschen auszugraben und sie euren Gegner stolz mit der Wurzel voran zu präsentieren.');
INSERT INTO "item_descriptions" VALUES(1063,'de','Dies ist wieder einmal eine dieser hervorragend gearbeiteten Dualwaffen. Dieser Streitkolben mit dem perfekten Luftwiderstandsfaktor pflügt doppelt so schnell wie andere durch die Luft – und zerschmettert daher doppelt so schnell die Schädel der Gegner. Das sind mindestens zwei gute Gründe, diese Waffe zu besitzen.');
INSERT INTO "item_descriptions" VALUES(1067,'de','Es wird diesem Hammer nachgesagt, er sei ein Unikat und nach altem Brauch von den Xélor-Schmieden erschaffen worden. Manche behaupten hingegen, es handele sich dabei gar nicht um einen Hammer, sondern um einen Buchstaben mit der Form des Stempels eines Schmiedes. Wenn ihr nun wissen wollt, wer Recht hat, dann probiert ihn doch einfach auf dem Schädel eines Gegners aus und trefft eure Entscheidung.');
INSERT INTO "item_descriptions" VALUES(1071,'de','Dieser Streithammer ist besonders für die Zerschlagung von Sphären geeignet. Als zusätzlicher Effekt wird der Träger auch sehr wetterfühlig. Doch seinen Schöpfer konnte diese Eigenschaft nicht schützen; er wurde von einem Blitz erschlagen. Erst sehr viel später fand man heraus, dass der Hammer Schläge jeder Art und insbesondere Blitzschläge anzuziehen scheint.');
INSERT INTO "item_descriptions" VALUES(1075,'de','Nüscht, der Großbwork, soll einer Legende nach einst die Anfertigung dieser gefürchteten Hämmer veranlaßt haben. Dabei stellte er einem ganzen Dorf der Xélor ein Ultimatum: Nur wenn sich diese Hämmer als wirkungsvoll herausstellen sollten, würde er das Dorf verschonen. Doch kaum wurden die Hämmer geliefert, wurde das Dorf dem Erdboden gleichgemacht. Woran sonst sollte der Großbwork schließlich die Wirksamkeit der Hämmer überprüfen?');
INSERT INTO "item_descriptions" VALUES(1079,'de','Die Spuren dieses Hammers lassen sich bis zum alten, friedlichen Stamm der Thays zurückführen. Man sagt, man hätte ihn benutzt, um ihn  über schmerzhafte Muskeln zu rollen, bis der Schmerz verschwindet. Doch die Barbaren der Neuzeit nutzen ihn genau umgekehrt. Sie schlagen lachend damit auf die Muskeln der Gegner ein, bis der Schmerz auftritt.');
INSERT INTO "item_descriptions" VALUES(1083,'de','Dieser Hammer ist dermaßen lächerlich, dass sich euer Gegner bei seinem Anblick sofort kaputtlacht, während ihr ihn damit kaputtmacht.');
INSERT INTO "item_descriptions" VALUES(1084,'de','Dieser gewaltige Hammer wird euch helfen, alle Menschen, die denken, dass Stärke über Verstand siegt, eines Besseren zu belehren! (Hier das Kleingedruckte: Allerdings gilt dies nur für diejenigen, die schwächer sind als ihr. Stärkere haben bekanntlich IMMER Recht...)');
INSERT INTO "item_descriptions" VALUES(1085,'de','Die Falistos sind außergewöhnliche Schmiede (die Qualität ihrer Hämmer ist dafür Beweis genug). Es handelt sich um ehemals dämonische Anhänger Xélors, die ihren Gott verlassen haben. Diese Tat hatte jedoch schwere Folgen: nämlich ihre ständige höllische Verspätung!');
INSERT INTO "item_descriptions" VALUES(1087,'de','Dieser Ring erhöht geringfügig die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(1088,'de','Diese Maske ist eine exakte, nur leicht vergrößerte Imitation der Masken, die stolz von den wichtigen Kannibällen getragen werden.');
INSERT INTO "item_descriptions" VALUES(1095,'de','Dieser Bogen wurde speziell entworfen, um Vögel zu jagen. Er ist so leicht und einfach zu bedienen, dass damit all eure Feinde bald Federn lassen müssen.');
INSERT INTO "item_descriptions" VALUES(1104,'de','Der Eniripsa Mie Däpan fertigte eine ganze Reihe dieser spitzen Stäbe an, um gegen Diebstähle vorzugehen. Theoretisch sollen die Stäbe die Macht haben, in der Zeit zurückzureisen, um Überfälle zu verhindern. Doch in der Praxis landeten sie alle im Auge eines mächtigen und mächtig darüber erbosten Dämons.');
INSERT INTO "item_descriptions" VALUES(1112,'de','"Aus einem Fresssack lässt sich alles machen!", war der Slogan eines Händlers, der sich auf die Wiederverwertung von Fresssäcken spezialisiert hatte. Dieser Bogen ist ein gutes Beispiel dafür. Sieht zwar nicht sehr ästhetisch aus, ist aber dafür sehr wirkungsvoll.');
INSERT INTO "item_descriptions" VALUES(1116,'de','Dieses Sondermodell eines Bogens, welches es nur im hohen Norden Amaknas zu kaufen gibt, ist spottbillig. Allerdings muss man es auch selbst zusammenbauen, so dass das Endergebnis stark von der Kompetenz des Bastlers abhängt.');
INSERT INTO "item_descriptions" VALUES(1120,'de','Der Bauplan dieses uralten Bogens wurde in den Tiefen der Ruinen von Din von einem Abenteurer gefunden, der wegen seiner Peitsche gefürchtet war. Es ist allerdings nicht bekannt, ob die Gerüchte wahr sind, er habe sein altes, krachmachendes Lederding gegen diesen wunderschönen, biologisch abbaubaren Bogen eingetauscht.');
INSERT INTO "item_descriptions" VALUES(1124,'de','Nehmen Sie einen alten, gebrauchten Bogen, streuen Sie etwas Wunderpulver darauf und bittet einen Drachen, seinen Odem darauf zu hauchen. Sie erhalten dann einen verzauberten Bogen. Doch dieses märchenhafte Rezept funktioniert leider nicht wirklich... Drachen zielen nämlich immer daneben.');
INSERT INTO "item_descriptions" VALUES(1128,'de','Dieser wenig konventionelle Bogen wurde eigens für den selbsternannten König eines Bauerndorfes entwickelt. Er wollte sich unbedingt dadurch auszeichnen, dass er zwei Pfeile gleichzeitig abschießen konnte.');
INSERT INTO "item_descriptions" VALUES(1131,'de','Dieser schwere Stab hat bereits mehr als nur einen Sünderschädel zertrümmert. Es waren nämlich Iop-Priester, die sich seiner bedienten, um auf radikale und endgültige Weise Reuigen die Absolution zu erteilen.');
INSERT INTO "item_descriptions" VALUES(1132,'de','Dieses wahre Kunstwerk symbolisiert die Verbindung von Reinheit... und Dummheit. Übrigens scheint der Schöpfer dieses Stabes beides in hohem Maße besessen zu haben, denn er verlieh diesem Gegenstand enorme magische Kräfte.');
INSERT INTO "item_descriptions" VALUES(1136,'de','Mit diesem Stab begann die Emanzipation der Eniripsa-Hausfrauen unter 50 Jahren – fürchterlich für Monster wie für Staub zugleich. Praktisch, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(1140,'de','Houvrette hat diesen Stab erfunden, um ihren Enutrof-Ehemann aus der Bar, wo er seine Tage zubrachte, nach Hause zu holen. Bei richtiger Verwendung konnte er auch ihrer Beziehung wieder etwas Pepp verleihen, aber wie, wird nicht verraten.');
INSERT INTO "item_descriptions" VALUES(1146,'de','Man sagt, dieser Stab habe die Macht, andere zu beherrschen. Laut Anleitung soll man ihn heftig vor dem Gesicht der Zielperson hin- und herschütteln. Aber mit dem Stab auf sie eindreschen, funktioniert meist genauso gut.');
INSERT INTO "item_descriptions" VALUES(1147,'de','Dieser Stock ist ein genaues Duplikat eines legendären Artefaktes, nur etwas weniger mächtig. Doch da er bei einem Schlag auf den Boden waberndes Licht produziert (Oh!) und die Stimme seines Trägers verändert (Wah!), wird er allen anderen etwas vorgaukeln, was gar nicht stimmt: Nämlich dass ihr ein großer Magier seid.');
INSERT INTO "item_descriptions" VALUES(1151,'de','Eine Vielzahl jugendlicher Fécas besitzt irgendwo einen solchen Stecken. Das kann man schon beinahe nicht mehr eine neue Modeerscheinung nennen, das ist bereits wie eine Art zwanghaftes Ritual geworden. Jemand sollte ihnen wirklich mal sagen, dass sie damit einfach nur lächerlich aussehen.');
INSERT INTO "item_descriptions" VALUES(1157,'de','Eine schlecht sehende Féca-Seherin erschuf zufällig diese mächtige Waffe, indem sie bei einem unvorhergesehenen Sturz ihre Kristallkugel auf ihren Stock fallen ließ.');
INSERT INTO "item_descriptions" VALUES(1162,'de','Der Erfolg des Wa Wabbit-Steckens führte zum Auftauchen einer großen Anzahl an Fälschungen auf dem Markt. Alles mit dem Ziel, diesen noch leichter verkaufen zu können. Ist ja schließlich eine altbekannte Technik der Immobilienmakler.');
INSERT INTO "item_descriptions" VALUES(1331,'de','Olivia, von allen nur Oly genannt, war eine Anhängerin von Iop, deren einziges echtes Talent das Kochen war. Man munkelt, Iop höchstpersönlich habe ihr diese Medaille zugesteckt, um ihre Schwäche im Kampf auszugleichen. Denn nur Streiter reinen Herzens können diese Medaille tragen.');
INSERT INTO "item_descriptions" VALUES(1350,'de','Diesen Bogen hat ein Erz-Magier erbaut, der sich nie von seinem Flachmann trennen konnte. Um das Problem in den Griff zu bekommen, erfand er diesen mit mächtiger Wassermagie verzauberten Bogen.');
INSERT INTO "item_descriptions" VALUES(1351,'de','„Knapp vorbei ist auch daneben“, so sagt das Sprichwort. Weise Krieger meiden diesen Bogen. Es heißt nämlich, er gäbe einem den Bösen Klick beim Schießen.');
INSERT INTO "item_descriptions" VALUES(1352,'de','Dieser Bogen bezieht seine Stärke aus Erde und Wasser. Unheil all jenen, die auf Feuer und Luft schwören!');
INSERT INTO "item_descriptions" VALUES(1353,'de','Dieser Bogen, dessen Rollen alle poliert wurden, war vor langer, langer Zeit das Symbol des Kampfes zwischen Gut und Böse. Selbst heute noch glimmt in ihm die Flamme der früheren Rächer des Unheils.');
INSERT INTO "item_descriptions" VALUES(1354,'de','Hick war ein verwunschener Crâ. Er konnte machen, was er wollte – er wurde seinen Schluckauf nicht mehr los. Eines Tages tauschte er seinen Feuerbogen gegen ein Schwert. Unbegreiflicherweise verschwand das ihn plagende Übel am gleichen Tag.');
INSERT INTO "item_descriptions" VALUES(1355,'de','Der Mann, der diesen Bogen erschaffen hat – ein gewisser Mark Hidsad – hat niemals richtig gelernt, damit umzugehen. Die meiste Zeit verletzte er seine Gegner genauso schwer wie sich selbst.');
INSERT INTO "item_descriptions" VALUES(1356,'de','Die Bäckerin Rika Zarouil war dafür bekannt, die kleinste Eniripsa im Umkreis zu sein. Ihr Brot wurde in einem Stöfchen gebacken, und in den Kampf zog sie mit ihrem berühmten, halben Stäbchenbaguette.');
INSERT INTO "item_descriptions" VALUES(1357,'de','Ein etwas schelmischer Schnitzer wollte diese Stäbchen als Dolche ausgeben. Seine List war wenig erfolgreich, seine Stäbchen jedoch sehr wohl.');
INSERT INTO "item_descriptions" VALUES(1359,'de','Dieser Stab ist von unbekannter Herkunft. Dennoch hat er seinen glücklichen Besitzern immer dabei helfen können, die am wenigsten frequentierten Wege von Amakna zu finden. Dies ist vor allem an besonders geschäftigen Tagen im Herrschaftsbereich des Königlichen Fresssacks von Nutzen.');
INSERT INTO "item_descriptions" VALUES(1360,'de','Dieser Stab wurde vor vielen Jahren in den Flammen der Schmiede von Mo''Der geschmiedet. Daher ist es auch stark angeraten, immer einen Eimer Wasser in der Nähe zu haben, um notfalls sein inneres Feuer wieder löschen zu können.');
INSERT INTO "item_descriptions" VALUES(1361,'de','Der Stab der Sylvan besitzt die sonderbare Macht, seinem Träger eine hervorragende Sehschärfe zu bescheren. Jetzt fehlt nur noch genügend Flinkheit, um sich rechtzeitig aus dem Staub zu machen.');
INSERT INTO "item_descriptions" VALUES(1362,'de','Der Vampirpflock ist der Stab eines alten Vampirs, der sich vor langer Zeit aus dem Gesellschaftsleben und Metzgerdasein zurückgezogen hat. Dieses seltsame Stück Holz hat jedoch einen Teil der Fähigkeiten des alten Vampirs konserviert.');
INSERT INTO "item_descriptions" VALUES(1363,'de','Neben seinem unerträglichen Namen besitzt dieser Stock noch viele andere Eigenschaften, um seinen Träger vor Wut schier zum Platzen zu bringen.');
INSERT INTO "item_descriptions" VALUES(1364,'de','Dieser Stock lässt einen Sorgen und Kummer vergessen. Leider geht dabei mit der Zeit auch ein Großteil des Gedächtnisses verloren, während gleichzeitig die Konzentrationsfähigkeit nachlässt. Daher ist er ausschließlich den Weisen vorbehalten...');
INSERT INTO "item_descriptions" VALUES(1365,'de','Wood war ungeschlagen im Umgang mit seinem Stock. Wenn er mal loslegte, dann war die Atmosphäre um ihn herum wie elektrisch aufgeladen, das rhythmische Trommeln seiner Schläge dröhnte durch die Luft, und Gegner in seiner Umgebung wurden wie von Geisterhand umhergewirbelt.');
INSERT INTO "item_descriptions" VALUES(1366,'de','Ein solcher Hirtenstock wird üblicherweise von den Bwork-Fresssackhirten für den Almabtrieb verwendet. Bworks lieben es nämlich, Fresssäcke in feine Scheibchen geschnitten als Vorspeise zu genießen (in nicht wenigen Fällen wird dann der Hirte selbst als Hauptgericht serviert).');
INSERT INTO "item_descriptions" VALUES(1367,'de','Dieser Stock gehörte einst der hübschen Dina. Mit ihren üppigen Kurven und ihrem hoch-explosiven Charakter schuf sie einen echten Mythos um sich und den sie überallhin begleitenden Stock herum. Sie war aber auch eine echte Granate, heißt es.');
INSERT INTO "item_descriptions" VALUES(1368,'de','Die berühmten „110er“ waren eine Truppe von 110 mutigen Feuerwehrmännern in Amakna, die das gefährliche Drachennestlingsfeuer löschen konnten. Anscheinend hat dieser Wurfspeer einmal einem von ihnen gehört. Man braucht Mut und Hingabe, wenn man ihn einsetzen will.');
INSERT INTO "item_descriptions" VALUES(1369,'de','Diese Messer sollten anfangs in einem bekannten Luxusrestaurant eingesetzt werden. Doch bei ihrem eher... seltsamen... Aussehen, hat es der Restaurantbesitzer letzten Endes doch vorgezogen, sie an einen fahrenden Messerwerfer zu verkaufen.');
INSERT INTO "item_descriptions" VALUES(1370,'de','Das Heft dieser Waffe fühlt sich stets fettig und glitschig an, doch vom Aussehen her ist sie einfach unübertroffen.');
INSERT INTO "item_descriptions" VALUES(1371,'de','Öhl war ein alter Fresssackhirte im Norden Amaknas, der eines Tages inmitten eines noch dampfenden Fresssack-Dunghaufens ein Paar stark verschmutzter Dolche fand. Eine Warnung an jeden der sie nun trägt: ihr Griff ist sehr rutschig, darum kann es leicht vorkommen, dass sie einem aus der Hand gleiten.');
INSERT INTO "item_descriptions" VALUES(1372,'de','Niemand kennt das Ende von Abdul Abhau O''da Abu Putt, einem alten Einsiedler-Sram, der schon immer ein wenig an Verfolgungswahn litt. Er erwartete stets, durch ein Mitglied seiner eigenen Familie erdolcht zu werden, daher vermied er jeden Kontakt mit der Außenwelt. Nach seinem Tod fand man seine Lieblingsdolche neben seiner Leiche liegen und nur die Flinksten konnten sich noch einen von ihnen schnappen.');
INSERT INTO "item_descriptions" VALUES(1373,'de','Krys Rasni war ein alter Enutrof-Anhänger mit dichtem Bart, wie jeder wahre Enutrof, der etwas auf sich hält. Darum zog er es vor, die Rasierklingen, die ihm seine Frau Bartbara Rasni zu schenken pflegte, ausschließlich im Kampf zu gebrauchen.');
INSERT INTO "item_descriptions" VALUES(1374,'de','Tylo war ein bekannter Schreiber aus Amakna, der Steinplatten mit Dolchen gravierte. Bei dieser Arbeit war er so flink, dass man ihn damit beauftragte, eine Enzyklopädie der astrubianischen Flüche zu verfassen. Er konnte sein Werk jedoch nie beenden.');
INSERT INTO "item_descriptions" VALUES(1375,'de','Bodi Beilder war ein junger Iop, der dafür berühmt war, gewaltige Gewichte hochstemmen zu können. Unglücklicherweise für ihn gehörte Intelligenz nicht zu seinen Stärken, wie es bei den meisten muskulösen Iops der Fall ist.');
INSERT INTO "item_descriptions" VALUES(1376,'de','Diese recht schwere Axt ist ideal, um Trolle zu bekämpfen. Denn die magischen Runen auf ihren Blättern verbrennen diese Gegner gleich an Ort und Stelle.');
INSERT INTO "item_descriptions" VALUES(1377,'de','Schraxtfur war der Name, den ein junger Priester seiner mächtigen Axt gegeben hatte. Er zögerte nicht, mit seiner mächtigen Axt alle Andersgläubigen niederzustrecken, woraufhin er jedes Mal einen Strich auf das Blatt malte. Wozu dies genau dienen sollte, hat jedoch noch keiner herausgefunden...');
INSERT INTO "item_descriptions" VALUES(1378,'de','Ramms schwere Steinaxt besteht trotz ihres verwirrenden Namen aus reinem Metall. Sie hat die Eigenschaft, beim Aufschlag auf das Ziel oder auf andere Waffen einen unangenehm lauten, schrillen Ton von sich zu geben.');
INSERT INTO "item_descriptions" VALUES(1379,'de','Alten Mythen zufolge soll der Name dieses Hammers dem Geräusch nachempfunden sein, das er beim Einschlagen gegnerischer Schädel macht. Leider kann keiner der Gegner diese Legende bestätigen.');
INSERT INTO "item_descriptions" VALUES(1383,'de','Dieser Hammer ging viele Jahrzehnte lang durch die Hände Dutzender Schmiede, die jeweils ein wenig daran weitergearbeitet haben. Das Endergebnis kann sich wirklich sehen lassen, doch hat der Hammer leider von den vielen Erschaffern auch deren Vorstellungen einer kurzen Zeitdauer geerbt.');
INSERT INTO "item_descriptions" VALUES(1393,'de','Dieser Hammer wurde aus Teilen eines Uhrwerkes gebaut. Nämlich des Uhrwerkes, das vom Crocodyll verschlungen wurde, welches gleichfalls die Hand von Käpt''n Gurk verspeist hatte. Während man das Uhrwerk heil wiedergefunden hat, weiß niemand genau, was aus der Hand des Kapitäns geworden ist.');
INSERT INTO "item_descriptions" VALUES(1399,'de','Wie auch das Amulett des gleichen Namens wandelt Elnags Schlägel eure Lebensenergie direkt in magische Energie um. Nur in Maßen zu verwenden!');
INSERT INTO "item_descriptions" VALUES(1403,'de','Dieser Hammer gehörte früher Otto, einem jungen Osamodas, der den lieben langen Tag lang nur Witze erzählte. Sein Hammer ist genau wie er. Er erhöht nicht gerade die Intelligenz seiner Umgebung, doch kann er tierisch entspannend auf sie wirken.');
INSERT INTO "item_descriptions" VALUES(1404,'de','Mögt ihr Tiere? Zum Beispiel Minotorors? Tonhammeri auch. Er hat ihnen sogar sein Leben gewidmet. Dieser Hammer erzählt ein wenig seine traurige Geschichte. Beispielsweise, wie er in Gemeinschaft mit seinen Tieren lebte und mit ihnen auf die Jagd ging, genauso flink, wie ein humpelnder Fresssack auf 2 Hufen. Einfach rührend!');
INSERT INTO "item_descriptions" VALUES(1426,'de','Kuch Henweg, der Erschaffer dieser Schaufel, war ein typischer Iop. Jahrelang suchte er nach einem Schreiber, der ihm seinen Namen auf die Schaufel ritzen würde. Doch kam es nie dazu, weil er stets alle Schreiber während seiner unkontrollierbaren Jähzornattacken mit seiner Schaufel henwegzuschaufeln pflegte...');
INSERT INTO "item_descriptions" VALUES(1427,'de','Diese Schaufel wird von den kannibällischen Priestern der Moon-Insel ausschließlich dazu genutzt, Zebub zu beschwören, eine Gottheit mit dem Kopf einer Kuh. Wozu das? Wer weiß... Achtung: Nur Charaktere böser Gesinnung können diese Waffe führen!');
INSERT INTO "item_descriptions" VALUES(1431,'de','Deils Schippe ist so kunstvoll gefertigt und wunderschön anzusehen, dass alle Frauen bei ihrem Anblick schwach werden. Allerdings sollte man niemals vergessen, dass es sich dabei um eine blanke, scharfe Waffe handelt. Oder mit den Worten Deils ausgedrückt: "Sie ist so scharf, sie ist so schick, sie ist so hip, meine Schipp''!"');
INSERT INTO "item_descriptions" VALUES(1432,'de','Fel, ein alter Enutrof-Gärtner, pflegte überall im Übermaß Blumen zu pflanzen und jedem damit auf die Nerven zu gehen. Daher bekam alles, was er je anrührte, den Spitznamen "Fels Gartenschau". Seine Waffe ist kein bisschen besser: Sie ist zwar mächtig, doch tut sie alles im Überfluß und steigert nicht gerade die Intelligenz ihres Trägers.');
INSERT INTO "item_descriptions" VALUES(1433,'de','Hin war ein exzentrischer Enutrof Richter, der statt eines Hammers immer seine Schaufel verwendete, um Urteilssprüche zu verkünden. Da er auch gleichfalls unerkannterweise der Henker des Ortes war, konnte er mit ihr auch gleich das Urteil vollstrecken. Praktisch, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(1435,'de','Diese extrem schwere Schaufel ist besonders für fe... ähm... starke Abenteurer geeignet.');
INSERT INTO "item_descriptions" VALUES(1436,'de','Hansi war der Name des kleinen Affen, der den erfahrenen Kämpfer Chourros treu begleitete. Dieser war so daran gewöhnt, sich mit dem kleinen Affen zu unterhalten, dass er nach dessen Versterben kurzerhand seine Schaufel nach ihm benannte und die gewohnten Unterhaltungen ohne Unterbrechung weiterführte.');
INSERT INTO "item_descriptions" VALUES(1439,'de','Dieser Pickel neigt dazu, Murphys Auge auf den Träger zu werfen. Allerdings würde, so sagt man, gar nicht viel fehlen, damit diesem der ganz große Wurf gelingt.');
INSERT INTO "item_descriptions" VALUES(1474,'de','Dieses überaus mächtige Amulett ist das Ergebnis der langen Arbeit eines sehr alten Xélor-Anhängers zur Meisterung der Zeit.');
INSERT INTO "item_descriptions" VALUES(1475,'de','Das zöne Zwert von Zulie wurde vom berühmten Waffenschmied Dave-LoL kurz vor seinem Tode geschmiedet, der es Zulie, der zönsten Iopine des Reiches vermachte. Man sagt, die Schönheit dieses Schwertes könne sich nur mit der Schönheit seines Trägers messen... Und wenn sie nicht gestorben sind, dann zönen sie noch heute.');
INSERT INTO "item_descriptions" VALUES(1476,'de','Dieses mächtige Amulett enthält das gesamte Leben eines Krachlers, mitsamt allen Gegenständen, die dieser ins Herz geschlossen hatte. Zumindest bevor er unter den brutalen Schlägen gieriger Abenteurer nach langem Leiden sein Leben aushauchte.');
INSERT INTO "item_descriptions" VALUES(1477,'de','Mulette ist ein kleines Ecaflippchen, das in ihrem Leben noch niemals eine Glückssträhne hatte, bis sie eines Tages dieses Amulett von ihrer Großmutter bekam.');
INSERT INTO "item_descriptions" VALUES(1478,'de','Dieser Anhänger ermöglicht es seinem Träger, in Frieden und Harmonie mit der Umgebung zu leben.');
INSERT INTO "item_descriptions" VALUES(1479,'de','Dieser legendäre Hammer ging  in Amakna bereits durch viele Hände. Er gehörte einst Hautscheputt, der nie auch nur eine Sekunde zögerte, seine Gegner damit zu Klump zu schlagen.');
INSERT INTO "item_descriptions" VALUES(1480,'de','Dieser Anhänger ermöglicht es seinem Träger, in Frieden und Harmonie mit der Umgebung zu leben.');
INSERT INTO "item_descriptions" VALUES(1481,'de','Dieser Anhänger ermöglicht es seinem Träger, in Frieden und Harmonie mit der Umgebung zu leben.');
INSERT INTO "item_descriptions" VALUES(1482,'de','Dieses Amulett ist sehr nützlich, doch erscheint sein Träger damit noch weißer als ein Fresssack.');
INSERT INTO "item_descriptions" VALUES(1483,'de','Ein mysteriöses Symbol eines mysteriösen Geheimbundes. Ihr habt nichts gehört und der Bund existiert auch nicht. Ihr habt diese Beschreibung auch niemals gelesen. Sie zerstört sich selbsttätig in 5...4...3...2...1.');
INSERT INTO "item_descriptions" VALUES(1484,'de','Eine ausgezeichnete Arbeit des Goldschmied-Lehrlings Polma Kartnez, der man nachsagt, sie sei sogar besser als das Original.');
INSERT INTO "item_descriptions" VALUES(1485,'de','Dieses Amulett ist eine verbesserte Version der Goldenen Zukunft. Seltsamerweise haben beide überhaupt nichts gemein, mit Ausnahme ihres lächerlichen Aussehens.');
INSERT INTO "item_descriptions" VALUES(1486,'de','Holy war eine Anhängerin von Iop, die den Schwur ablegte, das Böse mitsamt der Wurzel herauszureißen, wo auch immer es sich verstecken mag. Ihre vollkommene Selbstbeherrschung und gefährliche Ruhe konnte einzig dadurch gebrochen werden, dass man sie mit einer gewissen Oly verglich.');
INSERT INTO "item_descriptions" VALUES(1487,'de','Dieser tolle Gürtel kleidet ihn nicht nur elegant, er massiert auch noch seinen Träger. Der glückliche Besitzer leidet dadurch viel weniger unter Stress und kann so besser nachdenken.');
INSERT INTO "item_descriptions" VALUES(1488,'de','Hinter diesem seltsamen Namen versteckt sich ein ebenso seltsamer Gegenstand, der irgendwie aus den vorhergehenden Amuletten hervorgegangen ist. Über die genauen Umstände seiner Entdeckung ist nichts bekannt.');
INSERT INTO "item_descriptions" VALUES(1489,'de','Hète war einer der größten Krieger ganz Amaknas. Der Legende nach zog er all seine Weisheit aus dieser Brosche, die er immer bei sich trug.');
INSERT INTO "item_descriptions" VALUES(1490,'de','Der Erschaffer, ein gewisser Ken Aton, war für seine seltsamen Gewohnheiten bekannt. Er verbrachte ganze Tage damit, Minotorors zu jagen, um daraus für sich selbst diverse Oberkörperbekleidungen herzustellen.');
INSERT INTO "item_descriptions" VALUES(1491,'de','Der Licha ist eine dreckige Kreatur, die dafür bekannt ist, sich bei Gruppen aus tapferen Streitern einzuschmuggeln, um sich einen Teil der Beute anzueignen. Eines Tages flog er damit auf und ist seitdem auf der Flucht.');
INSERT INTO "item_descriptions" VALUES(1493,'de','Der Stein, der diesen Ring ziert, ist derart scharf geschliffen, dass er eine Halsschlagader mit einer flüchtigen Berührung durchtrennen kann. Glücklicherweise verstehen es die Sacrieurs, diesen Schmuck geschickt zu handhaben. Sie nutzen ihn außerdem gemeinhin, um sich zu verletzen und damit ein paar Tränen zu entlocken. Ob vor Schmerz oder vor Vergnügen spielt keine Rolle: In beiden Fällen ehren sie damit ihre Göttin.');
INSERT INTO "item_descriptions" VALUES(1494,'de','Die ursprüngliche Funktion dieses Ringes war es, den Osamodas das Erkennen ihres Tofus beim Kampfe zu erleichtern.');
INSERT INTO "item_descriptions" VALUES(1495,'de','Dieser kleine Ring, der nicht nach viel aussieht, wurde von Degun hergestellt. Degun ist übrigens besser bekannt für seine plötzlichen Jähzornanfälle und seine starke Abneigung gegen den Licha, als für seine Handwerkskünste.');
INSERT INTO "item_descriptions" VALUES(1496,'de','Dieser Ring wurde angefertigt, um seinem Träger Glück beim Kartenspiel zu bringen.');
INSERT INTO "item_descriptions" VALUES(1497,'de','Dieser Ring entstand während einer Xélor-Zeitreise.');
INSERT INTO "item_descriptions" VALUES(1498,'de','Diese Ringe wurden in den Tränen eines Enutrofs abgeschreckt, der seine Schaufel verloren hatte. Das gibt einen Eindruck von der tiefen Verzweiflung dieses armen Menschen.');
INSERT INTO "item_descriptions" VALUES(1499,'de','Dieser Ring ist nur für Enutrofs bestimmt. Ihr Gott hat ihn mit einem Zauber versehen, damit er einzig von seinen Anhänger getragen werden kann. Er wird Enutrofs viel Glück bringen und sie neue Schätze entdecken lassen.');
INSERT INTO "item_descriptions" VALUES(1500,'de','Dieser tolle Umhang wurde von Hand aus verschiedenen Naturfasern gewoben, was ihn zu einem Unikat macht, sei es durch die satten Farben oder die lebendigen Schattierungen.');
INSERT INTO "item_descriptions" VALUES(1501,'de','Dieser Trauring wird das Bündnis mit dem Wesen eurer Träume besiegeln... Also: Schluss mit den kleinen Schäferstündchen hinter den Büschen! Dieses Mal geht es ums Ganze, was ihr mit diesem Ring auch jedermann zeigen könnt.');
INSERT INTO "item_descriptions" VALUES(1503,'de','Es heißt, dass es zur Herstellung dieses schaurigen Gegenstandes nötig sei, das Holz des Stabes in einen frischen Kadaver einzuführen, welcher dann anschließend beerdigt werden muss. Doch wagte es bisher noch niemand, diese Rezeptur auszuprobieren.');
INSERT INTO "item_descriptions" VALUES(1504,'de','O''Bert Rotkehl war im ganzen Umkreis für seinen schrecklichen Gesang berühmt-berüchtigt. Eines Tages, als er wieder einmal aus voller Lautstärke seinen Gesang in die schutzlosen Wälder und Wiesen hinaus-Crâ-kehlte, wurde ihm selbige von einem Unbekannten durchgeschnitten. Daher auch sein Spitzname. Der für den Mord verwendete Dolch wurde schnell wiedergefunden, doch niemand machte sich die Mühe, den Schuldigen ausfindig zu machen. O''Bert sang einfach zu schauderhaft.');
INSERT INTO "item_descriptions" VALUES(1505,'de','Diese seltene Holzflöte aus Astaknydenholz wird Kummer und Sorgen zerstreuen und eure Freunde erfreuen.');
INSERT INTO "item_descriptions" VALUES(1511,'de','Der Legende nach soll Ecaflip im Laufe der epischen Schlacht, die ihm den Rang eines Gottes bescherte, eine Waffe verwendet haben, die aus seinen eigenen Schwänzen bestand. Nämlich einen für jedes Leben, das er besaß.');
INSERT INTO "item_descriptions" VALUES(1559,'de','Dieser Ring wurde aus einem Auswuchs von Weich-Eich geschaffen, der während eines Sturmes abgerissen wurde. Nun gehört er euch, doch solltet ihr immer vermeiden, ihn in die Nähe seines rechtmäßigen Besitzers zu bringen, da es sonst passieren kann, dass er sich gegen euch wendet.');
INSERT INTO "item_descriptions" VALUES(1574,'de','Dieses Schwert gehörte einst dem inzwischen verstorbenen Kih Besans, den man überall nur den Yench-Schnitter nannte. Dies war nämlich seine Lieblingsbeschäftigung. Da sieht man es wieder: Manche Leute kann ein Nichts erfreuen.');
INSERT INTO "item_descriptions" VALUES(1602,'de','Dieser Ring ermöglicht es dem Schattenastaknyden, abends auszugehen ohne befürchten zu müssen, nicht chic genug gekleidet zu sein. Das ist vorzüglich, da es im Düsterwald immer "abends" ist.');
INSERT INTO "item_descriptions" VALUES(1619,'de','Das Astamu ist ein sehr elegantes Amulett. Wenn ihr es tragen wollt, solltet ihr nackt spazieren gehen, um das wertvolle Schmuckstück voll zur Geltung zu bringen. Ihr werdet schnell merken, dass euch die Damenwelt nicht widerstehen kann.');
INSERT INTO "item_descriptions" VALUES(1620,'de','Dieser Bogen scheint so richtig lebendig zu sein. Beinahe erwartet man, dass er die Pfeile von allein losschießen wird, ganz wie ein Großer. Er wäre daher ein idealer Bogen für alle Abenteurer mit zwei linken Händen, wenn die Pfeile nicht auch noch richtig herum eingelegt werden müssten....');
INSERT INTO "item_descriptions" VALUES(1621,'de','Die Stiefel der Meisterschaft erhöhen die Beweglichkeit und die Intelligenz ihres Trägers, beeinträchtigen jedoch seine Stärke und sein Glück. Auch wenn man dies annehmen könnte, erlauben sie euch nicht, euren Gegner zu beherrschen.');
INSERT INTO "item_descriptions" VALUES(1622,'de','Die Stiefel der Macht erhöhen die Stärke und das Glück ihres Trägers, beeinträchtigen jedoch seine Intelligenz und Beweglichkeit. Auch wenn man dies annehmen könnte, erlauben sie keine völlig irre Machtfülle.');
INSERT INTO "item_descriptions" VALUES(1623,'de','Die Stiefel der Vorhersehung erhöhen die Stärke und das Glück, verringern allerdings die Intelligenz und und das Glück ihres Trägers. Der Name mag allerdings ein wenig missverständlich sein, da diese Stiefel nicht die Aktionen eures Gegners vorhersehen können...');
INSERT INTO "item_descriptions" VALUES(1624,'de','Diese Stiefel gehörten Nexus, dem größten Ritter, der er jemals erstarrte.');
INSERT INTO "item_descriptions" VALUES(1628,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
INSERT INTO "item_descriptions" VALUES(1629,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
INSERT INTO "item_descriptions" VALUES(1630,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
INSERT INTO "item_descriptions" VALUES(1631,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
INSERT INTO "item_descriptions" VALUES(1632,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
INSERT INTO "item_descriptions" VALUES(1633,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
INSERT INTO "item_descriptions" VALUES(1639,'de','Die Schmiedin dieses schnittigen Schwerts wollte mit ihrem Meisterstück den ganzen Anmut zum Ausdruck bringen, der sich hinter ihrem bissigen Charakter verbirgt. Ein Schwert sagt wirklich mehr als Tausend Worte.');
INSERT INTO "item_descriptions" VALUES(1651,'de','Diese Klinge ist hervorragend dazu geeignet, die anderen lieben Leutchen in der Umgebung zu bedrohen: sie ist handlich, wendig und vor allem extrem scharf. Aus diesem Grunde wurde sie vor langer Zeit aus dem Handel gezogen. Aber sie wird heutzutage zur reinen Bwork-Abwehr toleriert.');
INSERT INTO "item_descriptions" VALUES(1656,'de','Dieser Ring beschützt seinen Träger vor magischen Angriffen und dadurch auch gleichzeitig vor all diesen kleinen Monstern, die ihre verborgene magischen Künste dazu missbrauchen, sich wichtig zu machen und euch auf die Nerven zu gehen.');
INSERT INTO "item_descriptions" VALUES(1657,'de','Dieser Ring beschützt seinen Träger vor körperlichen Angriffen und dadurch auch gleichzeitig vor all diesen kleinen Monstern, die ihre verborgene körperliche Stärke dazu missbrauchen, um euch zu überraschen.');
INSERT INTO "item_descriptions" VALUES(1661,'de','Einen in Bernstein eingefangenen Moskito um den Hals zu tragen, ist eine gute Art, den Gegnern zu zeigen, dass man ein gefährlicher Jäger ist... von Moskitos wenigstens. Was euch außerhalb Astrubs ziemlich lächerlich macht.');
INSERT INTO "item_descriptions" VALUES(1662,'de','Eine in Bernstein gefangene Arachnee um den Hals zu tragen, während ihr eine ihrer Schwestern angreift, könnte ausreichen, um sie komplett aus der Fassung zu bringen. Armes Tierchen. Das nennt man wohl Ironie des Schicksals.');
INSERT INTO "item_descriptions" VALUES(1665,'de','Diese seltsamen Stiefel gibt man gern den jungen Lehrlingen, die geistig ein wenig hinterherhinken. Das erlaubt es ihnen, den geistigen Abstand zu den anderen etwas zu verringern. Grundsätzlich sind sie allerdings auch für jeden Iop geeignet.');
INSERT INTO "item_descriptions" VALUES(1666,'de','Diese Stiefel wurden speziell für all diejenigen entwickelt, die in Kämpfen gerne ihren Kreaturen die ganze Arbeit überlassen.');
INSERT INTO "item_descriptions" VALUES(1667,'de','Dieser Gürtel wurde von dem alten ex-Hippie Schuhmacher Luthuthuh angefertigt, dessen Spitzname "Kraft der Liebe" lautet. Er war zwar viel weniger bekannt als der berüchtigte Bowisse, aber trotz seines Alters immer noch sehr kreativ!');
INSERT INTO "item_descriptions" VALUES(1668,'de','Der zitternde Dickmann hasste es, so genannt zu werden und entschloss sich daher, lieber seine Gegner zum Zittern zu bringen. Aus diesem Grunde bestellte er bei Bowisse diesen Gürtel, passend zur Haarfarbe. Doch seitdem zitterte der Dickmann nicht nur stärker denn je, sondern versprühte auch noch seinen Charme in alle Richtungen.');
INSERT INTO "item_descriptions" VALUES(1669,'de','Dieser Gürtel wurde für die bekannteste Crâ von Amakna angefertigt, die es genoss, ihre ohnehin schon spärliche Freizeit durch das Organisieren vieler Feste und außergewöhnlicher Events auszufüllen. Sie nutzte auch noch die kleinste Zeitspanne, um das Volk zu erfreuen, wie beispielsweise die Zeit zwischen zwei Bügelstreichen der Lederunterhose des Chafer-Offiziers.');
INSERT INTO "item_descriptions" VALUES(1693,'de','Jules Yanos, der berühmte Schneider war in erster Linie dafür bekannt, dass er seine Frau gegen einen magischen Fingerhut ausgetauscht hat. Demnach gibt es also doch noch Männer, die etwas Geschäftssinn besitzen!');
INSERT INTO "item_descriptions" VALUES(1695,'de','Man sagt, der Chafer-Offizier habe einst versucht, diesen Umhang von seinem rechtschaffenen Besitzer zu stehlen, um seine lederne Unterkleidung dadurch zu ersetzen. Doch passte er ihm nicht in dem Kram, da er seiner Meinung nach weder seine perversen Gelüste, noch seine Arglist ausreichend unterstrich.');
INSERT INTO "item_descriptions" VALUES(1697,'de','Dieser kleine Rucksack wird aus euch sicherlich keine Berühmtheit machen, doch werdet ihr in ihm eure persönlichen Utensilien leicht verstauen können.');
INSERT INTO "item_descriptions" VALUES(1698,'de','Dieser Rucksack wurde speziell dazu entwickelt, eure geernteten oder gesammelten Ressourcen aufzunehmen. Nur echte Rohstoffsammler werden diesen Rucksack tragen können (Stufe >20 im Beruf erforderlich).');
INSERT INTO "item_descriptions" VALUES(1699,'de','Dieser Rucksack ist besonders für diejenigen geeignet, die nicht allzuweit von zuhause weggehen und dabei unwichtige Sachen mitnehmen wollen, wie zum Beispiel Eschenholzbretter.');
INSERT INTO "item_descriptions" VALUES(1700,'de','Dieser hochgradig aerodynamische Gürtel wurde von Tengra Reufrus höchstpersönlich angefertigt. Er wird euch flink wie die Luft und frei wie einen Tofu machen. Oder war es umgekehrt?');
INSERT INTO "item_descriptions" VALUES(1701,'de','Dieser Gürtel besitzt viele Taschen, die es dem Träger erlauben, einen erheblichen Teil seines Inventars darin aufzubewahren.');
INSERT INTO "item_descriptions" VALUES(1702,'de','Dieser Rucksack wurde speziell dazu entwickelt, eure geernteten oder gesammelten Ressourcen aufzunehmen. Nur echte Rohstoffsammler werden diesen Rucksack tragen können (Stufe >40 im Beruf erforderlich).');
INSERT INTO "item_descriptions" VALUES(1703,'de','Dieser Rucksack wurde speziell dazu entwickelt, eure geernteten oder gesammelten Ressourcen aufzunehmen. Nur echte Rohstoffsammler werden diesen Rucksack tragen können (Stufe >60 im Beruf erforderlich).');
INSERT INTO "item_descriptions" VALUES(1704,'de','Der Legende nach soll es einen berühmten Bergmann gegeben haben, der in der Lage war, ohne Unterlaß in allen 4 Minen gleichzeitig Erz abzubauen. Dies ist doch sicher wieder einmal eine Legende, die von der "Sichel-Hammer"-Gilde erfunden wurde, um die Bergmänner zur Arbeit anzutreiben.');
INSERT INTO "item_descriptions" VALUES(1705,'de','Dieser Rucksack ist einfach ideal dafür, all eure Tränke und Brote aufzunehmen, wenn ihr für mehrere Monate auf Abenteuer auszieht – in das Labyrinth zum Beispiel.');
INSERT INTO "item_descriptions" VALUES(1707,'de','Dieser Rucksack ist einfach ideal dafür, all eure Tränke und Brote aufzunehmen, wenn ihr zu neuen, immer exotischeren Zielen aufbrecht, wie beispielsweise die Moon-Insel.');
INSERT INTO "item_descriptions" VALUES(1711,'de','Mit diesem kleinen Wonneproppen macht selbst das tägliche Gassigehen wieder Spaß. Doch aufgrund seiner wilden Abstammung sollte man ihn nicht per Hand füttern, sonst riskiert man, eben diese zu verlieren.');
INSERT INTO "item_descriptions" VALUES(1718,'de','Dieses Ringpaar wurde einst durch den schwarzen Odem von Grougalorasalar verzaubert, weshalb ihm unglaubliche Macht innewohnt, die heute jedoch leider stark zurückgegangen ist. Diese Reliquie war dem Crocoburio bestimmt, der als einziger im Stande war, diese Ringe zu tragen, ohne von ihnen beherrscht zu werden.');
INSERT INTO "item_descriptions" VALUES(1719,'de','Dieses Paar Schuhe gehörte einst dem Crocoburio. Die wenigen Charaktere, die im Stande sind, diese Schuhe anzuziehen, werden sofort von raffinierten, aber gleichzeitig auch diabolischen Plänen und Gedanken heimgesucht. Dieser Fluch soll – so will es die Legende – von den Tausenden von Schädeln herkommen, die durch diese Stiefel bereits zermalmt wurden.');
INSERT INTO "item_descriptions" VALUES(1720,'de','Grougalorasalar pflegte einzelne Knochenstücke von jedem stärkeren Gegner aufzubewahren, den er besiegt hatte. Seine Liebe für den Crocoburio brachte ihn dazu, aus diesen Fragmenten den vorliegenden mächtigen Gürtel anzufertigen.');
INSERT INTO "item_descriptions" VALUES(1728,'de','Diese kleine verspielte, knuddelige Fellkugel bringt die Herzen der Damenwelt über alle Klassen hinweg zum Schmelzen. Ein furchterregendes Tier also.');
INSERT INTO "item_descriptions" VALUES(1729,'de','Dieser Ring gehörte einst Mer, dem größten Faulpelz und Nichtsnutz von ganz Amakna. Er betrieb eine Götzenanbetung von Donutts und Rippchen.');
INSERT INTO "item_descriptions" VALUES(1739,'de','Die Spitze dieses Stabs ist brennend heiß. Aber noch rätselhafter ist der Aschegeruch, der die Vermutung nahelegt, dass sein Holz einen Waldbrand überlebt hat.');
INSERT INTO "item_descriptions" VALUES(1748,'de','Dieser kleine Wabbit ist ganz zahm. Daher wird er euch nicht beißen. Doch das gilt nicht für die anderen ...');
INSERT INTO "item_descriptions" VALUES(1904,'de','Eine mit Leder und Wolle gepolsterte Schale eines Kalk-Dracheis. Es gibt nichts Besseres, um sich gegen Standardangriffe und Blitze eines betrunkenen Bwork Magus zu verteidigen. Allerdings müsst ihr dafür mit dieser Eierschale auf dem Kopf durch die Gegend laufen.');
INSERT INTO "item_descriptions" VALUES(1908,'de','Selbst Spartagfuss, der Schnitter, hatte nicht das Glück, diesen Helm zu tragen, welcher dank der edlen Edelsteinen und qualitativ hochwertigen Verarbeitung sehr widerstandsfähig ist. Ihr seid doch ein echter Glückspilz!');
INSERT INTO "item_descriptions" VALUES(1910,'de','Dieser Mantel stammt von einem Ouginak. Man kann daher noch den schwachen Geruch seiner feuchten, warmen Schnauze wahrnehmen, welcher ein wenig dem der Zitzen eines brünftigen Fresssackweibchens ähnelt.');
INSERT INTO "item_descriptions" VALUES(1934,'de','Dieses Messer ist ein typisches Erkennungsmerkmal von Jägern. Je größer, schärfer und glänzender, desto begehrter ist es. Seltsame Kriterien... Ein Jäger, der mit dieser scharfen Waffe ausgestattet ist, kann aus seiner erlegten Beute die besten Stücke herausschneiden.');
INSERT INTO "item_descriptions" VALUES(1942,'de','Der Jagdbogen wird als die zuverlässigste Waffe eines Jägers überhaupt angesehen. Denn mit ihm kann man ein Maximum an Schaden anrichten, und das bei einem Minimum an sichtbaren Spuren.');
INSERT INTO "item_descriptions" VALUES(2061,'de','Dieser Umhang, der auf den ersten Blick nicht sehr ansprechend aussieht, ist im Kampf sehr hilfreich. Immer vorausgesetzt, man kann sich an den strengen Geruch nach verwesendem Rabling gewöhnen.');
INSERT INTO "item_descriptions" VALUES(2063,'de','Diese Stiefel wurden unter Verwendung unterschiedlicher Teile von Rablingkadavern hergestellt. Sie verleihen ihrem Träger ein seltsames Gefühl der Leichtigkeit wie nach dem Verzehr einiger gegrillter Röhrlinge.');
INSERT INTO "item_descriptions" VALUES(2066,'de','Dieser Dreizack ist eine ungefähre Nachbildung des Speers eines Kanigrou, aber dreimal so effektiv. So ähnlich wie ein Wort, das dreifach zählt, oder eine dreimal so große Pinte Bier während eines feuchtfröhlichen Abends.');
INSERT INTO "item_descriptions" VALUES(2070,'de','Dieser Knochenschädel befand sich über lange Zeit in einer Kanigroutasche. Obwohl er nun benutzt und zerkratzt aussieht, hat er dennoch all seine schönen Eigenschaften behalten.');
INSERT INTO "item_descriptions" VALUES(2074,'de','Dieser süße kleine Bwack wird später irgendwann einmal zu einem furchtbaren Kwak werden. Doch bis dahin könnt ihr ihn getrost bei euch behalten.');
INSERT INTO "item_descriptions" VALUES(2075,'de','Dieser süße kleine Bwack wird später irgendwann einmal zu einem furchtbaren Kwak werden. Doch bis dahin könnt ihr ihn getrost bei euch behalten.');
INSERT INTO "item_descriptions" VALUES(2076,'de','Dieser süße kleine Bwack wird später irgendwann einmal zu einem furchtbaren Kwak werden. Doch bis dahin könnt ihr ihn getrost bei euch behalten.');
INSERT INTO "item_descriptions" VALUES(2077,'de','Dieser süße kleine Bwack wird später irgendwann einmal zu einem furchtbaren Kwak werden. Doch bis dahin könnt ihr ihn getrost bei euch behalten.');
INSERT INTO "item_descriptions" VALUES(2094,'de','Der Schatten-Makroute ist ein Hut, der aus einem zerfetzten Makroute entstand, wobei dieser von Hand und ohne Narkose wieder zusammengenäht wurde. Daher hört er auch nur auf sein Herrchen und liebt es, Unbekannte zu beißen.');
INSERT INTO "item_descriptions" VALUES(2095,'de','Där Bär ist eine Kopfbedeckung, die aus dem Kopf eines erlegten Bären angefertigt wurde. Der Schneider, der dieses Prachtstück geschaffen hat, muss ein wahrer Meister seiner Zunft gewesen sein. Denn er hat nicht nur den seidigen Glanz des schwarzen Bärenfelles, sondern auch noch den ungläubigen und unwilligen Ausdruck des Bären beim Erlegtwerden bewahrt. Einfach großartig!');
INSERT INTO "item_descriptions" VALUES(2096,'de','Brave, der Geist, verstand es als erstes, die seltenen Dunkelweiden für andere Zwecke als zur Nahrungszubereitung zu benutzen.');
INSERT INTO "item_descriptions" VALUES(2097,'de','Dieser Pilzhut stammt von einem der verblichenen großen Fungi-Meister Amaknas. Tapfer und allseits respektiert, endete Li Ling, der Röhrling, als Füllung eines Tofu-Eier-Omeletts. Die Welt ist grausam und ungerecht...');
INSERT INTO "item_descriptions" VALUES(2104,'de','Dieser gefährlich aussehende Helm wurde aus Ouginakkörperteilen und sonstigem Unrat zusammengewürfelt. Nachdem er dann noch längere Zeit über von Gurrlo, dem Fürchterlichen, getragen wurde, bot er ein jämmerliches Bild der Verzweiflung.');
INSERT INTO "item_descriptions" VALUES(2118,'de','Mit diesem Mantel könnt ihr unentdeckt über jeden Friedhof wandern oder euch in eine Chafine verwandeln, wenn euch wieder ein Impuls nach extremen Perversitäten überkommt.');
INSERT INTO "item_descriptions" VALUES(2119,'de','Dieser Umhang verleiht euch Flüüügel. Der Rauch beim Verbrennen könnte euch sogar noch länger im Schwebezustand dahingleiten lassen.');
INSERT INTO "item_descriptions" VALUES(2154,'de','Dieser Ring wurde von Silaisie getragen.');
INSERT INTO "item_descriptions" VALUES(2155,'de','Dieses Amulett wurde von Silaisie getragen.');
INSERT INTO "item_descriptions" VALUES(2156,'de','Dieses Schwert verbreitet die Stimme der Wahrheit. Und die will bekanntlich keiner hören...');
INSERT INTO "item_descriptions" VALUES(2233,'de','Diesen Gürtel bastelten die jungen Füchse Xif und Ixof aus den Zähnen, die bei den Kämpfen auf den Wabbitschlachtfeldern auf den Boden gefallen waren. Seit dieser Zeit ist dieses Basteln bei vielen Abenteurern zur Gewohnheit geworden.');
INSERT INTO "item_descriptions" VALUES(2341,'de','Dieser Bogen wurde von Mech Riorraw erbaut. Er ist solcherart austariert, dass man damit über den Lavafluss hinwegschießen und Ziele hoch oben auf den Zinnen der Mauern von Brâkmar treffen kann, nicht mehr und nicht weniger.');
INSERT INTO "item_descriptions" VALUES(2361,'de','Dieser Bogen ist eine Erfindung des genialen Erfinders Mulic Beres. Seine maximale Reichweite ist einfach nur unglaublich. Das Problem dabei ist nur, dass die minimale Reichweite beinahe genauso weit ist.');
INSERT INTO "item_descriptions" VALUES(2367,'de','Dieser schicke Gürtel ist wunderbar für große Maskenbälle geeignet, obwohl man ihm nachsagt, bereits bei mehr als 1.000 Kämpfen dabei gewesen zu sein. Oder ging es dabei um Gelage und das Schlachten von Geflügel? So genau weiß dies niemand mehr. Doch eines ist klar: in beiden Fällen waren wertvolle Edelsteine mit im Spiel.');
INSERT INTO "item_descriptions" VALUES(2368,'de','Ramum war eine Kindheitsgefährtin von Nova, doch sie haben sich wieder aus den Augen verloren, als Ramum beschloss, ihren Schönheitsschlaf zu halten. Da Schönheit nicht ewig währt, sie aber schon, könnte dies lange Zeit in Anspruch nehmen...');
INSERT INTO "item_descriptions" VALUES(2369,'de','Dieser wunderschöne Gürtel entstand nach einer verrückten Wette. Es wurde gewettet, dass sich einer der besten und mächtigsten Gürtel von ganz Amakna noch weiter verbessern ließe, nämlich der Funkelnde Gürtel. Pakape Prométhé nahm die Wette an und gewann. Dies ist das Ergebnis.');
INSERT INTO "item_descriptions" VALUES(2370,'de','Der Vegagürtel ist ein unvergleichlich leichtgewichtiger Ausrüstungsgegenstand und verleiht euch einige Pods an Finesse in dieser Welt voller brünstiger Bworks.');
INSERT INTO "item_descriptions" VALUES(2371,'de','Dieser Gürtel wird euch von Jiva höchstpersönlich für kalte und strenge Nächte empfohlen. Flecken lassen sich ganz einfach mit Rimennelle rauswaschen.');
INSERT INTO "item_descriptions" VALUES(2372,'de','Diese Stiefel geben einem den Eindruck, als liefe man durch frisches Gras. Daher sind sie ideal für alle, deren Fussgeruch mehr an einen kranken Bwork, als an ein Minzgelee erinnert. Daher darf man sie selbst am Tisch anbehalten. Ausnahmsweise.');
INSERT INTO "item_descriptions" VALUES(2373,'de','Tragt ihr diese Stiefel auf der Moon-Insel, werdet ihr so stark schwitzen, als ob ihr an einem heißen Sommertag, mitten auf dem Dorfplatz bei den Bworks in einem Kessel schmoren würdet.');
INSERT INTO "item_descriptions" VALUES(2374,'de','Hain lebte zurückgezogen in einer kleinen Hütte tief im Wald der Astaknyden. Er hasste Besuch und sah jede andere Kreatur als Störenfried an, wobei er ihnen die genaue Größe seiner Stiefel aus der Nähe zu zeigen pflegte.');
INSERT INTO "item_descriptions" VALUES(2375,'de','Dank dieser Stiefel werden all eure versteckten und verstopften Sinne wieder geschärft. Mit ihnen werdet ihr hören können, wie der Wind die Segel eines Schiffes auf den Weiten des Assel-Meeres füllt. Auch der faulige Geruch, der den Stiefeln des Bwork-Chefs entströmt, wird euch nicht entgehen.');
INSERT INTO "item_descriptions" VALUES(2376,'de','Diese Axt wird eurem Gegner einige Schmerzen bereiten, auch wenn er heute ganz besonders früh aufgestanden ist.');
INSERT INTO "item_descriptions" VALUES(2380,'de','Dieser seltsame Mantel wurde aus Schlammresten von Blubbis gefertigt. Bisher ist noch niemand dahintergekommen, weshalb er stehenbleibt, wenn man ihn auszieht.');
INSERT INTO "item_descriptions" VALUES(2381,'de','Dieser Mantel wurde aus einem Gimpel herausgeschnitten, der ehemals auf der obersten Zinne der höchsten Burg von Amakna flatterte. Das ist sicher auch der Grund dafür, warum dem Mantel ein himmlisch feiner Geruch nach offenem Himmel anhaftet.');
INSERT INTO "item_descriptions" VALUES(2382,'de','Uhm war ein tollkühner Ecaflip, der sich rühmte, immer auf seinen Pfoten zu landen, egal aus welcher Höhe er auch fallen möge. Doch eines Tages fiel er einem hungrigen Trool vor die Füße, was diesem sehr gefiel. Am Ende des auffallend kurzen und einseitigen Gemetzels vervielfältigten sich seine Körperteile in bedenklichem Maße. Man begrub ihn überall dort, wo man seine Überreste fand. Also ein wenig überall verstreut. Vielseitig bis in den Tod.');
INSERT INTO "item_descriptions" VALUES(2383,'de','Dieser aus reinem Blutgewebe gewobene Mantel fühlt sich seltsam an. So als wäre die rötliche Färbung im Laufe der Zeit geronnen.');
INSERT INTO "item_descriptions" VALUES(2384,'de','Man könnte beinahe behaupten, diese Stiefel hätten einen gewissen... tja... bestialischen Look. Darum solltet ihr nicht überrascht sein, wenn sich ein WuWulf in euch und eure Stiefel verliebt! Möglicherweise gehört dies zu den schlimmsten Erfahrungen, die man überhaupt machen kann.');
INSERT INTO "item_descriptions" VALUES(2385,'de','Grasena ist nicht nur ideal für euren Garten, sondern kann notfalls auch noch als Fußabtreter vorm Eingang des Hauses dienen. Dieser von Sadidas für Sadidas angefertigte Umhang wird niemandem auch nur ein Haar krümmen und euch haarklein alles Unerklärliche erklären. Zudem werdet ihr damit anderen Sadidas bis aufs Haar gleichen.');
INSERT INTO "item_descriptions" VALUES(2386,'de','Dieser seltsame Umhang bezieht all seine Kraft aus seinem heruntergekommenen Aussehen. Drum behaltet für ihn folgenden Merkspruch immer im Hinterkopf: "Je schmutziger, desto nützlicher!"');
INSERT INTO "item_descriptions" VALUES(2387,'de','Zugegeben, dieser Mantel riecht sehr streng. Geht man der Sache näher nach, so stellt man fest, dass der schlimme Geruch wohl von der Mischung aus vielerlei Monsterhaaren haariger Monster stammt. Ein echtes Potpourri eben.');
INSERT INTO "item_descriptions" VALUES(2388,'de','Eines Tages zerschlug ein Ecaflip namens Dodge eine steinerne Schatzkarte in tausend Teile. Anschließend puzzelte er. Als er dachte, die ursprüngliche Karte wiederhergestellt zu haben, fertigte er daraus dieses mysteriöse Amulett. Niemand weiß hingegen, was aus dem Schatz wurde.');
INSERT INTO "item_descriptions" VALUES(2389,'de','Dodge liebte es, alles zu zerstören, was in seinen Augen wertvoll erschien. Seiner Ansicht nach war dies der Beweis für seine Existenz. Jedem das seine...');
INSERT INTO "item_descriptions" VALUES(2390,'de','Dieses Medaillon ist so gut wie vollkommen. Es erhöht beträchtlich die Weisheit seines Trägers. Das ist sehr nützlich, um bei euren Freunden einen auf weise zu machen oder so zu tun, als wärt ihr ein Musterschüler.');
INSERT INTO "item_descriptions" VALUES(2391,'de','Eine alte Redensart von Sufokia besagt: Eines guten Tages die Glückskugel, an besseren Tagen die Glückskügelchen. Was das heißen soll? Das ist nicht wirklich wichtig.');
INSERT INTO "item_descriptions" VALUES(2392,'de','Dank der vielfältigen Talente der Handwerksmeister von Amakna zeichnet sich die modifizierte Dracoleier durch ihre Vollkommenheit aus.');
INSERT INTO "item_descriptions" VALUES(2393,'de','Der Osamodas Ohnei wollte unbedingt vor den Augen der Mitglieder seiner Gilde groß dastehen, was ihn dazu bewog, ein revolutionäres Amulett anzufertigen. Die Idee kam ihm, während er seinen Freunden ein Frühstück zubereitete. Seltsam, nicht war?');
INSERT INTO "item_descriptions" VALUES(2394,'de','Vollgetankt mit Sonnenstrahlen, erwärmt das Knospenkettchen das Herz seines Trägers und vermittelt ihm ein Gefühl von Erdverbundenheit und Naturliebe. Es ist derart angenehm und leicht zu tragen, dass man mitunter glatt vergisst, es zum Schlafen abzulegen.');
INSERT INTO "item_descriptions" VALUES(2395,'de','Lard Fou war ein kleiner, bösartiger Dämon, der es liebte, sich vor andere Personen hinzupflanzen und sich dann nicht mehr zu bewegen. Er ist sehr magie-resistent, was zu dieser Zeit großen Respekt gebot. Seit dieser Zeit hat sich Lard Fou irgendwo verkrochen und wartet.');
INSERT INTO "item_descriptions" VALUES(2396,'de','Sylveline gehörte nie zu den Gescheitesten. Ihre Mutter, Lam, schenkte ihr eines Tages diese Pione und sagte: "Hier. Wenigstens du sollst eine Leuchte werden!" Sie war ja selbst auch keine. Mit diesem Geistesblitz erleuchtete sie ihre Tochter und beschien ihr den Weg in ein neues Leben.');
INSERT INTO "item_descriptions" VALUES(2397,'de','Law Bibbe war ein alter Mann, der es liebte, irgendwelche Gegenstände zu seltsamen Objekten zusammenzufügen. Eines Tages erschuf er also dieses seltsam geformte Medaillon. Als er es sich anlegte, verspürte er ein merkwürdiges Kribbeln im ganzen Körper. Ein sehr seltsames Gefühl war das...');
INSERT INTO "item_descriptions" VALUES(2398,'de','Dieses Auge wurde Melyonen vom berüchtigten Kanigrou Rook Y Balboua als Dankeschön dafür geschenkt, dass sie ihm seine jetzige Frau Ar d''rieeeeeeeeeneuh vorgestellt hatte.');
INSERT INTO "item_descriptions" VALUES(2399,'de','Jozebo Vez war ein Fressmutzüchter, also ein Züchter von entfernten Verwandten der Fresssäcke. Innerhalb seiner Herde gab es nun einige Tiere mit einem weicheren Fell als das der anderen. Diese ließen sich zu einem viel höheren Preis verkaufen, weshalb er sie mit diesem Halsband markierte.');
INSERT INTO "item_descriptions" VALUES(2400,'de','Man könnte beinahe behaupten, diese Stiefel hätten eine gewisse... dunkle Seite. Darum solltet ihr nicht überrascht sein, wenn sich ein Vampir in euch und eure Stiefel verliebt! Möglicherweise ist dies eine der schlimmsten Erfahrungen, die man überhaupt machen kann.');
INSERT INTO "item_descriptions" VALUES(2403,'de','In vergangenen Zeiten wurde dieser Gürtel gern getragen. Doch heutzutage weiß niemand genau, was ihn von anderen Gürteln unterscheiden soll. Viele wollen das Geheimnis mit eigenen Augen gesehen haben, aber niemand redet gern darüber. Also solltet ihr immer die Augen offen halten, wenn ihr den Gürtel tragt. Denn es haben bereits viele andere ein Auge auf ihn geworfen.');
INSERT INTO "item_descriptions" VALUES(2404,'de','Die Gürtelratte war trotz ihres Namens eine gewöhnlichliche Kanalkratte, die diesen Gürtel um die Hüfte geschnallt trug, um ihre Knutschflecken besser verbergen zu können.');
INSERT INTO "item_descriptions" VALUES(2409,'de','Die Flammen-Kwackapp gibt euch wirklich das bärenstarke Erscheinungsbild eines erfolgreichen Weiberheldes. Also braucht ihr die Weiber nur noch festzuhalten, wenn sie sich nicht mehr auf den Beinen halten können vor Lachen, wenn ihr mit ihr auftaucht. Seid ihr nun ein Held, der hält, was er verspricht oder nicht?');
INSERT INTO "item_descriptions" VALUES(2410,'de','Diese stylische Kopfbedeckung schützt euch wirksam vor Dünnbrettbohrern und Wurmlöchern, immer vorausgesetzt, ihr schafft es, trotz eurer Dickköpfigkeit den Hohlraum mit Inhalt auszufüllen.');
INSERT INTO "item_descriptions" VALUES(2411,'de','Dieser tolle Hut erhöht die Stärke und Intelligenz seines Träger, vorausgesetzt, dieser kann sich an den strengen Geruch gewöhnen.');
INSERT INTO "item_descriptions" VALUES(2412,'de','Dieser flammende und schillernde Umhang ist zwar wunderschön anzusehen, verleiht euch aber dennoch keine Superkräfte. Da hilft es auch nichts, ein großes "M" darauf zu sticken. Auch nicht, wenn ihr fest daran glaubt. Punkt. Basta. Schluss mit der Diskussion. Dieses Cape verleiht  k e i n e  Superkräfte, und Garantien gibt es auch keine.');
INSERT INTO "item_descriptions" VALUES(2413,'de','Solchermaßen gewappnet, könnt ihr glatt durch den ganzen Wald stolzieren, ohne erkannt zu werden. Doch seht euch vor! Es kann schnell passieren, dass den Astaknyden bei eurem Anblick der Saft in die Krone schießt.');
INSERT INTO "item_descriptions" VALUES(2414,'de','Dieses sackförmige Gewand hat alles, was man sich nur wünschen kann: es ist behaglich, widerstandsfähig, schön gefärbt und höchst selten... nur der Geruch ist eine Zumutung für jede Nasenhöhle.');
INSERT INTO "item_descriptions" VALUES(2415,'de','Die Flammen-Kwacklinge ist eine wirklich stylische Waffe. Wenn der Gegner nicht gleich vor Angst und Schrecken bibbert, so wird sie ihn trotzdem gehörig beeindrucken, während ihr ihn dann mit einem alten, aber gemeinen Trick völlig überrumpeln könnt.');
INSERT INTO "item_descriptions" VALUES(2416,'de','Im Benutzerhandbuch dieses Hammers steht, dass er eine kolossale Energiemenge freisetzt, wenn er korrekt eingesetzt wird. Schon wieder eines dieser Osamodas-Handbücher, die in Sadida übersetzt wurden...');
INSERT INTO "item_descriptions" VALUES(2417,'de','Dieser Stecken hat die berüchtigte Aggressivität alter Astaknyden beibehalten, ohne dass ihm ihr charakteristisch modriger Geruch anhaftet. Einfach ideal!');
INSERT INTO "item_descriptions" VALUES(2418,'de','Anhand dieses Bandes kann euer Herr euch immer wiederfinden, solltet ihr mal verloren gehen.');
INSERT INTO "item_descriptions" VALUES(2419,'de','Dieser Ring gehörte dem berühmten Buhz Leichtfrier, dem Retter der Neuzeit, welcher den Kultsatz prägte: "Bis zum Eni der Unenuigkeit und darosamodas hiniop."');
INSERT INTO "item_descriptions" VALUES(2420,'de','Äste von Astaknyden zu verarbeiten ist nicht leicht. Aber mit viel Ausdauer erhält man am Ende ein Armband, das gleichzeitig nüchtern, elegant und raffiniert ist. Also so ziemlich genau das Gegenteil eines Sadidas in einer Taverne.');
INSERT INTO "item_descriptions" VALUES(2421,'de','Mit diesen Sporen an den Füßen werdet ihr von nun an wie auf Eiern gehen müssen, damit sie euch nicht ungesehen von einem Sram mit schlechten Absichten gestohlen werden.');
INSERT INTO "item_descriptions" VALUES(2422,'de','Diese Stiefel sind bequem wie nichts anderes. Das Innere scheint aus einer Doppellage Fresssackwolle zu bestehen, doch kann man auch noch eine warme Flüssigkeit zwischen den Zehen rinnen fühlen. Ist das wohl eher Fresssackspeichel oder -blut? Egal.');
INSERT INTO "item_descriptions" VALUES(2423,'de','Die Wirkung dieser Stiefel könnt ihr sehr gut simulieren anhand eines Besuchs in eurer Lieblingskneipe. Dort einfach so viel trinken, wie es geht, dann noch ein wenig mehr und am nächsten Morgen habt ihr Beine, die sich so schwer und leblos anfühlen, wie nach längerem Tragen der Astaboots. Toll, was?');
INSERT INTO "item_descriptions" VALUES(2424,'de','Mit all diesen roten Federn um den Hals werdet ihr Aldo Rado ähneln, dem großen Sacrieur-Abenteurer auf der Suche nach einer goldenen Stadt.');
INSERT INTO "item_descriptions" VALUES(2425,'de','Das wohlgeformte Horn eines Fresssacks verleiht euch Ruhe und Weisheit. Analog dazu wird euch auch ein wohlgeformter Fresssackanhänger Ruhe und Weisheit verleihen. Oder das Gegenteil. Oder etwas ganz anderes. Oder aber vielleicht auch gar nichts.');
INSERT INTO "item_descriptions" VALUES(2426,'de','Diese kleine Arachnee ist der lebende Beweis, dass man ein Tierchen nicht aufspießen muss, um aus ihm ein Amulett zu machen. Sie wird euch lustig am unteren Bereich des Halsansatzes kitzeln oder gar euren Mund mit einem netten Spinnennetz schmücken.');
INSERT INTO "item_descriptions" VALUES(2427,'de','Um wie ein Flammen-Kwack in der Balzzeit herumzustolzieren, gibt es nichts besseres als diesen Gürtel. Vorausgesetzt man trägt nichts anderes.');
INSERT INTO "item_descriptions" VALUES(2428,'de','Dieser aus Wolle handgefertigte, praktische Gürtel ist sehr leicht für seine Größe. Außerdem sieht seine Wolle stets wie neu aus. Beides soll einer Legende nach daher kommen, dass Hunderte neugeborener weißer Fresssäckchen ihr Leben, ihr Blut und ihre Wolle für ihn lassen mußten.');
INSERT INTO "item_descriptions" VALUES(2429,'de','Dieser hölzerne Lendenschurz wird euch Sicherheit und Komfort bieten. Einmal pro Jahr wird allerdings eine leichte Anti-Arachneenbehandlung empfohlen. Vergleichbar einer Anti-Parasitenbehandlung bei einem Sadida, doch mit 3x weniger Mittelchen.');
INSERT INTO "item_descriptions" VALUES(2435,'de','Kig war der einzige Eniripsa, der es schaffte, alle Ecaflips auszustechen und den großen Marathon von Amakna zu gewinnen. Dank seiner handgefertigten Stiefel konnte er das Assel-Meer überqueren und alle Ecaflips hinter sich lassen, die wie vom Donner gerührt zur Kenntnis nehmen mussten, dass ein Eni über Wasser laufen kann. Der Wahnsinn!');
INSERT INTO "item_descriptions" VALUES(2438,'de','Die königliche Fresssackkapp wird immer modern bleiben, ganz gleich wohin der Trend geht. Sie ist nämlich nicht nur hochelegant, sondern beschert ihrem Träger auch noch Stärke und Intelligenz. Wahrlich königlich!');
INSERT INTO "item_descriptions" VALUES(2440,'de','Dieses Schwert weiß nicht, auf welchem Huf es tanzen soll... Darum fügt es Gegnern einfach Schaden von jedem Element zu.');
INSERT INTO "item_descriptions" VALUES(2441,'de','Dieser Ring erhöht die Lebenspunkte seines Trägers, so wie der weibliche Geruch der Konkubine des königlichen Fresssacks ihren Liebreiz erhöht.');
INSERT INTO "item_descriptions" VALUES(2442,'de','Sie glänzen golden und sie strahlen große Macht aus – alles an diesen Stiefel ist einfach nur "königlich".');
INSERT INTO "item_descriptions" VALUES(2443,'de','Dieses Amulett erhöht die Stärke und Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(2444,'de','Dieser wunderschöne Gürtel erhöht die Vitalität seines Trägers in beträchtlichem Maße und hilft ihm beim Verstauen seiner Ausrüstung. Er ist so sanft, dass man damit sogar seine Liebste fesseln kann, wenn sie sich einmal weigert, zu Hause zu bleiben, während man auf die Jagd geht.');
INSERT INTO "item_descriptions" VALUES(2445,'de','Dieses königlich sackförmige Gewand ist nicht nur extrem stylisch, sondern macht seinen Träger auch noch extrem stark!');
INSERT INTO "item_descriptions" VALUES(2446,'de','Wie kann dieser Umhang ohne Gewebe und Felle so lange halten? Diese Frage beschäftigt schon seit langer Zeit die Denker von Amakna – eine kleine, unwichtige Minderheit, die heute nicht mehr als ein Dutzend Personen umfassen mag.');
INSERT INTO "item_descriptions" VALUES(2447,'de','Mit dieser Haube auf dem Kopf könnt ihr sicher sein, dass eure Freunde in Zukunft immer davon träumen werden, in eure Nähe zu kommen. Dieses Kleidungsstück hätte sogar den Chafer-Offizier in seinen aktivsten Zeiten zufriedengestellt. Und das will etwas heißen.');
INSERT INTO "item_descriptions" VALUES(2469,'de','Kein Nägelkauen mehr mit diesem Ring. Einfach stattdessen die Finger lecken!');
INSERT INTO "item_descriptions" VALUES(2470,'de','Diese Stiefel sind sehr bequem. Zudem sind sie besonders im Sommer sehr praktisch, da ihnen ein Geruch nach Walderdbeeren entströmt, der problemlos selbst den üblen Fußgeruch eines alten Sadida mit haarigen Zehen überdecken kann.');
INSERT INTO "item_descriptions" VALUES(2471,'de','Das Schwerste an diesem Gürtel ist, den Heißhunger auf Süßkram zu unterdrücken, um ihn nicht gleich an Ort und Stelle aufzuessen.');
INSERT INTO "item_descriptions" VALUES(2472,'de','Dieses Amulett verrät eure Vorliebe für Gelee-Orgien. Es gibt sicherlich bessere Wege, sich innerhalb der Gesellschaft ins Rampenlicht zu stellen, doch wenigstens steht ihr zu eurer Schwäche.');
INSERT INTO "item_descriptions" VALUES(2473,'de','Dieser klassische Umhang ist zwar noch keine große Klasse, doch wird er sicherlich kleine Abenteurer mit großer Freude erfüllen.');
INSERT INTO "item_descriptions" VALUES(2474,'de','Eines kann er gut, dieser Hut, nämlich hübsche Mädchen in die Flucht schlagen. Doch ansonsten ist er leider nicht sehr nützlich.');
INSERT INTO "item_descriptions" VALUES(2475,'de','Dieser niedliche Ring ist besonders für Anfänger gut geeignet und wird mit Sicherheit alle kleinen Kinder oder Ecaflips sehr erfreuen.');
INSERT INTO "item_descriptions" VALUES(2476,'de','Diese Stiefel einfacher Machart sind haltbar und schützen ihren Träger vor den Gefahren des Abenteureralltages. Daher sind sie besonders für junge Krieger gut geeignet, die sich auf den beschwerlichen Weg des Abenteurerlebens begeben haben.');
INSERT INTO "item_descriptions" VALUES(2477,'de','Ein kleiner Gürtel für kleine angehende Abenteurer. Klein, aber fein!');
INSERT INTO "item_descriptions" VALUES(2478,'de','Nicht sehr stylisch, nicht sehr mächtig, aber ganz nett, wenn man das vollständige Set dazu besitzt.');
INSERT INTO "item_descriptions" VALUES(2485,'de','Der derzeitige Hit im Nordosten Amaknas.');
INSERT INTO "item_descriptions" VALUES(2489,'de','Mit diesem hocheleganten Mantel werdet ihr in Zukunft aufpassen müssen, kein Blatt vor den Mund zu bekommen.');
INSERT INTO "item_descriptions" VALUES(2498,'de','Das Vegamu hat die manchmal störende Angewohnheit, Moskitos anzuziehen, die es von weitem für eine Artgenossin halten. Da ist die Enttäuschung groß, wenn sie schließlich auf den Träger des Amulettes stoßen.');
INSERT INTO "item_descriptions" VALUES(2521,'de','Roll, die freundliche Schwester des Besitzers dieser Stiefel, war Spezialistin in astraler Ausstopftechnik. Was ist nun der Unterschied zwischen normaler und astraler Ausstopftechnik? Nun, bei der astralen Ausstopftechnik werden Kreaturen astral ausgestopft natürlich! Warum ist das bloß so schwer zu begreifen?');
INSERT INTO "item_descriptions" VALUES(2522,'de','Dank dieser Stiefel konnte der berühmte-berüchtigte Jojo die Power seiner Rundumkicks erhöhen. Ein Wunder, dass sie immer noch weiß sind...');
INSERT INTO "item_descriptions" VALUES(2523,'de','Dieser Gürtel wurde speziell dafür entwickelt, die Hüften des Träger zu schützen. Er wird euch also zu nichts Nutze sein.');
INSERT INTO "item_descriptions" VALUES(2524,'de','Der Legende nach wurde dieser Gürtel vom Kapitän Blou höchstpersönlich hergestellt. Das ist wahrscheinlich Quatsch, aber ihr glaubt es trotzdem.');
INSERT INTO "item_descriptions" VALUES(2530,'de','Diese zwar ein wenig schweren, aber todschicken Stiefel werden euch zur Königin der Nacht machen.');
INSERT INTO "item_descriptions" VALUES(2531,'de','Gleich euch hat eine Schildkröte einen wirklich sehr sehr kleinen Kopf. Das trifft sich gut, denn dieser Hut ist speziell für einen solchen konzipiert worden.');
INSERT INTO "item_descriptions" VALUES(2532,'de','Ein praktischer und widerstandsfähiger Umhang ist das. Er wird euch bestimmt nicht über Nacht zu einer Berühmtheit machen, doch da ihr das ja vorher auch nicht wart, wo ist das Problem?');
INSERT INTO "item_descriptions" VALUES(2534,'de','Dieser Umhang ist einfach ideal, sich damit abzukühlen, wenn die Sonne wieder einmal auf der Moon-Insel niederbrennt oder das heiße Blut eurer unternehmungslustigen und selbstmörderischen Freunde am Überkochen ist. Sei es, sein Mütchen zu kühlen oder einen kühlen Kopf zu bewahren, dieser Umhang wird allen Ansprüchen des modernen Abenteurers gerecht.');
INSERT INTO "item_descriptions" VALUES(2535,'de','Die Eis-Kwackapp wird euch immer mit neuen, frische Ideen versorgen, selbst wenn euch letztere gerade am Ausgehen sind. Leider ist sie nicht mächtig genug, um bei Iops zu wirken.');
INSERT INTO "item_descriptions" VALUES(2537,'de','Dieser Gürtel ist nicht nur ideal, um eure Hüften zu festigen, nein, er wird sogar auch alles andere festigen und kühl bewahren, was unterhalb der Gürtellinie liegt. Ist das nicht toll?');
INSERT INTO "item_descriptions" VALUES(2544,'de','So furchtbar scharf und unglaublich stylisch ist diese Klinge, dass sie viele Neider finden wird... wenn ihr oft in Rablingskreisen verkehrt.');
INSERT INTO "item_descriptions" VALUES(2545,'de','Diese Stiefel verleihen dem Träger ein einzigartiges Gefühl von Leichtigkeit, allerdings auch ein völlig bescheuertes Aussehen.');
INSERT INTO "item_descriptions" VALUES(2546,'de','Dank dieses hübschen Helmes werdet ihr fast so stylisch aussehen, wie der berüchtigte Meister Rab.');
INSERT INTO "item_descriptions" VALUES(2547,'de','Die besten Schneider Amaknas haben sich nach dem Dahinscheiden Meister Rabs zusammengeschlossen, um aus seinen Überresten einen prächtigen Umhang zu schaffen. Das ist ihnen definitiv gelungen. Mit diesem Umhang ist jedem sofort klar – der Meister, das seid ihr!');
INSERT INTO "item_descriptions" VALUES(2587,'de','Dieses Handbeil ist für den Holzhacker unabdinglich. Nicht, dass es sonderlich nützlich wäre – es lässt sich ja nicht einmal ein Baum damit fällen. Allerdings wirkt bereits sein bloßes Vorhandensein beruhigend.');
INSERT INTO "item_descriptions" VALUES(2589,'de','Mit dieser kleinen Axt lassen sich zwar keine Bäume fällen, jedoch kann man sich gut mit ihr gegen kleine Monster verteidigen. Allerdings sollte man das nicht versuchen, wenn es sich beim kleinen Monster um einen Minotoror handelt.');
INSERT INTO "item_descriptions" VALUES(2590,'de','Diese Axt wurde von einem angehenden Bwork-Schmied hergestellt. Sie ist gut ausgewogen und liegt prima in der Hand. Damit hat dieser Bwork DIE Axt für junge Abenteurer erschaffen.');
INSERT INTO "item_descriptions" VALUES(2592,'de','Das geringe Gewicht und die gute Griffigkeit dieser Axt vereinfachen spürbar das sichere und problemlose Fällen von Bombussen.');
INSERT INTO "item_descriptions" VALUES(2593,'de','Diese aus Oliviolettaholz bestehende Axt ist bestens dazu geeignet, den violetten Wellen der Oliviolettas zu widerstehen. Es zeigt sich hier wieder einmal, dass man Feuer mit Feuer bekämpfen muss.');
INSERT INTO "item_descriptions" VALUES(2595,'de','Diese sehr... primitive Axt... ist sehr effektiv, um Dinge zu schlagen, so lange es sich dabei nicht um Holz handelt.');
INSERT INTO "item_descriptions" VALUES(2597,'de','Diese langstielige Axt findet selbst die kleinsten Zwischenräume im Stamm von Bäumen, um diese dann mit einem Schlag in zwei Teile zu spalten. Dies ist auch sehr praktisch im Kampf. Egal ob Baum oder Nichtbaum - eine Bresche kann man immer gebrauchen.');
INSERT INTO "item_descriptions" VALUES(2600,'de','Diese gewaltige Axt verursacht ein lautes Geräusch, wenn sie auf ein Ziel niederfährt. Das hat meist zur Folge, dass die danach einsetzende Stille umso erschreckender wirkt.');
INSERT INTO "item_descriptions" VALUES(2601,'de','Darsson war ein tapferer Enutrof-Streiter, der allerdings zwei linke Hände hatte. So ließ er ständig seine Schaufel im Kampf fallen. Eines Tages kam er auf die Idee, eine Ersatz-Axt an seinem Gürtel zu befestigen. Diese hat ihm oftmals das Leben gerettet, jedenfalls solange, bis er eines Tages auch sie im Kampf fallen ließ...');
INSERT INTO "item_descriptions" VALUES(2603,'de','Diese Axt ist sehr praktisch, um widerspenstige Teile von Bäumen abzuschneiden. Besonders die kleinen Geschwülste des Stammes lassen sich leicht entfernen, wenn man einen vollkommen glatten und runden Baumstamm erhalten will.');
INSERT INTO "item_descriptions" VALUES(2604,'de','Diese Bart-Axt wird hauptsächlich von den Milizverbänden Amaknas eingesetzt. Ihre Länge und Wirksamkeit soll vermutlich Schwächen in anderen Bereichen kompensieren.');
INSERT INTO "item_descriptions" VALUES(2606,'de','Diese Axt ist voll mit Buchstaben eines primitiven Alphabets. Bela Esen war so naiv zu glauben, dass er sich dadurch mit den Bäumen unterhalten könnte. Zuletzt hat man ihn im Wald der Schattenastaknyden gesehen.');
INSERT INTO "item_descriptions" VALUES(2608,'de','Diese Axt pflegt öfters um die Welt zu reisen, wobei sie meist ganz unten anfängt. Das liegt wohl daran, dass sie tief im Süden Amaknas von einer kleinen, aber dafür sehr erfolgreichen Gruppe von Schatzsuchern geschmiedet wird.');
INSERT INTO "item_descriptions" VALUES(2612,'de','Diese langstielige Axt wird gerne von erfahrenen Seeleuten genutzt, um gewaltige Fische zu bekämpfen, die ihr Schiff angreifen. Da kann man sich bestimmt leicht vorstellen, was diese Axt für Schaden bei kleineren Monstern anrichten wird...');
INSERT INTO "item_descriptions" VALUES(2614,'de','Prinzessin Denhals war eine bildhübsche junge Prinzessin, die Frische und Liebreiz ausstrahlte. Daher kam man aus dem Staunen nicht mehr heraus, als sie bei einem Bworkangriff auf ihre Heimatstadt ihre Axt zog und ganz allein die Hälfte der gegnerischen Armee damit niedermetzelte.');
INSERT INTO "item_descriptions" VALUES(2615,'de','Diese Axt ist dafür bekannt, sehr schnell und radikal jegliche Streitereien zwischen betrunkenen Enutrofs zu beenden.');
INSERT INTO "item_descriptions" VALUES(2616,'de','Diese Axt erhielt ihren Namen aufgrund ihrer Wirksamkeit im Laufe eines brutalen Einweihungstestes: Ein Mythophobiker wurde zusammen mit dieser großen Axt in eine Halle voller Barden gesteckt.');
INSERT INTO "item_descriptions" VALUES(2629,'de','Dieser fürstliche Mantel bietet seinem Träger einen unglaublich guten Schutz. Genau dieses Modell bescherte der berühmten Schneiderin dieses Meisterwerkes großen Ruhm, bevor sie im Ansturm der Massen unterging und nie wieder gesehen ward.');
INSERT INTO "item_descriptions" VALUES(2637,'de','Diese gekrümmte Klinge aus Knochen, Horn und Knorpel ist so scharf wie die Kralle eines Ecaflips. Nun, ein wenig größer vielleicht. Und sauberer.');
INSERT INTO "item_descriptions" VALUES(2638,'de','Aus 100% natürlichen Rohstoffen gemacht, liegt dieser Krummsäbel wie eine sechste Kralle in der Hand eines Ecaflips. Doch Vorsicht: Passt gut auf, dass ihr euch nicht an eurem Schnäuzchen kratzt.');
INSERT INTO "item_descriptions" VALUES(2639,'de','Eine Ecaflip-Schmiedin kam auf die Idee, dieses Schwert zu schmieden, nachdem es ihr nicht gelungen war, die uralte Technik desselben Namens zu beherrschen. Diese Kralle würde sie zumindest nicht im Stich lassen.');
INSERT INTO "item_descriptions" VALUES(2640,'de','Dieser merkwürdig geformte Stock stammt sicherlich nicht von hier. Er riecht nach den alten, feuchten und dunklen Gassen von Brâkmar.');
INSERT INTO "item_descriptions" VALUES(2641,'de','Dieser rot-weiß und vor allem absolut stylische Hut wird immer zu eurem Wohlbehagen in allen gesellschaftlichen Belängen beitragen, selbst bei lästigen Staatsempfängen.');
INSERT INTO "item_descriptions" VALUES(2655,'de','Dieser Gürtel wurde aus den Überresten Meister Rabs gefertigt, die sorgsam wieder vernäht wurden. Damit werdet ihr mit Sicherheit eine Respektsperson. Le Tschuck persönlich hat euch zu diesem Anlaß seine Gürtelschnalle geliehen.');
INSERT INTO "item_descriptions" VALUES(2677,'de','Dieser Gürtel wurde aus den mächtigsten Teilen von Le Tschuck gebastelt, allem voran aus seinem Schlüpfer. Es gibt nichts Wirksameres, um unter den weiblichen Freibeutern für etwas Aufregung zu sorgen.');
INSERT INTO "item_descriptions" VALUES(2678,'de','Dieser Gürtel ähnelt mehr einem Lendenschurz, als einem herkömmlichen Gürtel. Einfach perfekt, wenn ihr euch hinter den Kokokos der Moon-Insel verstecken wollt oder euch heimlich an eine solche heranzumachen gedenkt.');
INSERT INTO "item_descriptions" VALUES(2681,'de','Dieser kleine Gürtel ist einfach ideal, um eure wichtigsten Körperteile vor kritischen Treffern zu schützen. Achtet allerdings vor dem Anprobieren immer darauf, dass der Schuster auch wirklich den Vorbesitzer dieses Panzers entfernt hat.');
INSERT INTO "item_descriptions" VALUES(2683,'de','Dieser kleine Gürtel ist einfach ideal, um eure wichtigsten Körperteile vor kritischen Treffern zu schützen. Achtet allerdings vor dem Anprobieren immer darauf, dass der Schuster auch wirklich den Vorbesitzer dieses Panzers entfernt hat.');
INSERT INTO "item_descriptions" VALUES(2685,'de','Dieser kleine Gürtel ist einfach ideal, um eure wichtigsten Körperteile vor kritischen Treffern zu schützen. Achtet allerdings vor dem Anprobieren immer darauf, dass der Schuster auch wirklich den Vorbesitzer dieses Panzers entfernt hat.');
INSERT INTO "item_descriptions" VALUES(2687,'de','Dieser kleine Gürtel ist einfach ideal, um eure wichtigsten Körperteile vor kritischen Treffern zu schützen. Achtet allerdings vor dem Anprobieren immer darauf, dass der Schuster auch wirklich den Vorbesitzer dieses Panzers entfernt hat.');
INSERT INTO "item_descriptions" VALUES(2688,'de','Man kann wirklich sagen: wer diesen Gürtel erst einmal anprobiert hat, der gibt ihn nie wieder her. Das ist dann nämlich auch gar nicht mehr möglich. Somit ist der Gürtel ein Segen für alle zerstreuten Professoren und Lieblingsopfer von Taschendieben.');
INSERT INTO "item_descriptions" VALUES(2689,'de','Dem Schuhmacher, der diesen Gürtel aus Resten von Dracotrutern hergestellt hat, mangelte es wahrlich an Phantasie. Ansonsten hätte er ihm wohl kaum einen so dummen Namen gegeben.');
INSERT INTO "item_descriptions" VALUES(2710,'de','Diese verbesserte und vor allem stahlverstärkte Version des klassischen Lendenschurzes "Bannisierung, grün" wurde speziell für die Jagd nach äußerst scheuen und wilden Dracotrutern in schlecht zugänglichen Gebieten entworfen.');
INSERT INTO "item_descriptions" VALUES(2803,'de','Dieser seltsame Gürtel besteht vollständig aus den Zangen und Panzern von Krebsen. Das sieht zwar toll aus und macht ihn sehr kleidsam, jedoch lässt sich der charakteristische Geruch selbst mit der mächtigsten Magie nicht ganz vertreiben. Also nicht wundern, wenn Freund und Feind lieber auf Abstand bleiben.');
INSERT INTO "item_descriptions" VALUES(2804,'de','Der berühmte WuWulf hat einige seiner Organe gespendet, um die Herstellung dieses unglaublichen Gürtels zu ermöglichen. Obwohl er doch eher merkwürdig aussieht und auch die perversesten Chafer glücklich machen würde, strotzt er geradezu vor Macht.');
INSERT INTO "item_descriptions" VALUES(2807,'de','Der Schuster Bowisse hat diesen Gürtel höchstpersönlich angefertigt und anschließend seinem Freund Bruce Bulgour geschenkt, als es diesem gelang, mit bloßen Händen Weich-Eich zu entwurzeln.');
INSERT INTO "item_descriptions" VALUES(2808,'de','Dieser Gürtel wird euch einfach unwiderstehlich machen. Bowisse empfiehlt allerdings allen seinen Trägern, mit diesem Gürtel niemals echten Schweinedrachen zu nahe zu kommen, da dies einige ihrer urigsten Instinkte auslösen könnte.');
INSERT INTO "item_descriptions" VALUES(2809,'de','Hinter diesem grotesken Namen verbirgt sich eine wunderschöne Kreation des Schusters Bowisse. Eines Tages sammelte dieser nämlich bei seinem täglichen Spaziergang im Skelett-Dungeon die Reste seiner Gegner ein und erschuf daraus dieses Prachtstück.');
INSERT INTO "item_descriptions" VALUES(2810,'de','Dieser wunderschöne rötliche Gürtel soll euch angeblich magisch helfen, euch besser zu konzentrieren und schneller zu lernen. Das macht ihn zum Traum aller Faulpelze Amaknas.');
INSERT INTO "item_descriptions" VALUES(2811,'de','Dieser Gürtel ist speziell für ganz wagemutige Abenteurer angefertigt worden. Denn damit soll man sich angeblich gefahrlos den Ouginaks nähern können. Doch wurde das bisher noch nie nachgewiesen.');
INSERT INTO "item_descriptions" VALUES(3203,'de','Die Herkunft dieses Armbandes ist sehr vage. Man geht davon aus, dass es von einem sehr gefürchteten, herbivoren und Farn rupfenden Sadidas-Kaniball-Stamm der schlimmsten Sorte abstammt. Aber vielleicht ist das auch nur eine frei erfundene Geschichte, um kleine Sadidas zu erschrecken.');
INSERT INTO "item_descriptions" VALUES(3204,'de','Dieser Gürtel ist gegenwärtig sehr in Mode in den Straßen von Bonta. Die Verzierung an der Schnalle trägt den Stempel eines bekannten Schustergeheimbundes.');
INSERT INTO "item_descriptions" VALUES(3205,'de','Dieser Gürtel ist gegenwärtig sehr in Mode in den Abwasserkanälen von Brâkmar. Wer wie ein harter Bursche erscheinen will, wird nichts Besseres finden. Wer allerdings ein harter Bursche sein will, sollte sich nach etwas Besserem umschauen.');
INSERT INTO "item_descriptions" VALUES(3206,'de','Dieser wunderschöne Gegenstand wurde den fingerfertigsten Kriegern verliehen. Er trägt sich auf der bloßen Haut und nur im Winter.');
INSERT INTO "item_descriptions" VALUES(3207,'de','Diese Stiefel sind so bequem und so leicht, dass man gar nicht genug tun kann, um sie zu bekommen. Einzig eure Gegner könnten unzufrieden sein, wenn ihr ihnen die Sohlen eurer Stiefel eingehend zu begutachten gebt. Aber selbst das ist noch nicht gesagt.');
INSERT INTO "item_descriptions" VALUES(3356,'de','Es gibt nichts Kurzweiligeres, als mit dieser goldenen Schaufel Maulwurfshügel aufzugraben, um zu entspannen. Ist es euch egal, dass sich alle Welt über euren Stil und Geschmack lustig macht? Ist es euch egal, dass ihr völlig planlos durchs Leben geht? Dann ist die Schaufel des Dudes genau das Richtige für euch!');
INSERT INTO "item_descriptions" VALUES(3357,'de','Wenn in Amakna junge Schüler nicht brav waren oder nicht lernen wollen, dann schlägt man ihnen mit diesem Hammer auf die Finger. Dieses Gerät hier hat hauptsächlich Iop-Finger auf dem Gewissen.');
INSERT INTO "item_descriptions" VALUES(3647,'de','Dieser sichelförmige Dolch diente dazu, Reisende zu zerfleischen, die sich verlaufen hatten. Seinen Namen bekam er dadurch, dass sich sein Besitzer nach dem Ausrauben seiner Opfer immer in der örtlichen Taverne zu betrinken pflegte.');
INSERT INTO "item_descriptions" VALUES(3648,'de','Wenn auch der entsprechende Chafer-Offizier bereits seit Langem aus der Welt geschieden ist, so liegt dennoch sein Dolch in euren Händen. Das solltet ihr euch wirklich bewusst machen. Denn wenn das Heft des Dolches durch die Hände des Chafer-Offizieres gegangen ist, wie sieht es dann wohl mit der Klinge aus...?');
INSERT INTO "item_descriptions" VALUES(3649,'de','Dieser Dolch ist das letzte Werk des berühmten Waffenschmiedes Dolchevito. Sonst eher versiert in Glücksspielen und anderen nicht zu empfehlenden Tätigkeiten, schuf er mit diesem Dolch ein echtes Meisterstück. Es gibt wirklich schlimmere Wege, seine Karriere zu beenden.');
INSERT INTO "item_descriptions" VALUES(3650,'de','Diese mächtigen Doppelmesser sind das Ergebnis einer Kooperation zwischen den wenigen Handwerkern, die in der Lage waren, sich über die zukünftige Richtungswahl ihres Handwerkes einig zu werden. Es waren bloß zwei. Sie starben schließlich beide an den Folgen eines Streites bei der Namenswahl für ihr gemeinsames Werk.');
INSERT INTO "item_descriptions" VALUES(3651,'de','Ein kleiner Handwerker namens Sleyhin hatte eines Tages den brillianten Einfall, diesen wunderbaren Dolch zu schmieden. Von einem Tag auf den Nächsten standen alle Kunden vor seiner Schmiede Schlange, was ihn auch zum besonderen Namen seines Dolches inspirierte.');
INSERT INTO "item_descriptions" VALUES(3652,'de','Marie Aigue wusste, wie man mit Männern umgeht. Ihr Stock wusste es auch, da er selbst die hartnäckigsten Avancen der mächtigsten Iop-Ritter zurückwies. Daher sollte es noch sehr lange Zeit dauern, bis am Ende jemand herausfand, dass Marie Aigue nichts anderes als ein Junge war, der sich als Mädchen verkleidet hatte.');
INSERT INTO "item_descriptions" VALUES(4241,'de','Dieser unüblich gefärbte Krummsäbel dient dazu, den Gegner weichzuklopfen, bevor man daran geht, selbiges mit seinem Fleische vorzunehmen. So ähnlich, wie das ein junges Ecaflippchen machen würde. Die perfekte Färbung dieses Säbels wird dadurch erhalten, dass die Klinge seit vielen Jahrhunderten in die Innereien der besiegten Gegner getaucht wird.');
INSERT INTO "item_descriptions" VALUES(4242,'de','Ursprünglich war dieser Fächer nur ein nützliches Hilfsmittel, um sich Luft zuzufächeln. Dazu wurde er einfach stetig auf und ab bewegt. Nachdem jedoch dabei einige Köpfe zu Boden gerollt waren, wurde entschieden, in Zukunft kein Metall mehr für diese Art von Gegenstand zu benutzen.');
INSERT INTO "item_descriptions" VALUES(4381,'de','Dieses seltsame Amulett erlaubt es dem Träger, selbst mitten im Kampf ein erholsames Schläfchen zu machen. So wie ein Féca es beispielweise im Kampf gegen einen Krachler machen würde.');
INSERT INTO "item_descriptions" VALUES(4382,'de','Dieses Kurzschwert mit der kalten und spitzen Klinge weckt die innersten Instinkte bei seinem Träger. Binnen kürzester Zeit wird damit jede Bewegung, so alltäglich sie auch sein mag, als heimtückiger Tiefschlag von hinten ausgeführt. Ihr solltet wirklich mal ein wenig Willenskraft einsetzen, um dieser Klinge wenigstens ein wenig zu widerstehen.');
INSERT INTO "item_descriptions" VALUES(4684,'de','Dieses Amulett enthält einen Teil der Geschichte der Krachler der Ebenen, die sich wahrscheinlich in zwei Zeilen zusammenfassen ließe, wenn sie denn jemand kennen würde. Leider sind sich die Krachler selbst da völlig im Unklaren.');
INSERT INTO "item_descriptions" VALUES(5122,'de','Honkei Konpoupzius höchstpersönlich hat dieses Amulett von einem Meisterjuwelier anfertigen lassen. Er wünschte, all seine Puppen zur gleichen Zeit ankleiden zu können, ohne warten zu müssen, bis sie verschwinden, um neue zu beschwören. Eine gängige Krankheit bei den Sadidas.');
INSERT INTO "item_descriptions" VALUES(5999,'de','Zur Herstellung dieses Stabes sind extreme Bedingungen nötig, die beinahe mit denen im Herzen der Erde vergleichbar sind. Nur dadurch sei die gewaltige Macht des Stabes zu erreichen. Das hat allerdings noch niemand überprüfen können, mit Ausnahme der Handwerksmeister, die diesen Stab angefertigt haben.');
INSERT INTO "item_descriptions" VALUES(6438,'de','Wabbel wurde aus hochschwabbeligem Material gefertigt. Drum lässt sich dieser Zauberstab (sofern man Stab dazu sagen kann) sehr schlecht handhaben. Nur beim Höhepunkt des Kampfes, wird der Stab steinhart. Schade!');
INSERT INTO "item_descriptions" VALUES(6439,'de','Überirdische Elemente wurden bei der Erschaffung dieses die Grenzen der Wirklichkeit durchstreifenden Stabes miteingearbeitet. Sein Träger wird sicher mehr als einmal glauben, er sei in der 4-ten Dimension gelandet.');
INSERT INTO "item_descriptions" VALUES(6440,'de','Dieser Stab ist nicht bloß ein Haufen gewöhnlicher Fellbüschel! Ganz und gar nicht! Denn sein Mark hat die magische Essenz der verschiedenen Fellsorten absorbiert und miteinander verbunden, so dass die gemeinsame Energie viel größer wurde als die Summe der Einzelmagien. Klingt zwar völlig verrückt, aber es hat funktioniert!');
INSERT INTO "item_descriptions" VALUES(6442,'de','Immer auf der Suche nach neuen Mitteln, um Gegner zu überraschen, befestigte der Sadida Aga Dou eines Tages ein kleines Püppchen am Ende seines Wurfspeers. Seitdem stürzen sich die pubertierenden Iopinen darauf, um das Püppchen zu fangen, was zur Folge hat, dass sie sich daran aufspießen.');
INSERT INTO "item_descriptions" VALUES(6443,'de','Der berühmte und lebensfreudige Handwerksmeister Yamato, den man zu Unrecht für seinen lächerlichen Bogen verspottet hat, war der Erste, der es wagte, eine Unzahl an Kräften in ein Amulett einzuschließen und es dann magisch zu versiegeln. Das war etwas, was schon seit Ewigkeiten als unmöglich galt.');
INSERT INTO "item_descriptions" VALUES(6444,'de','Obwohl es den selben Farbton hat wie der berühmte Türkis-Dofus, haben beide nichts weiter miteinander gemein. Doch das verhindert nicht, dass das Amulett sehr mächtig ist. Man sieht hier also, dass der Schein nicht immer trügt.');
INSERT INTO "item_descriptions" VALUES(6445,'de','Dieser wirklich perfekte Bogen hat eine sehr ausgefeilte Form. Diesbezüglich erzählt man sich, dass der Bogenschnitzer sich das Hinterteil eines Fresspäckchens als Vorlage genommen hat.');
INSERT INTO "item_descriptions" VALUES(6446,'de','Chiduc war ein Bogenschnitzer, der für seine lustigen Ticks bekannt war. Zum Beispiel war es ihm unmöglich, die Silbe "Bo" auszusprechen, ohne sofort danach herzhaft zu gähnen. Dennoch war er ein großer Bo*gähn*schnitzer.');
INSERT INTO "item_descriptions" VALUES(6449,'de','Das ideale Stück, um des Nächtens als unscheinbarer Schatten zu erscheinen oder sich gar als Meister Rab zu verkleiden, um nach der Dämmerung die jungen Mädchen von der Bäckerei zu erschrecken.');
INSERT INTO "item_descriptions" VALUES(6450,'de','Die Schusterin Dual hatte einen Liebhaber, der dafür bekannt war, immer zur Seite wegzuspringen, wenn sie auf ihn zuging. Aber von der Liebe verblendet, schenkte sie ihm trotzdem diesen wunderschönen Gürtel als Zeichen ihres geheimen Bundes.');
INSERT INTO "item_descriptions" VALUES(6451,'de','Bei diesem Bogen darf man sich zu Recht fragen, warum er einen so blöden Namen hat. Gleiches gilt für euch.');
INSERT INTO "item_descriptions" VALUES(6452,'de','Dieser hochkompliziert aussehende Bogen ist ein wahres Kunstobjekt. Der Bogenschnitzer, der ihn erschuf, ist dadurch berühmt geworden, dass er seine kontroversesten Modelle in der berüchtigten Höhle von Dok Drum ausgestellt hat, die seit Ewigkeiten für das gewöhnliche Publikum gesperrt ist.');
INSERT INTO "item_descriptions" VALUES(6453,'de','Wie man auf den ersten Blick bereits sehen kann, enthält dieser Bogen zusätzlich eine integrierte Angel, mit der sich auch all die nicht fliegenden Fische aus dem Wasser holen lassen.');
INSERT INTO "item_descriptions" VALUES(6454,'de','Dieser Ast eines Schattenastaknyden war einmal sein rechter "Arm". Daher ist er hervorragend dazu geeignet, sich im Armdrücken zu üben. Zudem gibt er eine ausgezeichnete Waffe ab, um eure Kindheitsrivalen zu terrorisieren oder Trunknyden zu foltern.');
INSERT INTO "item_descriptions" VALUES(6459,'de','Der einzige Weg in einem von Schattenbergleuten heimgesuchten Bergwerk zu überleben, ist Licht. Falls es euch nicht gelingt, ihnen ihre Kerze zu stehlen, dann tragt dieses Amulett bei euch - es wird euch Glück bringen!');
INSERT INTO "item_descriptions" VALUES(6460,'de','Diese wunderschöne Brosche ist eine Würdigung des sagenhaften Widerstands der Bergleute der Silbermine von Grimoth, die den gesamten Winter lang gegen einen Krachler der schlimmsten Sorte durchgehalten hatten, um schließlich von einem verirrten Tofu niedergestreckt zu werden.');
INSERT INTO "item_descriptions" VALUES(6461,'de','Dieses Amulett, welches speziell für alte Enutrofs entwickelt wurde, ermöglichte es Setag vor langer, langer Zeit, die Grimoth-Mine von allen Bergmann-Rivalen zu "säubern". Diese Methode ist mit Sicherheit sehr unprofessionell, aber dafür äußerst wirkungsvoll.');
INSERT INTO "item_descriptions" VALUES(6462,'de','Diese kleine Brosche hat wirklich einen gewissen Charme. Ursprünglich trugen sie nur Pechvögel, die dennoch unbedingt an den Spielen auf dem Jahrmarkt teilnehmen wollten. Doch dann hat man festgestellt, dass sie auch für epische Verfolgungsjagden bestens geeignet ist.');
INSERT INTO "item_descriptions" VALUES(6463,'de','Dieser Ring wurde von einem bekannten Schausteller angefertigt, an dessen Namen sich allerdings niemand mehr erinnern kann. Er starb bei einem Bogenschützenwettbewerb, bei dem er sich als Zielscheibe präsentierte, mit dem Kern einer wilden Sonnenblume auf dem Kopf anstelle des üblichen Kürbisses.');
INSERT INTO "item_descriptions" VALUES(6464,'de','Dieser Ring ist eine verbesserte Version des berühmten Ringes der Genugtuung. Einfach ideal, um euren kleinen Viecher die Sorgen des Kampfes zu überlassen, oder auch einfach nur, um den Dicken zu machen, indem ihr ganze Armeen von Tofus beschwört.');
INSERT INTO "item_descriptions" VALUES(6465,'de','Dok Drum fragte einst das Monster, welches seine Höhle heimsuchte, nach dem Rezept, wie man denn einen solchen Ring herstellt. Das Monster gab es ihm, im Austausch gegen einige Gefälligkeiten, die sein Leben für immer verändert haben. Zeugen sagen aus, dass er bei diesem Deal ein sehr schlechtes Geschäft gemacht haben soll...');
INSERT INTO "item_descriptions" VALUES(6466,'de','Dieses Amulett erlaubte es Shika Ingalsse bereits mehrmals, offene Rebellionen der Fresssackherde zu überleben.');
INSERT INTO "item_descriptions" VALUES(6467,'de','Niemand kennt den Besitzer dieses Ringes, was auch beabsichtigt war, da dieser nach einem verlorenen Kampf gegen eine beschworene Arachnee nicht sonderlich erpicht darauf war, erkannt zu werden. Man muss zu seiner Verteidigung allerdings hinzufügen, dass diese Arachnee auch von einem Iop kontrolliert wurde.');
INSERT INTO "item_descriptions" VALUES(6468,'de','Zu dem Zeitpunkt, zu dem die anderen Iops seines Alters zur Kommunion einen Tabi als Reittier oder ein hölzernes Goultard erhielten, schenkten seine Eltern Vald diesen Jugendring. Er mag ja weniger geeignet sein, um mit seinen Altersgenossen zu spielen, aber dafür ist er im echten Kampf sehr viel nützlicher.');
INSERT INTO "item_descriptions" VALUES(6469,'de','Dieser Ehering wurde im Verlauf von Hunderten von Ernten durch die Reibung an sechszelliger Wintergerste abgenutzt. Dennoch bleibt er das Pfand für den Bund zwischen Farle und Shika, der eines schönen Frühlings inmitten eines Gerstenfeldes geschlossen wurde.');
INSERT INTO "item_descriptions" VALUES(6470,'de','Diese wunderschönen Stiefel sind einfach ideal, um Fresssäcken in den Hintern zu treten, wenn man den Weidegrund wechseln muss oder das Dorf zu durchqueren hat. Doch funktionieren sie genauso gut bei allen vergleichbaren Aufgaben, wie z.B. Iop-Kinder dazu zu bringen, ihre Hau&Saufgaben zu machen oder zur Schule zu gehen.');
INSERT INTO "item_descriptions" VALUES(6471,'de','Diese kleinen Schuhe wurden ausgebessert, verstärkt und anschließend neu parfümiert. Dennoch lassen sie sich gut für die Jagd auf Pilzlinge verwenden, da diese vom starken Geruch der Hinterlassenschaften der Lausigen Schweinepriester über große Entfernungen hinweg angezogen werden.');
INSERT INTO "item_descriptions" VALUES(6472,'de','Mit dieser gepolsterten Schale eines Lehm-Dracheis seid ihr so gut wie unempfindlich gegen magische Blitzschläge des Bwork Magus. Gegen echte Blitzschläge bietet sie allerdings überhaupt keinen Schutz.');
INSERT INTO "item_descriptions" VALUES(6473,'de','Diese Schale eines Schiefer-Dracheis wird euch wunderbar zu Gesicht stehen, wenn ihr wisst, wie ihr sie tragen müsst. Nicht jedem ist es gegeben, eine solche Haube stilvoll zu tragen. Der beste Beweis: Iops tragen sie meist verkehrtherum.');
INSERT INTO "item_descriptions" VALUES(6474,'de','Diese Schale eines Kohle-Dracheis ist ideal, um sich diskret durch die Nacht zu bewegen oder sich vor Steinschlägen zu schützen, wie sie häufig im Gebirge vorkommen. Sie ist aber auch von unschätzbarem Wert, wenn man einen Krachler an der Steinschleuder herausfordert.');
INSERT INTO "item_descriptions" VALUES(6477,'de','Dieser nützliche Helm wird euch erlauben, klarer zu sehen, selbst wenn es taghell ist. Zudem ist er auch noch gut dazu geeignet, in den Stollen heruntergekommener Gruben hausende Kreaturen zu blenden oder Iops weiszumachen, ihr wäret selbst eine Leuchte.');
INSERT INTO "item_descriptions" VALUES(6481,'de','Dieser wunderschöne Hut wurde auf der Dora Bora-Insel im Süden der Moon-Insel angefertigt. Er ist nicht nur hervorragend zum Kämpfen geeignet, sondern kann auch als Früchteschale verwendet werden, beispielsweise um traumatisierte Grokokoko-Nüsse aufzubewahren.');
INSERT INTO "item_descriptions" VALUES(6482,'de','Dieses verbesserte Modell von Jouiks Krempe wurde aus den allerfeinsten Rohstoffen der Moon-Insel gefertigt. Das verleiht ihm auch seinen rustikalen Charme. Selbst wenn ihr damit noch nicht wie ein Kanniball ausseht, könnt ihr Gegnern mit dem Korko Kousto immer noch hervorragende Kopfstöße verpassen.');
INSERT INTO "item_descriptions" VALUES(6483,'de','Laut einer Legende soll dieser wunderliche Helm seinen Träger in einen Bronze-Bwork verwandeln. Also, ran an die schweren Jungs! Helm aufsetzen, einschmelzen und schon seid ihr im Bronzegeschäft mit drin!');
INSERT INTO "item_descriptions" VALUES(6484,'de','Wenn Dolche nicht mehr ausreichend sind, wenn sich die Götter über einen lustig machen, dann wird es Zeit, seinen eigenen Kampfstil zu entwickeln. Einige Srams haben diese Lektion wohl gelernt, während andere immer noch darauf warten, dass ihr eigener Gott ihnen zu Hilfe kommt.');
INSERT INTO "item_descriptions" VALUES(6485,'de','Der Chafer-Bogenschütze war noch nie sehr schlau oder geschickt. Darüber hinaus zittern seine Knochen ständig viel zu sehr, um anständig einen Bogen zu bedienen. Abgesehen von den zittrigen Knochen, geht es ihm also wahrscheinlich genauso wie euch.');
INSERT INTO "item_descriptions" VALUES(6491,'de','Dieses hervorragende Kleinod hat ein findiger Bogenbauer aus der fehlgeschlagenen Kreuzung eines Astaknyden mit einem Trunknyden herausgearbeitet. Für einen Holzfäller ist dies natürlich ein Reinfall, doch für einen Bogenbauer ein großer Erfolg. Könnten nur eure Eltern das Gleiche mal von euch behaupten!');
INSERT INTO "item_descriptions" VALUES(6492,'de','Dew Abstand zwischen den beiden Spitzen dieses Heckenstutzers entspwicht genau dem Abstand zwischen den Augen dew Lenalds. Wewden diese schwecklichen Wabbits denn niemals Wuhe geben?');
INSERT INTO "item_descriptions" VALUES(6493,'de','Übernehmt auch ihr den coolen "Kawott-Style" mit diesen klasse Flip-Flops aus der neuesten Kollektion. Sie werden von allen führenden Experten empfohlen, sei es für Stepptanz, rituelle Tänze oder für den amakinischen Tango nach Chafer-Offizier-Art.');
INSERT INTO "item_descriptions" VALUES(6494,'de','Dieser von den berühmtesten Eniripsas von ganz Amakna benutzte Stab ist die ideale Waffe, um Zaubersprüche auf Gegner zu wirken, oder eigene Verbündete intelligenter werden zu lassen. Damit kann man beispielsweise sogar einem Iop die Intelligenz eines Küwbiss verleihen!');
INSERT INTO "item_descriptions" VALUES(6495,'de','Dieser Stab ist nichts weiter als ein abgefallener Ast von Weich-Eich, der wiederbelebt wurde. Daher ist er auch so unglaublich mächtig. Ihr müsst ihn nur langsam nach rechts und dann schnell nach links schwingen, um Frösche vom Himmel regnen zu lassen. Es kann allerdings sein, dass ihr euch dabei zum Gespött der Zuschauer macht.');
INSERT INTO "item_descriptions" VALUES(6496,'de','Dieser Stab hat die lästige Angewohnheit, sich mitunter gegen seinen Träger zu wenden. In diesem Fall gibt man ihn am besten an den Gegner weiter, oder an einen Iop. Der wird euch am Ende sogar noch dafür danken, in dem Glauben, dass ihr ihm ein Geschenk damit machen wolltet.');
INSERT INTO "item_descriptions" VALUES(6497,'de','Die Ehefrau von Bruce Bulgour, eine Eniripsa, pflegte ihm ständig seine berühmte Bulgourde der Lichtungen zu stehlen. Um diesen Unfug zu stoppen, schnitt er ihr einen Arm und einen Flügel ab. Später hat er ihr dann diese Lichte Balgourde geschenkt, um sich bei ihr zu entschuldigen. Definitiv ein Mann, der weiß, wie man mit Frauen umgeht.');
INSERT INTO "item_descriptions" VALUES(6498,'de','Dieser Schlüpfer von mehr als respektabler Größe trägt noch die Spuren des alten Besitzers in sich, sowie einige seltsame Haare. Egal ob über den Hintern gezogen oder auf dem Kopf getragen, dieser Schlüpfer wird aus euch eine in ganz Amakna gefürchtete Persönlichkeit machen.');
INSERT INTO "item_descriptions" VALUES(6499,'de','Die Zähne dieses Amuletts haben bereits mehr Kawotten geknabbert als Bruce Bulgour Bäume entwurzelt hat. Wundert euch also nicht, wenn ihr damit immer streng nach Kawotte riecht und wenn die Tiwabbits versuchen, euren Hals zu küssen.');
INSERT INTO "item_descriptions" VALUES(6500,'de','Diese Ohren werden zwar nicht dazu beitragen, dass ihr besser hört, aber dafür erheblich dazu, dass euch eure Freunde besser in der Menge ausmachen können und eure Gegner sich bei eurem bloßen Anblick bereits totlachen, so dass ihr nichts mehr zu tun habt. Ihr werdet sehen, binnen kürzester Zeit werdet ihr diese schicken Ohren nicht mehr missen wollen.');
INSERT INTO "item_descriptions" VALUES(6501,'de','Mit diesem Rucksack auf den Schultern werdet ihr stets auf Abenteuer ausziehen können, ohne euch um so lästige Probleme wie die Nahrungsbeschaffung sorgen zu müssen. Denn auch wenn die Kawott selbst so leer ist wie der Schädel eines Iops, so wachsen die Blätter an der Oberfläche von alleine nach. Aus ihnen lässt sich ein guter Kräutertee kochen.');
INSERT INTO "item_descriptions" VALUES(6503,'de','Polpouletten sind eine Kreuzung aus einem aggressiven Flammen-Kwack und einem kränklichen Tofu. Schon seit Ewigkeiten wird die Jagd auf Polpouletten als wichtiges Ritual angesehen. Darüberhinaus ist es ein echtes Vergnügen, solch gruselige Kreaturen zu jagen.');
INSERT INTO "item_descriptions" VALUES(6504,'de','Man kennt zwar nur die Koseform von demjenigen, der diesen Hammer erschaffen hat, allerdings weiß man mit Bestimmtheit, dass er einen sehr schlechten Modegeschmack hatte. Es ist beispielsweise bekannt, dass er sich gern mit königlichem Gelee einrieb, um sich dann in den Federn eines Königlichen Tofus zu wälzen. Ohne Zweifel, manche Menschen leben weit über ihre Verhältnisse.');
INSERT INTO "item_descriptions" VALUES(6505,'de','Dieser Hammer ist perfekt dazu geeignet, gegen gehörnte Kreaturen zu kämpfen. Doch was das Einschlagen von Nägeln oder andere handwerkliche Tätigkeiten angeht... das steht auf einem anderen Tablett.');
INSERT INTO "item_descriptions" VALUES(6506,'de','Ein Bergmann der kein Tageslicht mehr erträgt, weil er zu lange in seinem Bergwerk gearbeitet hat, wird von den Enutrofs ein gogorifizierter Bergmann genannt. Versucht niemals, mit einer Kerze in die Nähe eines solchen Bergmannes zu gelangen, er könnte euch sonst nämlich leicht in Bronze verwandeln.');
INSERT INTO "item_descriptions" VALUES(6507,'de','Die Terps war eine bösartige kleine Kreatur, die mindestens genauso gefährlich und genauso unbeliebt war wie ihr Rivale, der Licha. Stets darum bestrebt, diesen zu übertreffen, erschuf sie eines Tages diesen Hammer, um ihm diesen um die Ohren zu schlagen. Stattdessen traf sie bei ihm einen Nerv... Und das war der Beginn einer großen Liebesgeschichte voller Leidenschaft.');
INSERT INTO "item_descriptions" VALUES(6508,'de','Ein außergewöhnlicher Hammer, der dazu bestimmt ist, seinen kleinen geliebten Prespik zu heilen. Oder seine Gegner, wenn ihr ein Anhänger von Chaferwirr seid.');
INSERT INTO "item_descriptions" VALUES(6509,'de','Dieser prächtige Hammer hat bereits mehr als nur einem Osamodas den Kopf verdreht. Tatsächlich ist er dermaßen mächtig, dass sich jeder auf der Straße nach dessen Besitzer umschaut. Seitdem haben sich die Fälle seltsamer Leiden bei den Ärzten der Umgebung verzehnfacht.');
INSERT INTO "item_descriptions" VALUES(6510,'de','Der Oger Laller mit seinem verkrüppelten Körper war nicht nur häßlich wie die Nacht, er war zudem auch noch kämpferisch völlig unbegabt. Doch dies änderte sich schnell, als ihm eines Tages dieser alte Fäustel im wahrsten Sinne des Wortes vor die Füße fiel. Seitdem ist er eine respektierte und beneidete Persönlichkeit. Manchmal braucht es eben nicht viel zum Glück.');
INSERT INTO "item_descriptions" VALUES(6511,'de','Dieser Hammer ist perfekt an ein tropisches Klima angepasst. Doch will der Umgang mit ihm wohl erlernt sein, wenn ihr auf ein gutes Klima in eurer näheren Umgebung wert legt. Man sollte sich daher wohl überlegen, in welche Hände man ihn gibt.');
INSERT INTO "item_descriptions" VALUES(6512,'de','Dies ist DIE Traumwaffe für alle Xélor-Anhänger, die auf der Suche nach dem gewissen Kick sind. Ausserdem hilft sie den Xéloren, über ihren alten Minderwertigkeitskomplex wegen ihrer einfach nur lächerlichen Größe hinwegzukommen.');
INSERT INTO "item_descriptions" VALUES(6513,'de','Dieser Hammer bezieht all seine Macht aus einer ganz subtilen Verzauberung. Diese ist auf den ersten Blick kaum zu entdecken, geschweige denn auf den zweiten. Daher wird diese Eigenschaft auch grundsätzlich beim Verkauf erwähnt, damit auch die etwas naiveren Kunden diesem Gegenstand ihr Interesse zuwenden.');
INSERT INTO "item_descriptions" VALUES(6516,'de','Kein Sram kann es sich verkneifen, Freund wie Feind mit diesem wunderbaren Dolchen herauszufordern. Daher sollte man im Interesse der allgemeinen Sicherheit in Amakna alle verbleibenden Srams Stück für Stück mit diesem Dolch aus dem Verkehr ziehen.');
INSERT INTO "item_descriptions" VALUES(6517,'de','Diese Dolche lassen jeden weiblichen Sram auf der Suche nach neuen Erfahrungen schwach werden. Tatsächlich sind dank der beträchtlichen und seltsamen Kräfte dieses Dolches auch die hinterhältigsten Untaten möglich, sei es gegen Freund oder gegen Feind. Der Chafer-Offizier hätte seine wahre Freude daran!');
INSERT INTO "item_descriptions" VALUES(6518,'de','Dieser Stab eines berühmten Stabschnitzers hat bereits 13 Mal den großen Wettkampf der Stäbe des N''hi gewonnen. Dabei hat er jedes Mal auch alle anderen Boulgourden- und Balgourdenmodelle übertroffen, wobei erstere inzwischen vom Markt genommen wurden, da sie einfach zu gefährlich sind für kleine Eniripsas.');
INSERT INTO "item_descriptions" VALUES(6519,'de','Ein sehr berühmter Stabschnitzer, dessen Name seltsamerweise einer der wertvollsten Legierungen Amaknas ähnelt, hatte als allererstes den Einfall, Metalle und Legierungen in seine Kreationen einzubauen. An diesem Beispiel sieht man einmal mehr: Wahnsinn kann durchaus auch zum Erfolg führen.');
INSERT INTO "item_descriptions" VALUES(6520,'de','Der Stabschnitzer dieses Stabes bestand unzählige Male darauf, dass jeder den wahren Namen seines Stabes verwenden solle. Doch den Verantwortlichen von Amakna brummte nach langen Nächten in der Taverne dermaßen der Schädel, dass sie den Namenstreit kurzerhand ad acta legten und den Stab zu ihren eigenen Ehren benannten.');
INSERT INTO "item_descriptions" VALUES(6521,'de','Es wird gesagt, dass man mit diesem Stock weibliche Astaknyden zum Erröten bringen und sogar ungestraft den Intimbereich von Weich-Eich streicheln könne. Nun, wir würden euch Letzteres dennoch nicht empfehlen, da diese Eiche wirklich sehr besitzergreifend ist.');
INSERT INTO "item_descriptions" VALUES(6522,'de','Diese pflanzenfressende Wurzel buddelt sich einen Weg zwischen den vielen toten Blättern hindurch, um an junge Sprösslinge zu kommen. Eindrucksvoll... aber auch völlig unnütz, falls ihr nicht gerade gegen Löwenzahn kämpft.');
INSERT INTO "item_descriptions" VALUES(6523,'de','Diese elegante und hervorragend ausgearbeitete Wurzel wurde von Bien persönlich angefertigt. Mit ihrer Hilfe wird jeder zum Meisterbeschwörer. Auf Gesellschaftsabenden wird man damit zwar nur schlecht glänzen können, doch es gibt keinen besseren Aufhänger, um eine Horde begeisterter Sadidettchen um sich zu scharen.');
INSERT INTO "item_descriptions" VALUES(6524,'de','Sauvage, der Sadida, war Hals über Kopf in ein Sadidettchen verliebt. Eines Abends fasste er sich ein Herz und versuchte, sie mit dieser Wurzel unter einen Lindenbaum zu locken, doch gab sie ihm bloß ihren Korb und sagte: "Einmal mit Beeren füllen". Dann ging sie weg und ward die nächsten hundert Jahre nicht mehr gesehen. Kein Wunder, dass sich die Redensart "jemanden an der Wurzel herumführen" nicht durchsetzen konnte und stattdessen fleißig Körbe vergeben wurden.');
INSERT INTO "item_descriptions" VALUES(6525,'de','Die Einwohner Amaknas hatten eines Tages die Nase voll davon, die Anhänger Fécas ständig über ihre Rüstungen prahlen zu hören. Daher bauten sie diesen Stock, in der Hoffnung, zum Thema Nr. 1 der Tavernengespräche zu werden.');
INSERT INTO "item_descriptions" VALUES(6526,'de','Der Schmied, der diese Schaufel angefertigt hat, wollte aus Pseudo-Bescheidenheit anonym bleiben. Trotzdem hatte er die Zeit dafür, sorgfältig und deutlich sichtbar seinen Namen in die Schaufel einzugravieren. Manche Handwerksmeister sind einfach unverbesserlich.');
INSERT INTO "item_descriptions" VALUES(6527,'de','"Amboß Haudschi bumbaudschi, Amboß Haudschi bumbaudschi bummbumm", pflegte der Schwertschmied Weiner Achten aus voller Kehle bei der Arbeit zu singen. Dabei sang er so falsch und so laut, dass ihm seine darunter leidende Frau mit dieser Schaufel ein ewiges Andenken verpasste.');
INSERT INTO "item_descriptions" VALUES(6528,'de','Diese Schaufel hat bereits zahlreiche Kontinente durchquert. Sie hat den Sonnenuntergang vom Gipfel des Mauna Crachloas aus genossen und den Sonnenaufgang am Assel-Meer betrachtet, wo Horizont und Wasser miteinander verschmelzen. Und dann kommt so einer wie ihr, der es noch nie weiter als bis auf die Moon-Insel geschafft hat und will ihr die Welt zeigen. Wie erbärmlich!');
INSERT INTO "item_descriptions" VALUES(6535,'de','Diese seltsame aussehende und überaus vielseitige Schaufel wurde ursprünglich für drei Dinge verwendet: die dicken Flöhe von jungen Iops zu töten, ihre Schuppen zu entfernen,  und die Grundlagen der Arithmetik in ihre dicken Schädel zu kriegen.');
INSERT INTO "item_descriptions" VALUES(6536,'de','Bei den Schattenbergleute ist diese gewaltige Schaufel mit den Dimensionen einer Krachlerhand sehr beliebt, wenn es ihnen darum geht, gleich mehrere Eniripsas auf einmal zu zermalmen. Wir raten euch, das auch einfach mal auszuprobieren.');
INSERT INTO "item_descriptions" VALUES(6537,'de','Der Umgang mit dieser höchst eigenwilligen Schaufel ist immer recht schwierig. Niemand weiß den genauen Grund hierfür, aber im Allgemeinen sind schwiegrige Mutterschaufeln auf lange Sicht kaum auszuhalten. Man sagt ihnen jedoch auch nach, sie hätten ihre guten Seiten, man müßte sie nur finden. Also die Suche nicht aufgeben, hört ihr?');
INSERT INTO "item_descriptions" VALUES(6538,'de','Diese Schaufel ermöglicht es den Enutrofs, etwas weiter zu sehen. Sie ist schließlich so konzipiert, dass sie sich leicht in den Boden pflanzen lässt. So können die alten Herrschaften hinaufklettern, um den Horizont abzusuchen. Oder manchmal auch bloß, um sich interessant zu machen. Diese Schaufel ist einfach ideal für sie, um ihr Altersheim wiederzufinden, wenn sie sich wieder einmal unter all diesen hohen Farnwedeln verlaufen haben.');
INSERT INTO "item_descriptions" VALUES(6539,'de','Diese Schaufel ist wirklich einzigartig. Solltet ihr sie ernsthaft benutzen wollen, so müßt ihr darauf gefasst sein, dass sich jeder darüber lustig machen und schlechte Witze reißen wird. Tatsache ist nämlich, dass gerade in der Taverne die Witze rund um die Schaufel von Bella Ghiena sehr beliebt sind.');
INSERT INTO "item_descriptions" VALUES(6540,'de','Es wird erzählt, der Schöpfer dieser Schaufel sei ein echtes Monstrum gewesen. Er habe ausgesehen wie eine Kreuzung aus einem Sadida und einem WuWulf. Seine Schaufel habe sich auch prompt in ihn verliebt. Welch ein verrücktes Hirngespinst! Sowas ist schließlich nur im Märchen möglich.');
INSERT INTO "item_descriptions" VALUES(6604,'de','Das Quark-Quak ist der ungeschlagene Meister der Dummheit. Schlimmer noch als der Tofu, der Fresssack oder gar der Iop ...');
INSERT INTO "item_descriptions" VALUES(6654,'de','Es ist Ironie pur: der GulliWächter wurde von der Wächter-Kanalchnee verspeist! Sie hat ihn mehrere Jahrhunderte lang verdaut, bevor er schließlich endgültig verstarb. Jedoch waren seine Stiefel sehr viel widerstandsfähiger als er selbst. Der Beweis: hier sind sie, und zwar in hervorragendem Zustand.');
INSERT INTO "item_descriptions" VALUES(6660,'de','Wer wird zu euch noch "Nein" sagen, wenn ihr mit diesem eleganten Zylinder auf dem Kopf heranstolziert kommt? Ruhm und Eroberungen warten auf euch!');
INSERT INTO "item_descriptions" VALUES(6661,'de','Mit dieser Angel könnt ihr auf dem Jahrmarkt des Trools beim Wettfischen von Quark-Quaks mitmachen.');
INSERT INTO "item_descriptions" VALUES(6662,'de','Lasst ihn einfach dahinschmelzen, diesen wunderschönen Hut aus reinster südländischer Larvenseide, wie ein Minzgelee in der prallen Sonne. Achtung: nur mit warmen Wasser und von Hand waschen!');
INSERT INTO "item_descriptions" VALUES(6712,'de','Dieser wunderschön duftende Umhang lässt euch nicht nur wie ein Mauerblümchen erscheinen, sondern damit kauft man euch sogar ab, wie ein wahrer Mönch zu leben. Es gibt nichts besseres, um junge Crâs für euch zu gewinnen. Vor allem, wenn ihr in Wirklichkeit ein seit 100 Jahren nicht gewaschener Sadida seid.');
INSERT INTO "item_descriptions" VALUES(6713,'de','Mit diesen Dolchen, die bereits das Blut des furchtbaren LordSoth geschmeckt haben, wurde sogar der König der Chafer beim Dolchwurfwettbewerb während des Trool Jahrmarktes besiegt. Seitdem wagte er es nie wieder, seinen Lederschlüpfer zu zeigen. Er floh sogar zusammen mit dem Chafer-Offizier in die schützende Umgebung des Friedhofes von Pandala.');
INSERT INTO "item_descriptions" VALUES(6716,'de','Dieser diebische kleine Klammeraffe scheint euch in sein Herz geschlossen zu haben.');
INSERT INTO "item_descriptions" VALUES(6717,'de','Mit diesem kleinen Wonneproppen macht selbst das tägliche Gassigehen wieder Spaß. Doch aufgrund seiner wilden Abstammung sollte man ihn nicht per Hand füttern, sonst riskiert man, eben diese zu verlieren.');
INSERT INTO "item_descriptions" VALUES(6718,'de','Damen jeder Klasse werden beim Anblick dieses verschmitzten und kuscheligen, kleinen Fellknäuels weich. Man sollte dieses Tier aber keinesfalls unterschätzen.');
INSERT INTO "item_descriptions" VALUES(6719,'de','Diese seltsame Maske gehörte dem berühmt-berüchtigten Bärenmann. Sie wurde aus den Überresten eines verwesenden Bären gefertigt. Dadurch werdet ihr niemals ignoriert werden, wo auch immer ihr gerade seid, da ihr an jedem Ort eure eigenen olfaktorischen Spuren hinterlasst.');
INSERT INTO "item_descriptions" VALUES(6720,'de','Dieser warme Mantel wurde viele Jahre hinweg vom berüchtigten Bärenmann getragen. Das wird euch noch lange nicht zu einem Bären machen, wenn ihr den Mantel anzieht, aber euer Magen könnte dies möglicherweise glauben und seine Aktivität verdreifachen. Ihr seid hiermit gewarnt!');
INSERT INTO "item_descriptions" VALUES(6721,'de','Diese Stiefel sind mit Bärenpelz gefüttert. So können selbst die kaltblütigsten Killer noch warme Füße behalten.');
INSERT INTO "item_descriptions" VALUES(6722,'de','Der Bärenmann hat diesen Ehering niemals aufgegeben, obwohl sein Eheweib vor seinen Augen von einem Bären zerfleischt wurde, den er selbst beschworen hatte, um seine Liebste damit zu beeindrucken. Sie war in der Tat sehr beeindruckt...');
INSERT INTO "item_descriptions" VALUES(6723,'de','Der Bärenmann trug dieses Amulett um den Hals, als er die Brigandiner im Unterschlupf von Bimdhoul angriff. Der Legende nach soll es sogar seinen Kopf gerettet haben. Doch bei genauerer Untersuchung wurde diese Erzählung als geschickte Lüge zur Verkaufssteigerung entlarvt.');
INSERT INTO "item_descriptions" VALUES(6724,'de','Dieser kleine Gürtel aus Bärenleder ist perfekt dafür geeignet, Knutschflecken an unauffälligen Stellen zu verdecken. Daher solltet ihr ihn auch niemals in Gegenwart eurer Herzensdame ablegen, um diese nicht zu enttäuschen.');
INSERT INTO "item_descriptions" VALUES(6725,'de','Der Bärenmann benutzte diesen Stecken gerne zum Zähmen von beschworenen Tieren und Monstern, und um seinen Kindern auf die Finger zu klopfen, wenn sie frech waren. Dieser Mann hatte die Wichtigkeit einer guten Kindererziehung verstanden!');
INSERT INTO "item_descriptions" VALUES(6731,'de','Mit diesem Amukwack um den Hals könntet ihr versucht sein, eurer Umgebung weismachen zu wollen, dass ihr einen frischen Atem hättet. Versucht es gar nicht erst, das ist verlorene Liebesmüh.');
INSERT INTO "item_descriptions" VALUES(6732,'de','Dieses schmale Band war einst heiß begehrt bei den Enutröffchen, die mit ihm ihre Zehen zu schmücken pflegten. Ausgezeichnet, um Warzen zu kaschieren.');
INSERT INTO "item_descriptions" VALUES(6742,'de','Dieses Amulett enthält Heckenschützerblätter und Abfall der Moon-Insel. Es ähnelt zwar eher einer Blumenkette als einem Amulett, aber damit werdet ihr im Nu die örtliche Faune der Moon-Insel verführen können, auch wenn diese beinahe ausschließlich aus abscheulichen Kreaturen besteht. Kein Heckenschützer wird euch und der Versuchung, euch mit Knutschflecken zu übersähen, widerstehen können. Ein tolles Gegenmittel gegen Liebeskummer!');
INSERT INTO "item_descriptions" VALUES(6743,'de','Nehmt Heckenschützerblätter, stapelt sie, lasst sie in flüchtigen Alkoholdämpfen einweichen, perforiert sie dann, trinkt den übrigen Alkohol aus, klebt die Blätter um ein Stück Rinde herum, fixiert dann mit einem Klebstoff Mikokoblattstücke darum, und fertig ist euer wunderschöner Heckenschutzring. Allerdings stinkt er abartig! Das kann aber sogar sehr nützlich sein, um den Geruch eurer zu unternehmungsfreudigen Finger zu verstecken, vor allem, wenn ihr sie mal wieder wohin gesteckt habt, wo sie nichts zu suchen haben.');
INSERT INTO "item_descriptions" VALUES(6744,'de','Wenn ihr diese Schuhe erst einmal anprobiert habt, so werdet ihr sie möglicherweise nie wieder ausziehen. Nicht unbedingt, weil sie so besonders sind, sondern vielmehr weil sie besonders klebrig sind.');
INSERT INTO "item_descriptions" VALUES(6745,'de','Dieses bemerkenswerte handwerkliche Kleinkunstwerk aus Überresten von Heckenschützern und sonstigem Unrat, der inmitten der übelriechenden Brandung der Moon-Insel zusammengesammelt wurde, erzeugt eine einzigartige Wirkung an euch, vorausgesetzt ihr habt sonst nichts an. Dadurch lassen sich eure Gegner gut aus der Fassung bringen, oder gar eure Liebste. Vielleicht behaltet ihr ja nun ein für allemal die Oberhand und sie lässt sich unterkriegen, wer weiß?');
INSERT INTO "item_descriptions" VALUES(6746,'de','Einst von Oto Mustam, dem Kriegshäuptling von Brâkmar, getragen, diente dieses kleine Amulett einzig und allein dazu, mit seiner Schönheit bei den organisierten brâkmarischen Orgien zu glänzen. Das volle Programm!');
INSERT INTO "item_descriptions" VALUES(6747,'de','Wenn der Wind in ihre Federn fährt, dann fühlt sich eine Luft-Kwackine frei und lässt sich von den Windströmungen hin- und herwiegen wie ein totes Blatt in einer Sturmbö. Entgegen dem, was die meisten dabei denken, ist das ziemlich beeindruckend.');
INSERT INTO "item_descriptions" VALUES(6748,'de','Geschickt angelegt, vermag es dieses Armband, eure Wurstfinger zu verschönern. Zum Verdruss von so manch einem ist dies leider nur bei Fingern wirksam.');
INSERT INTO "item_descriptions" VALUES(6749,'de','Dieses Band ist so leicht, dass man das Gefühl hat, es könne sich beim ersten Windstoß in die Luft erheben. Aber nicht träumen! Wenn das passieren sollte, dann werdet ihr mit Sicherheit nicht mitfliegen können. Bestenfalls werdet ihr dabei ausgelacht.');
INSERT INTO "item_descriptions" VALUES(6750,'de','Dieses Schwert mit der kalten und scharfen Klinge weckt die innersten Instinkte im Träger.');
INSERT INTO "item_descriptions" VALUES(6751,'de','"Ein außergewöhnliches Schwert für Abenteurer auf der Suche nach außergewöhnlichen Erfahrungen" – liest man im Bedienungshandbuch. Handbücher von Schwertern sind auch nicht mehr das, was sie mal waren.');
INSERT INTO "item_descriptions" VALUES(6752,'de','Sie ist nicht nur ideal, um Wölkchen zu zerschneiden, sondern kann sogar dazu dienen, euch Luft zuzufächern, wenn ihr sie vor eurem Gesicht auf und ab bewegt. Das ist gleichzeitig auch eine hervorragende Technik, um Moskitos zu dezimieren, oder aber das Gesicht eurer Freunde zu entstellen.');
INSERT INTO "item_descriptions" VALUES(6753,'de','Einfach ideal zum Schlittschuhlaufen auf zugefrorenen Seen oder um an heißen Tagen euer Essen kühl aufzubewahren. In jedem Falle werden euch diese Schuhe helfen, stets einen kühlen Kopf und kühle Füße zu bewahren. Allerdings sollte man sie nach dem Trocknen vor dem Kamin nie liegen lassen, sonst gibt es sie eines morgens nicht mehr.');
INSERT INTO "item_descriptions" VALUES(6754,'de','"Nichts geht über steinerne Kwacklauen, um über die Erde zu kwacklaufen", sprach Rola Ingalsse, die berühmte Pflügerin, bevor ihr eine große Erdscholle beide Augen zerstörte und sie erblindete.');
INSERT INTO "item_descriptions" VALUES(6755,'de','Einfach, aber wirkungsvoll. Dennoch wurde das Design dieser wahnsinnig leichten Stiefel kürzlich noch einmal überarbeitet, um einen Windsack anzubringen, der einem Richtung und Stärke des Windes weist. Achtet bloß darauf, immer auf der richtigen Seite des Windes zu stehen, sonst erleidet ihr in kürzester Zeit den Erstickungstod!');
INSERT INTO "item_descriptions" VALUES(6756,'de','Dieser Umhang ist einfach ideal, sich als Riesenerdscholle zu tarnen. Dadurch könnt ihr dann die pflügenden Bauern aus dem Hinterhalt angreifen und all ihre Reichtümer stehlen. Demnach ist er vor allem für Sammler schön geformter und -gefärbter Feuersteinsplitter geeignet.');
INSERT INTO "item_descriptions" VALUES(6757,'de','Dieser raffinierte leichte Mantel kann den Ärmsten notfalls sogar als Vorhang dienen. Einst war er von der Mumie Nova heiß begehrt, die ihn tragen wollte, um abends gut gekleidet ausgehen zu können. Tja, davon sollten sich einige mal eine Scheibe abschneiden!');
INSERT INTO "item_descriptions" VALUES(6758,'de','Dass der Erd-Kwack nicht gerade sehr gesellig ist und für seine Federn gejagt wird, ist wohl bekannt. Mit diesem Gürtel setzt ihr euch ebenfalls der Heimtücke der Erd-Kwack-Jäger aus, die euch womöglich mit einem alten, klapprigen Kwack verwechseln, der nicht mehr lange zu leben hat. Manchmal täuscht einen der Schein eben doch nicht.');
INSERT INTO "item_descriptions" VALUES(6759,'de','"Die einzig wirksame Art, einen alten streitlustigen Wind-Kwack zu fangen, besteht darin, sich in einen streitlustigen weiblichen Wind-Kwack zu verkleiden. Das Männchen wird versuchen zu begreifen, was das Weibchen so streitlustig macht und es mit allen verfügbaren Mitteln und Wegen befriedigen. Wenn es zufrieden mit seiner Leistung ist, kann man seine Glückseligkeit dazu ausnutzen, es zu rupfen." Soweit Abschnitt 12 des dritten Bandes des Handbuches des kleinen Kwack-Jägers. Ihr wisst nun, was ihr zu tun habt!');
INSERT INTO "item_descriptions" VALUES(6760,'de','Dieser Helm ist dermaßen schwer, dass ihr damit ständig den Boden fest unter den Füßen spüren werdet. Andererseits könnten eure Ideen mitsamt eures Kopfes damit auch öfters auf den fruchtbaren Boden Amaknas fallen. Man kann schließlich nicht alles haben.');
INSERT INTO "item_descriptions" VALUES(6761,'de','Diese Kappe ist nichts für Luftikusse, sondern für Abenteurer, die es gewöhnt sind, hart am Wind zu segeln. Doch auch für weibliche Abenteurer ist dieses Prachtstück wunderbar. Was, der Wind zerzaust euch mal wieder die Haare? Dann schnell die Wind-Kwackapp überziehen und schon wird euch der Wind kein Härchen mehr krümmen.');
INSERT INTO "item_descriptions" VALUES(6762,'de','„Für den Kampf gegen Recken hilft ein Heckenschützerstecken.“ Dies zumindest stand in der Werbebroschüre des A-Touristik-Teams. In einer Beschreibung war zu lesen, wie man den Wurfspeer mithilfe verschiedener, auf der Moon-Insel versteckter Ressourcen zusammenbauen konnte. Das war so eine Art Schnitzeljagd, bloß ohne Schnitzel.');
INSERT INTO "item_descriptions" VALUES(6763,'de','Man sagt, tote Heckenschützer seien sehr bequem, wenn sie sich erst einmal in der Sonne zersetzt haben. Tatsächlich werden sie mit der Zeit immer elastischer und weicher. Viele Abenteurer würden gerne selbiges von ihrer Liebsten behaupten können.');
INSERT INTO "item_descriptions" VALUES(6764,'de','Mit dieser Mütze auf dem Kopf sehrt ihr grade nicht sehr schlau aus. Aber seid getröstet: das bessert sich auch nicht, wenn ihr sie abnehmt. Daher könnt ihr sie auch genauso gut weiter aufbehalten.');
INSERT INTO "item_descriptions" VALUES(6766,'de','Dieses rudimentär anmutende Amulett wurde aus drei Weizenähren gefertigt, die während der dreizehnten Ernte Istrabraqs in den Ebenen von Snossios gemäht und dann mit Edelsteinstaub überzogen wurden. Es verleiht dem Träger außergewöhnliche Tapferkeit und erlaubt gleichzeitig das Mähen von Ebenen und Tälern, ohne jemals zu ermüden.');
INSERT INTO "item_descriptions" VALUES(6767,'de','Dieses mit Edelsteinen besetzte Armband wurde von Shika mit einem Tuch aus Hanf umwickelt, um zu verhindern, dass Farle beim Sähen der Gerstensaat damit die Aufmerksamkeit der Rablinge erweckt.');
INSERT INTO "item_descriptions" VALUES(6769,'de','Dieses Werkzeug ist an einem Ende mit eindrucksvollen Zähnen bewehrt und wird so zu einer ausgezeichneten Mistgabel. Es heißt, Bruce Bulgour höchstpersönlich habe das zur Herstellung dieses Steckens notwendige Holz geschlagen. Dafür erhielt er jeden Tag riesige Portionen Haferflocken, die er hinunterschlang, bevor er ganze Wälder dem Erdboden gleichmachte.');
INSERT INTO "item_descriptions" VALUES(6773,'de','Diese Halskette ist nach Tude-Art angefertigt worden. Das ist eine der ältesten und einfachsten Herstellungsarten der Juweliere, die heutzutage nur noch Lehrlinge zu Übungszwecken beigebracht wird. Natürlich ist eine solche Kette auch nicht sehr mächtig, das kann man ja auch nicht von ihr erwarten.');
INSERT INTO "item_descriptions" VALUES(6774,'de','Diese Holzschuhe wurden aus seltenen Edelhölzern geschnitzt, durch Lederstücke von unvorstellbarem Wert verstärkt und mit magischen Getreidesorten ausgepolstert. Dadurch werden diese leichten, bequemen und sehr eleganten Holzschuhe dem Zahn der Zeit zu trotzen wissen. Viele ehemals liebestolle Abenteurer würden gern gleiches von ihrer Liebsten behaupten können.');
INSERT INTO "item_descriptions" VALUES(6775,'de','Dieser lange, aus Stoff und Fell zusammengenähte Mantel erlaubte es Farle Ingalsse, die Saat ganzer Felder eine Jahreszeit hinweg zu verstreuen, ohne jemals aufhören oder wieder auffüllen zu müssen. Denn dieser praktische Mantel lässt sich zu einer Art Umhängetasche schier unglaublichen Inhaltes zusammenfalten. Niemand kennt den Erschaffer dieses Meisterwerkes, jedoch soll dieser einer Legende nach sein Handwerk aufgegeben haben, nachdem seine Kunden anfingen ihre Mäntel als Wischmobs zu gebrauchen. Welch trauriges Ende einer langen Karriere.');
INSERT INTO "item_descriptions" VALUES(6776,'de','Dieser Lendenschurz diente Farle Ingalsse auch als Arbeitsschürze, wenn er mal wieder Tieren aus seiner Fresssackherde den Hals abschneiden mußte. Dies ist nämlich wirklich eine grausame und undankbare Aufgabe, die er immer sofort und mit kaum verhohlenem Unbehagen hinter sich bringt.');
INSERT INTO "item_descriptions" VALUES(6778,'de','Dieser Strohhut wurde aus einer Vielzahl magischer Ähren angefertigt, die ineinander verflochten wurden. Anschließend wurde das Innere von Hand von Shika Ingalsse, Farles Frau, mit verschiedenen Fell- und Stoffstücken ausgepolstert. Nun ist er noch klassischer als das Grobianium und stylischer als eine Dracheischale. Er hat Farle viele hundert Ernten lang vor der Sonnenglut beschützt und seine fröhliche und einfach coole Art unterstrichen. Damit fühlt man sich fast wie der König oder die Königin der Felder.');
INSERT INTO "item_descriptions" VALUES(6780,'de','Mit diesem praktischen Schwert fühlt ihr euch gleich wie ein kampferprobter Veteran.');
INSERT INTO "item_descriptions" VALUES(6781,'de','Mit diesem praktischen Stab fühlt ihr euch gleich wie ein kampferprobter Veteran.');
INSERT INTO "item_descriptions" VALUES(6782,'de','Mit diesem praktischen Stock fühlt ihr euch gleich wie ein kampferprobter Veteran.');
INSERT INTO "item_descriptions" VALUES(6783,'de','Mit diesem praktischen Bogen fühlt ihr euch gleich wie ein kampferprobter Veteran.');
INSERT INTO "item_descriptions" VALUES(6784,'de','Mit diesen praktischen Dolchen fühlt ihr euch gleich wie ein kampferprobter Veteran.');
INSERT INTO "item_descriptions" VALUES(6785,'de','Mit diesem praktischen Hammer fühlt ihr euch gleich wie ein kampferprobter Veteran.');
INSERT INTO "item_descriptions" VALUES(6786,'de','Mit dieser praktischen Schaufel fühlt ihr euch gleich wie ein kampferprobter Veteran.');
INSERT INTO "item_descriptions" VALUES(6789,'de','Dieses kleine Amulett blüht im Frühling, trocknet im Sommer, welkt im Herbst und verfault im Winter. Eine tolle Gelegenheit, seine Mode je nach Jahreszeit anzupassen.');
INSERT INTO "item_descriptions" VALUES(6791,'de','Mit diesem kleinen Ring um den Finger schafft ihr es, beinahe völlig unbemerkt durch die Felder zu streifen.');
INSERT INTO "item_descriptions" VALUES(6792,'de','Dieser Stecken in Form einer Blüte wurde aus Resten von Feldblumen hergestellt, die nach schrecklich grausamen Kämpfen übriggeblieben waren. Die ganze Wut und der ganze Hass dieser kleinen armen Pflanzen sind in diesem lächerlich mickrigen Stecken vereint. Diese Waffe wird von den schurkenhaftesten Srams verwendet, um irgendwelche Dummköpfe davon zu überzeugen, dass sie ihnen nur einen Blumenstrauß überreichen möchten. Sobald sich der Leichtsinnige in Reichweite befindet, erhält er umgehend einige wohlverdiente Schläge auf die Birne.');
INSERT INTO "item_descriptions" VALUES(6793,'de','Dieser Ring wurde noch nie in der Praxis getestet. Es handelt sich dabei um ein Unikat, welches von einem Juweliersgesellen als Probearbeit abgegeben wurde. Er wurde aus einem schlichten Eisenring gefertigt, welcher lange Zeit in eine magische Thee-Mischung getaucht wurde.');
INSERT INTO "item_descriptions" VALUES(6794,'de','Es geht doch nichts über ein paar Stiefel, die aus Teilen von Wiesenblumen gefertigt wurden, um all die ungezogenen wildwuchernden Wiesenblümchen auf euren Feldern damit zu zertreten. Zudem noch entströmt diesen Schuhen daher ständig der feine Geruch frischer Blumen. Schade, dass es von diesen Schuhen keine Version für Unterhosen gibt.');
INSERT INTO "item_descriptions" VALUES(6795,'de','Wenn ihr abends auf der Tanzfläche die Allerschönste im ganzen Land sein wollt, dann ist dieses Gewand genau das Richtige für euch!');
INSERT INTO "item_descriptions" VALUES(6796,'de','Mit diesem farbig-leuchtenden Gürtel mit seinen kleinen Blütenblättern am Rand werdet ihr ohne Probleme als Star-Tänzerin durchgehen. Sehr praktisch bei von vornherein verlorenen Kämpfen. Es gibt nichts Besseres, um eine Armee von Chafern abzulenken und die Lage wieder zu euren Gunsten zu ändern.');
INSERT INTO "item_descriptions" VALUES(6797,'de','Habt ihr schon immer davon geträumt ein Blumenmädchen zu sein und nach Rosenwasser zu duften? Wenn ja, dann ist dieser seltsame Hut genau das Richtige für euch!');
INSERT INTO "item_descriptions" VALUES(6799,'de','Diese Waffe ist nicht nur genauso scharf wie alle anderen Bworklingen, sondern auch noch sehr viel schwerer. Das macht sie zwar unhandlich, zugegeben, aber dafür genügt es in den meisten Fällen, sie einfach nur auf euren Gegner fallen zu lassen, um ihn wie einen gewöhnlichen Trunknyden in zwei Hälften zu spalten. Wenn euer Gegner nicht gleich vor Schmerzen umkommt, dann macht ihm die unerträgliche Schande bestimmt den Garaus... wie euch euer Lachanfall.');
INSERT INTO "item_descriptions" VALUES(6800,'de','Dieser Umhang wurde aus schwarzer Fresssackwolle gefertigt. Er ist zu nichts nutze, außer dazu, schick auszusehen... Und selbst das...');
INSERT INTO "item_descriptions" VALUES(6804,'de','Trotz seines groben Aussehens schlummert in diesem Amulett aus sorgfältig behauenem Feuerstein eine mächtige Magie. Die soll sogar in der Lage sein, einen Bwork in eine Prinzessin zu verwandeln... oder umgekehrt – so genau weiß das niemand mehr.');
INSERT INTO "item_descriptions" VALUES(6805,'de','Mit diesem Armschützer könnt ihr eurem Umfeld vortäuschen, dass ihr einen der großen Bwork-Chefs geheiratet und diesen Armschützer als Hochzeitsgeschenk bekommen habt. Bei den abendlichen Gelagen in der örtlichen Taverne könnt ihr damit interessanter erscheinen, wenn ihr mal wieder nichts zu erzählen habt.');
INSERT INTO "item_descriptions" VALUES(6807,'de','Von Weitem sehen diese Stiefel aus wie klassische Bwork-Stiefel. Von Nahem ebenfalls. Dennoch sind dies die Schuhe eines Bwork-Chefs. Darum sind sie noch haltbarer, noch mächtiger und vor allem noch übelriechender!');
INSERT INTO "item_descriptions" VALUES(6811,'de','Dieser zerrissene und verlotterte Umhang wird allen sofort zeigen, dass ihr ein großer Bwork-Krieger seid. Außerdem ist er ideal, um die Großväterchen und Großmütterchen des Dorfes in Angst und Schrecken zu versetzen. Eine Kampfgefährtin damit zu verführen, könnte sich hingegen als schwierig erweisen, es sei denn, ihr hättet unter dem Umhang nichts anderes an. Damit bleibt euch immernoch der Vorteil, weiterhin die Großväterchen und Großmütterchen des Dorfes in Angst und Schrecken zu versetzen.');
INSERT INTO "item_descriptions" VALUES(6812,'de','Es bedarf keiner Worte, um diesen violetten Lederschlüpfer zu beschreiben. Selbst wenn er das einzige Kleidungstück ist, das ihr am Leibe tragt, seht ihr immer noch wie ein Star aus. Vorausgesetzt er passt euch und fällt nicht wieder beim Seilspringen herunter.');
INSERT INTO "item_descriptions" VALUES(6813,'de','Wenn ihr wirklich wie ein grober Schwackkopf aussehen wollt, dann ist dieser Helm genau das richtige für euch! Mit etwas Glück bemerkt keiner den Unterschied mehr, wenn ihr den Helm irgendwann auszieht.');
INSERT INTO "item_descriptions" VALUES(6817,'de','Dieses erstaunliche Amulett wurde in Wirklichkeit aus einem Reptilpanzer gefertigt, in welchen mehrere Edelsteine eingefasst wurden. Das macht es zu einem echten Schmuckstück, nicht gerade leicht zu tragen, aber dafür auch noch äußerst resistent. Euer Hals wird damit 100%ig gegen Vampirangriffe geschützt, sowie vor Knutschflecken etwas zu unternehmungsfreudigen Dorfbewohnerinnen.');
INSERT INTO "item_descriptions" VALUES(6819,'de','Dieser Armschützer ähnelt seltsamerweise einem Handschuh, und trotzdem handelt es sich um einen Armschützer. Manchmal trügt der Schein eben.');
INSERT INTO "item_descriptions" VALUES(6821,'de','Diese aus kleinen Stückchen eines Chef-Crocodylls gefertigte Klinge wird euch gute Dienste leisten, vorausgesetzt ihr seid schön, flink, intelligent und stark genug, um sie zu führen. Andernfalls werdet ihr mit etwas Glück bestimmt jemanden finden, der sie euch gegen ein kleines hölzernes Schwert eintauschen wird. Nicht traurig sein!');
INSERT INTO "item_descriptions" VALUES(6825,'de','Diese wunderschönen Pantoffeln aus Haut und Schuppen des Chef Crocodylls besitzen an allen Extremitäten scharfe Krallen. Hütet euch daher, wenn ihr eurer Liebsten mal wieder auf den Fuß tretet, ihr könntet ihr dadurch nämlich leicht ihre kleinen Spitzenstrümpfe aus Tabi-Wolle zerreißen.');
INSERT INTO "item_descriptions" VALUES(6830,'de','Auch in Amakna ist der erneute Schulbeginn nach den Ferien eine schmerzhafte Qual für alle Kinder. Dies gilt insbesondere für die kleinen Iops, denn der Gang zur Schule bedeutet gleichzeitig das Martyrium regelmäßiger unüberwindlicher Prüfungen. Tröstet sie mit diesem wunderschönen Schulranzen aus Häuten und Schuppen des Chef Crocodylls sowie einer weichen Fütterung aus Fell.');
INSERT INTO "item_descriptions" VALUES(6831,'de','Dieser Gürtel ist nicht biegsam genug, um als Peitsche zu dienen, doch dafür funkelt er hübsch, da er mit kleinen polierten Edelsteinchen überzogen ist. Er kann auch problemlos auf konventionelle Art genutzt werden, beispielsweise um zu verhindern, dass euch die Gamaschen über die Knie rutschen.');
INSERT INTO "item_descriptions" VALUES(6834,'de','Wenn ihr den Traum wahr werden lassen wollt, wie ein Crocodyll auszusehen, ohne gleichzeitig auch zu einem Crocodyll zu werden, dann könnt ihr dies endlich tun – dank dieser tollen Maske. Doch wenn ihr meint, vor euren Freunden prahlen zu können, es sei euch gelungen, dieses Crocodyll mit eigenen Händen zu erwürgen, um daraus die Maske zu fertigen, so vergesst es. Niemand, außer vielleicht ihr, selbst wird solche Märchen glauben.');
INSERT INTO "item_descriptions" VALUES(6839,'de','Diese Waffe mit dem Herstellungsstempel von Miau Miau höchstpersönlich wird euch zu einem legendären Ecaflip machen... vielleicht.');
INSERT INTO "item_descriptions" VALUES(6840,'de','Diese Waffe mit dem Herstellungsstempel von Miau Miau höchstpersönlich wird euch zu einem legendären Ecaflip machen... vielleicht.');
INSERT INTO "item_descriptions" VALUES(6856,'de','Dank ihrer speziellen Form kann man mit dieser Schere problemlos die Stängel von Dämonenrosen jeglicher Größe durchtrennen, ohne dabei deren Blütenblätter zu beschädigen. Und das selbst dann, wenn sich die Rose gerade in eurer Wade festgebissen hat.');
INSERT INTO "item_descriptions" VALUES(6863,'de','Dies ist der Helm der Söldner von Astrub.');
INSERT INTO "item_descriptions" VALUES(6886,'de','Dies ist der Umhang der Söldner von Astrub.');
INSERT INTO "item_descriptions" VALUES(6894,'de','Diese übermächtige Kampfmaunzmiez ist ein Ausbund an Übermächtigkeit und damit sehr beeindruckend. Leider ist sie und ihre Übermächtigkeit den Eventmeistern vorbehalten.');
INSERT INTO "item_descriptions" VALUES(6895,'de','Ein wenig weniger übermächtig als die übermächtige Kampfmaunzmiez, aber immer noch sehr übermächtig. Diese kleine Kampfmaunzmiez ist der ideale der Vertraute für jeden wahren Eventmeister. Doch ist sie leider auch sehr schmutzanziehend. Drum vergesst nicht, sie von Zeit zu Zeit mit kochenden Wasser abzuwaschen, damit sie ihren herrlichen Farbton behält.');
INSERT INTO "item_descriptions" VALUES(6908,'de','Mit diesem Lendenschurz auf den Lenden seid ihr gut gerüstet für all die furchtbaren Gefahren des Alltages. Zudem ist er so haarig und so elegant, dass ihr den ganzen Tag lang an eure Liebste denken werdet. Herrlich, nicht?');
INSERT INTO "item_descriptions" VALUES(6909,'de','Diese Schuhe sind einfach perfekt dazu geeignet, durch den Schlamm zu waten oder den Parkettboden zu zerkratzen. Allerdings ist es grundsätzlich untersagt, Tanzflächen damit zu betreten.');
INSERT INTO "item_descriptions" VALUES(6910,'de','Dieses Band wurde früher um die Beine von brünftigen Keilern gebunden, damit die Züchter sie leichter von anderen unterscheiden konnten. Heute tragt ihr nun dieses Band. Das lässt Spielraum für alle möglichen Interpretationen...');
INSERT INTO "item_descriptions" VALUES(6911,'de','Dieser lächerliche kleine Ring mag euch vielleicht dabei helfen, eure Arachneeophobie zu bekämpfen.');
INSERT INTO "item_descriptions" VALUES(6912,'de','Dieser herrliche Lendenschurz wurde aus alten, halbverwesten Arachneenresten angefertigt. Das erklärt auch, warum er manchmal wieder zum Leben erwacht und euch mit perversem Vergnügen an alle Stellen beißt, die er erreichen kann. Was für schreckliche Biester!');
INSERT INTO "item_descriptions" VALUES(6913,'de','Mit dieser Maske vorm Gesicht ähnelt ihr von weitem einer wilden Arachnee. Doch damit erschreckt ihr bestenfalls alterschwache Moskitos.');
INSERT INTO "item_descriptions" VALUES(6914,'de','Eine seltsame Tatsache, die nicht jedem bekannt sein wird, ist, dass Arachneen bloß vier haarige Klauen besitzen. Also braucht man nur vier Schläge statt acht, um eine Arachnee in ein Arachnotrunk zu verwandeln. Toll, was?');
INSERT INTO "item_descriptions" VALUES(6915,'de','Dieser Ring ist so leicht, dass ihr damit zu einem regelrechten Fingerakrobaten avancieren könnt. Das ist sehr praktisch, wenn ihr um 10x kleinere Gegner erniedrigen wollt, indem ihr ihnen mit dem Daumen den Kopf zermalmt.');
INSERT INTO "item_descriptions" VALUES(6916,'de','Diese aus Moskitohaut und -flügeln gefertigte Tasche war mal DAS Trendaccessoire auf Pausenhöfen. Doch heute wirkt sie nur noch spießig und wurde vom aktuellen Modeschlager verdrängt, dem kleinen Schulranzen des Chef-Crocodylls. Welch ein Unsinn, wenn man bedenkt, dass letzterer viel teurer und vor allem auch noch viel hässlicher als dieser kleine Moskitosack ist. Da verstehe einer die Mode ...');
INSERT INTO "item_descriptions" VALUES(6917,'de','Der verblüffende Name dieser Kappe stammt von einem exzentrischen Enutrof, dem sie beim Entkleiden eines alten, kranken Moskitos in die Hände fiel. Sie ist sehr nützlich für angehende Abenteurer. Aber Vorsicht: sie erregt schon von weitem die Aufmerksamkeit aller ausgehungerten Moskitos der ganzen Umgebung.');
INSERT INTO "item_descriptions" VALUES(6918,'de','Dieses Medaillon ist zwar weniger hoch angesehen als das berühmte Arach-Amuleth, doch hat es auch einen gewissen Charme. Vor allem wenn es als einziges Kleidungsstück auf einem stark behaarten Körper getragen wird!');
INSERT INTO "item_descriptions" VALUES(6919,'de','Ein Pilzling ist nicht gerade als sehr großer Sympathieträger bekannt. Er vergiftet anderen das Leben, sobald er eine Möglichkeit dazu hat, er beißt um sich und hat einen ganz miesen Charakter. Es ist doch verwunderlich, wie sehr diese gemeinen kleinen Biester euch manchmal an eine Ehepartner erinnern können, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(6920,'de','Wenn ein Pilzling heiratet, schenkt er seiner Liebsten diese Art von Trauring. Da die Liebsten dummerweise keine Arme besitzen, wird der Trauring ganz vorsichtig auf einer ihrer Dornen abgelegt. Da ihr selbst nun diesen Trauring übergezogen habt, wurde der Bund des Lebens zwischen den beiden Kreaturen zerstört. Im besten Fall wird euch nun der betroffene Pilzling für seine Liebste halten.');
INSERT INTO "item_descriptions" VALUES(6921,'de','In der Vergangenheit wurde Tee daraus gebraut und es kann auch geraucht werden. Solch eine Pilzlingkopfbedeckung ist schon etwas Tolles!');
INSERT INTO "item_descriptions" VALUES(6922,'de','Das einzige, was noch beindruckender ist, als ein wütender Pilzling, ist ein wütender Pilzling mit einem Mantel. Den ein solcher Mantel strahlt eure innere vestimentarische Überlegenheit nach allen Seiten aus. Doch ob sich dieser giftgrüne Pilzmantel auch als Accessoire für die hohen Damen durchsetzen wird? Wer weiß...');
INSERT INTO "item_descriptions" VALUES(6923,'de','Dieses Amulett gehörte einst dem berüchtigten Banditen "Thisme", der für seine grenzenlose Grausamkeit und für seine stupide Todesart bekannt wurde. Nach einer Eniripsa-Erzählung ertrank er in einer großen Ölpresse und wurde darin zermalmt – und das, nachdem er gerade nach mehreren hunderten von Jahren wieder aus dem Gefängnis freigelassen wurde, wohin ihn eine gestohlene Nuss gebracht hatte.');
INSERT INTO "item_descriptions" VALUES(6924,'de','Diese scharfen Dolche sind bei Banditen sehr beliebt, ganz im Gegensatz zu jungen Abenteurern, die sie aus dem gleichen Grund fürchten. Diese Dolche sind nämlich in der Lage, bei Treffern den Gegnern Kamas zu rauben. Eine originelle Art und Weise, Steuern zu erheben, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(6925,'de','Dieser scharfe Lendenschurz wird euch entzücken, wenn ihr den Weg eines wahren Wegelagerers einschlagt. Bis dahin macht ihr euch damit allerdings schlichtweg lächerlich.');
INSERT INTO "item_descriptions" VALUES(6926,'de','Mit der Prespikapp auf dem Kopf seht ihr Debbie Crokett, der berühmtesten Jägerin der Gegenwart, zum Verwechseln ähnlich. Bloß dass ihre Kopfbedeckung dazu dient, ihren beginnenden Haarausfall zu vertuschen. Solltet ihr die gleiche Absicht haben, so wisst, dass diese kleine rötliche Kappe furchtbar stinken wird, sobald es anfängt zu regnen.');
INSERT INTO "item_descriptions" VALUES(6927,'de','Dieser rötlich gefärbte, kleine Umhang kann im Zweifel auch als Bettvorleger oder als Türmatte dienen, falls ihr sparen müsst und trotzdem eure Innenausstattung umdekorieren möchtet.');
INSERT INTO "item_descriptions" VALUES(6928,'de','Dieses gleichzeitig nüchtern, aber auch originell wirkende Armband wird mit Sicherheit alle Abenteurer erfreuen, die scharf auf Luxus sind, ihn sich jedoch nicht leisten können. So können sie losziehen, um mal wieder arme, kleine, wilde Kreaturen abzuschlachten, damit sie daraus Schmuck herstellen können. Die Bosheit kennt wohl keine Grenzen!');
INSERT INTO "item_descriptions" VALUES(6929,'de','Zwar hält dieser Gürtel die Hüfte schön warm, aber er hat den Nachteil, insbesondere zarte Haut doch arg zu reizen. Vorbehalten für alle mit dickem Fell.');
INSERT INTO "item_descriptions" VALUES(6930,'de','Dieser Krachlerhelm, aus Fels herausgehauen, ist sein Gewicht in Gold wert! Er wird euch selbst vor den Angriffen eines Krachlklotzes zu bewahren wissen. Sprich: er ist euch durchaus kein Klotz am Bein, sondern mit ihm werdet ihr, statt bloß zu kleckern, richtig klotzen können, und das nicht nur gegen Räuber wie RotzamKlotz!');
INSERT INTO "item_descriptions" VALUES(6931,'de','Dieser steinerne Umhang ist vielleicht anfangs ein wenig ungemütlich, aber dennoch ein wirklich guter Schutz gegen Steinwürfe, oder aber gegen die noch viel gefährlichere  Krachlerspucke.');
INSERT INTO "item_descriptions" VALUES(6933,'de','Diese Stiefel sind unglaublich schwer, doch dafür auch sehr wirkungsvoll, um andere zu treten. Zudem liefern sie euch die perfekte Entschuldigung, wenn ihr mal wieder zu langsam wart, euch rechtzeitig einem von vornherein verlorenen Angriff auf einen Perceptoren eurer Gilde anzuschließen.');
INSERT INTO "item_descriptions" VALUES(6934,'de','Diese Halskette ist so schwer wie ein fettsüchtiger Blob, was etwas zu leicht gebaute Abenteurer davon abhalten sollte, sie zu tragen. Allerdings muss man gestehen, dass sie sehr schick aussieht, wenn man erst einmal ihr Gewicht verkraftet.');
INSERT INTO "item_descriptions" VALUES(6935,'de','Mit diesem Gürtel um die Hüften wird man euch sofort als erfahrenen Abenteurer respektieren. Wenn ihr ihn allerdings lieber als Stirnband tragen wollt, nur zu – es ist eure Sache, wenn ihr euch zum Gespött von ganz Astrub machen wollt.');
INSERT INTO "item_descriptions" VALUES(6936,'de','Mit diesem originellen Helm auf dem Kopf werdet ihr all euren Freunden weismachen können, ihr seiet ein großer Scarablatt-Jäger.');
INSERT INTO "item_descriptions" VALUES(6937,'de','Mit diesem originellen Helm auf dem Kopf werdet ihr all euren Freunden weismachen können, ihr seiet ein großer Scarablatt-Jäger.');
INSERT INTO "item_descriptions" VALUES(6938,'de','Mit diesem originellen Helm auf dem Kopf werdet ihr all euren Freunden weismachen können, ihr seiet ein großer Scarablatt-Jäger.');
INSERT INTO "item_descriptions" VALUES(6939,'de','Mit diesem originellen Helm auf dem Kopf werdet ihr all euren Freunden weismachen können, ihr seiet ein großer Scarablatt-Jäger.');
INSERT INTO "item_descriptions" VALUES(6940,'de','Wer hat niemals davon geträumt, in die leere Schale eines Scarablattes zu schlüpfen? Wenn diese erst einmal angepasst ist, dann bekommt ihr beinahe das Gefühl, selbst ein echtes Scarablatt zu sein und werdet mit der Zeit womöglich auch noch anfangen, euch halb schwebend, halb (aus)rutschend fortzubewegen. Das kann die Horde von Trools, die euch gerade auffressen will, ganz schön aus dem Konzept bringen. Für eine kurze Zeit jedenfalls.');
INSERT INTO "item_descriptions" VALUES(6941,'de','Wer hat niemals davon geträumt, in die leere Schale eines Scarablattes zu schlüpfen? Wenn diese erst einmal angepasst ist, dann bekommt ihr beinahe das Gefühl, selbst ein echtes Scarablatt zu sein und werdet mit der Zeit womöglich auch noch anfangen, euch halb schwebend, halb (aus)rutschend fortzubewegen. Das kann die Horde von Trools, die euch gerade auffressen will, ganz schön aus dem Konzept bringen. Für eine kurze Zeit jedenfalls.');
INSERT INTO "item_descriptions" VALUES(6942,'de','Wer hat niemals davon geträumt, in die leere Schale eines Scarablattes zu schlüpfen? Wenn diese erst einmal angepasst ist, dann bekommt ihr beinahe das Gefühl, selbst ein echtes Scarablatt zu sein und werdet mit der Zeit womöglich auch noch anfangen, euch halb schwebend, halb (aus)rutschend fortzubewegen. Das kann die Horde von Trools, die euch gerade auffressen will, ganz schön aus dem Konzept bringen. Für eine kurze Zeit jedenfalls.');
INSERT INTO "item_descriptions" VALUES(6943,'de','Wer hat niemals davon geträumt, in die leere Schale eines Scarablattes zu schlüpfen? Wenn diese erst einmal angepasst ist, dann bekommt ihr beinahe das Gefühl, selbst ein echtes Scarablatt zu sein und werdet mit der Zeit womöglich auch noch anfangen, euch halb schwebend, halb (aus)rutschend fortzubewegen. Das kann die Horde von Trools, die euch gerade auffressen will, ganz schön aus dem Konzept bringen. Für eine kurze Zeit jedenfalls.');
INSERT INTO "item_descriptions" VALUES(6944,'de','Mit diesem Ring am Finger habt ihr unweigerlich das Bild der vielen niedergemetzelten Scarablätter vor euch und werdet schwach. Da kann man sich wirklich fragen, ob es das Gemetzel wert war.');
INSERT INTO "item_descriptions" VALUES(6945,'de','Mit diesem Ring am Finger habt ihr unweigerlich das Bild der vielen niedergemetzelten Scarablätter vor euch und werdet schwach. Da kann man sich wirklich fragen, ob es das Gemetzel wert war.');
INSERT INTO "item_descriptions" VALUES(6946,'de','Mit diesem Ring am Finger habt ihr unweigerlich das Bild der vielen niedergemetzelten Scarablätter vor euch und werdet schwach. Da kann man sich wirklich fragen, ob es das Gemetzel wert war.');
INSERT INTO "item_descriptions" VALUES(6947,'de','Mit diesem Ring am Finger habt ihr unweigerlich das Bild der vielen niedergemetzelten Scarablätter vor euch und werdet schwach. Da kann man sich wirklich fragen, ob es das Gemetzel wert war.');
INSERT INTO "item_descriptions" VALUES(6948,'de','Einst diente ein Scara-Gurt dazu, die Fähigkeiten seines Trägers im waffenlosen Kampf einzuschätzen. Demnach wurde ein grüner Scara-Gurt an Anfänger vergeben, ein roter Scara-Gurt war ein Zeichen dafür, dass man das vergossene Blut seiner Feinde stets vom Boden aufzulecken pflegte, ein Weißer, dass man von Gegnern im Kampf niemals getroffen wird, und ein Blauer, dass der Träger zu arm war, um sich einen der anderen Scara-Gurte zu leisten.');
INSERT INTO "item_descriptions" VALUES(6949,'de','Einst diente ein Scaragurt dazu, die Fähigkeiten seines Trägers im waffenlosen Kampf einzuschätzen. Demnach wurde ein grüner Scaragurt an Anfänger vergeben, ein roter Scaragurt war ein Zeichen dafür, dass man das vergossene Blut seiner Feinde stets vom Boden aufzulecken pflegte, ein Weißer, dass man von Gegnern im Kampf niemals getroffen wird, und ein Blauer, dass der Träger zu arm war, um sich einen der anderen Scaragurte zu leisten.');
INSERT INTO "item_descriptions" VALUES(6950,'de','Einst diente ein Scaragurt dazu, die Fähigkeiten seines Trägers im waffenlosen Kampf einzuschätzen. Demnach wurde ein grüner Scaragurt an Anfänger vergeben, ein roter Scaragurt war ein Zeichen dafür, dass man das vergossene Blut seiner Feinde stets vom Boden aufzulecken pflegte, ein Weißer, dass man von Gegnern im Kampf niemals getroffen wird, und ein Blauer, dass der Träger zu arm war, um sich einen der anderen Scaragurte zu leisten.');
INSERT INTO "item_descriptions" VALUES(6951,'de','Einst diente ein Scaragurt dazu, die Fähigkeiten seines Trägers im waffenlosen Kampf einzustufen. Demnach wurde ein grüner Scaragurt an Anfänger vergeben, ein roter Scaragurt war ein Zeichen dafür, dass man das vergossene Blut seiner Feinde stets vom Boden aufzulecken pflegte, ein Weißer, dass man von Gegnern im Kampf niemals getroffen wird, und ein Blauer, dass der Träger zu arm war, um sich einen der anderen Scaragurte zu leisten.');
INSERT INTO "item_descriptions" VALUES(6952,'de','Mit dem WuWulfut auf dem Kopf habt ihr stets eine gute Entschuldigung für eventuellen Mundgeruch parat.');
INSERT INTO "item_descriptions" VALUES(6953,'de','Diese Stiefelchen aus WuWulffell sind sehr praktisch, um staubige Parkettböden zu reinigen. Allerdings eignen sie sich auch hervorragend dafür, Gegnern damit den Kopf zu waschen, wenn sie mal wieder jämmerlich zu euren Füßen liegen und vor sich hin sterben.');
INSERT INTO "item_descriptions" VALUES(6954,'de','Das Fell eines WuWulfs isoliert hervorragend gegen Kälte, sowie gegen alle anderen Abenteurer, deren Nase noch nicht abgestorben ist.');
INSERT INTO "item_descriptions" VALUES(6955,'de','Wird diese Gürtelschnur als Peitsche eingesetzt, so zeigen sich schnell ihre extrem motivierenden Eigenschaften. Sie funktioniert genauso gut bei kampfunwilligen Weggefährten wie bei gefährlichen Crocodylls und ist zu 100% natürlich abbaubar. Von führenden WuWulfs empfohlen!');
INSERT INTO "item_descriptions" VALUES(6956,'de','Vorsicht! Dieser Ring verleiht eurem Finger einen besonders üblen Wolfsgeruch. Aber wie heißt es so schön: ein Geruch kann einen anderen verdecken. Darum ist es vielleicht für euren Finger und für euer Umfeld am Ende eine sehr gute Sache...');
INSERT INTO "item_descriptions" VALUES(6957,'de','Dieses Schwert diente einst dazu, gewaltige Granitblöcke für die Wände berühmter Städte wie Bonta oder Brâkmar zurechtzuschlagen. Heutzutage wird diese Waffe eher dazu benutzt, alle möglichen lebenden Kreaturen zu zermalmen – mit oder gegen ihren Willen.');
INSERT INTO "item_descriptions" VALUES(6961,'de','Dieser Ring ist sowohl bei Zahnärzten, als auch bei echten Banditen verbreitet. Denn beide verwenden ihn gern dazu, Unvorsichtigen die Zähne zu entfernen. Nur eine Methode von vielen zur Vorsorge gegen Karies.');
INSERT INTO "item_descriptions" VALUES(6978,'de','Diese Kreatur ähnelt von Weitem einem SchnuffWuff. Ihr Kopf zeigt deutliche Spuren der schweren erlittenen Traumata, passt also gut darauf auf.');
INSERT INTO "item_descriptions" VALUES(6980,'de','Die Gerüchte, die sich um den Dofus Vulbis ranken, sind wirklich erschreckend. Man sagt, dass der Drache, der dieses rubinrote Ei erschaffen hat, erbarmungsloser sei als der Tod selbst und seine Opfer verschlinge, um seinen unersättlichen Appetit zu stillen. Legende oder Wahrheit? Das wissen nur Helden, die sowohl unerschrocken als auch schwer verdaulich sind.');
INSERT INTO "item_descriptions" VALUES(6981,'de','Die Klinge dieser Dolche besteht aus Eis, was sehr praktisch ist, um den schlechten Atem eurer Gegner etwas aufzufrischen. Reißt ihnen einfach den Mund auf, stoßt eure Eisdolche hinein und fertig. Ein Kinderspiel!');
INSERT INTO "item_descriptions" VALUES(6982,'de','Diese Dolche haben bereits das Blut einer Vielzahl dämonischer Kreaturen getrunken – von Kindern zum Beispiel –, was ihnen einen originellen Touch verpasst.');
INSERT INTO "item_descriptions" VALUES(6983,'de','Auch wenn sie nur einmal pro Jahrzehnt geschärft werden müssen, bleiben diese Dolche dennoch absolut tödlich. Zudem haust in ihnen dunkle Magie, die sie dazu antreibt, sich des Nachts davonzustehlen, um Unvorsichtige in den Allerwertesten zu pieksen. Das ist ganz klar wieder so eine Geschichte, die man jungen Iops erzählt, um ihnen Angst einzujagen.');
INSERT INTO "item_descriptions" VALUES(6984,'de','Diese Dolche gehörten einst einem armen Sadida, dessen blitzartiger Aufstieg in die Welt des Reichtums in ganz Amakna bekannt wurde. Dieser Sadida hatte beschlossen, Fresssäckchen jagen zu gehen, was alle Einwohner seines Heimatdorfes belustigte. Einige Schaulustige schauten sogar von den Hügeln aus zu, um ihn bei der Jagd zu verspotten. Seine Rache an ihnen war furchtbar... Inzwischen zu Geld gekommen, stellte er ein Kopfgeld auf sie aus, wodurch sie bis auf den letzten Spötter ausgelöscht wurden.');
INSERT INTO "item_descriptions" VALUES(6986,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(6988,'de','Dieser schicke Hut wurde ehemals von einem wilden Xélor getragen, dessen Schwester von skrupellosen Sklavenjägern entführt wurde. Mit ihm werdet ihr sicher sehr originell aussehen.');
INSERT INTO "item_descriptions" VALUES(6989,'de','Dieser Hut wurde vor langer Zeit von angehenden Schneidern angefertigt, die sich dadurch vor den Jähzornanfällen ihres Meisters, Mirko, dem Meisterschneider, schützen wollten. Letzterer hatte nämlich die üble Angewohnheit, seine Lehrlinge mit Fußtritten auf den Kopf zu dezimieren, wenn sie ihm nicht schnell genug arbeiteten. Eine brutale aber wirkungsvolle Methode, um Untergebene zur Arbeit anzutreiben, oder?');
INSERT INTO "item_descriptions" VALUES(6990,'de','Diese seltsame Kopfbedeckung wurde den entfernten Cousins der Moskitos, nämlich den Nachtfaltern gewidmet. Sie waren zwar noch viel dicker als die Moskitos, doch auch um einiges freundlicher und weniger blutrünstig. Bloß neigten sie dazu, sich mit allem und jedem (und zwar vor allem mit allem) paaren zu wollen, was erheblich zum beschleunigten Aussterben ihrer Art beitrug.');
INSERT INTO "item_descriptions" VALUES(6991,'de','Diese seltsame Kopfbedeckung mit dem komischen Namen ähnelt einer ausgetrockneten dicken Frucht im fortgeschrittenen Stadium der Zersetzung. Genau wie ihr nach einer durchzechten Nacht in der Taverne.');
INSERT INTO "item_descriptions" VALUES(6992,'de','Diese verfeinerte Version der berühmten Kanniballischen Maske lässt euch vor euren Freunden wie einen wahren Piepmatzjäger aussehen.');
INSERT INTO "item_descriptions" VALUES(6993,'de','Der Sadida Adia war ein überall gefürchteter Minnesänger, da er einfach seine Klappe nicht halten konnte. Ständig musste er allen seine Liebe beweisen, dass es nicht mehr auszuhalten war. Schließlich wurde er neben der Bank von Bonta öffentlich verbrannt, als sein Aufruf "Vielleicht ist das Licht eines flimmernden Sterns schon genug", die Wut in den Herzen all derer entflammte, denen die Sterne völlig schnuppe waren.');
INSERT INTO "item_descriptions" VALUES(6994,'de','Diese interessante Mischung aus einem Umhang und einer Abdeckplane verblüfft die Uneingeweihten auf den ersten Blick durch ihr geniales Design. Selbst der Chafer-Offizier würde ihn liebend gern tragen, wenn er doch nur aus reinem Leder bestünde. Die aktuelle Version jedoch schützt den Träger besser vor jeder Art von Feuchtigkeit und gibt ihm ein schönes Gefühl von Sicherheit.');
INSERT INTO "item_descriptions" VALUES(6995,'de','Dieser übermächtige Umhang hat bereits mehr als einen unvorsichtigen Möchtegernträger umgehauen. Diese Eigenschaft teilt er neben vielen anderen auch mit der Mumie Nova.');
INSERT INTO "item_descriptions" VALUES(6996,'de','Stradamus war ein alter, stets rattendichter Enutrof, der anderen die Zukunft aus Biergläsern las. Der Legende nach wurde er auf seinen eigenen Wunsch hin senkrecht in der Taverne von Brâkmar eingemauert, „damit kein Idiot unabsichtlich Bier über meinem Grab ausschüttet.“ Diese Art von Legende wird gerne bei wüsten Saufereien weitergegeben, die dort von den Serianen-Meistern regelmäßig organisiert werden.');
INSERT INTO "item_descriptions" VALUES(6997,'de','Die Erschafferin dieses Ringes dachte, das Ende der Welt sei nahe. Daher verbrachte sie ihre restlichen Tage damit mit Hilfe ihres Setzers in Holztäfelchen zu gravieren, dass die Einwohner Amaknas keine Zukunft mehr hätten. In der Folge stellte sich dann heraus, dass sie Unrecht hatte.');
INSERT INTO "item_descriptions" VALUES(6998,'de','Dieser kleine Ehering ist perfekt geeignet für die zarten Fingerchen von Eniripsas. Er ist hingegen so gut wie unbenutzbar für Iops mit ihren dicken Wurstfingern und ihrer Unfähigkeit zu begreifen, wo man diesen Ehering eigentlich anbringen muss.');
INSERT INTO "item_descriptions" VALUES(6999,'de','Lahilama war ein großer Guru am tiefsten Punkt des höchsten Gebirges. Dort langweilte er sich so sehr, dass er den ganzen Tag lang gelbe Mützen für seine Anhänger strickte.');
INSERT INTO "item_descriptions" VALUES(7000,'de','Diese lächerlich anmutende, kleine Halskette aus Bambusstückchen verfügt über seltsame magische Kräfte. Sie wurde früher von jungen Pandawas getragen, sobald diese die Pubertät durchlaufen hatten. Daher wird es wohl noch ein paar Jährchen dauern, bis ihr es um den Hals tragen werdet...');
INSERT INTO "item_descriptions" VALUES(7001,'de','„Uuuunnnnddd ich warte auf ein Zeeeeeiiiiiicccchhhhhheeeennnnnnnn ...“ pflegte Howie, der Fischer aus vollster Kehle zu singen, wenn er seine Angel an seinem Geheimtipp für Karpf''Ediems auswarf, einem kleinen, versteckten Teich auf der Moon-Insel.');
INSERT INTO "item_descriptions" VALUES(7002,'de','Dieses Amulett aus Bambusharz verbreitet einen sehr angenehmen Geruch um euch herum. Das ist zum Beispiel sehr nützlich, um misslungene Versuche beim Wirken von Panikwellen zu vertuschen.');
INSERT INTO "item_descriptions" VALUES(7003,'de','Dieser Talisman besteht aus feinem Sternenstaub und Edelsteinen, die in Bernstein eines Ur-Astaknyden eingefasst wurden. Diese Mischung ist manchmal hochexplosiv. Darum ist es angeraten, sich niemals selbst an ihrer Herstellung zu versuchen, sondern diese Angelegenheit einem Juwelier eurer Unzufriedenheit zu überlassen.');
INSERT INTO "item_descriptions" VALUES(7011,'de','Dieser beinahe lebende Umhang mit rotem Fellbesatz ist wirklich einzigartig. In ihm steckt die mächtige Magie des Chaos. Dies merkt man sofort daran, dass er es liebt, Schabernack mit seinem Träger zu treiben – dazu gehört auch, sich jedes Mal unsichtbar zu machen, wenn sein Träger auf Abenteuer losziehen möchte. Aber glücklicherweise gleicht sich diese kleine Verrücktheit dadurch aus, dass er laut gewisser Wabbits "ein wewitablew Kwell dew Zewstöwung im Kwampf" sei.');
INSERT INTO "item_descriptions" VALUES(7012,'de','Dieses Amulett ist in Wirklichkeit eine Süßigkeit. Sie könnte auch gegessen werden, wenn eine Horde brünftiger, weiblicher Bworks sie nicht über 36 Generationen unter der Achselhöhle aufbewahrt hätte.');
INSERT INTO "item_descriptions" VALUES(7022,'de','Dieser Stock gehörte einst dem Großvater Sangrokus. Dieser, Sangrokran genannt, war für seinen dicken Kopf bekannt. Der Legende nach soll sich dieser magische Stock beliebig lang strecken können, um auch weit entfernte Gegner zu erreichen - oder auch einfach nur um gewisse Minderwertigkeitskomplexe auszugleichen.');
INSERT INTO "item_descriptions" VALUES(7029,'de','Immer wenn Sangroku wieder einmal zu viel von seinen magischen Bohnen genascht hatte, pflegte er diesen Gürtel enger zu schnallen, um die Panikwellen in seinem Inneren besser einschließen zu können, für die er im ganzen ewigen Lande von Amakna berühmt war.');
INSERT INTO "item_descriptions" VALUES(7031,'de','Der arme Gudul hat in einem furchtbaren Kampf mit Many den Kopf verloren. Glücklicherweise ist sein Amulett bei dieser Auseinandersetzung nicht beschädigt worden. Seine hypnotisierenden, aber dabei leider auch abführenden Eigenschaften sind erhalten geblieben. Sollte mit Bedacht eingesetzt werden.');
INSERT INTO "item_descriptions" VALUES(7034,'de','Dieser alte, zerbeulte Helm wird bereits seit langem von Generation zu Generation weitergegeben. Er soll sogar eine Zeitlang von Crail höchstpersönlich getragen worden sein. Viele Abenteurer schreiben ihm daher wunders welche Kräfte zu, die er überhaupt nicht besitzt. Eine Eigenschaft, die gleichfalls bei vielen Gottheiten und Helden der Neuzeit verbreitet ist.');
INSERT INTO "item_descriptions" VALUES(7037,'de','Dieser Spazierstock gehörte Oma Pralinchen höchstpersönlich, also einer der drei furchtbaren Liebespriesterinnen. Auf der einen Seite scharf, auf der anderen spitz, war dieser Spazierstock dafür berüchtigt, extrem vielseitig einsetzbar zu sein. Er soll sich wann auch immer, wohin auch immer, bei wem auch immer, und überhaupt überall hineinbohren können. Da bleibt kein Auge trocken.');
INSERT INTO "item_descriptions" VALUES(7038,'de','Dieser Krone gehörte einst dem berühmten König Gelax. Er stand im Ruf, mit seinem überschwenglichen Sinn für Romantik und seiner verführerischen Ausstrahlung das Leben mehr als eines weiblichen Gelees nachhaltig geprägt zu haben... Man munkelt sogar, er sei der Vater aller Gelees von Amakna... Falls das stimmt, wäre es ein klarer Beweis für die Ausdauer und Fruchtbarkeit, die in ihm steckt.');
INSERT INTO "item_descriptions" VALUES(7039,'de','Der berüchtigte Sonntagskämpfer Frank begann seine Kampfkunst-Karriere, nachdem er mit Pauken und Trompeten durch seine Diplomprüfungen als Steinmetz gefallen war.');
INSERT INTO "item_descriptions" VALUES(7040,'de','Dieser Bogen gehörte Kuri, der berühmten Liebespriesterin und linken Hand von Oma Pralinchen höchstpersönlich. Übrigens: Kehrt niemals einer Liebespriesterin den Rücken zu! Ein einziger Pfeil ihres Bogens kann euch das Herz zerreißen - oder sogar den Allerwertesten.');
INSERT INTO "item_descriptions" VALUES(7043,'de','Der Legende nach kommt dieser wunderschöne Dofus geradewegs aus dem frostigen Innersten Aguabrials, dem Wasserdrachen. Die Legende erwähnt allerdings nicht die Tatsache, dass er an diesem Tag erkältet war. Das ist dennoch leicht zu erraten.');
INSERT INTO "item_descriptions" VALUES(7056,'de','Dieser einzigartige Hut gehörte einst einem Xélor, der für seine hochexplosiven Ideen und seine Meisterung der Zeit bekannt war. Sein Tod wäre ein Fall für die Darwin Awards. Ihn überkam eine schwere Panikwelle, die die gesamte Umgebung in Mitleidenschaft zog, während sein Hut mal wieder kleine Funken warf. Seinen Tod tat er mit einem lauten Knall kund, der die gesamte Stadt Brâkmar einige Sekunden lang taghell erleuchtet haben soll.');
INSERT INTO "item_descriptions" VALUES(7058,'de','Dieser Hut wurde aus getrockneten Resten toter Krakamore angefertigt. Daher kann es passieren, dass wieder Leben in ihn zurückkehrt, solltet ihr ihn als Badekappe gebrauchen. Also Vorsicht!');
INSERT INTO "item_descriptions" VALUES(7069,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7070,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7071,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7072,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7073,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7074,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7075,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7076,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7077,'de','Dieser gelbe, saugfähige Schild mit vielen Poren wurde aus den Überresten eines Tieres gefertigt, welches sich in einer Maskananas am Meeresgrunde verkrochen hatte.');
INSERT INTO "item_descriptions" VALUES(7078,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
