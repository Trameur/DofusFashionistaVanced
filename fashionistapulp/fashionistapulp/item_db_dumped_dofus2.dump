INSERT INTO "item_craft_jobs" VALUES(29463,60,15);
CREATE TABLE item_descriptions (
            item INTEGER,
            language TEXT,
            description TEXT,
            PRIMARY KEY (item, language),
            FOREIGN KEY (item) REFERENCES items(id)
        );
INSERT INTO "item_descriptions" VALUES(44,'en','This basic sword won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(49,'en','This well-forged sword is ideal for beginners.');
INSERT INTO "item_descriptions" VALUES(55,'en','Highly prized by young Iops, this sword will make a hero of you if you know how to handle it... However, be careful. Don''t get too attached to it as it always falls down a well. Eventually, here or there, it''ll fall down a well. Don''t even try to avoid wells... you could be in a desert and THIS SWORD WOULD FALL DOWN A WELL. Got it?');
INSERT INTO "item_descriptions" VALUES(58,'en','This sword, soaked in a young Boowolf''s tears, is said to bring luck and is supposed to fill warriors with courage on the battlefield. Ah, the naivety of terror.');
INSERT INTO "item_descriptions" VALUES(62,'en','Designed by a blacksmith with double vision, this sword is very popular in Brakmar. As a popular slogan in the local militia says, "Ha Sword, will travel!" Just the sight of it will leave even your most courageous enemies cross-eyed with terror.');
INSERT INTO "item_descriptions" VALUES(65,'en','The sword Goultard was quenched in the blood of a Dragon Pig. The hero who can resist the sword''s powerful stench will find himself climbing the social ladder very quickly indeed.');
INSERT INTO "item_descriptions" VALUES(66,'en','This sword captures the sights, the sounds and the smells of Badoul, the brave, bloodthirsty and above all punctual warrior who one day left his clan due to artistic differences.');
INSERT INTO "item_descriptions" VALUES(67,'en','Sharp and diabolical: these were the wide-eyed words of the succubus who fathered this deadly little minx. Minx? Fathered? Damn, that was the page about Vald''s sister. Sorry about that.');
INSERT INTO "item_descriptions" VALUES(70,'en','This amulet increases the wearer''s Intelligence.');
INSERT INTO "item_descriptions" VALUES(77,'en','This amulet increases the wearer''s Strength.');
INSERT INTO "item_descriptions" VALUES(84,'en','This amulet increases the wearer''s Vitality.');
INSERT INTO "item_descriptions" VALUES(91,'en','This basic bow won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(97,'en','This basic pair of daggers won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(103,'en','This ring increases the wearer''s Wisdom.');
INSERT INTO "item_descriptions" VALUES(112,'en','This ring increases the wearer''s Chance.');
INSERT INTO "item_descriptions" VALUES(121,'en','This ring increases the wearer''s Agility.');
INSERT INTO "item_descriptions" VALUES(127,'en','These exceptional boots will grant you an extra Movement Point in combat. However, the smell of Bowisse''s feet will quickly stop you in your tracks again if you accidentally bring them too close to your nose.');
INSERT INTO "item_descriptions" VALUES(130,'en','These boots are perfect for that special coup de grace.');
INSERT INTO "item_descriptions" VALUES(134,'en','This basic wand won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(140,'en','This basic staff won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(147,'en','This basic hammer won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(153,'en','This basic shovel won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(156,'en','This Power Belt will render you particularly powerful during fights but its weight will considerably decrease your Agility.');
INSERT INTO "item_descriptions" VALUES(157,'en','The Gougnole is made of a moon stone that was marinated for 5,000 years in a barrel of beer. This has inevitably endowed it with terrific powers.');
INSERT INTO "item_descriptions" VALUES(158,'en','The Golden Destiny will considerably increase your Vitality and Agility.');
INSERT INTO "item_descriptions" VALUES(159,'en','People say the famous blacksmith Boulgur made this brooch. Yes, the guy who created weapons for the gods.');
INSERT INTO "item_descriptions" VALUES(160,'en','This amulet, cast in a mixture of celestial eggs and milky stardust, must be kept refrigerated.');
INSERT INTO "item_descriptions" VALUES(161,'en','This powerful amulet will certainly make a name for you.');
INSERT INTO "item_descriptions" VALUES(165,'en','A well-carved wand, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(180,'en','This wand comes from the Syrastass Limbo. The legends say that it can make entire fields of daisies bloom, if asked politely by its bearer.');
INSERT INTO "item_descriptions" VALUES(181,'en','Helle from High in the Sky blessed this wand. It gives its bearer Agility and Vitality in combat.');
INSERT INTO "item_descriptions" VALUES(183,'en','A well-carved staff, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(188,'en','This staff increases Wisdom. It has one awkward side effect... I''m sure you can guess.');
INSERT INTO "item_descriptions" VALUES(194,'en','This staff increases Vitality and can be eaten if required.');
INSERT INTO "item_descriptions" VALUES(200,'en','The God Rod is a fearsome weapon. Warriors have been known to win battles in their sleep with the aid of this... fearsome weapon.');
INSERT INTO "item_descriptions" VALUES(201,'en','The Hook was found on a corpse, near a huge, decomposing Crocodyl.');
INSERT INTO "item_descriptions" VALUES(202,'en','This sword was blessed by the tears of the angel Raziel. Terribly destructive, it''s powerful enough to help you fend off the most fearsome of enemies.');
INSERT INTO "item_descriptions" VALUES(203,'en','If you ever work out how to get this incredible item around your waist, you''ll be one of the luckiest heroes in the universe. It used to belong to the strongest and most attractive of the bearded heroes of old.');
INSERT INTO "item_descriptions" VALUES(204,'en','This living staff roamed the darkest corners of Amakna for aeons. Now it sleeps deeply, only waking up every 300 years to move to a different place or to look for a different owner. It favours the stench of small, sweaty tunnels.');
INSERT INTO "item_descriptions" VALUES(208,'en','These well-forged daggers are recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(214,'en','These well-forged daggers will make a worthy adversary of you.');
INSERT INTO "item_descriptions" VALUES(218,'en','Bashers are formidable daggers favoured by assassins who must dispatch the most bloodthirsty of warriors.');
INSERT INTO "item_descriptions" VALUES(219,'en','These Blessdags once belonged to the renowned Ogre ''Dark Hand'' who died while fighting a Bimd''Oole paladin. Apparently, his blood animates their twisted blades.');
INSERT INTO "item_descriptions" VALUES(220,'en','The Chakra Style... a pair of daggers that once belonged to the greatest female thief of all time. Chakra was the first to open the doors of the Osaroth Temple and steal the precious relics hidden within.');
INSERT INTO "item_descriptions" VALUES(224,'en','A well-forged hammer, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(230,'en','This hammer increases its bearer''s intelligence.');
INSERT INTO "item_descriptions" VALUES(233,'en','Kaiser was the name of the dastardly Dragon Pig who destroyed Bounkaïda Village many years ago. When the militia got the better of this monster, the smiths used his remains to make weapons. This hammer is one of them.');
INSERT INTO "item_descriptions" VALUES(234,'en','Ragnarok is powerful enough to raise a storm. It can also raise the temper of your friends if you don''t know how to use it properly.');
INSERT INTO "item_descriptions" VALUES(235,'en','This hammer once belonged to the guardian of the Door of Hell. He prevented the living from coming in, the dead from going out and the living dead from urinating through the letterbox. Dirty monkeys!');
INSERT INTO "item_descriptions" VALUES(236,'en','Barabas is a fearsome weapon: it allows its wearer to move with stealth and ease and most importantly, to become even deadlier in close combat.');
INSERT INTO "item_descriptions" VALUES(237,'en','Sargasse once belonged to a child with fearsome powers. No one has seen it since it was reportedly traded for a bag of marbles.');
INSERT INTO "item_descriptions" VALUES(241,'en','A well-balanced shovel, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(247,'en','An extremely well-forged shovel, this tool will make a worthy adversary of you.');
INSERT INTO "item_descriptions" VALUES(250,'en','Halfway between an axe and a shovel, Axel was one of the seven weapons used by the demon Kajlir to overcome the Brotherhood of the Enutrofs, vicious adventurers searching for the Crimson Dofus.');
INSERT INTO "item_descriptions" VALUES(251,'en','Greybeard was the favourite weapon of the demon-dwarf Assan Cehef who terrorised countless villages with his surprise attacks.');
INSERT INTO "item_descriptions" VALUES(255,'en','This belt increases its wearer''s Vitality, increasing their chances of surviving a fight.');
INSERT INTO "item_descriptions" VALUES(259,'en','This belt increases its wearer''s Strength.');
INSERT INTO "item_descriptions" VALUES(263,'en','This belt increases its wearer''s Agility.');
INSERT INTO "item_descriptions" VALUES(267,'en','The Disconcerting Bow is not new by any means, but it can be very useful.');
INSERT INTO "item_descriptions" VALUES(270,'en','Xaver is an efficient bow. It once belonged to the great baker Xavier. Between two batches, he used it to distribute bread to the monsters around his bakery.');
INSERT INTO "item_descriptions" VALUES(271,'en','This hammer is a beautiful, strange and fascinating weapon. Make sure you get nice and close to your enemy before you use it - that''s the way Chafers like it, after all!');
INSERT INTO "item_descriptions" VALUES(272,'en','This bow is powerful enough to shoot an arrow to the moon.');
INSERT INTO "item_descriptions" VALUES(273,'en','Yamato''s Rope has made more than one monster''s heart beat a little faster. A finely tuned weapon, it can direct arrows to even the most well-hidden targets.');
INSERT INTO "item_descriptions" VALUES(278,'en','A ring set with a rare stone. Do I need to explain the name?');
INSERT INTO "item_descriptions" VALUES(279,'en','If we are to believe one renowned adventurer, this amulet contains a tear from a Gobball, which has the same properties and stench as Gobball Leather tea.');
INSERT INTO "item_descriptions" VALUES(280,'en','Collectors prize this necklace, you will certainly get a good price for it.');
INSERT INTO "item_descriptions" VALUES(296,'en','The only thing as solid as a Crackler is a Crackler, that''s why this Crackler hunting shovel is made of Crackler Stone.');
INSERT INTO "item_descriptions" VALUES(298,'en','These sandals are made from the feathers of boiled Tofu and the sole from Tofu Beak, a very resistant material. Protracted wearing can render the wearer as daft as a Tofu.');
INSERT INTO "item_descriptions" VALUES(299,'en','Attack is the best defence. With these anti-aggression boots, you will easily send muggers packing. And those guys who come up to you at crossroads to clean your mount''s teeth.');
INSERT INTO "item_descriptions" VALUES(320,'en','This staff used to be very handy for Amakna breeders who wanted to keep their flocks of Tabis in one place. It doesn''t actually do much, but it is very light. Great for running after Gobballs.');
INSERT INTO "item_descriptions" VALUES(323,'en','This amulet gives the wearer special abilities: they will be possessed by a mysterious aura, which flows through their bodies and increases their physical abilities tenfold.');
INSERT INTO "item_descriptions" VALUES(324,'en','This amulet turns pink when you''re feeling perky. Rumour has it that it also increases your chances of finding good items tenfold.');
INSERT INTO "item_descriptions" VALUES(325,'en','Handmade by one of the greatest Sram jewellers, this amulet is made of small skulls carved in bone, helping its wearer escape perilous situations.');
INSERT INTO "item_descriptions" VALUES(326,'en','This amulet comes from the Nordic regions. It will increase your summoning powers.');
INSERT INTO "item_descriptions" VALUES(327,'en','This blade was originally forged for Gob-Trotters but is actually much too heavy for those puny goblins. It''s a very light weapon for normal beings, however – light enough to deliver rapid blows in succession.');
INSERT INTO "item_descriptions" VALUES(328,'en','This strange double-bladed sword was originally used to prune trees and cut through dense forests. The lumberjacks soon realised that it was also an excellent weapon against other creatures.');
INSERT INTO "item_descriptions" VALUES(329,'en','As its name indicates, this bow will help you on your path to consistent victory. A skilled Cra architect without an ounce of imagination later stole the same name for one of his monuments.');
INSERT INTO "item_descriptions" VALUES(331,'en','This is the bow of choice in the region. From what people say, you''ll find treasure where its arrows fall. You have to make sure you fire them towards the end of a rainbow, but I still think it''s crazy.');
INSERT INTO "item_descriptions" VALUES(332,'en','Joan was a little crazy, always hearing Tabis burping she said... They confiscated her bow - for her own good, mind you - and finally decided to burn her at the stake altogether. She burnt great, she did. Really something else... And I''ve seen a few burnings, me... I still have her singed kneecap if you want... come... hey! Where... ahhhh!');
INSERT INTO "item_descriptions" VALUES(333,'en','Originally made to be eaten, this baguette became a fearsome weapon when Xavier the Baker left it in the oven for 234 years. Why did he leave it for so long? Well, he reached a point where he''d had enough of making cheese sandwiches, and so he started handing out knuckle sandwiches to the monsters around the bakery instead. He had so much fun, he forgot all about the baguette.');
INSERT INTO "item_descriptions" VALUES(334,'en','This wand used to belong to Liriel, the Eniripsa, who suffered a painful death from a strawberry overdose and lost his wings with a cry that curdled more than just the cream. Collectors are surprisingly desperate to get hold of this wand, given that it''s said to be cursed.');
INSERT INTO "item_descriptions" VALUES(335,'en','Without their staffs, Bwork magi are as harmless as peckless Tofus. Need I say more about the power of this staff?');
INSERT INTO "item_descriptions" VALUES(336,'en','This staff can levitate Cawwots! Mind you, that''s not much use in fights.');
INSERT INTO "item_descriptions" VALUES(337,'en','The Bwork Archer Bow is extremely simple to use. It was designed with the Bwork Archers in mind... A bloody Tofu could use it... The catch is that you have to be as strong as a Crackler to string it.');
INSERT INTO "item_descriptions" VALUES(339,'en','This blade once belonged to Metzger the butcher, who used it to cut up bones. A Chafer managed to steal it from him and the blade became a fearsome weapon in his hands. Whole families of shoe salesmen went out of business, not to mention the glove trade... just terrible.');
INSERT INTO "item_descriptions" VALUES(340,'en','These daggers allow you to steal anything and everything, anything from everyone, or everything from anyone, or everyone from any... no that doesn''t work... They''re great, though.');
INSERT INTO "item_descriptions" VALUES(341,'en','These legendary daggers are a true collector''s item for any self-respecting Sram. They are so revered that even some of these rats refuse to steal them.');
INSERT INTO "item_descriptions" VALUES(342,'en','This very special hammer was made of Kwak Beaks. That''s why it''s so prickly when it knocks you head over heels!');
INSERT INTO "item_descriptions" VALUES(346,'en','According to some legends, this ring protects against bad weather. In reality, this has never been proven because it has never rained in Amakna.');
INSERT INTO "item_descriptions" VALUES(347,'en','This shovel is a very efficient tool for cutting nutsedge, a type of weed. It''s also an excellent weapon for taking care of the weeds you''ll find in the inns of Amakna.');
INSERT INTO "item_descriptions" VALUES(348,'en','These boots once belonged to a cook who was always in a big rush. He spent his time criss-crossing the land of Amakna looking for celery-tea.');
INSERT INTO "item_descriptions" VALUES(354,'en','This kind of sword is forged for the bodyguards of a renowned and wealthy shopkeeper. Its main use consists of frightening thieves but when murder is required - a tenacious burglar, a fussy customer - you''ll find it equal to the task.');
INSERT INTO "item_descriptions" VALUES(355,'en','This ring increases Strength and Chance.');
INSERT INTO "item_descriptions" VALUES(356,'en','This simple belt increases stamina.');
INSERT INTO "item_descriptions" VALUES(357,'en','This sword symbolises a body part of which Ecaflips are particularly proud. If you don''t feel it''s hypocrisy to take it, be my guest.');
INSERT INTO "item_descriptions" VALUES(358,'en','The Infernal Tail is really... infernal. If you don''t use it properly, it will drive your enemies and teammates completely crazy. Before long, you won''t have any teammates left, just enemies. Nobody has ever been known to use it properly, so, well, you''ve been warned.');
INSERT INTO "item_descriptions" VALUES(359,'en','A long time ago, King Allister gave this ring to Isidor, a smart cat, renowned for his incomparable Agility.');
INSERT INTO "item_descriptions" VALUES(436,'en','This staff is carved out of a huge Treechnid Root, and its main use is in close combat. The only problem for the owner is that its roots regenerate when in contact with water... That includes rain, by the way.');
INSERT INTO "item_descriptions" VALUES(455,'en','This ridiculously small hammer was used by Zokrim the peasant. Every day at dawn, he would work on his useless, meandering fences which still stretch all over his territory like confused spider webs.');
INSERT INTO "item_descriptions" VALUES(456,'en','This axe enables you to easily cut down trees, even the biggest ones. It is, above all, appreciated for its heavy weight which can cut a Bwork into three pieces. The only requirement is that you are strong enough to lift it!');
INSERT INTO "item_descriptions" VALUES(458,'en','Some say the Chafer is sensitive and distinguished, because his amulet carries the skulls of his dead cousins. Others say he''s a beastly creature, because it was he who killed them.');
INSERT INTO "item_descriptions" VALUES(462,'en','Though you can kill the Treechnids, their wood never truly dies... this makes it incredibly difficult to work. All the same, killing a Treechnid with an arrow made of the root of one of its brothers will really hit hard, and if they don''t die, you can be sure it''ll ruin their lives forever! Good show!');
INSERT INTO "item_descriptions" VALUES(469,'en','This wand makes use of the magic properties of the Treechnid Root. Beware of the side effects of this living wand, it can sometimes turn against its owner.');
INSERT INTO "item_descriptions" VALUES(478,'en','This axe has Woodee the Lumberjane to thank for its name... She knew how to turn on the charm and divert the lumberjacks'' attention, running in and stealing all the best trees for herself while they scurried off to pay ridiculous prices for rosebuds, sugarcane and those little snow globes that you shake... as soppy as wells they were.');
INSERT INTO "item_descriptions" VALUES(484,'en','An Enutrof builder who''d had a few drinks too many at the tavern realised one night that this shovel could do more than dig holes in the ground.');
INSERT INTO "item_descriptions" VALUES(489,'en','With this Magnifying Glass, you''ll be able to analyse the elements of your surroundings. Treasures will be yours!');
INSERT INTO "item_descriptions" VALUES(502,'en','This axe is the only tool that can cut down enchanted trees. It''s the silver bullet of axes.');
INSERT INTO "item_descriptions" VALUES(515,'en','This axe once belonged to the renowned lumberjack, Brouce Boulgoure. He used to be married to Kassiopee Baine, another great lumberjack''s daughter. Many''s the time this weapon protected him when he was alone in the forest.');
INSERT INTO "item_descriptions" VALUES(592,'en','This bow once belonged to Ivan Nowe, a foolhardy Cra who had a cruel habit of attacking stray Tofus. This bow first puzzles the enemy before efficiently killing them.');
INSERT INTO "item_descriptions" VALUES(610,'en','This delicate but original whitish amulet is made of Crab.');
INSERT INTO "item_descriptions" VALUES(616,'en','This amulet, set with fish scales, is supposed to bring its wearer good luck when he puts out to sea on stormy nights.');
INSERT INTO "item_descriptions" VALUES(617,'en','Many sailors have been impressed by this terrifying amulet. All you have to do is put it on and you''ll be a feared warrior.');
INSERT INTO "item_descriptions" VALUES(619,'en','This staff allowed Paile Ingalsse, breeder of Gobballs, to summon the Tofus that kept his flocks safe. After a tragic accident, he discovered that it was also a fierce weapon.');
INSERT INTO "item_descriptions" VALUES(620,'en','Thanks to this sword, the celebrated sailor Mobby Diquerivurs sliced the tentacles off the equally famous Giant Kralove of Moon Island, much feared for his habit of smothering drunken sailors.');
INSERT INTO "item_descriptions" VALUES(629,'en','Everyone will want this magnificent hat when you go the masked ball, hey hey!');
INSERT INTO "item_descriptions" VALUES(638,'en','Fishing a Somoon is quite a miracle but don''t worry, with this amulet around your neck, there''s no such word as "can''t".');
INSERT INTO "item_descriptions" VALUES(639,'en','This Amulet of the Depths was found in the submerged shipwreck of the renowned Kralove fisherman, Tom Fawyer, also famous for his lousy jokes at the pirates'' bar.');
INSERT INTO "item_descriptions" VALUES(640,'en','Fishermen used this bow to clean the vermin off the coastlines of Amakna... The cowards usually committed the pesticide from the windows of the local bars.');
INSERT INTO "item_descriptions" VALUES(657,'en','This staff allowed Shika Ingalsse, leader of Gobballs, to summon the Tofus that kept her flocks safe. After a tragic accident, she discovered that it was also a fierce weapon.');
INSERT INTO "item_descriptions" VALUES(658,'en','This staff allowed Gramine Ingalsse, leader of Gobballs, to summon the Tofus that kept his flocks safe. After a tragic accident, he discovered that it was also a fierce weapon.');
INSERT INTO "item_descriptions" VALUES(673,'en','This axe has no outstanding features except its natural lightness which is due to the Chestnut Wood it is made from. It has a shaft as light as a feather from the tail of a young Evil Tofu.');
INSERT INTO "item_descriptions" VALUES(674,'en','"There''s nothing wrong with this axe... Seriously, nothing. Really." The wise words of Brouce Boulgoure, lumberjack extraordinaire. Its Cherry Wood shaft cushions vibrations when you''re cutting trees down or splitting Bworks'' skulls.');
INSERT INTO "item_descriptions" VALUES(675,'en','This axe doesn''t look special, but it gets the job done. Brouce Boulgoure the lumberjack won the Bwork Dwarf tree-cutting championship with this modest tool - that''s saying something.');
INSERT INTO "item_descriptions" VALUES(676,'en','This axe''s special feature is that it never gets rusty, so don''t be surprised when hungry lumberjacks start licking the sweet tree sap from its blade.');
INSERT INTO "item_descriptions" VALUES(677,'en','This cloak once belonged to Zokrim, an old pirate. He must have been rather unlucky.');
INSERT INTO "item_descriptions" VALUES(694,'en','Ignemikahl the Fire Dragon created the Crimson Dofus. I would tell you that it stinks of sulphur... but it stinks of so many other things too.');
INSERT INTO "item_descriptions" VALUES(696,'en','Besides its has-been look, the Slob Headgear is great for those high-noon duels... keeps some sun out of your eyes.');
INSERT INTO "item_descriptions" VALUES(697,'en','Makroute is a very affectionate dog. He never leaves his master''s side. A fine animal.');
INSERT INTO "item_descriptions" VALUES(698,'en','The Sortingat Hogwat comes from a famous School of Magic. This lively creature has met the greatest wizards of our time, like Mrs Magoa AlaGale, Mr Doublegore and the renowned Misk''arry Rotter.');
INSERT INTO "item_descriptions" VALUES(699,'en','The Troma is as shady as an eraserhead made of Bherb hairs, and that''s saying something (if you don''t know what an eraserhead made of Bherb hairs looks like, refer to the great books of the Hen Pens).');
INSERT INTO "item_descriptions" VALUES(700,'en','Ah, the Pandawa, look at the face on him! Just like his good friend Makroute, he spends all his time on his owner''s head. This lazy beast never needs to move more than an arm''s length - he steals all he needs straight from his owners hands!');
INSERT INTO "item_descriptions" VALUES(701,'en','The Oiram has many fans throughout the World who just love its classy look. This hat once belonged to a plumber who spent his days cleaning pipes. He was quite stylish himself.');
INSERT INTO "item_descriptions" VALUES(702,'en','This demon skull, constructed from various bones, gives its bearer a graceful and elegant look. Even your lover will be sick with envy.');
INSERT INTO "item_descriptions" VALUES(703,'en','This magical hat, which looks like an upside-down wicker fruit basket, is in fact... a magical upside-down fruit basket hat. It will certainly impress the neighbours, especially if they are Bwork Magus apprentices.');
INSERT INTO "item_descriptions" VALUES(704,'en','With this hat made from Chafer Lancer Leather Briefs, the female Bwork Magi won''t be able to resist you. That''s not a good thing, mind - many are known to wear long, red beards and none are known for their femininity.');
INSERT INTO "item_descriptions" VALUES(705,'en','If what you''re looking for is a bit of trauma, you''ll find great relief in this magnificent Rokokonut. We remind you that a free straw and many a mouthful of fresh Rokokonut-flavoured goodness are waiting for you inside.');
INSERT INTO "item_descriptions" VALUES(706,'en','Hung ''Short Memory'' Lekahurse owned a magnificent crystal ball - his grandpa gave it to him. He wisely decided to hold on to it for the rest of his life. In fact, he put it on his hat which he never took off again, until one day, a jealous breeze took it away. He followed, and the breeze seemed to mock him, suspending the hat in the air, and whipping it away just as his searching fist approached. Not without a sense of decency, the wind took him home for a brief visit once a season and when it sensed the poor man was close to the end, took him to the edge of a cliff, hung the hat there for a moment and down Lekahurse tumbled, at peace at last.');
INSERT INTO "item_descriptions" VALUES(707,'en','With this Minotoror Horn hat, you''ll have no problem passing yourself off as a Minotoror if your confidence in your own powers is failing. This trickery only works on simple-minded creatures such as Iops and Tofus.');
INSERT INTO "item_descriptions" VALUES(708,'en','This brand new, magical, Green Larva Skin hat gives its bearer a jolly appearance... jolly but incredibly stupid. We can''t always get what we want and this hat is a perfect example.');
INSERT INTO "item_descriptions" VALUES(709,'en','This hat of enchanted bark once belonged to Lorko, a lumberjack. He challenged the renowned Brouce Boulgoure to an Elm uprooting duel in Liroye Merline.');
INSERT INTO "item_descriptions" VALUES(710,'en','The Korko Klako is a beautifo hato worno by the mo handso Sadido.');
INSERT INTO "item_descriptions" VALUES(711,'en','This magnificent leather mask once belonged to Jouik Krampe, cousin of Zeurg. They were both fond of tight leather clothes. A bit like Captain Chafer, only not as depraved.');
INSERT INTO "item_descriptions" VALUES(712,'en','This hat is so original that you will soon think you''re fantastic, unique and on top of the World. It is said that in bygone days, Rakmar Bilgout used it to charm the queen of the Gobballs. He didn''t hesitate to cut her throat open afterwards... Nothing to do with the hat I hope.');
INSERT INTO "item_descriptions" VALUES(732,'en','This magnificent wedding ring was stolen from Silimelle, a female brewer, during a boozy meal at the inn. See what happens when you accept drinks from strangers?');
INSERT INTO "item_descriptions" VALUES(733,'en','Without any doubt, Ragalde was one of the most foolhardy Iop warriors. With these magic boots, he slew a great number of enemies.');
INSERT INTO "item_descriptions" VALUES(734,'en','This belt is the weapon of choice for crowd control in Amakna prison and at the annual town fair.');
INSERT INTO "item_descriptions" VALUES(737,'en','Greener than a sick Tofu, the Emerald Dofus was created by Aerafal the Air Dragon. To create such a green thing, he was certainly feeling airsick. That bodes well for its powers, doesn''t it?');
INSERT INTO "item_descriptions" VALUES(739,'en','The Turquoise Dofus was created by Aguabrial, the Water Dragon. Isn''t it incredible what a Dragon can do with some water?');
INSERT INTO "item_descriptions" VALUES(742,'en','"I am the eggman, I am the Dofus. Waka fu ku." The last words recorded by the renowned axe smith-cum-minstrel, Jon Lemon. Soon after, he was crushed by a giant Tofu egg.');
INSERT INTO "item_descriptions" VALUES(744,'en','This cloak is an often underestimated one-of-a-kind. It is made of Green Larva Skin, giving it a most pleasant, rugged appearance.');
INSERT INTO "item_descriptions" VALUES(754,'en','Marinated in pure blood for many long years, this cloak has acquired a ruby red colour that is very pleasing to the eye. This cloak is much favoured during the Al Howin''s Day celebrations.');
INSERT INTO "item_descriptions" VALUES(758,'en','This cloak can only be worn by the great Bontarian dispensers of justice... It''s not very popular.');
INSERT INTO "item_descriptions" VALUES(759,'en','This magnificent cloak was made with the feathers of the very last Cheeken of Amakna. It''s a real rarity that collectors dream of hanging on their living room wall.');
INSERT INTO "item_descriptions" VALUES(765,'en','This scythe once belonged to Farle Ingalsse himself. It is sharp enough to mow any kind of cereal and any kind of monsters hidden in cereal fields.');
INSERT INTO "item_descriptions" VALUES(766,'en','This amulet tickles your curiosity... and your neck.');
INSERT INTO "item_descriptions" VALUES(767,'en','Don''t mind its stuck-up name, this ring can only make your hero stronger. Okay, his chin will shrink too, but hey, who cares!');
INSERT INTO "item_descriptions" VALUES(768,'en','This ring influences your fate. You''ll be tougher but less lucky. In other words, you improve your chances of living a long time and ruin your chances of living happily.');
INSERT INTO "item_descriptions" VALUES(769,'en','These boots bring good fortune. Unfortunately, they decrease your resistance.');
INSERT INTO "item_descriptions" VALUES(771,'en','This axe is nothing exceptional but it is appreciated by lumberjack apprentices for its simplicity of use.');
INSERT INTO "item_descriptions" VALUES(772,'en','According to what people say, this legendary cloak makes you almost invisible when combined with the fencers'' legendary sword, the Dart Onion, and to the legendary hat of the Six Rams of the Rahk Shepherds.');
INSERT INTO "item_descriptions" VALUES(773,'en','This light cloak comes from the Patitalian Country, a place where people communicate with their limbs. This explains the incredible lightness and complete freedom of movement given by the cloak.');
INSERT INTO "item_descriptions" VALUES(774,'en','Coming from the Mount Taigue, this cape ended up poisoning its former female owner... Strangely enough, if you wear it, it will increase your resistance.');
INSERT INTO "item_descriptions" VALUES(775,'en','This cape has been made with infinite care and attention, it allows the wearer to find the enemy''s weak point.');
INSERT INTO "item_descriptions" VALUES(776,'en','A certain Mulba used this item to carry half her kitchen with her on a long, difficult quest to find the Seven Crystal Hens which fell from the stars. This cloak will make you strong and brave.');
INSERT INTO "item_descriptions" VALUES(777,'en','The battery cock whose feathers made this cape fought its killers for several days and nights before finally dying of exhaustion. Let me tell you, killing that crazy chicken nearly finished them off too.');
INSERT INTO "item_descriptions" VALUES(778,'en','This authentic bad guy cloak proves you belong to the gang of the diabolic Mori Arty. It is said that his bad luck equalled his astounding intelligence. Only true bad guys can wear it.');
INSERT INTO "item_descriptions" VALUES(779,'en','This cloak looks ordinary... but isn''t. It can make its wearer invisible to the eyes of those who are not looking at him. Really impressive!');
INSERT INTO "item_descriptions" VALUES(781,'en','This superb cloak once belonged to the Great Stratequerre. This renowned and expert strategist lord of war, hungry for the universe conquest, soon gave up his plans after having arrayed himself in the cloak. Really strange!');
INSERT INTO "item_descriptions" VALUES(782,'en','This very special axe was originally designed to teach budding lumberjacks the art of chopping. When it is well used, it can split a young carefree Treechnid in two, provided that such a Treechnid exists.');
INSERT INTO "item_descriptions" VALUES(783,'en','This amulet, made exclusively of precious wood, is highly prized and loved by lumberjacks who usually exaggerate its abilities to offset the cost of the material.');
INSERT INTO "item_descriptions" VALUES(784,'en','Mulish Cat was a renowned Ecaflip, and the most stupid in his class. In combat, the only match for his nonexistent intelligence was his bewildering luck.');
INSERT INTO "item_descriptions" VALUES(785,'en','The tradition of passing this ring down from grandfather to grandson gives it incredible power. This one is but a pale imitation of the original, but even so, it is much sought-after by collectors, whether they are Enutrofs or not.');
INSERT INTO "item_descriptions" VALUES(786,'en','The jeweller''s hand slipped while shaping this amulet, which imparts more intelligence to the wearer but in exchange, imparts a tear-inducing migraine, making it almost impossible to see anything.');
INSERT INTO "item_descriptions" VALUES(787,'en','This strange little ring can increase the Agility of the wearer in exchange for Chance points.');
INSERT INTO "item_descriptions" VALUES(789,'en','This belt is all the rage among young Amaknians. A follower of Sadida, couturier by trade, is behind this fashion. When he sold it for the first time, he said: "Life is short, play hard!"');
INSERT INTO "item_descriptions" VALUES(790,'en','The magic effects of this cape are often overestimated, which inevitably causes heavy losses in adventurers, such as the notorious minstrel Jon Lemon.');
INSERT INTO "item_descriptions" VALUES(791,'en','This is a staff made of living Treechnid Roots. But watch out... it has a tendency to turn on its master. When it does decide to attack the same target as you, it can be very deadly.');
INSERT INTO "item_descriptions" VALUES(821,'en','Holy Swords are awarded to young warriors during their training.');
INSERT INTO "item_descriptions" VALUES(824,'en','The Knight Sword is an efficient and sturdy sword. Properly used, it can inflict serious damage upon your enemies.');
INSERT INTO "item_descriptions" VALUES(827,'en','This basic sword can usually be handled by the most cretinous of Bworks, that is to say the ones who are incapable of using a bow or a staff... Some of these geniuses even mistake the blade for the handle. The tradition in this case is for the Bwork to poke its own eyes out with its fingers... Lovely!');
INSERT INTO "item_descriptions" VALUES(828,'en','This bow fires its arrows so rapidly that the whistling sound travels for miles. A sound piece of advice: if you want to be discreet, equip it with a silencer.');
INSERT INTO "item_descriptions" VALUES(829,'en','Due to its restricted range, this bow is not very popular... Use it to weaken your enemies before finishing them off with a close-range weapon or a crafty spell.');
INSERT INTO "item_descriptions" VALUES(832,'en','This wand increases the bearer''s Intelligence.');
INSERT INTO "item_descriptions" VALUES(835,'en','This wand increases the bearer''s Wisdom.');
INSERT INTO "item_descriptions" VALUES(836,'en','This ring, made of Treechnid Bark, has great powers but carries great responsibility with it. However, in spite of its value, it is said to be cursed.');
INSERT INTO "item_descriptions" VALUES(837,'en','These boots increase your Strength but they affect your Intelligence. They could even turn you into a Iop in case of prolonged and regular use.');
INSERT INTO "item_descriptions" VALUES(841,'en','This ring increases AP in exchange for some Strength, Intelligence, Agility and Chance.');
INSERT INTO "item_descriptions" VALUES(849,'en','This small ring increases Strength.');
INSERT INTO "item_descriptions" VALUES(850,'en','Amaknian collectors are desperate to get their fingers into this ring, though it''s not worth a penny.');
INSERT INTO "item_descriptions" VALUES(851,'en','This small ring increases Life.');
INSERT INTO "item_descriptions" VALUES(852,'en','This small ring increases Intelligence.');
INSERT INTO "item_descriptions" VALUES(853,'en','This ring increases the wearer''s chance.');
INSERT INTO "item_descriptions" VALUES(856,'en','This small amulet increases Agility.');
INSERT INTO "item_descriptions" VALUES(860,'en','This basic belt increases luck.');
INSERT INTO "item_descriptions" VALUES(861,'en','These boots make whoever wears them stronger, but don''t make the wearer any less stupid. When you''re short on brains, you''d better have fists.');
INSERT INTO "item_descriptions" VALUES(862,'en','These sandals increase the intelligence of the wearer. They are also eternally fashionable. They are finished off with a breathable walnut sole for exquisite grip.');
INSERT INTO "item_descriptions" VALUES(863,'en','These boots increase the Agility of the wearer so that he can get into character as a Tofu every time he feels like making a fool of himself.');
INSERT INTO "item_descriptions" VALUES(864,'en','These boots increase your luck in finding powerful items such as Gobball Slobber.');
INSERT INTO "item_descriptions" VALUES(867,'en','Made of Dreggon remains, this splendid amulet is impressive enough to make your bravest enemies run home sobbing.');
INSERT INTO "item_descriptions" VALUES(889,'en','These boots are so comfortable that they instantly increase your concentration.');
INSERT INTO "item_descriptions" VALUES(892,'en','These boots are made of Gobball leather. Thanks to the smell they give off, breeders can approach and kill other Gobballs with the slightest of ease.');
INSERT INTO "item_descriptions" VALUES(896,'en','These daggers were created for cutting roots and young saplings in spring time but they were soon decommissioned in favour of quite a different purpose.');
INSERT INTO "item_descriptions" VALUES(900,'en','These modest-looking daggers are extremely dangerous. They are easily hidden down the pants which makes them a weapon of choice for murderous eunuchs throughout the land. The words chicken and egg come to mind.');
INSERT INTO "item_descriptions" VALUES(905,'en','According to the legend, these boots were secretly replaced by another pair, which though defective, were ultra-powerful; they were made by a clumsy, overworked shoemaker.');
INSERT INTO "item_descriptions" VALUES(909,'en','With these boots, Hogmeiser used to chase off the only human beings he couldn''t stand the sight of: children. Fortunately for them, the weight of the footwear prevented him from ever catching a single one.');
INSERT INTO "item_descriptions" VALUES(910,'en','These boots belonged to Hogmeiser for many years, before he actually lost them on a stupid bet with Grizmine. The moral of this story is... never gamble with an Ecaflip.');
INSERT INTO "item_descriptions" VALUES(911,'en','These boots belonged to Hogmeiser for many years. They are so worn they are crippling. A skilled shoemaker should be able to repair them.');
INSERT INTO "item_descriptions" VALUES(912,'en','These magnificent Hogmeiser boots are finely peppered with precious stones, protecting you against magic attacks. Brouce Boulgoure himself used them to crush the Treechnid King''s head many years ago, just to liven up the opening of the Trool Fair.');
INSERT INTO "item_descriptions" VALUES(916,'en','Silicate made this amulet on a wintry morning for a famous adventurer named Rimb Vardi. He was hunting down an old Bwork Magus whose bungling magic was the root of many a natural disaster.');
INSERT INTO "item_descriptions" VALUES(917,'en','This brooch was made one autumn morning in the depths of a Beech and Elm forest, near the Olag-Lacustre Island. It is considered to be a true relic by a great many lumberjacks.');
INSERT INTO "item_descriptions" VALUES(919,'en','These powerful daggers, forged from Ancestral Amber according to ancient techniques, were used during the colonization of Moon Island. It soon became wild again.');
INSERT INTO "item_descriptions" VALUES(923,'en','This battle axe was forged by Kademlia Boulgoure to fight against the most terrifying Treechnids. Legend has it that this legendary weapon killed more Treechnids in a night than there are trees in Amakna.');
INSERT INTO "item_descriptions" VALUES(924,'en','These boots gave Klime the shoemaker such agility that he was able to ride Gobballs. He died when he mistook a Jelly for a Gobball, having spent an evening drinking in the tavern.');
INSERT INTO "item_descriptions" VALUES(927,'en','This battle-axe was forged by Kademlia Boulgoure to fight against the Ancestral Treechnid. Only the best warriors can handle it.');
INSERT INTO "item_descriptions" VALUES(928,'en','Ogralimde was a great warrior who derived his strength from his master Adyol, an exceptionally intelligent and powerful Bwork Magus. This apprentice never surpassed his master.');
INSERT INTO "item_descriptions" VALUES(934,'en','This cloak increases life.');
INSERT INTO "item_descriptions" VALUES(937,'en','This cloak increases chance.');
INSERT INTO "item_descriptions" VALUES(940,'en','The Farter protects you from physical damage.');
INSERT INTO "item_descriptions" VALUES(941,'en','The Komintot increases the Wisdom of the wearer.');
INSERT INTO "item_descriptions" VALUES(942,'en','The Smoother resists magic damage.');
INSERT INTO "item_descriptions" VALUES(947,'en','This cloak increases Wisdom.');
INSERT INTO "item_descriptions" VALUES(948,'en','This magnificent cloak is a clever mix of Treechnid essence and nice familial Gobball.');
INSERT INTO "item_descriptions" VALUES(949,'en','This headband increases Vitality.');
INSERT INTO "item_descriptions" VALUES(952,'en','This cloak was made of hairs and other organic elements taken from various Boowolves... You can smell its power from here.');
INSERT INTO "item_descriptions" VALUES(953,'en','With this handmade cloak of Tofu Feathers, you will be able to run faster and escape from tackle zones with the grace of a shotgun-blasted pigeon.');
INSERT INTO "item_descriptions" VALUES(954,'en','The legendary Poak Cloak was specially embroidered for warriors who live for close combat situations.');
INSERT INTO "item_descriptions" VALUES(955,'en','Hairdressers use the Cape Hillary to tie up their hair. Will you?');
INSERT INTO "item_descriptions" VALUES(956,'en','This cloak increases your range, allowing distant targets to be attacked... or naive adventurers to be dumbfounded into unsuspecting admiration. Haha!');
INSERT INTO "item_descriptions" VALUES(957,'en','The Gobb increases damage and Vitality, but it gives off a nasty odour, too. Don''t be surprised if the Gobballs think you''re one of the gang.');
INSERT INTO "item_descriptions" VALUES(958,'en','This cloak is certainly one of the most powerful of its kind in the World. It increases all the elemental characteristics of its wearer.');
INSERT INTO "item_descriptions" VALUES(967,'en','This magnificent cloak increases AP, as well as Vitality and Wisdom.');
INSERT INTO "item_descriptions" VALUES(968,'en','This magnificent belt increases AP, as well as Vitality and Wisdom.');
INSERT INTO "item_descriptions" VALUES(969,'en','This magnificent Crown once belonged to the notorious Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'en','This staff once belonged to the notorious Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(971,'en','This cloak once belonged to the notorious Wa Wabbit. It is still imbued with his perspiration which will bring back a few memories of the amazing fight every time you put it on.');
INSERT INTO "item_descriptions" VALUES(972,'en','If a dragon really did lay this egg, then she must have been a right sweetheart. Especially since its main purpose seems to be to attract adventurers to the Wa Wabbit''s island so he can nick all their garb and gear before humiliating them. All in all, it''s quite a good way to obtain the latest sets without having to leave the house.');
INSERT INTO "item_descriptions" VALUES(976,'en','A distinctive feature of the Pumpkwin is that it prevents the dispersion of magic particles, making it a good magic insulator. That''s why some warriors use this vegetable as headgear.');
INSERT INTO "item_descriptions" VALUES(1019,'en','Wearing this hat creates a very special look, halfway between ridiculous and comical.');
INSERT INTO "item_descriptions" VALUES(1021,'en','For those who have always dreamt of flying like a Kwak, go back to bed because these wings will turn you into a public menace and an idiot.');
INSERT INTO "item_descriptions" VALUES(1029,'en','One day, the infamously crazy T. Bun Stek found two strange yet impressive knives... No one could figure out what they were for. He used the very same knives to sacrifice half his livestock to the Gods and soon after they bellowed the answer from the heave''s. He was slaughtering a particularly noisy cow at that very moment... The poor guy didn''t hear a word.');
INSERT INTO "item_descriptions" VALUES(1030,'en','This pair of daggers is in fact a magic game. Designed to entertain young Ecaflips, it was taken off the market when a visiting Sram decided to join. She was only a child... Shame on you... shame on us all.');
INSERT INTO "item_descriptions" VALUES(1031,'en','These magnificent daggers once belonged to the cruellest Sramette Amakna ever saw. Well, one of the most cruel. Actually, she was just a tiny bit more cruel than the others. No, I''m exaggerating there. She wasn''t quite as cruel as the others. That''s still quite an achievement though.');
INSERT INTO "item_descriptions" VALUES(1035,'en','This dagger was originally used by the secret brotherhood of Rowler. This guild wanted to plunge Amakna into chaos. They finally disappeared when the island where they hid and schemed was submerged by the waves.');
INSERT INTO "item_descriptions" VALUES(1039,'en','This Sram daggers are especially deceitfully shaped. So deceitful that you may wonder if they really are daggers. Once you have the answer, it''s often too late...');
INSERT INTO "item_descriptions" VALUES(1040,'en','Ortimus Contrari is a legendary assassin. If I told you how he carried out his contracts... you''d want to kill yourself even before he got to you.');
INSERT INTO "item_descriptions" VALUES(1041,'en','The legends tell of a famous Iop who left his island home and travelled across the sea to find work as an interpreter for the Kings of Amakna. He took to the job full of hope, enthusiasm and diligence, dazzling Ecaflips and Fecas alike with his vibrant wordplay and passion for good grammar. Unfortunately, on his way to the castle, he stumbled over a rock that turned out to be a Mega Crackler, and this broken sword was the only trace they found of him, or his equipment.');
INSERT INTO "item_descriptions" VALUES(1045,'en','This shovel is made of a very rare wood. According to the legend, young girls fall into an eternal sleep when they touch this weapon. Note that in case of repeated contact, valiant heroes can also be affected.');
INSERT INTO "item_descriptions" VALUES(1049,'en','What can be better than an eco-friendly shovel to clear your garden of weeds? This shovel is THE best way of getting rid of daisies. It''s also great to feed them to your enemies.');
INSERT INTO "item_descriptions" VALUES(1053,'en','The Woukuis family forged this shovel during the war between the Elle-Poma and the Touge-Woukuis. The one problem is that it covers your hands with grease. It''s also very popular with unmarried warriors who spend a lot of time alone. Dunno why.');
INSERT INTO "item_descriptions" VALUES(1054,'en','Half trowel and half shovel, the Trovel went out of fashion with builders and was remarketed as a weapon. Easy to handle and to put away thanks to its size, it''s the ideal accessory for any Enutrof that''s fond of a drink.');
INSERT INTO "item_descriptions" VALUES(1058,'en','These ghastly shovels are hand-crafted by the islanders of Koutoulou who use whatever materials come to hand to make them. Useless for digging holes, their main purpose is to ward off imaginary spirits and naughty children.');
INSERT INTO "item_descriptions" VALUES(1059,'en','This shovel is much favoured by the potato farmers of the region. It can be used for all kinds of crops however.');
INSERT INTO "item_descriptions" VALUES(1063,'en','A weapon created by Dha, this aerodynamic mace hurts the very air as it cleaves through and splits your enemies skulls open... Are you convinced yet?');
INSERT INTO "item_descriptions" VALUES(1067,'en','Rumour has it that this hammer is one of a kind, handmade by the ancient Xelor Smiths. Some people are convinced it is a copy, only carrying a convincing forgery of the Xelor rune... Go find out for yourself, hit someone over the head with it!');
INSERT INTO "item_descriptions" VALUES(1071,'en','Before being struck by lightning for the last time, the creator of this mace truly thought it would allow him forecast the weather. Much later, it was discovered that the tool was better at giving than taking blows.');
INSERT INTO "item_descriptions" VALUES(1075,'en','According to the legend, Outar Great Bwork ordered these fearsome hammers from a village of Xelors with the promise of sparing the townspeople if the hammers were well made. When he received the hammers, he destroyed the village. He needed to try his new weapons after all.');
INSERT INTO "item_descriptions" VALUES(1079,'en','This mace is the sole heritage left by the pacific Aj Taye tribe. Roll it on aching muscles and the pain will disappear. Big bullies will tell you it''s quite good at making pain appear as well.');
INSERT INTO "item_descriptions" VALUES(1083,'en','This hammer is so ridiculous that your enemy will laugh his head off. This should give you just enough time to beat it off with the very same hammer... Is that ironic?');
INSERT INTO "item_descriptions" VALUES(1084,'en','With this fearsome Hammer you will be able to prove the popular belief that muscles are more important than intelligence. This logic only works for people who are weaker than you, however. As we say ourselves... Strong is... never wrong.');
INSERT INTO "item_descriptions" VALUES(1085,'en','Falistos are Xelor demons. They betrayed their old principles and increased their strength by forging more and more powerful hammers. After spreading chaos across the land, they were defeated and banished underground. But some of the weapons they forged remained intact.');
INSERT INTO "item_descriptions" VALUES(1087,'en','This ring slightly increases intelligence.');
INSERT INTO "item_descriptions" VALUES(1088,'en','This mask is the faithful replica, only a bit bigger, of the ones proudly worn by important Kanniballs.');
INSERT INTO "item_descriptions" VALUES(1095,'en','This bow is specifically designed to hunt birds. Light and easy to handle, you''ll be able to sneak up on an eagle.');
INSERT INTO "item_descriptions" VALUES(1104,'en','The Eniripsa Mie Dopan made this series of sharpened wands to fight against the rising level of burglaries in the area. In theory, these wands can go back in time and nip any aggression in the bud. They often appear in hospitals, disguised as nurses asking stuff like, ''Have you seen so and so? Well, he hasn''t been born yet. Yeah a real nasty character.''');
INSERT INTO "item_descriptions" VALUES(1112,'en','"With a Gobball, no waste at all!" Such was the motto of a visionary shopkeeper who specialised in recycling Gobball carcasses. This bow is one of his best products, not for aesthetic reasons, but simply because it''s a fearsome weapon.');
INSERT INTO "item_descriptions" VALUES(1116,'en','A type of bow only made in the far North of Amakna, the I Kea Bow is a cheap, conveniently flat-packed weapon. Its effectiveness will strongly depend on the owner''s ability to follow poorly translated instruction manuals.');
INSERT INTO "item_descriptions" VALUES(1120,'en','The instructions for the making of this 100% biodegradable bow have been found in the ruins of Din by an adventurer apparently renowned for his mastery of the whip. I never trusted those Greenies... Many die each year in passionate and misguided embraces with sleeping Treechnids.');
INSERT INTO "item_descriptions" VALUES(1124,'en','Take an old worn bow, dust it with magical cure, ask a dragon to blow on it and you''ll have an enchanted bow. Be careful however, theorising with fairy recipes is all very well, but in practise, dragons take a malicious pleasure in blowing on everything but the bow.');
INSERT INTO "item_descriptions" VALUES(1128,'en','This unconventional bow was designed specially for the self-proclaimed king of a village of lowly peasants, who liked to show off by shooting two arrows at once.');
INSERT INTO "item_descriptions" VALUES(1131,'en','This heavy Wand shattered more than one soul''s skull. Iop priests use it to send repentant sinners to heaven with a bang.');
INSERT INTO "item_descriptions" VALUES(1132,'en','It''s the symbol of purity and stupidity. Just like its creator who nevertheless gave it tremendous magic powers.');
INSERT INTO "item_descriptions" VALUES(1136,'en','This wand was the key to the emancipation of Eniripsa housewives – a fearsome weapon against both monsters and hard-to-reach dust. Pretty handy, right?');
INSERT INTO "item_descriptions" VALUES(1140,'en','Houvette invented these wands to claim back her Enutrof husband from the liquid grip of the bar where he spent his evenings. She also used them to spice up their relationship, but nobody knows exactly how.');
INSERT INTO "item_descriptions" VALUES(1146,'en','According to the tag, this wand has the power to make people obey whoever is holding it. The instructions say you have to shake it rapidly near your adversary. If it doesn''t work, try and poke him in the eye with it.');
INSERT INTO "item_descriptions" VALUES(1147,'en','This staff is a replica of a legendary artefact, but with slightly lesser powers. It sends out light if it falls on the ground and it can distort your voice to any pitch you desire. The latter feature is useful for luring enemies into mortal traps... just don''t try to kill them with it when they fall for your trick.');
INSERT INTO "item_descriptions" VALUES(1151,'en','Most young Fecas have a staff quite similar to this one. It''s gone beyond a trend now, and has become a ritual of sorts. Has no one ever told them how ridiculous they look?');
INSERT INTO "item_descriptions" VALUES(1157,'en','A short-sighted, grumbling, fortune telling, smelly old Feca accidentally created this powerful weapon when her staff rammed into her crystal ball as she slipped from the kitchen table. She''d read her own fortune long before and, well, she more or less lived on that table... Wonder what it was she thought was going to kill her... Well, I guess she wasn''t the best fortune teller.');
INSERT INTO "item_descriptions" VALUES(1162,'en','The success of the Wa Wabbit Staff lead to the creation of a host of cheap copies. Today, there are far more fakes than originals.');
INSERT INTO "item_descriptions" VALUES(1331,'en','Oly was a disciple of Iop with only one ability – cooking. It is said that Iop himself gave her this medal in order to compensate for her weaknesses in battle. Only the pure of heart can wear it.');
INSERT INTO "item_descriptions" VALUES(1350,'en','This bow was created by a magician who believed you could find happiness in even the plainest of things. He invented this water-based bow to prove his point.');
INSERT INTO "item_descriptions" VALUES(1351,'en','"With a bow, it''s make or break" as the saying goes. Wise men avoid this bow. It''s rumoured to have the evil eye.');
INSERT INTO "item_descriptions" VALUES(1352,'en','This bow carries the forces of earth and water. Woe betide him who cannot control at least one of the two.');
INSERT INTO "item_descriptions" VALUES(1353,'en','All the pulleys of this bow were sawn off. It used to be a symbol of the conflict between Good and Evil.
Touch it and you''ll feel the supreme justice of the ancient lawmakers running through your fingertips.');
INSERT INTO "item_descriptions" VALUES(1354,'en','Hick was an cursed Cra: he couldn''t stop hiccupping. One day he threw his bow into the fire and decided to use a sword instead. The curse strangely disappeared at that exact moment.');
INSERT INTO "item_descriptions" VALUES(1355,'en','The man who created this bow, a certain Marc Hidsad, never really knew how to use it. He usually hurt himself just as much as his enemies.');
INSERT INTO "item_descriptions" VALUES(1356,'en','Rika Zarouil The Female Baker was renowned for having been the smallest Eniripsa in the whole World of Amakna. She made her loaves in small cardboard furnaces and used this old bread to impale many a hero.');
INSERT INTO "item_descriptions" VALUES(1357,'en','A sculptor who loved practical jokes tried to pass their wands off as daggers. The strategy was a flop, but the wands were a hit.');
INSERT INTO "item_descriptions" VALUES(1359,'en','The origins of this wand are shrouded in mystery. Nevertheless, it has always helped its happy owners find the least crowded routes in Amakna – which is particularly helpful when the crowds are out strolling through the Royal Gobball Estates.');
INSERT INTO "item_descriptions" VALUES(1360,'en','This wand was created many years ago in the forging flames of Dyin Ard. You''d be well-advised to have a bucket of water at hand just to keep control of the mini-inferno.');
INSERT INTO "item_descriptions" VALUES(1361,'en','The Sylvian Wand gives you sharp sight. You''ll probably use it for picking out a good escape route.');
INSERT INTO "item_descriptions" VALUES(1362,'en','The vampiric stake is, in fact, the wand of a vampire who retired long ago from social life and slaughtering. This strange piece of wood has nevertheless inherited a few qualities from its former owner.');
INSERT INTO "item_descriptions" VALUES(1363,'en','On top of its unbearable name, this staff has many ways to get on its owner''s nerves.');
INSERT INTO "item_descriptions" VALUES(1364,'en','This staff will help its owner forget about their worries and their strife. Unfortunately, it sometimes causes them to lose some of their memory and become subject to frequent lapses in concentration. Reserved for sages only.');
INSERT INTO "item_descriptions" VALUES(1365,'en','They say it was this staff that made a fearsome warrior of Heds; they say it was magic and could shoot fire. Ever heard of All Bran? Eight bowls of this stuff a day and you''d be shooting fire too, buddy.');
INSERT INTO "item_descriptions" VALUES(1366,'en','This staff is commonly used by gobbherds during the trading season to fend off the Bworks, who like to snack on the Gobball herds around this time. The prized dish is the gobbherd himself.');
INSERT INTO "item_descriptions" VALUES(1367,'en','This staff once belonged to the beautiful Dina Mite, renowned for her explosive voice. In her day, she was a cracker too.');
INSERT INTO "item_descriptions" VALUES(1368,'en','Apparently, this lance belonged to one of the 110 Amaknian firefighters it took to put out the fire started deliberately by the reckless red wyrmling. There were definite signs of arson about. One must have courage and dedication to use it.');
INSERT INTO "item_descriptions" VALUES(1369,'en','These knives have been specially conceived to be used in luxury restaurants. However, because of their rather strange appearance, the owner decided to resell them to a travelling knife thrower.');
INSERT INTO "item_descriptions" VALUES(1370,'en','The hilt of this weapon is greasy and slippery but it really does look fab.');
INSERT INTO "item_descriptions" VALUES(1371,'en','Eulasse was a gobbherd in Amakna who one day found these dirty daggers in the Gobball dung heap. Be careful with them, the hilts are still a bit slippery...');
INSERT INTO "item_descriptions" VALUES(1372,'en','Otof''Mai''We was a hermit, a legendary disciple of Sram, who spent his life avoiding all sorts of contact with others. When he died, his favourite daggers were found next to his body. Only the nimblest of men can control them.');
INSERT INTO "item_descriptions" VALUES(1373,'en','Any Enutrof worthy of the name has a beard and old Krys Nosheive was no exception. One day his wife, Mrs Nosheive, bought him a razor, and he decided he would rather use it as a weapon.');
INSERT INTO "item_descriptions" VALUES(1374,'en','Penn was a renowned Amaknian scribe who would use daggers to engrave his stone notebooks. He was so fast that he was commissioned to write an encyclopedia of Astrubian swear words. He was never able to complete his opus.');
INSERT INTO "item_descriptions" VALUES(1375,'en','Terophyle the Iop was capable of lifting enormous stones... It''s not really proof of intelligence to you or me, but a Iop who can capture the idea of picking up something round is already a king among his people.');
INSERT INTO "item_descriptions" VALUES(1376,'en','This axe might be heavy, but it will take down Trools in a flash. The magic runes it contains can also burn enemies.');
INSERT INTO "item_descriptions" VALUES(1377,'en','Hure was a young priest who used weapons freely to spread the word of God. His favourite weapon was an axe on which he inscribed numerous meaningful quotations. His final blows were always accompanied by a blood-curdling supplications, which ended, each word like a hot pin in the victim''s ear, with the phrase "And, you will know my name is The Lord when I lay my vengeance upon thee!"');
INSERT INTO "item_descriptions" VALUES(1378,'en','Created for young, bloodthirsty warriors, this battle axe makes a deafening noise when it strikes another weapon.');
INSERT INTO "item_descriptions" VALUES(1379,'en','Legend has it that this hammer is named after the sound it makes when it crushes enemy skulls. Unfortunately, there aren''t any enemies left to confirm that this is the case.');
INSERT INTO "item_descriptions" VALUES(1383,'en','It took many, many years and many, many smiths to forge this hammer. The result is a magnificent weapon which has unfortunately inherited a particular concept of efficiency from its creators.');
INSERT INTO "item_descriptions" VALUES(1393,'en','This Hammer was made from a clock, the famous clock swallowed by the Crocodyl when it devoured the hand of Captain Hawkfish. Though the clock has been located, the hand is still missing. Hawkfish''s hand that is... the clock was in surprisingly good... oh, forget it.');
INSERT INTO "item_descriptions" VALUES(1399,'en','Just like the amulet of the same name, the Aclou Mallet can transform your vital energy into strength. To be used in moderation.');
INSERT INTO "item_descriptions" VALUES(1403,'en','This hammer once belonged to Aha, a young Osamodas who wasted all his days telling painful one-liners. The hammer couldn''t break open a hazelnut, but it''s useful for breaking the ice from time to time.');
INSERT INTO "item_descriptions" VALUES(1404,'en','So you like animals? So did Toh''Lo. He devoted his whole life to helping them out. This hammer kind of represents his relationship with animals, a communion as shaky as a lame Gobball on a freshly gravelled driveway.');
INSERT INTO "item_descriptions" VALUES(1426,'en','Layte, the creator of this shovel, was a devoted disciple of Iop. You can guess what this guy''s major flaw was.');
INSERT INTO "item_descriptions" VALUES(1427,'en','This shovel is used by the Kanniball High Priests of Moon Island to invoke Zebuth, one of their gods who is often depicted as a cow. Only vile characters use it.');
INSERT INTO "item_descriptions" VALUES(1431,'en','This shovel, created by Mechba, is used by Enutrof followers to knock nuts from trees. On the battlefield, it has a similar function. Yowza!');
INSERT INTO "item_descriptions" VALUES(1432,'en','Gaston Houze, gardener and disciple of Enutrof, planted too many plants. It had to be said... There, I''ve said it. What''s more this worn spade is the evidence of his dirty business. Never talk to this thing, it''ll tell you stories, don''t believe a word, it''ll have you digging yourself into your own grave before you know it... and then where will you be? I hate this damn thing.');
INSERT INTO "item_descriptions" VALUES(1433,'en','This shovel was once a self-defence weapon used by a small group of female Enutrof''s followers. Once they had even this puny pile of power in their clutches, they turned into horrible crea.......');
INSERT INTO "item_descriptions" VALUES(1435,'en','Very heavy shovel. For fa... um, big boned adventurers.');
INSERT INTO "item_descriptions" VALUES(1436,'en','Ikan was Churros the Warrior''s little fish. The shovel doesn''t look a thing like the creature, but the smell is almost identical.');
INSERT INTO "item_descriptions" VALUES(1439,'en','This pick seems to attract the evil eye to you. But with a few minor alterations here and there, you could have a great pick on your hands.');
INSERT INTO "item_descriptions" VALUES(1474,'en','This ultra-powerful amulet is the fruit of the expert time-mastery of an old Xelor.');
INSERT INTO "item_descriptions" VALUES(1475,'en','The Pretty Blade has been crafted by the renowned blacksmith Dave-LoL, just before he died for the sake of the prettiest girl in the kingdom, a Iop. It is said that the efficiency of the blade is only matched by the grace of the wearer.');
INSERT INTO "item_descriptions" VALUES(1476,'en','This powerful pendant contains the life-blood of the Crackler, that is to say all the items he gathered before he was killed by some jealous adventurer.');
INSERT INTO "item_descriptions" VALUES(1477,'en','Mulette was a little female Ecaflip dogged by bad luck... until her grandmother presented her with this amulet.');
INSERT INTO "item_descriptions" VALUES(1478,'en','This pendant will make you feel more harmonious.');
INSERT INTO "item_descriptions" VALUES(1479,'en','This legendary Hammer has already proved itself in Amakna. It belonged to the powerful Cardboard Twot who used it to transform his opponents into confetti and papier-mâché.');
INSERT INTO "item_descriptions" VALUES(1480,'en','This pendant will make you feel at peace with the World.');
INSERT INTO "item_descriptions" VALUES(1481,'en','This pendant will make you grant you greater understanding of the World around you.');
INSERT INTO "item_descriptions" VALUES(1482,'en','This is an extremely useful amulet, but it turns its wearer as white as a Gobball.');
INSERT INTO "item_descriptions" VALUES(1483,'en','A mysterious symbol of a mysterious organisation... by the way, it doesn''t exist and you''ve never heard of it, understand?');
INSERT INTO "item_descriptions" VALUES(1484,'en','An excellent copy of the work done by Polma Kartnay, the silversmith''s apprentice. This reproduction surpasses the original.');
INSERT INTO "item_descriptions" VALUES(1485,'en','This amulet is said to be a modified version of the Golden Destiny... which is really strange when you think that these two amulets have nothing in common except their ridiculous appearance.');
INSERT INTO "item_descriptions" VALUES(1486,'en','Holy was a female Iop, intent on spreading Evil throughout the land. Renowned for her incredible composure, she would never get angry except when people compared her to someone named Oly.');
INSERT INTO "item_descriptions" VALUES(1487,'en','Not only is this belt elegant, it also massages you as you walk... You''d be surprised what a back rub can do for your murderous instinct.');
INSERT INTO "item_descriptions" VALUES(1488,'en','This strange name refers to an equally strange object made from previous amulets... goodness knows how. We know just as little about the circumstances in which it was found.');
INSERT INTO "item_descriptions" VALUES(1489,'en','With this near-perfect pin, you''ll have the Wisdom of an Irish salmon. It''s great for group therapy sessions among friends. Don''t forget to bring some tissues, though, it can get emotional!');
INSERT INTO "item_descriptions" VALUES(1490,'en','The creator of this chain, someone called Ken Aton, was renowned for his strange habits. He spent all his time hunting the Minotoror for his coat which he wanted to make into a merkin.');
INSERT INTO "item_descriptions" VALUES(1491,'en','The Liche was a dirty creature known for infiltrating the ranks of valiant warriors in order to steal food. Marmalade and toast was his favourite. But one day, the warriors saw through its little game and the Liche had to run away.');
INSERT INTO "item_descriptions" VALUES(1493,'en','The stone set in this ring is so incredibly sharp that it could open a vein at the slightest touch. Fortunately, Sacriers know how to handle this jewel with skill and care. This includes using it on themselves to inflict a little damage when they need to shed a tear or two. Tears of pain or tears of joy... either way, that''s how they honour their goddess.');
INSERT INTO "item_descriptions" VALUES(1494,'en','The main function of this pretty ring was to help Osamodas recognise their Tofus during fights.');
INSERT INTO "item_descriptions" VALUES(1495,'en','This small modest-looking ring was created by Degun. He was more famous for shouting his head off without the slightest reason and his violent aversion to the Liche than for his talent as a jeweller.');
INSERT INTO "item_descriptions" VALUES(1496,'en','This ring was made to increase its wearers luck during card games.');
INSERT INTO "item_descriptions" VALUES(1497,'en','Rings forged during Xelor''s temporal journeys.');
INSERT INTO "item_descriptions" VALUES(1498,'en','These rings were cooled from the forge with the tears of Enutrof, shed over his lost shovel. Must have been some shovel!');
INSERT INTO "item_descriptions" VALUES(1499,'en','This ring is meant for Enutrofs only. It was enchanted by their God so that the followers would be the only ones to wear it. It allows all god-fearing Enutrofs to be even luckier than usual in treasure hunts.');
INSERT INTO "item_descriptions" VALUES(1500,'en','Made of many different fibres, this magnificent cloak is unique - just look at that patchwork of colour and the way the light plays on its surface.');
INSERT INTO "item_descriptions" VALUES(1501,'en','This wedding ring will satisfy the most mercenary of fathers-in-law.');
INSERT INTO "item_descriptions" VALUES(1503,'en','It is said that to create this wand, it is put into a warm corpse, which is then buried shortly afterwards. No one dares to imagine by what route exactly the wand is put into the dead body.');
INSERT INTO "item_descriptions" VALUES(1504,'en','Billy-Ray Red Neck was renowned throughout the countryside. One day, as he was yodelling at the top of his voice, someone cut off his head, which is why he got the nickname. The dagger was found but nobody looked for the murderer... Billy-Ray was famous for singing out of tune.');
INSERT INTO "item_descriptions" VALUES(1505,'en','This exceptional Treechnid wood flute is ideal for entertaining and inspiring your friends.');
INSERT INTO "item_descriptions" VALUES(1511,'en','According to the legend describing the Dantesque fight after which he was raised to the rank of God himself, Ecaflip used a weapon made by the ancient principle: "a tail for a life". This series of swords was forged as a tribute to him.');
INSERT INTO "item_descriptions" VALUES(1559,'en','This ring is in fact an outgrowth of the Soft Oak, uprooted during a storm. It''s now yours, but keep it away from its master as he could decide to take back what''s his!');
INSERT INTO "item_descriptions" VALUES(1574,'en','This sword belonged to the late lamented Kih Besans, known as the Yench Carver. This was his main hobby... Pointless to mention that some people waste their lives.');
INSERT INTO "item_descriptions" VALUES(1602,'en','This ring allows the Dark Treechnid to be very stylish when it goes dancing. And as life is kind, there are many parties in the Dark Forest.');
INSERT INTO "item_descriptions" VALUES(1619,'en','The Treemu is a very elegant amulet. If you''re planning on putting it on, we advise you not to wear any other clothes so as to really show off this precious jewel. You''ll be irresistible.');
INSERT INTO "item_descriptions" VALUES(1620,'en','This bow looks as if it were still alive and can almost shoot arrows on its own like a big boy. It could have been the perfect bow for people who are clumsy with their hands but, unfortunately, the arrow always has to be loaded the right way.');
INSERT INTO "item_descriptions" VALUES(1621,'en','Skill boots increase the wearer''s agility and intelligence but lower their strength and chance. Contrary to what many people believe, they won''t defeat your opponent for you.');
INSERT INTO "item_descriptions" VALUES(1622,'en','Power Boots increase the wearer''s strength and chance but lower their intelligence and agility. Contrary to what many people believe, they won''t grant you insane amounts of power.');
INSERT INTO "item_descriptions" VALUES(1623,'en','Anticipation Boots increase Strength and Agility to the detriment of your Intelligence and Chance. Contrary to what many people believe, they won''t allow you to anticipate your enemy''s next moves.');
INSERT INTO "item_descriptions" VALUES(1624,'en','These boots once belonged to the great knight Nexus - the poor bugger was frozen for eternity.');
INSERT INTO "item_descriptions" VALUES(1628,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1629,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1630,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1631,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1632,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1633,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1639,'en','This sword was created by a glamorous young lady who wanted a weapon in her own image and endowed it with her own graceful beauty and passionate nature. The magnificent result speaks for itself.');
INSERT INTO "item_descriptions" VALUES(1651,'en','This sword is absolutely perfect for attacking the defenceless. Quick, handy and above all extremely sharp, it has been banned from shops for many years now. It is tolerated only if used on Bworks.');
INSERT INTO "item_descriptions" VALUES(1656,'en','This ring can protect you from weak magic attacks... In practise, from infantile monsters with something to prove.');
INSERT INTO "item_descriptions" VALUES(1657,'en','This ring can protect you from weak magic attacks... In practise, from infantile monsters with something to prove.');
INSERT INTO "item_descriptions" VALUES(1661,'en','Wearing a necklace with a Moskito encased in amber will show your opponents you''re a fearsome hunter of Moskitos! Unless you''re still a toddler, that''s got to be embarrassing.');
INSERT INTO "item_descriptions" VALUES(1662,'en','Wearing an amber Arachnee around your neck when attacking one of its sisters can be enough to disconcert it. Poor bug. It''s what we call the "irony of fate".');
INSERT INTO "item_descriptions" VALUES(1665,'en','These strange boots were first used by young disciples who were one or two socks short of a pair. Ah yes, popular with the Iops.');
INSERT INTO "item_descriptions" VALUES(1666,'en','These boots have been especially made for those who prefer to watch their summons do all the hard work during fights.');
INSERT INTO "item_descriptions" VALUES(1667,'en','This belt takes its name from its creator, a shoemaker who was less renowned and much older than Bowisse, but quite gifted all the same.');
INSERT INTO "item_descriptions" VALUES(1668,'en','The Dodu was a Sadida who loved frightening his enemies. He asked Bowisse to make him a belt that matched the colour of his hair... Like many charmers, the Dodu had a rotten heart.');
INSERT INTO "item_descriptions" VALUES(1669,'en','This belt was made for the most popular of all the Craettes who often organised parties and wacky events to keep her countless friends and acquaintances on her side. All this between ironing and washing Captain Chafer''s leather underpants.');
INSERT INTO "item_descriptions" VALUES(1693,'en','The famous tailor, Jules Yanos, was particularly renowned for having exchanged his wife for a magic thimble. What a businessman, hmm? Just great!');
INSERT INTO "item_descriptions" VALUES(1695,'en','Some say Captain Chafer tried to steal this cloak to replace his famous leather panties. But it didn''t suit him at all - it just wasn''t perverse enough.');
INSERT INTO "item_descriptions" VALUES(1697,'en','Don''t expect this bag to make a hero of you. It will keep all your personal items in one place. Better than nothing, I suppose.');
INSERT INTO "item_descriptions" VALUES(1698,'en','This bag has been designed to hold a few collectible resources.
Only true harvesters can carry it.');
INSERT INTO "item_descriptions" VALUES(1699,'en','This bag is ideal for those who never wander far from home but take useless things with them when they do. Like Ash Planks for example.');
INSERT INTO "item_descriptions" VALUES(1700,'en','Designed by Tengra Reufrus, this aerodynamic belt will make you as nimble as a Tofu and as windy as the breeze. Or is it the opposite?');
INSERT INTO "item_descriptions" VALUES(1701,'en','This belt has small pockets allowing you to stock more items in your inventory.');
INSERT INTO "item_descriptions" VALUES(1702,'en','This bag has been designed to hold collectible resources.
Only true harvesters can carry it.');
INSERT INTO "item_descriptions" VALUES(1703,'en','This bag has been designed to hold many collectible resources.
Only true harvesters can carry it.');
INSERT INTO "item_descriptions" VALUES(1704,'en','Legend whispers of a miner who worked continuously for several months in 4 different mines simultaneously, raising a family in the process and running a successful one-man printing press with his feet. Ah, the Hammer-Sickle newspaper has been hard at work again.');
INSERT INTO "item_descriptions" VALUES(1705,'en','It''s the ideal bag for holding all your bread and potions when you go away for several months... into the labyrinth for example.');
INSERT INTO "item_descriptions" VALUES(1707,'en','This is the ideal bag for keeping all your bread and potions in when you are on an exotic holiday on Moon Island.');
INSERT INTO "item_descriptions" VALUES(1711,'en','You''ll be saying "wow" and taking bows every time you take this tiny Bow Wow out to do its business. Due to its wild nature, this pet should not be fed – that is, unless you want to lose a hand.');
INSERT INTO "item_descriptions" VALUES(1718,'en','The powers given to this ring by the Dark Breath of Grougalorasalar are now considerably weakened. This relic was intended for Crocoburio, the only one capable of mastering it without being dominated himself.');
INSERT INTO "item_descriptions" VALUES(1719,'en','This pair of boots apparently belonged to Crocoburio. Only a few people can put them on and they are immediately plunged into a clever, Machiavellian frame of mind. Legend has it that this evil spell is due to the numerous skulls the boots have crushed.');
INSERT INTO "item_descriptions" VALUES(1720,'en','Grougalorasalar loved collecting the bone fragments of his most fearsome enemies. His affection for Crocoburio inspired the creation of this ultra-powerful belt.');
INSERT INTO "item_descriptions" VALUES(1728,'en','The fairer sex of any class will fall under the spell of this cuddly little ball of fluff. That alone makes it an animal to be feared.');
INSERT INTO "item_descriptions" VALUES(1729,'en','This ring once belonged to Mer, the laziest piece of stuff in Amakna. He worshipped doughnuts and ribs...');
INSERT INTO "item_descriptions" VALUES(1739,'en','This wand is searingly hot to the touch. But the most enigmatic thing about it is its ash smell which would make you think it had survived a forest fire.');
INSERT INTO "item_descriptions" VALUES(1748,'en','This little Wabbit is domesticated, so it won''t bite you. Others might not be so lucky, though...');
INSERT INTO "item_descriptions" VALUES(1904,'en','A Limestone Dreggon shell padded with leather and wool, this headgear will protect you from basic attacks and the lightning bolts of a drunken stumbling Bwork Magus. You''ll also look like you just fell out of a Dreggon''s backside.');
INSERT INTO "item_descriptions" VALUES(1908,'en','Even Spartapine the Great Reaper doesn''t have such a helmet, the precious stones and metals used to make it ensure your noggin will be kept safe and sound inside..');
INSERT INTO "item_descriptions" VALUES(1910,'en','This cloak is made from the body parts of an Ouginak, it still has the smell of the creature''s humid nose. Personally, its taste reminds me of a horny set of Gobball''s udders... Well, someone told me that... damn.');
INSERT INTO "item_descriptions" VALUES(1934,'en','This knife is the typical hallmark of the hunter. The brighter, sharper and bigger the blades are, the better-looking the hunters are... according to themselves at least... A hunter equipped with this sharpened weapon will be able to take the best cuts from the carcasses of their prey.');
INSERT INTO "item_descriptions" VALUES(1942,'en','The hunting bow is considered to be the safest hunting weapon. A maximum of damage without exposing yourself, for a minimum in battle scars.');
INSERT INTO "item_descriptions" VALUES(2061,'en','This cloak, not really nice at first sight, is nevertheless really efficient. Once you get used to the smell of rotting Crobak.');
INSERT INTO "item_descriptions" VALUES(2063,'en','Many parts from crobak corpses went into the making of these boots, which give their wearer a strange floating feeling similar to the feeling that comes from consuming grilled boletus.');
INSERT INTO "item_descriptions" VALUES(2066,'en','This trident is an approximate replica of a Kaniger''s lance, but three times as effective. Like a triple word score, or maybe a triple pint of beer on a night out.');
INSERT INTO "item_descriptions" VALUES(2070,'en','This bone helmet has been in a Kaniger''s pocket for many years. Worn and scratched it might be, but its properties are as powerful as ever.');
INSERT INTO "item_descriptions" VALUES(2074,'en','This cute little Bwak will eventually become an ugly Kwak. Until then, feel free to keep it by your side.');
INSERT INTO "item_descriptions" VALUES(2075,'en','This cute little Bwak will eventually become an ugly Kwak. Until then, feel free to keep it by your side.');
INSERT INTO "item_descriptions" VALUES(2076,'en','This cute little Bwak will eventually become an ugly Kwak. Until then, feel free to keep it by your side.');
INSERT INTO "item_descriptions" VALUES(2077,'en','This cute little Bwak will eventually become an ugly Kwak. Until then, feel free to keep it by your side.');
INSERT INTO "item_descriptions" VALUES(2094,'en','The Dark Makroute is a hat created from a Mutilated Makroute stitched together without an anaesthetic. Strangely enough, the master who visited these mutilations upon him is the only one it obeys... it can''t stand strangers.');
INSERT INTO "item_descriptions" VALUES(2095,'en','The Bear is a hat made from a head of a dead bear. Its fur is still silky and warm. The tailor who made it must have been really skilled to keep the look of terror on the dead bear''s face.');
INSERT INTO "item_descriptions" VALUES(2096,'en','Brave the Ghost was the first one to use Dark Wicker in fields other than gastronomy.');
INSERT INTO "item_descriptions" VALUES(2097,'en','The Champo once belonged to one of the greatest Fungi Masters of Amakna. Valiant and brilliant, Gnion the Boletus was the only one of his race who gained the respect of Human beings.');
INSERT INTO "item_descriptions" VALUES(2104,'en','The Daudgee is a disturbing helmet made of Ouginak remains and other rubbish. Worn for many years by Gourlo the Terrible, the Daudgee has come to symbolise hopeless desolation.');
INSERT INTO "item_descriptions" VALUES(2118,'en','This cloak allows you to remain incognito in a cemetery, or to transform yourself at will into a female Chafer. Both these things are entirely useless to anyone but the most criminally perverse among us.');
INSERT INTO "item_descriptions" VALUES(2119,'en','This cloak gives you wings of a sort. The smoke it gives off when you burn it... you''ll be high as a kite.');
INSERT INTO "item_descriptions" VALUES(2154,'en','A ring worn by Silaisie.');
INSERT INTO "item_descriptions" VALUES(2155,'en','An amulet worn by Silaisie.');
INSERT INTO "item_descriptions" VALUES(2156,'en','This sword allows you to preach to the people.');
INSERT INTO "item_descriptions" VALUES(2233,'en','Xof the Fox created this belt after he inexplicably decided to gather up all the teeth he could find on a Wabbit battlefield. It has now become a lifelong passion of his.');
INSERT INTO "item_descriptions" VALUES(2341,'en','Mech Riorraw specially designed this bow. It can cross lava rivers and reach the top of Brakmar walls. No more, no less.');
INSERT INTO "item_descriptions" VALUES(2361,'en','This bow is a creation of the inspired Mulic Bere. Its maximum range is just incredible. The problem is the minimum range can also be as incredible.');
INSERT INTO "item_descriptions" VALUES(2367,'en','Raya Bean thought he knew how to make friends. He often invited complete strangers to fancy-dress balls and bought them dinner, champagne and magnificent jewels. His conversation, in contrast, was paltry and extremely monotonous...');
INSERT INTO "item_descriptions" VALUES(2368,'en','Ramoune was a childhood friend of the sunny Nova. When Ramoune decided to put his spotless mind at rest for an eternal nap, he put an end to their friendship.');
INSERT INTO "item_descriptions" VALUES(2369,'en','This dazzling belt is the result of a mad bet to restore one of the most dazzling belts ever created in Amakna: it''s the Dazzling Belt. Pakape Promethe won the contest.');
INSERT INTO "item_descriptions" VALUES(2370,'en','The Vegete Hative – an incredibly light piece of equipment – has finally brought a little delicacy into this cruel world full of rutting Bworks.');
INSERT INTO "item_descriptions" VALUES(2371,'en','This belt came recommended by Jiva herself for those long, cold waking nights. If stained, hand wash with Rimennelle.');
INSERT INTO "item_descriptions" VALUES(2372,'en','Wearing these boots, you''ll feel like you''re walking on fresh grass. Their particular niche is the bio-conservative Hyuppie demographic.');
INSERT INTO "item_descriptions" VALUES(2373,'en','The fur used to make this pair of boots is absolutely ideal for keeping your feet warm. These boots are also a heart-warming memory of Moon.');
INSERT INTO "item_descriptions" VALUES(2374,'en','Tarsy the hermit quite obviously couldn''t stand visitors. Any guests who did dare come along quickly left with nothing but a big, red boot mark on their back.');
INSERT INTO "item_descriptions" VALUES(2375,'en','Wearing these boots, you''ll hear the noise of the wind on the coast or the cries of a chafer Lancer lost in the inmost depths of the labyrinth. They''re disturbingly similar.');
INSERT INTO "item_descriptions" VALUES(2376,'en','Even if your opponents are early risers, this axe will still hurt them.');
INSERT INTO "item_descriptions" VALUES(2380,'en','It''s a strange cloak made of pieces of Mushd which are very much all of one piece. And you can give the one who is laughing a piece of his mind.');
INSERT INTO "item_descriptions" VALUES(2381,'en','This cloak was made out of a pennant which used to be kept on the highest tower of Amakna Castle. That''s probably why it smells like fresh, sun-kissed linen waving in the Junssidor breeze...');
INSERT INTO "item_descriptions" VALUES(2382,'en','Maimpa, an Ecaflip who wasn''t afraid of heights... he thought he''d always land on his feet. One day, he landed on a starving Trool and was buried the same day on the very spot where his remains were found... Well, the spot where the biggest pieces were found.');
INSERT INTO "item_descriptions" VALUES(2383,'en','Made of bloody tissue, the Kwag''U Cape feels like stiff cardboard... a bit like a big, cape-shaped scab.');
INSERT INTO "item_descriptions" VALUES(2384,'en','There''s something beastly about these boots. Don''t be shocked if a Boowolf starts humping a limb when you put them on. Does your neck count as a limb? Well, it does for a loved-up Boowolf.');
INSERT INTO "item_descriptions" VALUES(2385,'en','Ideal for laying on the green grass of your garden or wiping the green mess in your nose, the Grazor is one of the few inanimate objects that can multitask.');
INSERT INTO "item_descriptions" VALUES(2386,'en','This strange cape draws its strength from its rundown look. The dirtier it is, the more useful it is.');
INSERT INTO "item_descriptions" VALUES(2387,'en','This cloak smells very bad - it has to be said. Truth be told, it''s made with a dense mixture of monster hairs, which gives off this wonderful medley of odours.
Do not confuse the Hairy Cloak with Hairy Pie, which is something else entirely.');
INSERT INTO "item_descriptions" VALUES(2388,'en','A long time ago, an Ecaflip follower called Dodge dropped a valuable treasure map which was carved on stone. He made an amulet of the largest piece, believing he would one day unite the pieces once more. Then he lost the amulet.');
INSERT INTO "item_descriptions" VALUES(2389,'en','Dodge brought meaning to his life by smashing, burning, grinding, selling... no, sorry not selling... ehh... throwing away, spitting on... everything he owned. And you should see what he did to his kamas. My Lord, I know they''re only a moulded piece of copper, but still, I pity those poor coins.');
INSERT INTO "item_descriptions" VALUES(2390,'en','This amulet is almost perfect. It considerably increases the Wisdom of anyone who wears it. It''s useful for making yourself appear wise in front of your friends, or passing yourself off as a model pupil.');
INSERT INTO "item_descriptions" VALUES(2391,'en','There''s an old Sufokian saying that goes: "Lucky one day, double lucky the day after." The longer you think about it, the more ridiculous it sounds.');
INSERT INTO "item_descriptions" VALUES(2392,'en','Thanks to the artisans of Amakna who are multitalented, the Modified Dragolyre is almost perfect.');
INSERT INTO "item_descriptions" VALUES(2393,'en','The Osamodas Onehaieuf Bek craved the respect of his guild members, so he decided to create a revolutionary Amulet. He found inspiration one morning while making some breakfast for his friends... Okaaaay!');
INSERT INTO "item_descriptions" VALUES(2394,'en','This heart-warming, sun-kissed little thing lends a feeling of invulnerability to the wearer. It''s also so light that many wear it for years on end, day in and day out, around the clock.');
INSERT INTO "item_descriptions" VALUES(2395,'en','Mad Bacon was a little vile demon with the enraging habit of standing right in front of people and not moving. He was magic-proof, which imposed a certain respect at the time. The Mad bacon went underground recently, he stood in front of the wrong guy for the wrong length of time.');
INSERT INTO "item_descriptions" VALUES(2396,'en','The name of this amulet is unpronounceable in the language of the country where it is manufactured, for non-natives, anyway. To make it more appealing to the Amaknian market, its designer used the services of a local translator, a certain Lou Gull, to help him come up with a new name. When the designer saw how much Lou Gull charged for his services, he used a cheaper translator instead. Evidently, you get what you pay for.');
INSERT INTO "item_descriptions" VALUES(2397,'en','Law-bibe was an old man who took whatever came to hand to create strange, strange items. One day, he made a locket with scrap off the street. He put it round his neck, and felt a strange sensation. A very strange sensation.');
INSERT INTO "item_descriptions" VALUES(2398,'en','The self-made Kaniger Rucky Balboua gave this eye to Melyonen to thank her for introducing his future wife, Adriana, to him. Soon after, they separated. Rucky would scream her name at the top of his voice and burst into tears without the slightest warning.');
INSERT INTO "item_descriptions" VALUES(2399,'en','José Bovey was a Mastogob shepherd. Mastogobs are a distant cousin of the Gobballs. Some of his Mastogob troop had a softer fleece than the others, and he sold these fleeces for more money. To distinguish between animals, he attached this necklace around their necks.');
INSERT INTO "item_descriptions" VALUES(2400,'en','These boots aren''t just dark, they''re Dark with a capital D. So don''t be surprised if a vampire falls in love with you when you wear them. I don''t know if you''ve had a hard life up to now, but I would say it would be the worst thing that''s ever happened to you. The worst, seriously. Worse than, well, I don''t know. Really bad. Like, awful.');
INSERT INTO "item_descriptions" VALUES(2403,'en','Used for parole in bygone days, the Peeka Belt apparently has an additional power compared to other belts. But nobody has figured out what it is. You''d better keep a close eye on the thing.');
INSERT INTO "item_descriptions" VALUES(2404,'en','This belt once belonged to a Grossewer Rat. It suits it perfectly. What I''m not supposed to tell you is that the little rodent had the most horrifying case of love handle you''ve ever seen.');
INSERT INTO "item_descriptions" VALUES(2409,'en','The Fire Kwak Headdress will make a real charmer out of you... Charm is the second best way of sidelining your enemies in the heat of combat... The other is raw, unpackaged, unapproved-by-the-FDA LUST. Let me tell you, though, with the beasts that wander round these parts, you''ll feel like a big of cheese in a Bonta rat trap if you take the latter approach.');
INSERT INTO "item_descriptions" VALUES(2410,'en','The Treechelmet protects you from hangovers.');
INSERT INTO "item_descriptions" VALUES(2411,'en','This magnificent headgear increases Strength and Intelligence... if you can stand the smell.');
INSERT INTO "item_descriptions" VALUES(2412,'en','This cloak won''t make you fly but it will itch like hell. Even if you sew a big "S" on it, it won''t work... though some people a few years ago on a cliff were absolutely convinced of it. Too bad.');
INSERT INTO "item_descriptions" VALUES(2413,'en','With these Treechnid Leaves on, you''ll be able to strut about in the forest without being recognised. However, beware of the Treechnids in search of spring buddings.');
INSERT INTO "item_descriptions" VALUES(2414,'en','This cape was designed to please - it''s hard-wearing and comfortable, it looks classy, and it''s a good step up from a Novice Cloak. But it smells dreadful and plays merry hell with your nostrils. Well, what do you expect? You can''t have it all.');
INSERT INTO "item_descriptions" VALUES(2415,'en','The Fire Kwakblade is a magnificent weapon. Even if you don''t scare your enemy away, at least, you might make an lasting impression.');
INSERT INTO "item_descriptions" VALUES(2416,'en','The user guide explains that this surprising hammer can release astonishingly powerful energy when correctly used. Another Osamodas'' user guide translated into Sadida.');
INSERT INTO "item_descriptions" VALUES(2417,'en','This staff was sculpted from a rather old Treechnid: it can be recognised by its aggressive shape, but it hasn''t kept the woody smell that is often characteristic of things that have aged.');
INSERT INTO "item_descriptions" VALUES(2418,'en','Using this ring, your master may be able to find you if you get lost while delivering a letter.');
INSERT INTO "item_descriptions" VALUES(2419,'en','This ring once belonged to the renowned Bouze Lite Yeah, the saviour of the modern age. He never stopped going on about some place he used to drink called the Inn ''Finity and Beyond''.');
INSERT INTO "item_descriptions" VALUES(2420,'en','The branch of a Treechnid isn''t easy to carve, but with some perseverance you''ll get a simple and stylish ring. Simple and stylish like a sleeping Osamodas.');
INSERT INTO "item_descriptions" VALUES(2421,'en','With those Fire Kwak spurs on, every Sram for miles around will be on your back.');
INSERT INTO "item_descriptions" VALUES(2422,'en','These are the most comfortable boots ever created. The inside seems to be padded with Gobball Wool and you can feel a liquid running through your toes. For all you know, it could be Gobball Saliva... even Blood. Whatever!');
INSERT INTO "item_descriptions" VALUES(2423,'en','You''d get the same effects out of this pair of Boots as you would from an evening at the tavern. You must have a drink, or plenty of drinks, to get the optimum effect. And the next day, your legs will feel as heavy as these boots.');
INSERT INTO "item_descriptions" VALUES(2424,'en','With all these feathers around your neck, you''ll look like Aldo Rado, the great Sacrier adventurer eternally searching for a golden city.');
INSERT INTO "item_descriptions" VALUES(2425,'en','A fine piece of Gobball horn, this. The material is known for bringing peace and wisdom to these tranquil beasts, so a Gobball Amulet should bring peace and wisdom too. Although since you murdered the poor thing to get it, maybe the opposite will happen. Who knows.');
INSERT INTO "item_descriptions" VALUES(2426,'en','This small Arachnee is the proof that you don''t have to stuff an animal to turn it into an amulet. It will tickle your neck and might even spin a web in front of your mouth if you yawn too much or talk too much rubbish.');
INSERT INTO "item_descriptions" VALUES(2427,'en','This Belt is perfect to strut about like a Fire Kwak during the season of love. Provided, of course, that it''s the only thing you''re wearing.');
INSERT INTO "item_descriptions" VALUES(2428,'en','Easy to wear, this belt is quite light in relation to its size. The wool looks brand new... according to the legend, about a hundred Gobballs had to be cut to pieces to get this smooth and silky look.');
INSERT INTO "item_descriptions" VALUES(2429,'en','This belt will increase your self-confidence and give you abs of wood. An anti-Arachnee treatment is nevertheless strongly recommended once a year. It is more or less the same as the hair of a Sadida, but with a lot less anti-parasites.');
INSERT INTO "item_descriptions" VALUES(2435,'en','Kere was the only Eniripsa to ever win the Great Amakna Triathlon. Wearing these handmade boots, he skimmed across the Asse Sea, leaving behind all the Ecaflips who were gob-smacked to see an Eniripsa running on water. Nice!');
INSERT INTO "item_descriptions" VALUES(2438,'en','The Royal Gobball Headgear will never go out of fashion. Besides being elegant, the bearer gains Strength and Intelligence.');
INSERT INTO "item_descriptions" VALUES(2440,'en','This sword doesn''t know whether it''s coming or going. It inflicts all types of elemental damage.');
INSERT INTO "item_descriptions" VALUES(2441,'en','This ring increases life, just like the smell of Royal Gobball it gives off increases its charm.');
INSERT INTO "item_descriptions" VALUES(2442,'en','They shine, they radiate power, they are fit for a king! Three cheers.');
INSERT INTO "item_descriptions" VALUES(2443,'en','This amulet increases Strength and Intelligence.');
INSERT INTO "item_descriptions" VALUES(2444,'en','This magnificent belt increases your Vitality and conveniently carries loads of items. It''s so soft that you can even use it to bind your lady-love hand and foot when she refuses to stay home.');
INSERT INTO "item_descriptions" VALUES(2445,'en','On top of being classy, this cape, worn by the great Royal Gobball, inspires the wearer with incredible strength.');
INSERT INTO "item_descriptions" VALUES(2446,'en','Without any hairs or threads, this cape remains a mystery for the intellectuals of Amakna. At last count there were ten.');
INSERT INTO "item_descriptions" VALUES(2447,'en','With this headgear on, the hotties will be queuing up to lick you. It''s one of those things Captain Chafer always dreamt of in his own time.');
INSERT INTO "item_descriptions" VALUES(2469,'en','There''s no need to bite your nails with this ring on your fingers, just lick them instead!');
INSERT INTO "item_descriptions" VALUES(2470,'en','These boots are great in summer because they give off a smell of wild strawberries in the heat... which also masks the stench of perspiration left behind by the hairy toes of the old Sadida who wore them before you.');
INSERT INTO "item_descriptions" VALUES(2471,'en','The worst thing about this item is that when you get hungry, you''ll be tempted to take a bite of it.');
INSERT INTO "item_descriptions" VALUES(2472,'en','This amulet betrays your love of jelly.');
INSERT INTO "item_descriptions" VALUES(2473,'en','Classy but not very effective, this cloak will suit young adventurers nonetheless.');
INSERT INTO "item_descriptions" VALUES(2474,'en','This hat is not really useful for anything... it does scare the boys away quite nicely though.');
INSERT INTO "item_descriptions" VALUES(2475,'en','A small but pleasing ring for beginners which will amuse young children, or Ecaflips.');
INSERT INTO "item_descriptions" VALUES(2476,'en','These standard boots are popular with young folk of adventurous spirit.');
INSERT INTO "item_descriptions" VALUES(2477,'en','A small belt for budding adventurers.');
INSERT INTO "item_descriptions" VALUES(2478,'en','Not too classy or even powerful, but it''s better when you''ve collected the whole set.');
INSERT INTO "item_descriptions" VALUES(2485,'en','The MUST-HAVE item, but only in the North-East of Amakna.');
INSERT INTO "item_descriptions" VALUES(2489,'en','This elegant cape will make you irresistible to all the noobs out there.');
INSERT INTO "item_descriptions" VALUES(2498,'en','The Vegamu attracts swarms of Moskitos that mistake it for one of their friends. They are always disappointed when they see this character.');
INSERT INTO "item_descriptions" VALUES(2521,'en','Roll, the boot owner''s lovely sister, specialised in astral taxidermy. Long ago, no one knew the difference between astral taxidermy and regular taxidermy. Nowadays, it''s easy to see that astral taxidermy is the involves stuffing astral creatures. If you still can''t understand where they went wrong, you obviously don''t know just how stupid they were.');
INSERT INTO "item_descriptions" VALUES(2522,'en','These boots enabled the famous Jojo to perfect his famous roundhouse kick, which was known as "Hot Red Kick". No one knows where this name comes from since his boots were unmistakably white!');
INSERT INTO "item_descriptions" VALUES(2523,'en','This belt has been especially designed to protect the hips of our valuable heroes. Totally useless to you then.');
INSERT INTO "item_descriptions" VALUES(2524,'en','Rumour has it that this belt was created by Captain Blooe himself. It defies belief, and yet you believe it all the same.');
INSERT INTO "item_descriptions" VALUES(2530,'en','A bit heavy but really pretty, you''ll be the queen of the night with these Caraboots on.');
INSERT INTO "item_descriptions" VALUES(2531,'en','Just like you, turtles have very small heads. How convenient! This cap is just the right size for both of you.');
INSERT INTO "item_descriptions" VALUES(2532,'en','A practical, well-made cloak. It won''t make a champion out of you, but then again, I can''t think of anything that would make a champion out of you.');
INSERT INTO "item_descriptions" VALUES(2534,'en','Ideal for keeping cool in those hot summers on Moon Island, as well as ideal to cool down the advances of your more eager paramours, this cape will satisfy all the needs of the modern adventurer.');
INSERT INTO "item_descriptions" VALUES(2535,'en','This Ice Kwak headdress will keep your head full of fresh and brilliant ideas. And before you say anything, it doesn''t work on Iops.');
INSERT INTO "item_descriptions" VALUES(2537,'en','Ideal for toning your hips, this belt will allow you to keep cool below the belt too.');
INSERT INTO "item_descriptions" VALUES(2544,'en','Dreadfully sharp and incredibly classy, this blade will make your Crobak friends jealous.');
INSERT INTO "item_descriptions" VALUES(2545,'en','With these boots you''ll feel incredibly light and peculiarly ridiculous.');
INSERT INTO "item_descriptions" VALUES(2546,'en','Thanks to this magnificent helmet, you''ll have all the class of the notorious Lord Crow.');
INSERT INTO "item_descriptions" VALUES(2547,'en','Long ago, the best tailors of Amakna united to scavenge the remains of Lord Crow and make the greatest cloak the World has ever seen. It looks incredible draped grandly over your shoulders, but for some reason, it gives you the strong urge to eat cheese.');
INSERT INTO "item_descriptions" VALUES(2587,'en','This hatchet is the ideal mascot for any lumberjack. It''s not really useful (you can''t fell a tree with it), but having it attached to your belt might calm and reassure you.');
INSERT INTO "item_descriptions" VALUES(2589,'en','This small Axe can''t cut down trees but can protect you against small monsters. If you find yourself face to face with a Minotoror, just drop it and run.');
INSERT INTO "item_descriptions" VALUES(2590,'en','One day, a Bwork smith apprentice made a range of axes, a range of one-size-fits-all, ergonomic axes... THE ideal weapon for a young, simple-minded adventurer like yourself.');
INSERT INTO "item_descriptions" VALUES(2592,'en','Very light and easy to handle, this axe allows the Bambou chopper to keep well out of harm''s way.');
INSERT INTO "item_descriptions" VALUES(2593,'en','This axe, made of Oliviolet wood, is the only one that can harm the Oliviolet. You gotta fight fire with fire.');
INSERT INTO "item_descriptions" VALUES(2595,'en','This axe might be primitive, but it''s also very deadly... like a kick between the legs.');
INSERT INTO "item_descriptions" VALUES(2597,'en','This long axe worms its way into the cracks of the biggest trees and splits the giants in half. Its use in battle is no different. Ouch!');
INSERT INTO "item_descriptions" VALUES(2600,'en','This big axe makes a horrendous noise when it falls on something, reducing everyone in the vicinity to petrified silence.');
INSERT INTO "item_descriptions" VALUES(2601,'en','Darsson was a valiant Enutrof, though he was not very good with his hands. As he often dropped his shovel in fights, he decided to tie a spare axe onto his belt. It saved his life more than once. Then he dropped his axe. Poor bugger will never have kids.');
INSERT INTO "item_descriptions" VALUES(2603,'en','This axe is very useful for chopping up the more stubborn parts of a tree, such as the grizzled knots on an old oak... A few swipes with this fellow and you''ll have a perfectly round trunk.');
INSERT INTO "item_descriptions" VALUES(2604,'en','This bardiche is mainly employed by the militiamen of Amakna. Its unusually large size and girth undoubtedly compensate for something else.');
INSERT INTO "item_descriptions" VALUES(2606,'en','This axe is covered with primitive writings. Claus Ansipedi naively thought he could use it to dialogue with trees. He was last seen in the Dark Treechnid Forest.');
INSERT INTO "item_descriptions" VALUES(2608,'en','This axe was forged between two great stones, and changed hands so many times in the process that it has travelled the World ten times over in its lifetime.');
INSERT INTO "item_descriptions" VALUES(2612,'en','This long axe is used by horny-fisted seamen to battle the biggest fish the briny depths vomit to the surface. It will atomize anything smaller than a whale.');
INSERT INTO "item_descriptions" VALUES(2614,'en','Dame Zel was a pretty young princess who radiated intelligence and freshness. During a Bwork raid on her city, she shocked everyone when she took out this axe and, Moses-like, sent half the besieging army to oblivion.');
INSERT INTO "item_descriptions" VALUES(2615,'en','This axe is well known for rapidly and permanently resolving disputes between drunken Enutrofs.');
INSERT INTO "item_descriptions" VALUES(2616,'en','This axe owes its name to the test made to prove its dreadful efficiency: a gigantic axe, a mythophobiac and a hall full of bards.');
INSERT INTO "item_descriptions" VALUES(2629,'en','This cape, which looks royal, offers incredible protection. It made the reputation of a renowned female tailor who died victim of her success, squashed in the crowd.');
INSERT INTO "item_descriptions" VALUES(2637,'en','Made of bone, horn and cartilage, this curved bone is as sharp as an Ecaflip''s claw.');
INSERT INTO "item_descriptions" VALUES(2638,'en','100% natural, this sword was forged from the sixth claw of an Ecaflip. Don''t go picking your nose with it!');
INSERT INTO "item_descriptions" VALUES(2639,'en','An Ecaflip smith got the idea of creating this sword after failing to master the ancestral technique bearing the same name. She figured that if she couldn''t master the latter, she''d at least master the former.');
INSERT INTO "item_descriptions" VALUES(2640,'en','Strangely sculpted, this staff doesn''t come from around here. It smells of the darkness and dankness associated with Brakmar''s old haunts.');
INSERT INTO "item_descriptions" VALUES(2641,'en','This hat comes in red and white and is so classy, you''ll be invited to all the best parties in town. If you see the Ambassador, as you soon surely will, don''t forget to thank him in the traditional way: "Ambassador, you''re really spoiling us with these..."');
INSERT INTO "item_descriptions" VALUES(2655,'en','This belt is a patchwork of Lord Crow''s body parts. Once equipped with it, you''ll have a wonderful sensation of power. LeChouque even agreed to add his buckle as a show of support.');
INSERT INTO "item_descriptions" VALUES(2677,'en','This belt has been made out of LeChouque''s most powerful belongings, notably his famous boxer shorts. It''s enough to plunge the entire female clientele of the Pirates Bar into mass confusion.');
INSERT INTO "item_descriptions" VALUES(2678,'en','This belt almost looks like a loincloth. Very convenient for camouflaging yourself among the Kokokos of Moon Island, or even seducing one of them.');
INSERT INTO "item_descriptions" VALUES(2681,'en','This small belt is ideal for protecting your most sensitive parts from critical blows. 
Just check that the shoemaker has removed the owner from inside before trying it.');
INSERT INTO "item_descriptions" VALUES(2683,'en','This small belt is ideal for protecting your most sensitive parts from critical blows. 
Just check that the shoemaker has removed the owner from inside before trying it.');
INSERT INTO "item_descriptions" VALUES(2685,'en','This small belt is ideal for protecting your most sensitive parts from critical blows. 
Just check that the shoemaker has removed the owner from inside before trying it.');
INSERT INTO "item_descriptions" VALUES(2687,'en','This small belt is ideal for protecting your most sensitive parts from critical blows. 
Just check that the shoemaker has removed the owner from inside before trying it.');
INSERT INTO "item_descriptions" VALUES(2688,'en','Once you have equipped this belt it''s hard to lose it, that''s the least you can say! The scatterbrains and the serial victims of theft among you will be grateful.');
INSERT INTO "item_descriptions" VALUES(2689,'en','The shoemaker who created this belt using dragoturkey remains must really have been short on imagination to give it such a stupid name.');
INSERT INTO "item_descriptions" VALUES(2710,'en','An improved model of the standard version, the Wild Banisation Belt has been specially reinforced with hunting Wild Dragoturkeys in mind.');
INSERT INTO "item_descriptions" VALUES(2803,'en','That strange belt is made entirely of fragments of crab claws and carapaces. Even with its powerful magic, it will smell of fish forever and ever. You''d just better get used to it.');
INSERT INTO "item_descriptions" VALUES(2804,'en','The famous Boowolf "donated" his precious organs to make this incredible belt that just screams power despite its odd appearance that would satisfy even the most twisted Chafers.');
INSERT INTO "item_descriptions" VALUES(2807,'en','Bowisse the shoemaker made this belt. He gave it to Brouce Boulgoure when the legendary lumberjack managed to uproot the Soft Oak... You don''t even deserve to hear about such heroism, child!');
INSERT INTO "item_descriptions" VALUES(2808,'en','Yes my child, it will be hard to resist you with this belt on. Bowisse consequently advises you to never get too close to a Dragon Pig while wearing it. They''re known to be lusty devils.');
INSERT INTO "item_descriptions" VALUES(2809,'en','Behind the grotesque name, hides a beautiful creation by Bowisse the Shoemaker. Behind the beautiful creation, hides a grotesque reality... the belt is made of the skin and bones of Bowisse''s Chafer victims.');
INSERT INTO "item_descriptions" VALUES(2810,'en','The magical powers of this magnificent red belt will help you concentrate better and learn quicker. Some Iops even manage to hobble to the end of the alphabet before their ignorant lives are extinguished.');
INSERT INTO "item_descriptions" VALUES(2811,'en','Here''s a belt that''ll please the thrill-seekers among you! It was designed to aid the easy and safe hunting of Ouginaks. Mortality rates remained the same as before, but hunters kept wearing the thing. You have to admit it''s classy though, no?');
INSERT INTO "item_descriptions" VALUES(3203,'en','The supposed origin of this ring is doubtful, to say the least. Apparently it once belonged to a clan of Kanniballs of the worst type, the fern eaters. Certainly a story to frighten any young Sadida, and quite a few older Sadidas too.');
INSERT INTO "item_descriptions" VALUES(3204,'en','As of last spring, this is officially the trendiest belt on the streets of Bonta. The insignia of a renowned brotherhood of shoemakers adorns the buckle.');
INSERT INTO "item_descriptions" VALUES(3205,'en','It''s the most fashionable belt in the sewers of Brakmar, perfect if you''re looking to give the impression that you''re a hard nut to crack. In your case it''s just an impression, but it''s useful nonetheless.');
INSERT INTO "item_descriptions" VALUES(3206,'en','Specially designed to reward skilful knights, the Xerbo must be worn without underwear and in winter only.');
INSERT INTO "item_descriptions" VALUES(3207,'en','These boots are a dramatic improvement on even the most carefully crafted footwear. Comfortable and light, they promise consistent pedal satisfaction with every wear. At the sight of this pair, even your opponent will give a faintly happy, wistfully envious smile.');
INSERT INTO "item_descriptions" VALUES(3356,'en','Some people may laugh at you because of this surprising shovel but what does it matter? It''s time to accept your style and your personal taste!');
INSERT INTO "item_descriptions" VALUES(3357,'en','In Amakna, when pupils are too loud, too quiet, too smart or too dumb, they receive a firm smash on the knuckles with this hammer. Iop teachers in particular find it works wonders in the context of their one-tiered educational system.');
INSERT INTO "item_descriptions" VALUES(3647,'en','This sickle-like dagger was used to gut travellers who lost their way. It owes its name to the numerous binge drinking parties the owner organised with the money stolen from his victims. More specifically, the name refers to the morning after.');
INSERT INTO "item_descriptions" VALUES(3648,'en','Captain Chafer has disappeared but you have his dagger in your hands. Just imagine what the blade must have seen all that time it was in his murderous grasp.');
INSERT INTO "item_descriptions" VALUES(3649,'en','We owe this magnificent blade to a craftsman named Daguiero. Before a descent into gambling and other dubious activities, this was his last creation worthy of interest. Not a bad way of ending a career...');
INSERT INTO "item_descriptions" VALUES(3650,'en','These powerful daggers are the result of a collaboration between a group of wise craftsmen in order to secure their professional future. The group consisted of two. They both died arguing over the name of the daggers.');
INSERT INTO "item_descriptions" VALUES(3651,'en','A ridiculous, pint-sized artisan named Slaillehine had the wonderful notion of making these magnificent daggers.');
INSERT INTO "item_descriptions" VALUES(3652,'en','Marie Aigue knew how to treat the men folk. With her big staff, she thwarted the advances of many a great Iop knight. One fine day, it was discovered that Marie Aigue was, in fact, a boy dressed as a girl. Suddenly it all made sense.');
INSERT INTO "item_descriptions" VALUES(4241,'en','This sword''s fantastic colour will pierce right to your enemy''s heart, and then you can cut it out - which is exactly what an Ecaflipette would do! The magnificent pink hue is obtained by soaking the blade in monsters'' entrails for several centuries.');
INSERT INTO "item_descriptions" VALUES(4242,'en','This sword was originally an ornate fan for overheated ladies. All you had to do was wave it energetically about the face. The product was soon withdrawn when angry widowers complained they couldn''t put their wives'' heads back on. It was quickly re-launched as a lethal weapon. That''s market research for you!');
INSERT INTO "item_descriptions" VALUES(4381,'en','This strange amulet allows its wearer to relax, chill out and have a nap, right in the middle of a fight. Just like a Feca, in fact.');
INSERT INTO "item_descriptions" VALUES(4382,'en','With its cold, sharp blade, this sword makes the most primitive instincts bubble to the top. Each gesture, even with the best of intentions, results in a blow below the belt.');
INSERT INTO "item_descriptions" VALUES(4684,'en','This amulet contains a part of the Plain Crackler''s story that could be summed-up in two lines if anyone knew it. Unfortunately, even the Cracklers have forgotten how it goes.');
INSERT INTO "item_descriptions" VALUES(5122,'en','Pol Dullbow himself ordered this amulet from a renowned jeweller. He wanted to play with several dolls at the same time instead of having to wait for one to die before summoning a new one, something Sadidas like to do a great deal.');
INSERT INTO "item_descriptions" VALUES(5999,'en','This wand was created under extreme conditions identical to those at the centre of the earth. That''s where it gets its frightening powers. That''s the story anyway – at least according to artisans capable of making one.');
INSERT INTO "item_descriptions" VALUES(6438,'en','This Wand is composed of soft materials, making it very tricky to use. However, once produced in combat by an experienced warrior, it reveals its true power.');
INSERT INTO "item_descriptions" VALUES(6439,'en','This ethereal wand is the result of a magic mixture of supernatural elements. Sometimes frightening, sometimes wacky, this wand is the epitome of instability.');
INSERT INTO "item_descriptions" VALUES(6440,'en','This wand is not just an ordinary ball of hair. Its centre absorbs the magic essence of various tufts and merges them all together. As strange as it may seem, it works!');
INSERT INTO "item_descriptions" VALUES(6442,'en','Always looking for ways to surprise his enemies, the Sadida Aga Dou took care to hang a small doll at the sharp end of his lance. Young Iopettes inevitably rush towards it to get the doll and die from severe impalement.');
INSERT INTO "item_descriptions" VALUES(6443,'en','The renowned and hilarious Yamato, a craftsman unjustly despised because of his ridiculous bow, was the first to dare to imbue an amulet with magic... until then it was believed to be impossible.');
INSERT INTO "item_descriptions" VALUES(6444,'en','Apart from its colour, this amulet has no connection whatsoever to the famous Turquoise Dofus. However, it is every bit as powerful. Sometimes you can read a book by its cover...');
INSERT INTO "item_descriptions" VALUES(6445,'en','This bow has been crafted with the utmost care, giving it a perfect curvature. They say that the sculptor who made it used a gobbette''s backside as a pattern.');
INSERT INTO "item_descriptions" VALUES(6446,'en','Chiduc was a bow carver, renowned for his errors of pronunciation. He was incapable of pronouncing the letter "b" without adding an "ow" behind. Yet another indication of his erratic genius.');
INSERT INTO "item_descriptions" VALUES(6449,'en','Personally I can''t think of a better way of impressing the girls at the bus stop than turning yourself into a shadow or even into Lord Crow. This cape will let you do just that. It also makes a great pillow... if you''re lucky.');
INSERT INTO "item_descriptions" VALUES(6450,'en','Aman, a renowned female shoemaker had a lover who often stood her up. As love is blind, she still gave him this magnificent belt as a symbol of their secret love.');
INSERT INTO "item_descriptions" VALUES(6451,'en','Seeing this bow, you have to wonder why it has such a stupid name. You and it have that in common.');
INSERT INTO "item_descriptions" VALUES(6452,'en','This strangely-shaped bow is a work of art. The Bow Sculptor who created it is also renowned for having exhibited his most controversial models in Loopine''s cave, a place forbidden to all but the most hedonistic of bohemians.');
INSERT INTO "item_descriptions" VALUES(6453,'en','This weapon was inspired by this ancient, incredibly specific, Chinese axiom: "Many''s the bow that was useful for catching a flying fish and then cooking it on a slow barbecue for several minutes each side, being particularly handy for turning said fish or plucking it out of the coals should it take a tumble."');
INSERT INTO "item_descriptions" VALUES(6454,'en','This Dark Treechnid branch is in fact one of the creature''s arms. Ideal for arm-wrestling training, it''s above all an excellent weapon for terrorising your childhood enemies or torturing the Trunknids.');
INSERT INTO "item_descriptions" VALUES(6459,'en','Your only chance to survive in a mine infested with Dark Miners is to have light. Since you''ll never manage to steal one of their precious candles, just wear this amulet... at least it''ll bring you some luck.');
INSERT INTO "item_descriptions" VALUES(6460,'en','This magnificent brooch pays homage to the resistance of the miners of the Grimoth Silver Mine. They spent a winter fighting a Crackler of the worst kind but in the end they were killed by a Tofu who wandered into their hideout on his way home. Boy isn''t life unfair.');
INSERT INTO "item_descriptions" VALUES(6461,'en','It was this amulet, which was especially designed for older Enutrofs, that allowed Setag to get rid of all the other miners in the Grimoth mine. Quite heavy-handed, but very effective, it must be said.');
INSERT INTO "item_descriptions" VALUES(6462,'en','This little brooch is truly lovely. It was made to encourage unlucky people to try their luck at the fun fair, but it''s also useful when you go on epic hunting expeditions.');
INSERT INTO "item_descriptions" VALUES(6463,'en','This ring was made by a famous oriental itinerant, but unfortunately no one could remember his name. He died during an archery contest, putting a Wild Sunflower seed on his head instead of the larger Pumpkin variety.');
INSERT INTO "item_descriptions" VALUES(6464,'en','This ring is an improved version of the celebrated Ring of Satisfaction. It''s ideal if you want to step out of the blood-red spotlight of dangerous battle.');
INSERT INTO "item_descriptions" VALUES(6465,'en','Loopine once asked the monster that haunted his cave the secret to making this ring. The monster said he''d have to do him a few favours in return, and Loopine gladly agreed. 
Let''s just say the poor guy never wanted to see another ring in his life after the monster was finished with him, let alone make the bloody things. Blimey!');
INSERT INTO "item_descriptions" VALUES(6466,'en','This amulet allowed Shika Ingalsse to survive on several occasions when furious Gobballs, bent on making her life a misery, attacked her.');
INSERT INTO "item_descriptions" VALUES(6467,'en','Nobody knows who the owner of this ring is. He wanted to remain anonymous after a humiliating defeat inflicted by a summoned Arachnee. We must say in his defence that this Arachnee had been compelled by a Iop...');
INSERT INTO "item_descriptions" VALUES(6468,'en','While other Iops of his age got presents like a Tabi or a wooden Goultard for their communion, Vald got this ring. It''s hardly something you can show off to your friends but it''s very useful for fighting.');
INSERT INTO "item_descriptions" VALUES(6469,'en','This wedding ring has been worn down by the scratching of barley through hundreds of harvests. It was even there to witness the union of Farle and Shika when they got married in the middle of barley field one spring!');
INSERT INTO "item_descriptions" VALUES(6470,'en','These magnificent boots are perfect for kicking Gobballs in the arse when you''re herding the difficult little runts. Children respond just as well to the same encouragement.');
INSERT INTO "item_descriptions" VALUES(6471,'en','These small shoes have been reinforced, repaired and deodorised. They are often used to trap Mush Mush since the substratum left out by the Lousy Pig seems appetising to them...');
INSERT INTO "item_descriptions" VALUES(6472,'en','This padded Clay Dreggon shell makes you nearly impervious to Bwork Magus''s magical lightning bolts. It won''t be any help against real lightning, however...');
INSERT INTO "item_descriptions" VALUES(6473,'en','This Slate Dreggon shell would suit you perfectly, if only you knew how to wear it. Not everyone can pull off headgear such as this, though – just take a look at the Iops. Those bumbling idiots don''t even wear it the right way around!');
INSERT INTO "item_descriptions" VALUES(6474,'en','The Coal Dreggon shell is ideal if you want to want to go unnoticed at night or avoid falling rocks. That makes it popular with two divergent sections of society: peeping Toms in Madrestam Harbour and fans of Crackler rock-throwing contests.');
INSERT INTO "item_descriptions" VALUES(6477,'en','This magnificent hat will help you see everything as bright as daylight, especially during the daytime. It can also be useful to dazzle the beasts haunting the mines or to make Iops believe you''re... well anything you tell them.');
INSERT INTO "item_descriptions" VALUES(6481,'en','This magnificent hat was created on Dora Bora Island, south of Moon Island. Perfectly adapted to fight, it''s also much appreciated as a fruit basket, for traumatised Rokokonuts for instance.');
INSERT INTO "item_descriptions" VALUES(6482,'en','An improved version of the Jouik Krampe, this hat was made out of the best resources found on Moon Island, giving it a rural character. Even if you don''t look like a Kanniball, you''ll still give some great headbutts.');
INSERT INTO "item_descriptions" VALUES(6483,'en','According to the legend, this impressive helmet turns anyone who wears it into a Bronze Bwork. The helmet was held responsible for a string of incidents where defenceless hobos mysteriously disappeared, leaving only the taste of licked spoon behind them.');
INSERT INTO "item_descriptions" VALUES(6484,'en','When daggers are not enough anymore, when gods are making fun of you, you have to find your own way of fighting. Some followers of Sram have apparently understood, others are still counting on the help of gods.');
INSERT INTO "item_descriptions" VALUES(6485,'en','Because of his clattering bones and an obvious lack of dexterity and intelligence, the Chafer Archer has never been able to handle such a bow as this one. Although your bones may not shake like his, there''s no guarantee a beginner like yourself won''t look just as foolish.');
INSERT INTO "item_descriptions" VALUES(6491,'en','This bow is a messed up crossbreed of a Trunknid and a Treechnid. It''s obviously a failure for a lumberjack, but a true success for a bow carver. Your parents wish they could say the same about you.');
INSERT INTO "item_descriptions" VALUES(6492,'en','The distance between the two ends of this hedge-trimmer is identical to the space between a Lenalds'' eyes. Will these howwible wabbits stop at nothing?');
INSERT INTO "item_descriptions" VALUES(6493,'en','These Wabbit thongs give you the "Cawwot attitude." They are recommended by experts of ritual dancing, tap-dancing or the Captain Chafer fast tango.');
INSERT INTO "item_descriptions" VALUES(6494,'en','Used by the most renowned Amaknan Eniripsas, this wand is a great for casting vicious spells at your enemies. Most people use it to make themselves or their friends more intelligent. They say... though I find it hard to believe myself... but they say that someone once turned a Iop into a rat with this. Such an enormous leap in intelligence is unlikely, but try it out!');
INSERT INTO "item_descriptions" VALUES(6495,'en','Made from the remains of the Soft Oak, this wand is ultra-powerful. Just wave it from right to left according to the specified patterns and it may trigger a shower of toads... or you may look like a perfect idiot.');
INSERT INTO "item_descriptions" VALUES(6496,'en','This wand can sometimes turn against its owner. In this case, the best thing you can do is to give it to one of your enemies, or to a Iop - idiots like them will certainly believe it''s a present.');
INSERT INTO "item_descriptions" VALUES(6497,'en','Brouce Boulgoure''s wife, an Eniripsa, always stole her husband''s famous axe. To stop her, he cut off one of her wings and an arm. Then, when he inevitably regretted it, he gave her this wand. What a gentleman.');
INSERT INTO "item_descriptions" VALUES(6498,'en','These briefs of respectable size still sport the marks of their former owner (plus some really strange hairs). On the buttocks or on the head, this garment will bring you unlimited respect around Amakna.');
INSERT INTO "item_descriptions" VALUES(6499,'en','The teeth of this amulet have eaten away more Cawwots than Brouce Boulgoure has uprooted trees, so don''t be surprised if you find Tiwabbits trying to give you kisses on the neck as a result of your powerful Cawwot awoma.');
INSERT INTO "item_descriptions" VALUES(6500,'en','These Ears won''t improve your hearing but the good news is that your friends will easily spot you in a crowd...and that your enemies will have a good laugh. Keep smiling, this pair of ears will prove essential with time.');
INSERT INTO "item_descriptions" VALUES(6501,'en','If you carry this bag on your back, you can go on a trip without worrying about food. Even if the Cawwot is as empty as a Iop''s skull, the leaves on top of it can grow again. Ideal to make herbal tea.');
INSERT INTO "item_descriptions" VALUES(6503,'en','The Polpullet is the result of a cross breed between an aggressive Fire Kwak and a sickly Tofu. Time out of mind, the Polpullet hunt has been an unchanged ritual. Hunting this horrible creature is a pleasure on many levels.');
INSERT INTO "item_descriptions" VALUES(6504,'en','The only things we know about the creator of this hammer are his nickname - a certain Fantal - and his woeful taste. He loved covering himself with Royal Jelly and Tofu feathers... An expensive, useless activity. Some people are starving for God''s sake.');
INSERT INTO "item_descriptions" VALUES(6505,'en','This Hammer is ideal for fighting horned beasts... It isn''t recommended you nail your colours to the mast with it, though.');
INSERT INTO "item_descriptions" VALUES(6506,'en','An Enutrof legend says that a miner is "gogorified" when he can''t stand daylight anymore, a result of spending so much time working down his mine. Never bring a candle close to such a miner, he could turn you into bronze.');
INSERT INTO "item_descriptions" VALUES(6507,'en','The Terps was a very nasty creature, as dangerous and hated as the old Liche, its great rival. Determined to surpass its nemesis, the Terps created this hammer to crush its toes but ended up destroying its feet. The beginning of a great love story.');
INSERT INTO "item_descriptions" VALUES(6508,'en','An exceptional hammer which is ideal for taking care of your darling little prespic... or taking care of your enemies, if you''re a follower of Chaferfu.');
INSERT INTO "item_descriptions" VALUES(6509,'en','This magnificent hammer turned the heads of many an Osamodas. It''s so impressive that people still turn around when they pass by its bearer. You wouldn''t believe the number of chronic neck injuries this bloody thing has caused.');
INSERT INTO "item_descriptions" VALUES(6510,'en','Kahr was mad for hammer fighting, always fighting with that hammer he was. His pet name for it was ''Quire Boy'', since, like many a 12th century singer, this hammer never did see a nail.');
INSERT INTO "item_descriptions" VALUES(6511,'en','It''s the perfect hammer for talking yourself out of sticky situations. You''ll be an instant success at all the best parties too. Just don''t abuse its power. Yeah, you know what I mean.');
INSERT INTO "item_descriptions" VALUES(6512,'en','It''s THE weapon Xelors dreamt of when they were fifteen, especially those looking for thrills and spills. It helps them to get over the endemic Xelor height complex nicely.');
INSERT INTO "item_descriptions" VALUES(6513,'en','This hammer''s power comes from a subtle enchantment. You can''t see it at first glance, nor at second. I thought it was worth pointing it out, to increase its value for naive buyers.');
INSERT INTO "item_descriptions" VALUES(6516,'en','A Sram would cut his own parents up if you gave him these daggers at the wrong moment. They cannot resist. Some say they were invented by a powerful group of anti-Sramites who gleefully watch the entire population wipe itself out one by one.');
INSERT INTO "item_descriptions" VALUES(6517,'en','Any Srams looking for a new experience would be well advised to get their hands on a pair of these daggers. Their strange powers fill them with treacherous potential... for enemies or friends. The Captain Chafer would have loved them.');
INSERT INTO "item_descriptions" VALUES(6518,'en','Made by a famous sculptor, this wand has won the great N''hi Wand competition no less than 13 times. It easily beat old Boulgourde models, which were later taken off the market... too dangerous to be used by young Eniripsas.');
INSERT INTO "item_descriptions" VALUES(6519,'en','A renowned carver, he changed his name when he started using metal in his creations. Unfortunately, vanity often accompanies genius.');
INSERT INTO "item_descriptions" VALUES(6520,'en','The sculptor of this wand tried many times to change the unfortunate name of his magical weapon, but sales always plummeted. Any publicity is good publicity.');
INSERT INTO "item_descriptions" VALUES(6521,'en','People say that this staff would make a female Treechnid blush. We would not recommend you make use of this feature, male Treechnids are very possessive creatures.');
INSERT INTO "item_descriptions" VALUES(6522,'en','People say this root is herbivorous. It quickly worms its way through dead leaves and eats young shoots. Very impressive. But, well, unless you''re fighting Dandelions, it''s completely useless.');
INSERT INTO "item_descriptions" VALUES(6523,'en','This very stylish carved root will make an experienced summoner of you. Nothing to write home about in itself, but it''s a magnet for the female Sadidas.');
INSERT INTO "item_descriptions" VALUES(6524,'en','A shy old Sadida tried to lure a young, beautiful female into Hornbeam Wood with this root. He waited for one hundred years but she stood him up. Since that day, walking past some Savage Root on your way to a date is considered a very bad omen.');
INSERT INTO "item_descriptions" VALUES(6525,'en','The inhabitants of Amakna were fed up of hearing Fecas constantly complaining about their spells, so they made this staff to give them something else to moan about. Blah blah blah, bring 2-turn Immunity back, blah blah blah. Give it a rest, already!');
INSERT INTO "item_descriptions" VALUES(6526,'en','The smith who created this shovel wanted to stay anonymous, as a mark of modesty. But he left a clue in the name of the shovel that would lead devotees of his work to his real identity. These craftsmen are vain after all.');
INSERT INTO "item_descriptions" VALUES(6527,'en','Krys Mass was an illustrious shovel smith. He was always singing about shovels, out loud and out of tune. This scarred his wife for good, and she transferred the wounds onto the shovel she made him.');
INSERT INTO "item_descriptions" VALUES(6528,'en','This Shovel has explored all the continents, watched the sun set on the ridge of Crackler Mountain and rise over the tranquil Asse Sea. What? You''ve never gone further than Moon Island? Shame on you!');
INSERT INTO "item_descriptions" VALUES(6535,'en','This strange multi-purpose shovel was used to kill lice, to remove dandruff and to get Iops to learn their nine times tables.');
INSERT INTO "item_descriptions" VALUES(6536,'en','Dark Miners use this shovel, which is as large as the hand of a Crackler, to crush several Eniripsas at once. Try doing the same, you''ll feel great.');
INSERT INTO "item_descriptions" VALUES(6537,'en','This shovel is really obnoxious. Nobody knows why, but the Mairhes Shovels are always unbearably cheeky. They must have some good qualities... everyone does for god''s sake.');
INSERT INTO "item_descriptions" VALUES(6538,'en','This shovel allows the Enutrofs to see far into the distance... It''s not magic or anything, they just stick it in the ground and climb onto it. Ideal for finding your house when you''re lost in a field of gigantic ferns.');
INSERT INTO "item_descriptions" VALUES(6539,'en','The Truffle Shovel will make the people around you laugh. At you, though, not with you.');
INSERT INTO "item_descriptions" VALUES(6540,'en','People say the creator of this shovel truly resembled a beast. A kind of mix between a Boowolf and a Sadida. His shovel is said to have fallen in love with him. What a load of nonsense.');
INSERT INTO "item_descriptions" VALUES(6604,'en','In levels of sheer idiocy, the Tofu, the Gobball and even the Iop can''t hold a candle to the Quaquack.');
INSERT INTO "item_descriptions" VALUES(6654,'en','Just listen to this... The Sewer Warden was devoured by the Sewer Keeper. He was digested for more than 100 years before he finally died. His boots were fortunately more resistant than he was and are still in good nick.');
INSERT INTO "item_descriptions" VALUES(6660,'en','You''ll be irresistible with this hat. You''ll break hearts and discover the true meaning of Glory!');
INSERT INTO "item_descriptions" VALUES(6661,'en','Try catching a Quaquack at the Trool Fair with this.');
INSERT INTO "item_descriptions" VALUES(6662,'en','This wonderful 100% southern larva silk hat, washable in fresh water, will make your beloved melt like a Mint Jelly in the sun.');
INSERT INTO "item_descriptions" VALUES(6712,'en','This magnificent cape smells like fruits of the forest. Not enough to drive a Craette mad about you, but enough to drown the stink of a sloppy Sadida.');
INSERT INTO "item_descriptions" VALUES(6713,'en','Soaked with the blood of the terrible Lordsoth, these daggers helped him bring down the Chafer King during the famous dagger throwing contest at Troolmusement park. The Chafer King never again revealed his leather briefs and went into exile with the illustrious Captain Chafer in the surroundings of the Pandala cemetery.');
INSERT INTO "item_descriptions" VALUES(6716,'en','This pinchy little monkey seems to like you now.');
INSERT INTO "item_descriptions" VALUES(6717,'en','You''ll be saying "wow" and taking bows every time you take this tiny Bow Wow out to do its business. Due to its wild nature, this pet should not be fed – that is, unless you want to lose a hand.');
INSERT INTO "item_descriptions" VALUES(6718,'en','The fairer sex of any class will fall under the spell of this cuddly little ball of fluff. That alone makes it an animal to be feared.');
INSERT INTO "item_descriptions" VALUES(6719,'en','This strange headgear used to belong to the notorious Bearman. Sewn from the remains of the head of a decomposing bear, the headgear will itself turn heads thanks to the unmistakable whiff-trace that follows you wherever you go.');
INSERT INTO "item_descriptions" VALUES(6720,'en','This beautiful cloak has been worn for years by the famous Bearman. It won''t turn you into a bear, but you will be able to rival the greatest of fighters.');
INSERT INTO "item_descriptions" VALUES(6721,'en','These boots are lined with bear fur: even the coldest-blooded creatures will have toasty warm feet.');
INSERT INTO "item_descriptions" VALUES(6722,'en','The Bearman has vowed never to take off this wedding ring in memory of his dead wife... the besotted groom summoned a bear to impress his newly-wed love. She went to give it a hug... the summoned bear, raised by a distant father and an abusive mother, thought she was trying to beat him... you can guess the rest... The most tragic thing about this story is that Bearman hadn''t made a single payment on the ring. Man, that has to hurt!');
INSERT INTO "item_descriptions" VALUES(6723,'en','The Bearman was wearing this necklace around his neck when he faced the hooligans of Bimdhul''s lair. Legend has it that the amulet saved him, but on close inspection, you can see why it''s just a legend.');
INSERT INTO "item_descriptions" VALUES(6724,'en','This little bear hair-covered belt will hide your love handles perfectly. You should wear it always to avoid disappointing your beloved.');
INSERT INTO "item_descriptions" VALUES(6725,'en','The Bearman used this staff to tame his summoned Bear and from time to time, to rap his children''s knuckles when they didn''t do their homework. Here''s a man who understood the value of education.');
INSERT INTO "item_descriptions" VALUES(6731,'en','With this amulet around your neck, you might fool yourself into thinking people won''t smell your breath. No chance!');
INSERT INTO "item_descriptions" VALUES(6732,'en','Long ago this small ring was much sought after by Enutrofettes who preferred to use it to decorate their toes. An excellent way of hiding their warts.');
INSERT INTO "item_descriptions" VALUES(6742,'en','This amulet is made of a mixture of Ambusher leaves and litter from Moon island. It looks more like a garland than a real amulet, but it will help you seduce the wildlife of the island, which almost exclusively consists of abominable creatures. No Ambusher will resist you, they all will fly into your arms to give you a hickey. Only the most unlucky in love will appreciate this piece.');
INSERT INTO "item_descriptions" VALUES(6743,'en','Take some Ambusher leaves, pile them up, let them macerate in stale alcohol, pierce them, drink the left-over alcohol, stick the leaves around a piece of bark, fix some pieces of Tikoko leaves with a slimy material, and here is a magnificent Deceitful Wedding Ring. It smells really bad and it will be quite handy for you to justify the smell of your fingers overall if you have a tendency to put them everywhere. Especially where you shouldn''t.');
INSERT INTO "item_descriptions" VALUES(6744,'en','Once you''ve tried these boots on, you won''t be able to part with them. Not because they are exceptional, but because they are exceptionally sticky. A feature they often share with female Ambushers.');
INSERT INTO "item_descriptions" VALUES(6745,'en','Outstanding handicraft made of remains of Ambushers and litter picked up along the Moon beaches, in the middle of the foul foam, this belt, when worn alone, will give you a really surprising look. Enough to disconcert your enemies or surprise your beloved, you''ll be able to take advantage of this special moment when, for once, you''ll have the upper hand.');
INSERT INTO "item_descriptions" VALUES(6746,'en','Oto Mustam, the leader of the Brakmar warriors, wore this small amulet long ago... though only at the organised orgies of Brakmar. They say it doubled as a leash!');
INSERT INTO "item_descriptions" VALUES(6747,'en','When the wind blows in its feathers, the Wind Kwak feels as free as an eagle, gliding like a dead leaf carried by a gust of wind. In spite of the clumsy description, it really is quite impressive.');
INSERT INTO "item_descriptions" VALUES(6748,'en','Judiciously worn, this ring will make your stubby little fingers look a little longer. Unfortunately for some, it only works on fingers.');
INSERT INTO "item_descriptions" VALUES(6749,'en','This ring is so light that it could be blown off by the least gust of wind. But don''t expect you''ll be taken away with it. At best, you''ll be safe, humiliated and on solid ground.');
INSERT INTO "item_descriptions" VALUES(6750,'en','Cold and sharp, this blade will revive its users'' most primitive instincts.');
INSERT INTO "item_descriptions" VALUES(6751,'en','"This ribbed blade is lubricated for increased pain." That''s what the handbook says... What is that supposed to mean?');
INSERT INTO "item_descriptions" VALUES(6752,'en','Ideal for cutting clouds, this blade will also dissect Moskitos and split hairs.');
INSERT INTO "item_descriptions" VALUES(6753,'en','As perfect as ice-skates on frozen lakes, these boots are very useful for keeping your feet cool, or storing your flask. Recommendations? Don''t put them by the fire to dry, you''ll never see them again.');
INSERT INTO "item_descriptions" VALUES(6754,'en','"Nothing''s better for the feet than a pair of Earth Kwakoboots" said Rola Ingalsse, the famous ploughwoman. Soon after she somehow shovelled a giant clod of earth into her own eyes and was blind for ever more.');
INSERT INTO "item_descriptions" VALUES(6755,'en','Basic but efficient, these surprisingly light boots are sometimes used as wind socks. Listen carefully though... People who find themselves downwind of this improvised apparatus often die.');
INSERT INTO "item_descriptions" VALUES(6756,'en','Ideal for camouflaging yourself as a lump of earth, this cloak will help you attack ploughmen by surprise and steal their treasures. It is for this reason that collectors of ancient pottery covet it so fiercely.');
INSERT INTO "item_descriptions" VALUES(6757,'en','Light and refined, this creation is also used as a curtain by the most destitute in the region. Mummy Nova herself used to wear this as an evening dress.');
INSERT INTO "item_descriptions" VALUES(6758,'en','The Earth Kwak is not very social and is especially hunted for its feathers, as everybody knows. If you wear this belt around your hips, you''ll have the Earth Kwak hunters thinking you''re an over the hill Kwak. Sometimes appearances can be truer than reality.');
INSERT INTO "item_descriptions" VALUES(6759,'en','"The only way to catch an upset old male Wind Kwak is to dress up as an upset female Wind Kwak. Then, the male will try to understand why the female is upset and will try every possible means to satisfy her. Once the male is satisfied with his performance, you should take advantage of his beatitude to fleece him." This is what one can read in part twelve of book three on Wind Kwak hunting. Besides, it is clearly specified that this belt is an essential element to pass yourself off as a female Wind Kwak. You know what you have to do now.');
INSERT INTO "item_descriptions" VALUES(6760,'en','This Earth Kwak headdress is so heavy it''ll always keep your feet on the ground. If the ground happens to be soft, well, it''ll keep your chin on the ground.');
INSERT INTO "item_descriptions" VALUES(6761,'en','To keep your hair streaming in the wind even with a headdress, there''s nothing like this lovely Wind Kwak Headdress which will certainly enable you to give free rein to your hair in most circumstances. It is enough to take the most blasé of Chafers aback.');
INSERT INTO "item_descriptions" VALUES(6762,'en','"There''s nothing like an Ambusher-Up for bash ups." At least, that''s what the Charlie''s Agents advertising leaflet said. It invited people to craft a lance using various resources hidden all over Moon Island. Some sort of treasure hunt without any maps.');
INSERT INTO "item_descriptions" VALUES(6763,'en','As the story goes, the dead Ambushers are very comfortable once they have taken the time to rot under the sun. Indeed, they become much more flexible and softer with time. Many adventurers would like to say the same about their beloved.');
INSERT INTO "item_descriptions" VALUES(6764,'en','This headgear isn''t giving you the smartest look, is it? But you do still look less stupid with it on. So just keep it!');
INSERT INTO "item_descriptions" VALUES(6766,'en','This apparently simple amulet was made from three magic ears of Corn, covered with the dust of precious stones, and planted in the Snossios plains during the thirteenth harvest of Istrabraq. It gives incredible courage to its bearer, who with its help can reap entire plains and valleys without rest.');
INSERT INTO "item_descriptions" VALUES(6767,'en','Shika covered this bracelet of precious stones with a hempen cloth to avoid drawing the Crobaks'' attention while Farle sowed his barley.');
INSERT INTO "item_descriptions" VALUES(6769,'en','This tool is fitted with lovely tines on one tip, making it an excellent pitchfork. It is said that Brouce Boulgoure himself felled the tree for it, in return for daily rations of oat flakes. He used to gulp down fistfuls before going and felling entire forests.');
INSERT INTO "item_descriptions" VALUES(6773,'en','This amulet was made in the Tude manner, hence its name. It is one of the earliest and simplest forms of jewellery, and so it is used to train apprentice jewellers. It is true that the thing is not very powerful, but you can''t have it all, can you?');
INSERT INTO "item_descriptions" VALUES(6774,'en','These clogs have been carved from various rare woods, reinforced with leather pieces of priceless value and padded with magic cereals. Light, stylish and comfortable, these clogs will resist the passage of time. Many misogynistic adventurers would like to say the same about their beloved.');
INSERT INTO "item_descriptions" VALUES(6775,'en','This cape, a fashionable patchwork of cloth and leather, has allowed Farle Ingalsse to single-handedly sow entire fields for numberless seasons on end. Once folded up and used as a pouch, its capacity seems to be almost unlimited. Nobody really knows the tailor behind this marvel. All the story tells us is that his business went tail-up when his clients began to confuse his cloaks with floor cloths. What a sad end to a fine career!');
INSERT INTO "item_descriptions" VALUES(6776,'en','This belt served Farle Ingalsse as a butcher''s apron when slaughtering Gobballs in his makeshift abattoir. A cruel, thankless task which he nevertheless carried out with obvious and undignified pleasure.');
INSERT INTO "item_descriptions" VALUES(6778,'en','This straw hat has been made with several plaited magic ears, and padded on the inside with various types of hair and fabrics hand sewn by Farle''s wife, Shika Ingalsse. Classier than the Slob Headgear, and more stylish than the Daudgee, this hat will protect you from the heat as it did Farle through hundreds of long harvests. In this hat, you''ll own those fields.');
INSERT INTO "item_descriptions" VALUES(6780,'en','With this basic-looking weapon, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(6781,'en','With this basic-looking weapon, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(6782,'en','With this basic-looking weapon, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(6783,'en','With this basic-looking weapon, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(6784,'en','With these basic-looking weapons, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(6785,'en','With this basic-looking weapon, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(6786,'en','With this basic-looking weapon, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(6789,'en','This small amulet blooms in spring, dries out in summer, fades in autumn, and goes rotten in winter. An ideal opportunity to change your style with the passing seasons.');
INSERT INTO "item_descriptions" VALUES(6791,'en','With this little ring on your finger, you''ll be able to walk through fields in the countryside. What do you mean you can do that already? Wow!');
INSERT INTO "item_descriptions" VALUES(6792,'en','This flower-shaped staff was made from the remains of wildflowers cut down in cruel, bloody battles. All those poor flowers'' rage and hatred is contained in this ridiculous little staff. The trickiest of Srams use this weapon to try and persuade gullible fools that they are really going to give them a bouquet of deflowers. Once within range, the poor fools get a proper whacking instead.');
INSERT INTO "item_descriptions" VALUES(6793,'en','This ring has proven its worth, as shown by the little mark made on the inside. It is a unique creation made by a jeweller apprentice for an important test. It is made from a standard iron ring plunged into a magic Tea solution.');
INSERT INTO "item_descriptions" VALUES(6794,'en','If you''re looking for something to trample those flowers growing in your fields, these boots are just the ticket. Your feet mightn''t smell so bad with them on. It''s a shame they don''t come as shorts too.');
INSERT INTO "item_descriptions" VALUES(6795,'en','If you''re planning to go to one of those eternally popular BABA theme-nights, this cloak is just what you need.');
INSERT INTO "item_descriptions" VALUES(6796,'en','With this petal-peppered belt around your waist, you can slip out of a nasty situation while your enemies roll around the ground laughing. This will take care of the most war-weary Chafer army, and instantly reverse the situation to your advantage.');
INSERT INTO "item_descriptions" VALUES(6797,'en','If you have always dreamt of being a florist and having rose-scented breath, it''s time for you to put this strange headgear on.');
INSERT INTO "item_descriptions" VALUES(6799,'en','Sharp as a Bwork blade, the Bwork Chief''s blade has the advantage of being much heavier. It is certainly less easy to handle, but you just have to make it fall on your opponent and he''ll be in two pieces. Lifting it up again if you miss is another issue, but your enemy will surely have run off by then.');
INSERT INTO "item_descriptions" VALUES(6800,'en','This cloak is made of Gobball Wool. It''s neither classy nor attractive. Don''t bother with it, basically.');
INSERT INTO "item_descriptions" VALUES(6804,'en','Although basic-looking, this flinty amulet is endowed with a very powerful magic that can turn a Bwork into a princess... or the opposite, nobody knows.');
INSERT INTO "item_descriptions" VALUES(6805,'en','Even your good friends will think you''ve married a great Bwork Chief if you sport this little thing on your wrist. It''s enough to get you a few free drinks at the local inn... Don''t be fooled though, they''ll be pity drinks.');
INSERT INTO "item_descriptions" VALUES(6807,'en','These boots just look like ordinary Bwork boots. And yet, they are Bwork Chief boots. Hard-wearing, powerful, and smelly, they will be the deciding factor in any evenly-matched battle.');
INSERT INTO "item_descriptions" VALUES(6811,'en','Wear this cloak to look like a battle-weary Bwork warrior. It''s perfect for stealing lunch money off the elderly in the village. All the same, if you''re in search of a soul mate, you might want to change your approach... unless you wear it with nothing else on... Hey, that''s it... that way, you can keep on scaring the elderly of the village too! Kill two birds with one stone.');
INSERT INTO "item_descriptions" VALUES(6812,'en','These purple leather briefs are all you need. You can wear them on their own and still look distinguished, provided that they fit you. You''re better off keeping still in them, though - even the slightest movement will have you sounding like an old door creaking shut.');
INSERT INTO "item_descriptions" VALUES(6813,'en','If you really want to look like a weakling, this helmet is made for you. In your case, it mightn''t make too much difference all the same.');
INSERT INTO "item_descriptions" VALUES(6817,'en','This amazing amulet was made from a reptilian shield, from which all gems were removed. As a result, it''s a particularly heavy, but very sturdy, piece of jewellery. Your neck will be protected from vampire bites, as well as from the aggressive advances of female villagers.');
INSERT INTO "item_descriptions" VALUES(6819,'en','This bracelet looks strangely like a glove... it''s not a glove, it''s a bracelet.');
INSERT INTO "item_descriptions" VALUES(6821,'en','Made from the remains of a Crocodyl Chief, this weapon will prove very useful if you are handsome, deft, clever and strong enough to handle it. In your case, I would try to find someone who will trade it for a Twiggy Sword.');
INSERT INTO "item_descriptions" VALUES(6825,'en','These beautiful slippers, made of Crocodyl Chief''s skin and scales, come with sharp teeth at their ends. Be careful when you play footsie under the table with your beloved, you might rip her lovely Tabi woollen stockings.');
INSERT INTO "item_descriptions" VALUES(6830,'en','The first day back at school is tough for children everywhere, and Amakna is no exception. It''s especially true for young Iops, for whom back-to-school means torture and unwinnable challenges. With its Crocodyl Chief scales and furry padding, this bag makes the whole experience a bit easier to bear.');
INSERT INTO "item_descriptions" VALUES(6831,'en','Too stiff to be used as a whip, too flexible to cause any real bodily harm, this gem-covered belt nevertheless serves one obscure purpose... Armed with this, you''ll never find your pants around your ankles again. Great or what?');
INSERT INTO "item_descriptions" VALUES(6834,'en','If you''ve always dreamt of looking like a Crocodyl - without becoming one - then this headgear''s make for you. Don''t even think about using this headgear to fool your friends and tell them you''ve actually killed a Crocodyl. They''ll never believe you.');
INSERT INTO "item_descriptions" VALUES(6839,'en','This weapon, on which Meow Meow put his hallmark, could turn you into a legendary Ecaflip, eventually...');
INSERT INTO "item_descriptions" VALUES(6840,'en','This weapon, on which Meow Meow put his hallmark, could turn you into a legendary Ecaflip, eventually...');
INSERT INTO "item_descriptions" VALUES(6856,'en','These scissors have been specially designed to cut the stems of demonic roses without damaging the petals, even when it bites into your calf.');
INSERT INTO "item_descriptions" VALUES(6863,'en','The helmet of an Astrubian mercenary.');
INSERT INTO "item_descriptions" VALUES(6886,'en','The cloak of an Astrubian mercenary... what were you expecting?');
INSERT INTO "item_descriptions" VALUES(6894,'en','This super-mighty fighting Bow Meow is the embodiment of super-might. Very impressive. Beware, it can only be entrusted to the care of Game Masters... because they''re worth it.');
INSERT INTO "item_descriptions" VALUES(6895,'en','Less super-mighty than the super-mighty fighting Bow Meow, this small fighting Bow Meow is still very powerful. This pet remains a safe bet for Game Masters but it''s not the least bit house trained and tends to roll around in its own detritus. Don''t forget to throw some boiling water over it every once in a while so that it retains its splendour.');
INSERT INTO "item_descriptions" VALUES(6908,'en','Hairy but elegant, this belt should remind you of your lady-love.');
INSERT INTO "item_descriptions" VALUES(6909,'en','These are the perfect boots for splashing around in the mud or making big dents in an expensive hardwood floor. It''s forbidden to wear them on dance floors, beaches and in saunas.');
INSERT INTO "item_descriptions" VALUES(6910,'en','This ring used to be fixed on the legs of rutting boars so that breeders could easily recognise them. Today, you are the one wearing the ring. You can take from with what you wish.');
INSERT INTO "item_descriptions" VALUES(6911,'en','This ridiculously small ring will help you overcome your Arachnophobia once and for all.');
INSERT INTO "item_descriptions" VALUES(6912,'en','Made from the rotting remains of decaying Arachnees, you''ll just love this belt. From time to time, it might come back to life and greedily bite you on the hips. Bloody thing!');
INSERT INTO "item_descriptions" VALUES(6913,'en','You''ll look like a wild Arachnee if you wear this Arachelmet. What will that achieve? Well, you might scare off some flies.');
INSERT INTO "item_descriptions" VALUES(6914,'en','Did you know that Weak Arachnees only have four hairy legs? With only four blows of this axe, you could turn one into an Arachneetrunk. Blimey. Imagine everyone in Amakna doing that. It explains why you don''t see Weak Arachnees any more, anyway.');
INSERT INTO "item_descriptions" VALUES(6915,'en','This is such a light ring that your hands can perform acrobatic feats when it''s on. It''s also quite useful if you want to humiliate somebody smaller than you by smashing their head with your thumb.');
INSERT INTO "item_descriptions" VALUES(6916,'en','Made out of Moskito skin and wings, this bag used to be a big fad in schools. Today, it is old-fashioned and has been replaced by the Crocodyl Chief Schoolbag. I don''t get it – one, a Crocodyl Chief Schoolbag is much more expensive and two, it''s HORRIBLE. Kids these days.');
INSERT INTO "item_descriptions" VALUES(6917,'en','This headgear takes its name from the eccentric Enutrof who discovered it while stripping a sick old Moskito for all it had. Extremely useful for inexperienced adventurers, this headgear will help you seduce famished Arachnees.');
INSERT INTO "item_descriptions" VALUES(6918,'en','This small amulet is not as effective as the famous Arachnamu. It certainly looks good, though... To be worn on a bare, hairy chest for a great jewel-in-the-roughage look.');
INSERT INTO "item_descriptions" VALUES(6919,'en','The Mush Mush has a reputation for being a nasty piece of work. He''ll pester and bite you at every opportunity, and he''s very moody. I was married to someone like that once... Smelled like mushrooms too.');
INSERT INTO "item_descriptions" VALUES(6920,'en','When a Mush Mush gets married, he gives this wedding ring to his bride. Since the bride has no arms, the ring is put delicately on one of its thorns. If you get hold of this ring, you will forever break the sacred bond between the two creatures. At best, the Mush Mush will take you as his bride to make up for it, and just remember, Mush Mushes spend their whole lives where the sun don''t shine.');
INSERT INTO "item_descriptions" VALUES(6921,'en','Before the prohibition, Musheadgear was smoked or drunk as tea. This headgear really has it all.');
INSERT INTO "item_descriptions" VALUES(6922,'en','The only thing more impressive than a livid Mush Mush is a livid Mush Mush in a cloak. Indeed, this particular cloak is the embodiment of a certain kind of ultra-powerful clothing... pretty ugly clothing if you ask me.');
INSERT INTO "item_descriptions" VALUES(6923,'en','This amulet used to belong to the great robber "Thisme" who was famous for his limitless cruelty and idiotic death. A central figure of Eniripsa folklore, he was crushed and drowned to death in an olive press having just come out of jail after a 30-year sentence for the theft of a giant walnut.');
INSERT INTO "item_descriptions" VALUES(6924,'en','These sharp daggers are very popular among robbers and very unpopular among the elderly for one and the same reason. The daggers cast spells that let them steal kamas from adversaries. At least that''s the story their victims tell.');
INSERT INTO "item_descriptions" VALUES(6925,'en','This beautiful belt is essential you if you ever decide to become a highwayman. Don''t wear it round town, though, you''ll be arrested on sight.');
INSERT INTO "item_descriptions" VALUES(6926,'en','With this Prespwig on, you''ll look like Debbie Crockett, the most celebrated huntress of the modern age, but a tragic victim of premature baldness. That''s not to say that this rat-bitten, off-red wig is any better than a balding nut.');
INSERT INTO "item_descriptions" VALUES(6927,'en','This reddish small cloak can be also used as a rug or doormat so that you can redecorate the house on the cheap.');
INSERT INTO "item_descriptions" VALUES(6928,'en','This ring, both simple and original, will seduce adventurers who long for the good things in life but could never afford them. The kind who would beat the daylights out of helpless animals and strip them of anything that seemed to be of any value. There''s no shortage of them, believe me.');
INSERT INTO "item_descriptions" VALUES(6929,'en','The Prespic Belt is the ideal belt for keeping your hips warm. It makes sensitive skin itch like hell, though. Only for the calloused.');
INSERT INTO "item_descriptions" VALUES(6930,'en','This helmet, directly hewed in stone, is worth its weight in gold. It will both protect you from the attacks of a Crackrock and allow you to give headbutts worthy of that of Desirock. It''s perfect to make your opponents go off their rocker.');
INSERT INTO "item_descriptions" VALUES(6931,'en','This stone cloak is a bit too stiff, but you''ll be grateful when you''re in danger of being spat on by a Crackler.');
INSERT INTO "item_descriptions" VALUES(6933,'en','Incredibly heavy but equally effective, these rocky boots will give you a good excuse to drag your feet when you have to defend a Perceptor in a fight you know you can''t win.');
INSERT INTO "item_descriptions" VALUES(6934,'en','This amulet is as heavy as a bulimic Blop. It has not been designed for weak adventurers. However, once you get used to bearing its heavy weight around your neck, you''ll sure cut a dash!');
INSERT INTO "item_descriptions" VALUES(6935,'en','Wear it on your waist and you''ll gain the respect of your peers. Wear it on your head and you''ll be the laughing stock of Astrub.');
INSERT INTO "item_descriptions" VALUES(6936,'en','With this helmet on, you''ll be able to pretend to be a Scaraleaf hunter.');
INSERT INTO "item_descriptions" VALUES(6937,'en','Your friends will think that you''ve joined the elite Scaraleaf hunter clan if you wear this helmet.');
INSERT INTO "item_descriptions" VALUES(6938,'en','Your friends will think that you''ve joined the elite Scaraleaf hunter clan if you wear this helmet.');
INSERT INTO "item_descriptions" VALUES(6939,'en','With this helmet on, your friends will think that you''ve joined the elite Scaraleaf hunter clan.');
INSERT INTO "item_descriptions" VALUES(6940,'en','Have you ever dreamt of wearing a cape made of Scaraleaf shells? Well, here''s your chance! Once equipped, you should feel as if you were a real Scaraleaf and you might even succeed to slide and skid around. This should be enough to take aback a whole herd of Trools.');
INSERT INTO "item_descriptions" VALUES(6941,'en','Who''s never dreamt of wearing a cloak made of Scareleaf shells? Once equipped, you''ll probably believe yourself to be a true Scaraleaf, and maybe you''ll manage to move on by way of slipping and skidding. That''s enough to take a crowd of Trools aback.');
INSERT INTO "item_descriptions" VALUES(6942,'en','Who''s never dreamt of wearing a cloak made of Scareleaf shells? Once equipped, you''ll probably believe yourself to be a true Scaraleaf, and maybe you''ll manage to move along by way of slipping and skidding. That''s enough to take a crowd of Trools aback.');
INSERT INTO "item_descriptions" VALUES(6943,'en','Who''s never dreamt of wearing a cloak made of Scareleaf shells? Once equipped, you''ll probably believe yourself to be a true Scaraleaf, and maybe you''ll manage to move along by way of slipping and skidding. That''s enough to take a crowd of Trools aback.');
INSERT INTO "item_descriptions" VALUES(6944,'en','When you''ll wear this ring, you''ll spare a thought for all the Scaraleaves you have wiped out. You then maybe ask yourself if it is worth this slaughter... Yeah, of course it is worth it!');
INSERT INTO "item_descriptions" VALUES(6945,'en','When you''ll wear this ring, you''ll spare a thought for all the Scaraleaves you have wiped out. You then maybe ask yourself if it is worth this slaughter... Yeah, of course it is worth it!');
INSERT INTO "item_descriptions" VALUES(6946,'en','When you''ll wear this ring, you''ll spare a thought for all the Scaraleaves you have wiped out. You then maybe ask yourself if it is worth this slaughter... Yeah, of course it is worth it!');
INSERT INTO "item_descriptions" VALUES(6947,'en','When you''ll wear this ring, you''ll spare a thought for all the Scaraleaves you have wiped out. You then maybe ask yourself if it is worth this slaughter... Yeah, of course it is worth it!');
INSERT INTO "item_descriptions" VALUES(6948,'en','The Scarabelt was worn as an indicator of a warrior''s fist-fighting skills. With a Green Scarabelt, your enemy knew you were a beginner. A red one meant that you were a lusty warrior who ate the uncooked internal organs of your enemies just for fun... And the white one indicated that you were really tough. A blue one meant you didn''t spend long enough saving up for one of the others.');
INSERT INTO "item_descriptions" VALUES(6949,'en','The Scarabelt was worn as an indicator of a warrior''s fist-fighting skills. With a Green Scarabelt, your enemy knew you were a beginner. A red one meant that you were a lusty warrior who ate the uncooked internal organs of your enemies just for fun... And the white one indicated that you were really tough. A blue one meant you didn''t spend long enough saving up for one of the others.');
INSERT INTO "item_descriptions" VALUES(6950,'en','The Scarabelt was worn as an indicator of a warrior''s fist-fighting skills. With a Green Scarabelt, your enemy knew you were a beginner. A red one meant that you were a lusty warrior who ate the uncooked internal organs of your enemies just for fun... And the white one indicated that you were really tough. A blue one meant you didn''t spend long enough saving up for one of the others.');
INSERT INTO "item_descriptions" VALUES(6951,'en','The Scarabelt was worn as an indicator of a warrior''s fist-fighting skills. With a Green Scarabelt, your enemy knew you were a beginner. A red one meant that you were a lusty warrior who ate the uncooked internal organs of your enemies just for fun... And the white one indicated that you were really tough. A blue one meant you didn''t spend long enough saving up for one of the others.');
INSERT INTO "item_descriptions" VALUES(6952,'en','The smell coming from this Boowolf Headgear will handily mask your terrible breath.');
INSERT INTO "item_descriptions" VALUES(6953,'en','These boots are coated with Boowolf hair. They are extremely useful for cleaning dusty wooden floors or fixing up the heads of your enemies as they lie dead on the battle field.');
INSERT INTO "item_descriptions" VALUES(6954,'en','This Boowolf fur makes for excellent protection against the cold... and also adventurers with a highly developed sense of smell.');
INSERT INTO "item_descriptions" VALUES(6955,'en','Used as a whip, this thong can be a lot more efficient than it looks to motivate your fellow travellers when they''ve lost the will to live.');
INSERT INTO "item_descriptions" VALUES(6956,'en','Watch out! This ring will make your finger stink, although that''s no bad thing, as the foul smell will mask a worse smell. This may just be the best thing that could happen to your finger, your hands in general, your family and your guildmates, in fact.');
INSERT INTO "item_descriptions" VALUES(6957,'en','This sword was used to cut the granite blocks for the city walls of Bonta and Brakmar. Nowadays, it''s used to crush creatures in battle.');
INSERT INTO "item_descriptions" VALUES(6961,'en','This ring is as popular with dentists as it is with gangsters. They both use it to break the teeth of careless people... They both use similar drills too, but let''s not dwell on that.');
INSERT INTO "item_descriptions" VALUES(6978,'en','From a distance, this creature looks just like a Bow Wow. From its face you can see it has suffered terrible trauma, so take good care of it.');
INSERT INTO "item_descriptions" VALUES(6980,'en','The Vulbis Dofus is the subject of terrifying rumours. It''s said that the dragon who created the ruby-coloured egg is more pitiless than death itself, devouring her victims in an attempt to satisfy her insatiable appetite. Tall tale or truth? Only the most valiant and foul-tasting heroes know for sure.');
INSERT INTO "item_descriptions" VALUES(6981,'en','The blade of these daggers is made of ice. Reminds me of an old incident that had the detectives working overtime... A fella called Tum Sellick stabbed his buddy with one of these things over a couple of kamas... Nice crime... They found the novelty ice-cube maker in his house though... NICKED!');
INSERT INTO "item_descriptions" VALUES(6982,'en','These daggers are soaked in the blood of various evil creatures, such as children. They are very special.');
INSERT INTO "item_descriptions" VALUES(6983,'en','Only sharpened once every ten years, these daggers retain their lethal edge because of the dark magic that possesses them. They can sometimes be seen walking the streets at the weekend, playing loud music and staring threateningly at passersby.');
INSERT INTO "item_descriptions" VALUES(6984,'en','These daggers belonged to a Sadida whose dazzling ascent will be remembered forever in Amaknian history. From a young age, this Sadida dedicated his humble life to Gobbly hunting... the villagers found it hilarious... word spread and soon folk came from all around to watch him hunt those ridiculous balls of wool. His revenge was terrible and long-lived. When the price of Gobbly skins skyrocketed, he became so rich that he paid to have every last villager who mocked him hunted down and murdered. He''s storing their skins too, but the stock market isn''t going his way.');
INSERT INTO "item_descriptions" VALUES(6986,'en','This shield has seen a few battles too many and in this state it is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(6988,'en','The sister of a wild Xelor who was kidnapped by unscrupulous slave drivers used to wear this thing for her nightly shows, the nature of which I will not repeat here.');
INSERT INTO "item_descriptions" VALUES(6989,'en','This hat was made a long time ago by apprentice tailors who wanted to protect themselves from the violent fits of rage of Mirko, their boss. This fine business man was often forced to kick his apprentices in the head when they didn''t work fast enough. From what I''ve heard, that was far too good for the lazy bast.');
INSERT INTO "item_descriptions" VALUES(6990,'en','This hat is a tribute to the distant cousins of the Moskitos: the Moths. A lot bigger and a lot kinder than the Moskitos, the Moths took such good care of their livestock that they soon became extinct from self-inflicted famine. From this tragic story, we have the common insult ''Moth'' as in, ''Poor bloody Moth'', which describes a fellow who discovers his spouse is devastatingly gluttonous.');
INSERT INTO "item_descriptions" VALUES(6991,'en','This strange-looking hat looks like a big dehydrated rotting fruit... A bit like you after a night out at the pub.');
INSERT INTO "item_descriptions" VALUES(6992,'en','An improved version of the famous Kanniball Mask, the Kannipiwi will make you look like a real Piwi hunter to your friends.');
INSERT INTO "item_descriptions" VALUES(6993,'en','Lonard Kohen, the famous minstrel with the voice of a castrated Crackler (which is still incredibly low) was burnt alive in front of the bank of Bonta after causing a moral scandal with his latest, and last, song "Tower of Thong". A full recording was made of his cries of agony, which he had the vision to frame in C#m, modulate to Fb, and resolve in a risqué but manageable G#. Nice.');
INSERT INTO "item_descriptions" VALUES(6994,'en','This hood-cloak hybrid is just amazing. If it were made of leather, Captain Chafer would have loved it.');
INSERT INTO "item_descriptions" VALUES(6995,'en','You just can''t stay inside this cape; it''ll throw you out whether you want to go or not.');
INSERT INTO "item_descriptions" VALUES(6996,'en','Stradamus was an old drunken Enutrof who could read the future in pints of beer. Legend has it he was buried standing up in a wall of the Brakmar inn upon his own request, "so that no drunkard can ever spill his beer over my grave". This has been told at least once a week by every drunk in every inn in Brakmar.');
INSERT INTO "item_descriptions" VALUES(6997,'en','The woman who created this ring was convinced the end of the World was near due to plummeting food supplies. She used to spend entire days engraving messages on wooden tables with her motto ''No steak but what we bake''. Time proved her wrong.');
INSERT INTO "item_descriptions" VALUES(6998,'en','This small wedding ring will fit an Eniripsa''s little fingers perfectly. For Iops, however, it''s almost unusable. Their fingers are too fat and they can''t get it into their heads that it''s not a bracelet.');
INSERT INTO "item_descriptions" VALUES(6999,'en','Lahilama was a great spiritual guide who kept his temple right in the heart of the mountains. He was so bored that he spent his days sewing little yellow hats for his disciples. They just had nothing to talk about. They all slowly went mad years of awkward conversation.');
INSERT INTO "item_descriptions" VALUES(7000,'en','This ridiculous little piece of bamboo has got strange magical powers. It used to be carried by young Pandawas, once they''d been through puberty. You might want to wait a while before you start wearing it round your neck...');
INSERT INTO "item_descriptions" VALUES(7001,'en','"I, I am the kheeng, you, you are the quheen, whee can be heeroes just for one daaaayyyy"
Davyd, the famous minstrel, was singing his head off on his way back from Moon Island.');
INSERT INTO "item_descriptions" VALUES(7002,'en','This amulet of Bamboo resin will spread a nice smell all around you. It comes in handy when you''re practising your Wind of Panic.');
INSERT INTO "item_descriptions" VALUES(7003,'en','This Talisman was created with stardust and precious stones, encased in Ancestral Treechnid Amber. The mixture can be quite explosive, so it is not recommended you try to make it yourself. Leave it to a jeweller you don''t like.');
INSERT INTO "item_descriptions" VALUES(7011,'en','This cloak is made of red beard hair... it is quite unique. Animated by extraordinarily powerful magic that renders it all but living, it adores playing practical jokes on the unfortunate bugger who puts it on. It''s favourite trick? It unfindably conceals itself when it senses you need it most. If you do ever manage to discipline it, it can be very powerful in fights. As the Wabbits like to say it''s a "weal good instwument of wawfawe".');
INSERT INTO "item_descriptions" VALUES(7012,'en','This amulet is, in fact, a candy. It might have been edible if it hadn''t been carefully rolled under female Bworker armpits for 36 generations as part of some bizarre ritual.');
INSERT INTO "item_descriptions" VALUES(7022,'en','This Staff belonged to Sangroku''s grandfather, Sangrokrane, famous for his big head. Legend says this magic staff has the ability to stretch to any length desired... use it to flatten your enemies or stick it down your pants, you''re always a winner with this thing.');
INSERT INTO "item_descriptions" VALUES(7029,'en','Sangroku ate way too many magic beans one time. Forever more, it was a constant struggle to restrain the winds of panic that erupted from his britches without the slightest warning... Those very same winds made him famous the length and breadth of Amakna.');
INSERT INTO "item_descriptions" VALUES(7031,'en','Poor Flooey lost his mind after a terrible fight against Many. Fortunately, his amulet didn''t suffer. It kept both its mesmerising properties and its laxative powers. Use with moderation.');
INSERT INTO "item_descriptions" VALUES(7034,'en','Passed down from generation to generation, this misshapen helmet was even worn by Crail himself. Many adventurers think it has mysterious powers. As with many divinities and modern heroes, the magical powers of this helmet have all the potency of a shoe.');
INSERT INTO "item_descriptions" VALUES(7037,'en','This stick used to belong to Granny Candy, one of the three famous Love Priestesses. Sharpened at one end and shiny at the other, this stick is renowned for its versatility and its annoying tendency to turn up just about anywhere. None can resist its power.');
INSERT INTO "item_descriptions" VALUES(7038,'en','This crown belonged to the famous King Jellix, renowned for his unbounded romanticism and his seductive power which left its mark on many female Jellies. Some even say he is the father of all the Jellies of the region of Amakna, proof (if needed) of his stamina and legendary fecundity.');
INSERT INTO "item_descriptions" VALUES(7039,'en','Famous Sunday fighter Frank crossed over into martial arts after he failed miserably at his stone-cutting apprenticeship.');
INSERT INTO "item_descriptions" VALUES(7040,'en','This bow belonged to Kuri, the famous Love Priestess and left-hand woman of Granny Candy. Never turn your back on a Love Priestess. One arrow from this bow is enough to tear your heart to shreds, or your arse if you have actually turned around.');
INSERT INTO "item_descriptions" VALUES(7043,'en','Legend says that this magnificent Dofus came out of the frozen hole of the Water dragon Aguabrial. Legend does not say if he had a cold that day, though it''s highly likely.');
INSERT INTO "item_descriptions" VALUES(7056,'en','This unique hat used to belong to a Xelor grandmaster, known the World over for his explosive theories and his incessant meddling with time. His death was as explosive and untimely as his life... Jealous of his neighbour''s hat, whose magic powers were said to be even greater than his, he rashly unleashed a Wind of Panic to remove it forever, forgetting about his own. He was blown into a million little pieces when his hat exploded like a giant firecracker.');
INSERT INTO "item_descriptions" VALUES(7058,'en','This headgear is made of dead dried Kralove leftovers. Be careful, it can come back to life if you use it as a bathing cap.');
INSERT INTO "item_descriptions" VALUES(7069,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7070,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7071,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7072,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7073,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7074,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7075,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7076,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7077,'en','This porous but absorbent yellow shield was made from the remains of a creature who used to live in a Pineapi Mask at the bottom of the sea.');
INSERT INTO "item_descriptions" VALUES(7078,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7079,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7080,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7081,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7082,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7083,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7084,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7085,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7086,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7087,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7088,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7089,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7090,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7091,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7092,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7093,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7094,'en','This shield has seen a few battles too many and in this state is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7097,'en','This shield is given to disciples who don''t know how to correctly use a shield yet. Its durability''s pretty questionable; it''s a good bet that it will fly apart into splinters before long.');
INSERT INTO "item_descriptions" VALUES(7102,'en','The Ice Knight was famous for being one of the greatest sword smiths in all of Amakna. Only the horrible, pitiless Liche refused to recognise his immense talent. Offended that such a creature wouldn''t stand in awe before his creations, the smith issued an ultimatum, refusing to forge so much as a teaspoon until his sword smith skills got the public recognition they deserved. But he hadn''t reckoned on the horrible Liche, who never gave in. A century or so later, the smith had to resign himself to going back to work... even though his skills had gotten rusty. This ridiculous sword was his last usable creation. The years passed by, and the sword''s true power was finally discovered. Shattered, the sword released an evil energy that did lasting damage to Liche''s economic activities. Mocked, provoked, humiliated and outsmarted, Liche feigned giving up, only to come back meaner than ever and exact humiliating revenge when the time was right.');
INSERT INTO "item_descriptions" VALUES(7103,'en','This wand was used to behead all the ninnies in Amakna. Suffice to say, it''s seen a lot of action. It''s interesting to note how much it resembles a staff or even a walking stick. It might even have been used to satisfy the wicked fantasies of the owner who named it. No one will ever have the final word on this sordid story.');
INSERT INTO "item_descriptions" VALUES(7104,'en','These Flee-Flops were used to practice various martial arts. Not quite revolutionary and artistically speaking, a failure, they were only good for running away, a bit like yourself.');
INSERT INTO "item_descriptions" VALUES(7106,'en','With this Larva head round your neck, you look like Stive Irween, the famous modern-day larva tamer.');
INSERT INTO "item_descriptions" VALUES(7107,'en','You probably never dreamt of putting your feet right inside the guts of a Larva... But here is your chance... Seize it!');
INSERT INTO "item_descriptions" VALUES(7108,'en','This plain bag used to be very fashionable a very long time ago. It is the best example of your ancestors'' bad taste.');
INSERT INTO "item_descriptions" VALUES(7109,'en','You finally have the chance to look like a real larva. You will be able to openly show the World your larval lifestyle.');
INSERT INTO "item_descriptions" VALUES(7110,'en','This terrific Wand is made of larva guts which are firstly dried, then enchanted and finally rehydrated. It''s totally shapeless. A bit like you, except you''re not even enchanted.');
INSERT INTO "item_descriptions" VALUES(7112,'en','Like a poem born of black ink and white paper, this Dofus was born from an island and a dragon. Is it just a dream, a paradox or an illusory reflection? Quite the contrary! It''s the fruit of two worlds and the symbol of their union. Through it, the Krosmoz contemplates you... or engulfs you.');
INSERT INTO "item_descriptions" VALUES(7113,'en','This Dofus is worryingly similar to a wild Dragoturkey egg. For once, appearances might not be misleading.');
INSERT INTO "item_descriptions" VALUES(7114,'en','As dark as darkness can be and as solid as a rock. The dragon who laid and egg like this one probably didn''t forget it in a hurry.');
INSERT INTO "item_descriptions" VALUES(7115,'en','The Ivory Dofus is incomparably white, which isn''t surprising given that Dardondakal the White Dragon whitened it with his breath every morning (an old trick passed on to him from his Dragon grandmother).');
INSERT INTO "item_descriptions" VALUES(7116,'en','The enchantment in this ring is very strange - once around your finger, the only person you''ll be able to talk to will be the jeweller who made it.');
INSERT INTO "item_descriptions" VALUES(7117,'en','A particularly talentless group of cosmopolitan minstrels used this type of ring to keep time at their shows after their original drummer left them. They would all put a ring on a toe, and beat in time. Needless to say, it was the percussion that always let them down.');
INSERT INTO "item_descriptions" VALUES(7118,'en','This big moth-shaped ring won''t make your hands pretty, but isn''t that a good thing?');
INSERT INTO "item_descriptions" VALUES(7119,'en','The jeweller who created this masterpiece is no relative of the famous sword smith, despite appearances. According to its creator, this ring is supposed to remind you of life in the bush without having to mind the shrubbery. No one has figured out what he was going on about yet.');
INSERT INTO "item_descriptions" VALUES(7120,'en','Contrary to common misunderstanding, this ring has nothing to do with the beautiful Karin, whose regular live shows at Sufokia Pirates'' Inn raised many a visiting spirit from the dead. The namesake of this jewel is a musician who breeds Tofus in his spare time... so what, you ask. Well, with this ring, it''ll sound like there''s a dying tofu attached to your finger.');
INSERT INTO "item_descriptions" VALUES(7121,'en','This living ring has a terrible curse that makes even the toughest of adventurers seriously ill. They say it was originally designed to heal the person who wore it, but since warriors brought it to the most disreputable locations in the land, its sense of dignity led it to become more and more dangerous and aggressive.');
INSERT INTO "item_descriptions" VALUES(7122,'en','This ring is made for tearful novices. It also symbolises some ancient, unspeakable traditions. It''s made for you! Perfect.');
INSERT INTO "item_descriptions" VALUES(7123,'en','For experienced adventurers only. It might shock your family and friends to know it''s composed of young, innocent creatures.');
INSERT INTO "item_descriptions" VALUES(7128,'en','Spiteful gossips claim that this ring is the most useful fashion accessory in the World. The wings attached to it can be quite a pain when you need to get a tissue out of your pocket. Now, Iops neither have tissues nor pockets... so, it''s just fine.');
INSERT INTO "item_descriptions" VALUES(7131,'en','Many other adventurers dreamt of getting their paws on this jewel long before you came along. Indeed, it''s said to have many powers, such as the power to turn fierce warriors into good-for-nothing dreamers. It says in my book to never put it near fire. Doesn''t say why.');
INSERT INTO "item_descriptions" VALUES(7132,'en','This ring owes its name to the last words pronounced by its creator: "O'' Ring Ami! You''re such a friend!" he said in a painful but bewitching rattle. It is interesting to note that this Bamboo ring was actually made before Bamboo evolved. Another mystery which will not be solved for another ten years or so!');
INSERT INTO "item_descriptions" VALUES(7136,'en','This medal used to belong to a famous Pandawa master at an old martial arts school who taught his disciples the principles of defence using their opponents'' strength. His school finally closed down because his opponents were no longer strong enough.');
INSERT INTO "item_descriptions" VALUES(7137,'en','This cape was made with just one goal in mind: it had to be able to keep its owner awake for a few days running. The results were outstanding! The Cape Huccino is so rigid that it will keep you upright no matter what. Just don''t expect to be able to bend over and tie your shoelaces.');
INSERT INTO "item_descriptions" VALUES(7138,'en','Worn by the most important people in the World, this cloak is famous for its legendary softness which means you don''t have to put on underwear in the warm season. An elegant way to expose yourself...');
INSERT INTO "item_descriptions" VALUES(7139,'en','Sula the shoemaker loved strolling in the fields, looking for improbable love. Instead of finding her soul mate, she fell into a huge ditch full of filth near the Pig Zone and died. Her body was found seventy years later, when they finally emptied the ditch. Her brother apparently said, "We all have to go sometime," and them promptly fell into the ditch himself.');
INSERT INTO "item_descriptions" VALUES(7140,'en','Contrary to appearances, Xena was not a warrior, but a shoemaker. Her generous figure and her unlimited passion for housework strongly suggested a brilliant career in the inns of Amakna. But it wasn''t to be.');
INSERT INTO "item_descriptions" VALUES(7141,'en','This strange hat will protect you from sun beams, especially when its dark. Be careful though, every thirty years it comes to life and tries to suffocate its owner... It doesn''t say when the last time... I wouldn''t worry about it.');
INSERT INTO "item_descriptions" VALUES(7142,'en','This hat was used by some Xelors to hide their hereditary baldness. Enutrofs used it to hide their wives'' faces. In fact, the only male syndrome it doesn''t treat is prostate cancer.');
INSERT INTO "item_descriptions" VALUES(7143,'en','The Solomonk hat was worn by the Chief of a Pandawa tribe. Experts in laxative potions, low-ranking Pandawas were often obliged to test the potions for the alchemists. When banished to the jungle for these trials, this hat doubled as a chamber pot, reducing their load considerably.');
INSERT INTO "item_descriptions" VALUES(7144,'en','This wedding hat has long gone out of fashion, since its lace is no longer considered stylish. If it were recycled into knickers, it might still get a reaction out of a weary Chafer.');
INSERT INTO "item_descriptions" VALUES(7145,'en','Gaddie, a strange creature from an imaginary World, always stood out for its incredible cunning, its total aversion to plants and its ability to fast for days on end in times of war. A creature that''s complex to understand was obviously impossible to control. It was abandoned in the depths of the bottomless Kruup mine where its only friend was an old, Gobbly devouring Liche.');
INSERT INTO "item_descriptions" VALUES(7146,'en','This headgear looks like any old wig, but it is powerful indeed. It has one prior owner who had the strange and despicable habit of dressing up as other people, and conning the elderly into signing over items of tiny value. Once he convinced a gentle old man that he was his dead wife returned to life, proceeded to ''remarry'' him, had six of his children (which even I can''t explain) and then, ten years later, just as they were about to renew their vows on a scenic cliffside, he broke the news. It is said he ran off with three party poppers and a half-eaten ball of Stracciatella ice cream, laughing wildly... still laughing as he tripped and fell over the cliff and laughing to this day if you believe the popular but unlikely sea shanty, ''The crazy fool took my Stracciatella''.');
INSERT INTO "item_descriptions" VALUES(7150,'en','This hat, strangely named, belonged to a poor Ecaflip who became mute after a traumatic event. An artist through and through, he was compelled to follow a Brewer training. When he turned 14, he drowned in a barrel of beer and tears. Fortunately, beer was not wasted as the priest who was in charge of the funeral fell into an alcoholic coma for many years before he could take his office right where he had stopped it.');
INSERT INTO "item_descriptions" VALUES(7151,'en','On the box of this helmet, it said: ''This imposing clay helmet will turn you into a giant with a head of clay''. Upon further inspection, you realise the helmet is not made of clay, but of lead. Every year, many adventurers die, trapped under this helmet like nipples under a Chinese fire cup.');
INSERT INTO "item_descriptions" VALUES(7152,'en','This basin-shaped hat was used by the firemen of Amakna when there were fires on cereal fields. Nowadays it is mainly used by brewers and pub waitresses who are treated like walking barrels.');
INSERT INTO "item_descriptions" VALUES(7153,'en','This huge hammer makes a very loud noise when hitting a Iop''s skull as it tends to amplify sound. As surprising as it is effective.');
INSERT INTO "item_descriptions" VALUES(7154,'en','This light hammer is designed for small beings. Xelors used to find great pleasure in squashing Arachnees with this implement. Its use quickly changed and it became a little toy for young Iop Handymen.');
INSERT INTO "item_descriptions" VALUES(7155,'en','For fifty long years, the famous Captain Haddock''n''roll used this terrible Hammer to slay anyone who got in his way – including women and children. In spite of his legendary bad temper and his addiction to alcohol, he won the respect of all warriors – both friend and enemy.');
INSERT INTO "item_descriptions" VALUES(7156,'en','This rusty hammer is perfect for all your smashing needs - pulverising maple trees, atomising Moskitos, this hammer can do it it all.');
INSERT INTO "item_descriptions" VALUES(7157,'en','This hammer was used to sound the bell of the Church of Amakna every Sunday. In these times of war, it''s used much more often than that.');
INSERT INTO "item_descriptions" VALUES(7158,'en','This hammer was crafted by a famous alchemist during his sentence in the prison of Brakmar. He planned to steal his competitors'' secrets and get rich when he got out. This hammer was the first in a collection of devilish instruments.');
INSERT INTO "item_descriptions" VALUES(7159,'en','As the Enutrof philosopher Traincartes once said, "I think, therefore I hammer." It sums up the way this greedy bunch sees the World.');
INSERT INTO "item_descriptions" VALUES(7160,'en','Many ages ago, this Bow was occupied with a very dark magic, a mysterious force that strikes fear into both its owners and its targets in equal measure.');
INSERT INTO "item_descriptions" VALUES(7161,'en','This bow was mainly used to hunt Plain Boars. Indeed, it is so powerful that it can kill several young boars with one single arrow, provided that they stand still in a line. Well it could happen!');
INSERT INTO "item_descriptions" VALUES(7162,'en','This Bow belonged to an independent group of Minstrels mainly famous for their war cries which destroyed their enemies'' ear drums. They were firstly banished to Pandala, but after driving generations of Pandawa nuts, they were finally brought to the Great Sorlok to be slowly digested for more than 752 years.');
INSERT INTO "item_descriptions" VALUES(7163,'en','This bow was used as a dissuasive weapon. The owner of the Runaway Bow claimed that he was using poisoned arrows so any cowards he met would take off instantly.');
INSERT INTO "item_descriptions" VALUES(7164,'en','Light and fragile, this bow appeals to adventurers who are more concerned about appearances than substance.');
INSERT INTO "item_descriptions" VALUES(7165,'en','This explosive wand was dipped into the lava of an erupting volcano before being sculpted, and then enchanted. It goes without saying that it''s very powerful, despite its ridiculous appearance.');
INSERT INTO "item_descriptions" VALUES(7167,'en','The craftsman who created this wand had many apprentices. He made them work all day long. He was supposed to teach them the tricks of the trade but as it turned out, he was a terrible teacher. He always started sentences but never finished them.');
INSERT INTO "item_descriptions" VALUES(7168,'en','Once sculpted, this wand was soaked in beer for many decades ''to put a few magical powers into it'', as the people who made it said. Unfortunately, it started to rot, but it has a few magical properties... it can lure worms to the earth''s surface for example. Are you into fishing by any chance?');
INSERT INTO "item_descriptions" VALUES(7169,'en','Ideal for lighting a fire, or indeed lighting up a dreary party. With this wand, you just might get the chance to shine once in your life. An opportunity not to be missed.');
INSERT INTO "item_descriptions" VALUES(7170,'en','Creizy the pastry chef was nuts... he married Stufh the Lumberjane and choked her to death the very next day with his fat-stuffed pastries. Ever since, the phrase "Creizy Stufh" is used to express an unhappy surprise after a great celebration.');
INSERT INTO "item_descriptions" VALUES(7171,'en','The designer of this wand kept forgetting to pick his kids up at school. Conscious of his absent-mindedness, he sculpted a wand that would come to life everyday and remind him to pick his kids up. After a while, he kept thinking the wand was waking him up to remind him to go to the bathroom. His children were taken away from him not long after.');
INSERT INTO "item_descriptions" VALUES(7172,'en','This magic wand is still used today to empty septic tanks, clean out ditches and pick noses. Most informed sculptors will tell you that it derives all its magic from all the filthy waste it''s been dragged through... in reality, it''s the dirty gunge from your snout.');
INSERT INTO "item_descriptions" VALUES(7173,'en','This terrific Wand can wrap itself round your opponent''s neck and strangle them slowly but surely. An original and distinguished way of killing enemies you don''t respect.');
INSERT INTO "item_descriptions" VALUES(7174,'en','This cloak is essential if you want to practise the art of Pandawushu.');
INSERT INTO "item_descriptions" VALUES(7176,'en','Frank, a master staff carver, was the fellow who created this little wonder. It can darken the sky with raging clouds and draw the blood of your enemies, even if they don''t have any. Legend says it took him nine years to carve. Even your enemies will have to compliment you on this beautifully crafted weapon.');
INSERT INTO "item_descriptions" VALUES(7177,'en','With this Pandawushu Headband around your skull, you''ll be able to scare away young Lenalds pretending to be martial arts Masters. Don''t forget to bawl a bit of a war cry to be more convincing.');
INSERT INTO "item_descriptions" VALUES(7178,'en','If it wasn''t for the incessant arguing over whether this thing is a fruit or a root, it would be an excellent weapon.');
INSERT INTO "item_descriptions" VALUES(7181,'en','Red was a young Sadidette. She loved singing, though she had a terrible voice. She always dreamt of travelling to Chili. She was often sent packing but never got anywhere...');
INSERT INTO "item_descriptions" VALUES(7182,'en','Mel was quite unlucky. Her husband was a lazy cad, incapable of assuming his status as the head of the family. She was convinced that incessant nagging was the way to go. "You''ll get no strawberry jelly if you don''t go harvest that barley" or "You''ll get no tobacco till you''ve sheared those Gobballs" and so on. Obviously, this story has nothing to do with this very powerful root, unless it starts to nag you too.');
INSERT INTO "item_descriptions" VALUES(7183,'en','This Root has a purity that is the essence of perfection for some wide-eyed craftsmen. I can tell you from experience that this root is the single greatest cause of marital breakdown in the entire region.');
INSERT INTO "item_descriptions" VALUES(7184,'en','This terrible root is mainly known for its capacity to provoke climatic disasters at the exact place where it''s been used. Avoid using it to kick your enemies around. It is an abuse which could see you and all your friends burnt to a crisp, drowned in a flood, blown to bits, frozen solid, misted to... well the last one wouldn''t be so bad, but just don''t use it okay!');
INSERT INTO "item_descriptions" VALUES(7185,'en','Using this root during a fight is supposed to be very easy. Nevertheless, it can happen that the root somehow comes to life and does whatever it wants... that''s generally when the owner yells "This is not the usual Root ''Een, is it?". Well, it is indeed the usual Root ''Een.');
INSERT INTO "item_descriptions" VALUES(7187,'en','This bow is reviled the land over for leading its archers into battle at the slightest sign of unusual behaviour. Drinking loudly, shaking hands for longer than is proper, and wearing hats - a few examples of what can make the bow start shooting wildly.');
INSERT INTO "item_descriptions" VALUES(7188,'en','These Daggers are often used for cutting lemons, or the ground right out from under your enemies'' feet. An original way to surprise them which often comes to a messy end.');
INSERT INTO "item_descriptions" VALUES(7189,'en','This strange staff is an improved version of the famous God Rod. Indeed, this staff was designed and made according to the numerous tests done on the God Rod by the Love Priestesses. This model was even used by Kuri herself, which makes it a unique piece.');
INSERT INTO "item_descriptions" VALUES(7190,'en','When a precocious Sramette princess couldn''t find a single dagger that suited her, she offered a challenge to the dagger smiths of Amakna: the one who forged her a set capable of killing a Tofu in one blow would spend three nights in her bed. Unfortunately, not a single smith took up her challenge. By the time she found a willing craftsman, a retiree of the trade who never should have started in the first place, she''d been advertising her offer among other things on the streets of Madrestam for 17 years. Let''s just say that time hadn''t been kind to the proud Sramette.');
INSERT INTO "item_descriptions" VALUES(7191,'en','Ramougre was an old Sram who became a jewellery master. He used this setter to perfect his creations as well as to murder his clients when he got bored. He was known for his bad temper, sometimes destroying his setter and his most beautiful creations. Today, when people with these daggers get angry, they pay tribute to Ramougre by cutting off some family jewels.');
INSERT INTO "item_descriptions" VALUES(7192,'en','Grizmine never succeeded in properly using this Claw - he was always too drunk.');
INSERT INTO "item_descriptions" VALUES(7193,'en','No one but Dark Vlad himself can use this sword properly, but if you carry it round town at least people will know you''re not one of those pathetic fools who died under its blade.');
INSERT INTO "item_descriptions" VALUES(7194,'en','This bow proves that collaboration between technology and magic can lead to excellent results. This bow was quickly forgotten for some strange reason and its creator, Arkanum, had to close down his store.');
INSERT INTO "item_descriptions" VALUES(7195,'en','This legendary sword was forged early one morning by a drunken Enutrof army, deep in the mines of Grimoth. It has a very powerful aura as well as a potent hum of beer.');
INSERT INTO "item_descriptions" VALUES(7197,'en','This hammer was used to break chocolate blocks into dust for so many years, it eventually gained a delicious flavour. One more reason to give your enemies a taste!');
INSERT INTO "item_descriptions" VALUES(7198,'en','Any old Enutrof will tell you that a well-maintained beard is every woman''s dream. This razor is so sharp it''ll even take care of that thick, curly back hair.');
INSERT INTO "item_descriptions" VALUES(7199,'en','This sword belonged to a butcher called Franky Abatz who used it to disembowel his enemies for sausage meat. I used to go to that stall... Believe me, I made sure the dirty mongrel paid for every sausage he ever sold.');
INSERT INTO "item_descriptions" VALUES(7200,'en','This magnificent sabre is used by Pandawushuka disciples when they reach the Shodanwa level alive.');
INSERT INTO "item_descriptions" VALUES(7201,'en','This magnificent Sabre is used by Pandawushuka disciples when they reach the Nidanwa level alive.');
INSERT INTO "item_descriptions" VALUES(7202,'en','This magnificent sabre is used by Pandawushuka disciples when they reach the Sandanwa level alive.');
INSERT INTO "item_descriptions" VALUES(7203,'en','This magnificent sabre is used by Pandawushuka disciples when they reach the Yondanwa level alive.');
INSERT INTO "item_descriptions" VALUES(7204,'en','This Staff is normally used by Pandawushuka disciples when they reach Shodanwa level without losing the use of their arms in the process.');
INSERT INTO "item_descriptions" VALUES(7205,'en','This Staff is normally used by Pandawushuka disciples when they reach the Nidanwa level without losing the use of their arms in the process.');
INSERT INTO "item_descriptions" VALUES(7206,'en','This Staff is normally used by Pandawushuka disciples when they reach the Sandanwa level without losing the use of their arms in the process.');
INSERT INTO "item_descriptions" VALUES(7207,'en','This Staff is normally used by Pandawushuka disciples when they reach the Yondanwa level without losing the use of their arms in the process.');
INSERT INTO "item_descriptions" VALUES(7208,'en','This Axe is used by Pandawushuka disciples when they reach the Shodanwa level. It makes short work of Bamboo Forests, including anything that may be hiding in the undergrowth.');
INSERT INTO "item_descriptions" VALUES(7209,'en','This Axe is used by Pandawushuka disciples when they reach the Nidanwa level. It makes short work of Bamboo Forests, including anything that may be hiding in the undergrowth.');
INSERT INTO "item_descriptions" VALUES(7210,'en','This Axe is used by Pandawushuka disciples when they reach the Sandanwa level. It makes short work of Bamboo forests, including anything that may be hiding in the undergrowth.');
INSERT INTO "item_descriptions" VALUES(7211,'en','This axe is used by Pandawushuka disciples when they reach the Yondanwa level. It makes short work of Bamboo forests, including anything that may be hiding in the undergrowth.');
INSERT INTO "item_descriptions" VALUES(7212,'en','Equipped with this light and elegant axe you''ll be able to progress more easily through the bamboo forests of Pandala. It will serve as sufficient protection against the warlike Pandis who never get tired of attacking lone lumberjacks who wander through their lands.');
INSERT INTO "item_descriptions" VALUES(7213,'en','This Shovel is supposed to cut through the soil at an incredible speed. Those who know how to handle it usually split their enemies'' skulls open instead.');
INSERT INTO "item_descriptions" VALUES(7214,'en','These Sandals belonged to the Macians, an Ouginak tribe. They were so close to the Pandawas that, as the generations passed by, their fur slowly changed colour, becoming white speckled with black. One day, they were all killed by a horrible woman who wanted to make a coat out of them.');
INSERT INTO "item_descriptions" VALUES(7215,'en','These thong sandals were formerly used by female Pandits to seduce lost adventurers and lure them into traps.');
INSERT INTO "item_descriptions" VALUES(7216,'en','Those sandals are given to sick Pandawas for those special emergencies... we''re talking the dreaded McSheth, which usually comes a knocking when they drink too much down at the Inn.');
INSERT INTO "item_descriptions" VALUES(7217,'en','Pandawas have always been attracted by alcoholic beverages. As time went by, they discovered how best to conserve and flavour them. These sandals were made especially for alcoholic Pandawas. They''re ballasted at the sole so that you can keep your feet firmly on the ground, most of the time. Good for fighting, terrible for running away.');
INSERT INTO "item_descriptions" VALUES(7218,'en','Adin was a young Pandawa who loved collecting lamps, but he was far from being a genius.');
INSERT INTO "item_descriptions" VALUES(7219,'en','Those sandals were awarded to young Pandits at the end of religious rituals. Nowadays they are mainly used for tap-dancing championships.');
INSERT INTO "item_descriptions" VALUES(7221,'en','Tanukouï Sans wear this collar from early childhood. Given what these monsters are capable of, it''s no wonder this jewellery is so valuable.');
INSERT INTO "item_descriptions" VALUES(7226,'en','From a distance, you''ll look like a Pandawushuka from Akwadala Village wearing this hat. Up close, you''ll look like an idiot.');
INSERT INTO "item_descriptions" VALUES(7227,'en','From a distance, you''ll look like a Pandawushuka from Terrdala Village wearing this hat. Up close, you''ll look like an idiot.');
INSERT INTO "item_descriptions" VALUES(7228,'en','From a distance, you''ll look like a Pandawushuka from Feudala Village wearing this hat. Up close, you''ll look like an idiot.');
INSERT INTO "item_descriptions" VALUES(7229,'en','From a distance, you''ll look like a Pandawushuka from Aerdala Village wearing this hat. Up close, you''ll look like an idiot.');
INSERT INTO "item_descriptions" VALUES(7230,'en','This cloak comes from Akwadala. It can be used as a doormat or even as a floorcloth if you''ve just come out of water.');
INSERT INTO "item_descriptions" VALUES(7231,'en','This cloak comes from Terrdala Village. It can be used as a doormat or even as a towel if you''ve just come out of the water.');
INSERT INTO "item_descriptions" VALUES(7232,'en','This cloak comes from Feudala. It can be used as a doormat or even as a towel if you''ve just come out of the water.');
INSERT INTO "item_descriptions" VALUES(7233,'en','This cloak comes from Aerdala. It can be used as a doormat or even as a floorcloth if you''ve just come out of water.');
INSERT INTO "item_descriptions" VALUES(7234,'en','This shield has seen a few battles too many and in this state it is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7235,'en','This shield has seen a few battles too many and in this state it is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7236,'en','This shield has seen a few battles too many, and in this state, is good for nothing. Perhaps Bouwada, in Pandala village, could replace it for you.');
INSERT INTO "item_descriptions" VALUES(7237,'en','This shield has seen a few battles too many and in this state it is good for nothing. Bouwada, in Pandala village, might be able to replace it for you.');
INSERT INTO "item_descriptions" VALUES(7238,'en','Pandawas from Akwadala always watch their figure. If you tighten this belt as much as possible, you should finally get some results with your flabby belly problem.');
INSERT INTO "item_descriptions" VALUES(7239,'en','Pandawas from Terrdala always watch their figure. If you tighten this belt as much as possible, you should finally get some results with your flabby belly problem.');
INSERT INTO "item_descriptions" VALUES(7240,'en','Pandawas from Feudala always watch their figure. If you tighten this belt as much as possible, you should finally get some results with your flabby belly problem.');
INSERT INTO "item_descriptions" VALUES(7241,'en','Pandawas from Aerdala always watch their figure. If you tighten this belt as much as possible, you should finally get some results with your flabby belly problem.');
INSERT INTO "item_descriptions" VALUES(7242,'en','These wooden getas were made by the best shoemaker in the village of Akwadala. Let your warts take a breath of fresh air and enjoy the landscape.');
INSERT INTO "item_descriptions" VALUES(7243,'en','These wooden getas were made by the best shoemaker in the village of Terrdala. Let your warts take a breath of fresh air and enjoy the landscape.');
INSERT INTO "item_descriptions" VALUES(7244,'en','These wooden getas were made by the best shoemaker in the village of Feudala. Let your warts take a breath of fresh air and enjoy the landscape.');
INSERT INTO "item_descriptions" VALUES(7245,'en','These wooden getas were made by the best shoemaker in the village of Aerdala. Let your warts take a breath of fresh air and enjoy the landscape.');
INSERT INTO "item_descriptions" VALUES(7246,'en','This Wedding Ring comes from Akwadala Village. Closer to a lucky charm than a magic relic, you''ll still be able to make your friends believe you''ve found your soul mate.');
INSERT INTO "item_descriptions" VALUES(7247,'en','This Wedding Ring comes from Terrdala Village. Closer to a lucky charm than a magic relic, you''ll still be able to make your friends believe you''ve found your soul mate.');
INSERT INTO "item_descriptions" VALUES(7248,'en','This Wedding Ring comes from Feudala Village. Closer to a lucky charm than a magic relic, you''ll still be able to make your friends believe you''ve found your soul mate.');
INSERT INTO "item_descriptions" VALUES(7249,'en','This Wedding Ring comes from Aerdala Village. Closer to a lucky charm than a magic relic, you''ll still be able to make your friends believe you''ve found your soul mate.');
INSERT INTO "item_descriptions" VALUES(7250,'en','The only people allowed to wear this amulet were the inhabitants of the village of Akwadala, as it was considered to be one of the most important parts of their traditional costume. Seen close up, you have to ask yourself why.');
INSERT INTO "item_descriptions" VALUES(7251,'en','The only people allowed to wear this amulet were the inhabitants of the village of Terrdala, as it was considered to be one of the most important parts of their traditional costume. Seen close up, you have to ask yourself why.');
INSERT INTO "item_descriptions" VALUES(7252,'en','The only people allowed to wear this amulet were the inhabitants of the village of Feudala, as it was considered to be one of the most important parts of their traditional costume. Seen close up, you have to ask yourself why.');
INSERT INTO "item_descriptions" VALUES(7253,'en','The only people allowed to wear this amulet were the inhabitants of the village of Aerdala, as it was considered to be one of the most important parts of their traditional costume. Seen close up, you have to ask yourself why.');
INSERT INTO "item_descriptions" VALUES(7254,'en','This staff was used to give young boisterous Pandawa a trashing. Three raps on the knuckles, fifteen lashes across the back, sixty blows to the head, two pokes in the eyes, that would be enough to calm them down a bit.');
INSERT INTO "item_descriptions" VALUES(7255,'en','This axe was designed for one thing only: cutting living beings. So be careful, as a single miscalculation and you could be cut in half!');
INSERT INTO "item_descriptions" VALUES(7256,'en','As sharp as Moowolf claws, these daggers will turn you into a perfect apprentice assassin.');
INSERT INTO "item_descriptions" VALUES(7257,'en','This Sabre was forged by Hotari Honza himself. It''s said to be one of his last creations before he took an intensive cooking course and became a chef. A collector''s item for sure!');
INSERT INTO "item_descriptions" VALUES(7339,'en','This Kitsou cap can only be worn by adventurers who''ve lost their sense of smell. Don''t ask me why.');
INSERT INTO "item_descriptions" VALUES(7340,'en','This wrap is river-washable, even though it might fade after the third cycle.');
INSERT INTO "item_descriptions" VALUES(7341,'en','This small Kitsou ring will protect you from casual troubles.');
INSERT INTO "item_descriptions" VALUES(7342,'en','This Kitsou Amulet will draw attention to your double chin.');
INSERT INTO "item_descriptions" VALUES(7368,'en','The designer of this wand wanted to use it to destroy the shooting stars that kept him awake at night. The legend goes that one night, as he left the tavern after one too many, he decided to test the wand, but mistook the moon for a shooting star. The wand, which really was incredibly powerful, split the moon clean in two, and one of the halves fell into the middle of the Asse Sea, thus creating Moon Island as we know it today. Another little anecdote he can tell the grandkids...');
INSERT INTO "item_descriptions" VALUES(7414,'en','This fluffy ball of hair scratches, bites, and pinches everything that comes close, including the hand that feeds it! It''s a terrifying yet irresistibly likeable and fascinating creature.');
INSERT INTO "item_descriptions" VALUES(7415,'en','This pet''s pleasant company more than makes up for its breath, which smells strongly of dried fish.');
INSERT INTO "item_descriptions" VALUES(7513,'en','Titude, a modest Enutrof shoemaker, was even smaller than a Xelor. Legend says he created these sandals to be able to kiss his lady-love, a legless Eniripsa, on the lips.');
INSERT INTO "item_descriptions" VALUES(7514,'en','Harry was an old wise man who spent his days fishing on the docks of Sufokia. His great moustache made him look like Danous Kwaide, famous actor of a theatre company that used to play at the Amakna Tavern. All this was only a prelude to incredible beer and meat ball orgies.');
INSERT INTO "item_descriptions" VALUES(7515,'en','This cape is not from our galaxy, yet it seems similar in color to your gobbly-wool fishnet stockings.');
INSERT INTO "item_descriptions" VALUES(7516,'en','It was an old, unlucky, bitter Enutrof who first discovered this terrible hat, hidden at the bottom of a crevasse in the Bimd''Oule Caverns. Later, the Enutrof exiled himself far away from the lands of Amakna to escape boredom and discover new horizons. Legend tells that he comes back to his native land once a century to make fun of his old friends... but we all know he''s just a bit nostalgic.');
INSERT INTO "item_descriptions" VALUES(7518,'en','This surprising creature comes from the afterlife and is not willing to go back there unless it takes you with it.');
INSERT INTO "item_descriptions" VALUES(7519,'en','This little dragon''s skin is as pink as a bodacious Bwork''s backside, making it a risk-free and cheap thing to fantasise about, or just a nice reminder of happy times. Luckily for the dragon, it''s not just something for you to lust after. It is also a very wise and powerful creature. A word of warning, however: its hunger for other pets is as great as a Chafer''s wickedness during a full moon.');
INSERT INTO "item_descriptions" VALUES(7520,'en','A retired toy soldier, this metal creature suddenly came to life one day. It will follow you everywhere you go, risking its life to save yours. Don''t expect it to fight your fights for you, though – it won''t be replacing the low-level adventurers of Astrub anytime soon.');
INSERT INTO "item_descriptions" VALUES(7522,'en','Tamed and cleaned, this baby Minotoror can be approached and petted without fear of losing fingers or hands. Don''t let down your guard, though, as sometimes nature can reclaim control, and the creature''s destructive instincts will take over just when you need its help most. To avoid such nasty surprises, raise it like a child in need of a very strict education.');
INSERT INTO "item_descriptions" VALUES(7523,'en','This adorable ginger creature loves getting up at dawn to stroll about in the orange glow of the rising sun. Blessed by the goddess Nixie, it can eat absolutely unbelievable quantities of croquettes without gaining a single pod.');
INSERT INTO "item_descriptions" VALUES(7524,'en','This surprising creature is the result of crossbreeding a White Bow Meow and a Black Bow Meow.');
INSERT INTO "item_descriptions" VALUES(7552,'en','Sometimes, when true love joins a warrior and a Dragoturkey, weird things can happen.
This cape proves is living proof of that, since there are Dragoturkey wings sewn onto it. The Dragoturkey sacrificed itself for the making of this cape, offered to Lonne Jenone, the famous minstrel, on their wedding day. Apparently, Jon Lemon even wrote a song about it.');
INSERT INTO "item_descriptions" VALUES(7553,'en','If you ever dreamt of looking like a turkey, this is your chance! However, if you want to remain healthy, we advise you not to wear this hat on the streets of Amakna during the Christmas season.');
INSERT INTO "item_descriptions" VALUES(7554,'en','Your friends are definitely going to be jealous. Those boots will take you all the way to the ambassador''s party for one of those wonderful little golden chocolates.');
INSERT INTO "item_descriptions" VALUES(7555,'en','Gobble, gobble.');
INSERT INTO "item_descriptions" VALUES(7559,'en','Legend has it that the very first owner of this belt used to spin round and round every time he put it on.');
INSERT INTO "item_descriptions" VALUES(7680,'en','This hat is a piece of the head of Ougaa, a very important deity worshipped by the Porcos. Padded with fabric, feathers and wool, anyone can wear this headgear, provided that they can stand the smell and the weight of it.');
INSERT INTO "item_descriptions" VALUES(7703,'en','This sombre avian is especially renowned for its love of cemeteries and white-skinned adventurers. It loves using its huge beak to break bones found in graves.');
INSERT INTO "item_descriptions" VALUES(7704,'en','This squirrel is a real acorn twister. It''ll tickle your monkey nuts one minute and break ''em the next.');
INSERT INTO "item_descriptions" VALUES(7705,'en','This magnificent creature is somehow related to the famous Lenalds from the Wabbit Islands. More reckless and a lot more unruly, it will help you in combat but will prove incredibly deceitful if you don''t treat it well.');
INSERT INTO "item_descriptions" VALUES(7706,'en','Bilby, short for Bilbiblabaloo, is a little jelly in search of big adventures. Especially fond of Vald, it has remarkable powers (for its size, of course).');
INSERT INTO "item_descriptions" VALUES(7707,'en','This wild little piggy has an immeasurably large snout, particularly suited to sniffing out big acorns. By chance, it seems to have found you quite easily.');
INSERT INTO "item_descriptions" VALUES(7708,'en','This little Piwin is far from being a Piwi – one look at its colour should tell you that much. However, it shares the same inexplicable interest in pecking posteriors. Apparently some even enjoy it...');
INSERT INTO "item_descriptions" VALUES(7709,'en','This little Piwin is far from being a Piwi – one look at its colour should tell you that much. However, it shares the same inexplicable interest in pecking posteriors. Apparently some even enjoy it...');
INSERT INTO "item_descriptions" VALUES(7710,'en','This little Piwin is far from being a Piwi – one look at its colour should tell you that much. However, it shares the same inexplicable interest in pecking posteriors. Apparently some even enjoy it...');
INSERT INTO "item_descriptions" VALUES(7711,'en','This little Piwin is far from being a Piwi – one look at its colour should tell you that much. However, it shares the same inexplicable interest in pecking posteriors. Apparently some even enjoy it...');
INSERT INTO "item_descriptions" VALUES(7712,'en','This little Piwin is far from being a Piwi – one look at its colour should tell you that much. However, it shares the same inexplicable interest in pecking posteriors. Apparently some even enjoy it...');
INSERT INTO "item_descriptions" VALUES(7713,'en','This little Piwin is far from being a Piwi – one look at its colour should tell you that much. However, it shares the same inexplicable interest in pecking posteriors. Apparently some even enjoy it...');
INSERT INTO "item_descriptions" VALUES(7714,'en','Rumour has it this turtle was raised by a Martial Arts Master who resembled a Grossewer Rat.');
INSERT INTO "item_descriptions" VALUES(7754,'en','Laid by Terrakourial the Earth Dragon, this Dofus contains considerable powers and shouldn''t be given to just anyone.');
INSERT INTO "item_descriptions" VALUES(7880,'en','This Amulet was worn by adventurers who said they wanted to make tea, not war. Each to their own.');
INSERT INTO "item_descriptions" VALUES(7881,'en','This ring will enable you to cause even more pain when doling out those well-deserved spankings to your little darlings.');
INSERT INTO "item_descriptions" VALUES(7882,'en','This hammer is great for expressing your pacifism... all over your enemy''s face.');
INSERT INTO "item_descriptions" VALUES(7883,'en','Stuffed with Gobkool wool, these boots are just fantastic. Light and warm for the cold season and cool for the hot one, they will please even the pickiest of adventurers.');
INSERT INTO "item_descriptions" VALUES(7884,'en','If you''re the kind of person who always thinks positive, this cape is made for you. It''s so thick and comfy that it can be used as an improvised bed when you feel extremely sleepy. Its smoked Kaliptus odour even repels insects and other unwanted creatures.');
INSERT INTO "item_descriptions" VALUES(7885,'en','Wrapped around your hips, this belt will give you the appearance of a peace-loving adventurer. This enables you to surprise your enemies with a dagger in their back.');
INSERT INTO "item_descriptions" VALUES(7886,'en','Let''s be honest, as headwear goes, this cap is about as fashionable as a mullet hairdo. You never know though, look what happened to drainpipe jeans.');
INSERT INTO "item_descriptions" VALUES(7887,'en','This headgear once belonged to the famous Koolich, renowned for his clay feet and his legendary good mood.');
INSERT INTO "item_descriptions" VALUES(7888,'en','The Koolich uses this bag to keep his Kaliptus leaves fresh or to suffocate Koalaks that are a bit too enterprising.');
INSERT INTO "item_descriptions" VALUES(7889,'en','These boots used to belong to the Koolich - even if you can''t tell, you can smell! These boots are so comfortable that you''ll almost forget how miserable your existence is.');
INSERT INTO "item_descriptions" VALUES(7890,'en','This staff is really an emptied bone of one of the Koolich''s ancestors. Pierced on both ends, it can be used as a Kaliptus pipe but also as a shepherd''s stick. Ahhhh... sticks, eh! What would we do without them?');
INSERT INTO "item_descriptions" VALUES(7891,'en','This little Wabbit is in fact a bastard son of the notorious Wa Wabbit. Maybe one day it''ll get to wear its father''s crown.');
INSERT INTO "item_descriptions" VALUES(7892,'en','Willy Peninzias is a nasty creature indeed, and seems to have had a very tough childhood. Count on it to follow you around and scare your friends away.');
INSERT INTO "item_descriptions" VALUES(7902,'en','An old legend extracted from the famous old book titled "Everything You Need To Know About Women" says that this belt once belonged to a golden lady, a lot more interested in wealth than in power. In the non-censored version of this book, we also learn that she was keen on cracking dirty jokes. I guess she wasn''t that different from most women.');
INSERT INTO "item_descriptions" VALUES(7911,'en','This little Koalak seems harmless, but that''s far from the truth. Tortured when it was young, it frequently received boomerangs in the face, or even the bum. It has positively loathed boomerangs ever since, and has an appetite for violence rivalled only by your own thirst for blood.');
INSERT INTO "item_descriptions" VALUES(7913,'en','This mysterious item, forgotten by the World, used to belong to a great magus. People say it gives you the ability to speak to certain animals.');
INSERT INTO "item_descriptions" VALUES(7921,'en','This crown is almost impossible to hold... No surprise, it belongs to the Royal Tofu! Doesn''t seem to suit your small head, though. I think it just might be out of your league. LOSER!!!');
INSERT INTO "item_descriptions" VALUES(8000,'en','This small creature is a Bwork that was locked inside a jar for several decades. It took the shape of the jar as it grew, and will now be a dwarf the rest of its life. Its legendary good humour makes it the perfect companion when you know you''re going to die soon, or for boisterous social occasions.');
INSERT INTO "item_descriptions" VALUES(8003,'en','This amulet does not look like any other amulet, simply because no other amulet looks like it.');
INSERT INTO "item_descriptions" VALUES(8004,'en','This beautiful ring is worn by the most foolhardy of all Koalaks... the ones who stole it in Astrub.');
INSERT INTO "item_descriptions" VALUES(8005,'en','This bow enables you to steal your opponents'' life and sometimes, to steal your opponents from life. (Don''t spend too long trying to understand, that doesn''t mean anything.)');
INSERT INTO "item_descriptions" VALUES(8006,'en','These boots are in fact real Koalak feet that were brutally pulled off their owners, then emptied of their content before being padded with Koalak hairs. Both terrifying and attractive, these boots will make you the terror of Astrub.');
INSERT INTO "item_descriptions" VALUES(8007,'en','This cloak will protect you from most attacks, but not from being ridiculous.');
INSERT INTO "item_descriptions" VALUES(8008,'en','This Kaliptus leaf belt diffuses a delightful smell that will hide all others. Besides, this belt is perfect for hiding your chubbiness.');
INSERT INTO "item_descriptions" VALUES(8009,'en','This headgear is adorned with huge Koalak ears which can amplify any sound within hearing distance. Be careful, it can destroy your eardrums if your friends are fond of the Wind of Panic.');
INSERT INTO "item_descriptions" VALUES(8072,'en','No one knows exactly which dragon created this Dofus, but the rumours suggest it ingested an incredible quantity of Kaliptus leaves before laying the egg and then dying of acute aerophagia.');
INSERT INTO "item_descriptions" VALUES(8088,'en','This wand, made out of useless office stationery, holds incredible magical powers. Legend tells that it can move of its own will, choose its target and protect its master even when death is seemingly inevitable.');
INSERT INTO "item_descriptions" VALUES(8089,'en','Iots was a parrot who repeated just about anything you could say. Rumour has it that this wand was carved from its beak.');
INSERT INTO "item_descriptions" VALUES(8090,'en','Legend has it that this staff bites people, or was it that people always bit it? Something about biting anyway.');
INSERT INTO "item_descriptions" VALUES(8091,'en','This palm cane celebrates a famous festival in the South East. Unfortunately this one isn''t made of gold.');
INSERT INTO "item_descriptions" VALUES(8092,'en','The Ostwogoth is neither sharp nor smart but when he has his daggers to hand, no one dares face this monster.');
INSERT INTO "item_descriptions" VALUES(8094,'en','This sword perfectly illustrates the old Iop saying "In a slain enemy is a sword''s hilarity".');
INSERT INTO "item_descriptions" VALUES(8095,'en','This conversation piece is mass-produced according to an unchanging style. Since it''s also quite deadly, it''s often used in combat. In this case, art doesn''t imitate life, it tears it out at the roots.');
INSERT INTO "item_descriptions" VALUES(8096,'en','This hammer''s previous owner used to dance with Boowolves, until one day he was wolfed down altogether.');
INSERT INTO "item_descriptions" VALUES(8097,'en','Even your enemies will be asking to be hit again and again with this weapon.');
INSERT INTO "item_descriptions" VALUES(8098,'en','This axe is really special. Its vibrating blade plays beautiful music while you slice the life out of your enemies.');
INSERT INTO "item_descriptions" VALUES(8099,'en','Rumour has it this weapon has been dipped into a fountain of pure lightning and then sprinkled with stardust. Other rumours entirely contradict this story.');
INSERT INTO "item_descriptions" VALUES(8100,'en','This axe has been pierced in many different places making it whistle pleasantly while you slice your enemies. As the old song goes ''Whistle while you Whack.''');
INSERT INTO "item_descriptions" VALUES(8101,'en','This troublesome axe claims it comes from a mysterious land far away... Don''t listen to its rambling, though, it has made peace-loving fools out of more than one fine warrior. What a shame.');
INSERT INTO "item_descriptions" VALUES(8103,'en','This bow is made from fossilised hair of a Sadida who slept for so long that Arachnees spun a film of tough webs around it.');
INSERT INTO "item_descriptions" VALUES(8104,'en','This bow is a bizarre colour but is perfect to show off at the Zaap of Bonta. You won''t pass off as a rooster, but you''ll surely attract all the chicks! Sometimes amazing, sometimes disgusting, it might even overcome your enemies without your needing to shoot a single arrow.');
INSERT INTO "item_descriptions" VALUES(8108,'en','As light as a Tofu feather, this amulet can be worn around your neck or around your forehead if you want to be original.');
INSERT INTO "item_descriptions" VALUES(8109,'en','This ridiculously small ring can end up being essential... your enemies might pity you so much they''ll finish you off instead of letting you agonize. Let''s be positive!');
INSERT INTO "item_descriptions" VALUES(8110,'en','Unlike what some adventurers may think, this wand is not used by Tofus - they''re way too stupid to know how to use such a weapon - but to fight them. Indeed, this wand is made of Tofu feathers which enable hunters to simulate the Tofu mating dance and catch them. What else will these terrible hunters invent to satisfy their murderous instinct?');
INSERT INTO "item_descriptions" VALUES(8111,'en','Light and soft, these slippers are warm in winter and cool in summer. Unfortunately, they can''t stand being washed in washing machines.');
INSERT INTO "item_descriptions" VALUES(8112,'en','This weird cloak has been cut in half. But why would somebody cut it in half? No one knows... though everybody has his own little idea about it.');
INSERT INTO "item_descriptions" VALUES(8113,'en','This belt is the ideal tool for strangling Tofus, but hunters also use it to whip any adventurers who stray onto their land in hunting season. Probably best not to mess with the hunters - they have a history of jumping the gun, shooting first and asking questions later.');
INSERT INTO "item_descriptions" VALUES(8114,'en','This safety helmet became a very fashionable item that every pretty lady adventurer should have. What''s wrong in this World?');
INSERT INTO "item_descriptions" VALUES(8116,'en','This helmet will hide your teenage acne or your ugly face.');
INSERT INTO "item_descriptions" VALUES(8117,'en','More golden than a classical Scaracape and less black than a Black Scaracape, this cape is perfect to hide your outgrowths. The Scarabugly used to use it to hide its awful hump, for example. These days, this cape is mainly used to hide terrible-looking behinds. No need to point out that this cape is very popular.');
INSERT INTO "item_descriptions" VALUES(8118,'en','This magic wand is perfect for dusting old furniture or old people.');
INSERT INTO "item_descriptions" VALUES(8119,'en','If you love running naked on the paradisiacal Moon Island beaches, you''ll surely fall in love with this belt.');
INSERT INTO "item_descriptions" VALUES(8120,'en','Worn on a hairy torso, this amulet just looks fantastic! Hair tufts are just the perfect match for this amulet.');
INSERT INTO "item_descriptions" VALUES(8121,'en','Scarabuglies are strange creatures. Born hunchbacked and ugly, they inevitably become the laughing stock of the other Scaraleaves. Maybe that''s why you feel so close to this creature.');
INSERT INTO "item_descriptions" VALUES(8122,'en','These hooked boots make it easy for you to climb the sheerest of cliffs or to plough your fields without a plough.');
INSERT INTO "item_descriptions" VALUES(8123,'en','This amulet smells of Wild Sunflower oil and herbs. You can use it as a lure to trap dangerous rummagers... like Gobballs, or your mother-in-law.');
INSERT INTO "item_descriptions" VALUES(8124,'en','With its complementary pair of linen Bermuda shorts attached, the Beltudas is simply a must have. This belt is designed for those who need to get their clothes off in a heartbeat and burst into action just as fast. Be careful though. For reasons of hygiene, it is forbidden to wear it in public swimming pools... we don''t want a repeat of the Bonta incident... I almost lost my sight that time.');
INSERT INTO "item_descriptions" VALUES(8125,'en','If you need protection from the sun while working in the fields, what you really need is a Slob Headgear. If you need protection from the sun while working in the fields and you''re poor, the famous Farmer Sunhat will have to do.');
INSERT INTO "item_descriptions" VALUES(8126,'en','These moth-eaten mittens are a real treasure. They''re said to be covered with diamond dust which gives them extraordinary resistance. They are also abrasive on one side, perfect for putting the finishing touches to that latest DIY project.');
INSERT INTO "item_descriptions" VALUES(8127,'en','This robust but damaged scythe has already been used extensively. It is now quite dull. However, it is still wonderfully suited to ripping out chunks of tender, surface flesh. Your opponents'' varicose veins won''t stand a chance.');
INSERT INTO "item_descriptions" VALUES(8128,'en','These boots are padded with wheat straw, absorbing perspiration and allowing the portable and low-cost cultivation of toxic mushrooms. Thanks to their soft sole, they''ve been recommended by all the great Gobbowl players.');
INSERT INTO "item_descriptions" VALUES(8129,'en','Behind this stupid name, you''ll find an extremely powerful amulet, made with Boowolf fangs and bones which explains why it smells so bad. If it doesn''t suit your neck, it will perfectly suit your breath.');
INSERT INTO "item_descriptions" VALUES(8130,'en','This terrible axe has beheaded many foolhardy adventurers even if it does not cut very well. Indeed, a dozen attempts can be necessary to finish cutting a resistant neck.');
INSERT INTO "item_descriptions" VALUES(8131,'en','This bag is very fashionable among school kids and is ideal for storing animal and vegetable flours. Once opened, unfolded and torn along the seams, you''ll be able to use this bag as a skirt, just shave those legs, for Iop''s sake.');
INSERT INTO "item_descriptions" VALUES(8132,'en','This belt is anything but original... funny, it seems to match your hairdo.');
INSERT INTO "item_descriptions" VALUES(8133,'en','This helmet is perfect for those who see the World through opaque black glasses.');
INSERT INTO "item_descriptions" VALUES(8134,'en','If you can''t afford to buy a Mastralis Croak, but you like to scare Arachnees by wearing black clothes, this is the cape for you!');
INSERT INTO "item_descriptions" VALUES(8136,'en','This beautiful ring can be worn around your big toe. It''s perfect to hide your warts and your ingrown nails.');
INSERT INTO "item_descriptions" VALUES(8146,'en','If you like to break a few toes when you take your date out to dance, these boots are made for you!');
INSERT INTO "item_descriptions" VALUES(8147,'en','This is an improved version of the Crackler Helmet. This rock will efficiently protect you from falling rocks, but not from hair loss.');
INSERT INTO "item_descriptions" VALUES(8148,'en','This huge hammer is in fact a Crackler sword, adorned with a rock from the Legendary Crackler. This shocking creation will stun your opponents, just before squashing them.');
INSERT INTO "item_descriptions" VALUES(8149,'en','This rock, set with precious stones, is perfect if you want to leave a permanent mark on the forehead of an enemy.');
INSERT INTO "item_descriptions" VALUES(8150,'en','This amulet has quite a modest look though it contains many secrets including the one telling what secrets it contains.');
INSERT INTO "item_descriptions" VALUES(8151,'en','This little monster will follow you everywhere and bit anyone who tries to pull the wool over your eyes. Always ready to ring your enemies'' bells, he''ll bring a bit of music into your life. You can also count on him to keep insomnia away.');
INSERT INTO "item_descriptions" VALUES(8152,'en','The Legendary Crackler wears this belt around one of his toes. You wear it around your waist... at least for a few seconds before it clunks down around your ankles!');
INSERT INTO "item_descriptions" VALUES(8153,'en','This young Treechnid could no longer stand its family and, like you, has decided to rebel. Now, it follows you everywhere, sticking to your heels like moss on a tree trunk.');
INSERT INTO "item_descriptions" VALUES(8154,'en','This charming little southern beetle is in fact a thoroughly fearsome creature. Humiliated by its friends as a young beetle, it decided to take revenge and will gladly help you kick any bottoms you encounter.');
INSERT INTO "item_descriptions" VALUES(8155,'en','This magnificent creature is somehow related to the famous Lenalds from the Wabbit Islands. More reckless and a lot more unruly, it will help you in combat but can also prove incredibly deceitful if you don''t treat it well.');
INSERT INTO "item_descriptions" VALUES(8162,'en','With this magic Pumpkwin on your head, you''ll look even more idiotic than usual. But remember the Al Howin curse. Yes, the curse that transforms creatures into misshapen beasts.
It seems that this headgear is the only thing that can protect you from this terrible curse.');
INSERT INTO "item_descriptions" VALUES(8163,'en','Formerly worn by the authorities of the greatest cities, this helmet is now used to intimidate rebels and those who are a bit too curious about the rulers of the universe.');
INSERT INTO "item_descriptions" VALUES(8181,'en','This cloak of big stone chunks will turn you into a big stone chunk.');
INSERT INTO "item_descriptions" VALUES(8211,'en','This creature must have escaped from a zoo or some remote island somewhere. Its most distinguishing feature – sometimes shared with its master – is its rotten-fish breath. We suggest that you tape its mouth closed (tape sold separately).');
INSERT INTO "item_descriptions" VALUES(8213,'en','This amulet seems to have been made with a small, dried red Piwi head. Vanity knows no bounds.');
INSERT INTO "item_descriptions" VALUES(8214,'en','This amulet seems to have been made with a small, dried blue Piwi head. Vanity knows no bounds.');
INSERT INTO "item_descriptions" VALUES(8215,'en','This amulet seems to have been made with a small, dried purple Piwi head. Vanity knows no bounds.');
INSERT INTO "item_descriptions" VALUES(8216,'en','This amulet seems to have been made with a small, dried green Piwi head. Vanity knows no bounds.');
INSERT INTO "item_descriptions" VALUES(8217,'en','This amulet seems to have been made with a small, dried yellow Piwi head. Vanity knows no bounds.');
INSERT INTO "item_descriptions" VALUES(8218,'en','This amulet seems to have been made with a small, dried pink Piwi head. Vanity knows no bounds.');
INSERT INTO "item_descriptions" VALUES(8219,'en','This ring will allow your lover to find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8220,'en','This ring will allow your lover to find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8221,'en','This ring will allow your lover to find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8222,'en','This ring will allow your lover to find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8223,'en','This ring will allow your lover to find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8224,'en','This ring will allow your lover to find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8225,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8226,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8227,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8228,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8229,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8230,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8231,'en','If you''re small enough, this cape of Piwi feathers may cover up your behind. Some modest protection that will at least draw attention away from your greasy hair and horrible warts.');
INSERT INTO "item_descriptions" VALUES(8232,'en','If you''re small enough, this cape of Piwi feathers may cover up your behind. Some modest protection that will at least draw attention away from your greasy hair and horrible warts.');
INSERT INTO "item_descriptions" VALUES(8233,'en','If you''re small enough, this cape of Piwi feathers may cover up your behind. Some modest protection that will at least draw attention away from your greasy hair and horrible warts.');
INSERT INTO "item_descriptions" VALUES(8234,'en','If you''re small enough, this cape of Piwi feathers may cover up your behind. Some modest protection that will at least draw attention away from your greasy hair and horrible warts.');
INSERT INTO "item_descriptions" VALUES(8235,'en','If you''re small enough, this cape of Piwi feathers may cover up your behind. Some modest protection that will at least draw attention away from your greasy hair and horrible warts.');
INSERT INTO "item_descriptions" VALUES(8236,'en','If you''re small enough, this cape of Piwi feathers may cover up your behind. Some modest protection that will at least draw attention away from your greasy hair and horrible warts.');
INSERT INTO "item_descriptions" VALUES(8237,'en','This small belt will accentuate your hips if you''re fighting in front of important people.  It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
INSERT INTO "item_descriptions" VALUES(8238,'en','This small belt will accentuate your hips if you''re fighting in front of important people.  It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
INSERT INTO "item_descriptions" VALUES(8239,'en','This small belt will accentuate your hips if you''re fighting in front of important people.  It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
INSERT INTO "item_descriptions" VALUES(8240,'en','This small belt will accentuate your hips if you''re fighting in front of important people.  It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
INSERT INTO "item_descriptions" VALUES(8241,'en','This small belt will accentuate your hips if you''re fighting in front of important people.  It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
INSERT INTO "item_descriptions" VALUES(8242,'en','This small belt will accentuate your hips if you''re fighting in front of important people.  It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
INSERT INTO "item_descriptions" VALUES(8243,'en','With this hat on, you''ll look ridiculous but you''ll be just adorable. Life is a matter of choices.');
INSERT INTO "item_descriptions" VALUES(8244,'en','With this hat on, you''ll look ridiculous but you''ll be just adorable. Life is a matter of choices.');
INSERT INTO "item_descriptions" VALUES(8245,'en','With this hat on, you''ll look ridiculous but you''ll be just adorable. Life is a matter of choices.');
INSERT INTO "item_descriptions" VALUES(8246,'en','With this hat on, you''ll look ridiculous but you''ll be just adorable. Life is a matter of choices.');
INSERT INTO "item_descriptions" VALUES(8247,'en','Some people might think you look ridiculous wearing this hat, others will find you adorable. That''s life.');
INSERT INTO "item_descriptions" VALUES(8248,'en','With this hat on, you''ll look ridiculous but you''ll be just adorable. Life is a matter of choices.');
INSERT INTO "item_descriptions" VALUES(8253,'en','This amulet is often mistaken for a lucky-bag gift... It''s actually something you win at the shooting range.');
INSERT INTO "item_descriptions" VALUES(8254,'en','Offered as a wedding ring, this ring sends two subliminal messages to the wearer: "I love you" and "Go do the dishes". Perfect for those who hate wasting their time repeating the same things over and over again.');
INSERT INTO "item_descriptions" VALUES(8255,'en','Many inexperienced adventurers will remember this terribly powerful weapon, used as a defence against sods of earth. If you wet it, it becomes soft and can be rolled about, though it generally takes at least two weaklings like yourself to manage it.');
INSERT INTO "item_descriptions" VALUES(8256,'en','With these boots, Eniripsas can walk on water... which is quite useless since they can fly anyway, but it always impresses the crowds. Normal folk can always use these boots to exfoliate their feet while they sit around the house.');
INSERT INTO "item_descriptions" VALUES(8257,'en','This belt allowed Vald to take his seasonal bath without putting his life in danger. Indeed, no Iop ever succeeded in learning so much as the doggy paddle.');
INSERT INTO "item_descriptions" VALUES(8258,'en','This cape is perfect for camouflaging yourself in the natural environment. Well, it''s more like you''ll be adding a pleasant touch to the countryside, but hey, who wants to be invisible anyway?');
INSERT INTO "item_descriptions" VALUES(8259,'en','Instructions: "Offer this helmet to your husband. Firmly attach it to his head and drag him by his feet around your kitchen. You now have a clean, shining floor. Be careful not to drown him when rinsing the helmet off." This sums up the state of the modern marriage. Bloody feminists.');
INSERT INTO "item_descriptions" VALUES(8260,'en','This headband will make Iops more handsome than ever!');
INSERT INTO "item_descriptions" VALUES(8262,'en','The Amoolet holds a strange substance that is only found in the guts of a Moowolf. Some say it''s the monster''s essence, others say it''s just the semi-digested remains of a Kirball.');
INSERT INTO "item_descriptions" VALUES(8263,'en','Beware! This ring will make your finger stink, although the foul smell may cover a worse odour. Actually, that might be the best thing that could happen to your finger, your hands, and the people around you, to be honest.');
INSERT INTO "item_descriptions" VALUES(8264,'en','Ubiquitous boots that are still driven by the voracious appetite of the Moowolf. If your feet smell of Clakoss, these boots will probably bite them.');
INSERT INTO "item_descriptions" VALUES(8265,'en','The Moowolf''s beautiful, fluffy tail is so long that it trails on the ground. Driven into a jealous rage, some adventurers pulled it off and they now wear it to increase fertility.');
INSERT INTO "item_descriptions" VALUES(8266,'en','This coloured belt has a wonderful purple tuft on the front and if you wear it back to front you can pretend to be a Wabbit.');
INSERT INTO "item_descriptions" VALUES(8267,'en','While dismembering the Moowolf, hunters discovered that it only has one big horn going right through its skull. That doesn''t seem to bother Iops, who wear it proudly anyway.');
INSERT INTO "item_descriptions" VALUES(8268,'en','This necklace protected the Minotoror from getting fleas, ticks and even lice. You can be the judge of whether you need it or not.');
INSERT INTO "item_descriptions" VALUES(8269,'en','Unlike what some adventurers may think, this ring was never worn by the Minotoror who was unable to fit such a delicate thing around his hoofs.');
INSERT INTO "item_descriptions" VALUES(8270,'en','This bracelet fully protects the arm of an Eniripsa, but triples its weight.');
INSERT INTO "item_descriptions" VALUES(8271,'en','This ring of leather and ivory makes it easier for you to stimulate your partner.');
INSERT INTO "item_descriptions" VALUES(8272,'en','This necklace protects the Minotot''s cervical vertebrae from lethal Wabbit punches.');
INSERT INTO "item_descriptions" VALUES(8273,'en','This necklace comes with a small loop so the owner of the Dragon Pig can attach a leash to it. It also does wonders for Dragon Pig lice.');
INSERT INTO "item_descriptions" VALUES(8274,'en','This very axe actually beheaded one of the most dangerous Minotorors in the province of Amakna. What I can''t believe is that you don''t seem to care!');
INSERT INTO "item_descriptions" VALUES(8275,'en','This sceptre with a Plissken head made of precious stones at one end enables you to scare away young adventurers and kick their pinky butts.');
INSERT INTO "item_descriptions" VALUES(8276,'en','You won''t go winning the legendary race of Amakna Bay with these terrible boots of Minotoror Hair and leather. You might manage to break the competitors'' toes on the starting line, though.');
INSERT INTO "item_descriptions" VALUES(8277,'en','These incredible sandals will enable you to bathe in the most dangerous waters without hurting your feet. Be careful however, as they''re said to scratch the bottom of bathtubs.');
INSERT INTO "item_descriptions" VALUES(8278,'en','A good pair of mules at your side and you''ll feel stronger, more powerful and deadlier than ever. They''re just ordinary mules, though. It must be the vibes they give off.');
INSERT INTO "item_descriptions" VALUES(8279,'en','Take a Minotoror. Firmly tie him up. Take a giant plane and peel off his back in a oner. There! You''ve got your Minotoror Cloak!');
INSERT INTO "item_descriptions" VALUES(8280,'en','This is the perfect cloak to go out or practise your seduction skills at the Captain Chafer''s masked ball.');
INSERT INTO "item_descriptions" VALUES(8281,'en','This cloak will not turn you into a Piglet but at least you''ll be able dress up for one night and seduce a beautiful sow.');
INSERT INTO "item_descriptions" VALUES(8282,'en','This supple belt can be used to whip unruly kids'' bottoms. Its buckle might even mark their skin but this would only teach them their lesson once and for all.');
INSERT INTO "item_descriptions" VALUES(8283,'en','The Minotot used this stiff belt to hold his huge potbelly in, preventing him from toppling over every time he felt a draught.');
INSERT INTO "item_descriptions" VALUES(8284,'en','This headgear has been passed down from generation to generation through the Minotot family. This partially explains why it smells like rotting dandruff.');
INSERT INTO "item_descriptions" VALUES(8285,'en','With this huge skull on, you''ll look like a stiff-bristled Grizball, but with no hair. Your admirers will be speechless.');
INSERT INTO "item_descriptions" VALUES(8286,'en','According to the legend, this scale-covered cape will protect you from lightning, beans and femmes fatales, whatever they are.');
INSERT INTO "item_descriptions" VALUES(8287,'en','A little angel like you could easily pass for a merciless warrior with such a terrifying and disproportionate helmet on. If that doesn''t work, it''ll make a great cloak rack.');
INSERT INTO "item_descriptions" VALUES(8288,'en','The most perverted minds in Amakna say that this belt can be used as a prosthesis. No one knows why they would say that, though, and they''re wrong. It''s just a plain old Dreggon belt. Really.');
INSERT INTO "item_descriptions" VALUES(8289,'en','This ring, directly cut in the shape of a giant Dreggon scale, will protect a small part of your phalanx. Maybe the most important part...');
INSERT INTO "item_descriptions" VALUES(8290,'en','Made of Dreggon scales, this amulet will efficiently protect your Adam''s Api or your tonsils. It will make all the difference on a battlefield.');
INSERT INTO "item_descriptions" VALUES(8291,'en','These boots are perfect for killing Gobballs while playing Gobbowl or making your enemies suffer some more during spanking sessions.');
INSERT INTO "item_descriptions" VALUES(8292,'en','You''ll end up without a nose if you use this sword to shave your face. Save it for your back.');
INSERT INTO "item_descriptions" VALUES(8293,'en','This axe cuts through skulls like a hot knife through butter.');
INSERT INTO "item_descriptions" VALUES(8294,'en','Heavier than an empty Munchor Skull, but less solid than a Cave-dwelling Kirball femur, this hammer is nevertheless quite a fearsome weapon.');
INSERT INTO "item_descriptions" VALUES(8295,'en','This bow is so powerful that it can send Dreggon eggs over the great wall of Brakmar. What a wonderful waste of food!');
INSERT INTO "item_descriptions" VALUES(8296,'en','This wand seems to be a lot more effective when it''s used as a club or as a Moskito swatter!');
INSERT INTO "item_descriptions" VALUES(8297,'en','One end of this staff is armed with a long, sharp point. No one knows where it came from, but you can guess where it usually goes.');
INSERT INTO "item_descriptions" VALUES(8298,'en','Shika used to help Farle at harvest time by picking up the magic grain his scythe swiped. She used it to make necklaces. Though their roots and stalks have been cut off, these magic ears keep on ripening every year around the same time.');
INSERT INTO "item_descriptions" VALUES(8299,'en','This bracelet covered up Shika''s arms. This way it protected her from sunburn and Crobak pecks... the little creatures were attracted by her stunning beauty and many claim to have gotten lucky with her.');
INSERT INTO "item_descriptions" VALUES(8300,'en','This custom-made hoe helped Shika make the highest haystacks in the realm. Legend has it they were so big that sailors used them as markers to tell how far they were from the Amaknian coast.');
INSERT INTO "item_descriptions" VALUES(8301,'en','These clogs were created for Shika so that she wouldn''t trample the seedbeds of the Snossios plains. The high-heels make it easier to run in the stubble without hurting her ankles and stop the dew getting in.');
INSERT INTO "item_descriptions" VALUES(8302,'en','Flowers from harvest time have been sewn to this cape made of woven magic cereals. It''s driven by such a powerful magic that Shika used to use it for protection against lightning on stormy nights!');
INSERT INTO "item_descriptions" VALUES(8303,'en','This belt of leather used to protect Shika''s thighs when she ran across the wheat fields to bring back to their herd lost Gobballs. Covered with pollen from magic cereals, legend says that it used to shimmer in the moonlight and ensured Farle didn''t cut his wife''s legs while reaping fields of cereals at night.');
INSERT INTO "item_descriptions" VALUES(8304,'en','Covered with a multitude of flowers, this hat made Shika look happy and bright when she left at the crack of dawn to plough the Church Hills.');
INSERT INTO "item_descriptions" VALUES(8330,'en','This little headgear lets Dragandrops throw themselves at their enemies without running the risk of getting lumps on their foreheads. It''s long been in use on major construction sites in Amakna, as well. This headgear became all the rage again after Moowolves from Kruup Mountain invaded Astrub. What''s the point of this story? There is no point, but who cares?');
INSERT INTO "item_descriptions" VALUES(8331,'en','With this hat on, you''ll be able to dress up and seduce any naive Astrubian you find... Just offer him a hot date for 100 kamas, and Bob''s your uncle, his wallet''s empty.');
INSERT INTO "item_descriptions" VALUES(8333,'en','This mysterious cape only comes out once a year, but the scammers always use it to get a fast kama from the kiddies.');
INSERT INTO "item_descriptions" VALUES(8334,'en','This hat will hide the scars all over your head. That way, no more toddlers will be injured trying to flee in terror from your Santa stall.');
INSERT INTO "item_descriptions" VALUES(8338,'en','This strange sword sure won''t make you invincible... In fact, people have died trying to kill snowmen with it.');
INSERT INTO "item_descriptions" VALUES(8341,'en','These boots smell of Pineapi juice marinated with wet socks. The great thing is that when you visit your friends, they will never ask you to take your shoes off.');
INSERT INTO "item_descriptions" VALUES(8366,'en','This cape used to belong to a famous capon, a long-feathered bird that loved to dance near the Bonta Zaap and puff itself up in front of all the gullible poultry and immature chickens.');
INSERT INTO "item_descriptions" VALUES(8414,'en','These daggers are perfect for cutting the top off a soft-boiled Dreggon egg. They''re also very light, which enables you to run fast when the Dreggon community realises what you''ve done.');
INSERT INTO "item_descriptions" VALUES(8417,'en','This small shovel was once given to a young Enutrof. He liked it so much that he took up digging full time. He dug his own grave when he was twenty eight and healthy... dug himself a whole graveyard, he still didn''t die. His body was lost at sea first time he left home. How ironic.');
INSERT INTO "item_descriptions" VALUES(8419,'en','Captain Mayhav is said to have used this very shovel to rip open the Great White Kralove known as Dopy Mick.');
INSERT INTO "item_descriptions" VALUES(8420,'en','Dreggons like to dig networks of underground passages but they never use these shovels. The Enutrof community studied this enigma but concluded that it was less important to know where they came from than how to hit someone with one.');
INSERT INTO "item_descriptions" VALUES(8441,'en','Bill wanted a halo. He screamed so loud and threw such a tantrum that he finally got it. A real little devil.');
INSERT INTO "item_descriptions" VALUES(8442,'en','Brouce Boulgoure used this mask to discreetly infiltrate a Grossewer rats'' den and cut down an elm by the roots. On the way out, he squashed every single rat in the den with his wooden clogs.');
INSERT INTO "item_descriptions" VALUES(8443,'en','This cape can be made with any sort of animal hair provided that it''s very dirty. They are plaited together and then cemented with various secretions. The smell is unfortunately not optional.');
INSERT INTO "item_descriptions" VALUES(8444,'en','Badly damaged, but extremely sharp, these dagger blades will slice off a limb with disconcerting ease. They''ll sink through bones like butter, allowing you to carve your enemies up like spring chickens. What a pity they aren''t rusty, poisoned and white-hot too!');
INSERT INTO "item_descriptions" VALUES(8445,'en','The rat who used to own this necklace thought he would become the chief of his clan. He was devoured by a rabid Lenald.');
INSERT INTO "item_descriptions" VALUES(8446,'en','Be careful when you put on these boots, as there might still be a foot or two of the previous owner inside them.');
INSERT INTO "item_descriptions" VALUES(8447,'en','Unlike his Bontarian cousin, the Black rat is discreet and wears a simple fabric belt. But he also likes to take a lot of weapons with him, and it all makes a terrible clinking noise at each of his steps.');
INSERT INTO "item_descriptions" VALUES(8448,'en','They say that the Black Rat himself scratched his own back with the sharp claws on this glove. Be that as it may, it may still have fur and hair caught in the crevices and there are no guarantees as to the odour. One could even wonder if he only scratched his back...');
INSERT INTO "item_descriptions" VALUES(8450,'en','This weapon is the symbol of the White Rat. It will slice both enemies and allies with the same ease.');
INSERT INTO "item_descriptions" VALUES(8451,'en','With this hat, the White Rat looks like a real musketeer from Bonta. Without this hat, he looks like an ordinary, hatless white rat from Bonta.');
INSERT INTO "item_descriptions" VALUES(8452,'en','This cape is the identifying symbol of white rats throughout the Bonta sewers. It is the reward a rat gets after a long and difficult series of examinations and is proudly worn until the pants his final ratty breath... which usually isn''t very long at all.');
INSERT INTO "item_descriptions" VALUES(8453,'en','If you wear this around your neck like a necklace, it''ll protect you from the toxic sewer fumes. If you wear it lower down like a belt, it will protect your allies from your toxic intestinal fumes.');
INSERT INTO "item_descriptions" VALUES(8454,'en','This glove used to belong to Julia Dilch, master cook at the Bonta palace. She used it to knock out gobballs that didn''t want their throats slit, wild plants that didn''t want to end up in a salad bowl, and clients reluctant to eat what was on the menu. And through it all, she stayed classy, never once getting her hands dirty.');
INSERT INTO "item_descriptions" VALUES(8455,'en','Although their Brakmarian cousins may not agree, white rats like to be as discreet as possible. That''s why this belt is so light and small – to stylishly offset overly imposing bodies.');
INSERT INTO "item_descriptions" VALUES(8456,'en','With these boots, your balance will be perfect. You won''t sway in the slightest, even on the windiest of days.');
INSERT INTO "item_descriptions" VALUES(8457,'en','This hat has nothing to do with a Dora, a Brave''s Dark Dora, a Dora Bora or a Doro L. Blak. Absolutely nothing! So don''t bother spreading rumours about its designer being slack or uninspired! It''s just a very nice looking hat.');
INSERT INTO "item_descriptions" VALUES(8458,'en','This colourful cape turns you into an ideal target. Only quick and nimble adventurers can wear it for more than a few minutes.');
INSERT INTO "item_descriptions" VALUES(8459,'en','To dissuade greedy thieves, this necklace is secured around the neck of the heir to the Lord of the Rats at his birth. The only way to remove it is to take off his head... This doesn''t seem to dissuade the thieves.');
INSERT INTO "item_descriptions" VALUES(8460,'en','This ring was designed at a time when the Lord of the Rats only had one finger left after mutilating all the others. The unfortunate lords that followed had all of theirs.');
INSERT INTO "item_descriptions" VALUES(8461,'en','The patterns on this belt will have people thinking you''re on fire. The optical illusion is so powerful that you shouldn''t be surprised when complete strangers throw water all over you. Amazingly enough, this corresponds exactly to the ceremonial ritual.');
INSERT INTO "item_descriptions" VALUES(8462,'en','The very first Lord of the Rats died when he stepped in a pool of molten lava. To pay tribute to him, his lords wear these boots. By the way, they are not in the least bit fireproof.');
INSERT INTO "item_descriptions" VALUES(8463,'en','The mushrooms pushing up on this helmet spread a nice exhilarating smell that makes you want to take roots. They are also quite tasty but might definitely bury you.');
INSERT INTO "item_descriptions" VALUES(8464,'en','In summer, the Ancestral Treechnid likes to sunbathe but as its wood is accustomed to dark forests, it doesn''t stand it very well. This cape is made of his bark peelings.');
INSERT INTO "item_descriptions" VALUES(8465,'en','Worn around your neck with a low-cut top, this torc will accentuate your beard beautifully. If you don''t have one... well... you only have yourself to blame.');
INSERT INTO "item_descriptions" VALUES(8466,'en','If you''ve had a little too much to drink, you might see the Moskito embedded in this ring wink at you. But don''t tell your friends, the little beast will deny everything.');
INSERT INTO "item_descriptions" VALUES(8467,'en','Your legs will fear nothing when you''re wearing these solid wood shin guards. Unfortunately, you can''t wear them and boots at the same time. You can wear them for protection during gobbowl ball games, but your toes will take the full brunt of any toe pokers.');
INSERT INTO "item_descriptions" VALUES(8468,'en','This belt is supposed to inspire you with ancestral virility. Whether this was ever true or not, the effect has now surely gone without a trace.');
INSERT INTO "item_descriptions" VALUES(8469,'en','This piece of wood extracted from the very heart of the Soft Oak is extremely powerful. Indeed, it can even enrage the Soft Oak.');
INSERT INTO "item_descriptions" VALUES(8470,'en','This ring is made of Soft Oak faeces. It''s wooden alright, but the smell remains the same.');
INSERT INTO "item_descriptions" VALUES(8471,'en','On Sundays, the Soft Oak takes a long nap and when he wakes up he likes to have an obedient Trunknid bring him his flip-flops. Fortunately, he doesn''t have any feet so they''re still brand new.');
INSERT INTO "item_descriptions" VALUES(8472,'en','More than 200 years ago, some fabric got stuck in the Soft Oak''s branches. As the tree grew, it imbued the fabric with its magic. The cloth is now an integral part of this huge piece of wood and though it makes it hard to handle and highly flammable, its power can''t be denied.');
INSERT INTO "item_descriptions" VALUES(8473,'en','In autumn, the Soft Oak wears its G-string to protect his precious acorns. In summer time, he likes to go commando.');
INSERT INTO "item_descriptions" VALUES(8474,'en','No matter how you wear this hat, it will always look like it''s on sideways.');
INSERT INTO "item_descriptions" VALUES(8513,'en','There''s nothing better for collecting "bits" of creatures than Bworknroll''s scalpel, which preserves the vitality of the torn-off limbs.');
INSERT INTO "item_descriptions" VALUES(8521,'en','The red cape is the favourite artefact of megalomaniacs. Once on their frail shoulders, they believe they are Superman or an ultra-powerful magician. Until they meet a Minotoror at least.');
INSERT INTO "item_descriptions" VALUES(8527,'en','These Goblin skin boots were created by Planbworksek to charge the enemy (if possible from behind) extremely quickly. These boots saved many a Bwork comrade in wartime.');
INSERT INTO "item_descriptions" VALUES(8530,'en','This hat keeps your ears warm and absorbs the alcohol on your breath. What else could you ask for?');
INSERT INTO "item_descriptions" VALUES(8533,'en','The Flud is not really a hat. It''s more of a parasite that tends to develop on loud or aggressive people''s heads. Its disgusting appearance repels all and sundry, compelling its wearer to scream even louder which is useless since these people have nothing to say anyway.');
INSERT INTO "item_descriptions" VALUES(8534,'en','This padded cape absorbs all surrounding noise, plunging the wearer into a lifetime of incredibly awkward silences.');
INSERT INTO "item_descriptions" VALUES(8535,'en','These getas are so light that they make their owner run and jump all over the place whenever some action starts. Experienced adventurers just hate them... Every Tom Dick and Harry comes and crashes their fights uninvited.');
INSERT INTO "item_descriptions" VALUES(8536,'en','This belt must be worn tight... so tight that it forces its wearer to stammer, shake and generally jerk around in the inimitable style of Thrustin Timbertake.');
INSERT INTO "item_descriptions" VALUES(8537,'en','This small ring has no use beside making you look extremely flashy. Now people might actually want to talk to you.');
INSERT INTO "item_descriptions" VALUES(8538,'en','After several nights of hard work, the most famous jeweller in Astrub, also known for being raised by Bworks, announced to an astounded crowd: "c u l8r @ d gld hs". Even the renowned historian Champo Lhyon didn''t manage to decipher the jeweller''s message.');
INSERT INTO "item_descriptions" VALUES(8561,'en','This cute Pandawa Cub will gladly travel round the World with you and discover its mysteries with its big, round eyes.');
INSERT INTO "item_descriptions" VALUES(8569,'en','This cap used to belong to a little Xelorette who got a kick out of disrupting the passage of time. Legend has it that she once stole several days off the inhabitants of Amakna. She had to hand out quite a few candies to make up for that little trick.');
INSERT INTO "item_descriptions" VALUES(8575,'en','A famous Feca warrior who lived in the jungle of Pandala was often heard to say: "To win the war, you have to become the war".');
INSERT INTO "item_descriptions" VALUES(8596,'en','This sharp sword gained this elegant crimson colour after gutting thousands of Bworks. Before, it was just purplish.');
INSERT INTO "item_descriptions" VALUES(8598,'en','These blades have holes all over them so that they make a nice little whistling noise when handled quickly. The holes are also extremely useful when it comes to gutting your enemies.');
INSERT INTO "item_descriptions" VALUES(8599,'en','These daggers were forged for a Ecaflip who had a real thing for proper manicures. She thought that heavy swords that didn''t match her perfectly varnished claws.');
INSERT INTO "item_descriptions" VALUES(8604,'en','This shiny sword is perfect for trimming flowers and trees, even if the plants fight back.');
INSERT INTO "item_descriptions" VALUES(8605,'en','This blade has been lubricated to slip into its sheath more easily. However, it cannot be cleaned after use and must be thrown away, especially if it''s covered in blood. Bear in mind that its main use is to protect you.');
INSERT INTO "item_descriptions" VALUES(8607,'en','It''s a big staff with nails knocked into it. Do not hope for something else in this staff, it''s simple and loosens your enemies'' teeth nicely.');
INSERT INTO "item_descriptions" VALUES(8608,'en','Rumour has it that a Sadida named Fraye used this staff to protect his wife and son from an enraged flock of Gobballs. What a pity that he also mistook his family for the monsters during the fight.');
INSERT INTO "item_descriptions" VALUES(8609,'en','This bow is light, delicate, elegant and smells of cherry tree flowers. It is also lethal if used for anything other than striking a pose.');
INSERT INTO "item_descriptions" VALUES(8610,'en','If you hold this bow high and joyfully say "Pampulilu!", you''ll look absolutely ridiculous.');
INSERT INTO "item_descriptions" VALUES(8611,'en','This wand belongs to a famous Grinegau who makes excellent coffee, but who just can''t get the ladies.');
INSERT INTO "item_descriptions" VALUES(8612,'en','With the Bidjiz, you''ll stay alive probably because your opponents will start dancing when they see the disco ball at the end of this wand.');
INSERT INTO "item_descriptions" VALUES(8613,'en','Created like a Smithmagic masterpiece, this shovel digs really bad, except when it''s your opponents'' heads.');
INSERT INTO "item_descriptions" VALUES(8614,'en','This shovel is a great invention. It can dig up a grave and be left on top as a cross, provided only one adventure fellow dies at the time... Or else you''ll have to dig the other graves with your hands.');
INSERT INTO "item_descriptions" VALUES(8615,'en','This Hammer easily crushes skulls to pulp... which is exactly why it''s tinted with a nice red tomato colour.');
INSERT INTO "item_descriptions" VALUES(8616,'en','This hammer was created during the reign of King Stephan, a terrible tyrant who terrorised trillions of people.');
INSERT INTO "item_descriptions" VALUES(8617,'en','Your pet, our passion.');
INSERT INTO "item_descriptions" VALUES(8618,'en','This strange axe is designed to easily behead Bworks. The ease with which it can also behead Astrub''s inhabitants clearly indicates that there''s a connection between these two populations. But no one has discovered just what it is yet.');
INSERT INTO "item_descriptions" VALUES(8619,'en','Thanks to this warrior hat, Iops really cut a fine figure. The only problem is that it hides some of their field of vision and prevents them from hearing their opponents'' words. This hat is designed for those who like to strike before they think.');
INSERT INTO "item_descriptions" VALUES(8627,'en','Colleague and friend of the famous Guy-Guy (close relative of the Soft Oak), Sarr Ys is a minstrel whose enchanting melodies have been engraved in Amakna''s collective unconscious. Unfortunately, this brilliant artist had a tragic Quaquack accident after a particularly boozy New Year''s Eve celebration.');
INSERT INTO "item_descriptions" VALUES(8628,'en','This headgear bestows self confidence and temerity on whoever wears it. Thanks to it you''ll always keep going thinking you can actually make exploits. Remember to take it off from time to time or it will take you into inextricable situations!');
INSERT INTO "item_descriptions" VALUES(8629,'en','Every time an opponent comes to face this headgear, he turns as silent as the grave. No one dares ask what it is supposed to be. But that''s ok, Srams aren''t known for their sensitivity.');
INSERT INTO "item_descriptions" VALUES(8630,'en','This hat looks like the Sulik and the Paperb'' Hat. But since it''s very comfy and Xelors never take it off - even when they sleep, it is commonly called Hatter Lily. It gives off a nice pleasant white water lily smell which helps you get to sleep. However, it also provokes snores as unbearable as the Toads'' song during the mating season.');
INSERT INTO "item_descriptions" VALUES(8631,'en','Thanks to this hat, Eniripsas always know how to deal with emergencies. Indeed, all the first aid tips are discreetly written on the lining. It makes them look as if they just graduated even though no one would normally wear such a ridiculous hat even for a school ceremony!');
INSERT INTO "item_descriptions" VALUES(8632,'en','You might have expected this headgear to be a handsome orange colour. It''s nothing of the sort. Not only that, this fashion accessory is more of a mask than a cap... So why did the creators decide to call it a Cap Ricott? Probably just to get people talking about it!');
INSERT INTO "item_descriptions" VALUES(8633,'en','The sharpened points coming out of this cap not only enable you to hurt your enemy but also increase your chances of being struck on the head by lightning during a storm. Indeed, Sacriers are a class who love to hurt others as much as themselves. A nice smell of grilled meat: nothing''s better to start your day!');
INSERT INTO "item_descriptions" VALUES(8634,'en','Thanks to this headgear, you''ll really look like a horny beast. People will turn round to admire the huge pair on your head. This roomy hood can also keep food fresh like hay for Gobballs or bread for Tofus.');
INSERT INTO "item_descriptions" VALUES(8635,'en','This helmet can make wearers make promises they instantly forget. Is it because it exerts pressure on the part of the brain which deals with memory or language? No one truly knows. What matters is to only take into account the less extravagant words.');
INSERT INTO "item_descriptions" VALUES(8636,'en','Robbie Hood was a famous Cra who lived in the woods. This explains the camouflage green colour of the cap. He wanted to take the law into his own hands and spent all his time stealing money from the rich for a good cause: himself!');
INSERT INTO "item_descriptions" VALUES(8637,'en','Fecas increase their luck, as well as that of their allies when they wear this hat. If you''ve hired a Feca who''s wearing the Zinda Hood, you''re sure to arrive safely and almost without a scratch. The problem is, it smells so foul that it''s only useful for protecting widows and orphans.');
INSERT INTO "item_descriptions" VALUES(8638,'en','This hood can be used to fend off the bad weather, but it''s also great for cooking. It allows you to regulate the strength of a flame with a tip of the head. Now you know why Enutrofs have such muscular necks.');
INSERT INTO "item_descriptions" VALUES(8639,'en','The floating cape will give you the aura of a warrior, especially when you turn your back to your enemy. Some think it''s reinforced by a metal sheet capable of staving off the slyest attacks.');
INSERT INTO "item_descriptions" VALUES(8640,'en','Cut from a soft and strong fabric, this cape gives the Ecaflips the impression that they''re always the best, no matter what happens. When they win, they love to wear this piece of clothing and claim their reward: "And now, gimme the cash!"');
INSERT INTO "item_descriptions" VALUES(8641,'en','This cape is so light and thin that the slightest wind, wind of any sort, will blow it off... It''s anything but discreet especially after a meal of veggies and fermented drinks.');
INSERT INTO "item_descriptions" VALUES(8642,'en','The dark colour of this cape makes it easy to match any other cloth, of any colour. Since it''s a very wide cape, it can also protect your head and nose.');
INSERT INTO "item_descriptions" VALUES(8643,'en','Place the cape lightly on your shoulders to prevent stiff joints, stiff upper lips and other stiffness-related problems.');
INSERT INTO "item_descriptions" VALUES(8644,'en','This item is used to hide the Sadidas'' weight problem. Because they spend most of their time sleeping instead of practicing sports, the characters of this class tend to become rather stout. If Sadidettes actually have anti-starvation supplies flatteringly placed in the eyes of men, Sadidas usually use this cape to hide theirs.');
INSERT INTO "item_descriptions" VALUES(8645,'en','This piece of clothing plays an essential part in the Sacriers'' style. They use it to bandage their wounds, to clean off blood, to warm their feet during the cold seasons. We cannot say it enough - this class is terrified of frozen ground!');
INSERT INTO "item_descriptions" VALUES(8646,'en','This soft cape is sometimes used by the Osamodettes as a wide-brimmed hat. Male Osamodas only use it as a cape. Thanks to the drawing which decorates this piece of clothing, this character class has inherited the reputation of being frank... they can''t laugh up their sleeves since the laugh has actually been sewn onto the cape!');
INSERT INTO "item_descriptions" VALUES(8647,'en','Pandawas use this cape as protection against bad weather and as a dance accessory. They put it on the floor, in the middle of a circle of tipsy dancers. Then they start their improvised choreography during which their feet can''t leave the cloth.');
INSERT INTO "item_descriptions" VALUES(8648,'en','Let me tell you about Hulco, a very strange Cra. He couldn''t find his way to his own bathroom because everything he saw looked like a tropical beach at sunset. At least he never had to pay for a sun holiday.');
INSERT INTO "item_descriptions" VALUES(8649,'en','This cape''s warm and comforting colours take its wearer on an imaginary journey to sunny lands, full of canyons carved by the elements, and cave paintings hidden amongst wind-blasted rocks and weathered cliffs. This is extremely useful way of forgetting the cold, grey, rainy weather.');
INSERT INTO "item_descriptions" VALUES(8650,'en','Enutrofs have the habit of drawing a map on their cape. They live in such a mess that they can barely find the toilets and this is quite a problem, especially when nature calls urgently.');
INSERT INTO "item_descriptions" VALUES(8651,'en','This beautiful belt adds to the prestige of the Iops'' appearance. Some say that the central cross can become a detachable weapon when their swords aren''t within reach. Obviously this is a legend. Only Srams are deceitful enough to have such things.');
INSERT INTO "item_descriptions" VALUES(8652,'en','When an Ecaflip is bored, he usually takes his cards from his belt and starts a game of solitaire. In fight, he can also use the cards as projectiles. He draws a card faster than his shadow and once victory is his, there''s always time for a little game!');
INSERT INTO "item_descriptions" VALUES(8653,'en','This belt owes its name to the unusual noise it makes. The bones decorating the belt bang together, preventing Srams, even those who are invisible, from sneaking up on their enemies unannounced. Surprise someone wearing a Clinkin Belt? You''ve got a snowball in the Obsidemon''s Hypogeum''s chance!');
INSERT INTO "item_descriptions" VALUES(8654,'en','The incessant ticking sound of the clock system of this belt prevents Xelors from sleeping when fights last forever. It is strongly advised that you take this belt off before going to bed.');
INSERT INTO "item_descriptions" VALUES(8655,'en','Though it won''t stop the sobbing, this belt will hold lots of medical supplies. This is especially important for Eniripsas... when they have a sore throat, they can''t cast their spells properly. And when they''re voiceless ... well, they''re as useful as a bear skin jacket in a heat wave.');
INSERT INTO "item_descriptions" VALUES(8656,'en','The reason the designers of this fashion accessory put the doll head next to the crotch is still unknown.');
INSERT INTO "item_descriptions" VALUES(8657,'en','Warriors of an ancient tribe renowned for their love for blood, the Pados may have been the first worshippers of the goddess Sacrier. Despite its harmless appearance, this belt is a real sophisticated instrument of torture.');
INSERT INTO "item_descriptions" VALUES(8658,'en','Osamodas are known to be quite touchy, and can fly off the handle at the slightest thing. The numerous buckles and horns on this belt are there to help them rein in this anger, as touching them and counting out loud is supposed to be quite calming.');
INSERT INTO "item_descriptions" VALUES(8659,'en','This belt helps Pandawas stand up straight (or almost) when they''re drunk which they are, most of the time. In these moments, they tend to feel like they''re stuck to the ground though gravity has no link whatsoever to this sensation. Gravity is way too busy knocking out scientists with Apis.');
INSERT INTO "item_descriptions" VALUES(8660,'en','This belt enables you to keep up baggy clothes (so as not to scare away sensitive souls) and it also offers a target to apprentice Cras. Indeed, they''re taught to shoot right in the centre but never below the belt.');
INSERT INTO "item_descriptions" VALUES(8661,'en','Always prepared, Fecas keep survival supplies in a small bag. These supplies are mainly bread made from Crackrock stones. Not very tasty, but incredibly long lasting. The girdle belt firmly secures the bags around their waists. Even so, there are still way too many serious injuries caused by falling bags out of negligence or just plain stupidity.');
INSERT INTO "item_descriptions" VALUES(8662,'en','This belt is a very handy fashion accessory used by male Enutrofs. The map sewn onto it hides the little accidents they have when they get lost looking for the toilets.');
INSERT INTO "item_descriptions" VALUES(8663,'en','With these boots on, the Iops are always the first to get to the battlefield and start livening the place up. It''s common knowledge that this class love to amuse the crowd with their warrior exploits. But they''re never taken seriously because of their intelligence, which is inversely proportional to their strength.');
INSERT INTO "item_descriptions" VALUES(8664,'en','It is said that Sadidas never feel lonely, since they can summon lots of dolls to keep them company. Thanks to these shoes, you too can say goodbye to loneliness! Not only will you be able to talk to them, but they''ll be great for hiding aces when you''re playing poker. Once you''re wearing them, you''ll feel really good, even if you are a little ashamed to actually go out with them on.');
INSERT INTO "item_descriptions" VALUES(8665,'en','Imbued with a revolutionary firming agent, these boots will perfect the curvature of your legs and fight the good fight against your death-like Sram complexion. This cream has spectacular effects on Sramettes but seems to be absolutely useless on Srams. Could it be a hormonal problem?');
INSERT INTO "item_descriptions" VALUES(8666,'en','These boots were created by a Xelor artist to help him paint more quickly. And they work! However, they also tend to distort the vision, meaning the artist was incapable of drawing anything but curvy females.');
INSERT INTO "item_descriptions" VALUES(8667,'en','These boots will protect you by identifying and neutralising ground-borne toxins. Well, you can never be too suspicious of microbes and other germs, can you? Some pedantic observers enjoy pointing out that they look more like slippers than boots, but that''s what Eniripsas call them. I wonder if it''s because they''re so tiny that they see everything from a different viewpoint.');
INSERT INTO "item_descriptions" VALUES(8668,'en','Thanks to their recognition system, these boots prevent Sadidas from crushing rare plants. However they won''t prevent you from stepping in various sort of excrements if you don''t watch where you''re going.');
INSERT INTO "item_descriptions" VALUES(8669,'en','Unlike the other classes, Sacriers love having thorns stuck in their feet and would rather not pull them out. The pain reminds them that they''re alive and gives them the raging energy they need to slaughter their enemies. Plus, the drops of blood they leave behind make it impossible to get lost. They can always backtrack – which they wouldn''t have been able to do as easily in poor quality shoes.');
INSERT INTO "item_descriptions" VALUES(8670,'en','Crocodyl Dandy lost many a good opportunity and many a wife through his undying urge to wander round the outback. His fame grew fast and he was even offered a sponsorship deal by the famed shoemakers of Aerdala, but when he saw what they had on offer, he threw them back and shouted "That''s not a pair of boots... THIS is a pair of boots."');
INSERT INTO "item_descriptions" VALUES(8677,'en','Ross is the favourite pet of the famous Master Black Jack. Don''t be put off by its appearance, it can be really fearsome in battle.');
INSERT INTO "item_descriptions" VALUES(8693,'en','Thanks to this pet, anyone of the opposite sex will be making eyes at you. Don''t gloat too much, though. Very soon, you''ll realise that your suitor has been hypnotised by Feanor. It won''t be much of an advantage either: from then on, your admirer will only eat raw Snapper and rub up against your legs... Sounds romantic, doesn''t it?');
INSERT INTO "item_descriptions" VALUES(8695,'en','Like Brice said: "It''s not the size that counts, it''s the sharpness."');
INSERT INTO "item_descriptions" VALUES(8698,'en','Created by Khelebragon''s love for the priestess Methea, this Dofus is full of nostalgia. Don''t gaze at it too long, or you might feel like crying... which might damage your reputation as a stone-cold adventurer.');
INSERT INTO "item_descriptions" VALUES(8699,'en','You''ll always have an out-of-bed look if you wear this hat, even if you''ve spent hours brushing your hair. The hairs on a Tynril''s bark curl when the weather is humid, which makes it the surest weather forecaster in the World. This hat fears fire, however, so be extremely careful and keep it away from flames if you don''t want to become a human torch.');
INSERT INTO "item_descriptions" VALUES(8701,'en','This sumptuous sword used to belong to a famous thief who was renowned for getting nicked every time he committed a crime.');
INSERT INTO "item_descriptions" VALUES(8704,'en','If you shake your two little bells, you might be able to play music.');
INSERT INTO "item_descriptions" VALUES(8713,'en','In some countries, it seems that Geta Bernacle are thrown at the feet of enemies to propose a duel. It''s a little like hitting your opponent with a pair of gloves. The advantage of using Geta Bernacle is that they add the stench factor to the actual blow. Pandawas never were famous for their foot hygiene.');
INSERT INTO "item_descriptions" VALUES(8714,'en','Wearing this ring is an honour. It shows that you''re a faithful worshipper of the goddess Cra, the only one to reveal how to harden your muscle more quickly to be able fire more effectively.');
INSERT INTO "item_descriptions" VALUES(8715,'en','Ecaflips have the gift of the gab. They can talk you into almost any bet you can think of. This ring celebrates their business smarts. It can also be used as a spare dice or to scratch yourself.');
INSERT INTO "item_descriptions" VALUES(8716,'en','Osamodettes love this ring that gives an extra feline touch to their walk. Because they''re always so close to monsters, they''re starting to behave like true tigers. But in reality, they''re as devoted and caring as mother Boowolfines.');
INSERT INTO "item_descriptions" VALUES(8717,'en','Spiteful gossips claim that this ring is the least useful fashion accessory in the World. The wings attached to it are very awkward when you need to get a tissue out of your pocket. Now, as Iops have neither tissues nor pockets, they don''t care. Instead, they prefer shredding their enemies'' flesh with the wings during close combat. Thinking about it, you wonder why this isn''t the Sacriers'' ring instead.');
INSERT INTO "item_descriptions" VALUES(8718,'en','Fecas use the mini shields on this ring as memo boards to write love notes and to-do lists. This jewel has been nicknamed the anti-forgetfulness shield. However, it does not protect you from stammering or slips of the tongue.');
INSERT INTO "item_descriptions" VALUES(8719,'en','Enutrofs can use this ring to evoke the memory of their happiest times whenever they want. If one removes the miniature shovel driven into the ring, it will give off a gentle aroma. To make the memory even more potent, you''d need to add a specific smell to it, and that''s not the easiest thing to do, let me tell you.');
INSERT INTO "item_descriptions" VALUES(8720,'en','The goddess Eniripsa gave this item to her worshippers as a sign of their spiritual union during the class spell initiation session. Incidentally, Eniripsas can also use it as a sponge bracelet to clean off the blood of their allies.');
INSERT INTO "item_descriptions" VALUES(8721,'en','This jewel tends to turn Pandawas into insulting devils after two or three beers... just remember the old proverb "Sticks and stones may break my bones, but a drunken bear-like creature will never hurt me."');
INSERT INTO "item_descriptions" VALUES(8722,'en','This jewel with a skull on it was traditionally offered to all Sram kids to reward them for their treachery and blows below the belt. The other classes seem to discredit this practise which tends to overexcite the kids and turn them into little devils.');
INSERT INTO "item_descriptions" VALUES(8723,'en','This ring is the only jewel that can tell the time and which is perfectly waterproof. Some believe that if you enlarge it a few hundred times, it''ll make a submarine too. A submarine that can tell the time.');
INSERT INTO "item_descriptions" VALUES(8724,'en','Contrary to the rumour, Sadidas do not let their hair down... This hair has just been adjusted round a wonderful ring to reinforce its benefits. Never ever cut it! Thanks to the Hai Ring, you''ll always be perfect!');
INSERT INTO "item_descriptions" VALUES(8725,'en','If you see a character who''s not a Sacrier wear the Ring Neinwonwon, take him directly to intensive care. Indeed, this jewel is extremely harmful. In general, people lose their cool when they face the pool of blood caused by this ring.');
INSERT INTO "item_descriptions" VALUES(8726,'en','These shoes enable their wearer to dance all night long, despite blisters and corns! They dance to the rhythm of the night and make a little "beep beep" sound when they''re next to religious artefacts. You''ll be bright as a button the next day too, ready for a bit of slaughter.');
INSERT INTO "item_descriptions" VALUES(8727,'en','When Fecas are embarrassed and wish to change the subject, they always mention their Relief Boots. They talk about the way you can pace up and down all sorts of landscapes with them on. When their allies are in trouble on the battlefield, these comfy boots help them recover and ward off the threat.');
INSERT INTO "item_descriptions" VALUES(8728,'en','The numerous straps around these shoes can be used as spare bow strings. Young Craettes also use them to cook vegetables. The smell of feet doesn''t seem to bother them.');
INSERT INTO "item_descriptions" VALUES(8818,'en','Made from Mopy King Fabric, this cape is riddled with micro-holes that allow sweat to escape more easily during periods of intense exercise - during aggressive melees in steamy swamps, for example. The holes may let the humidity out, but they keep the heat in, and so you always stay dry, whatever the situation. It''s just a pity the stench of mould is so hard to shift.');
INSERT INTO "item_descriptions" VALUES(8819,'en','This cape may not be as powerful as the fancier Mopy King version, but it still has the same sweat evacuation system. You''ll be able to face any situation wearing it, as long as you''re able to fight while holding your breath, that is. The stench is truly unbearable!');
INSERT INTO "item_descriptions" VALUES(8820,'en','This sturdy wooden mask will have you fearlessly facing all kinds of dangers, which isn''t surprising given that it completely blocks your view.');
INSERT INTO "item_descriptions" VALUES(8821,'en','From a distance, this hat looks like a lampshade with two holes for the eyes. It looks the same up close actually.');
INSERT INTO "item_descriptions" VALUES(8822,'en','This mask won''t help you avoid or heal hangovers, but at least it gives you some chance of hiding the effects.');
INSERT INTO "item_descriptions" VALUES(8823,'en','This mask won''t help you avoid or heal hangovers, but at least it gives you some chance of hiding the effects. The dark touch simply indicates that you''re in a bad mood... and that you should not be annoyed and you''re ready to throw a flurry of blows to anyone who does not respect that!');
INSERT INTO "item_descriptions" VALUES(8824,'en','You''ll look like a Snailmet if you wear this hat. Of course it will protect your head from blows, but does that make up for the slobber all over your head?');
INSERT INTO "item_descriptions" VALUES(8825,'en','Bigger, heavier and more powerful, this mace makes a louder noise when smashing the enemies. But curiously, it''s lighter and has a better grip to it. The Coralator we used to make it wasn''t great for no reason!');
INSERT INTO "item_descriptions" VALUES(8826,'en','Despite her small size, the Zoth Girl carries a huge hammer. It''s a way to reinforce her muscle structure. No need to add weights around her wrists and ankles to increase her strength. Dragging the hammer is quite enough!');
INSERT INTO "item_descriptions" VALUES(8827,'en','The Zoth Warrior is used to carrying two axes because he can''t reach his enemy''s left side with his right hand. It''s hard to tell whether it is due to a lack of self-confidence or if he was just born clumsy!');
INSERT INTO "item_descriptions" VALUES(8828,'en','The Cheeken is an awkward, winged creature which has as much energy as a Tofu with avian flu.');
INSERT INTO "item_descriptions" VALUES(8829,'en','This hat is large enough to hide Barbrossa''s ridiculously hairless head and beard. But it won''t cover big-headed skulls.');
INSERT INTO "item_descriptions" VALUES(8833,'en','This hammer took its nice colour from the pieces of Coralator used to make it. Unlike what people think, it was not originally used to crush Iops and other enemies, but as a door-knocker for the hard of hearing.');
INSERT INTO "item_descriptions" VALUES(8834,'en','This branch was apparently used to scrape some otherwise inaccessible body part. But don''t worry, the dark colour is authentic, it''s got nothing to do with the various sorts of deposits contained in the inaccessible cavities of the Treeckler.');
INSERT INTO "item_descriptions" VALUES(8835,'en','This branch was apparently used to scrape some otherwise inaccessible body part. This might explain the stick''s stickiness.');
INSERT INTO "item_descriptions" VALUES(8836,'en','Rotaflors use their stem to clean their ears. Sculptors, however, prefer to use them as weapons. Proof, indeed, that there''s no accounting for taste.');
INSERT INTO "item_descriptions" VALUES(8837,'en','This staff completely binds the Zoth Master, making him fearless and therefore formidable. When it comes to eating though, it makes an awful mess.');
INSERT INTO "item_descriptions" VALUES(8838,'en','Just like weeds, Tynrils can breed infinitely thanks to this simple piece of rhizome. After making this discovery some greedy staffmakers made a staff from Tynril and tried to breed it. It was a miserable failure.');
INSERT INTO "item_descriptions" VALUES(8839,'en','This Voodoo mask serves primarily to hide and protect the faces of those who, like Thierry, like slingshots, but often miss their target.');
INSERT INTO "item_descriptions" VALUES(8840,'en','When Jav Kanniballs feel a little blue, they dye their hair this colour. Is it due to frustrated love or something else? Hard to know for sure, but it would be great if they could just wear the mask and stop telling everyone how sad they were.');
INSERT INTO "item_descriptions" VALUES(8841,'en','Many moons ago, the Kanniballs were travelling actors respected for their comedies and tragedies, as represented by two masks - one laughing, the other cruel. When their chief lost the happy mask, the Kanniballs descended into savagery.');
INSERT INTO "item_descriptions" VALUES(8842,'en','Kanniball archers can''t concentrate and aim right unless they are very angry. So, in order to be sure to see red at all times, they painted their masks this colour.');
INSERT INTO "item_descriptions" VALUES(8843,'en','When he puts on this hat, Crocodyl Dandy thinks he''s at the forefront of fashion. Fashion must be pretty dull if that''s the case. However, it''d be best if you didn''t let him know how ridiculous he looks, after all, he is particularly touchy.');
INSERT INTO "item_descriptions" VALUES(8844,'en','This hood serves as a royal headdress, and shares the same virtues as the Mopy King Sovereign Cape. Its micro-vents allow sweat to drain away more easily, so you''ll always have a cool head. Unfortunately, it shares the same defects as the cape: its foul stench is so strong, you could cut it with a knife.');
INSERT INTO "item_descriptions" VALUES(8845,'en','It may be less efficient than the Sovereign Hood, but it still allows for a good draining of the sweat. Maybe too good, actually. As a result, whether you wear it or not, it won''t make any difference.');
INSERT INTO "item_descriptions" VALUES(8846,'en','The Zoth Girl''s hat makes her see double. Strange. This is the reason she lisps.');
INSERT INTO "item_descriptions" VALUES(8847,'en','This helmet has the same advantages as other Zoth hats - it''ll protect you from the sun no matter how hot it is, from blows dealt on the head, and it prevents the wearer from being aware of the danger by restricting his visual field. Anyway, this is the perfect warrior headgear.');
INSERT INTO "item_descriptions" VALUES(8848,'en','The main advantage of the Zoth Master Hat is that it restricts your field of view far more than any other helmet. Thanks to this peculiarity, the wearer can use the famous fighting technique known as "The Weasel". In short, this method consists of striking anywhere using all your strength. As it''s completely unpredictable, you''re guaranteed to defeat your opponent (or at least surprise them enough to finish them off with a well-placed kick).');
INSERT INTO "item_descriptions" VALUES(8849,'en','This stick is a firm favourite with the trunk-women. But it''ll seduce any old kind of girl. Probably.');
INSERT INTO "item_descriptions" VALUES(8850,'en','If you''re superstitious and always need to knock on wood, use the Floramor Root! On the other hand, you should try to be careful not to saw the branch you''re sitting on and especially not to get your fingers in the way!');
INSERT INTO "item_descriptions" VALUES(8854,'en','You say that a kraken, with the foulest breath you''ve ever seen, follows you wherever you go? Well, deal with it: it''s only a tiny inconvenience that comes with the hat!');
INSERT INTO "item_descriptions" VALUES(8855,'en','This shield will protect you for now, but don''t be fooled, it won''t last.');
INSERT INTO "item_descriptions" VALUES(8856,'en','When the Bherb has got butterflies, he wears his Bherbal belt and healthily eliminates them.');
INSERT INTO "item_descriptions" VALUES(8858,'en','These boots create a disgusting suction noise with each step, which will remind you of a rutting Trool''s love chant if you''ve ever heard it. A painful memory that you could easily live without.');
INSERT INTO "item_descriptions" VALUES(8859,'en','This seal indicates that its owner is the undisputed sovereign of Otomai Island''s Bottomless Peat Bog, although it''s difficult to imagine a more pastoral kingdom...');
INSERT INTO "item_descriptions" VALUES(8860,'en','This ring was pulled off the still-warm finger of a freshly slaughtered Coralator. His mother was expecting him for dinner, until she saw he''d been transformed into a tombstone.  Coralators are not as stone-hearted as people might imagine.');
INSERT INTO "item_descriptions" VALUES(8861,'en','Only Kimbos, with their weird feet, feel comfortable in these sandals. However, they''re not the only ones who can benefit from their powers. But be careful not to wear them the wrong way!');
INSERT INTO "item_descriptions" VALUES(8862,'en','Parkinn Pan truly believed that he could fly thanks to this belt trimmed with Pikoko wings, but what he didn''t know was that very few Pikokos can actually fly. That''s why every time he jumped off the Tree Keeholo he routinely crashed to the forest floor below. His nickname "Cake" comes from "flat as a pancake".');
INSERT INTO "item_descriptions" VALUES(8863,'en','This amulet might be nothing more than a few pieces of wood bound with a strip of torn fabric, but the Zoths are absolutely convinced it has terrible powers. The doddery old fools!');
INSERT INTO "item_descriptions" VALUES(8864,'en','This bow string is made of Snailmet Slobber, not too dry with a unique elasticity. However, its slimy and gooey texture reminds you of, well, nothing really, but it''s quite unpleasant.');
INSERT INTO "item_descriptions" VALUES(8865,'en','Carved in a Snailmet carapace, this ring can resist anything and anyone.');
INSERT INTO "item_descriptions" VALUES(8866,'en','Woven from Zoth fabrics, this cape has extraordinary powers of unknown origin.');
INSERT INTO "item_descriptions" VALUES(8867,'en','With this cape on, you''ll be craving for some vinaigrette.');
INSERT INTO "item_descriptions" VALUES(8868,'en','The Cheeken Beak on this weapon is absolutely useless, and can be more of a handicap than anything else.
Fortunately, it is quite powerful.');
INSERT INTO "item_descriptions" VALUES(8869,'en','These boots are so heavy that they should actually be categorised as weapons. Indeed, they make the slightest kick lethal.');
INSERT INTO "item_descriptions" VALUES(8870,'en','Carved in a Dark Treeckler, this belt isn''t pliable enough to let you move around easily, but at least, it''ll protects you.');
INSERT INTO "item_descriptions" VALUES(8871,'en','Carved from a Light Treeckler, this belt won''t afford you great protection, but at least it is soft enough to let you move around freely.');
INSERT INTO "item_descriptions" VALUES(8872,'en','This jewel is not precious but is the perfect size to balance the moorgale in a nice belgroot flavoured with a hint of Glaviooze.');
INSERT INTO "item_descriptions" VALUES(8873,'en','Finally a good excuse to smell of the sea!');
INSERT INTO "item_descriptions" VALUES(8874,'en','This jewel sometimes tries to steal some of your food when you''re eating, so don''t let it hang down too low.');
INSERT INTO "item_descriptions" VALUES(8876,'en','This strange cape seems to be made of black ink, but oddly enough, it behaves just like fabric - it doesn''t run. As for stains, well, that''s another matter. Your backside will never be clean again.');
INSERT INTO "item_descriptions" VALUES(8877,'en','Once round your finger, you won''t be able to take it off, ever. Its suckers are way too powerful.');
INSERT INTO "item_descriptions" VALUES(8878,'en','This hammer is not handy, not particularly good looking, not very ergonomic, not powerful, too light, too fragile, unbalanced, too shiny and smelly. But at least it''s got pretty colours.');
INSERT INTO "item_descriptions" VALUES(8879,'en','Unfortunately, this ring is only polished on the outside. You put your finger through a hole full of sharp rock fragments. It is recommended for Sacriers.');
INSERT INTO "item_descriptions" VALUES(8880,'en','It''s the Mufafah moustaches that cause the wearer of this necklace to bellow so loudly. Why? They hang down and tickle the nipples constantly.');
INSERT INTO "item_descriptions" VALUES(8881,'en','Solo was a nice good-for-nothing, and he admitted as much himself. That didn''t stop him from being hanged on the village square for stealing a thong belonging to the chief''s wife. Solo wasn''t a bright guy, no, but he was a nice guy all the same.');
INSERT INTO "item_descriptions" VALUES(8918,'en','In theory, this helmet should keep your wig on your head if you decide to go ride a Scaraleaf. Simply priceless!');
INSERT INTO "item_descriptions" VALUES(8919,'en','These improved wooden wings have been padded and made lighter thanks to feathers and high-quality fabric. Since the frame is still in wood, it will be hard not to crash!');
INSERT INTO "item_descriptions" VALUES(8924,'en','Once upon a time, a man named Rahm got lost in the jungle. Have you heard of Viet Rham?');
INSERT INTO "item_descriptions" VALUES(8925,'en','This strange bow was carved by a Sadidette during a very productive sleep-stroll. Just looking at it makes you feel sleepy - that goes for the archer as well as the target.');
INSERT INTO "item_descriptions" VALUES(8926,'en','These daggers are perfect for pushing Pineapis and shaking trees, or pushing Pineapis and grinding coffee, if that''s what takes your fancy. Just remember: to the left, to the right, jump up and down and to the knees.');
INSERT INTO "item_descriptions" VALUES(8927,'en','Long ago there lived a mad Sram called Gaga... this guy, he robbed from the poor and gave to the rich.');
INSERT INTO "item_descriptions" VALUES(8928,'en','Porkeez is a better drinker than he is a fighter, and let me tell you he doesn''t get any better as time passes by. All the same I wouldn''t go around looking like a cork when he''s got his daggers out.');
INSERT INTO "item_descriptions" VALUES(8929,'en','This should not be mistaken for the famous staff of similar name. The blades on this implement spill far more blood.');
INSERT INTO "item_descriptions" VALUES(8930,'en','Many a proud adventurer refused this weapon because of its colour. Many the same died by its blade.');
INSERT INTO "item_descriptions" VALUES(8931,'en','This sword used to belong to an old, power-hungry Enutrof. Just like his ego, it''s made of solid gold.');
INSERT INTO "item_descriptions" VALUES(8932,'en','Smile! Say cheese! Perfect! Sliced in half!');
INSERT INTO "item_descriptions" VALUES(8933,'en','Ourag''han was an old Pandawa with skin so soft he was known as Slippiderm. His odour on the other hand gave rise to another name altogether. He christened his trusty axe likewise.');
INSERT INTO "item_descriptions" VALUES(8934,'en','Driven into a horticidal rage when a mischievous squirrel stole a grain of his rice during a summer holiday on Pandala Island, Brouce Boulgoure used this axe to flatten each and every bamboo shoot the squirrel hopped onto.  The Pandawas in the village had to feed him half their stock of bamboo wine to keep him from razing the entire forest. Trust old Broucey.');
INSERT INTO "item_descriptions" VALUES(8935,'en','Even as a young Iopette, Mel dreamt of slaying dragons. With a spade for a sword and a rock for a dragon, she honed her skills in the back yard. The mere mention of a shovel now has the poor rock in convulsions.');
INSERT INTO "item_descriptions" VALUES(8936,'en','This is a wild shovel which tries to bite its owner each time it''s picked up. It makes the most unusual sounds when it''s happy and can only be pacified with the soothing sound of chimes.');
INSERT INTO "item_descriptions" VALUES(8937,'en','A cunning Enutrof became a pirate after noticing that there were more treasures to be found on fresh corpses than in rotten graves. This blood-red shovel was his symbol and filled the sailors of the Asse Sea with terror.');
INSERT INTO "item_descriptions" VALUES(8941,'en','This sword will teach you that there''s a bit of misfortune hidden in the best of luck.');
INSERT INTO "item_descriptions" VALUES(8956,'en','This sword will teach you that there''s a bit of misfortune hidden in the best of luck.');
INSERT INTO "item_descriptions" VALUES(8957,'en','This sword will teach you that there''s a bit of misfortune hidden in the best of luck.');
INSERT INTO "item_descriptions" VALUES(8958,'en','Ecaflip held out his godly paw to you but all you found was a claw, and it''s not as sharp as you first thought. Maybe it wasn''t a god after all.');
INSERT INTO "item_descriptions" VALUES(8959,'en','Ecaflip held out his godly paw to you but all you found was a claw, and it''s not as sharp as you first thought. Maybe it wasn''t a god after all.');
INSERT INTO "item_descriptions" VALUES(8960,'en','Ecaflip held out his godly paw to you but all you found was a claw, and it''s not as sharp as you first thought. Maybe it wasn''t a god after all.');
INSERT INTO "item_descriptions" VALUES(8961,'en','Superstitious folk believe that a simple wodent leg around the neck can bring you luck and fortune. Thanks to this legendary sword, they''ll gaze upon you with awe. Plus, its blade is extremely sharp, and it reminds you of another sword you used to know.');
INSERT INTO "item_descriptions" VALUES(8962,'en','Superstitious folk believe that a simple wodent leg around the neck can bring you luck and fortune. Thanks to this legendary sword, they''ll gaze upon you with awe. Plus, its blade is extremely sharp, and it reminds you of another sword you used to know.');
INSERT INTO "item_descriptions" VALUES(8963,'en','Superstitious folk believe that a simple wodent leg around the neck can bring you luck and fortune. Thanks to this legendary sword, they''ll gaze upon you with awe. Plus, its blade is extremely sharp, and it reminds you of another sword you used to know.');
INSERT INTO "item_descriptions" VALUES(8964,'en','"Fortune favours the brave", whisper the disciples of Ecaflip. Now you''re ready, you''ll be able to show us how you play. This pure, prestigious sword is extremely rare.');
INSERT INTO "item_descriptions" VALUES(8965,'en','"Fortune favours the brave", whisper the disciples of Ecaflip. Now you''re ready, you''ll be able to show us how you play. This pure, prestigious sword is extremely rare.');
INSERT INTO "item_descriptions" VALUES(8966,'en','This sword represents the incarnation of the god Ecaflip''s luck. You''re holding in your hands the purest version of the Ecaflip Paw, which testifies to your incredible, yet somehow undignified, luck.');
INSERT INTO "item_descriptions" VALUES(8989,'en','If you spin around at the speed of sound while wearing this helmet, you''ll take off. As for landing, well, you''ll have to sort it out.');
INSERT INTO "item_descriptions" VALUES(8991,'en','This cold, slimy ring never stops sucking on your finger from the minute you slip it on. If you can see past its flaws, however, its great powers are yours to wield.');
INSERT INTO "item_descriptions" VALUES(8992,'en','This blade cuts wheat as well as enemies, but it also makes your allies extremely jealous. That''s the destiny of powerful people.');
INSERT INTO "item_descriptions" VALUES(8993,'en','This sword holds an immense power of which the many victims fill chapters in the history books. It''s said there''s also a cursed scythe, but only the most famous farmer could confirm that.');
INSERT INTO "item_descriptions" VALUES(9001,'en','This shield will remind your opponents you grew up in the Sidimote Moors. That alone could be enough to scare them away.');
INSERT INTO "item_descriptions" VALUES(9002,'en','This shield is covered with peepers to allow you to give one of those devastating multi-evil-eyes. Unstoppable.');
INSERT INTO "item_descriptions" VALUES(9003,'en','The Innkeeper at the Feubuk Brewery in Bonta was bored to death one day when he suddenly got the idea of equipping his bouncers with neon advertising shields.');
INSERT INTO "item_descriptions" VALUES(9004,'en','Looking to fend off a frenzied attack? This shield from the village of Akwadala should do the trick.');
INSERT INTO "item_descriptions" VALUES(9005,'en','When your allies run out of breath, or when you want to clear the air after an unexpected wind of panic, this shield can save your life. The only thing you need to do is to shake it energetically in all directions, like you''d do with a hungry baby.');
INSERT INTO "item_descriptions" VALUES(9006,'en','Sadidas originally used this shield as a stool when they needed to rest. If you tuck in your feet, it will protect you from a wide range of attacks. Nothing will protect you from the cruel laughter of your opponents, however.');
INSERT INTO "item_descriptions" VALUES(9007,'en','This surprising creation is covered in a pair of Chafer Lancer Leather Briefs which have been boiled, cleaned and stretched so that they hug the arm as perfectly as they did the full, generous curves of Chafer Lancer''s... I think that''s quite enough of that actually.');
INSERT INTO "item_descriptions" VALUES(9008,'en','This magnificent shield contains a few drops from the Asse Sea. Not only does it bring good luck but it can also be used as a flask.');
INSERT INTO "item_descriptions" VALUES(9009,'en','Hidden behind this shield, some naive adventurers could mistake you for a Treechnid and run off screaming. Most will attack all the more eagerly, thinking they can get some amber out of you.');
INSERT INTO "item_descriptions" VALUES(9010,'en','Perfect if you want to fit in on Pandala, or to stand out anywhere else! The biggest advantage of this shield is that it''s entirely covered with hypoallergenic Pandawa hair, so now you don''t need to pack your underwear and your armour in separate suitcases when you take your vacation.');
INSERT INTO "item_descriptions" VALUES(9011,'en','This special shield will protect you from the Fire element and will also give your opponents plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(9012,'en','This special shield will protect you from the Air element and will also give your opponents plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(9013,'en','This special shield will protect you from the Earth element and will also give your opponents plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(9014,'en','This special shield will protect you from the Water element and will also give your opponents plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(9015,'en','This shield used to protect lumberjacks from falling trees. Its function quickly changed and now it is more often used to protect warriors from enemies who tend to land on them without warning!');
INSERT INTO "item_descriptions" VALUES(9016,'en','Greenish and smelly, this shield remains a first choice for protection when it comes to fighting the creatures of green and smelly Mount Stinkky.');
INSERT INTO "item_descriptions" VALUES(9017,'en','If your dearest dream is to become a real imp, this is the shield you need. Passed down from generation to generation, it will enable you to rob all the young Astrubian adventurers you like without getting hurt.');
INSERT INTO "item_descriptions" VALUES(9018,'en','A renowned adventurer spent his whole life looking for all four quarters of this shield. Some say that when the shield is complete, it has the exact opposite effect of that of breaking a mirror.');
INSERT INTO "item_descriptions" VALUES(9019,'en','Not all Wabbits are nice little creatures. In fact, all Wabbits are vile creatures. Some get their kicks smashing up Cawwots with this huge shield and taking baths in the juice.');
INSERT INTO "item_descriptions" VALUES(9020,'en','This shield of skin will fit you like a glove. Don''t forget to treat its warts and furuncles from time to time to prevent them from getting worn.');
INSERT INTO "item_descriptions" VALUES(9021,'en','A young adventurer once dreamt of joining the Bonta militia to protect the oppressed. Considered morally unfit for service, he was contacted by an Amakna alchemist who took advantage of his good nature, using him as a guinea-pig for his potions. You''ll be glad to know that this is one story that ends... well, the middle bit is happy. He became so strong that he was known forever more as Captain Amakna and had this reputedly indestructible shield forged for him. The end... well, you don''t wanna know the end.');
INSERT INTO "item_descriptions" VALUES(9022,'en','This huge shield saved the famous adventurer Kloome from an awful death: squashed under the weight of a Crackler who was in love with him. The legend doesn''t say if he survived the side effects of his subsequent romance with the stony beast.');
INSERT INTO "item_descriptions" VALUES(9023,'en','As strange as it might sound, some say this shield of wood and hair enables the lightest adventurers to become airborne for a brief moment... a final attempt to shock their enemies before falling flat on their faces.');
INSERT INTO "item_descriptions" VALUES(9024,'en','LeChouque used this shield to protect himself from the friendly cannonballs his friends regularly tossed to him. Some crazy stories tell that some of those balls were alive.');
INSERT INTO "item_descriptions" VALUES(9025,'en','Although it''s all but useless, its stench alone will spread your fame far and wide. This shield accompanies many young adventurers on their first quests - maybe that''s why so few make it to thirty.');
INSERT INTO "item_descriptions" VALUES(9026,'en','This shield is a tribute to Bowisse''s Cloak which itself was a tribute to a famous relic composed of three triangular shapes. Blimey, all this history is putting me to sleep.');
INSERT INTO "item_descriptions" VALUES(9027,'en','This stone shield is in fact made from a Crackler''s head, smashed by the foot of a Minotoror. A perfect combination of big head and smelly feet.');
INSERT INTO "item_descriptions" VALUES(9028,'en','Looking to fend off a frenzied attack? This shield from the village of Terrdala should do the trick.');
INSERT INTO "item_descriptions" VALUES(9029,'en','Looking to fend off a frenzied attack? This shield from the village of Feudala should do the trick.');
INSERT INTO "item_descriptions" VALUES(9030,'en','Looking to fend off a frenzied attack? This shield from the village of Aerdala should do the trick.');
INSERT INTO "item_descriptions" VALUES(9031,'en','In his time, Gore Master was very strong and had all he needed - money, women and more. He didn''t quite deserve all of it since he got his strength from his nice ring. Until the day he carelessly crossed the street. And BAM! No more Gore Master. Since then, unscrupulous people pass it on to other unscrupulous people.');
INSERT INTO "item_descriptions" VALUES(9117,'en','Ougaa had a head thicker than anyone else, which is why a hammer created from the skull of this redoubtable deity is perfect for crushing those of others.');
INSERT INTO "item_descriptions" VALUES(9122,'en','Once it wraps its Bloppish way around your finger, it''s impossible to get rid of this ring.');
INSERT INTO "item_descriptions" VALUES(9123,'en','Once it wraps its Bloppish way round your finger, it''s impossible to get rid of this ring.');
INSERT INTO "item_descriptions" VALUES(9124,'en','Once it wraps its Bloppish way round your finger, it''s impossible to get rid of this ring.');
INSERT INTO "item_descriptions" VALUES(9125,'en','Once it wraps its Bloppish way round your finger, it''s impossible to get rid of this ring.');
INSERT INTO "item_descriptions" VALUES(9126,'en','Kroula had a plan. He was going to put this ring on his big toe, get Blops to lick his feet and collect litres of Royal Blop juice. Well, the ring didn''t fit.');
INSERT INTO "item_descriptions" VALUES(9127,'en','Kroula had a plan. He was going to put this ring on his big toe, get Blops to lick his feet and collect litres of Royal Blop juice. Well, the ring didn''t fit.');
INSERT INTO "item_descriptions" VALUES(9128,'en','Kroula had a plan. He was going to put this ring on his big toe, get Blops to lick his feet and collect litres of Royal Blop juice. Well, the ring didn''t fit.');
INSERT INTO "item_descriptions" VALUES(9129,'en','Kroula had a plan. He was going to put this ring on his big toe, get Blops to lick his feet and collect litres of Royal Blop juice. Well, the ring didn''t fit.');
INSERT INTO "item_descriptions" VALUES(9130,'en','This rough copy of the great Ougaa should be worn around the neck, with a hungry stare and a well-kept beard to boot.');
INSERT INTO "item_descriptions" VALUES(9131,'en','A young Cra named Colette lost her head in Eltneg Wood. The poor girl stepped in the way of Brouce Boulgoure''s hatchet, which he threw thinking she was a giant fern. Lucky she didn''t live – she would have died had she found out she looked like a giant fern.');
INSERT INTO "item_descriptions" VALUES(9132,'en','Are you too young to get into the good clubs? Are you nervous around girls? Well, stick this ring on your finger, and hold it in front of your upper lip. It''ll add a few years to your age and do wonders for your self-confidence. Just don''t go out in strong winds, or it''ll blow away, like your quickly evaporating self-esteem.');
INSERT INTO "item_descriptions" VALUES(9133,'en','If your enemies are allergic to mushrooms, let them nibble your fingers.');
INSERT INTO "item_descriptions" VALUES(9134,'en','This bow is made from sharp, thin, very flexible slats that are more often used to make beds than deadly weapons. Now they''re used to bring on a more permanent sort of sleep.');
INSERT INTO "item_descriptions" VALUES(9135,'en','Originally, blowing hard into this trumpet-shaped fungal wand would call Jon Lemon, the wandering minstrel, to the scene of battle. He''d then begin singing and everyone who hadn''t blocked their ears would die on the spot. Since this made it a bit too easy to kill monsters, the gods decided to plug the trumpet and turn it into a relatively harmless wand.');
INSERT INTO "item_descriptions" VALUES(9136,'en','The three points of this staff attract particles of plasmogrine present in the quadramental breeze. Carefully lick the points of the stick, align them with the hands of an inverted Xelor clock, count to sixty (try six if you''re a Iop) and squeeze your buttocks together. You''ll have a fifty-fifty chance of being hit by lightning or turning your enemies into grizzly Kirballs.');
INSERT INTO "item_descriptions" VALUES(9137,'en','These knives were once used to remove the fungus that infested the feet of adventurers. Removing the fungus actually means removing both feet, just below the knees.');
INSERT INTO "item_descriptions" VALUES(9138,'en','The different blades of this axe can be used to cut sausage very quickly. One blow is sufficient to produce three slices. It''s not quite as useful when it comes to killing enemies, unless you''re used to eating nothing but sliced food, of course.');
INSERT INTO "item_descriptions" VALUES(9139,'en','These boots are the perfect thing to put on if you want to go for a walk in the woods without crushing any dead leaves. You''ll need to be careful, however, as their vegetal origins inevitably drive them to crush anything remotely related to manure.');
INSERT INTO "item_descriptions" VALUES(9140,'en','Contrary to popular misconception, the holes in these shoes are not there to let your feet breathe, but to let the spawn of your foot fungus escape and infect the feet of other footloose adventurers.');
INSERT INTO "item_descriptions" VALUES(9141,'en','If there wasn''t so much mould on this rag, it would make a great tablecloth. Not to worry, you can always dry the dishes with it when your guests aren''t watching.');
INSERT INTO "item_descriptions" VALUES(9142,'en','One more glass for the road? Ah, well, roads are long and nights are short, so this cape is usually used to keep the barflies warm as they finish their endless rounds of night caps. It''ll kill them in the end, you know.');
INSERT INTO "item_descriptions" VALUES(9143,'en','As its name suggests, this string assassinates any flies that get too close to your sweet spots. Just one piece of advice - never, ever pull it off a loved one with your teeth.');
INSERT INTO "item_descriptions" VALUES(9144,'en','The best way to solve crotch fungus is to lure it elsewhere. As there''s no longer room between your toes to accommodate any more fungi, you can use this belt, a truly impressive residence for any fungus worthy of the name.');
INSERT INTO "item_descriptions" VALUES(9145,'en','Take an Elm, strip the bark off, soak it for a few months in a muddy puddle, cover it with fungal infections, stick it under your bed for a week while you sleep on the floor, basting it regularly with Blop fat. All you need to know to make an Elm belt that stinks. Are you happy now?');
INSERT INTO "item_descriptions" VALUES(9146,'en','The tag on this belt says ''Sorry, but if you''re looking for a way to get Ougaa''s power, this belt is not for you.''
Well that''s just great, isn''t it.');
INSERT INTO "item_descriptions" VALUES(9147,'en','Take a Dora, cover it in Gobball Slobber and Iop sweat, let it stew for a couple of weeks and you''ll get an idea of the intoxicating effects of the Mush Ombrero. Try to stay away from heavy machinery while you wear it. In fact, stay away from anything that''s heavy.');
INSERT INTO "item_descriptions" VALUES(9148,'en','Instead of cutting down on impure Blop juice, Shika Ingalsse pressed on with her harvest through her inebriated state. One day, as she was stumbling and falling through the golden fields, Shika landed on this ring. Whoever said that impure Blop juice should be taken in moderation?');
INSERT INTO "item_descriptions" VALUES(9149,'en','When Lorkos set off on his trip to the Labyrinth of the Minotoror, the first thing he did was put on his Amublop. No one ever found out why.');
INSERT INTO "item_descriptions" VALUES(9150,'en','When Lorkos set off on his trip to the Labyrinth of the Minotoror, the first thing he did was put on his Amublop. No one ever found out why.');
INSERT INTO "item_descriptions" VALUES(9151,'en','When Lorkos set off on his trip to the Labyrinth of the Minotoror, the first thing he did was put on his Amublop. No one ever found out why.');
INSERT INTO "item_descriptions" VALUES(9152,'en','When Lorkos set off on his trip to the Labyrinth of the Minotoror, the first thing he did was put on his Amublop. No one ever found out why.');
INSERT INTO "item_descriptions" VALUES(9153,'en','This Amublop costs a lot more to make than an ordinary Amublop, but look on the bright side... it will sell for a lot more too, especially if you offload it on an Astrubian.');
INSERT INTO "item_descriptions" VALUES(9154,'en','This Amublop costs a lot more to make than an ordinary Amublop, but look on the bright side... it will sell for a lot more too, especially if you offload it on an Astrubian.');
INSERT INTO "item_descriptions" VALUES(9155,'en','This Amublop costs a lot more to make than an ordinary Amublop, but look on the bright side... it will sell for a lot more too, especially if you offload it on an Astrubian.');
INSERT INTO "item_descriptions" VALUES(9156,'en','This Amublop costs a lot more to make than an ordinary Amublop, but look on the bright side... it will sell for a lot more too, especially if you offload it on an Astrubian.');
INSERT INTO "item_descriptions" VALUES(9157,'en','They have to put heaps of artificial colourants and flavourings into this amulet to stop it coming out white when it''s crafted. A word of advice, it might look great and smell delicious, but don''t try to eat it.');
INSERT INTO "item_descriptions" VALUES(9158,'en','Does it make your mouth feel funny when you say the name of this object? Well, let me tell you, if you find yourself face-to-face with a highway robber who asks you for your ''Boot... Bloops... Bloo...'', you''ll be glad you have just enough time to scurry off while he figures out how to pronounce the word. So stop your complaining.');
INSERT INTO "item_descriptions" VALUES(9159,'en','Does it make your mouth feel funny when you say the name of this object? Well, let me tell you, if you find yourself face to face with a highway robber who asks you for your ''Boot.. Bloops... Bloo...'', you''ll be glad to have just enough time to scurry off while he figures out how to pronounce the word. So stop your complaining.');
INSERT INTO "item_descriptions" VALUES(9160,'en','Does it make your mouth feel funny when you say the name of this object? Well, let me tell you, if you find yourself face to face with a highway robber who asks you for your ''Boot.. Bloops... Bloo...'', you''ll be glad to have just enough time to scurry off while he figures out how to pronounce the word. So stop your complaining.');
INSERT INTO "item_descriptions" VALUES(9161,'en','Does it make your mouth feel funny when you say the name of this object? Well, let me tell you, if you find yourself face to face with a highway robber who asks you for your ''Boot.. Bloops... Bloo...'', you''ll be glad to have just enough time to scurry off while he figures out how to pronounce the word. So stop your complaining.');
INSERT INTO "item_descriptions" VALUES(9162,'en','Say the word Bloopts ten times fast while spinning round in circles. Now you know what it feels like to be a Iop.');
INSERT INTO "item_descriptions" VALUES(9163,'en','Say the word Bloopts ten times fast while spinning round in circles. Now you know what it feels like to be a Iop.');
INSERT INTO "item_descriptions" VALUES(9164,'en','Say the word Bloopts ten times fast while spinning round in circles. Now you know what it feels like to be a Iop.');
INSERT INTO "item_descriptions" VALUES(9165,'en','Say the word Bloopts ten times fast while spinning round in circles. Now you know what it feels like to be a Iop.');
INSERT INTO "item_descriptions" VALUES(9166,'en','Some people let the grass grow under their feet. With these boots, you''ll have enough foliage for four weddings and a funeral.');
INSERT INTO "item_descriptions" VALUES(9167,'en','Behind the silly name is a belt. A belt that we don''t know much about. Its original design and its magical ability to conceal the worst love-handles known to science ensure this is always a favourite with image-conscious, middle-aged men.');
INSERT INTO "item_descriptions" VALUES(9168,'en','Behind the silly name is a belt. A belt that we don''t know much about. Its original design and its magical ability to conceal the worst love-handles known to science ensure this is always a favourite with image-conscious middle-aged men.');
INSERT INTO "item_descriptions" VALUES(9169,'en','Behind the silly name is a belt. A belt that we don''t know much about. Its original design and its magical ability to conceal the worst love-handles known to science ensure this is always a favourite with image-conscious middle-aged men.');
INSERT INTO "item_descriptions" VALUES(9170,'en','Behind the silly name is a belt. A belt that we don''t know much about. Its original design and its magical ability to conceal the worst love-handles known to science ensure this is always a favourite with image-conscious middle-aged men.');
INSERT INTO "item_descriptions" VALUES(9171,'en','The tiniest bluesman in the World is playing the blues for this belt on the tiniest guitar in the World. It lost its buckle. If belts could cry, this one would never stop sobbing.');
INSERT INTO "item_descriptions" VALUES(9172,'en','The tiniest bluesman in the World is playing the blues for this belt on the tiniest guitar in the World. It lost its buckle. If belts could cry, this one would never stop sobbing.');
INSERT INTO "item_descriptions" VALUES(9173,'en','The tiniest bluesman in the World is playing the blues for this belt on the tiniest guitar in the World. It lost its buckle. If belts could cry, this one would never stop sobbing.');
INSERT INTO "item_descriptions" VALUES(9174,'en','The tiniest bluesman in the World is playing the blues for this belt on the tiniest guitar in the World. It lost its buckle. If belts could cry, this one would never stop sobbing.');
INSERT INTO "item_descriptions" VALUES(9175,'en','If you tighten this belt fully, you can shut down your digestive system completely. Why you would want to do this is another question entirely.');
INSERT INTO "item_descriptions" VALUES(9176,'en','Jon Lemon created his last and greatest song as he was being slaughtered by the Bworker and this very blade. Goes a little something like - ''I heard the news today oh boy, Ten thousand holes all over meeeee''. Thank the gods that Bworker had the good sense to jot down the words and music of the ditty.');
INSERT INTO "item_descriptions" VALUES(9177,'en','The three points of this bracelet represent the three major weaknesses of the Bworker: Thirst for vengeance, thirst for victory and, well, thirst for liquids.');
INSERT INTO "item_descriptions" VALUES(9178,'en','This ring is covered in little bits of nose rubble from the Bworker''s shnoz. The dirty creature uses the sharp points to achieve that perfect pick.');
INSERT INTO "item_descriptions" VALUES(9179,'en','When a certain Captain Chafer met the Bworker for the first time, he took the liberty of saying ''Wow, is that your backside or is it your face?'' Nobody has seen the good Captain, or his famous moulded underwear, since. This amulet was created in his memory.');
INSERT INTO "item_descriptions" VALUES(9180,'en','The story goes that the Bworker sewed this cape from Rushu''s butt skin. The story would be entirely believable if the Bworker actually knew how to sew.');
INSERT INTO "item_descriptions" VALUES(9181,'en','This beautiful helmet holds its fair share of secrets. For many years before it died, it was the Bworker''s only companion. While it was still alive, he told it many stories about used protectives. It was having to listen to these atrocities that led to the helmet''s death.');
INSERT INTO "item_descriptions" VALUES(9182,'en','A long, long time ago, Danous Kwaide wanted to be clever and beat the Bworker in a baiting contest: "Your boots are covered with earrings because you''re too stupid to realise that you''re not supposed to put boots in your ears", he teased. The Bworker replied by crushing Danous'' skull with his axe. Do you blame him? Do you even understand what Danous was going on about? No, neither do I.');
INSERT INTO "item_descriptions" VALUES(9183,'en','This belt is used in the feast of the Dofus eggs which celebrates the gift of the six eggs, as recorded in the Biibl, an ancient text written by a Bontarian Joiner. Most people just paint ordinary eggs to look like Dofus and give them to one another, but some go a bit further, wearing this painful belt for the forty days and nights which precede the feast.');
INSERT INTO "item_descriptions" VALUES(9186,'en','Beyond his love for porcelain vases, there''s little we know about Flash Gorgone. One legend says he was always in such a hurry that he could out run a Tofu... He learnt his lesson when he rushed out of bed one morning and tied his belt round his ankles. His porcelain collection still remembers that like it was yesterday.');
INSERT INTO "item_descriptions" VALUES(9192,'en','With this attractive and delicious belt, the bigger your love handles are, the better!');
INSERT INTO "item_descriptions" VALUES(9193,'en','This amulet will remind you of the happy days, the picnic days, the days before you turned into... this.');
INSERT INTO "item_descriptions" VALUES(9198,'en','If you find yourself stuck with a tasteless beer or coffee, stick this ring in there for a while.');
INSERT INTO "item_descriptions" VALUES(9199,'en','Look what you''ve done. Just look. Trying to smash coffee cups with your boots... what were you thinking?');
INSERT INTO "item_descriptions" VALUES(9366,'en','This pink tutu will be ideal for showing your little behind off at the New Year''s festivities. Made of ancestral cotton and stretchy Sponge Mob mousse, soft and comfortable with a swishing skirt, this piece could be the first in a long line of tutus for a future star dancer.');
INSERT INTO "item_descriptions" VALUES(9394,'en','This headgear will give Mitcho-class style to anyone who wears it. It does have a strong smell of undergrowth that your friends could do without.');
INSERT INTO "item_descriptions" VALUES(9395,'en','For several years this Bloprown was worn by Kuri herself, until the fickle gods of fashion mocked her for her taste in crappy hats and she stuffed it to the back of her wardrobe to gather dust with her Feca-style Wig, Youllbea Mantle, and fluff-covered Consolation Candies.');
INSERT INTO "item_descriptions" VALUES(9396,'en','In the ancient language of the Lenalds, it''s name is "Zawooin Ling", which means the cursed seal of the Zawooins.');
INSERT INTO "item_descriptions" VALUES(9402,'en','The little wings attached to these slippers will give smelly feet some fresh air... But be careful, don''t use them to play Gobbowl... Gobballs may not particularly like getting stung on the arse...');
INSERT INTO "item_descriptions" VALUES(9408,'en','This ring will turn you into a Lousy Pig, which should satisfy your closest friends.');
INSERT INTO "item_descriptions" VALUES(9409,'en','This little cork-screw shaped tail will bring out the jealousy of the people around you.');
INSERT INTO "item_descriptions" VALUES(9412,'en','The sling of this belt is tightly tied to it, so tightly tied that you won''t be able to take it off. It will only impress highwayboys you''ll meet.');
INSERT INTO "item_descriptions" VALUES(9413,'en','The spurs on these boots will enable you to cut up your Dragoturkey when you decide it''s time to eat it.');
INSERT INTO "item_descriptions" VALUES(9416,'en','If your water becomes tasteless, just stick this ring on your finger, stick your finger in the glass and vigorously stir it in until it falls off. There you go! A delicious blood orange and lemon mixture... and one finger less. You can''t have it all, you know.');
INSERT INTO "item_descriptions" VALUES(9452,'en','This ring will make your finger radiant.');
INSERT INTO "item_descriptions" VALUES(9453,'en','With this belt around your hips, no one will ever dare pinch you again for fear of having their fingers cut off.');
INSERT INTO "item_descriptions" VALUES(9454,'en','This amulet can be used as a bib for both the young and the old.');
INSERT INTO "item_descriptions" VALUES(9455,'en','You can wear this ring as a toe ring if you need to snuff out your foot odour.');
INSERT INTO "item_descriptions" VALUES(9461,'en','The Kimbo is said to wear this wig to pay tribute to a handsome, perfectly tanned young man that he met on his island. What a wonderful smile he had! Anyway, he hides the ridiculous wig under his coco.');
INSERT INTO "item_descriptions" VALUES(9463,'en','This jewel is so powerful that it''d kill a Moskito from 30 paces, if only its smell didn''t prevent anything from getting that close!');
INSERT INTO "item_descriptions" VALUES(9464,'en','This scary amulet was hidden away in a remote mansion for ages. When it was alive, it used to dream of travelling around the World and all the places it would see. In the end, the only place it got to go around is your neck, the poor thing!');
INSERT INTO "item_descriptions" VALUES(9468,'en','This dangerous shovel will steal your Vitality, your youth, the water in your body and your precious Troofles.');
INSERT INTO "item_descriptions" VALUES(9469,'en','Made from pieces of fungi, this sword is perfect for infecting your enemies'' bowels.');
INSERT INTO "item_descriptions" VALUES(9542,'en','These shoes are very shiny even when they''re worn out. They''re perfect for impressing your opponents when they get them right in their faces.');
INSERT INTO "item_descriptions" VALUES(9543,'en','This heavy ring will give more power to your slaps and more passion to your caresses...');
INSERT INTO "item_descriptions" VALUES(9549,'en','The motto of the tailor who made this wonder was "Even in the heart of the action, your pants must always remain up your behind which they will thanks to these high quality flax suspenders". This really isn''t a good motto...');
INSERT INTO "item_descriptions" VALUES(9575,'en','This belt is reversible and can be worn according to what you wish to hide or show.');
INSERT INTO "item_descriptions" VALUES(9576,'en','Made from Black Wabbit backside skin, you''ll be able to take your revenge on those nasty little creatures with these butt skin boots, as they''ll feel like they''re kicking their own butt every time you kick something. It''s the simple pleasures that count.');
INSERT INTO "item_descriptions" VALUES(9594,'en','This Gobtubby seems perfectly normal, other than its wool being black in parts... Give it time and you might be surprised!');
INSERT INTO "item_descriptions" VALUES(9617,'en','This little ball of fur is more resistant to the cold than an ordinary Bow Meow. It''s softer to stroke, but it''s even more annoying than its short-haired cousin.');
INSERT INTO "item_descriptions" VALUES(9619,'en','This creature is a little stupid. The only way to make it move forward is to attach a Cawwot and stick to its back. Fortunately, it has been well trained, so it won''t be breaking wind in a panic.');
INSERT INTO "item_descriptions" VALUES(9620,'en','This Minimino was brought up by Minotot himself. Unfortunately, the beast''s character rubbed off on the innocent creature, along with some nasty body odours from being cuddled.');
INSERT INTO "item_descriptions" VALUES(9623,'en','Don''t be fooled: this creature''s pointed teeth will end up in your backside one day, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(9624,'en','Take a Pink Dragoone, plunge it into a pot of black dye, throw some gold dust on it, dip it in oil, then water – now you have a Black Dragoone.');
INSERT INTO "item_descriptions" VALUES(9627,'en','Certain adventurers whom the gods have chosen may use this staff to aid their neighbours. What a noble quest you have before you!');
INSERT INTO "item_descriptions" VALUES(9655,'en','The soles of these sandals are thicker than regular sandals to make sure they''ll resist the weight of the heavier Alowas.');
INSERT INTO "item_descriptions" VALUES(9656,'en','These roller skates make it easier to go down stairs but considerably increase the risk of you breaking a few bones. It''s up to you to take that risk.');
INSERT INTO "item_descriptions" VALUES(9658,'en','This amulet is a mere flower necklace. It''s supposed to give off a magic smell and transform an Alowa into an Alowaian...');
INSERT INTO "item_descriptions" VALUES(9659,'en','Erala wore this amulet for her entire childhood. No one knows what''s inside it, not even her.');
INSERT INTO "item_descriptions" VALUES(9662,'en','Adventurers like to collect this kind of rings but no one really knows why.');
INSERT INTO "item_descriptions" VALUES(9667,'en','Slait can now walk on his new wooden floors without scratching them.');
INSERT INTO "item_descriptions" VALUES(9785,'en','This minor demon fresh out of the Shustuft Crust will accompany you everywhere you roam, from the Astrub Zaap to the cemetery, and maybe even from the cemetery to the Astrub Zaap. Like all its peers, and like you, it has a single obsessions: destroying everything until nothing remains.');
INSERT INTO "item_descriptions" VALUES(9919,'en','Take on the appearance of an owl.');
INSERT INTO "item_descriptions" VALUES(9921,'en','They say this bracelet is shiny, but only when you''re in an inn or in the middle of the night.');
INSERT INTO "item_descriptions" VALUES(9922,'en','This belt has an incredibly powerful built-in magnet that keeps it shut without a buckle. Not recommended for wear with lead undergarments.');
INSERT INTO "item_descriptions" VALUES(9923,'en','The headspinners among you will have very little use for these shoes, but if you use your feet from time to time, they''re just what you need.');
INSERT INTO "item_descriptions" VALUES(9925,'en','This ring is closer to a glove or a mitten than a wedding ring, but who cares, no one will ever shake your hand the same way again.');
INSERT INTO "item_descriptions" VALUES(9927,'en','If you wear these boots when climbing Mount Jifu, you''re almost guaranteed to see strange UFO flying across the sky.');
INSERT INTO "item_descriptions" VALUES(9928,'en','These boots take approximately 12 hours to tie up and slightly longer to get off. That gives you just enough time to get some sleep every day or so, so long as you''re single, unemployed, and very good with your hands.');
INSERT INTO "item_descriptions" VALUES(9929,'en','The Achilles heel isn''t always below the knees, you know. Sometimes it''s just below the waist. In that case, this heavy but effective belt will give all those wieners among you peace of mind and sackfulls of confidence.');
INSERT INTO "item_descriptions" VALUES(9942,'en','This ring is also known as the Black Band, but in spite of its two names, it remains unfinished. Even so, it''s powerful enough to destroy a small planet.');
INSERT INTO "item_descriptions" VALUES(9943,'en','These shoes are rumoured to have been eaten by a starved gold miner only to be stitched back together when they came out the other end. That must be why they''re so shiny.');
INSERT INTO "item_descriptions" VALUES(9944,'en','This charm is an amulet and a cravat in one, and it''ll give you the air of a gentleman even when you''re down and out.');
INSERT INTO "item_descriptions" VALUES(9961,'en','This stone hammer was invented to lure smiths into believing that they were holding a hammer of excellent quality. It is strongly advised that you do not touch it, better still, do absolutely nothing with it at all.');
INSERT INTO "item_descriptions" VALUES(9972,'en','This hammer, to be used in a forge, was created for a specific purpose, which makes it difficult to use for anything else. Only someone desperate or on the margins of society would use it to make weapons.');
INSERT INTO "item_descriptions" VALUES(9974,'en','This slasher is for slashing handles, not candles. You can dangle a candle on your sandals, you vandal, but the scandal would be too much for Randall to handle. And no, I don''t know who Randall is, either.');
INSERT INTO "item_descriptions" VALUES(10054,'en','This ring spent three years in a pool of Borbat guano. It''s still magic, though.');
INSERT INTO "item_descriptions" VALUES(10055,'en','This amulet is supposed to stop vampyres sucking your blood. The idea is that they''re meant to believe you''re a vampyre too.');
INSERT INTO "item_descriptions" VALUES(10056,'en','This belt not only glows in the dark, it also glows in the light, although it''s hard to be sure.');
INSERT INTO "item_descriptions" VALUES(10058,'en','Bram was right after all: you should watch out for grown men who prance around with make-up and long, flowing capes.');
INSERT INTO "item_descriptions" VALUES(10061,'en','They say that Countess Bathory herself used to wear these boots. Knowing her, they should be nice and soft... just hope there aren''t too many pimples on them.');
INSERT INTO "item_descriptions" VALUES(10102,'en','If nothing else, this mask will protect you from the sun.');
INSERT INTO "item_descriptions" VALUES(10106,'en','This creature with a wan complexion will take cruel pleasure in sucking the blood of your friends, and even take a nip out of you if you need taking down a peg. What it likes most, however, is when you fight horrible monsters so it can bleed them dry. You''re therefore going to have to spend all your time fighting... Poor you, how terrible.');
INSERT INTO "item_descriptions" VALUES(10107,'en','This pet had a long, hard childhood, which was not made any easier by its frankly stupid name. Maybe that explains its volatile temper and uneven temperament... It''s quite taken with you, since it sees those same "qualities" in you. It follows you everywhere, determined to haunt the World of Twelve at your side.');
INSERT INTO "item_descriptions" VALUES(10155,'en','This amulet is meant to protect you from random beheadings, but it increases your chances of dying from a random hanging.');
INSERT INTO "item_descriptions" VALUES(10156,'en','These slippers are more comfortable than your average footwear, but it''s hard to say why... perhaps the parasites that infest them massage your feet.');
INSERT INTO "item_descriptions" VALUES(10157,'en','This belt was made using the leftovers from spools of Flax String. It ties up rubbish bags too.');
INSERT INTO "item_descriptions" VALUES(10158,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10159,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10160,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10161,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10162,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10163,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10164,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10165,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10166,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10167,'en','Hold it high and proud, because this trophy is all that will be left of your glory when you''re gone.');
INSERT INTO "item_descriptions" VALUES(10168,'en','Ponch polished his boots every morning before mounting his Dragoturkey and leaving on missions to save widows and orphans. Especially widows. Ponch was quite the charmer.');
INSERT INTO "item_descriptions" VALUES(10171,'en','These fingerless leather gloves are perfect for rainbow coalitions of dancing.');
INSERT INTO "item_descriptions" VALUES(10172,'en','This amulet will feed a vorpal slug for two days, or three days if it accompanied by a puree of your head.');
INSERT INTO "item_descriptions" VALUES(10173,'en','The soles of these boots are covered with a sticky slime and the interior is filled with a slippery slime. Or maybe it''s the other way round.');
INSERT INTO "item_descriptions" VALUES(10180,'en','This medallion acts as the key to a mysterious, forgotten city.');
INSERT INTO "item_descriptions" VALUES(10181,'en','This ring was found in a mysterious city where nobody knew of its existence until they began frantically searching for it.');
INSERT INTO "item_descriptions" VALUES(10186,'en','This boar-tooth necklace will terrify boars, and by extension, your mother-in-law.');
INSERT INTO "item_descriptions" VALUES(10189,'en','This ring used to belong to the Oxon King. He liked to play with the sunbeams reflecting on the ring and used to say "Watch out for the Oxon Laser!''"');
INSERT INTO "item_descriptions" VALUES(10190,'en','Don''t forget to put these boots on when you have your heads in the clouds, they''ll keep you high. Even though they''re cool, don''t wear them to go dancing if you want to keep your feet on the ground.');
INSERT INTO "item_descriptions" VALUES(10191,'en','This belt is perfect when you need to rest and digest your granny''s Oxo Bucco.');
INSERT INTO "item_descriptions" VALUES(10223,'en','This shovel is primarily intended for medical use, despite being used very controversially by the Enutrof known as Resat as a weapon of self defence.');
INSERT INTO "item_descriptions" VALUES(10438,'en','These boots belonged to the unforgettable Maidarte, a misunderstood genius who specialised in infinite loops and recursion. Nobody really understood what he was explaining nor why he or continually repeated the same stories. Just as the surf crashes against the rocky shoreline, so have his diatribes become a part of the landscape, forever colliding with the obstacle of common sense.');
INSERT INTO "item_descriptions" VALUES(10544,'en','Trained by its former master to eat only monsters living near Cania Lake, this creature from elsewhere eventually diversified its diet. However, its breath still reeks of blops.');
INSERT INTO "item_descriptions" VALUES(10557,'en','This battered old glove helps you catch Gobbowl balls, or any other round thing covered in wool, for that matter. What you do with it as result concerns you, and you only...');
INSERT INTO "item_descriptions" VALUES(10558,'en','With this glove on your hand, you can pretend you''re a famous Gobbowl player when you''re playing fetch with your Bow Wow.');
INSERT INTO "item_descriptions" VALUES(10559,'en','Gobbowl matches are brutal, and this belt was designed to protect players from muscular blows. However, you can also use it as a life-belt when you''re taking a bath. Who''d have thought?');
INSERT INTO "item_descriptions" VALUES(10560,'en','They say that Gobbowl is a game for real men. This belt''s for real men too, with plenty of protective padding to soften low blows. It''s also great for training young Srams.');
INSERT INTO "item_descriptions" VALUES(10561,'en','These boots have been around for a while, you can certainly smell that. Plant them on your feet and you''ll look just like a real Gobbowl player. Plant their crampons in the rump of a few Gobblies, and the fans will come flocking.');
INSERT INTO "item_descriptions" VALUES(10562,'en','"Fashionable footwear feeds fascinated fan''s frenzy", reads the latest headline, and for once, the papers aren''t wrong. When properly polished, these boots help make it look like your opponent pushed you over, when in fact, you slipped. Congratulations! You''ve just learnt one of the basics of Gobbowl.');
INSERT INTO "item_descriptions" VALUES(10623,'en','Grute the Bwork wasn''t very clever. He was even stupid as stupid can be. For years, his companion tried to fill his head with something other than beer – to no avail. Grute stayed just as dim-witted, just with no froth on top.');
INSERT INTO "item_descriptions" VALUES(10624,'en','Those who have had to face Grute the Bwork will tell you, "Don''t bother aiming for the head, it''s empty". This advice also applies to all those who face Iops, Goblins or mothers-in-law.');
INSERT INTO "item_descriptions" VALUES(10625,'en','Grute''s Boots give off such a pungent aroma that you''ll be able to knock your opponents out with one quick kick to their head. These boots were forbidden in combat situations by the Sufokia Convention a long time ago, a convention which, it has to be said, has saved many, many lives.');
INSERT INTO "item_descriptions" VALUES(10627,'en','Koksiks''s had many rather questionable preferences, such as dipping vinegar crisps in chocolate spread or – shudder – eating bow meow fur. Many went far in their efforts to get him to see the error of his ways, and got lost on their way back.');
INSERT INTO "item_descriptions" VALUES(10628,'en','There''s nothing noisier than the tap-tapping of bones on an elm coffin. You should have seen Koksiks going at it in these soft boots. A sight to behold he was. Dancing. Dancing as if no one was listening – not his neighbours, not the dead, and especially not his dead neighbours.');
INSERT INTO "item_descriptions" VALUES(10629,'en','Koksiks had two dreams in life: climb Crackler Mountain and become a minstrel. Life was very cruel to him, because all he ever accomplished before he died was being the opening act for Jon Lemon concerts. Sometimes, life throws you lemons. In Koksiks''s case, it threw crates of lemons.');
INSERT INTO "item_descriptions" VALUES(10631,'en','A popular saying amongst those of the mauve persuasion is: "Sometimes you hit the bar, sometimes the bar hits you."');
INSERT INTO "item_descriptions" VALUES(10632,'en','Goboff the Goblin loved to gobble very rotten eggs. While his digestive tract was able to deal with this atrocious habit easily, those who came within whiffing distance of his foul breath would drop like mooflies. Those unlucky enough not to be rendered unconscious immediately would grab onto this belt to stop themselves hitting the floor.');
INSERT INTO "item_descriptions" VALUES(10633,'en','Goboff was a keen gardener. He loved nothing more than whacking trespassers around the head with his rake. He found this ring on the finger of an impudent rambler who''d dared to trample his babbage leaves.');
INSERT INTO "item_descriptions" VALUES(10635,'en','When the two small balls attached to this amulet collide, they produce a slight rattling noise, which means a Kanniball is very close by. When you hear this noise, it is usually too late to escape, but there is still time to choose which sauce you want to be devoured with.');
INSERT INTO "item_descriptions" VALUES(10636,'en','The ring is infused with secret spices, used for flavouring broth when stirred by hand. The spices are so good that once you put the ring on, there''s a real risk you''ll bite your own fingers off, they''ll be that tasty.');
INSERT INTO "item_descriptions" VALUES(10637,'en','Kanniball Lektor wore these boots for several years before trading them in for a tourist on Moon Island. Look, he was hungry, alright?');
INSERT INTO "item_descriptions" VALUES(10639,'en','Stroy Zemol had a sister, Faye Pworme. She liked travelling alone and exploring dark, foul-smelling tunnels.');
INSERT INTO "item_descriptions" VALUES(10640,'en','This belt is allegedly reversible, only no one''s ever dared try it as they don''t want to be the first to discover that it isn''t actually reversible.');
INSERT INTO "item_descriptions" VALUES(10641,'en','Stroy Zemol made these boots himself, from a few blocks of wood and a little bit of fabric. They might not look like other boots, but blimey, they''re certainly magical nevertheless.');
INSERT INTO "item_descriptions" VALUES(10643,'en','When it comes into contact with warm, sticky liquids, this ring changes colour, which explains why Fyred Ampe the Dark Miner loved it so much.');
INSERT INTO "item_descriptions" VALUES(10644,'en','The soles of these magic boots allow you to shatter lumps of coal by vibrating at its resonant frequency (look it up). The user guide indicates that they will even vibrate on their own when Slamdance music is played nearby.');
INSERT INTO "item_descriptions" VALUES(10645,'en','This belt, reinforced with several different metals, was strong enough to support the weight of Fyred Ampe the Dark Miner''s enormous sack. Don''t worry, though, it should be just as useful for tiny packets too.');
INSERT INTO "item_descriptions" VALUES(10657,'en','This strange pet is a cross of the best truffle hunters in all Amakna. Its massive snout lets it sniff out ogrines, even ones hidden underwater. It seems Otomai took several years to create this species, and it''s said that he''s using it to try and find something he lost or a creature he let escape. Only he knows the full story...');
INSERT INTO "item_descriptions" VALUES(10685,'en','Equipped with this golden helmet, your head will soon be up for auction and worth its weight in gold.');
INSERT INTO "item_descriptions" VALUES(10686,'en','This fabric cloak, coated with a thin layer of gold, is magical. It attracts attention and reflects light directly into the pupils of dishonest types who try to stab you from behind. Essential if you have Sram friends.');
INSERT INTO "item_descriptions" VALUES(10687,'en','This ring is so heavy that it greatly increases the inertia of your fist when you distribute blows to your opponents. When you begin punishing peasants, it will be virtually impossible to stop you.');
INSERT INTO "item_descriptions" VALUES(10688,'en','This belt is perfect to hang your gold bars around your waist, they''ll pass unnoticed.');
INSERT INTO "item_descriptions" VALUES(10784,'en','No one has a clue what powers this amulet brings, but everyone knows what it takes away: your credibility.');
INSERT INTO "item_descriptions" VALUES(10785,'en','You''ve heard of the game "Pick it, lick it, roll it, flick it", right? Well this ring will protect you from the flicked stuff.');
INSERT INTO "item_descriptions" VALUES(10794,'en','Warm on the inside and cold on the outside, these boots will let you kick snowmen''s arses without melting their pert little buttocks.');
INSERT INTO "item_descriptions" VALUES(10797,'en','Unsheathed from its scabbard, this sword can cut ham, Enutrofs, one-legged men, dancers and one-legged, Enutrof dancers wrapped in a slice of ham. Sadly though, it''s useless for killing monsters.');
INSERT INTO "item_descriptions" VALUES(10798,'en','This shield won''t protect you from your own stupidity.');
INSERT INTO "item_descriptions" VALUES(10799,'en','Having problems hiding your dagger in your underwear? No problem, you can wedge it between your love handles and this belt.');
INSERT INTO "item_descriptions" VALUES(10800,'en','You''ll be able to fly with this cape around your shoulders. Just close your eyes, clench your fists, open your mouth, stretch out your arms and jump off a cliff shouting "I can fly!". Moments later, you''ll wake up with two broken legs.');
INSERT INTO "item_descriptions" VALUES(10801,'en','This shoddy hat admirably hides your baldness. Unfortunately, it''s not big enough to hide your false modesty.');
INSERT INTO "item_descriptions" VALUES(10802,'en','More golden than a Black Dragoone, less pink than a Pink Dragoone, and rarer than a Skeleton Dragoone, this pet will draw all eyes towards you, even if you''re as ugly as a Piwi.');
INSERT INTO "item_descriptions" VALUES(10818,'en','With this basic-looking weapon, you''ll feel like you know how to fight.');
INSERT INTO "item_descriptions" VALUES(10828,'en','They say sticks and stones may break your bones, but names will never hurt you. With this helmet on, you''ll certainly challenge that misconception...');
INSERT INTO "item_descriptions" VALUES(10829,'en','Having a dispute over money? Thanks to this rod, there''ll only be one winner: you!');
INSERT INTO "item_descriptions" VALUES(10830,'en','Is that a Banana Cape in your pocket or are you just pleased to see me?');
INSERT INTO "item_descriptions" VALUES(10834,'en','It doesn''t take much to make you look like an Ouginak. Watch out for fleas.');
INSERT INTO "item_descriptions" VALUES(10836,'en','You wear this amulet proudly, as a symbol of your participation in this great sporting event. You need it to stay proud having been through a scrum with B.C. Trool.');
INSERT INTO "item_descriptions" VALUES(10846,'en','Driven into a strange frenzy, any Tofus that you meet will want to rub up against your leg. Are you sure it''s the cape that attracts them?');
INSERT INTO "item_descriptions" VALUES(10847,'en','Hulkrap slipped these comfortable boots on to his ample feet once a year, but he took them off every day, which suggests they might be magic.');
INSERT INTO "item_descriptions" VALUES(10848,'en','These boots can also be used as anvils. Their former owner urges you not to dance while wearing them.');
INSERT INTO "item_descriptions" VALUES(10849,'en','This belt is constructed around a magnetic metal frame which attracts the purses of those careless enough to rub up against you.');
INSERT INTO "item_descriptions" VALUES(10850,'en','Klume had three weaknesses: Arachnees, being tickled, and tickly Arachnees.');
INSERT INTO "item_descriptions" VALUES(10851,'en','This belt is still covered in flour, perhaps because Kloug the Dark Baker wore it as an apron. Mind you, it might not be flour; it could be the powder he uses to soothe his embarrassing rash.');
INSERT INTO "item_descriptions" VALUES(10852,'en','Hulkrap stole this amulet from Ted Gonztipay, an anally retentive goblin with absolutely no sense of humour whatsoever.');
INSERT INTO "item_descriptions" VALUES(10853,'en','This amulet allows you to knead the skin on your neck without using your hands.');
INSERT INTO "item_descriptions" VALUES(10854,'en','Gontran Klume the smith traded a sword belonging to Dame Antium for this ring.');
INSERT INTO "item_descriptions" VALUES(10855,'en','This ring has been dipped in a multitude of different yeasts. It is said that it is capable of transforming those who wear it into mould. Some adventurers don''t see any difference after slipping it on.');
INSERT INTO "item_descriptions" VALUES(10863,'en','This Arachnee is very badly behaved: it jumps around, screams all the time, and bites anyone it meets... but for some reason you still love it.');
INSERT INTO "item_descriptions" VALUES(10864,'en','This unique Mush Mush was raised by a pack of Boowolves, which still doesn''t explain why it has such hairy armpits.');
INSERT INTO "item_descriptions" VALUES(10865,'en','This Tofu was struck by lightning 11 times while still growing. It''ll give you an electric shock if you stroke it, and it''ll shock you with electricity if you don''t stroke it. The choice is yours.');
INSERT INTO "item_descriptions" VALUES(10866,'en','This pet loves artichoke hearts smothered in Bherb blood, endives with Pikoko hair, and Jon Lemon''s songs. It seems to enjoy your company as well.');
INSERT INTO "item_descriptions" VALUES(10907,'en','Well, there you are. You did it: you took part in the greatest dragonic birth-control exercise ever. As a result, you''re going to have to eat omelette for weeks to come.');
INSERT INTO "item_descriptions" VALUES(10955,'en','There''s nothing unusual about a bird being ringed!');
INSERT INTO "item_descriptions" VALUES(10956,'en','Like the rest of the Black Crow set, this pair of boots has been passed down, foot to foot, through the generations. That explains the strong smell of Clakoss.');
INSERT INTO "item_descriptions" VALUES(10963,'en','The soles of these boots are so spongy that they absorb sewer sludge and release it each time you place your foot on the ground. As you can imagine, it''s quite handy if you ever need to retrace your steps.');
INSERT INTO "item_descriptions" VALUES(10964,'en','Plunder hung his booty from this belt. You can make out a small valve on the inside. This valve allows the belt to be inflated, transforming it into a buoy. An essential item when venturing into the sewers.');
INSERT INTO "item_descriptions" VALUES(10965,'en','This amulet was specially designed not to get stuck in Plunder''s neck hairs, so you can wear it without fear under your armpit or even keep it in your hand.');
INSERT INTO "item_descriptions" VALUES(10971,'en','With this bag slung at a jaunty angle over your shoulder, you''ll be able to muck about while still keeping that charming smile on your face, you cheeky little monkey!');
INSERT INTO "item_descriptions" VALUES(10976,'en','Fungi generally have collars. Phong Huss, however, preferred rings. We assume this was so that he could boast about having fingers.');
INSERT INTO "item_descriptions" VALUES(10977,'en','Phong Huss wore this belt across his body so he could sheath his sword in it. The belt pinched his nipples on multiple occasions, but that''s the price to pay when you want to pull your sword with class.');
INSERT INTO "item_descriptions" VALUES(10978,'en','The feet of fungi are rarely very clean - they are often covered with mycelium. Phong Huss''s feet were no exception to this rule and he took care to hide them with his boots. They don''t smell particularly good, but they are well suited for growing mushrooms. Which of your stomach or your nose will win?');
INSERT INTO "item_descriptions" VALUES(10980,'en','A ghost''s amulet must be extremely powerful, given that it glows in the dark.');
INSERT INTO "item_descriptions" VALUES(10981,'en','It''s a well-known fact that real ghosts don''t have fingers. So how are they able to wear rings? That seems completely irrational. A bit like you, actually.');
INSERT INTO "item_descriptions" VALUES(10982,'en','Captain Haddock''n''roll once stumbled into Ektope on his way home from a drinking contest at the Ripate Inn. "Ectoplasm on skates!" he exclaimed. Poor Captain Haddock''n''roll, his tipsy mind was playing tricks on him: Ektope has never had any skates.');
INSERT INTO "item_descriptions" VALUES(10985,'en','This bow meow has known the winter of the far north, even if it has never actually seen the far north. Nobody knows how it arrived in Amakna, although the elders claim that it was imported from Frigost Island to counter the tragic shortage of ice cubes for use in drinks.');
INSERT INTO "item_descriptions" VALUES(10987,'en','This belt cools the hips, nearby organs, and ardour of all who dare wear it. The perfect gift for your most stubborn suitors.');
INSERT INTO "item_descriptions" VALUES(10990,'en','Heavy and stiff, these boots don''t look particularly special, but their icy sole will have you ice-skating without the need for ice. Of course, you''ll need to find a surface covered with ice-skate blades, but in these crazy times, that shouldn''t be too difficult.');
INSERT INTO "item_descriptions" VALUES(11011,'en','Crazier than a regular Minifoux but much less ginger, this pet can swim underwater without needing to plug its nose.');
INSERT INTO "item_descriptions" VALUES(11012,'en','This pet may have stripes, but that won''t stop it from sniffing your bottom or trying to relieve itself on your carpet. What did you expect?');
INSERT INTO "item_descriptions" VALUES(11013,'en','This ugly little Black Quaquack was rejected by its own family because it was different: it loved listening to the songs of Jon Lemon, the famous minstrel. Maybe it was just misunderstood.');
INSERT INTO "item_descriptions" VALUES(11014,'en','This pet stayed out too long in acid rain. It doesn''t glow in the dark, nor is it magical, but you can make a very potent salad dressing from it.');
INSERT INTO "item_descriptions" VALUES(11015,'en','This strange creature crossed the oceans on a block of ice to escape from a lost port. It looks like it''s taken you for a block of ice.');
INSERT INTO "item_descriptions" VALUES(11042,'en','This belt was given to Goultard by his father for his 5th birthday. It is more solid than its appearance suggests, and will keep your trousers snugly around your hips. It can also be used as a washing line, or even a skipping rope.');
INSERT INTO "item_descriptions" VALUES(11051,'en','If you dip this amulet into your glass, your tasteless water will be transformed into a delicious, citrus-flavoured beverage.');
INSERT INTO "item_descriptions" VALUES(11052,'en','The soles of these boots are made from the tough skin of fruit harvested on an island whose very existence remains unknown to mere mortals.');
INSERT INTO "item_descriptions" VALUES(11057,'en','This belt is composed of scales arranged spirally in accordance with the Vibronacci suite.');
INSERT INTO "item_descriptions" VALUES(11058,'en','Who were you hoping to seduce with a ring like this?');
INSERT INTO "item_descriptions" VALUES(11080,'en','This versatile pair of boots guarantees full freedom of movement. That''s why Lonne Jenone wears them when he dances with Boowolves.');
INSERT INTO "item_descriptions" VALUES(11082,'en','These boots were specially designed to destroy your opponents'' shin pads, and then their shins, and then your own toes.');
INSERT INTO "item_descriptions" VALUES(11083,'en','You can use this ring to puncture the Gobbowl Ball when you want to quietly enjoy a break in play.');
INSERT INTO "item_descriptions" VALUES(11085,'en','If you wear this belt upside down and press on it hard enough, you may be able to activate its integrated retromagic module. It has never worked, but you can activate it anyway. Then you can then sell it on to someone even more naive than you.');
INSERT INTO "item_descriptions" VALUES(11087,'en','Worn by several generations of handymen, this ring will protect your knuckle from hammer blows. Unfortunately, it is never sold in packs of five.');
INSERT INTO "item_descriptions" VALUES(11091,'en','Grillian the magician traded a magic ring for this pair of boots. It seems that he lost out on the deal, as they aren''t even padded.');
INSERT INTO "item_descriptions" VALUES(11092,'en','Grillian wore this amulet around his neck when... when... 
Oh, what does it matter? He died and now this amulet is yours.');
INSERT INTO "item_descriptions" VALUES(11104,'en','In levels of sheer idiocy, the Tofu, the Gobball and even the Iop can''t hold a candle to the Quaquack.');
INSERT INTO "item_descriptions" VALUES(11306,'en','The following text is engraved on the pommel: "This sword steals life from the poor and gives it to the rich." Too bad you''re poor.');
INSERT INTO "item_descriptions" VALUES(11343,'en','Rapiat manufactured these boots himself, without it costing him a kama. The same can''t be said of two of his fellows, for who it cost their lives.');
INSERT INTO "item_descriptions" VALUES(11344,'en','To this belt''s great misfortune, Rapiat''s only guilty pleasure were the breads of Danioul Garnioul the Baker. He was actually the only one to continue eating them after learning they were kneaded with the feet, saying that was what gave them their unique aftertaste.');
INSERT INTO "item_descriptions" VALUES(11345,'en','This beautiful amber amulet actually seems to be made of a much less noble material, which explains its foul odour and its low price. But it''s the result that counts, right?');
INSERT INTO "item_descriptions" VALUES(11346,'en','This ring helped Ougicle to stop biting his claws. To this day, it still glistens with slobber.');
INSERT INTO "item_descriptions" VALUES(11347,'en','In his youth, Ougicle wore his belt as a loincloth, with no trousers. He stopped the day he realised why people were laughing at him when he turned away from them.');
INSERT INTO "item_descriptions" VALUES(11348,'en','Ougicle especially liked his gold necklace: it amplified his cries so much that the ground around him vibrated. Very handy for flushing out Kolerats.');
INSERT INTO "item_descriptions" VALUES(11350,'en','The dark Cawwot that adorns Kawotz''s ring isn''t magic, and it''s certainly not evil, it''s just the same age as him.');
INSERT INTO "item_descriptions" VALUES(11351,'en','Kawotz''s Amulet is simply a luxury version of the "Wabbit-tooth Amulet", adorned with fur. Too bad it made it less powerful.');
INSERT INTO "item_descriptions" VALUES(11352,'en','Kawotz''s Boots are light and lined with fur, which makes them very comfortable. Unfortunately, as a Wabbit, he never managed to put them on.');
INSERT INTO "item_descriptions" VALUES(11354,'en','On the tomb erected in Grouillot''s honour, it says that to avoid being burnt to death by his lamp like other Gargoyls, he extinguished his. He finally died lost in the darkness of the Cemetery of Heroes.');
INSERT INTO "item_descriptions" VALUES(11355,'en','Grouillot''s stone boots slowed him down terribly in spite of the wings that were attached to him. Nobody has ever really understood why this was the case.');
INSERT INTO "item_descriptions" VALUES(11356,'en','Grouillot liked to make his belt speak using his talents as a ventriloquist. No one ever found out how he managed to make the tongue move without using his hands.');
INSERT INTO "item_descriptions" VALUES(11358,'en','Kubitus was a very versatile Chafer: challenging him from afar meant having to face his great talent in archery, while approaching him within a dozen kametres meant facing a horrible death by suffocation. Just like keeping the same boots for decades may have its advantages.');
INSERT INTO "item_descriptions" VALUES(11359,'en','The bone on the front of Kubitus''s Belt is roughly the shape of a coccyx: he thought that by having two pairs of buttocks, he would be more attractive to the fairer sex. In practise, it simply made him look ridiculous.');
INSERT INTO "item_descriptions" VALUES(11360,'en','This unique amulet, once animated by the same magic as that of Livitinems, insisted on calling Kubitus "Ulna". The latter, exasperated, finally muted it by tearing off its jaw.');
INSERT INTO "item_descriptions" VALUES(11362,'en','Piggy Paupe yelled so loudly when he sang that after a while, he became deaf. The magic infused into the ears of his ring helped him hear again. The snout addressed the damage caused by its stench.');
INSERT INTO "item_descriptions" VALUES(11363,'en','The discomfort caused by Piggy Paupe''s belt tended to make him adopt a very particular gait, always swaying his pelvis forward or backward. Don''t expect to garner much interest from the opposite sex, you don''t look attractive, just grotesque.');
INSERT INTO "item_descriptions" VALUES(11364,'en','The shoe that adorns Piggy Paupe''s Amulet is that of his wife and muse Yque Paupe, who bought it for him a gift. But Piggy has always thought it was more of an excuse to stop coming to his concerts than proof of love.');
INSERT INTO "item_descriptions" VALUES(11374,'en','There''s enough room for one of your friends to write your name on this paper amulet, which is just what breeders do so they know which Gobballs belong to them.');
INSERT INTO "item_descriptions" VALUES(11375,'en','This strong and rigid undergarment is not very comfortable, but then it was made with paper mache, after all. Having the saliva of a stranger on your buttocks does not seem to bother you in the slightest, I notice.');
INSERT INTO "item_descriptions" VALUES(11378,'en','Lighter than conventional sandals, they have only one real drawback, they don''t suit ticklish people at all.');
INSERT INTO "item_descriptions" VALUES(11379,'en','This amulet will tickle your neck and make you cough up that frog in your throat.');
INSERT INTO "item_descriptions" VALUES(11384,'en','Hook this ring around the neck of any children in your charge, and then connect the ring to a rope that you''ve hung from a tree. Now you can enjoy yourself and the children can''t escape.');
INSERT INTO "item_descriptions" VALUES(11386,'en','These boots are perfect for dishing out punishment with your feet so that you don''t have to get your hands dirty. The children will adore you!');
INSERT INTO "item_descriptions" VALUES(11395,'en','This small chain could pass for an amulet were it not the tip of a padlock.');
INSERT INTO "item_descriptions" VALUES(11396,'en','The man who gave this belt such a stupid name is actively sought by the police. The years he''ll spend in prison when they catch him still won''t make up for such a lack of creativity.');
INSERT INTO "item_descriptions" VALUES(11399,'en','This ring has the following engraved on its inside edge: "For upholders of the law who doesn''t afraid of anything". Bless. Did you really think you could use it?');
INSERT INTO "item_descriptions" VALUES(11400,'en','The shoemaker who designed these boots fitted them with Borbat wings so that their wearer could fly. Well, it was difficult to hear anything above the obnoxious din, but that''s what you thought the merchant was saying when you bought them from him at the Astrub Zaap.');
INSERT INTO "item_descriptions" VALUES(11416,'en','This pair of boots was carved out of a tree trunk. Or maybe it''s the other way round.');
INSERT INTO "item_descriptions" VALUES(11417,'en','This ring was made from sawdust and something very sticky, and it''s better that you leave it at that.');
INSERT INTO "item_descriptions" VALUES(11419,'en','Jon Lemon always put on these boots when he had a deposit to make in the hut at the bottom of his garden.');
INSERT INTO "item_descriptions" VALUES(11468,'en','A votive amulet dedicated to the worship of a forgotten goddess. It has "Protect your brothers and sisters" engraved around its edge. Well, that''s goddesses for you, I guess. Always pampering spoilt brats. And what if we haven''t got a brother or a sister? What are we supposed to do then, huh?');
INSERT INTO "item_descriptions" VALUES(11469,'en','"Notes on Dragons: teeth (huge), claws (sharp), breath (burning), greed (phenomenal). Some Dragons can predict the weather. But a dragon is more cumbersome than a frog". Where did Count Harebourg get all this information from?');
INSERT INTO "item_descriptions" VALUES(11470,'en','"The bearer of this ring was supposed to have been the prisoner of a Dragon. If my memory serves me correctly, a Dragon has never been known to hold somebody against their will. It''s so easy for a Dragon to make a good barbecue, why would they bother?"- A quote from Count Harebourg');
INSERT INTO "item_descriptions" VALUES(11471,'en','"The wearer of these boots held a grudge against a Dragon. Don''t be like him, and make sure you give Dragons the ancestral respect they deserve. And remember that Dragons are big. Very big. And they have no sense of humour."- A quote from Count Harebourg');
INSERT INTO "item_descriptions" VALUES(11472,'en','"This cape is supposed to protect the wearer from the dreams and illusions of the ethereal dimension. Does it really work? We would need to be able to come and go through the dimensions to get to the bottom of it. Apart from Magus Ax on his good days (or the days when he''s had a drink or two), not many people have ever boasted about doing so." - A quote from Count Harebourg.');
INSERT INTO "item_descriptions" VALUES(11473,'en','Count Harebourg has engraved the following on this belt: "Whoever wears this belt may pass through time and space!" Theoretic speculation? One thing is certain - it certainly stops your trousers falling down, which is a good start.');
INSERT INTO "item_descriptions" VALUES(11474,'en','"In case of disturbance in the astral veil, pull this over your head pretty quickly". A safety note engraved by Count Harebourg himself! You don''t know what an astral veil is, but having slipped this out-of-the-ordinary hat onto your not-quite-as-out-of-the-ordinary head, you''re ready to race off on an adventure, or into a wall!');
INSERT INTO "item_descriptions" VALUES(11514,'en','With this weapon in your clenched fist, you will cry for vengeance and seek justice. Get your revenge on who? Seek justice for what? It looks like the answers to these questions do not belong to this Age.');
INSERT INTO "item_descriptions" VALUES(11563,'en','Proudly sporting this amulet around your neck will demonstrate your mastery of all four primordial elemental energies. It will not make you any wealthier, however.');
INSERT INTO "item_descriptions" VALUES(11571,'en','This hat''s horns sit directly against the temples of the brave adventurer who dares to wear it. As a result, they resonate at the same frequency as the brain''s alpha waves, allowing the wearer to communicate with distant Gullipops without needing to open their mouth or ears, which comes in very handy when trying to infiltrate a tribe of the googly-eyed creatures.');
INSERT INTO "item_descriptions" VALUES(11572,'en','The four huge, glowing balls that adorn this crown are considered by some Frigostian Pingwin experts to be a somewhat graphic representation of the Royal Pingwin''s incredible fertility. Where do they get these hare-brained ideas?');
INSERT INTO "item_descriptions" VALUES(11573,'en','Buck Anear wore this hat on the Hesperus to show he was the boss. It didn''t stop his loyal crew members nicknaming him "The Prat in the Hat", "Hattie Jacques", "Sonia Head" or, worst of all, "Octopus Tule".');
INSERT INTO "item_descriptions" VALUES(11574,'en','You have to admit, this helmet doesn''t make you look very clever. The problem is that without it, you look even less so.');
INSERT INTO "item_descriptions" VALUES(11575,'en','The first thing your opponent noticed before stealing this necklace was how sparkly it was. Funnily enough, that was also the last thing you noticed as your head went tumbling to the floor.');
INSERT INTO "item_descriptions" VALUES(11576,'en','In olden days, Frigostian jewellers used to offer some very good advice when they had heavy pieces of jewellery on sale: place a heavy piece of jewellery around your sweetheart''s neck, and it will stop her going too far away.');
INSERT INTO "item_descriptions" VALUES(11577,'en','A legend tells of a motley band of Frigostian cowards who tried to throw this ring into the crater of a volcano to destroy it. Fortunately for you, they failed.');
INSERT INTO "item_descriptions" VALUES(11578,'en','Buck Anear loved hugs and manly handshakes – and sometimes both at once. Unfortunately for those he loved, he regularly forgot that he was armed with a huge, rusty hook. By dint of scratching, stinging, pinching, cutting and poking out the eyes of his family, he was called many things: "Joshua Lackhand", "Hooky Hooky Hookface", and often just simply "Hook Off".');
INSERT INTO "item_descriptions" VALUES(11579,'en','In olden days, Frigostian jewellers used to offer some very good advice when they had lighter pieces of jewellery on sale: don''t give your sweetheart jewellery which is too heavy for her hands, or she could have trouble cleaning the top of your shelves.');
INSERT INTO "item_descriptions" VALUES(11580,'en','This cloak would have made a beautiful blanket for a bed had the tailor who crafted it not slept in a hammock.');
INSERT INTO "item_descriptions" VALUES(11581,'en','A little rigid, a little heavy and from a completely different era, this cloak reminds you of a former colleague you used to break rocks with down in the mine.');
INSERT INTO "item_descriptions" VALUES(11582,'en','If you run through the snow wearing these boots, you''ll leave Royal Mastogob-sized footprints behind. The only thing missing will be the print of a Royal Mastogob-sized tail.');
INSERT INTO "item_descriptions" VALUES(11583,'en','These boots won''t give you a very graceful gait. But since you''ve never had a graceful gait anyway, no one''s going to notice.');
INSERT INTO "item_descriptions" VALUES(11584,'en','This belt was formerly used as a chastity belt, which is quite surprising when you consider how fond Royal Mastogobs are of putting their dungeon keys in a bowl and having a big party.');
INSERT INTO "item_descriptions" VALUES(11585,'en','This belt can also be worn as a loincloth. Without it, Buck Anear wouldn''t have been able to hide his most precious, envied and coveted jewel. Sailors jealous of his enormous treasure nicknamed him, for reasons known only to themselves, the "crooked visionary" or the "ravaging buccaneer". When he was hung for the thirteenth time, he cried out to the crowd, "My treasure for someone who understands!"');
INSERT INTO "item_descriptions" VALUES(11586,'en','Just like any good self-respecting ghost pirate, Buck Anear had a Sabre to cut knots, heads, and knotheads. But he was so sensitive he couldn''t stop himself shedding a tear when he did so. His opponents who lost their heads used this story to give him the nickname "The Sobbing Sabre" before they died.');
INSERT INTO "item_descriptions" VALUES(11598,'en','You know that name they call you in the guild? No? Oh well, wearing this helmet, you''ll soon find out.');
INSERT INTO "item_descriptions" VALUES(11599,'en','It''s no secret that Frighogs like to make a pig of themselves. Now you can justify doing the same thing.');
INSERT INTO "item_descriptions" VALUES(11600,'en','It''s difficult to say if the Yuara Pirate deliberately chose this mask or was the victim of a very violent maritime accident with a sea shell. It''s also difficult to say who is the worst-off - the shell or the pirate.');
INSERT INTO "item_descriptions" VALUES(11601,'en','Occasionally called a "limpet head", the Harpy Pirate doesn''t like seafood jokes, and he likes jokes involving seafood and his mother even less.');
INSERT INTO "item_descriptions" VALUES(11602,'en','Pope Ory was a Frigostian renowned for hiding anything and everything in his hat, but above all, anything. His hat had much in common with a female adventurer''s handbag: they''re the only containers whose contents exceed their capacity, defying all known laws of modern Frigostian physics.');
INSERT INTO "item_descriptions" VALUES(11603,'en','This hat only goes with blonde hair. It''s a bit tatty, and you should be able to exchange it for a new one with Juss Tafinger''s Assistant at the Ski Maker''s shop in Frigost Village.');
INSERT INTO "item_descriptions" VALUES(11604,'en','The tailor who made this hat was convinced that the future of Frigost would be very dark. Like all naysaying doom-mongers and their half-baked predictions, he was wrong. The future of Frigost was just cold.');
INSERT INTO "item_descriptions" VALUES(11605,'en','Naive Frigostian tailors believe this cape to be an improved version of the famous Cape Rice. There''s an inscription on its label: "This cape takes its name from its ability to become transparent around the posterior should the latter be somewhat on the large side". You''ve just realised that everyone can see your buttocks.');
INSERT INTO "item_descriptions" VALUES(11606,'en','This cape attracts attention and provides a diversion. If you are ordered to wear it on a battlefield, you''ll be able to more accurately estimate your life expectancy.');
INSERT INTO "item_descriptions" VALUES(11607,'en','A bard called Konan Bleating wore this chain when he was younger. All his fans wore the same chain. If you decide to do the same, don''t be surprised if even the monsters in Incarnam mock your taste in music.');
INSERT INTO "item_descriptions" VALUES(11608,'en','The maintenance and upkeep of this life-saving talisman is funded by the generous participants of Blop Eater appeals.');
INSERT INTO "item_descriptions" VALUES(11609,'en','Every time you scratch your neck, this amulet will make your vocal cords vibrate and you''ll make the following noise: "Dzoing Dzoing". If that doesn''t help you attract a mate, there''s nothing more we can do for you.');
INSERT INTO "item_descriptions" VALUES(11610,'en','There''s no doubt about it. This loincloth belonged to at least one Kanigloo, maybe several. One less, now. However, it appears badly made. You should be able to exchange it for a better one with Juss Tafinger''s Assistant at the Ski Maker''s shop in Frigost Village.');
INSERT INTO "item_descriptions" VALUES(11611,'en','These pants are best worn with long hair and come with an ash tray and plectrum. Before Frigost''s big freeze, they were very popular with the angry young rebels who cut the grass for their own personal consumption. They were almost certainly Mastogob breeders looking to feed their pets.');
INSERT INTO "item_descriptions" VALUES(11612,'en','If you look directly at these pants, moving your head from right to left for several days, you might eventually manage to fall asleep.');
INSERT INTO "item_descriptions" VALUES(11617,'en','These boots are meant to be worn by Frigostians whose parents were Frigostians whose parents were Frigostians and whose parents of their parents of their parents were Frigostians. If you''re not Frigostian yourself, we wouldn''t recommend you put these boots on.');
INSERT INTO "item_descriptions" VALUES(11618,'en','Legend has it that these sandals are named after a great Frigostian mathematician called Hannibal Gorithm. He always wore sandals, even after the big freeze. He used to walk around in circles in the snow until he found the solution to stopping walking - which was when his toes turned blue.');
INSERT INTO "item_descriptions" VALUES(11619,'en','You''ll soon be able to match these sandals to the colour of your hair or the flag you''re carrying at your next battle against a Perceptor.');
INSERT INTO "item_descriptions" VALUES(11620,'en','This ring could have prevented some of Buck Anear''s maritime disappointments. Instead of having to drink from a cup, he would have been able cut open bottles of Cocalane, the famous beverage that makes everything go by in a blur.');
INSERT INTO "item_descriptions" VALUES(11621,'en','If you don''t place it on a finger, this ring will wander off on its own accord. It may also provide you with an excuse if you have wandering hands and can''t stop shoving your fingers places you really shouldn''t.');
INSERT INTO "item_descriptions" VALUES(11622,'en','The Frigostian artisan who made this ring almost died of exhaustion trying to write something interesting on its label. He preferred to "move on to something else". Which, translated into Frigostian means, "go on a pub crawl around all the taverns in Frigost Village".');
INSERT INTO "item_descriptions" VALUES(11623,'en','This typically Frigostian creation was made by an artisan whose blood never ran cold, not even in his hands.');
INSERT INTO "item_descriptions" VALUES(11624,'en','The blade of this sabre has been specially designed to cut your adversary''s braces. Once their breeches are around their ankles, you can easily make them trip over or simply humiliate them by making your mocking laugh the last thing they ever hear.');
INSERT INTO "item_descriptions" VALUES(11625,'en','This axe was a favourite of the butchers of Frigost who wanted to chop the meat into such small pieces that no one would notice their esteemed customers were being sold Gullipop cloacae. This practise would actually go a long way to explaining the prejudices against Frigostian gastronomy.');
INSERT INTO "item_descriptions" VALUES(11626,'en','It''s difficult to tell if this is an axe or an anchor. The Talklyka Pirate himself doesn''t know the answer to that question. When in doubt, he uses it like an axe on all adventurers he encounters.');
INSERT INTO "item_descriptions" VALUES(11627,'en','This bow uses very simple Frigostian mathematics to calculate the height of certain buildings very efficiently. Unfortunately, it gives no indication of the units of measurement used for the result.');
INSERT INTO "item_descriptions" VALUES(11628,'en','This shovel belonged to a bard. His avant-garde approach to music - pressing the keys of his instrument with a shovel - was not rapturously received by the inhabitants of Frigost Village.');
INSERT INTO "item_descriptions" VALUES(11629,'en','These daggers belonged to a famous Sram who loved to show off in front of the village braves. He was renowned for his many Cider Juggling Championship titles. Cider Juggling is a pretty stupid game which consists of drinking alcohol at a friend''s house, attempting to pick up a piece of wood and tipping as much liquid as possible onto the floor of the one hosting the game. A game wholeheartedly sponsored by Frigostian carpet shop owners.');
INSERT INTO "item_descriptions" VALUES(11630,'en','This hammer was built for the sole purpose of being able to give the YeCh''Ti a good walloping. It was slightly diverted from its original purpose when the people of Frigost found out that it works very well on all creatures that have one or more of the following characteristics: long hair, herring breath, a stupid expression, or a baleful eye. Now you understand why you were hit with this hammer in the past.');
INSERT INTO "item_descriptions" VALUES(11631,'en','The Vigi Pirate had a fairly unique approach to fighting. She began by describing her hammer like this: "It''s heavy, it hurts and it floats". Her attackers then posed the following question: "It floats? So what?". This left the Vigi Pirate with enough time to crush her adver...*splat*');
INSERT INTO "item_descriptions" VALUES(11632,'en','This wand was crafted by a Frigostian expert in discretion and stealth. The user manual reads: "If you''ve managed to surprise your enemy by sneaking up behind them to give them a good wanding in just the right part of their backside but are suddenly overcome with the desire to sneeze, quickly push this wand into your odd nostril and count to three."
You have to pay extra for the accompanying manual that explains how to tell which one of your nostrils is the odd one.');
INSERT INTO "item_descriptions" VALUES(11633,'en','Everyone knows that the most successful staves are the hardest ones. What can you do with a soft staff, a staff you can''t hold? Probably the same thing you do with a soft wand.');
INSERT INTO "item_descriptions" VALUES(11634,'en','It''s difficult to believe that this staff''s magic comes from the decaying fish head that adorns its extremity. The mystery behind all this should also help to explain the clever ideas coming out of yours.');
INSERT INTO "item_descriptions" VALUES(11635,'en','This lance, equipped with a sharpened piece of shell, can be used as a harpoon, a javelin, a tent peg, or even used to gut your dinner. Just don''t ask a Harpy Pirate for a demonstration.');
INSERT INTO "item_descriptions" VALUES(11667,'en','These boots are meant to be worn by Frigostians whose parents were Frigostians whose parents were Frigostians and whose parents of their parents of their parents were Frigostians. If you''re not Frigostian yourself, we wouldn''t recommend you put these boots on.');
INSERT INTO "item_descriptions" VALUES(11686,'en','There''s no doubt about it. This loincloth belonged to at least one Kanigloo, maybe several. One less, now.');
INSERT INTO "item_descriptions" VALUES(11706,'en','This hat only suits blondes.');
INSERT INTO "item_descriptions" VALUES(11707,'en','The vast majority of the female population of the World of Twelve will think you look like an incredibly cute cuddly toy when you wear this hat. What? You''re more interested in terrorising them with the remains of a monster as ferocious as Tengu Snowfoux, are you? That''s a shame.');
INSERT INTO "item_descriptions" VALUES(11708,'en','Tengu Snowfoux doesn''t have three tails, and neither do any of its Snowfoux cousins, so why did you ask your tailor to sew three onto this cloak? You must have a crippling inferiority complex.');
INSERT INTO "item_descriptions" VALUES(11709,'en','Having snatched enough bandages from Tengu Snowfoux to make this belt, you need a couple of plasters yourself.');
INSERT INTO "item_descriptions" VALUES(11710,'en','Made from Snowfoux pelt, these slippers are comfortable enough for you to squeeze your toes inside. Only three of them, mind you.');
INSERT INTO "item_descriptions" VALUES(11711,'en','Don''t you find it slightly sadistic, chopping down wood with a wooden axe? You probably do, which is why you can''t stop yourself from killing all those poor Gobballs.');
INSERT INTO "item_descriptions" VALUES(11712,'en','If you''ve seen the commercial for this cape, you''ll remember the catchy tagline: "Not often copied but frequently equalled, this cape is particularly noteworthy for its double stitched seams that make it more solid than the capes that do not copy it but equal it". Hmmm. Suddenly, you smell the subtle odour of scam.');
INSERT INTO "item_descriptions" VALUES(11713,'en','This amulet was very fashionable on Frigost.
Several centuries ago.');
INSERT INTO "item_descriptions" VALUES(11714,'en','This stench coming off this ring makes you think someone has been wearing it on their toes.');
INSERT INTO "item_descriptions" VALUES(11715,'en','Have you heard the expression "a face like a slapped arse"? No? Take a look in the mirror.');
INSERT INTO "item_descriptions" VALUES(11716,'en','This fur-covered belt keeps your thighs warm, which should melt your love handles a little faster.');
INSERT INTO "item_descriptions" VALUES(11717,'en','Piautre was born on an old collective farm on Frigost, near the Frozen Lake. He created this ring thinking he''d managed to reinvent the finger-mounted lawn strimmer. He only cut his hand 3 times.');
INSERT INTO "item_descriptions" VALUES(11718,'en','When the Celestial Bearbarian fancies a quick sneak out of his hive, he dons this mask to pass himself off as a Mellifluous Bearbarian. Unfortunately, his belly gives him away.');
INSERT INTO "item_descriptions" VALUES(11719,'en','When there''s nothing much going down in the Bearbarian Hive, the sticky ursines wrap themselves up in their cloaks and use them as a kind of luge. A thorough Frigostian study into their traits and their mannerisms seems to have shown that they are very bad at avoiding obstacles and they generally protect their hands with their heads.');
INSERT INTO "item_descriptions" VALUES(11720,'en','A delicious, yet frighteningly sticky honey drips from this amulet. If you put it around your neck, you''ll benefit from a free, progressive depilation of your entire torso. If you really want to put it in your mouth, you''d be advised to do so before you wear it around your neck, unless you like recipes based on body hair.');
INSERT INTO "item_descriptions" VALUES(11721,'en','There are a few Frigostian hunters who claim to have seen the Celestial Bearbarian actually slip this belt up over his paunch, but they''re the same hunters who claim to have seen a YeCh''Ti on Frigost.');
INSERT INTO "item_descriptions" VALUES(11722,'en','The Bearbarians have been working for generations to produce the perfect sole: one that doesn''t stick to honey.');
INSERT INTO "item_descriptions" VALUES(11723,'en','Everyone will think you look ridiculous when they see you wearing this hat, but they won''t say a word. Now you know what they''re thinking though, although they won''t know that you know what they''re thinking. The most important thing is that you know that they don''t know that you know what they''re thinking.');
INSERT INTO "item_descriptions" VALUES(11724,'en','Formerly worn by disreputable Frigostian men, this hat has now become an indispensable fashion item. On the label you can read: "This hat will attract all manner of wild creatures that want your body rather than your gold." It is not clear whether these are female Frigostians from Frigost Village or the creatures that inhabit the forests.');
INSERT INTO "item_descriptions" VALUES(11725,'en','Sleepy, lazy, nonchalant, bone idle - all adjectives that can be applied to the wearer of this hat. Mind you, it will certainly lull people into a false sense of security. Your enemies will lower their guard, monsters will ignore you and attack your friends instead, people will treat you like a layabout, you won''t be able to find any work, your partner will leave you, everyone will forget about you. And it seemed like such a good idea to wear it at the time :(');
INSERT INTO "item_descriptions" VALUES(11726,'en','Wear this cape around your shoulders and then conspire against King Allister, which will allow you, amongst other things, to eat Brawn Salad more regularly, or even land yourself a parasol. But you must then get out of his sight!');
INSERT INTO "item_descriptions" VALUES(11727,'en','This very rough creation has no shape as such, no aesthetic appeal at all, and looks like it would fall to pieces at the slightest touch. It is, however, extremely powerful. I bet you didn''t see that coming.');
INSERT INTO "item_descriptions" VALUES(11728,'en','Before the big freeze, Count Harebourg said that if all of the Eculture Capes were to disappear from Frigost Island, the World of Twelve would only be able to survive for another four years. He didn''t actually say that, it was just a rumour started by Eculture, the cape''s creator, who was on the brink of bankruptcy. He has since become immeasurably wealthy.');
INSERT INTO "item_descriptions" VALUES(11729,'en','Cetera was a terribly powerful warrior, but was unable to finish what he started. He mutilated his opponents by the dozen without ever knowingly killing a single one. He died the day they all decided to gang up on him in revenge. You''ll think twice next time you''re about to spare someone''s life now, won''t you?');
INSERT INTO "item_descriptions" VALUES(11730,'en','The jeweller who created this amulet was a little mad, and put it together without any respect for the basic rules of Frigostian jewellery, using individual components each more different than the last. By some unknown miracle, he was quite successful.');
INSERT INTO "item_descriptions" VALUES(11731,'en','Equip your Battleflag Amulet, mount your proudest Dragoturkey, equip your shiniest weapon, hold your shield high and guide your men to victory with the biggest demonstration of chivalry the World of Twelve has ever seen! Tallyho! Be careful not to scare people too much if you don''t want to end up burnt at the stake, mind you.');
INSERT INTO "item_descriptions" VALUES(11732,'en','For a long time now, Frigostian hunters have pondered the significance of the motif scribbled on this loincloth. After long deliberation, they have concluded that it must be a warning concerning the odour it must hide.');
INSERT INTO "item_descriptions" VALUES(11733,'en','Whether you''re standing in a breeze, or wading through a strong current, you''ll generate an enormous amount of energy wearing this belt. What you do with it is up to you, except for the fact that this one is all clogged-up and as such, unusable. You should be able to give it to Juss Tafinger''s Assistant, in the Ski Maker''s shop in Frigost Village, and she''ll give you a new one for it.');
INSERT INTO "item_descriptions" VALUES(11734,'en','This belt, which radiates fluorescent green light, will cause any flowers around you to wilt, will make your summons look original, and will kill your enemies (very) slowly. Guaranteed for 4.47 billion years.');
INSERT INTO "item_descriptions" VALUES(11735,'en','The jeweller who crafted this ring, which has been passed down from generation to generation of Cestrals, was certainly no great talent. The "Z" which adorns the seal appears back-to-front when you seal an envelope with it. Actually, you''re not even sure it is a "Z". It might be an "N". Will you ever find out? Probably not.');
INSERT INTO "item_descriptions" VALUES(11736,'en','This extremely powerful ring will allow you to manipulate the person who wears it like a puppet. Now''s the perfect time for you to save your marriage.');
INSERT INTO "item_descriptions" VALUES(11737,'en','This ring, which appears to have suicidal tendencies, requires your constant attention. If you stop looking after it, there''s a good chance it will inexorably roll towards the nearest cliff and throw itself off.');
INSERT INTO "item_descriptions" VALUES(11738,'en','This ring takes its strange name from the exclamation of surprise it draws from young adventurers who see it for the first time, an exclamation among others such as "zomghax", "do want" and "kill self vs wall". The inhabitants of the World of Twelve move in mysterious ways.');
INSERT INTO "item_descriptions" VALUES(11739,'en','When you''re running, these boots will help you to keep a constant speed without any extra effort on your part, as long as no one tries to stop you. Unfortunately, they''re so heavy you''re unable to put one foot in front of the other. You''ll make an excellent punching ball. Very stable.');
INSERT INTO "item_descriptions" VALUES(11740,'en','The shoemaker who designed these boots was very innovative. He covered them with many small holes so that unpleasant odours could escape rather than gather in the boots themselves. As a result, you stink to high heaven, but your boots don''t smell in the slightest.');
INSERT INTO "item_descriptions" VALUES(11741,'en','These boots have one serious design flaw: they may be perfect for climbing the highest peaks of Frigost, but they''re nothing more than heavily-soled socks, and your toes may well fall off if you attempt to climb Mount Scauldron wearing them. They''re still great for inflicting very painful low blows on your opponents.');
INSERT INTO "item_descriptions" VALUES(11742,'en','This sword is so short, you''ll need to stretch if you want to hit people with it. Sure, it''ll be nigh on impossible for you to hurt your enemies, but try to look on the bright side for once. At least you won''t hurt your allies any more.');
INSERT INTO "item_descriptions" VALUES(11743,'en','This sword is the preferred weapon of dentists, wild boar hunters and wild boar hunting dentists.');
INSERT INTO "item_descriptions" VALUES(11744,'en','The blade of this sword wilts when your legs start to shake, giving you the perfect excuse to flee like the coward you are.');
INSERT INTO "item_descriptions" VALUES(11745,'en','This strange hammer is supposed to allow your enemies to see their future when you hit them on the head with it. It doesn''t seem to be working properly, because the only thing they see is blood. Maybe you''re hitting them a little too hard.');
INSERT INTO "item_descriptions" VALUES(11746,'en','This hammer oozes virility, brute force, sweat, and somewhat counter-intuitively, hair. It reminds you of the Minotoror more than anything. It goes without saying that with this little marvel in their hands, even the most delicate of calves would be capable of creating unprecedented carnage.');
INSERT INTO "item_descriptions" VALUES(11747,'en','This massive, honey-covered hammer attracts the greedy and feeds the dying.');
INSERT INTO "item_descriptions" VALUES(11748,'en','Thanos practised all manner of unsavoury occupations: drill sergeant, banker, moneylender, storyteller and occasional P.A.N.T.S. prophet. He used this staff to punish his apprentices and anyone that would listen to him, a daily habit that certainly kept him fit. This example has been gnawed by a starving Rattedaugue. Juss Tafinger''s Assistant will happily take it off your hands and give you a new one for it.');
INSERT INTO "item_descriptions" VALUES(11749,'en','This is the perfect staff for protecting yourself from the sun, and will prompt hours of ripe debate amongst your peers. Is it really a sunshade, or an umbrella?');
INSERT INTO "item_descriptions" VALUES(11750,'en','If you''ve decided to become a furtive, nocturnal dispenser of justice, then this is the staff for you! Coordinating very well with black looks and blacker moods, it has the extraordinary magic power of being completely invisible in total darkness.');
INSERT INTO "item_descriptions" VALUES(11751,'en','This pair of daggers will allow you to perform two beneficial actions at the same time: dish out sweet-tasting candy, and rid yourself of annoying kids.');
INSERT INTO "item_descriptions" VALUES(11752,'en','These daggers are incredibly exasperating: irregular, unpredictable, treacherous, they remind you in every way of your mother-in-law. You''re already looking forward to the prospect of sharing these feelings with your worst enemy.');
INSERT INTO "item_descriptions" VALUES(11753,'en','Aguirre Godswrath was an adventurer in search of conquests and a conqueror in search of adventure. He didn''t find what he was looking for on Frigost, but found instead everything he wasn''t looking for. He was known to shout his name every time he killed an enemy. He lost his voice after attacking a hydra. How, you ask? Well, its heads wouldn''t stop growing back.');
INSERT INTO "item_descriptions" VALUES(11754,'en','This bow, with its most unusual colour and shape, only seems to be appreciated by a small minority of adventurers. They call themselves artists, avant-gardists, or misunderstood, it depends. If you leave them to wrack their brains to find a way that they could be useful in a fight, it should give you enough time to split them in two.');
INSERT INTO "item_descriptions" VALUES(11755,'en','The creator of this bow was well-known, having dedicated his life to creating weapons of excellent quality, although very basic. Reaching the end of his years, and regretting never having created anything out-of-the-ordinary, he carved this bow, his one and only flight of fancy. It may be strange, but you will inevitably find it very useful.');
INSERT INTO "item_descriptions" VALUES(11756,'en','This bow dates back to before the glaciation of Frigost. Old-fashioned, it fell into disuse until very recently, when a small child who had found an old copy in an attic accidentally laid waste to an army of Mastogobs preparing to invade Frigost Village.');
INSERT INTO "item_descriptions" VALUES(11757,'en','This wand enabled knowledgeable Frigostians who were studying the social and cultural characteristics of the inhabitants of Frigost to easily identify each other. It was also an easily identifiable indication to monsters who were on the look out for prey with more brain than brawn.');
INSERT INTO "item_descriptions" VALUES(11758,'en','On this wand''s wooden sleeve you can read the following inscription: "The shame of this blonde will last for all eternity". It must surely be a coded message, unless the engraver meant to write: "The flame of this wand will last for all eternity".');
INSERT INTO "item_descriptions" VALUES(11759,'en','This wand is the ideal weapon to berate your adversaries or to point out the allies you choose to fight in your place.');
INSERT INTO "item_descriptions" VALUES(11760,'en','This axe used to belong to a famous assassin who took perverse pleasure in jumping into haystacks from the tops of the towers of Allister''s Castle.');
INSERT INTO "item_descriptions" VALUES(11761,'en','The chances of crossing a Teroid Axe field successfully are only one in three million seven hundred and twenty.');
INSERT INTO "item_descriptions" VALUES(11762,'en','This shovel comes from a mythical land where gold is supposed to abound. It is said that Aguirre himself sought this country for years. He ended his life on a raft with only this miserable shovel to paddle with.');
INSERT INTO "item_descriptions" VALUES(11763,'en','This shovel goes really well with long hair and pointed ears, and will awaken the magic dormant inside you. It''ll also do wonders for your feminine side.');
INSERT INTO "item_descriptions" VALUES(11765,'en','This little fuzzball hates being stroked the wrong way, although you''re not actually sure which is the right way to stroke it.');
INSERT INTO "item_descriptions" VALUES(11771,'en','Yes, it floats. Don''t ask.');
INSERT INTO "item_descriptions" VALUES(11777,'en','This little pet will take care of your nuts by running off and hiding them somewhere. Don''t expect to find them again, however, as it won''t remember where it''s hidden them.');
INSERT INTO "item_descriptions" VALUES(11783,'en','Grumpier than a Minifoux but with far less hairy armpits, this pet is renowned for having bitten Dame Antium without breaking a single tooth.');
INSERT INTO "item_descriptions" VALUES(11792,'en','You excel in your mastery of the four primordial elemental energies and you want everyone to know. Be careful though, as this amulet might play tricks on you.');
INSERT INTO "item_descriptions" VALUES(11794,'en','Two copies of this root-containing amulet were created by an eminent Frigostian biologist, and were supposed to help the inhabitants of the Snowbound Village rid themselves of the vegetal creatures from the Petrified Forest.
The biologist disappeared without leaving any kind of instructions as to how to use them, and his son, who went off to find him, never found a single trace. The Frigostian islanders tried to recreate the effects of the two amulets and what you have in your hands is only a rough copy of the original.');
INSERT INTO "item_descriptions" VALUES(11811,'en','A pair of splendid walking boots tanned in Brakmar.');
INSERT INTO "item_descriptions" VALUES(11816,'en','You''re not really sure if this belt itches or tickles. It doesn''t matter though, because unless you wear something underneath it to Captain Chafer''s Panty Party, it''ll drive you nuts.');
INSERT INTO "item_descriptions" VALUES(11819,'en','This hammer, which is as heavy as the atmosphere generated when a Rattedaugue tells one of his "jokes", is perfect for crushing the Minotoror''s hooves. It is equally effective should you wish to smash other, just-as-sensitive body parts.
Latem Sa will exchange it for you, at the Blacksmiths'' Workshop in Astrub.');
INSERT INTO "item_descriptions" VALUES(11820,'en','It took several centuries to build this shovel from gold bar dust, but it was worth the wait. It''s very handy for cutting off the heads of monks or slicing a piece of Zoug pie.');
INSERT INTO "item_descriptions" VALUES(11850,'en','These pants form the ceremonial dress of the prophets of P.A.N.T.S. They are the only ones who can wear them without risking being mistaken for a farmer, a travelling tinker or a milkman. That sort of thing.');
INSERT INTO "item_descriptions" VALUES(11855,'en','These flip-flops are roomy enough for you to be able to pick up kamas with your toes. Their shape is also suited to placing blows in the sacks of your enemies so that you can recover their family jewels more easily.');
INSERT INTO "item_descriptions" VALUES(11856,'en','You can tuck your family jewels safely into this belt''s two enormous sacks.');
INSERT INTO "item_descriptions" VALUES(11857,'en','This shovel can do everything: dig earth, collect kamas, stun bandits and even repel your mother-in-law. As you can see, it''s pretty much indispensable.
Latem Sa will exchange it for you, at the Blacksmiths'' Workshop in Astrub.');
INSERT INTO "item_descriptions" VALUES(11858,'en','This Tofu fell into a cauldron of cheese fondue when it was tiny. It has grown a little plump, and the other Tofus constantly tease it about its weight. Self-acceptance is key in life, so it''s decided to eat every resource it can.');
INSERT INTO "item_descriptions" VALUES(11947,'en','Don''t let appearances fool you. This axe might be cheap but it can come in very handy for cutting down trees and frozen tourists.');
INSERT INTO "item_descriptions" VALUES(11950,'en','Feared by other pets because of teeth that would make a vampire blush, this creature had a lonely childhood and its social skills suffered. Until you adopted it, that is.');
INSERT INTO "item_descriptions" VALUES(11955,'en','Once fully grown, this pet will radiate a wonderful Frigostian charm, and like its Amaknian cousin, it loves to cuddle. In the meantime, it will give you lots of kisses to show its affection.');
INSERT INTO "item_descriptions" VALUES(11966,'en','This sweet little brockhard''s fur is as smooth as a mama bwork''s buttocks, but don''t be fooled. Its cute appearance would lull its peers into a false sense of security so it could better devour them in their sleep. Its attitude seems to have improved since you adopted it, though, because now it lunges at any creature, asleep or awake.');
INSERT INTO "item_descriptions" VALUES(11971,'en','This little Bearbarian cub escaped from Professor Obsidian-Heart''s laboratory and was rescued by Granny Capping. Starved of affection, it will try to kiss you all the time, so you should probably rub antiseptic cream around your mouth to avoid getting stubble rash.');
INSERT INTO "item_descriptions" VALUES(11976,'en','Most adventurers will find this amulet quite difficult to wear, not because of its weight, not because its prerequisites are so demanding, nor because it''s so weak, but because of the moustache that adorns it. It''s probably because he wears his moustache so well that Boostache is such a well-respected monster.');
INSERT INTO "item_descriptions" VALUES(11977,'en','Kanniball Andchain has had many women, each more beautiful that the last. He even went so far as to say that they were delicious. No one knows what has happened to them.');
INSERT INTO "item_descriptions" VALUES(11978,'en','Boostache doesn''t care about losing his ring. After all, he doesn''t have any fingers! The only thing that matters to him is his moustache. That''s quite a treasure you''re holding there.');
INSERT INTO "item_descriptions" VALUES(11979,'en','Kanniball Andchain only wears these boots when fighting the World of Twelve''s most valiant warriors. It''ll be a while before you see him wearing them to fight you.');
INSERT INTO "item_descriptions" VALUES(11980,'en','This cape, like Boostache, glows in the dark. As a result, it will have you failing every single attempt at breaking in to your ex-girlfriend''s house, will stop you sleeping at night, and will annoy every single one of your guildmates. Just what you need to spice up your dull existence.');
INSERT INTO "item_descriptions" VALUES(11981,'en','As a child, Boostache loved to play Postman''s Knock. He still loves to sneak up on adventurers, stopping abruptly if they turn around, looking as if nothing''s going on, then attacking them savagely when he finally reaches them. It might be childish and annoying, but it proves the trick.');
INSERT INTO "item_descriptions" VALUES(11982,'en','Now that you know Kanniball Andchain wears a hood beneath his headgear, a hood with two holes for eyes, you are hit with the sudden realisation that this cycloptic mask must have rendered the poor sod completely blind.');
INSERT INTO "item_descriptions" VALUES(11983,'en','In Kanniball Andchain''s hands, this sceptre unleashes strange magic powers capable of causing enormous totems to fall on the heads of opponents. In your hands, it just looks stupid, and won''t even turn your allies'' heads.');
INSERT INTO "item_descriptions" VALUES(12009,'en','As old and as stylish as an Enutrof, and as affectionate as the Eliatrope Goddess, this Platypus shines day and night. The children''s stories give its home as Sufokia, and raise it to the status of the remains of an ancient civilization, but the veracity of these claims has never been verified.');
INSERT INTO "item_descriptions" VALUES(12018,'en','Following the example set by his subjects the Kwaks, the Kwakwa has a blade to his name. Even if we still don''t know why, or for what occasion a bird would wear a sword, it does seem much lighter and easier to handle than a Kwakblade. Your enemies might be well and truly plucked.');
INSERT INTO "item_descriptions" VALUES(12019,'en','Though he has no master, the Kwakwa does have an identification ring. He uses the Kwaks'' rings to identify and find them when they get lost, so they can be brought back to the nest safely. He wears his ring so they can find him when he gets lost looking for lost Kwaks. They go round in circles so much, they''ve never left Crackler Mountain.');
INSERT INTO "item_descriptions" VALUES(12020,'en','The Kwakwa carries out a mating ritual to seduce the Kwakeres, which consists of displaying his tail feathers. He makes himself look incredibly silly when he does it, as he only has five of them. This is a perfect example of the old adage, "Make a woman laugh and she''ll play with your staff."');
INSERT INTO "item_descriptions" VALUES(12021,'en','As well as covering your little bird brain, this hat will give you a proud allure and might even make you forget you''re an egg head. What more can you ask for?');
INSERT INTO "item_descriptions" VALUES(12023,'en','Tracon''s belt, firmly attached to his stomach by its two straps, acted as a shock absorber. Coupled with his rather cushiony belly, Tracon was completely immune to his own attacks...');
INSERT INTO "item_descriptions" VALUES(12024,'en','These heavy square-toed metal boots forced Tracon, who knew how to manipulate vibrations, to use all his energy to dampen the sound they gave off. If he didn''t, you''d have been able to feel him coming from kilokametres away. Even worse, they''d stopped him from aiming properly when playing gobbowl.');
INSERT INTO "item_descriptions" VALUES(12025,'en','Due to his incredibly sensitive hearing, Tracon had removed the main gear from his clock to stop it from making that incessant tick-tock and then wore the gears as an amulet. After that, everyone he met told him his clock had stopped, which was not a great improvement on the ticking.');
INSERT INTO "item_descriptions" VALUES(12027,'en','Mirh, like any good percussionist, can''t help but tap away at anything that moves, even when he''s asleep. He''s going to have trouble finding a partner who knows how to stay alive with him around.');
INSERT INTO "item_descriptions" VALUES(12028,'en','Mirh was never able to summon Pandora''s Bokse. To compensate, he added a small box to his belt, in which he kept various poisons that caused all sorts of ills. Unfortunately, he never managed to make any of his enemies ingest one, so he only uses the sleeping poison when he can''t get to sleep.');
INSERT INTO "item_descriptions" VALUES(12029,'en','Mirh sometimes used his amulet as a pendulum to lull him to sleep more easily. The problem was, since it was also a little drum, when he''d drop it as he''d nod off, it''d wake him up with a deafening racket.');
INSERT INTO "item_descriptions" VALUES(12031,'en','Logram always remembered to take his getas off before a fight. He forgot once and metamorphosed with them still on. His paws grew to ten times their normal size... Pain is an excellent teacher, sometimes.');
INSERT INTO "item_descriptions" VALUES(12032,'en','Logram mastered the art of origami, and made most of his equipment out of folded paper. That said, wearing his necklace won''t give you the power to control fire like a Firefoux. Also, don''t scratch your neck unless you want to end up burnt to a crisp... After all, everyone knows that Logram could get a bit distracted around matchsticks.');
INSERT INTO "item_descriptions" VALUES(12033,'en','The origami Foux head, inside Logram''s ring, allows him to project illusions of himself, which has never been much use in battle, since he has to stay within short range and stand absolutely still to do it. You might manage to impress one or two bystanders, but that''s all.');
INSERT INTO "item_descriptions" VALUES(12035,'en','No one knows what mysterious power kept Kalkaneus''s pants from falling off his bony little legs. A few people did come up with theories, but no one wanted to verify them.');
INSERT INTO "item_descriptions" VALUES(12036,'en','Kalkaneus only had one leg, so it follows that he only wore one boot. If you wear it, and nothing else, you''ll be able to imitate his rolling gait!');
INSERT INTO "item_descriptions" VALUES(12037,'en','Even though Kalkaneus only had one arm, one leg and one eye, he was a great hit with the ladies. What he carefully forgot to mention was that he was born that way and had only lost one thing in combat – his trousers.');
INSERT INTO "item_descriptions" VALUES(12039,'en','Hichete had been married before. Unfortunately, it didn''t last: he kept pushing his wife beyond the bend. Trapped, with her back against the wall, she chose to leave. Pushing and trapping pretty much sum up the story of Hichete''s life (and death).');
INSERT INTO "item_descriptions" VALUES(12040,'en','Hichete might have had the appearance and mocking laugh of any old Barbrossa, but he surpassed them all in terms of guile. Even this belt couldn''t hold his trousers up when he''d double up with laughter while pushing, trapping, fooling and hindering his opponents.');
INSERT INTO "item_descriptions" VALUES(12041,'en','Hichete, dishonest and sore loser as he was, always used to cheat at thumb wars: he used two hands. One to pin his opponent''s thumb down and, if that didn''t work, one to chop it off with his dagger.');
INSERT INTO "item_descriptions" VALUES(12043,'en','Haku was never a particularly communicative Zoth, much preferring activities inside to those outside. That is possibly why he lived to such a ripe old age, far from the grabbing claws of adventurers searching for kristalite and Zoth fabric. But he did eventually fumble.');
INSERT INTO "item_descriptions" VALUES(12044,'en','Haku wasn''t considered a Zoth Master because of his social status, his studies or his ability to fight, but because of the numerous interminable evenings he spends as a game master with his Zoth friends. He liked to keep that to himself, though.');
INSERT INTO "item_descriptions" VALUES(12045,'en','Haku has never been able to keep a girlfriend for very long. Each time an adventurer introduced herself to him, he got the impression she was only after him for his Zoth Master Fly, a situation which suited certain people perfectly.');
INSERT INTO "item_descriptions" VALUES(12057,'en','Thanos practised all manner of unsavoury occupations: drill sergeant, banker, moneylender, storyteller and occasional P.A.N.T.S. prophet. He used this staff to punish his apprentices and anyone that would listen to him, a daily habit that certainly kept him fit.');
INSERT INTO "item_descriptions" VALUES(12068,'en','Whether you''re standing in a breeze, or wading through a strong current, you''ll generate an enormous amount of energy wearing this belt. What you do with it is up to you.');
INSERT INTO "item_descriptions" VALUES(12069,'en','There are those who will happily proclaim that the word "whitish" doesn''t exist, and that "Whitish Fang" should actually be "White Fang". Show them this amulet, made from fangs that are neither white, nor yellow, nor grey, nor black, and see if they''ll shut up for a bit.
They probably won''t.');
INSERT INTO "item_descriptions" VALUES(12070,'en','Having thought about it, you wonder if this cloak, which you thought was an authentic piece made from Nelween Down, isn''t actually what it seems at first glance. You don''t remember Nelween being blue, or brown, let alone cut into two pieces the last time you saw her. Still, it''ll match the wallpaper in your bedroom, won''t it?');
INSERT INTO "item_descriptions" VALUES(12071,'en','These lovely leather boots suddenly become less appealing when you discover that the fur that lines them came from the still-smoking body of a living-dead Whitish Fang.');
INSERT INTO "item_descriptions" VALUES(12072,'en','The Nelween Smoke trapped in the buckle of this belt is still charged with magic. It''ll help you accomplish minor miracles, like lighting your way at night, and stopping you from trapping your unmentionables in your fly. You know what they say - "that''s got to hurt", and it does. It really, really does.');
INSERT INTO "item_descriptions" VALUES(12084,'en','The hairs sticking out of this hammer''s handle will guarantee you an excellent grip, even amidst a horde of slobbering Mastogobs.');
INSERT INTO "item_descriptions" VALUES(12085,'en','This ring is unbearable for two reasons: it stinks of wet Mastogob, and it''s covered in hairs which tickle you constantly between the fingers. Probably not the best present for your beloved.');
INSERT INTO "item_descriptions" VALUES(12086,'en','This ring is made of finest gold extracted from Royal Mastogob horns. It''s sure to touch the heart of anyone who fully appreciates the efforts necessary for its fabrication.');
INSERT INTO "item_descriptions" VALUES(12087,'en','When correctly trailed in the snow, this cloak will leave horn marks fit to frighten off the weakest monsters, although the same can''t be said for enraged Royal Mastogobs, who will see through the tracks in a flash and inevitably set off after you.');
INSERT INTO "item_descriptions" VALUES(12088,'en','Wands are Frigostine''s speciality. This one, however, seems a little different from the others - be careful not to bite off more than you can chew!');
INSERT INTO "item_descriptions" VALUES(12089,'en','With this amulet around your neck, the delicious smell of steaming hot pastries will envelop your senses and give you the illusion of strength. It is just an illusion, though.');
INSERT INTO "item_descriptions" VALUES(12090,'en','When you find out that the main ingredient of Frigostine cream is Pingwin Blubber, you''ll suddenly be much less inclined to lick this ring.');
INSERT INTO "item_descriptions" VALUES(12091,'en','This belt will draw the enemy''s attention to your love-handles and make them look good enough to eat. Decidedly, slimming techniques are getting more innovative by the day.');
INSERT INTO "item_descriptions" VALUES(12092,'en','These boots allowed Frigostine to crush bread into crumbs. They also sometimes came in handy on tourists who failed to leave a tip. If there''s one thing you should know about life on Frigost, it''s that they don''t mess about when it comes to respect.');
INSERT INTO "item_descriptions" VALUES(12093,'en','This cloak, sewn with gold thread by an expert craftsman, will bring you the official credibility you are so severely lacking.');
INSERT INTO "item_descriptions" VALUES(12094,'en','This ring is certainly highly official, but the chances are that your loved one would prefer something more sparkly.');
INSERT INTO "item_descriptions" VALUES(12095,'en','Following several catastrophes caused by needles that were a little too sharp, Mayor Cantile made a habit of decorating Frigost''s most skilful artisans with this amulet instead.');
INSERT INTO "item_descriptions" VALUES(12096,'en','These boots make so much noise when you walk in them that people say Lou Bricante, better known as "Loulou", filled them with lead so she could follow Mayor Cantile wherever she went.');
INSERT INTO "item_descriptions" VALUES(12097,'en','According to the P.A.N.T.S. prophets, the combined power of five of these rings would be enough to summon the Unknown Lord of Lava wearing just his pants. Yet another of that Ecaflip Lebar''s flights of fancy...');
INSERT INTO "item_descriptions" VALUES(12098,'en','This belt will provide essential support to any self-respecting P.A.N.T.S. prophet.');
INSERT INTO "item_descriptions" VALUES(12099,'en','This staff, made with extracts of Obsidemon bowel, is a real relic. Its location and the way to get hold of it are two of the most closely guarded secrets of the P.A.N.T.S. prophets. That and their recipe for cheesecake.');
INSERT INTO "item_descriptions" VALUES(12100,'en','The jeweller who produced this ring had just enough time to start carving Tengu Snowfoux''s head into a piece of wood before he was mercilessly trampled by his subject.');
INSERT INTO "item_descriptions" VALUES(12101,'en','They say that this was the wedding ring that Guten Tak offered his beloved Kami Snowfoux when they first met. Apparently, when she refused, his fur went white with rage.');
INSERT INTO "item_descriptions" VALUES(12102,'en','The story goes that one day a Frigostian tried to tame a baby Snowfoux by putting this amulet around his neck. That would probably have worked, if only the Snowfoux he had his heart set on hadn''t been one of Guten Tak''s offspring.');
INSERT INTO "item_descriptions" VALUES(12103,'en','Even if the origins of this bow remain mysterious, some Frigostians claim to have seen Guten Tak use it to cheat when competing at stalactite toss.');
INSERT INTO "item_descriptions" VALUES(12104,'en','Despite the fact that this is composed of a very rare mineral, only found in certain volcanic Fangs of Glass mines, and that it supposedly required several years of polishing, Waldos FieldChester Potcobble still never had the guts to offer it to Aurora Borealis.');
INSERT INTO "item_descriptions" VALUES(12105,'en','Aurora addresses a huge importance to watching her figure, and measures the length of the cords hanging from her belt every morning. So far, nobody has dared to tell her that leather stretches with time...');
INSERT INTO "item_descriptions" VALUES(12106,'en','Thanks to her aristocratic upbringing, Aurora was horrified when she saw the hat the head tailor had made for her - he was dismissed immediately. Since Frigost froze over, though, it seems that he''s got his job back.');
INSERT INTO "item_descriptions" VALUES(12107,'en','Enamoured by her project of creating a hotel completely surrounded by ice, Aurora''s boots were specially designed to keep her delicate feet from the cold. As far as not slipping is concerned, there''s still work to be done.');
INSERT INTO "item_descriptions" VALUES(12108,'en','This cloak may not be very elaborate, but it was enchanted by the great Magus Ax to always billow heroically, even when there''s no wind. This means it''s perfect for show-offs, although Professor Xa really chose it because he knew it wouldn''t get stuck in his wheels.');
INSERT INTO "item_descriptions" VALUES(12109,'en','It''s said that Professor Xa, who''s well known for being a skinflint, created this ring using a bolt that fell off his chair.');
INSERT INTO "item_descriptions" VALUES(12110,'en','The shoemaker who made these boots was the kind of guy who always had some kind of tasteless practical joke up his sleeve. Professor Xa fired him on the spot and swore never to wear the shoes.');
INSERT INTO "item_descriptions" VALUES(12111,'en','Don''t be fooled by this amulet''s ordinary appearance, as it is actually the key to the secret store of Professor Xa''s favourite cereal, Cerebios.');
INSERT INTO "item_descriptions" VALUES(12112,'en','What might Professor Xa need this shovel for, I hear you ask? Other than using it to keep the rowdiest of his Gluttonous Brockhards in check, he supposedly uses it to dig rocks, though he does it horizontally and not vertically... and doesn''t get very far.');
INSERT INTO "item_descriptions" VALUES(12113,'en','Too lazy to mine any diamonds for this ring, the Celestial Bearbarian chose instead to nab an unfortunate Apewicubic Bearbarian''s ice cube to set in a ring of honey. It evidently didn''t occur to him that his creation would melt as soon as it was worn.');
INSERT INTO "item_descriptions" VALUES(12114,'en','A miniature version of the crown so coveted by the Celestian Bearbarian, you should think twice before wearing it when he''s around, or you''ll run the risk of unleashing his fury. Which he has an awful lot of...');
INSERT INTO "item_descriptions" VALUES(12115,'en','Deeply embedded in a honey plinth, this sword bears an inscription that says only he who manages to remove it will be named king of the Bearbarians. They say that the Celestial Bearbarian got some help from several Rampant Bearbarians, but the result is the same.');
INSERT INTO "item_descriptions" VALUES(12116,'en','These leaves are bigger than any found so far in the area around Mount Scauldron, which is why the headdress is so rare.');
INSERT INTO "item_descriptions" VALUES(12117,'en','Given the unhealthy amount of fur growing on Fuji Snowfoux''s back, the small fraction needed for this cloak isn''t going to make much difference to her body mass.');
INSERT INTO "item_descriptions" VALUES(12118,'en','With this headgear on, you can be sure to attract all the Maho Snowfoux during mating season. It''s up to you to decide whether that''s a good thing or not.');
INSERT INTO "item_descriptions" VALUES(12119,'en','Snowfoux leather is known to be extremely resistant, but its unbearable odour tends to put off even the most seasoned shoemakers. Using Fuji Snowfoux leather helps a bit with this problem, but watch out, as there may be other side effects...');
INSERT INTO "item_descriptions" VALUES(12120,'en','Before she gave birth to the Snowfoux, Fuji Snowfoux used to wear this ring as a belt. Nowadays, it fits her podgy fingers perfectly. It''ll fit yours too.');
INSERT INTO "item_descriptions" VALUES(12133,'en','Mother Nature did not smile down on little Solid Plissken. Teased by his peers because he has only one eye, he also has only one fang, which is nevertheless very useful for collecting flowers, plants, and the skulls of anyone who dares mock him.');
INSERT INTO "item_descriptions" VALUES(12177,'en','As contradictory as it may seem, Tofume is a very kind evil tofu. Without pity or remorse, he''ll join you in exterminating anything that crawls, walks, flies or swims and take great delight in doing so. They say birds of a feather flock together... Since you both define "kindness" in the same way, it''s normal that you get along so well.');
INSERT INTO "item_descriptions" VALUES(12237,'en','Made by Isgrate Giftoyu, this amulet symbolises passionate love. When you put it on, you can make Ballotwine''s Day last forever.');
INSERT INTO "item_descriptions" VALUES(12238,'en','Made by Isgrate Giftoyu, this amulet symbolises passionate love. When you put it on, you can make Ballotwine''s Day last forever.');
INSERT INTO "item_descriptions" VALUES(12370,'en','Push. Push harder. Still no luck? Are you sure you''re trying to get the amulet around your neck...?');
INSERT INTO "item_descriptions" VALUES(12371,'en','Wrapped around your waist and passed between your legs, this cape will really emphasise your extra padding.');
INSERT INTO "item_descriptions" VALUES(12372,'en','Excellent for protecting your hands during a boxing match, this glove can be spun to collect the necessary fat to make potted dragon pig.');
INSERT INTO "item_descriptions" VALUES(12373,'en','Wearing these boots, you can make the ground tremble by tapping your foot, which is sure to titillate all the Lousy Pigs in your vicinity. A cheap but dangerous way of finding a partner.');
INSERT INTO "item_descriptions" VALUES(12379,'en','When you pull this bristly bracelet on, you''ll relive your last encounter with Fuji, minus the humidity. Oh and FYI you can also wear it on your wrist.');
INSERT INTO "item_descriptions" VALUES(12380,'en','You can''t see any difference between these hairy boots and your feet, but it should be obvious: the boots smell nice.');
INSERT INTO "item_descriptions" VALUES(12385,'en','The skull drawn on Rogues'' headscarves allows them to pretend to be dead in order to take dimwitted enemies such as Tofus and Iops by surprise. Be warned, though: undesirable side effects have been reported by people wearing the scarves in cemetaries during the Chafer mating season.');
INSERT INTO "item_descriptions" VALUES(12386,'en','The Arpone Mask, which is based on the Stinkshop Mask, smells less strong but is unfortunately less powerful as well. That''s why it''s best used alongside other equipment - why not try it with the Misu Tiara?');
INSERT INTO "item_descriptions" VALUES(12387,'en','Vil Smisse was the first to use this cloak for subterfuge; in fact, it saved his life many times, including once when he was hanging by his toes. Since then, Rogues condemned to death have got used to following his example.');
INSERT INTO "item_descriptions" VALUES(12388,'en','Masqueraiders like to fight to music and this cloak is perfect for keeping time. They also use it to drum lessons into naughty children''s heads.');
INSERT INTO "item_descriptions" VALUES(12389,'en','Rogues are so sneaky that they hide their Machiavellian plans and mission orders in their boots. I mean, who''s reckless enough to brave the deadly stench just to check inside a dead Rogue''s boots?');
INSERT INTO "item_descriptions" VALUES(12390,'en','Have you ever won a fight by darting nimbly here and there in clogs disguised as shoes? Wooden''t you like to give it a go?');
INSERT INTO "item_descriptions" VALUES(12391,'en','Useful for storing bombs, try not to dance around too much when wearing this belt, or you really will have a blast.');
INSERT INTO "item_descriptions" VALUES(12392,'en','To ascertain whether a Masqueraider was worthy of wearing its first mask, an ancient custom required that two young hopefuls be tied up and plunged head first into a barrel of bwork beer. The first one to escape earned his mask and wore the ropes around his waist as a souvenir of this rite of passage. Even if the tradition has died out, Masqueraiders still produce these belts in its memory.');
INSERT INTO "item_descriptions" VALUES(12393,'en','These mittens were worn for many years by the Rogue magician Lina, who enhanced her bombs using black magic in order to create explosives powerful enough to kill dragons. They remain imbued with her power to this day.');
INSERT INTO "item_descriptions" VALUES(12394,'en','It is said that this bracelet will ensure you a place in history. It is also said that it will make you the most popular of all Masqueraiders. It is even said that some numskulls believe all of this.');
INSERT INTO "item_descriptions" VALUES(12407,'en','This amulet is the trophy which proves that you decimated hordes of Sauroshells who had barely had the time to grow up. Now your mission is to conceal this mass infanticide from their parents, Grozilla and Grasmera, who are no longer weak and pubescent at all.');
INSERT INTO "item_descriptions" VALUES(12408,'en','When you asked your jeweller to make this amulet, you thought that its decorative bezoar would cool down eventually. Unfortunately, it is still as ardent as ever: it catches fire with every breeze, and you''ll boil yourself alive if you forget to take it off before getting in the bath. The other side of the victory coin, eh?');
INSERT INTO "item_descriptions" VALUES(12409,'en','The compass embedded in this ring will prove very useful for finding the way back to your cosy little cottage after all your friends have been slaughtered by furious Sauroshells.');
INSERT INTO "item_descriptions" VALUES(12410,'en','In the past, this bracelet was given to tourists visiting Vulkania to make sure that they didn''t come to the island twice despite only registering once. Charlie''s Agents soon stopped this when they realised that nobody ever wanted to come back to Vulkania. That is, if they ever made it off, and didn''t end up in the island''s ever more populous cemetery.');
INSERT INTO "item_descriptions" VALUES(12411,'en','Made from the remains of dozens of Juvenile Sauroshells, these boots are very trendy outside Vulkania. On Vulkania, they''re perfect for suicide missions amongst the Venerable Sauroshells, who''ll take it upon themselves to avenge their little brothers without hesitation.');
INSERT INTO "item_descriptions" VALUES(12412,'en','The very fact that Grozilla has boots named after him might seem ironic considering the idleness he has famously developed since settling down in Vulkania with Grasmera. That said, who wouldn''t be idle on a heavenly island with charming company and all the exotic meals one could wish for?');
INSERT INTO "item_descriptions" VALUES(12413,'en','The Saurosheller Cloak is a guilty pleasure for Vulkania''s craftsmen, who get a kick out of seeing an adventurer run in one: the hard, heavy cape smacks against his calves, wears down his shoulder blades and often knocks him entirely off balance.');
INSERT INTO "item_descriptions" VALUES(12414,'en','With this pack on your back, you''re ready to explore Vulkania at your leisure. Warning - Vulkanian craftsman by no means guarantee its efficiency once you''ve left the island... although some claim that a well-stocked PLVB is better than other bags when all you want to do is sit in a corner on a paving slab and break the fast.');
INSERT INTO "item_descriptions" VALUES(12415,'en','The Saurosheller Belt is traditionally presented to Vulkanian teenagers and becomes impossible to remove when they become adults. That way, they have to stay in shape if they don''t want it cutting into their flesh. As for you, perhaps you can squeeze it around one thigh, or, more realistically, a calf.');
INSERT INTO "item_descriptions" VALUES(12416,'en','Grozilla and Grasmera''s reported debauchery with Dragostesses has always been a hot topic of discussion, scandalising girl adventurers and awing their male companions. This belt and its enormous... buckles have become one way for the afore-mentioned boys to claim they live by the same rules. Obviously, they''re lying.');
INSERT INTO "item_descriptions" VALUES(12417,'en','This hat will make you look like a hunter from the darkest wild, who''ll make your enemies feel just like children. In any case, that''s what a certain Pan Velt would tell anyone who''d listen.');
INSERT INTO "item_descriptions" VALUES(12418,'en','Jamming this headgear on, you look forward to showing everyone that you''ve defeated the terrible Grozilla. In practise, all you can really do with it is terrify children and/or get a job as the mascot of your favourite Gobbowl team.');
INSERT INTO "item_descriptions" VALUES(12421,'en','Unlike the Tetra Cloak or Hammer, this Amulet always faces the same way no matter how much you turn around. Make sure you don''t get a stiff neck!');
INSERT INTO "item_descriptions" VALUES(12423,'en','This magic ring, if you should let it drop, will only slow down its fall by landing on its head.');
INSERT INTO "item_descriptions" VALUES(12463,'en','No one knows why the straps on this mankini are so long. Did it once belong to the lanky Rushu? Was it used as a catapult in the Battle of the Crimson Dawn? There''s certainly something off-putting about it.');
INSERT INTO "item_descriptions" VALUES(12465,'en','These varnished shoes are the height of fashion in some of the less well-developed countries of the World of Twelve. In Amakna, however, you might be mistaken for an ill-mannered immigrant.');
INSERT INTO "item_descriptions" VALUES(12466,'en','The Boracelet is really a simple bracelet made of black plastic. Its creator, however, managed to turn it into a great commercial success by inventing madder and madder ways to use it. Some of them were in such dubious taste we''d rather not go into details here. And that''s saying something.');
INSERT INTO "item_descriptions" VALUES(12502,'en','This belt was made to match Pandalida''s favourite weapon, the Andy War Sword, perfectly. Simply decorated, the sabre has proven its worth in battle. This belt has not: the pieces of gold hanging from it make so much noise your enemies always hear every move you make.');
INSERT INTO "item_descriptions" VALUES(12512,'en','Any self-respecting Masticator knows that he shouldn''t try to harvest gum from the Wriggly tree with his bare hands, unless he wants to find his hands stuck to the bark... forever. And forever is filled with unbearable, unreachable itches.');
INSERT INTO "item_descriptions" VALUES(1012541,'en','A reward for adventurers who have proved their worth by defeating Grozilla and Grasmera several times during their period of semi-dormancy, this Madreggon is very popular among the people of Astrub.');
INSERT INTO "item_descriptions" VALUES(12598,'en','This ring used to be the seal of an army general from a faraway country who wanted to invade Amakna. He didn''t prove too much of a problem to his enemies due to his tactical errors. Essentially, his troops moved side to side as one big group, only advancing very slowly, instead of just moving forward in a straight line. This made them the easiest targets that Allister''s Army had ever fought against.');
INSERT INTO "item_descriptions" VALUES(12599,'en','Equipped with this belt, you will feel like a true hero, able to decimate entire armies on your own. The hard part will be finding an army that lets you decimate it.');
INSERT INTO "item_descriptions" VALUES(12622,'en','This Trophy lets you keep the cowards close to you. So you can crush them more easily.');
INSERT INTO "item_descriptions" VALUES(12623,'en','This Trophy lets you keep the cowards close to you. So you can crush them more easily.');
INSERT INTO "item_descriptions" VALUES(12624,'en','This Trophy lets you keep the cowards close to you. So you can crush them more easily.');
INSERT INTO "item_descriptions" VALUES(12625,'en','This Trophy lets you escape when the opportune moment presents itself.');
INSERT INTO "item_descriptions" VALUES(12626,'en','This Trophy lets you escape when the opportune moment presents itself.');
INSERT INTO "item_descriptions" VALUES(12627,'en','This Trophy lets you escape when the opportune moment presents itself.');
INSERT INTO "item_descriptions" VALUES(12628,'en','This Trophy helps you slow down your opponent''s movements so you can catch them more quickly and humiliate them accordingly, by giving them a wedgie, for example.');
INSERT INTO "item_descriptions" VALUES(12629,'en','This Trophy helps you slow down your opponent''s movements so you can catch them more quickly and humiliate them accordingly, by giving them a wedgie, for example.');
INSERT INTO "item_descriptions" VALUES(12630,'en','This Trophy helps you slow down your opponent''s movements so you can catch them more quickly and humiliate them accordingly, by giving them a wedgie, for example.');
INSERT INTO "item_descriptions" VALUES(12631,'en','This Trophy enables you to oppress your aggressors more easily. It also seems to work on digressers.');
INSERT INTO "item_descriptions" VALUES(12632,'en','This Trophy enables you to oppress your aggressors more easily. It also seems to work on digressers.');
INSERT INTO "item_descriptions" VALUES(12633,'en','This Trophy enables you to oppress your aggressors more easily. It also seems to work on digressers.');
INSERT INTO "item_descriptions" VALUES(12634,'en','This Trophy allows you to escape from anyone who''s trying to prevent you from reaching your destination. This doesn''t work against those who are trying to prevent you from reaching your destiny though.');
INSERT INTO "item_descriptions" VALUES(12635,'en','This Trophy allows you to escape from anyone who''s trying to prevent you from reaching your destination. This doesn''t work against those who are trying to prevent you from reaching your destiny though.');
INSERT INTO "item_descriptions" VALUES(12636,'en','This Trophy allows you to escape from anyone who''s trying to prevent you from reaching your destination. This doesn''t work against those who are trying to prevent you from reaching your destiny though.');
INSERT INTO "item_descriptions" VALUES(12637,'en','This Trophy allows you to escape from anyone who''s trying to limit your actions. It doesn''t work against lawyers.');
INSERT INTO "item_descriptions" VALUES(12638,'en','This Trophy allows you to escape from anyone who''s trying to limit your actions. It doesn''t work against lawyers.');
INSERT INTO "item_descriptions" VALUES(12639,'en','This Trophy allows you to escape from anyone who''s trying to limit your actions. It doesn''t work against lawyers.');
INSERT INTO "item_descriptions" VALUES(12640,'en','This Trophy enables you to do a bit more damage to an opponent when you push them against a tree, some debris or another enemy with a goatee.');
INSERT INTO "item_descriptions" VALUES(12641,'en','This Trophy enables you to do a bit more damage to an opponent when you push them against a tree, some debris or another enemy with a goatee.');
INSERT INTO "item_descriptions" VALUES(12642,'en','This Trophy enables you to do a bit more damage to an opponent when you push them against a tree, some debris or another enemy with a goatee.');
INSERT INTO "item_descriptions" VALUES(12643,'en','This Trophy lessens your suffering a little when your opponents push you against a tree, a person, an animal or just something really big and hard. It does not protect you from blows, not even those dealt by calloused hands.');
INSERT INTO "item_descriptions" VALUES(12644,'en','This Trophy lessens your suffering a little when your opponents push you against a tree, a person, an animal or just something really big and hard. It does not protect you from blows, not even those dealt by calloused hands.');
INSERT INTO "item_descriptions" VALUES(12645,'en','This Trophy lessens your suffering a little when your opponents push you against a tree, a person, an animal or just something really big and hard. It does not protect you from blows, not even those dealt by calloused hands.');
INSERT INTO "item_descriptions" VALUES(12646,'en','This Trophy protects you from Critical Hits in critical places at critical moments. Once it''s equipped, you will suffer a side effect which will really get on your friends'' nerves: You won''t be able to accept criticism.');
INSERT INTO "item_descriptions" VALUES(12647,'en','This Trophy protects you from Critical Hits in critical places at critical moments. Once it''s equipped, you will suffer a side effect which will really get on your friends'' nerves: You won''t be able to accept criticism.');
INSERT INTO "item_descriptions" VALUES(12648,'en','This Trophy protects you from Critical Hits in critical places at critical moments. Once it''s equipped, you will suffer a side effect which will really get on your friends'' nerves: You won''t be able to accept criticism.');
INSERT INTO "item_descriptions" VALUES(12649,'en','This Trophy will protect you from Air attacks, but not from Air spray.');
INSERT INTO "item_descriptions" VALUES(12650,'en','This Trophy will protect you from Air attacks, but not from Air spray.');
INSERT INTO "item_descriptions" VALUES(12651,'en','This Trophy will protect you from Air attacks, but not from Air spray.');
INSERT INTO "item_descriptions" VALUES(12652,'en','This Trophy will protect you from Water attacks, but not from Water sports.');
INSERT INTO "item_descriptions" VALUES(12653,'en','This Trophy will protect you from Water attacks, but not from Water sports.');
INSERT INTO "item_descriptions" VALUES(12654,'en','This Trophy will protect you from Water attacks, but not from Water sports.');
INSERT INTO "item_descriptions" VALUES(12657,'en','Strangely, whichever jeweller created this hairy amulet, with a rat nose and ears growing out of it, systematically refused to sign it. You can''t really blame them.');
INSERT INTO "item_descriptions" VALUES(12658,'en','Only adventurers of a certain age will understand why the symbol on this bracelet is of a cat''s paw, whereas the rest of these items seem to be linked to rats. Sneaky as they are, they''re keeping quiet about it. Or are they senile already?');
INSERT INTO "item_descriptions" VALUES(12659,'en','This Trophy protects you from Fire attacks, but not Goblets of Fire.');
INSERT INTO "item_descriptions" VALUES(12660,'en','With this shield, everyone can see that you''ve left Incarnam and joined the World of Twelve to set off on the long search for the Dofus.');
INSERT INTO "item_descriptions" VALUES(12661,'en','This small bag, created by Poss''Ybel, is all the rage in Incarnam. Adventurers find it as practical as it is elegant. The more experienced ones keep the teeth they tear from the mouths of their enemies in it.');
INSERT INTO "item_descriptions" VALUES(12671,'en','The musical note on Davyd''s belt is actually a button which, once activated, launches an S.O.S. into the sky, signalling to all the space oddities that an earthling''s in trouble. Somebody up there likes him.');
INSERT INTO "item_descriptions" VALUES(12672,'en','Unwashed and slightly dazed, but always at the height of country fashion, Davyd was the one who invented this hybrid of clogs and boots, which combines the solidity and the rustic feel of the clog with the protection and practicality offered by the boot. He never stopped campaigning for their popularity, going so far as to say they were the product of his own sweat and tears. Which probably put a great many people off wearing them.');
INSERT INTO "item_descriptions" VALUES(12674,'en','You''ve just put on the same hat that Daggero has been wearing since his early childhood. Unfortunately, you don''t have the same excuse he did: no one ever told him it was already a good decade out of fashion.');
INSERT INTO "item_descriptions" VALUES(12675,'en','Daggero took this blood-coloured pearl necklace from the body of a Kitsou chief who had attacked his village in the past, Red. Let''s hope no one ever asks you where you got yours from. No one''s going to believe you''re a Pandawushu Master if you admit you just ordered a cheap copy from your jeweller.');
INSERT INTO "item_descriptions" VALUES(12676,'en','This loincloth bears the marks of the long years of intense training that Daggero put himself through so he could one day defeat Zatoishwan. Strangely, it''s only been giving off that musty smell since you put it on.');
INSERT INTO "item_descriptions" VALUES(12677,'en','After destroying his village, Daggero made this staff from its still-fuming remains. He was almost able to make himself another one from yours.');
INSERT INTO "item_descriptions" VALUES(12678,'en','This Trophy protects you from Fire attacks, but not Goblets of Fire.');
INSERT INTO "item_descriptions" VALUES(12679,'en','This Trophy protects you from Fire attacks, but not Goblets of Fire.');
INSERT INTO "item_descriptions" VALUES(12680,'en','This Trophy protects you from Earth attacks, unless you happen to be in Middle-Earth.');
INSERT INTO "item_descriptions" VALUES(12681,'en','This Trophy protects you from Earth attacks, unless you happen to be in Middle-Earth.');
INSERT INTO "item_descriptions" VALUES(12682,'en','This Trophy protects you from Earth attacks, unless you happen to be in Middle-Earth.');
INSERT INTO "item_descriptions" VALUES(12683,'en','This Trophy protects you from Neutral attacks, but it won''t make your enemies any more Neutral once the hostilities commence.');
INSERT INTO "item_descriptions" VALUES(12684,'en','This Trophy protects you from Neutral attacks, but it won''t make your enemies any more Neutral once the hostilities commence.');
INSERT INTO "item_descriptions" VALUES(12685,'en','This Trophy protects you from Neutral attacks, but it won''t make your enemies any more Neutral once the hostilities commence.');
INSERT INTO "item_descriptions" VALUES(12686,'en','This Trophy increases Air attack damage in those who are full of hot air.');
INSERT INTO "item_descriptions" VALUES(12687,'en','This Trophy increases Air attack damage in those who are full of hot air.');
INSERT INTO "item_descriptions" VALUES(12688,'en','This Trophy increases Air attack damage in those who are full of hot air.');
INSERT INTO "item_descriptions" VALUES(12689,'en','This Trophy increases Water attack damage, but it won''t help you turn water into wine.');
INSERT INTO "item_descriptions" VALUES(12690,'en','This Trophy increases Water attack damage, but it won''t help you turn water into wine.');
INSERT INTO "item_descriptions" VALUES(12691,'en','This Trophy increases Water attack damage, but it won''t help you turn water into wine.');
INSERT INTO "item_descriptions" VALUES(12692,'en','This Trophy increases Fire damage. According to the label, it''s guaranteed to get you all fired up.');
INSERT INTO "item_descriptions" VALUES(12693,'en','This Trophy increases Fire damage. According to the label, it''s guaranteed to get you all fired up.');
INSERT INTO "item_descriptions" VALUES(12694,'en','This Trophy increases Fire damage. According to the label, it''s guaranteed to get you all fired up.');
INSERT INTO "item_descriptions" VALUES(12695,'en','This Trophy increases Neutral attack damage. It was invented by a famous ogre: Pete Aitchnutrool.');
INSERT INTO "item_descriptions" VALUES(12696,'en','This Trophy increases Neutral attack damage. It was invented by a famous ogre: Pete Aitchnutrool.');
INSERT INTO "item_descriptions" VALUES(12697,'en','This Trophy increases Neutral attack damage. It was invented by a famous ogre: Pete Aitchnutrool.');
INSERT INTO "item_descriptions" VALUES(12698,'en','This Trophy increases Earth attack damage. Only Earthworms are impressed by this.');
INSERT INTO "item_descriptions" VALUES(12701,'en','This Trophy increases Initiative instead of taking it.');
INSERT INTO "item_descriptions" VALUES(12702,'en','This Trophy increases Initiative instead of taking it.');
INSERT INTO "item_descriptions" VALUES(12703,'en','This Trophy increases Initiative instead of taking it.');
INSERT INTO "item_descriptions" VALUES(12704,'en','This Trophy increases the maximum weight you''re able to carry. It doesn''t make a heavy heart any easier to bear though.');
INSERT INTO "item_descriptions" VALUES(12705,'en','This Trophy increases the maximum weight you''re able to carry. It doesn''t make a heavy heart any easier to bear though.');
INSERT INTO "item_descriptions" VALUES(12706,'en','This trophy increases the maximum weight you can carry, but it won''t make the weight of your misdeeds any easier to bear.');
INSERT INTO "item_descriptions" VALUES(12707,'en','This Trophy increases Heals. It won''t make you look any more lively, though.');
INSERT INTO "item_descriptions" VALUES(12708,'en','This Trophy increases Heals. It won''t make you look any more lively, though.');
INSERT INTO "item_descriptions" VALUES(12709,'en','This Trophy increases Heals. It won''t make you look any more lively, though.');
INSERT INTO "item_descriptions" VALUES(12712,'en','This trophy increases your Agility. You''re finally going to be able to climb on your high horse without falling off.');
INSERT INTO "item_descriptions" VALUES(12713,'en','This trophy increases your Agility. You''re finally going to be able to climb on your high horse without falling off.');
INSERT INTO "item_descriptions" VALUES(12714,'en','This trophy increases your Agility. You''re finally going to be able to climb on your high horse without falling off.');
INSERT INTO "item_descriptions" VALUES(12715,'en','This Trophy increases your Chance. It doesn''t seem to have any effect when you use cheesy chat-up lines though.');
INSERT INTO "item_descriptions" VALUES(12716,'en','This Trophy increases your Chance. It doesn''t seem to have any effect when you use cheesy chat-up lines though.');
INSERT INTO "item_descriptions" VALUES(12717,'en','This Trophy increases your Chance. It doesn''t seem to have any effect when you use cheesy chat-up lines though.');
INSERT INTO "item_descriptions" VALUES(12718,'en','This Trophy increases your Intelligence. I wonder why the auctioneers at the Astrub Zaap have never thought to get one?');
INSERT INTO "item_descriptions" VALUES(12719,'en','This Trophy increases your Intelligence. I wonder why the auctioneers at the Astrub Zaap have never thought to get one?');
INSERT INTO "item_descriptions" VALUES(12720,'en','This Trophy increases your Intelligence. I wonder why the auctioneers at the Astrub Zaap have never thought to get one?');
INSERT INTO "item_descriptions" VALUES(12722,'en','This trophy increases your Strength. Unfortunately, it doesn''t increase strength of mind though.');
INSERT INTO "item_descriptions" VALUES(12723,'en','This trophy increases your Strength. Unfortunately, it doesn''t increase strength of mind though.');
INSERT INTO "item_descriptions" VALUES(12724,'en','This trophy increases your Strength. Unfortunately, it doesn''t increase strength of mind though.');
INSERT INTO "item_descriptions" VALUES(12725,'en','This trophy increases Vitality. Its effects against impotence have never been proven.');
INSERT INTO "item_descriptions" VALUES(12726,'en','This trophy increases Vitality. Its effects against impotence have never been proven.');
INSERT INTO "item_descriptions" VALUES(12727,'en','This trophy increases Vitality. Its effects against impotence have never been proven.');
INSERT INTO "item_descriptions" VALUES(12747,'en','This Trophy increases Earth attack damage. Only Earthworms are impressed by this.');
INSERT INTO "item_descriptions" VALUES(12748,'en','This Trophy increases Earth attack damage. Only Earthworms are impressed by this.');
INSERT INTO "item_descriptions" VALUES(12753,'en','The ball between the Pongbelt''s two bands moves around the belt all the time, constantly kneading your love handles. In short, it''s quite ridiculous, kind of unpleasant and definitely not glamorous. But they say it helps you lose weight, so you should give it a shot at least.');
INSERT INTO "item_descriptions" VALUES(12754,'en','The amulet around your neck is a miniature version of the original Pongulet, which was as tall and wide as a Treechnid. After a number of broken necks and a lukewarm response from critics, its creator decided to make a portable version, which was a great success.');
INSERT INTO "item_descriptions" VALUES(12756,'en','Whatever you do, don''t give this amulet to a child: they''ll want to chew on the ghost beads, and will die instantly. Strangely enough, chewing a special kind of gum will turn these dangerous ghosts into a tasty, and quite harmless, delicacy.');
INSERT INTO "item_descriptions" VALUES(12757,'en','These boots are capable of engulfing anything you kick with them. A kick in the danglies with a pair of Pacmaboots is every male adventurer''s worst nightmare.');
INSERT INTO "item_descriptions" VALUES(12774,'en','These boots, which are fitted with wooden rackets, will be underfoot wherever you go. They are resistant to digestive juices and caustic humour.');
INSERT INTO "item_descriptions" VALUES(12775,'en','This wooden belt is just right for holding in large stomachs and protecting tummy buttons from Critical Hits.');
INSERT INTO "item_descriptions" VALUES(12848,'en','This coat is quite a paradox. You put it on to stop shivering, but the cold metal of the bells which hang off it here and there brush against you unexpectedly as they jingle, which makes you shiver even more.');
INSERT INTO "item_descriptions" VALUES(12849,'en','Wear this hat and your head will be sound as a bell!');
INSERT INTO "item_descriptions" VALUES(12850,'en','These underpants will keep your manhood safe and warm. Plus, the strategically-placed bells will let everyone know you''ve got a thing for the young lady who just walked past.');
INSERT INTO "item_descriptions" VALUES(12851,'en','The Goblimps have turned this baby rattle into a magnificent bracelet. If you shake it hard enough, you might be able to cover the Astrubian tourists'' wailing.');
INSERT INTO "item_descriptions" VALUES(12852,'en','Jack would have loved to be a vampire, but instead, he had to be a lowly skeleton his whole life. In order to be just a tiny bit cooler, he had this cape made.');
INSERT INTO "item_descriptions" VALUES(12853,'en','Jack was such a devious fellow that he had the crazy idea of dressing up as himself to do his misdeeds and throw people off the scent. Using this mask, you can do the same thing! If you''re a Sram, that is.');
INSERT INTO "item_descriptions" VALUES(12854,'en','Jack was a Sram who just loved tricks and treats. For that reason, he spent almost all his time knocking at doors to ask for sweets. One day, though, he knocked on Tengu Snowfoux''s door when Fuji Snowfoux was visiting... All they found of poor Jack was this amulet.');
INSERT INTO "item_descriptions" VALUES(12855,'en','The other Frigostians always saw Jack as something of an eccentric, which is why the only person he could find to make these boots was an Amaknian shoemaker who was part of the Order of the Kicked Ass. The boots'' shape was specially chosen to suit the Order''s techniques.');
INSERT INTO "item_descriptions" VALUES(12856,'en','This saddlebag gives easy access to bottles during combat, which makes it an obvious choice for Pandawa adventurers.');
INSERT INTO "item_descriptions" VALUES(12857,'en','This headgear is great for showing your rivals that you''re looking for a real challenge. It''s also useful for sending out an explicit message to any ladies in the vicinity, although your mileage may vary.');
INSERT INTO "item_descriptions" VALUES(12858,'en','Wear this halter around your neck if you''re scared of wandering off and never being found again. Tried and tested by Gobball breeders.');
INSERT INTO "item_descriptions" VALUES(12859,'en','These hooves are fitted with anti-slip soles. The shoemaker who made them assures everyone that that''s to avoid their wearer from slipping on ice, but everyone knows that they''re really to stop the wearer from slipping in puddles of spilt beer late at night.');
INSERT INTO "item_descriptions" VALUES(12882,'en','These little boots will make a cute clip-clopping sound when you move. This will often by followed by a heavy "BOOM" when you fall onto the ground because these tough, round boots really aren''t good for your balance.');
INSERT INTO "item_descriptions" VALUES(12883,'en','Tidy your hair up in an instant with this Brushdant, which will enable you to face up to any hair-raising situation. Unfortunately, though, its meagre powers won''t ruffle your enemies'' hair.');
INSERT INTO "item_descriptions" VALUES(12887,'en','These Gladiapants, worn on their own, are going to delight powerful and muscular adventurers. Of course, on you, at best they''ll look like you''re a little bit eccentric and, at worse, a dangerous pervert.');
INSERT INTO "item_descriptions" VALUES(12888,'en','These boots will weaken your kicks so you don''t hurt your opponent. It''s very kind of you, but it won''t stop the Gobballs biting your knees off with very little effort.');
INSERT INTO "item_descriptions" VALUES(1012963,'en','A loyal hunting companion of Goblimps who travel the Taiga, the Slayhound''s bite is worse than its bark.');
INSERT INTO "item_descriptions" VALUES(12969,'en','This bracelet is so enormous that you could use it as a belt or hang it around one of your swollen ankles. Big-headed adventurers like you can even wear it as a crown! The jeweller who made it really was the practical type.');
INSERT INTO "item_descriptions" VALUES(12975,'en','This frozen tofu does indeed have a beak, which is how you can tell it apart from a snowball. Tired of Goblimp island and Kwismas karols, it decided to follow you and see new places. Isn''t its presence by your side the most wonderful of gifts?');
INSERT INTO "item_descriptions" VALUES(12982,'en','Mouselet is the most voracious vegetarian in all Amakna. Its favourite hobbies include upsetting the Api cart and getting rid of the bad eggs, so it can have its cake and eat it too. And they say carnivores are bloodthirsty...');
INSERT INTO "item_descriptions" VALUES(12988,'en','Scarakiri has a very extreme sense of honour. No longer able to bear the unjustified hostility shown by its brothers on Minotoror Island, it''s resigned itself to serving you in order to make up for its kind''s misdeeds and restore the honour of its long line of honourable Scaratos. If it fails, death is the only option.');
INSERT INTO "item_descriptions" VALUES(12994,'en','Grauler is the smallest of all the Raul Mops, and it''s not very happy about it. Even the Snappers are bigger than it – and they swim around, mocking it. Constantly complaining about all the insults, it decided to show everyone that size doesn''t matter. When you want to get respect, the important thing is to befriend a brute.');
INSERT INTO "item_descriptions" VALUES(13000,'en','When you chose to adopt the Moowitty, you might have expected a pet who''s a laugh a minute. Unfortunately, it''s not half as funny as its name would have you believe. A fan of crude jokes in bad taste, the Moowitty will have you at your wit''s end. It''s been banned from the Moowolf Lair and the Sidimote Moors.');
INSERT INTO "item_descriptions" VALUES(13017,'en','This feathery belt will really emphasise your waist. Not that it needs much emphasising.');
INSERT INTO "item_descriptions" VALUES(13018,'en','These downy boots, which give the impression you have Dragoturkey feet, would make excellent slippers. You know, the type your guests make fun of whenever you wear them round the house? You aren''t really going to wear them outside, are you?');
INSERT INTO "item_descriptions" VALUES(13020,'en','Of modest origins, Feline has only ever been known to wear boots on her feet. To keep up her image as a diva, she asked one of the greatest cobblers in Frigost to find a dye that would turn them a pretty pink colour. He ended up taking his own life, unable to forgive himself for having created such a monster.');
INSERT INTO "item_descriptions" VALUES(13022,'en','The crystal on Feline''s necklace rings in harmony with her vocal chords and can create devastating shock waves. However, they will never do as much damage as her voice alone, which can effortlessly pierce your eardrums and ruin even your most beautiful fantasies.');
INSERT INTO "item_descriptions" VALUES(13063,'en','Where there is Arty, there is his cane. Legend has it that one end is coated in black treacle to attract herds of lost Gobballs. The other is supposedly splintered wood, just to get those Gobballs moving! You certainly won''t want to get the wrong end of the stick on this one! Unfortunately, this cane seems to have a serious design flaw which renders it unusable. Juss Tafinger, the ski maker in Frigost Village, should be able to exchange it for one that works.');
INSERT INTO "item_descriptions" VALUES(13064,'en','This cursed hat used to belong to Katar, but he lost his mind. Mad as a hatter, he ended up beheaded. Take heed!');
INSERT INTO "item_descriptions" VALUES(13071,'en','He''s a little shell-shocked and a little crabby, but after years of experimentation, Mekrab has clawed his way out of the lab and into existence. He was designed to be a basic robotic life-form but, as with all crazy experimental subjects, he''s gone a bit wrong... Obsessed with the meaning of life (as artificial as his is), he''s counting on you to help him find the answers to his questions since you spend so much time dying and coming back to life and dying again without wondering about it.');
INSERT INTO "item_descriptions" VALUES(13091,'en','Ronin Chafer bones are black from the hundreds of years spent wandering without a master, guided solely by dark intentions. If you''re as black as this Kabuto, however, it''s only because you haven''t had a wash for ages, you dirty devil.');
INSERT INTO "item_descriptions" VALUES(13092,'en','If you''ve read up on obscure Draugur Chafer legends, you might think that this hammer will come back to you just like a boomerang when you throw it. To this day, the truth behind the legend is unknown, as most adventurers can only throw it as far as on their own toes!');
INSERT INTO "item_descriptions" VALUES(13093,'en','The Ronin Chafer doesn''t need to wear any underwear underneath his loincloth: thanks to his lack of flesh, a glimpse of his coccyx from the front has never shocked a soul. You should probably avoid testing out people''s reactions to the same frontal view of your coccyx.');
INSERT INTO "item_descriptions" VALUES(13094,'en','The tailor that created these boots thought he was making them for the Ronin Chafer. He obviously thought you looked primitive enough already.');
INSERT INTO "item_descriptions" VALUES(13095,'en','The headband that you will wear as a Rokwa Pandawushuka is a multi-functional garment. Covering your forehead, it shows oncomers that you are indeed a martial artist; covering your eyes, it allows you to take an afternoon nap without anyone noticing; and covering your mouth, it makes sure you don''t talk nonsense.');
INSERT INTO "item_descriptions" VALUES(13099,'en','Although Plop would never hurt a fly, he has never truly been accepted by the other aquatic creatures of Sufokia. These creatures are horrified at the prospect of Plop growing up to be just like his three-times-removed cousin, the Giant Kralove, who scares the living daylights out of them. You were repulsed by the unfairness of it all, so you decided to hold out your hand to the little cephalopod, who quickly grabbed it and hugged it with all its tentacles.');
INSERT INTO "item_descriptions" VALUES(13114,'en','This belt was made so that Brouce Boulgoure could properly sway his hips whilst singing his favourite chorus: "Tsamina mina eh eh, Wabbit Wabbit eh eh, tsamina mina zangelewa, anawa aa, this time for Amakna".');
INSERT INTO "item_descriptions" VALUES(13115,'en','This ring has sharp extremities which allow the wearer to mark the trees that need felling. They say that after a heavy night on the juice, Brouce Boulgoure gently stroked the wings of his dear wife Kassiopee Baine with this ring, leaving her with beastly tree fell markings. Being the fiery character that she was, she took his axe without asking which, of course, then gave him a real reason to mash up her wings. The moral of the story? Don''t get on the wrong side of a lumberjack.');
INSERT INTO "item_descriptions" VALUES(13116,'en','These boots were specially designed by Brouce Boulgoure, with the help of Hogmeiser and Bowisse who stumped down the ash and walnut trees. You don''t even want to know about the side-effects they can have on your arse.');
INSERT INTO "item_descriptions" VALUES(13117,'en','Otomai is a well-known alchemist who created, among other things, the vaccination for Myxomawosis. One of his less well-known theories is the controversial claim that Cawwots improve your sight. He might just be right, though – after all, have you ever seen a Wabbit wearing glasses?');
INSERT INTO "item_descriptions" VALUES(13118,'en','These boots, which used to belong to Otomai, the renowned alchemist, have sponge soles useful for absorbing and cleaning up liquids spilt on laboratory floors. They''re a little heavy, but take it in your stride and it will save you paying a cleaner each month. Return on investment guaranteed within 248 years.');
INSERT INTO "item_descriptions" VALUES(13119,'en','This blade has sliced through numerous innocent creatures - all in the interest of science, of course!');
INSERT INTO "item_descriptions" VALUES(13120,'en','According to rumours, Danathor poisoned Rimaraf, Amayiro''s best friend, with a cake made from deadly Blops. What a pleasant story to tell your kids at bed time; it''ll certainly teach them never to accept anything from strangers... especially when it smells like Blop.');
INSERT INTO "item_descriptions" VALUES(13121,'en','On the base of this amulet is an abrasive rock that will epilate the entire abdomen of its wearer. The merchant that sold it to you must have forgotten to warn you not to sleep with it on.');
INSERT INTO "item_descriptions" VALUES(13122,'en','Danathor was chosen by Jiva to be Steward of Bonta. He was such a bent and manipulating fellow, however, that the populace thought that he''d have been much better suited to Brakmar.');
INSERT INTO "item_descriptions" VALUES(13123,'en','Allister was a simple shepherd before he founded – as legend has it – the first-ever guild in the World of Twelve. He then went on to capture the demon Esra''Ruoy''Dnim and imprisoned him in Amakna. These efforts made Allister a well-respected and popular king with his subjects and an example for the depraved youth of today who sit and play all day long and never set off on adventures of their own.');
INSERT INTO "item_descriptions" VALUES(13124,'en','This ring was given to Allister by his old friend Amayiro. The rumour-mongers of the village believe it hides a secret engraving, Allister''s closest friends see it as a mark of unwavering friendship and the village idiots see it as, well, a ring.');
INSERT INTO "item_descriptions" VALUES(13125,'en','Allister used to hide his secret forceps in these boots. Rumour has it he used them to offer a helping hand when any of his Gobballs ever had trapped wind. He kept it for many years, and word on the street is that when he became King he used it on himself after the great feasts held in the Castle of Amakna!');
INSERT INTO "item_descriptions" VALUES(13127,'en','This cloak makes its wearer invisible, as soon as he hides in a dark cupboard. For extra stealth, move around with said dark cupboard.');
INSERT INTO "item_descriptions" VALUES(13128,'en','Lethaline Sigisbul is an Astrubian mercenary with no scruples. She sells her services to whoever is offering the best price. The size of your pouch shows that you''re out of the running, my friend.');
INSERT INTO "item_descriptions" VALUES(13129,'en','Leather, heels and more hide. It''s enough to make you go mad.');
INSERT INTO "item_descriptions" VALUES(13130,'en','Ogivol Scalarcin''s generally aggressive temper led him to steal everything he came across and he was eventually condemned to six months'' imprisonment for contempt of authority. Young Astrubians, however, see him as a modern hero, a revolutionary and a free thinker who stands up for the right to indefinite borrowing of other people''s property.');
INSERT INTO "item_descriptions" VALUES(13131,'en','It''s hard to tell whether the bones that make up Ogivol Scalarcin''s Cloak are those of victims or just spare parts for the arthritic Sram.');
INSERT INTO "item_descriptions" VALUES(13132,'en','The arthritic punishment chosen by Xelor means that every passing day sees Ogivol Scalarcin''s bones move a little bit further apart. This belt was pretty handy as it held all his bones in place when he was trying to dance the Kamarena.');
INSERT INTO "item_descriptions" VALUES(13135,'en','After you met him for the very first time, all frail and low-level, Metamunch Kin made a whispered promise to the Key Master: "If this one here completes a tour of the World, I''ll eat my hat." It took some time, and getting it back into its original shape was some hefty work, but it was completely worth it.');
INSERT INTO "item_descriptions" VALUES(13136,'en','With your head inside this hat, never have the contents of a chest been so disappointing.');
INSERT INTO "item_descriptions" VALUES(13137,'en','Once you have equipped this belt it will become impossible to take off without the key. This explains why it''s only worn by women with incredibly jealous husbands, by girls with worrying fathers and by you, for the good of humanity (you should think about throwing away that key).');
INSERT INTO "item_descriptions" VALUES(13138,'en','The key for this pendant doesn''t open the Chesty Hat, the Chestity Belt, or even the Chesty Boots. It doesn''t open any other lock that you have ever come across, for that matter. The only reason for it existing is to incite hope that one day it will serve some kind of purpose. A little bit like you.');
INSERT INTO "item_descriptions" VALUES(13139,'en','These boots are the safest boots in the World of Twelve. Pop them on your feet and you can be sure that nobody will steal your socks. Please note: toe-stubbing protection not included.');
INSERT INTO "item_descriptions" VALUES(13170,'en','If you wear this amulet just underneath your chin, its small wings will help keep a spring in your step.');
INSERT INTO "item_descriptions" VALUES(1013182,'en','The Karmeleon is just as stupid as an Armoured Dragoturkey, and even more useful! Some breeders claim that it is at the root of the Khamelerost gene in Dragoturkeys, although all attempts to get the two species to mate have failed resoundingly. Otomai might be behind this miracle creation, although he has yet to comment on the issue.');
INSERT INTO "item_descriptions" VALUES(13194,'en','This gossipy hat is perfect for people who are always gassin'', which is why you love wearing it after drunken nights out or long stays on Pandala Island. It''s good at keeping on top of all the latest rumours, although Charlie''s Agents strongly discourage people from wearing it if they''re headed for the Sidimote Moors.');
INSERT INTO "item_descriptions" VALUES(13197,'en','The cloak, the latest creation from Juss Tafinger, will help you brave the glacial temperatures on Frigost. Thick, hot and smelly... It takes you back to the days of Mama Bwork cuddles.');
INSERT INTO "item_descriptions" VALUES(13230,'en','This creature found life on the Archipelago of Vulkania way too unfair and decided to come out of its shell and follow you in your quest for a better world.');
INSERT INTO "item_descriptions" VALUES(13245,'en','Where there is Arty, there is his cane. Legend has it that one end is coated in black treacle to attract herds of lost Gobballs. The other is supposedly splintered wood, just to get those Gobballs moving! You certainly won''t want to get the wrong end of the stick on this one!');
INSERT INTO "item_descriptions" VALUES(13261,'en','With this diving bell on your head you might look a little bit silly, to say the least. Your new friends will probably feel a little uncomfortable around you and avoid looking you in the eye.');
INSERT INTO "item_descriptions" VALUES(13262,'en','This backpack ensures your breathing tank is firmly held in place, ready for deep sea adventures. Now why did you fill it with beer again? You''ll be as drunk as a fish!');
INSERT INTO "item_descriptions" VALUES(13263,'en','These heavy diving boots are the fruit of pure Foggernaut technology. They are fitted with a super-duper microchip that allows them to walk themselves, reducing the fatigue that might normally encumber you. You might want to have your scuba suit on hand all the same - the boots are programmed to head towards the sea!');
INSERT INTO "item_descriptions" VALUES(13264,'en','This diving belt is worth its weight in gold, but you still can''t help feeling slightly disgusted imagining the dude who invented it. I mean, the portholes are lovely and all, but what kind of freak has eyes down there?');
INSERT INTO "item_descriptions" VALUES(13265,'en','As its name suggests, this ring is vital for Foggernauts. It allows them to keep an eye on their air pressure and gives them a better idea of how long they''ve been underwater. Most importantly, it ensures that any dummies who think it''s a compass get lost before they start to become really annoying.');
INSERT INTO "item_descriptions" VALUES(13297,'en','The metallic pieces on this ring are folded inwards on the inside for maximum comfort. You can use a common stapler and a band of paper to make a similar ring at home for much cheaper, but it''s not recommended for non-Sacriers.');
INSERT INTO "item_descriptions" VALUES(13298,'en','You were right to break that habit of ring-gnawing. At least if you have a lapse, this ring will stop you putting on too much weight.');
INSERT INTO "item_descriptions" VALUES(13301,'en','These boots, made out of leftover soup ingredients, were a gift from Auntie Cranny. Waste not, want not is all very well, but for a couple of days now you''ve been sure there are maggots crawling around between your toes...');
INSERT INTO "item_descriptions" VALUES(13302,'en','Typical footwear for big-hooped, gum-chewing, female Gobbowl fans, these boots are ideal for training in.');
INSERT INTO "item_descriptions" VALUES(13303,'en','They say that if you wear this belt and say the magic words "Time for bed, time for bed" in the most ridiculous voice ever, you''ll be transported to a magical world. It''ll also make everyone around you point and laugh.');
INSERT INTO "item_descriptions" VALUES(13304,'en','This scaly belt is very trendy and rather powerful but can only be used in certain situations. At the smallest sign of danger its wearer is overcome by an irrepressible desire to snap at everyone around him. Not suitable when in the company of Crocodyls.');
INSERT INTO "item_descriptions" VALUES(13320,'en','This ring also works as a magic paintbrush. Just wave your hand and magnificent lines will appear from nowhere! Obviously, waving your hands everywhere also makes you look like an absolute nutter. The choice is yours: do you want to be an artist of genius, or hang onto the few friends who aren''t already embarrassed to be seen with you?');
INSERT INTO "item_descriptions" VALUES(13321,'en','Whilst shoemaking critics (yes, they exist) consider these boots to be the crowning point of their art, you''re inclined to see them as proof that art definitely doesn''t exist in this day and age.');
INSERT INTO "item_descriptions" VALUES(13326,'en','It''s a shame the lights aren''t on upstairs - you''d make a pretty little lantern!');
INSERT INTO "item_descriptions" VALUES(13327,'en','Al Howin stuck the Pumpkwin seeds onto the back of this cape himself. He wanted to plant Pumpkwins all over the World in order to spread his curse. Whilst you''re waiting for that to happen, why don''t you have a nibble – they''re most nutritious!');
INSERT INTO "item_descriptions" VALUES(13328,'en','Al Howin wore this cursed belt religiously until the day it came to life and started attacking all the the other belts it came across, whether they were attached to waists or not. As you can imagine, the whole thing was rather embarrassing for Al Howin and gave him quite a reputation.');
INSERT INTO "item_descriptions" VALUES(13329,'en','Al Howin has such dishevelled hair that anybody would think that it was him that''d been raked over the coals!');
INSERT INTO "item_descriptions" VALUES(13344,'en','This Dofus changes colour with the seasons. The warm gold it displays in the summer gives way to a glacial chill as winter sets in. They say it was laid by a dragon who fell in love with a pedlar who stopped by its cave to flog an out-of-date calendar.');
INSERT INTO "item_descriptions" VALUES(13423,'en','Captain Chafer''s real panties, which were very tight and very leathery, disappeared along with their owner. Luckily for us, the famous tango dancer left behind various pairs of worn undies that perverse tailors were able to use for inspiration. This pair of Spare Panties has a comfortable, elasticated waistband and an affordable pricetag. It''s even reversible, so you can use it twice (or four times)!');
INSERT INTO "item_descriptions" VALUES(13424,'en','Ere be th'' hat of Ol'' John, th'' great grand sailor o'' th'' 107 oceans! Legend says that his parrot died ''ere yonder one stormy, stormy night. Ever since that fateful eve, any hearty who puts on this topper starts talking a little like Ol'' John did himself.');
INSERT INTO "item_descriptions" VALUES(13459,'en','This amulet generates magical interference that changes the way your vocal cords work and forces you to sing "Di di di di di". Unfortunately, that sounds awfully like the Kidos'' wedding march. It''s never too late to learn how to lay an egg.');
INSERT INTO "item_descriptions" VALUES(13460,'en','This coloured ring will remind you of your naive and worry-free youth, when your arms were covered in multicoloured bracelets from market stalls. Fashion spares no man.');
INSERT INTO "item_descriptions" VALUES(1013465,'en','The Boarhog is the common boar''s sturdier, friendlier cousin. As long as you don''t feast on cold cuts before its eyes, it''ll be more than happy to carry all the stuff that won''t fit in your already ridiculously full pockets for you.');
INSERT INTO "item_descriptions" VALUES(13480,'en','Don''t fancy equipping the Arachelmet? Then you''re not going to like the Hairy Arachelmet! It''s lined with Arachnee web, sewn together with threads of the stuff and perfumed with pheromones in such a way that an amorous Arachnee will always be following you. It might be better offering it to an Arachneephobe; they''ll either overcome their fear, or die from terror. Either way, it''s for their own good.');
INSERT INTO "item_descriptions" VALUES(13485,'en','The buckle of this belt has a little slot in the top for you to keep your GG points. Your local shoemaker attached that piece upside down because he knew you were going to make a habit of losing.');
INSERT INTO "item_descriptions" VALUES(13486,'en','It doesn''t matter if you can''t give your enemies a kicking in Krosmaster tournaments; with these boots on, you can take it out on monsters in fights instead!');
INSERT INTO "item_descriptions" VALUES(13582,'en','These magnificent slippers are a perfect excuse to dance. They can be worn with a tutu, or with other garments if you''re worried about looking ridiculous.');
INSERT INTO "item_descriptions" VALUES(13583,'en','This wand looks very much like a Great Sweet Gum branch, the mythical tree that grows in the Jellith Dimension. So much so, that it''s hard to tell them apart. It''s probably for that very reason that it attracts sweet, trembling little Strawberry Jellies.');
INSERT INTO "item_descriptions" VALUES(13584,'en','This chest, worn like a bag, is an incredibly practical invention. Unfortunately, it seems that it attracts young Koalaks and other undesirables. Only adventurers with strong shoulders should consider using it without being dogged with bad luck.');
INSERT INTO "item_descriptions" VALUES(1013603,'en','The Razorbuck is said to be one of the oldest boars in the World of Twelve. A legendary fighter who''s considered a god by little porklings, it has always been a perfect role model. He has long fought the worst of the worst, like Pandits and unscrupulous adventurers who try to cheat their peers.');
INSERT INTO "item_descriptions" VALUES(13629,'en','This wheel-shaped ring turns on itself very slowly, in a clockwise direction. Only Henual understands the importance of this very discreet movement. One thing''s for sure: the ring must not stop turning under any circumstances. Be very careful, the state of the entire Krosmoz may well depend on the piece of jewellery wrapped around your finger.');
INSERT INTO "item_descriptions" VALUES(13630,'en','This belt is supposed to protect its wearer from temporary paradoxes, Krosmic waves, repeat delays and that feeling of déjà-vu. In theory, anyway. It''s probably a safe bet just to use it when you don''t want to lose your trousers.');
INSERT INTO "item_descriptions" VALUES(13631,'en','This hammer is equipped with a chronomagical convector. As soon as you whirl it around your head at the speed of 88 kamiles per hour, it''ll transport you back to the future. If, however, you don''t manage to spin it fast enough, you''ll disappear into a puff of smoke. Get working on those biceps!');
INSERT INTO "item_descriptions" VALUES(13632,'en','When you wear this helmet, you''ll look like a battered old Bow Wow. Looking like that, you risk coming across as a bit of a bonehead, but you might also come across animal-lovers that take a certain shine to you. If you''re lucky, maybe they''ll end up adopting you?');
INSERT INTO "item_descriptions" VALUES(13633,'en','A necklace that demonstrates how loyal and disciplined you are. If that''s not the case, you could always show your teeth and look all beastly.');
INSERT INTO "item_descriptions" VALUES(13634,'en','These boots leave very interesting marks that will allow you to mash up your footprints, ridiculing your hunter friends. Careful, you might still take an arrow or two on your way.');
INSERT INTO "item_descriptions" VALUES(13635,'en','Warm, resistant and self-cleaning, this cloak is practical and beautiful. Who would''ve thought you could be the greatest hunter in the World of Twelve and look fashionable?');
INSERT INTO "item_descriptions" VALUES(13636,'en','The tooth that adorns this amulet was ripped from the mouth of a legendary monster. Was it a dragon? A YeCh''Ti? A mother-in-law? Only Nevark knows and he''ll take it with him to the grave.');
INSERT INTO "item_descriptions" VALUES(13637,'en','They say that whoever wears this belt becomes capable of hitting a Moskito in flight from three kilokametres away. It is, however, unadvisable to walk through a shooting range with this accessory around your waist.');
INSERT INTO "item_descriptions" VALUES(13638,'en','The first cloak of this kind was worn by the sergeant major, Darkfountain. The militiaman is said to have given Antyklime Ax the cloak off his back to thank him for his help editing his memoirs. It has to be said that the tempestuous life of a Brakmarian officer often results in a lot of ink spilt.');
INSERT INTO "item_descriptions" VALUES(13639,'en','According to the legend, this amulet can erase all the mistakes you might have made as an adventurer. In your case, you''ll probably need a few of them.');
INSERT INTO "item_descriptions" VALUES(13640,'en','These boots tend to leave black marks on the carpets and tiles, which will frustrate your house staff no end. Unless they''re Goblins, of course.');
INSERT INTO "item_descriptions" VALUES(13641,'en','This helmet looks like the head of the late Ivory Scarabugly that got squashed by Nomarow in his younger years. The merchant who sold it to you guaranteed that it was the original. The mysterious label that says "781 / 10,000" makes you think differently.');
INSERT INTO "item_descriptions" VALUES(13642,'en','A long time ago, the sages had a fallout about how to wear this large ring. Some believed it should be worn around the thumb, and others believed that it was made for the big toe. Nomarow switches it between the two on alternate weeks.');
INSERT INTO "item_descriptions" VALUES(13643,'en','Nomarow is the unbeatable champion of skullcrushing. When he chucks on these getas, you''ll want to hope you don''t come across him.');
INSERT INTO "item_descriptions" VALUES(13644,'en','Like any respectable magician''s helmet, this one doesn''t look anything special... However, it was used as a tankard, a sick bag and even Hel Munster''s chamberpot when he was a young, impressionable apprentice. Even nowadays, few helmets can guarantee so many functions at once.');
INSERT INTO "item_descriptions" VALUES(13645,'en','When Hel Munster asked his master how he could fight against the cold, he responded that the answer was in the pages of his spell book. So he pulled out the pages one by one and sewed them together to make this original cape.');
INSERT INTO "item_descriptions" VALUES(13646,'en','The precious jewel in this amulet contains a Quadramental Breeze digest and that is exactly what is wrong with it. To be able to fully benefit from its magical powers, you''ll need to free the Breeze, but only a blonde, beautiful, intelligent woman with a good chest and sense of direction can do it. Otherwise, get used to its basic powers.');
INSERT INTO "item_descriptions" VALUES(13647,'en','This helmet went out of fashion ages ago, especially amongst housewives under 50. Nobody dares tell Aermyne, however, for fear of the consequences.');
INSERT INTO "item_descriptions" VALUES(13648,'en','Housewives over 50 can pick up this cloak for dirt cheap at cooking events. You, unfortunately, didn''t think about that and bought it from a tailor who sold it as a state-of-the-art item. You were warned that a good merchant is, above all, a good liar.');
INSERT INTO "item_descriptions" VALUES(13649,'en','Originally made to prepare tarts, this rolling pin is now used to dish out clouts. You''ll have a feast when your kiddywinkle invites his friends round for his birthday.');
INSERT INTO "item_descriptions" VALUES(13657,'en','This cape was originally worn by Sylkauf the Meridia of Hibernation''s prophet. The idea came to him when he was watching some Snailmets lug their houses around on their backs. Weary of falling asleep in uncomfortable places, he took the opportunity to traipse around with his mattress with him at all times.');
INSERT INTO "item_descriptions" VALUES(13658,'en','This slippers are very highly regarded by the new generation who love comfort, but refuse to put in any effort to get it. Come to think of it, they might just suit you. Try them on!');
INSERT INTO "item_descriptions" VALUES(13659,'en','These boots are the epitome of your life. Don them proudly and make those who pity you flee. They are also efficient for crushing beggars'' fingers and kicking children up the backside.');
INSERT INTO "item_descriptions" VALUES(13661,'en','You''re now best friends with this innocent-looking insect. It''s so cute, you''ll forget just how exasperating it is. Indeed, Snickermite is always ready to pull your leg and can''t resist a good (or bad, especially bad) joke. It''ll have you laughing until you cry.');
INSERT INTO "item_descriptions" VALUES(13667,'en','As its name might suggest, Bulbutting was created by taking cuttings, which means that it is a clone, genetically identical to its mother. So why does no other bulb look like it? Determined to solve the mystery of its origins, it decided to explore the World of Twelve to take as many samples as possible from anything and everything that moves. If samples don''t survive the process, well, that''s just too bad – it''s all in the name of science.');
INSERT INTO "item_descriptions" VALUES(13673,'en','Snailmate is a Snailmet with a passion for the dark sciences. Its lack of hands doesn''t make incantation easy, so, as you can imagine, it''s not too dangerous.');
INSERT INTO "item_descriptions" VALUES(13679,'en','Toucantankerous really lives up to its name, which was apparent from an early age. If you don''t know how to behave around it, that''s really quite normal. It''ll make your life difficult but it means well and will prove incredibly helpful in combat if you help it overcome its flaws. After all, you''re not always all sunshine and roses, either, and you''re doing okay, right?');
INSERT INTO "item_descriptions" VALUES(13748,'en','This Trophy enables you to stick undesirables onto the bottom of your boots, or vice versa. Don''t forget to tie your laces, now.');
INSERT INTO "item_descriptions" VALUES(13749,'en','This Trophy enables you to stick undesirables onto the bottom of your boots, or vice versa. Don''t forget to tie your laces, now.');
INSERT INTO "item_descriptions" VALUES(13750,'en','This Trophy enables you to stick undesirables onto the bottom of your boots, or vice versa. Don''t forget to tie your laces, now.');
INSERT INTO "item_descriptions" VALUES(13751,'en','This Trophy accepts no responsibility for runaway brains.');
INSERT INTO "item_descriptions" VALUES(13752,'en','This Trophy accepts no responsibility for runaway brains.');
INSERT INTO "item_descriptions" VALUES(13753,'en','This Trophy accepts no responsibility for runaway brains.');
INSERT INTO "item_descriptions" VALUES(13754,'en','This Trophy lets you play doctors and nurses with your allies, or with your enemies, if the fight''s too boring for words.');
INSERT INTO "item_descriptions" VALUES(13755,'en','This Trophy lets you play doctors and nurses with your allies, or with your enemies, if the fight''s too boring for words.');
INSERT INTO "item_descriptions" VALUES(13756,'en','This Trophy lets you play doctors and nurses with your allies, or with your enemies, if the fight''s too boring for words.');
INSERT INTO "item_descriptions" VALUES(13757,'en','This Trophy will show the world that Strength runs deep in your family.');
INSERT INTO "item_descriptions" VALUES(13758,'en','This Trophy will show the world that Strength runs deep in your family.');
INSERT INTO "item_descriptions" VALUES(13759,'en','This Trophy will show the world that Strength runs deep in your family.');
INSERT INTO "item_descriptions" VALUES(13760,'en','This Trophy will make you so brainy that you''ll score a clean 3 on the Bwork Intelligence Scale, which runs from negative infinity to 1.');
INSERT INTO "item_descriptions" VALUES(13761,'en','This Trophy will make you so brainy that you''ll score a clean 3 on the Bwork Intelligence Scale, which runs from negative infinity to 1.');
INSERT INTO "item_descriptions" VALUES(13762,'en','This Trophy will make you so brainy that you''ll score a clean 3 on the Bwork Intelligence Scale, which runs from negative infinity to 1.');
INSERT INTO "item_descriptions" VALUES(13763,'en','This Trophy has the power to miraculously balance everything. Except, perhaps, your class spells.');
INSERT INTO "item_descriptions" VALUES(13764,'en','This Trophy has the power to miraculously balance everything. Except, perhaps, your class spells.');
INSERT INTO "item_descriptions" VALUES(13765,'en','This Trophy has the power to miraculously balance everything. Except, perhaps, your class spells.');
INSERT INTO "item_descriptions" VALUES(13766,'en','This Trophy will make Chance your area of expert-tease.');
INSERT INTO "item_descriptions" VALUES(13767,'en','This Trophy will make Chance your area of expert-tease.');
INSERT INTO "item_descriptions" VALUES(13768,'en','This Trophy will make Chance your area of expert-tease.');
INSERT INTO "item_descriptions" VALUES(13769,'en','This Trophy protects you from really cracking hits but also prevents you from scoring them yourself. You should take the opportunity to claim that you hate wanton violence and stand with your hands on your hips, tutting disapprovingly at everyone you see.');
INSERT INTO "item_descriptions" VALUES(13770,'en','This Trophy protects you from really cracking hits but also prevents you from scoring them yourself. You should take the opportunity to claim that you hate wanton violence and stand with your hands on your hips, tutting disapprovingly at everyone you see.');
INSERT INTO "item_descriptions" VALUES(13771,'en','This Trophy protects you from really cracking hits but also prevents you from scoring them yourself. You should take the opportunity to claim that you hate wanton violence and stand with your hands on your hips, tutting disapprovingly at everyone you see.');
INSERT INTO "item_descriptions" VALUES(13772,'en','This Trophy helps you keep your feet on the ground. Warning: can prove painful if used in conjunction with a flying mount.');
INSERT INTO "item_descriptions" VALUES(13773,'en','This Trophy helps you keep your feet on the ground. Warning: can prove painful if used in conjunction with a flying mount.');
INSERT INTO "item_descriptions" VALUES(13774,'en','This Trophy helps you keep your feet on the ground. Warning: can prove painful if used in conjunction with a flying mount.');
INSERT INTO "item_descriptions" VALUES(13775,'en','This Trophy allows you to keep your face utterly expressionless as you decimate the enemy.');
INSERT INTO "item_descriptions" VALUES(13776,'en','This Trophy allows you to keep your face utterly expressionless as you decimate the enemy.');
INSERT INTO "item_descriptions" VALUES(13777,'en','This Trophy allows you to keep your face utterly expressionless as you decimate the enemy.');
INSERT INTO "item_descriptions" VALUES(13778,'en','This Trophy helps you hold your own in the line of fire.');
INSERT INTO "item_descriptions" VALUES(13779,'en','This Trophy helps you hold your own in the line of fire.');
INSERT INTO "item_descriptions" VALUES(13780,'en','This Trophy helps you hold your own in the line of fire.');
INSERT INTO "item_descriptions" VALUES(13781,'en','This Trophy is your first step towards becoming less of a drip.');
INSERT INTO "item_descriptions" VALUES(13782,'en','This Trophy is your first step towards becoming less of a drip.');
INSERT INTO "item_descriptions" VALUES(13783,'en','This Trophy is your first step towards becoming less of a drip.');
INSERT INTO "item_descriptions" VALUES(13784,'en','The packaging this Trophy came in says that it works best when you have fresh air against your bare bottom. You can''t wait to try it out.');
INSERT INTO "item_descriptions" VALUES(13785,'en','The packaging this Trophy came in says that it works best when you have fresh air against your bare bottom. You can''t wait to try it out.');
INSERT INTO "item_descriptions" VALUES(13786,'en','The packaging this Trophy came in says that it works best when you have fresh air against your bare bottom. You can''t wait to try it out.');
INSERT INTO "item_descriptions" VALUES(13787,'en','This Trophy slows your loved one down when he or she desperately wants to leave. You laugh in the face of restraining orders!');
INSERT INTO "item_descriptions" VALUES(13788,'en','This Trophy slows your loved one down when he or she desperately wants to leave. You laugh in the face of restraining orders!');
INSERT INTO "item_descriptions" VALUES(13789,'en','This Trophy slows your loved one down when he or she desperately wants to leave. You laugh in the face of restraining orders!');
INSERT INTO "item_descriptions" VALUES(13790,'en','The good thing about this Trophy is that, if you hit an ally by mistake, there''s little chance they''ll be able to do anything about it.');
INSERT INTO "item_descriptions" VALUES(13791,'en','The good thing about this Trophy is that, if you hit an ally by mistake, there''s little chance they''ll be able to do anything about it.');
INSERT INTO "item_descriptions" VALUES(13792,'en','The good thing about this Trophy is that, if you hit an ally by mistake, there''s little chance they''ll be able to do anything about it.');
INSERT INTO "item_descriptions" VALUES(13793,'en','This Trophy sends small, regular jolts of electricity running through your muscles, preventing them from seizing up and stopping you from falling asleep at family dinners.');
INSERT INTO "item_descriptions" VALUES(13794,'en','This Trophy sends small, regular jolts of electricity running through your muscles, preventing them from seizing up and stopping you from falling asleep at family dinners.');
INSERT INTO "item_descriptions" VALUES(13795,'en','This Trophy sends small, regular jolts of electricity running through your muscles, preventing them from seizing up and stopping you from falling asleep at family dinners.');
INSERT INTO "item_descriptions" VALUES(13796,'en','This Trophy oozes a slippery liquid that gives you the upper hand when escaping from Lock-happy opponents.
Just don''t be surprised when you don''t get any free hugs on Ballotwine''s Day.');
INSERT INTO "item_descriptions" VALUES(13797,'en','This Trophy oozes a slippery liquid that gives you the upper hand when escaping from Lock-happy opponents.
Just don''t be surprised when you don''t get any free hugs on Ballotwine''s Day.');
INSERT INTO "item_descriptions" VALUES(13798,'en','This Trophy oozes a slippery liquid that gives you the upper hand when escaping from Lock-happy opponents.
Just don''t be surprised when you don''t get any free hugs on Ballotwine''s Day.');
INSERT INTO "item_descriptions" VALUES(13799,'en','This Trophy turns you into the clumsiest warrior anyone has ever seen. Just turning around to check the height of the sun in the sky sends four of your allies flying into bushes and walls.');
INSERT INTO "item_descriptions" VALUES(13800,'en','This Trophy turns you into the clumsiest warrior anyone has ever seen. Just turning around to check the height of the sun in the sky sends four of your allies flying into bushes and walls.');
INSERT INTO "item_descriptions" VALUES(13801,'en','This Trophy turns you into the clumsiest warrior anyone has ever seen. Just turning around to check the height of the sun in the sky sends four of your allies flying into bushes and walls.');
INSERT INTO "item_descriptions" VALUES(13802,'en','When the pressure gets too much, when people start throwing their weight around, and when you realise you''re a total pushover, it''s time to equip this Trophy.');
INSERT INTO "item_descriptions" VALUES(13803,'en','When the pressure gets too much, when people start throwing their weight around, and when you realise you''re a total pushover, it''s time to equip this Trophy.');
INSERT INTO "item_descriptions" VALUES(13804,'en','When the pressure gets too much, when people start throwing their weight around, and when you realise you''re a total pushover, it''s time to equip this Trophy.');
INSERT INTO "item_descriptions" VALUES(13805,'en','Having the first turn gives you the limelight to commit the first fatal error, show everyone what an idiot you are, prove that you''re not a priority target, be the last man standing and come home a hero.');
INSERT INTO "item_descriptions" VALUES(13806,'en','Having the first turn gives you the limelight to commit the first fatal error, show everyone what an idiot you are, prove that you''re not a priority target, be the last man standing and come home a hero.');
INSERT INTO "item_descriptions" VALUES(13807,'en','Having the first turn gives you the limelight to commit the first fatal error, show everyone what an idiot you are, prove that you''re not a priority target, be the last man standing and come home a hero.');
INSERT INTO "item_descriptions" VALUES(13808,'en','This Trophy protects you from falling earth. Handy if you spend your days hollowing out underground passageways.');
INSERT INTO "item_descriptions" VALUES(13809,'en','This Trophy protects you from falling earth. Handy if you spend your days hollowing out underground passageways.');
INSERT INTO "item_descriptions" VALUES(13810,'en','This Trophy protects you from falling earth. Handy if you spend your days hollowing out underground passageways.');
INSERT INTO "item_descriptions" VALUES(13811,'en','This Trophy stops you from taking sides in combat and prevents you from potentially hurting yourself by casting a spell.');
INSERT INTO "item_descriptions" VALUES(13812,'en','This Trophy stops you from taking sides in combat and prevents you from potentially hurting yourself by casting a spell.');
INSERT INTO "item_descriptions" VALUES(13813,'en','This Trophy stops you from taking sides in combat and prevents you from potentially hurting yourself by casting a spell.');
INSERT INTO "item_descriptions" VALUES(13814,'en','This Trophy could save your life when your sect is on fire.');
INSERT INTO "item_descriptions" VALUES(13815,'en','This Trophy could save your life when your sect is on fire.');
INSERT INTO "item_descriptions" VALUES(13816,'en','This Trophy could save your life when your sect is on fire.');
INSERT INTO "item_descriptions" VALUES(13817,'en','Don''t throw this Trophy out with the bathwater.');
INSERT INTO "item_descriptions" VALUES(13818,'en','Don''t throw this Trophy out with the bathwater.');
INSERT INTO "item_descriptions" VALUES(13819,'en','Don''t throw this Trophy out with the bathwater.');
INSERT INTO "item_descriptions" VALUES(13820,'en','Equip this Trophy and your worries will vanish into thin air.');
INSERT INTO "item_descriptions" VALUES(13821,'en','Equip this Trophy and your worries will vanish into thin air.');
INSERT INTO "item_descriptions" VALUES(13822,'en','Equip this Trophy and your worries will vanish into thin air.');
INSERT INTO "item_descriptions" VALUES(13823,'en','Wind up this Trophy and you''ll be going strong all night! You''re never too old for the generation game.');
INSERT INTO "item_descriptions" VALUES(13824,'en','Wind up this Trophy and you''ll be going strong all night! You''re never too old for the generation game.');
INSERT INTO "item_descriptions" VALUES(13825,'en','Wind up this Trophy and you''ll be going strong all night! You''re never too old for the generation game.');
INSERT INTO "item_descriptions" VALUES(13826,'en','This Trophy is seasoned with Cania Bay sea salt, delicate herbs and rustic rust, so your enemies can enjoy a taste sensation when they smash their front teeth out on it.');
INSERT INTO "item_descriptions" VALUES(13827,'en','This Trophy is seasoned with Cania Bay sea salt, delicate herbs and rustic rust, so your enemies can enjoy a taste sensation when they smash their front teeth out on it.');
INSERT INTO "item_descriptions" VALUES(13828,'en','This Trophy is seasoned with Cania Bay sea salt, delicate herbs and rustic rust, so your enemies can enjoy a taste sensation when they smash their front teeth out on it.');
INSERT INTO "item_descriptions" VALUES(13829,'en','A lifetime of mischief and monkey business has finally paid off. You carved Blop Goldof lyrics into the bench behind the church in Amakna. You spent your evenings throwing people weaker than you into the harbour at Madrestam. You orchestrated that magnificent event whereby all the bins in Astrub were filled with Fairyworks and innocent creatures and then set alight. This Trophy was made for you.');
INSERT INTO "item_descriptions" VALUES(13830,'en','This Trophy will help you leave the nest and take your first steps as a real person. Next up: learn how to cook something other than pasta. Doesn''t anyone around here have a replicator?');
INSERT INTO "item_descriptions" VALUES(13831,'en','If you would stop using it to check out birds for a second, you would discover that this Trophy is an incredible instrument of precision. You won''t miss a thing, not even the Blop stain on the hat of an enemy crouching behind a bush in a hole on the other side of that hill all shrouded in mist.');
INSERT INTO "item_descriptions" VALUES(13832,'en','This Trophy will show your enemies that you are capable of the best actions known to man, and the most evil, and that you prefer the latter. And they will weep, forsooth.');
INSERT INTO "item_descriptions" VALUES(13833,'en','This Trophy will show your enemies that you are capable of the best actions known to man, and the most evil, and that you prefer the latter. And they will weep, forsooth.');
INSERT INTO "item_descriptions" VALUES(13834,'en','This Trophy will show your enemies that you are capable of the best actions known to man, and the most evil, and that you prefer the latter. And they will weep, forsooth.');
INSERT INTO "item_descriptions" VALUES(13848,'en','You hold in your hands a knife that, unlike you, is far from ordinary. A legend as old as the sea itself says that its barnacled blade will help you open Mumussels wider than any other knife, coaxing them into giving up their dearest treasure: Soul Pearls fallen to the bottom of the ocean. If you''ve always dreamt of having a bra made of shells and a bottom half that smells like sardines, today is your lucky day.');
INSERT INTO "item_descriptions" VALUES(13850,'en','The members of the Black Hornet gang used to wear masks just like this one. These sinister individuals were accused of all the worst deeds known to humanity: kidnapping, bridge destroying, fake treasure mongering and ill-timed humming in people''s ears. To this day, nobody has got to the bottom of these ne''er-do-wells'' motives.');
INSERT INTO "item_descriptions" VALUES(13851,'en','It''s thanks to belts like these that the Black Hornets were able to buzz off as soon as the militia arrived. Nobody was quick enough to net them! Without a good belt around his waist, a bandit runs a high risk of his trousers falling down, causing him to lose his dignity, his freedom of movement, and his freedom full stop.');
INSERT INTO "item_descriptions" VALUES(13891,'en','The inhabitants of Amakna who could be described as a few sandwiches short of a picnic believe that the Woolly Piggoth, being a prehistoric ancestor of the common Boar, is 100% extinct, and that creating jewels from its ivory is therefore perfectly ethical. That''s why wearing this ring will make you look like you''ve never actually been to Frigost and as though you''re a bit dense.');
INSERT INTO "item_descriptions" VALUES(13893,'en','Warning! Risk of death! This amulet was manufactured using a Woolly Piggoth rump. Never ever try to use it as a gas mask.');
INSERT INTO "item_descriptions" VALUES(13894,'en','A bespectacled Foggernaut by the name of Timmy Mallard was the creator of a word association game where you couldn''t pause, hesitate, repeat a word or say a word he didn''t like, otherwise you got a bash on the head with this mallet. OK, technically it''s a staff, but after a couple of blows to the head you really won''t feel like arguing. And remember - the one with the most bruises loses!');
INSERT INTO "item_descriptions" VALUES(13896,'en','Western Amakna can be pretty wild, but you should be alright if you''re wielding a hatchet like this. And who knows, if you survive long enough out there, they might even give you a shiny, star-shaped badge.');
INSERT INTO "item_descriptions" VALUES(13897,'en','This eerily lifelike, fleshy ring weighs exactly a pound adapts to the size of its wearer''s fingers. Surprisingly, no one had thought to try it on other extremities until you picked it up.');
INSERT INTO "item_descriptions" VALUES(14000,'en','This hat was designed by a tailor who adored Bow Meows and was vehemently opposed to the Systematic Termination For Undesirable Bow Meows association. He was assassinated by members of the Pingwin Protection Agency, who were vehemently opposed to the extermination of wildlife from the Frozen Lake area.');
INSERT INTO "item_descriptions" VALUES(14001,'en','Augilol was a non-descript Sram who spent his whole, miserable life in Ogivol''s shadow. When Frigost Island was rediscovered, he was one of the first passengers to make the journey, hoping to come into his own and make his fortune. We don''t know what happened next. All that''s left of him is this cloak.');
INSERT INTO "item_descriptions" VALUES(14002,'en','Inferno used to wear these boots to trample all over his apprentices and the basic rules of good manners.');
INSERT INTO "item_descriptions" VALUES(14003,'en','Styx underwent a bizarre initiation ceremony involving him being ducked underwater in a river. These boots saved his life: if they had slipped off when Fetis grabbed hold of them to yank him out, he would have been swept downstream and lost forever.');
INSERT INTO "item_descriptions" VALUES(14004,'en','These boots allow their wearer to play in seven leagues at once. Mandrin was never that into Gobbowl, so he just wore them to kick Perceptors'' rumps and do the gardening in.');
INSERT INTO "item_descriptions" VALUES(14005,'en','Like all great warriors, Will Killson always had something up his sleeve. In his case, it was actually a spare pair boots. Unconventional, but practical.');
INSERT INTO "item_descriptions" VALUES(14006,'en','This ring belonged to Inferno''s most beautiful apprentice. She was unlucky enough to die twice, suffering third-degree burns in the fourth dimension of the fifth amendment, after accidently looking her fiery master in the eye.');
INSERT INTO "item_descriptions" VALUES(14007,'en','Five fingers good, three fingers better. That''s how Styx explained his punishment for the theft of this ring.');
INSERT INTO "item_descriptions" VALUES(14008,'en','When a perceptor''s head proved too tough to grind, Mandrin tightened this ring around its neck to throttle it instead.');
INSERT INTO "item_descriptions" VALUES(14009,'en','Was it a present from a client or loot from a victim? Nobody''s sure where Will Killson got this ring from, and nobody really cares.');
INSERT INTO "item_descriptions" VALUES(14030,'en','After expert handling by a Fogger who appeared to know just what he was doing, this diving bell looks to be in prime condition! Now you''ll be able to enter the Geofurnaces without being asphyxiated by the sulphur fumes, which is always nice. On the downside, the window barely lets any light through, so you shouldn''t wear it for fighting or for any activity requiring good eyesight. And I bet your life''s ambition was to wear your Magmatic Diving Bell whilst combing through your mother-in-law''s hair looking for nits. Sorry about that!');
INSERT INTO "item_descriptions" VALUES(14049,'en','Copper Nickus was a heretic polymath who dared to suggest that the World of Twelve wasn''t at the centre of the Krosmoz. No traces of his body were ever found, and this ring is his only surviving relic. Wear it with care.');
INSERT INTO "item_descriptions" VALUES(14050,'en','All the best costumiers have their little foibles, and Klime is clearly no exception. He may well have a sharp eye for fashion, but he''s terribly sadistic, and no one has ever seen him without his mask - no one alive, that is. That probably goes a long way to explaining why Carla Garfield wears those sunglasses all the time.');
INSERT INTO "item_descriptions" VALUES(14051,'en','The lining of this cape wasn''t blood red when it was first stitched, it''s just been dragged one too many times across the floor of the back room in Klime''s private quarters.');
INSERT INTO "item_descriptions" VALUES(14052,'en','A long time ago, Klime would use the needle on this belt to stitch up the broken things he found and they would return to perfect health. These days he uses it to pick apart the healthy things he finds until they''re perfectly broken.');
INSERT INTO "item_descriptions" VALUES(14053,'en','Klime wears this hat to avoid being deafened by the cries of the victims he brings to the back room of his private quarters, and also to avoid having his head knocked off by their jerking limbs. It''s important to look one''s best at all times, after all.');
INSERT INTO "item_descriptions" VALUES(14054,'en','It would be best if you didn''t find out just how many horrific instruments of torture can be attached to this ring.');
INSERT INTO "item_descriptions" VALUES(14055,'en','Stilted Shovels are known for their unusual tendency to refuse to dig. As this is a particularly inconvenient quality for a shovel, the Enutrofs of the Asse Sea strap them vertically to their legs instead. This allows the stumpy treasure hunters to walk freely across the rolling sand dunes, and also makes them appear much taller than they really are.');
INSERT INTO "item_descriptions" VALUES(14056,'en','Klime was known throughout the World of Twelve for the beauty of his creations, but since his arrival on Frigost, and due in part to the sordid magic he breathes into them, they''ve been getting uglier the more powerful they get. Well, at least these boots look nice.');
INSERT INTO "item_descriptions" VALUES(14057,'en','Wearing this cape will make you so cold you may as well not bother putting it on, so give it to me instead.');
INSERT INTO "item_descriptions" VALUES(14058,'en','If your ring finger wasn''t already a frostbitten stump, it certainly will be now.');
INSERT INTO "item_descriptions" VALUES(14059,'en','No one''s sure exactly how this belt works, but it seems to allow male wearers to keep a cool head in even the most stressful situations. It would appear that a thousand years of classical cerebral anatomy was wrong, and the housewives of Frigost might be on to something after all.');
INSERT INTO "item_descriptions" VALUES(14060,'en','Missiz Freezz''s helmet is a near-perfect example of her incredible talent for smithmagic and item modification. It''s so well made that despite it being infinitely lighter and far easier to carry than a bog-standard helmet, it protects her head just as well.');
INSERT INTO "item_descriptions" VALUES(14061,'en','Missiz Freezz forged this ring herself in a vain attempt to make Count Harebourg jealous. Poor Missiz Freezz - the Count didn''t even notice.');
INSERT INTO "item_descriptions" VALUES(14062,'en','These reinforced boots might not give you the ice-cold temperament of Missiz Freezz, but at least you won''t notice when someone steps on your toes.');
INSERT INTO "item_descriptions" VALUES(14063,'en','Members of a Frigostian criminal organisation sell this hat to naïve tourists, who are told they have to wear it all the time if they want free travel across the frozen island. It makes them loads more money than their previous racket - selling Mastogob Black Pudding pizzas.');
INSERT INTO "item_descriptions" VALUES(14064,'en','Worn back-to-front, Nileza''s cloak can be used as bib to catch your slobber.');
INSERT INTO "item_descriptions" VALUES(14065,'en','The symbol on Nileza''s amulet refers to his love of science, his intelligence, his vast knowledge, and more specifically, his mastery of the elements. You''ll notice it doesn''t describe anything about his mental state, however.');
INSERT INTO "item_descriptions" VALUES(14066,'en','Nileza''s Boots are as waterproof as it is possible to get, but when a simple splash of water would cause Alchimeras to grow out of your feet, you''d want them to be as well.');
INSERT INTO "item_descriptions" VALUES(14067,'en','This ring is a little bit too big for you and chafes your finger, which is very painful. It also looks like it''s about to explode, which would be even more painful.');
INSERT INTO "item_descriptions" VALUES(14068,'en','This ring disturbs the atomic structure of anything it comes into contact with, so you should avoid scratching your itchy bottom with it at all costs.');
INSERT INTO "item_descriptions" VALUES(14069,'en','This belt isn''t called "unstable" because it''s about to self-destruct, invert gravity or send you crazy, it just doesn''t hold your trousers up very well.');
INSERT INTO "item_descriptions" VALUES(14070,'en','If we excuse Sylargh''s antics, his villainy and his impertinence, it''s not because he hides behind this hood, but because he''s just a child. Whether that makes you feel better or worse tells me everything I need to know about you.');
INSERT INTO "item_descriptions" VALUES(14071,'en','If truth be told, Sylargh doesn''t have a cloak. It would be far too big for him, and would trip him up or get stuck between the cogs of his death machines. What you''ve stolen is actually his comfort blanket. You''re a monster!');
INSERT INTO "item_descriptions" VALUES(14072,'en','This isn''t really Sylargh''s belt, it would be much too big for him. His is actually a rather simple affair, crafted from a single strap and a gearwheel, the Imp''s tools of the trade. I bet you paid a fortune for this knockoff, didn''t you?');
INSERT INTO "item_descriptions" VALUES(14073,'en','Long, raggedy teeth and a head made of wood, it''s as if this Kan-O-Mat Headgear was designed with you in mind.');
INSERT INTO "item_descriptions" VALUES(14074,'en','You''ll soon get fed up of people asking you if this cape is machine-washable.');
INSERT INTO "item_descriptions" VALUES(14075,'en','The reverse of this amulet can be opened up to reveal a secret compartment. It looks like you''ve got washing powder for your Kan-O-Mat Cloak hidden in yours.');
INSERT INTO "item_descriptions" VALUES(14076,'en','Count Harebourg was forced to become a recluse after the big freeze, but even back then, no living soul had ever seen his face. What is he hiding behind this hat, and what transformations has that face undergone after all these years?');
INSERT INTO "item_descriptions" VALUES(14077,'en','This ring allows the Count to channel the surplus energy generated by his incredible powers, which would destroy him if let loose. Fortunately, that''s not something you need to worry about.');
INSERT INTO "item_descriptions" VALUES(14078,'en','Between his castle, his soul, his island and his monsters, Count Harebourg''s feet are the only things that aren''t frozen solid thanks to these boots.');
INSERT INTO "item_descriptions" VALUES(14079,'en','It''s hard to imagine Count Harebourg in a helm like this. Mind you, everyone goes through a rebellious stage, and to be fair, his has lasted more than a century.');
INSERT INTO "item_descriptions" VALUES(14080,'en','Looking at this amulet, it''s plain to see that very little has changed over the past hundred years when it comes to jewellery.');
INSERT INTO "item_descriptions" VALUES(14081,'en','This belt is the only piece of equipment that the Count was wearing before the big freeze that he still wears now, mainly because the clasp froze solid when Djaul cast his curse, and Harebourg has been unable to take it off ever since.');
INSERT INTO "item_descriptions" VALUES(14082,'en','Like any good aristocrat, the Bubotron loves a good masked ball, but much to his great annoyance, he''s never allowed to take part. The doormen always turn him away for not wearing a mask, even though he''s quite clearly wearing this one.');
INSERT INTO "item_descriptions" VALUES(14083,'en','Bubotrons can turn their heads through 270 degrees, but are often confused by the sudden rotation. This amulet plays a vital role in allowing the dozy owls to remember the direction they should actually be facing.');
INSERT INTO "item_descriptions" VALUES(14084,'en','Count Harebourg presented this sword as a gift during the Bubotron''s dubbing ceremony. It symbolises the owl''s rank amongst the Sinistros, but as the Bubotron has no hands, it is of no use to him whatsoever.');
INSERT INTO "item_descriptions" VALUES(14085,'en','This cape was woven from filoplumes, tiny, feathery sensors that allow you to feel the changes in air pressure caused by an enemy sneaking up behind you. You''ve got to admit, that''s pretty coo-owl. Oh come on, that wasn''t that bad!');
INSERT INTO "item_descriptions" VALUES(14086,'en','A Sinistrofu doesn''t have a neck, so why would it need an amulet? Is this even an amulet at all? You''d prefer not to find out.');
INSERT INTO "item_descriptions" VALUES(14087,'en','Sinistrofus have asymmetric ears that allow them to pinpoint the source of any sudden noise. The only asymmetric thing about you is your feet, so don''t attempt to do the same thing or you''ll fall over.');
INSERT INTO "item_descriptions" VALUES(14088,'en','Count Harebourg wore this helmet to manipulate time. If you can use it as a welding helmet, it will be an achievement.');
INSERT INTO "item_descriptions" VALUES(14089,'en','This ring, one of Count Harebourg''s inventions, can predict when the weather is going to be cold up to a week in advance. Unsurprisingly, there''s never been any great call for it on Frigost.');
INSERT INTO "item_descriptions" VALUES(14090,'en','Anything that disappears into the hole in this amulet reappears in another era. No, don''t even think about it - the process requires that the "subject" be cryogenically frozen beforehand.');
INSERT INTO "item_descriptions" VALUES(14091,'en','Using the Cycloid eye in this amulet as a monocle might let you see disturbances in the spacetime continuum, but you''ll look like a complete berk doing so.');
INSERT INTO "item_descriptions" VALUES(14092,'en','This ring tells the time, but sadly, no one knows how to read it.');
INSERT INTO "item_descriptions" VALUES(14093,'en','These boots were made for walking at the rate of one step a second. Great if you want to walk somewhere without expending much energy, but not so great if you''re attempting to escape an imminent death.');
INSERT INTO "item_descriptions" VALUES(14094,'en','The Trictus is the Treadfast omen of death. This amulet will predict its appearance, but won''t protect you from other Treadfasts attempting to kill you for wearing the remains of one of their brothers as an amulet.');
INSERT INTO "item_descriptions" VALUES(14095,'en','Treadfasts attach the remains of their prey to the razor-sharp claws on this belt, so they''ve always got something to snack on within easy reach. I''d warn you to keep your hands away from them, if you weren''t always fumbling around in your pockets.');
INSERT INTO "item_descriptions" VALUES(14096,'en','As long as your toes are strong enough, you can use the soles of these boots to help you hang upside-down from the branches of trees. Not a particularly useful skill, you have to admit.');
INSERT INTO "item_descriptions" VALUES(14097,'en','The Nocturnowl Amulet is a magical pendulum that swings back and forth from your neck without stopping, which is great if you want to hypnotise your enemies, or even yourself if you''re that way inclined.');
INSERT INTO "item_descriptions" VALUES(14098,'en','When a Nocturnowl struggles to digest part of its meal, it spits it out in the form of a pellet. You''ll find these pellets all over the Count''s castle, and if you pull one apart, you''ll find all kinds of things - adventurer bones, Nocturnowl feathers, and the bitter tang of frustration.');
INSERT INTO "item_descriptions" VALUES(14099,'en','The spines on a Nocturnowl''s body act as miniature lightning conductors, so you can walk on thick carpet in these boots without having to worry about the build-up of static electricity.');
INSERT INTO "item_descriptions" VALUES(14130,'en','If you wear this belt for long enough, you''ll suddenly crave bacon and eggs for breakfast and want to drink tea all the time. You''ll take great pride in the monarchy, and develop a strange sense of humour and a fondness for battered fish and fried potatoes. Mind you, you were hardly a shining example of normality before you put it on, so your friends might not notice the difference.');
INSERT INTO "item_descriptions" VALUES(14131,'en','At one time on Frigost, way before the big freeze, these daggers were the height of harvesting technology... until the day the mainlanders arrived with their scythes. They may not be used for harvesting crops any more, but they''re perfect for harvesting souls.');
INSERT INTO "item_descriptions" VALUES(14132,'en','If the owner of these daggers wants them to obtain their characteristic odour of blood, sweat and tears, they must remain undefeated throughout countless battles. This pair stinks, so someone must have done all the hard work for you.');
INSERT INTO "item_descriptions" VALUES(14133,'en','This axe will transform any enemy into a docile mount. Plant it firmly between their shoulder blades, use the handle as a saddle, and with a few cracks of a whip you''ll be galloping along in no time.');
INSERT INTO "item_descriptions" VALUES(14135,'en','Are you lonesome tonight, down by the riverside? Has a hard-headed woman got you crying for the green, green grass of home? Well, a little less conversation, a little more equipping this shovel! Pull on your sequinned jumpsuit, comb some Trool fat through your hair and get that pelvis jerking uncontrollably – you''ll be shake, rattle and rolling in no time! Oh, come on, I''m doing the best I can...');
INSERT INTO "item_descriptions" VALUES(14146,'en','This vibrating pick is used to shatter rocks, and should under no circumstances be used for vibrating anything else.');
INSERT INTO "item_descriptions" VALUES(14156,'en','They say that if you touch a Feca''s glyph with the tip of this rapier, you will be able to decipher the symbols written at its heart. Mind you, they also say that carrying it will help you overcome your fear of water, give you the courage to quit your menial job, and that it has the power to burn down houses, so I''d take that with a pinch of salt if I were you.');
INSERT INTO "item_descriptions" VALUES(14159,'en','This cape was worn by Adipose, an obese Sadida who liked to use his defeated enemies as stuffing for his mattresses. The countless bloodstains are testament to the terrible punishment the poor souls endured, and Adipose was consigned to history as one of the cruellest beings the World of Twelve had ever seen. To be fair, you get through a lot of mattresses when you sleep for 23 hours a day, and Bubotron Feathers don''t come cheap.');
INSERT INTO "item_descriptions" VALUES(14160,'en','They say that as soon as the bearer of this amulet admits to killing defenceless animals for fun, its sinister powers are revealed when it strangles the unsuspecting blabbermouth to stop them from admitting anything else! Mind you, if that were true, there''d be no one left alive in Amakna...');
INSERT INTO "item_descriptions" VALUES(14161,'en','Appearances can sometimes be deceptive, as this powerful cape demonstrates. You''re the proof that it doesn''t happen very often, though.');
INSERT INTO "item_descriptions" VALUES(14162,'en','Like many men, Epeni loved to compare his belt strap to other men''s belt straps. The more he tugged at it, the longer it became, and the more he polished its buckle, the happier he felt. But happiness is fleeting, and if truth be told, Epeni was incredibly lonely.');
INSERT INTO "item_descriptions" VALUES(14163,'en','Usia Sandals conjure up thoughts of happy summer holidays, with the sun beating down on an endless sandy beach and the sea as warm as bathwater. It''s a shame that in Amakna, everywhere like that is overrun with bloodthirsty monsters, or, even worse, with tourists.');
INSERT INTO "item_descriptions" VALUES(14164,'en','You may be surprised to hear that this powerful bow, which once belonged to an archon, one of the chief magistrates of ancient Amakna, was never fired during battle. It was considered a coward''s weapon so the pen-pushers had to join in the melee with the foot soldiers, rather than staying at the back out of harm''s way. Even back then, wars were lost through misplaced egos.');
INSERT INTO "item_descriptions" VALUES(14166,'en','You painted the letters R, I and P on the oversized tip of this sceptre because you think it looks cool, and because you think death is edgy and artistic. The colour matches your nail polish, your eye shadow, your labret, your Evil Tofu key ring, your Bow Meow outfit, your bedroom and your Chameleon Dragoturkey. Well, for this week at least.');
INSERT INTO "item_descriptions" VALUES(14167,'en','The resounding thud this hammer makes as it comes into contact with yet another poor unfortunate''s skull can become very addictive, so you''ll need to be careful, because once you''ve run out of enemies, you''ll be tempted to start hitting your friends.');
INSERT INTO "item_descriptions" VALUES(14168,'en','If you struggle to find new reasons to stay at home every time your friends ask you out, then this flamboyant cloak is just what you need. Sling it over your shoulders and it''ll generate a torrent of excuses, from "I''m washing my hair" and "My Bow Meow died" to that old chestnut "A band of marauding Mastogobs destroyed my house". Mind you, it''s so hideous that no one would want to be seen dead with you anyway, so its vocal talents are somewhat wasted.');
INSERT INTO "item_descriptions" VALUES(14169,'en','This amulet has the extraordinary ability to make you believe everything you''re told.');
INSERT INTO "item_descriptions" VALUES(14170,'en','Any dork who tries wearing this headband as a belt will receive a high-voltage bolt of electricity to their nether regions, quickly putting an end to such disillusioned practises. "Bzzzing! AAAGH!"');
INSERT INTO "item_descriptions" VALUES(14171,'en','There''s a secret hidden in the name of these boots, and although corrupted over time, it becomes obvious once you know the dreadful truth - they''re made from mechanically extracted Ouginak sausage meat. There''ll be uproar when people find out, but it will be a shame if they stop making them for "ethical reasons", because they''re so comfortable!');
INSERT INTO "item_descriptions" VALUES(14271,'en','If you''re always risking your life on a roll of the dice, then you''ll love this necklace, which is just like the one worn by the famous Lucky Bow Meow. It''ll even let you use the Kama Baraka in Kerub''s shop. You lucky devil!');
INSERT INTO "item_descriptions" VALUES(14273,'en','Some narrow-minded historians claim that Bonta has never had a monarch. Here is the irrefutable proof that they''re wrong. In-depth studies of the fabric seem to confirm that the royal pants were worn on the head as well as on the buttock, which made them very useful for diplomatic meetings gone wrong.');
INSERT INTO "item_descriptions" VALUES(14274,'en','Legend has it that this power-charged weapon was created by Ulgrude of Thunder, Protector of Martalo. In reality, it''s far more likely that it''s just a shepherd''s staff. The Gobbette that''s been following you around lately favours this explanation... Unless she just finds that you two have a lot in common?');
INSERT INTO "item_descriptions" VALUES(14277,'en','It''s said that this silken belt was worn by the famous Master Nabur, the martial arts specialist. Apparently he enchanted it to alert him when danger was approaching... Unfortunately, this magic seems to have worn off, which is too bad for you, as you could do with being saved by the bell from time to time.');
INSERT INTO "item_descriptions" VALUES(14281,'en','This phylactery emits a soft warmth that will bring back fond memories of the sultry night you spent sandwiched between a Dragostess and a Dreggon Warrior. It also attracts Moskitos in the night.');
INSERT INTO "item_descriptions" VALUES(14283,'en','When it was first made, this belt didn''t look Vulkanian enough for anyone''s taste. Without further ado, it was smelted, soaked in tourist blood three times in a row, covered in soot and riddled with holes to make it look "worn-in". Oh, the whims of fashion.');
INSERT INTO "item_descriptions" VALUES(14285,'en','This heavy helmet will protect your head from falling lava and fluttering ash next time you visit a volcano. Unfortunately, it''s not much good against currents of hot air, which will zip in one ear and out the other, sizzling important information to a crisp.');
INSERT INTO "item_descriptions" VALUES(14286,'en','This pince-nez guarantees that you''ll bump into a lot more people than you used to. Too bad you feel absolutely no need to be sociable any more, what with the beautiful, shimmering, fragmented view of the world you''re discovering.');
INSERT INTO "item_descriptions" VALUES(14287,'en','The metaphysical properties of this expensive crystal allow it to light up in the presence of arsenic. You''ll be able to use it as a halogen lamp the next time your alliance has a banquet!');
INSERT INTO "item_descriptions" VALUES(14288,'en','The tyrannical employees in charge of security in Vulkania Park use these wands on tourists to amuse themselves during breaks. What, you''ve never played Jabble, Prodopoly or Poke ''Er? You''ve never lived!');
INSERT INTO "item_descriptions" VALUES(14289,'en','This axe feels so light in your hands that you get the dizzying feeling that it could cleave an unsuspecting tourist or a nosy neighbour in half without much input on your part.');
INSERT INTO "item_descriptions" VALUES(14302,'en','This ring starts glowing when it senses hostile plants nearby. If you''re going to the Petrified Forest, you may as well take it off... But just so you know, you''ll also be wide open to attacks from mutant plants.');
INSERT INTO "item_descriptions" VALUES(14304,'en','This amulet isn''t anywhere near as sharp as it looks, which will be a relief to most people... Although perhaps not to the Sacriers who saw it from afar, noticed its resemblance to an instrument of torture, and bought it on the spot.');
INSERT INTO "item_descriptions" VALUES(14310,'en','With these boots on, "taking somebody under your wing" has a whole new meaning. They enable their wearer much more flexibility when it comes to moving around, which is especially useful when it comes to dodging attacks.');
INSERT INTO "item_descriptions" VALUES(14311,'en','You don''t know what the symbol engraved on this thing means, but who cares? It leaves an awesome stamp on the bruised faces of the enemies you defeat. You could always carve your initials in their flesh with the end of your sword, but that takes so much longer.');
INSERT INTO "item_descriptions" VALUES(14433,'en','Ever since he can remember, others of his kind have teased Tubskito about his weight. He''s therefore decided to take his life into his own wings and now he can''t wait to get back at the cruel world that so easily rejects anyone a little different. But he''s still just a moskito so... you''ll likely always have a few lingering, irritating reminders of your time together.');
INSERT INTO "item_descriptions" VALUES(14491,'en','This beast of a crown only comes out on special occasions, on account of its weight. If you feel like wearing it on your head would be a pain in the neck, you can always use it as a shield.');
INSERT INTO "item_descriptions" VALUES(14492,'en','This cloak weighs heavy on your shoulders. Have you unwittingly agreed to bear the Wa Wabbit''s guilt, or is it all your own?');
INSERT INTO "item_descriptions" VALUES(14493,'en','This belt is actually totally hollow and was designed to hold emergency Cawwots for the Wa. You feel around inside, but the ruddy swindler managed to finish all but a few mouldy end bits before you got to him. Curses!');
INSERT INTO "item_descriptions" VALUES(14494,'en','You''ve heard that the pair of ears fixed on this gleaming helmet will enable you to hear just as well as a Wabbit. It seems that the original owner of this particular specimen was as deaf as a post.');
INSERT INTO "item_descriptions" VALUES(14495,'en','This belt was awarded following a great tournament in which Wabbits went head to head in red-hot, bare-pawed combat. Once the winner, a Whitepaw, had been declared and the madness had died down, the Wabbits started wondering whether the whole thing hadn''t been an elaborate set-up to sell over-priced Cawwot juice to all the spectators.');
INSERT INTO "item_descriptions" VALUES(14496,'en','It''s a funny thing: when Wabbits get old, they all start to look like one another and smell kind of fusty. These bracelets were invented to help distinguish the different Whitepaw Wabbits: each one periodically releases a spray of a unique odour: peach blossom, fresh pine, damp soil, last week''s bedding...');
INSERT INTO "item_descriptions" VALUES(14497,'en','The third eye on this ring is the result of a genetic modification made to the Janus Wabbits. Be aware that you may suffer side effects when wearing it... If you feel an extra eye, nose or arm starting to grow, please take the ring off as soon as possible before the situation gets worse.');
INSERT INTO "item_descriptions" VALUES(14498,'en','Hardly anyone dares wear this amulet. It may be soft, but being near the Janus Wabbit''s tail is... well, let''s just say it''s uncomfortable for anyone who''s not used to the smell. If you''re used to hanging around at Gwimace''s, you should be fine.');
INSERT INTO "item_descriptions" VALUES(14499,'en','Janus Wabbits have three legs. You''ve got a spiffing new pair of boots from the two outer legs, but you can''t help wondering whether the third foot matches your left foot or your right...');
INSERT INTO "item_descriptions" VALUES(14500,'en','One of the most popular Wabbit games out there is Whewe''s Wabbit. The rules are simple: one participant dons a pair of Wewe-Wabbit Boots and hides in a dense crowd. The others then look high and low for the one with the boots. When they find him, they ''wip him to shweds''. Have fun!');
INSERT INTO "item_descriptions" VALUES(14501,'en','Snuggling up in this warm cape will make nightfall feel as cosy as returning home to a bowl of stew and a seat by the fire. Unless you wear it on the night of the full moon, of course.');
INSERT INTO "item_descriptions" VALUES(14502,'en','Even if you haven''t noticed that the Cawwot adorning this belt is a tawdry shade of purple, other people will. Prepare a terrifying story about how you triumphed over two-headed Wabbits, living Cawwots and Wabbit-bat hybrids, or say goodbye to your street cred.');
INSERT INTO "item_descriptions" VALUES(14505,'en','This shield is a replica of the trophy awarded to the winners of the famous Dragoturkey race. It''s not as prestigious as the original, of course, but if it stops you from getting sliced in two by an anonymous madman, who are you to complain?');
INSERT INTO "item_descriptions" VALUES(14506,'en','This poor imitation of a Iop''s flamboyant hairstyle is said to have been made using a ball of wool blessed by the god Ecaflip himself. That''s probably why Woolly Bow Meows have such fun playing with it.');
INSERT INTO "item_descriptions" VALUES(14519,'en','Back in the day, Judge Lou was the big cheese around the north of Cania. Her sentences were harsh, the word ''appeal'' wasn''t in her vocabulary and she was the terror of the courtrooms. Bonta''s criminals trembled before her. Apparently, Kerub Crepin is the only one who ever convinced the judge of his clients'' innocence. How he did it is another matter entirely.');
INSERT INTO "item_descriptions" VALUES(14545,'en','Luckily for you, Fosfor is one of the only survivors of the Abandoned Labowatowies that isn''t toxic to touch. Well, he was only discovered recently, so who knows what might happen, but he''s probably safe. Either way, he''s the most charming night-light you''ve ever had.');
INSERT INTO "item_descriptions" VALUES(14579,'en','Before being used as a mask, this was an old chamber pot that passed through the hands of many owners. Due to a misunderstanding, Dramak put it on his head and, too proud to admit his mistake, has refused to this day to take it off.');
INSERT INTO "item_descriptions" VALUES(14580,'en','The fact that a certain Levito wore this belt caused no small uproar amongst Dramak''s servants, and it took Dramak a monumental effort to convince them he was their one true chief.');
INSERT INTO "item_descriptions" VALUES(14581,'en','Dramak just won''t stop telling you what a fantastic idea it was to make multiple copies of this bracelet. And as shattering magic objects is your favourite hobby, you''re inclined to agree.');
INSERT INTO "item_descriptions" VALUES(14582,'en','The most treacherous ruffians use these straps as a means of identifying each other, which ensures they don''t con their peers. Certain badmouthers have suggested they only use straps because they couldn''t find anything cheaper.');
INSERT INTO "item_descriptions" VALUES(14583,'en','So you want to play the swaggart and have everybody''s eyes on your mediocre self? This hat''s for you. It''ll replace all your bragging and cowardice with actual virtues, and all for a modest price.');
INSERT INTO "item_descriptions" VALUES(14584,'en','Splinted and taped all over the place, this bow is nevertheless still an efficient weapon, capable of shooting right through an imbecile hanging out at the Astrub Zaap, in the middle of the other hawkers.');
INSERT INTO "item_descriptions" VALUES(14585,'en','Spanner uses this key not just to open doors, but to accomplish all sorts of tasks given by Dramak, like fixing the theatre, or whacking adventurers over the head.');
INSERT INTO "item_descriptions" VALUES(14589,'en','Your little cheeks have never known comfort like this. But beware of strangers; one of them might belong to the bizarre panty-raider cult. If that''s the case, they won''t hesitate to beat you senseless until you disrobe and hand over the goods. So take some advice: watch your behind!');
INSERT INTO "item_descriptions" VALUES(14593,'en','Fin Fang: two opposing yet balanced forces. Light and Dark. Good and Evil. Surf and Turf.');
INSERT INTO "item_descriptions" VALUES(14597,'en','This amulet is commonly worn by zoologists in the spring. Its pleasant fragrance wafts into their nostrils and helps them to put up with the horrific stench when they study the mating habits of Lousy Pigs. Yup, zoologists are voyeurs!');
INSERT INTO "item_descriptions" VALUES(14601,'en','If you were only wearing this, you''d look like an idiot. A super cute idiot, sure, but an idiot all the same. Ah, who cares? You don''t need to be smart to be attractive.');
INSERT INTO "item_descriptions" VALUES(14605,'en','Despite what you may think, this ring isn''t worn on your finger. Certain Osamodas tried to wear it in other ways during certain of their ceremonies - they had some problems.');
INSERT INTO "item_descriptions" VALUES(14609,'en','No one knows exactly where this ring came from; all we know is that it fell off the end of a Quakane during a particularly vigorous fight against the Bworkette.');
INSERT INTO "item_descriptions" VALUES(14613,'en','This ring is given annually as a prize to the first imbecile to dress as a Tofoone, head into the Eltneg Wood and come out alive. Due to a recent change in rules, being in one piece is also required.');
INSERT INTO "item_descriptions" VALUES(14617,'en','The White Ninja is extremely superficial and superstitious. He paid a fortune for this amulet to protect him from bad spells, but it only protects him from having too many kamas.');
INSERT INTO "item_descriptions" VALUES(14621,'en','The Black Ninja''s amulet holds dark and terrible powers, remnant of ancient times, which according to the legend are powerful enough to kill even a god. The only problem is that the method of accessing those powers has long since been forgotten, which explains the amulet''s cheap price.');
INSERT INTO "item_descriptions" VALUES(14625,'en','They say the messenger Airmees could fly using the prototype of these boots. Amakna shoemakers, on guard against potential abuses since the incident involving Klime''s overpowered boots, decided to nerf these boots before marketing them.');
INSERT INTO "item_descriptions" VALUES(14629,'en','More practical than dried rations, and less cumbersome than hunting gear, this belt is still used during certain Pandikaze operations.');
INSERT INTO "item_descriptions" VALUES(14633,'en','These boots aren''t quite as classy as those made of white dragon scales, but they''re still pretty popular with adolescents looking to find gear that matches their Adora Set.');
INSERT INTO "item_descriptions" VALUES(14637,'en','This used to be a normal jellyfish. But then Oktapodas saw it being bullied near his sanctuary, and so punished it by turning its tentacles to eels. Then he sent an adventurer named Pershing to kill it and turn it into a hat. Doesn''t really seem fair, does it?');
INSERT INTO "item_descriptions" VALUES(14638,'en','This belt will make you feel like a fish in water. And you could almost take that expression literally, given the ripe smell emanating from it.');
INSERT INTO "item_descriptions" VALUES(14639,'en','Admit it, you''ve asked yourself how mermaids keep from getting lost in the ocean depths. Well here you have your answer. This ring is equipped with the latest Foggernaut technology, including a G.P.S. (Geolocation in the Depths of Sufokia) system and a camera for taking underwater selfies.');
INSERT INTO "item_descriptions" VALUES(14640,'en','This staff was specially conceived for underwater engagements. Which means you won''t be able to use it to its full potential until you''ve learned to swim. So for the moment, it might be better for you and your companions if you just use it as little as possible.');
INSERT INTO "item_descriptions" VALUES(14644,'en','Numerous adventurers are ready to sell their parents, sacrifice their families and eat their mount to see, even for a moment, what lies under this belt...');
INSERT INTO "item_descriptions" VALUES(14798,'en','Sometimes used to discipline insolent young Iops, this solid belt is usually worn pulled quite tightly, to hold in the paunch. This style is particularly popular with King Allister''s personal guards.');
INSERT INTO "item_descriptions" VALUES(14803,'en','These boots are indispensable during traditional theatre performances. They''re used by the security guards to give a swift kick in the rear to disrespectful patrons while they''re being shown the door.');
INSERT INTO "item_descriptions" VALUES(14806,'en','Giving this ring to someone you desire is a simple, effective, and not overly-expensive means to an end. It doesn''t seem to work too well with Enutrofs, but, really, when you get down to it, who cares?');
INSERT INTO "item_descriptions" VALUES(14809,'en','If you like speaking in a nasal voice, quacking your butt off, and walking with an anitidae stuck to your tail, this Quacoif is made for you. What''s more, it''s pink, which makes it absolutely indispensable!');
INSERT INTO "item_descriptions" VALUES(14810,'en','By wearing this insignia, you''ll become a Keeper of the Peace. Dressed in your nice blue uniform, you''ll be a Baahboh, a civil servant. Honest citizens will accord you the greatest respect, and delinquents will tremble at the mere mention of your name – at least, in theory. In the real world, it''ll be almost exactly the opposite.');
INSERT INTO "item_descriptions" VALUES(1014827,'en','Kwyness will surely satisfy your taste for luxury. The custom leather saddle alone will make for a unique flying experience, not to mention the aerodynamic feathers. But you''ll have to cater to its whims – Sir Kwak doesn''t sleep in just any nest, you know.');
INSERT INTO "item_descriptions" VALUES(1014833,'en','This petsmount is completely unable to keep its head out of the clouds, preferring to embark on wild flights of fancy and going wherever the wind blows. It likes to dream of a place where it can roam freely without adventurers always trying to mount it.');
INSERT INTO "item_descriptions" VALUES(1014838,'en','Dehluge and Brulay get along quite well, despite their very opposite temperaments: while Brulay tends to be hot-headed, Dehluge prefers the path of least resistance. However, he''s definitely not afraid to dive in and get his feet wet.');
INSERT INTO "item_descriptions" VALUES(1014848,'en','Quite unlike Sirocco, Kompost is very down-to-earth, undoubtedly the perfect companion for those with their head in the clouds. He''ll keep your feet solidly on the ground, forcefully if need be.');
INSERT INTO "item_descriptions" VALUES(1014854,'en','Brulay is a bit of a hot-head with a short fuse. You''d better not upset him if you''d like to keep your butt out of the fire.');
INSERT INTO "item_descriptions" VALUES(14877,'en','Wearing this hat outside Sufokia will make it very, very hard for people to take you seriously since it looks a bit, well... ridiculous. Underwater, however, it will make you look like a shark. You''ll still be a guppy, however.');
INSERT INTO "item_descriptions" VALUES(14878,'en','This talisman was found in the darkest depths of Sufokian waters, and allows you to breathe underwater! Sure, when they found it, it was around the neck of a drowned man, but hey, who''s to say it wasn''t put there after the man drowned?');
INSERT INTO "item_descriptions" VALUES(14879,'en','This ring used to belong to Jon Mackerelane, who was just a normal soldier until Merkator forced him to be the base''s protector. After numerous exploits, Mackerelane went to the surface to escape the fame he''d earned. The last thing anyone remembers him saying? "Ring-a-ling, motherfogger!"');
INSERT INTO "item_descriptions" VALUES(14880,'en','There''s no doubt about it: this helm is a great way to get some alone time, as not many will dare approach you while you''re wearing it. But it''s not foolproof: there are certain mischievous types who will find it pretty amusing to follow you around and launch pieces of fruit at your helmet to try and get them to stick. This might actually be rather desirable if you''re hungry and want a free lunch...');
INSERT INTO "item_descriptions" VALUES(14881,'en','These boots are designed specifically to help you protect your back. A swift flex of your knee, and anyone standing behind you will wish they hadn''t been. Warning: your mounts may not share your appreciation of these boots.');
INSERT INTO "item_descriptions" VALUES(14882,'en','While not very useful for many tasks, it''s incredibly handy for a select few. For example, in combat, it makes your punches that much more effective. Outside of battle, you''ll have all the usefulness of a fork without needing to actually carry one. Where would we be without such gadgets?');
INSERT INTO "item_descriptions" VALUES(14883,'en','This headband can just as easily be worn over the eyes – they say it helps with underwater navigation. Unfortunately, it won''t help you navigate the Sunktuary!');
INSERT INTO "item_descriptions" VALUES(14884,'en','This next-generation amulet will let you look at your quests from a new angle. You''ll love exploring far-off lands and helping the inhabitants. And what''s more, it glows in the dark!');
INSERT INTO "item_descriptions" VALUES(14885,'en','One of the great capes, the Cape of Pohdoog has for a long time been significant to sailors, some of whom simply call it "THE Cape". It''s especially popular on clipper ships and during yacht races.');
INSERT INTO "item_descriptions" VALUES(14886,'en','Legends say that with such a weapon, ancient warriors were able to smash the hull of a boat with a single blow. The famed Captain Passeridae was particularly adept at the technique. Unfortunately, he also wasn''t very bright. His hammer sunk with his ship after he tried to use it to nail a portrait of his spouse to the cabin wall.');
INSERT INTO "item_descriptions" VALUES(14929,'en','This amulet holds a horrible secret. Something simultaneously wondrous and terrible. But to open it, you''ll need to swallow it. As for getting it back, there are a couple of different methods...');
INSERT INTO "item_descriptions" VALUES(14930,'en','This belt isn''t hiding much. It''s a perfectly normal belt in all respects. It does a decent job of keeping your pants up, and it''s even fairly stylish. Sometimes, that''s all you need.');
INSERT INTO "item_descriptions" VALUES(14931,'en','These shoes are ancient relics imbued with deathly powers. It''s probably worth noting it''s not been established who the powers affect: the wearer or his target?');
INSERT INTO "item_descriptions" VALUES(14932,'en','This ring will give you the amazing power to control your own shadow: it will follow you and exactingly mimic you! This sales pitch probably won''t convince many.');
INSERT INTO "item_descriptions" VALUES(14933,'en','These boots are astoundingly uncomfortable. They''re for those who are nostalgic for the olden times, when one had to suffer to progress. They''ll keep you suffering throughout the day, but imagine how good it will feel to slip them off when you get home.');
INSERT INTO "item_descriptions" VALUES(14934,'en','"This helmet will make your sense of smell 10 times as powerful!"
Notice: The markings on this helmet are for decoration. This helmet does not incorporate eye holes.
Consumer warning: This helmet renders the wearer blind. Increased olfactory capacity has been proven to be fatal under certain circumstances. Avoid Bworks and public restrooms.');
INSERT INTO "item_descriptions" VALUES(14937,'en','This cape used to be a symbol of valour and glorious deeds, but those days are gone. Now its value is aesthetic, worn by those looking for attention. Real Vigilantes have stopped wearing it, even in full dress, after one of their peers was crushed to death in less than a minute, having caught his cape in a revolving door.');
INSERT INTO "item_descriptions" VALUES(15009,'en','This belt, with bells lining the entire length, was crafted and offered to Father Whupper as a sort of early warning system. He''s not the sort of person you want sneaking up on you.
Why doesn''t he just take it off, you ask? They got his mother-in-law to give it to him as a gift - now he has to wear it at Kwismas time.');
INSERT INTO "item_descriptions" VALUES(15010,'en','These jester boots will be a splendid addition to your wardrobe. It''s well known that black is slimming and goes with everything.');
INSERT INTO "item_descriptions" VALUES(15011,'en','Wearing this ring will be very poorly looked on: it''s a reminder of the suffering Father Whupper inflicted on the inhabitants of Kwismas Island. Certain groups are even trying to have it outlawed.');
INSERT INTO "item_descriptions" VALUES(15012,'en','Wearing this hat will earn you a few amused glances and maybe a few snickers too. Maybe that''s why Violet Arrow is an archer. So that he can fight from afar – in other words, out of sight.');
INSERT INTO "item_descriptions" VALUES(15013,'en','It''s said that Violet Arrow likes this color because he was raised by Goblins. Which might explain the countless arrows planted around their camp.');
INSERT INTO "item_descriptions" VALUES(15014,'en','This bow is part of Violet Arrow''s arsenal, but he''s got many more! There''s one for every taste: bows which shoot explosive arrows, sticky arrows, boomerang arrows, Pumpkwins, hearts, and even rainbows! Because simply changing the arrows is a little too conventional...');
INSERT INTO "item_descriptions" VALUES(15015,'en','Not content to simply terrorise the country folk with his imposing build, Veg Antilleze is the only monster able to instantly make any enemy cry. This hat contains a bit of that power, and it''s edible too!');
INSERT INTO "item_descriptions" VALUES(15016,'en','This cape - 100% organic, like the rest of Veg Antilleze''s gear - has a peculiar smell which naturally repels all manner of enemies.');
INSERT INTO "item_descriptions" VALUES(15017,'en','These boots will give you the excuse you''ve been looking for to smell your feet.');
INSERT INTO "item_descriptions" VALUES(15059,'en','This is a real head, shrunken to a twentieth of its original size (by a secret ancestral technique, naturally) to fit onto a finger. An anonymous researcher managed to carry out the same process on Pikoko Rumps, but not even modern art students wanted to wear them. That''s what happens when you''re ahead of your time.');
INSERT INTO "item_descriptions" VALUES(15060,'en','The legends say that Eltux, the Meridia of the Colour Blue, painted all the Kanazures in homage to Blou, the Meridia of Humidity. Nobody really knows what exactly he was hoping to achieve, or whether he succeeded, but at least now we know why the Kanazures are always feeling so blue.');
INSERT INTO "item_descriptions" VALUES(15061,'en','Kanazure Ray the tailor invented this cape after his attempts to market his adult Haloperi Doll replica failed miserably. The sales numbers were well behind even the XXXboxes sold in the seedy quarters of Bonta.');
INSERT INTO "item_descriptions" VALUES(15062,'en','This headgear will make you look like some kind of terrible Iop-beast that''ll scare the bejesus out of the Astrubians and maybe even some Amaknians. Of course, you''ll need to try a lot harder than that to scare Nevark.');
INSERT INTO "item_descriptions" VALUES(15063,'en','The number of red marks on an Orfan''s belt is a sign of how good at hunting its owner is. Every time he devours his prey, alive and kicking, he has to loosen his belt by one mark so he doesn''t get bloated. You can use it in much the same way to count how many beers you''ve had down the tavern.');
INSERT INTO "item_descriptions" VALUES(15064,'en','Visitors to the region are always asking where the Orfans'' second eye went - all except those who have one of these amulets. They know the answer, but won''t breathe a word to anyone.');
INSERT INTO "item_descriptions" VALUES(15099,'en','This flouncy skirt will change colours slightly when you shake your hips. As cool as that might sound, you should probably only do it at home in front of the mirror. As usual, there''s a fine line indeed between ''twerk'' and ''twerp''.');
INSERT INTO "item_descriptions" VALUES(15100,'en','These boots were designed to make the Too-Faux Karnaval as pleasurable as possible. Just make sure your toenail polish matches the colour of the PVC, or else your feet will be plastered all over the ''fashion fail'' pages of the bumper Karnaval edition of Krosmopolitan. Cringe!');
INSERT INTO "item_descriptions" VALUES(15110,'en','If you think you''ve adopted a pet which will snooze peacefully by the hearth, you''re in for a shock. The Bowzai''s ferociousness is inversely proportional to its size, and it spends all day yowling, hissing and scratching everything to pieces. It also loves to stare at you whilst sniggering, which is neither cute nor reassuring.');
INSERT INTO "item_descriptions" VALUES(15133,'en','It''s not so much bravery as the fact that the bandana slips down over its eyes that the Black Tiwabbit always charges headlong into enemies... and allies. It makes for a great diversion tactic, though!');
INSERT INTO "item_descriptions" VALUES(15157,'en','People always put this hat on when they need help with something. They stand in the same place all day long and repeat the same tired guilt trips hundreds of times a day, just like the self-professed charitable souls you always meet in the centre of Amakna. What an exciting life they lead!');
INSERT INTO "item_descriptions" VALUES(15183,'en','Perfect if you''re desperate for a bit of alone time, this mask acts as a natural repellent for people that would otherwise come up and start speaking to you, especially children. Careful you don''t use it too often or you''ll become a bitter old fool whose stories are all boring, repetitive rants.');
INSERT INTO "item_descriptions" VALUES(15184,'en','This comfortable, old-fashioned cloak is the height of fashion for Enutrofs. Its unusual shape is also just the thing to hide your hunchback.');
INSERT INTO "item_descriptions" VALUES(15185,'en','Starumen hate going anywhere without their belt. As soon as they take it off at night, their body hair springs out in all directions just like their facial hair.');
INSERT INTO "item_descriptions" VALUES(15186,'en','Nidas''s Crown can also be worn backwards to watch what''s going on behind you. Then again, do you really trust a Shushu to watch your back?');
INSERT INTO "item_descriptions" VALUES(15187,'en','This pugnacious ring loves the limelight and is happiest serving wearers who like fighting bare-fisted.');
INSERT INTO "item_descriptions" VALUES(15188,'en','If you want to wear these sandals, make sure you wash between your toes every day, or they''ll make sure you regret it.');
INSERT INTO "item_descriptions" VALUES(15189,'en','This amulet is actually used for testing its wearer''s purity. Every time you have a dirty thought, the two balls move upwards and start strangling you. It''s only a matter of time.');
INSERT INTO "item_descriptions" VALUES(15190,'en','Each Hairsh ball has a special meaning, which is why there are also some on this bracelet. You don''t really care about the meanings; you just like ''em because they match your eyes.');
INSERT INTO "item_descriptions" VALUES(15191,'en','These slippers are too heavy to be lifted up each time you take a step; instead, just slide your feet forward when you want to move. At least that way the floors of Enurado get cleaned too!');
INSERT INTO "item_descriptions" VALUES(15192,'en','Hair blowing in the wind, this headgear will give you the timeless style of a Levitrof. That might seem like a bit of a let-down, but I''ll have you know that there are certain people who won''t even speak to you unless you sport a look like this. Like... well, mostly other Enutrofs.');
INSERT INTO "item_descriptions" VALUES(15193,'en','Levitrofs start wearing these wedding rings after a certain age because they know they''ll never get the chance to wear a proper one.');
INSERT INTO "item_descriptions" VALUES(15194,'en','As you may or may not have guessed from their name, Levitrofs levitate. These boots really aren''t very useful at all.');
INSERT INTO "item_descriptions" VALUES(15195,'en','The Kamasterisks aren''t stupid; they know you can''t go about without a shovel in this day and age. They invented this portable version with a retractable handle so they could keep their hands free for picking up coins and shooing other people away.');
INSERT INTO "item_descriptions" VALUES(15196,'en','There''s nothing like huge golden boots for going incognito.');
INSERT INTO "item_descriptions" VALUES(15197,'en','Some people say that Kamasterisks actually fashion their head hair into a beard in order to conceal their femininity. This cloak makes you think those people might be right.');
INSERT INTO "item_descriptions" VALUES(15198,'en','Ahhh, finally a pair of boots that breathe! Just be careful as you walk around, as it''s common for little objects to slip inside unseen. They''re also known for sneezing, often and always at the worst moments, making you fall down stairs, off cliffs, into swimming pools, etc.');
INSERT INTO "item_descriptions" VALUES(15199,'en','Because of its value in gold, this belt is very rarely actually used as a belt. And for those of you who think it''d make a good weapon: think again. It''s way too heavy!');
INSERT INTO "item_descriptions" VALUES(15200,'en','This Drellhair cloak is a must-have for individuals in a certain income bracket. It gives its wearer a wild, almost Kanigrula-esque look.');
INSERT INTO "item_descriptions" VALUES(15201,'en','This belt looks like it came straight from the Shustuft Crust. Who knows how far the Powa Drhell had to dig to find it?');
INSERT INTO "item_descriptions" VALUES(15202,'en','This cloak makes you look terrifically terrifying! Unfortunately, the other Drhellers don''t think so, and are more likely to charge you from behind than they are to run away.');
INSERT INTO "item_descriptions" VALUES(15203,'en','This might not be the most tasteful accessory around, but at least your friends can''t accuse you of walking around with your nose in the air any more.');
INSERT INTO "item_descriptions" VALUES(15207,'en','Wearing this cloak will give you an irrepressible urge to blurt out everything that passes through your head. Who cares, when the whole world will see you''ve got a tongue to put even Sean Jimmons to shame!');
INSERT INTO "item_descriptions" VALUES(15208,'en','The creator of this belt got fed up of losing the key to it and enchanted the lock so it would open up to any key at all. Just thought you should know before you went out into the big bad world hoping to keep your trousers up.');
INSERT INTO "item_descriptions" VALUES(15210,'en','These boots will act just like treasure chests, protecting your doughy calves in all circumstances.');
INSERT INTO "item_descriptions" VALUES(15212,'en','It''s never felt this good to have horns! China shops, here you come!');
INSERT INTO "item_descriptions" VALUES(15213,'en','The message is clear enough: whatever lies behind this belt is very dearly guarded indeed.');
INSERT INTO "item_descriptions" VALUES(15215,'en','Although they''re supposed to symbolise virility, these boots are most often on the feet of people who need to compensate for something. Curious...');
INSERT INTO "item_descriptions" VALUES(15216,'en','It''s said that Brutatax led the army of chests using this very wand. Funnily enough, when you wave it around, all that happens is that papers fly everywhere and you get a burning pain in your scar.');
INSERT INTO "item_descriptions" VALUES(15217,'en','The Drhossil Hammer is a paradoxical piece of equipment. It was designed by Enutrofs to mint kamas, but it actually makes them disappear. As a result, it was quickly banned from Enurado: losing a single kama is seen as sacrilege of the worst kind.');
INSERT INTO "item_descriptions" VALUES(15218,'en','This shovel was made for diggin'', but not just anywhere! Only in the infinite gold heaps of Enurado.');
INSERT INTO "item_descriptions" VALUES(15235,'en','Dragon''s egg or Strich egg? Maybe it''s half and half... After all, if there''s a Dragon Pig, there could be a Dragon Strich somewhere out there. Heh... Hehehe... PSHAWHAWHAW! Okay, no, that would just be too ridiculous. ...Or would it?');
INSERT INTO "item_descriptions" VALUES(15240,'en','These flip-flops leave kama prints behind you when you walk along the beach. Just don''t be surprised when you''re trying to watch the sunset from an isolated cove and a horde of voracious treasure hunters show up, thinking they''re onto something.');
INSERT INTO "item_descriptions" VALUES(15241,'en','Wear this belt on your first day at a new school and you''ll have tons of friends in no time! Of course, nothing''s to say they''ll stick around when they find out you''re flat broke in reality.');
INSERT INTO "item_descriptions" VALUES(1015243,'en','Drhexler is an all-terrain petsmount. He''ll trek on, unaffected by the longest journeys and the toughest climates. He''s so insensitive, in fact, that he won''t even notice if you fall off his back; he''ll just soldier on into the sunset without you.');
INSERT INTO "item_descriptions" VALUES(15249,'en','This pet is crazy about kamas and goes nuts when it smells any nearby! Some boutiques use Snoofles as kama detectors to determine whether their customers have money to spend there or not. The only downside is that when someone asks if you can spare a few kamas, you can''t pretend not to have any...');
INSERT INTO "item_descriptions" VALUES(15254,'en','Drhellbert has an innate talent for finding his way, especially in Enurado, where he knows the scents like the back of his paw! He''s the best companion there is to help you weave your way among the god Enutrof''s piles of gold.');
INSERT INTO "item_descriptions" VALUES(15282,'en','According to Gizmond, this nugget chucker can be used to train the Drhellers'' reflexes. Is he planning to transform them into terrifying war beasts? You don''t know. Just doin'' your job.');
INSERT INTO "item_descriptions" VALUES(15356,'en','This hat has the incredible advantage of making you invisible when you stick your head in the sand.');
INSERT INTO "item_descriptions" VALUES(15357,'en','With this around your hips, you can bet that your belt area will get a lot of attention. Just don''t be surprised if people start avoiding you in the street.');
INSERT INTO "item_descriptions" VALUES(15358,'en','This ring is a constant reminder that some awkward questions simply can''t be answered.');
INSERT INTO "item_descriptions" VALUES(15359,'en','Designed for bad weather, this cloak of Stretch feathers swells up to absorb rainwater... and gets so heavy that you can barely walk in it. You should probably just use it as a towel.');
INSERT INTO "item_descriptions" VALUES(15360,'en','These boots make the same sounds as Stretches do during mating season. Don''t be surprised if you attract quite a following every time you wear them out of the house!');
INSERT INTO "item_descriptions" VALUES(15361,'en','With this amulet around your neck, you look exactly like a Stretch (that''s lost all its feathers and become deformed).');
INSERT INTO "item_descriptions" VALUES(15422,'en','However banal the name, this item is anything but – it was created for a very special and unique purpose. Try not to use it to do the bookshelves.');
INSERT INTO "item_descriptions" VALUES(15428,'en','These are the boots of a criminal par excellence: silent enough that one can sneak in and out of any place without being seen, and comfortable enough to celebrate misdeeds with a little improvised dance number.');
INSERT INTO "item_descriptions" VALUES(15429,'en','This very simple belt is a symbol that its wearer is part of Srambad''s nobility. No matter how the wearer came by the belt.');
INSERT INTO "item_descriptions" VALUES(15430,'en','This cape is slightly fluorescent, allowing its wearer to be detected in the dark. Also, it''s so light that it''s entirely possible to be wearing it and not even know it. These two characteristics have made it quite popular with some of Srambad''s delinquents, who use it to mark a target to be beaten up later.');
INSERT INTO "item_descriptions" VALUES(15431,'en','You might be wondering how Gein manages to see anything at all, given that this hat completely covers the eyes. But one generally doesn''t have time to ask too many questions when face-to-face with him.');
INSERT INTO "item_descriptions" VALUES(15432,'en','Gein actually uses this belt as pants, but it might be a bit tight on you.');
INSERT INTO "item_descriptions" VALUES(15433,'en','Gein is a bit of a gambler: you just have to yank on the chain of his amulet to immobilize him. Obviously, if he takes that kind of a risk, it''s because anyone who gets that close to him is already regretting it.');
INSERT INTO "item_descriptions" VALUES(15434,'en','The Queen of Thieves proposed a challenge to her followers: all they had to do was steal a strip of fabric from her belt. No one really had the pluck to get that close, and she gave up out of boredom. But since, they''ve attached some lighter-than-light strips so that everyone has a chance to nab one without her noticing.');
INSERT INTO "item_descriptions" VALUES(15435,'en','Like all self-respecting criminals, the Queen of Thieves has fitting boots: practical and, above all, silent. The difference is that hers are far more classy.');
INSERT INTO "item_descriptions" VALUES(15436,'en','This headpiece is particularly interesting for bald people: on windy days, it can give them the impression the wind is blowing through their hair.');
INSERT INTO "item_descriptions" VALUES(15437,'en','The Malitiamen sometimes need to get into the most impractical places in Srambad and have thus created these slightly raised boots to get wherever they need to go, so long as it''s in an urban setting.');
INSERT INTO "item_descriptions" VALUES(15438,'en','It''s said the Malitiamen based their look on Fungi Masters. In any case, the similarities are striking.');
INSERT INTO "item_descriptions" VALUES(15439,'en','"Come undone" is a very understated way to describe what has happened to this cape.');
INSERT INTO "item_descriptions" VALUES(15440,'en','This ring is the only officially authorized weapon for Rasslin matches, and it leaves behind nice little imprints of a star.');
INSERT INTO "item_descriptions" VALUES(15441,'en','The principal characteristic of these boots is that they make a lot of noise. Which is, of course, an important part of Rasslin, helping to keep the atmosphere high during matches.');
INSERT INTO "item_descriptions" VALUES(15442,'en','Here''s a mask just like Captain Scarlight''s. Well, no one is actually sure that he wears one, but it seems the most likely hypothesis, given his complete lack of facial expressions.');
INSERT INTO "item_descriptions" VALUES(15469,'en','For generations, all the members of the Homlett family have been the servants of a powerful necromancer. They''re so loyal that they continue to serve their master after their own demise, in the form of talking skulls. Dead or alive, they remain loyal. "To be or not to be" is not a question the Homletts have asked.');
INSERT INTO "item_descriptions" VALUES(15493,'en','According to the legends, these daggers were ordered by Sram, in the image of his own daggers, for his disciples. Seeing how successful these copies were, the inhabitants of Srambad started a booming counterfeit trade without even bothering to pass them off as genuine.');
INSERT INTO "item_descriptions" VALUES(15494,'en','This shovel can, astonishingly, be used to bury things. Dead things... Live things...');
INSERT INTO "item_descriptions" VALUES(15495,'en','This bow can cause damage without its arrows being seen. Unless they can smell the arrows, they''ll never see it coming.');
INSERT INTO "item_descriptions" VALUES(15496,'en','This imposing sword is very manageable. So much so that the Queen of Thieves always keeps it on her. Some even say it''s her closest friend and confidant.');
INSERT INTO "item_descriptions" VALUES(15499,'en','Only to be used in case of an emergency. This jewel contains a powerful poison capable of ruining your life, or saving it, depending on the situation.');
INSERT INTO "item_descriptions" VALUES(15500,'en','Outlawed outside of Srambad thanks to a lobby of Sadida, these boots have a tendency to wilt any vegetable matter under your foot. Quite an effective way to get rid of weeds, despite some tiny side effects.');
INSERT INTO "item_descriptions" VALUES(15501,'en','Necroticks recognize their allies primarily by their smell, and this cape is soaked with it. The only problem is that the odour it gives off is a direct result of the powerful poisons coming from it. Use it at your own risk.');
INSERT INTO "item_descriptions" VALUES(15502,'en','These boots will do nothing to help your athlete''s foot.');
INSERT INTO "item_descriptions" VALUES(15503,'en','All the experts insist that Dremoan is in fact edible, but no one has really had the courage to try: its colour is about as appetising as your great-aunt''s special Gobball tripe. Not very.');
INSERT INTO "item_descriptions" VALUES(15504,'en','With this cape equipped, you can proudly show that you defeated the biggest menace in the petrified forest. But be careful not to keep it on your back too long – nobody really knows what Dremoan is made of, and it could be dangerous.');
INSERT INTO "item_descriptions" VALUES(15505,'en','This net allows you to keep a weak Necrotick from fleeing.');
INSERT INTO "item_descriptions" VALUES(15506,'en','This belt probably fit Captain Scarlight alright, but it has a tendency, just like Captain Scarlight, to grab you uncomfortably between the legs.');
INSERT INTO "item_descriptions" VALUES(15507,'en','Get ready for some incredible slides: since they have very little friction, these boots guarantee spectacular effects. That''s actually how Captain Scarlight always seems to get out of sticky situations.');
INSERT INTO "item_descriptions" VALUES(15508,'en','These gloves give whoever wears them a rather imposing air: don''t be surprised if people suddenly start avoiding you, but don''t enjoy it too much either.');
INSERT INTO "item_descriptions" VALUES(15514,'en','With this helmet on your head, you''ll be the terror of the swamps. And there''s more! The steam coming off your head whenever you think really hard will come out its nostrils, giving it an even more menacing look.');
INSERT INTO "item_descriptions" VALUES(15518,'en','Wanted throughout Amakna, Mastigator keeps this amulet to remind him of what might happen if he ever decides to come out of exile.');
INSERT INTO "item_descriptions" VALUES(15523,'en','Mastigator never was all that clean, and this cape shows it: it looks as if he may have used it as a napkin or tissue. Or both. Probably both.');
INSERT INTO "item_descriptions" VALUES(15524,'en','With this mask in your hands, you can understand Stellia''s reputation a little better: it''s reinforced to make head-butts all the more deadly.');
INSERT INTO "item_descriptions" VALUES(15525,'en','Stellia is a big-time shoe collector, but she''s not really a big fan of variety. So this is the only type of shoe in her collection. She has over 9,000 pairs of them.');
INSERT INTO "item_descriptions" VALUES(15526,'en','Stellia never takes off her gloves, given her tendency to get her hands dirty.');
INSERT INTO "item_descriptions" VALUES(15548,'en','Not many fans go as far as wearing a belt with their favourite teams colours. That''s what separates the true fans from the cheerleaders.');
INSERT INTO "item_descriptions" VALUES(15549,'en','This discreet amulet is great for timid fans or fans who aren''t completely confident in their favourite team: it''s easy to hide if your favourite team bombs.');
INSERT INTO "item_descriptions" VALUES(15607,'en','This pet rolls up in a ball at the slightest hint of danger. Then, depending on how the ground tilts, he''ll roll randomly in one direction and can sometimes work as a distraction.');
INSERT INTO "item_descriptions" VALUES(15660,'en','These Mini Inuit knives are not for fighting.');
INSERT INTO "item_descriptions" VALUES(15692,'en','The mouth of these boots can open, though their breath will make you wish they didn''t.');
INSERT INTO "item_descriptions" VALUES(15693,'en','These shoes are often used in snowy or icy environments: they stick really well, and don''t sink into snow.');
INSERT INTO "item_descriptions" VALUES(15694,'en','A monster that has long been on the minds of many an ardent adventurer, Kideebom can now be on your head instead.');
INSERT INTO "item_descriptions" VALUES(15695,'en','Orange enough to make a pumpkwin jealous, this mask will be a hit come Al Howin.');
INSERT INTO "item_descriptions" VALUES(15696,'en','With this cape on your back, you''ll feel like a fish in the water. You probably won''t feel as nimble though, given its size.');
INSERT INTO "item_descriptions" VALUES(15697,'en','Made up, as it is, of little bits of Krobes, you''d better have a solid and healthy constitution if you''re going to wear this cape. Otherwise it might make you a bit of a hypochondriac.');
INSERT INTO "item_descriptions" VALUES(15698,'en','Pawl Ouatnos keeps this ring as a reminder that even the smallest creatures are important. And also that it''s a pain in the butt to make a ring out of fish.');
INSERT INTO "item_descriptions" VALUES(15699,'en','The Belteen is more suited to imposing physiques. But unlike other belts, this one inflates to squeeze its wearer, giving an illusion of more volume. It can also be used as a flotation device in the event of a water landing.');
INSERT INTO "item_descriptions" VALUES(15700,'en','This translucent loincloth is a favourite among exhibitionists: even if they''re not completely naked, they''re certainly not hiding much.');
INSERT INTO "item_descriptions" VALUES(15701,'en','The symbol of the Sea Chafer, this amulet is worn by its captain. It seems it allows him to communicate with powerful marine animals, even though the latter aren''t too talkative.');
INSERT INTO "item_descriptions" VALUES(15737,'en','You''ve heard that this amulet allows its wearer to turn his head 360° with a little practise. Then again, all the people that told you that are sadly no longer with us. You decide to keep turning around the old-fashioned way.');
INSERT INTO "item_descriptions" VALUES(15738,'en','According to the legend, this hat provides the ultimate protection against sunstroke, but only at night. During the day, it suddenly becomes transparent. O, great hat, what other mysteries do you conceal?');
INSERT INTO "item_descriptions" VALUES(15739,'en','I never go for a night hunting with the gals without my Showl!');
INSERT INTO "item_descriptions" VALUES(15740,'en','This ring will peck off the end of your finger before you know it. Some reckless adventurers use it as a dangerous kind of nail clipper.');
INSERT INTO "item_descriptions" VALUES(15741,'en','These boots will probably make you feel like a fatty. Not only are they unflattering on your calves; they also don''t appear to be able to lift you off the ground like it said on the advert.');
INSERT INTO "item_descriptions" VALUES(15742,'en','Clearly, this helmet makes you look like the perfect predator. Now you just need to practise turning invisible and making creepy noises in the trees.');
INSERT INTO "item_descriptions" VALUES(15743,'en','Vortex hasn''t been able to get this belt on for years. You''ll probably go the same way, you know.');
INSERT INTO "item_descriptions" VALUES(15744,'en','These little clogs provide a soft touchdown after jumps of over 20 kametres. Try them if you don''t believe me!');
INSERT INTO "item_descriptions" VALUES(15745,'en','This is the very best way to look like Vortex without actually being Vortex. Just get to work growing out that belly, and soon the two of you will be indistinguishable!');
INSERT INTO "item_descriptions" VALUES(15746,'en','This pendant can look into the future and foresee any event. It really is too bad it doesn''t know how to talk.');
INSERT INTO "item_descriptions" VALUES(15747,'en','People say that the Fugitives sprouted wings after downing too many Raid Boole Potions. This cloak offers some of the same effects, although there''s no guarantee you won''t regret wearing it.');
INSERT INTO "item_descriptions" VALUES(15748,'en','With shoes like these, pesky electrocutions during voyages through time will be a thing of the past!');
INSERT INTO "item_descriptions" VALUES(15749,'en','If someone gazes pointedly into this pendant for 42 hours straight, they will be completely under your command.');
INSERT INTO "item_descriptions" VALUES(15750,'en','Oh! Were you planning to wear this ring on your finger? It''s a belt, silly!');
INSERT INTO "item_descriptions" VALUES(15751,'en','Bootini was one of the finest magicians of all time, and yet fate has decided that he will be best known for sharing his name with these silly boots. (Just try and get out of them once they''re on, though!)');
INSERT INTO "item_descriptions" VALUES(15762,'en','These boots will let you kick your enemies'' butts 42 times faster than before.');
INSERT INTO "item_descriptions" VALUES(15764,'en','This belt has the pointiest demon horns you''ve ever seen. Woe betide the tipsy adventurer who decides to greet you with a friendly hip bump.');
INSERT INTO "item_descriptions" VALUES(15768,'en','Now when someone asks you the meaning of life, the universe and everything, giving them the finger whilst wearing this ring should suffice.');
INSERT INTO "item_descriptions" VALUES(15771,'en','This belt will either boost your masculinity, or make you look impossibly ridiculous. Luck of the draw.');
INSERT INTO "item_descriptions" VALUES(15773,'en','This topper comes from the deepest, most demonic realm and is imbued with time-old magic. When you put it on, you will look like a backing vocalist from a boyband. You can''t have it all!');
INSERT INTO "item_descriptions" VALUES(15776,'en','Don''t get me wrong, I hate demons as much as the next fella, but there''s something comforting about cuddling up with a pair of slippers lined with their armpit hair.');
INSERT INTO "item_descriptions" VALUES(15778,'en','"Nananananananana FRAKTAL!" Yep. You''re practically a superhero now.');
INSERT INTO "item_descriptions" VALUES(15779,'en','Lifting this wand straight up into the air during a storm is enough to transport you through time. I mean, everyone else who''s tried it has vanished and never returned, so it seems to work fine.');
INSERT INTO "item_descriptions" VALUES(15780,'en','This belt has several amazing properties, including the ability to reproduce infinite quantities of its own logo. Not bad for hypnotising your enemies.');
INSERT INTO "item_descriptions" VALUES(15781,'en','Paradoxically, this hammer is most effective when the pointy end is used.');
INSERT INTO "item_descriptions" VALUES(15782,'en','You probably think there''s no feather on earth that could cut you into bits... Why not let this be the feather to prove you wrong?');
INSERT INTO "item_descriptions" VALUES(15783,'en','Although this ring is extremely fragile, it will make you hugely powerful. Just make sure you don''t sit on it by accident.');
INSERT INTO "item_descriptions" VALUES(15784,'en','This ring will show the world that the thing it needs to fear the most is you (well, kind of).');
INSERT INTO "item_descriptions" VALUES(15789,'en','There''s nothing scarier than a Xelomorph staring at you with its big, shining eyes... So just imagine how frightened your enemies will be when they see you in these boots!');
INSERT INTO "item_descriptions" VALUES(15791,'en','This semi-transparent cloak adapts to suit its wearer''s look and makes them look even more imposing.');
INSERT INTO "item_descriptions" VALUES(15794,'en','Nobody knows why, but the moment you pull on this balaclava, you are filled with an insatiable hunger for acorns. Chomp!');
INSERT INTO "item_descriptions" VALUES(15795,'en','Perfect for all your country walks, these boots will help you become friends with the animals!');
INSERT INTO "item_descriptions" VALUES(15796,'en','This amulet, which was made out of an Akornaddikt tail, is so soft and fluffy that you can''t stop stroking yourself with it. That''s normal, right?');
INSERT INTO "item_descriptions" VALUES(15860,'en','There''s nothing like a little bolt from the blue to pep you up when all you want is a nice nap.');
INSERT INTO "item_descriptions" VALUES(15886,'en','The temporal convector embedded in the head of this hammer was invented by Doc Ettem Bworn. As for what it does... We''re still trying to figure that out.');
INSERT INTO "item_descriptions" VALUES(15978,'en','"You shall not pass!" 
These words suit your new pet to a tee. Still, don''t expect it to stand between you and certain death, as it lacks both courage and muscles.');
INSERT INTO "item_descriptions" VALUES(15990,'en','Are you the kind that shrinks away from a scrap? Do you have delusions of grandeur? The Rikiki wand is perfect for you. You can also use it to slip into inaccessible areas... soon, no mouse hole will be unknown to you.');
INSERT INTO "item_descriptions" VALUES(15992,'en','If, while cleaning this ring, you notice a golden dust coming off it, think happy thoughts; perhaps you''ll be able to fly, as if by magic...');
INSERT INTO "item_descriptions" VALUES(15993,'en','Appreciate a good match? Like to strike it lucky? Then this cape is made for you! Just make sure you don''t rub against any rough surfaces, or you may find it goes up in smoke.');
INSERT INTO "item_descriptions" VALUES(15994,'en','Has anyone ever told you you have a brain the size of a peanut? Well, with this helmet you''ll finally have enough protection for it to come out of its shell.');
INSERT INTO "item_descriptions" VALUES(15995,'en','Worn around the neck, this pearl is a beautiful jewel. And a nice way to recycle an earring if you''ve lost one half of the pair.');
INSERT INTO "item_descriptions" VALUES(15996,'en','This needle-shaped pendant grants the power to heal even the most serious of injuries... If you know how to use it.');
INSERT INTO "item_descriptions" VALUES(15997,'en','The liquid flowing in this belt has superior healing properties and provides instant relief for nagging back pain!');
INSERT INTO "item_descriptions" VALUES(15998,'en','Feeling tense? Rub this ring against your skin and feel your muscles instantly relax. The light scent of menthol will also be a great improvement on your usual odour.');
INSERT INTO "item_descriptions" VALUES(15999,'en','Panthyrozy used to hide her face behind this mask, and not only when she was up to mischief! Her beauty was so great, it would have driven even the hardest of men mad...');
INSERT INTO "item_descriptions" VALUES(16003,'en','It may look harmless but the end of this belt can be used as a fearsome whip against all who stand in your path.');
INSERT INTO "item_descriptions" VALUES(16004,'en','The ideal accessory for any robbery! Make quick work of any window with this ring, which is as sharp as diamond.');
INSERT INTO "item_descriptions" VALUES(16005,'en','Armed with this bracelet, you will be kept informed about the forces of pressure acting upon your body. Now, that may not seem useful anywhere beyond the deepest depths of the oceans... and in fact it isn''t.');
INSERT INTO "item_descriptions" VALUES(16006,'en','These waterproof sandals are the product of advanced technological developments, and will keep your feet dry in any circumstances.');
INSERT INTO "item_descriptions" VALUES(16007,'en','This mask will help you see clearly in even the darkest areas, and will provide all the oxygen you need to go deep-sea diving.');
INSERT INTO "item_descriptions" VALUES(16061,'en','This Dofus was fashioned on the basis of someone''s hazy recollection of what an authentic dragon egg looked like. Touching it causes long-lost memories to come flooding back - it''s almost like tasting a Becky Stein cake for the first time in years. You revisit your arrival in Incarnam and the first time you ever slaughtered a Gobbly... Ah, great times!');
INSERT INTO "item_descriptions" VALUES(16116,'en','The Eliom is a mischievous, chatty spirit that tends to show up around portals created by the Eliotropes. Legends claim that the Eliom is a wandering soul which is not ready for reincarnation just yet. Although it can be irritating, even annoying at times, the Eliom is not evil at heart... It just likes to get into people''s ears with its shrill voice.');
INSERT INTO "item_descriptions" VALUES(16122,'en','Friendrakes are born in an enormous cavern discovered by the Eliotropes beneath the waters of Sufokia. These miniature dragons have long lacked affection, and they make for extremely loyal companions. When a Friendrake adopts you, it''s for life! When you go on nights out with your fellow adventurers, you can count on your Friendrake to warm up the room and lighten the mood with the funny faces it makes.');
INSERT INTO "item_descriptions" VALUES(16140,'en','It''s hard to understand the use of this mask if you haven''t used an Eliotrope portal before. Even if you have used one, it''s still hard to understand what the mask is for... But at least you can use it to hide your face, and that must be a godsend for someone with a face like yours.');
INSERT INTO "item_descriptions" VALUES(16141,'en','Just like a flying carpet, this will take you around the world. Its secret power? If you gently caress it, it will open up an "Ortal", which you can try to use for faster travel. It''s not an Eliotrope Portal, but it''s something.');
INSERT INTO "item_descriptions" VALUES(16142,'en','With these boots, you can move from A to B using the power of your own two feet. Isn''t that amazing? It''s so amazing that you can never reveal the secret to anyone. No, seriously! We swear!');
INSERT INTO "item_descriptions" VALUES(16143,'en','If you spin around on the spot very quickly while wearing this belt, something surprising may well happen to you. Although, since no-one who''s ever done it is still around to talk about it, nobody knows what this surprise actually is. Give it a try though, you''ll see for yourself!');
INSERT INTO "item_descriptions" VALUES(16144,'en','Bright like the sun and powerful like a supernova, this ring will augment your Eliotrope powers in a great and terrible way. You''re not an Eliotrope? Then you could put it on your bedside table - it would make for a very nice nightlight too. Such is also the power of the Nova Ring.');
INSERT INTO "item_descriptions" VALUES(16169,'en','A wood sculptor had started by carving bows from dead branches found in the Dark Forest. Sadly, they were too soft when drawn and proved to be unusable by the authorities. The sculptor then tried his hand at truncheons made from Soft Oak branches. Surprisingly hard as nails, they were immediately adopted by Brakmar instructors, who continue to use them on the heads of unruly Chafers to this day.');
INSERT INTO "item_descriptions" VALUES(16171,'en','A cape specially designed for those who like to hide their cape? Now I''ve seen it all... or at least I would, if I could see it...');
INSERT INTO "item_descriptions" VALUES(16172,'en','A very practical head covering to make sure everyone can see your fantastic follicles or lack thereof. As you may have guessed, this hat is for exhibitionists and adventurers with no inhibitions.');
INSERT INTO "item_descriptions" VALUES(16173,'en','Does your mother-in-law suffer from arachneephobia? Well congratulations, you''ve found the ideal gift for her next birthday, which will be her last, with any luck.');
INSERT INTO "item_descriptions" VALUES(16174,'en','Supple and soft to the touch, these boots are incredibly comfortable. But be prepared to be asked to go barefoot by those who hate seeing those creepy crawlies scuttling across their floor.');
INSERT INTO "item_descriptions" VALUES(16175,'en','This hat was a roaring success at the last fashion show organised by the Brakmar Black Widows Association.');
INSERT INTO "item_descriptions" VALUES(16176,'en','Some claim that this talisman corrects eyesight problems; while others assure us that it merely multiplies them. The truth, as is often the case, depends on your point of view.');
INSERT INTO "item_descriptions" VALUES(16177,'en','If you cross paths with Nevark the Hunter while wearing this cape, he may take you for the acolyte of Arachneeman and give you a good hiding. But you''re free to do what you want, after all.');
INSERT INTO "item_descriptions" VALUES(16178,'en','With this many legs, no one will ever think you''re on your last ones.');
INSERT INTO "item_descriptions" VALUES(16182,'en','If your enemies do not pass away, at least they shall not pass.');
INSERT INTO "item_descriptions" VALUES(16183,'en','If your enemies do not pass away, at least they shall not pass.');
INSERT INTO "item_descriptions" VALUES(16184,'en','If your enemies do not pass away, at least they shall not pass.');
INSERT INTO "item_descriptions" VALUES(16185,'en','This Trophy will be of no use to you whilst crossing the desert.');
INSERT INTO "item_descriptions" VALUES(16186,'en','This Trophy will be of no use to you whilst crossing the desert.');
INSERT INTO "item_descriptions" VALUES(16187,'en','This Trophy will be of no use to you whilst crossing the desert.');
INSERT INTO "item_descriptions" VALUES(16188,'en','This Trophy will help you heal your allies by offering wise words: "an api a day keeps the doctor away; seven apis a week you''ll no longer feel weak"');
INSERT INTO "item_descriptions" VALUES(16189,'en','This Trophy will help you heal your allies by offering wise words: "an api a day keeps the doctor away; seven apis a week you''ll no longer feel weak"');
INSERT INTO "item_descriptions" VALUES(16190,'en','This Trophy will help you heal your allies by offering wise words: "an api a day keeps the doctor away; seven apis a week you''ll no longer feel weak"');
INSERT INTO "item_descriptions" VALUES(16191,'en','It helps to be cured, but not in the ham sense.');
INSERT INTO "item_descriptions" VALUES(16192,'en','It helps to be cured, but not in the ham sense.');
INSERT INTO "item_descriptions" VALUES(16193,'en','It helps to be cured, but not in the ham sense.');
INSERT INTO "item_descriptions" VALUES(16194,'en','The saliva on your lips allows you to create a Snailmet trail when you bite the dust.');
INSERT INTO "item_descriptions" VALUES(16195,'en','The saliva on your lips allows you to create a Snailmet trail when you bite the dust.');
INSERT INTO "item_descriptions" VALUES(16196,'en','The saliva on your lips allows you to create a Snailmet trail when you bite the dust.');
INSERT INTO "item_descriptions" VALUES(16202,'en','Team up with some Bworks to become the group''s intellectual.');
INSERT INTO "item_descriptions" VALUES(16203,'en','Team up with some Bworks to become the group''s intellectual.');
INSERT INTO "item_descriptions" VALUES(16204,'en','Team up with some Bworks to become the group''s intellectual.');
INSERT INTO "item_descriptions" VALUES(16209,'en','Wearing the Forester''s Ring originally symbolised commitment to a way of life: sleeping under the stars, climbing trees, eating mushrooms, rolling around in the hay, etc. But now that some are wearing it purely for aesthetic reasons, its meaning has become somewhat devalued. However, it still represents a desire to return to naturism.');
INSERT INTO "item_descriptions" VALUES(16239,'en','These boots are said to improve Kwismas dinners. Independent studies have shown that wearers of this footwear do show a marked increase in their appreciation for sprouts.');
INSERT INTO "item_descriptions" VALUES(16240,'en','This ring has a different meaning depending on which finger it is worn. For example, on the middle finger, it means you are blossoming.');
INSERT INTO "item_descriptions" VALUES(16243,'en','That pitiful slip on a banana skin was just a stunt to make your friends laugh. No one believed you, but everyone had a good laugh.');
INSERT INTO "item_descriptions" VALUES(16244,'en','That pitiful slip on a banana skin was just a stunt to make your friends laugh. No one believed you, but everyone had a good laugh.');
INSERT INTO "item_descriptions" VALUES(16245,'en','That pitiful slip on a banana skin was just a stunt to make your friends laugh. No one believed you, but everyone had a good laugh.');
INSERT INTO "item_descriptions" VALUES(16246,'en','You had a 99% chance of getting a glass half-empty, but you got a glass half-full. How lucky is that!');
INSERT INTO "item_descriptions" VALUES(16247,'en','You had a 99% chance of getting a glass half-empty, but you got a glass half-full. How lucky is that!');
INSERT INTO "item_descriptions" VALUES(16248,'en','You had a 99% chance of getting a glass half-empty, but you got a glass half-full. How lucky is that!');
INSERT INTO "item_descriptions" VALUES(16249,'en','That playground bully who destroyed your sand castle traumatised you for life. Time for payback.');
INSERT INTO "item_descriptions" VALUES(16250,'en','That playground bully who destroyed your sand castle traumatised you for life. Time for payback.');
INSERT INTO "item_descriptions" VALUES(16251,'en','That playground bully who destroyed your sand castle traumatised you for life. Time for payback.');
INSERT INTO "item_descriptions" VALUES(16252,'en','Monsters will bite you on the bum and you will bite the dust. Poor monsters.');
INSERT INTO "item_descriptions" VALUES(16253,'en','Monsters will bite you on the bum and you will bite the dust. Poor monsters.');
INSERT INTO "item_descriptions" VALUES(16254,'en','Monsters will bite you on the bum and you will bite the dust. Poor monsters.');
INSERT INTO "item_descriptions" VALUES(16255,'en','There where your Dragoturkey has passed, the grass will never grow again.');
INSERT INTO "item_descriptions" VALUES(16256,'en','There where your Dragoturkey has passed, the grass will never grow again.');
INSERT INTO "item_descriptions" VALUES(16257,'en','There where your Dragoturkey has passed, the grass will never grow again.');
INSERT INTO "item_descriptions" VALUES(16258,'en','When attacked, you''ll fire back with anything: curses, taunts, bad jokes, baptisms and great balls.');
INSERT INTO "item_descriptions" VALUES(16259,'en','When attacked, you''ll fire back with anything: curses, taunts, bad jokes, baptisms and great balls.');
INSERT INTO "item_descriptions" VALUES(16260,'en','When attacked, you''ll fire back with anything: curses, taunts, bad jokes, baptisms and great balls.');
INSERT INTO "item_descriptions" VALUES(16262,'en','You''ve always strongly believed that blood is thicker than water. Which is why you never pour yourself a refreshing glass of blood.');
INSERT INTO "item_descriptions" VALUES(16263,'en','You''ve always strongly believed that blood is thicker than water. Which is why you never pour yourself a refreshing glass of blood.');
INSERT INTO "item_descriptions" VALUES(16264,'en','You''ve always strongly believed that blood is thicker than water. Which is why you never pour yourself a refreshing glass of blood.');
INSERT INTO "item_descriptions" VALUES(16265,'en','You tried different air styles but that was before your thatch turned into thin air.');
INSERT INTO "item_descriptions" VALUES(16266,'en','You tried different air styles but that was before your thatch turned into thin air.');
INSERT INTO "item_descriptions" VALUES(16267,'en','You tried different air styles but that was before your thatch turned into thin air.');
INSERT INTO "item_descriptions" VALUES(16269,'en','The Tanuks don''t hit puberty for a few decades, but when they do they gain both their independence and a ferocious temper. Before adolescence they''re as docile as a lazy Bow Meow, but it''s impossible to tell the males from the females, since their distinguishing features, at this age, haven''t grown much bigger than their tails. The poachers working in Pandala make a nice bit of money from the trafficking of these creatures, to which you are contributing by taking this little Tanuk under your wing.');
INSERT INTO "item_descriptions" VALUES(16274,'en','Your technique is not to be the quickest, but to just delay everyone else so you''re not the slowest. This is a tried and tested technique in all administrations of the World of Twelve.');
INSERT INTO "item_descriptions" VALUES(16275,'en','Your technique is not to be the quickest, but to just delay everyone else so you''re not the slowest. This is a tried and tested technique in all administrations of the World of Twelve.');
INSERT INTO "item_descriptions" VALUES(16276,'en','Although not quite as cute as a Konalak, you''ll feel just as much need to take care of it, to cuddle it, to stroke its head and to rub your face against its soft fur.');
INSERT INTO "item_descriptions" VALUES(16281,'en','Your technique is not to be the quickest, but to just delay everyone else so you''re not the slowest. This is a tried and tested technique in all administrations of the World of Twelve.');
INSERT INTO "item_descriptions" VALUES(16282,'en','Headbutting an enemy to stun them seemed to be an interesting tactic. Until you realized they were wearing a helmet, but you weren''t.');
INSERT INTO "item_descriptions" VALUES(16283,'en','Headbutting an enemy to stun them seemed to be an interesting tactic. Until you realized they were wearing a helmet, but you weren''t.');
INSERT INTO "item_descriptions" VALUES(16284,'en','Headbutting an enemy to stun them seemed to be an interesting tactic. Until you realized they were wearing a helmet, but you weren''t.');
INSERT INTO "item_descriptions" VALUES(16292,'en','Use a good Fire attack with this Trophy and you''ll be able to dodge and burn.');
INSERT INTO "item_descriptions" VALUES(16293,'en','Use a good Fire attack with this Trophy and you''ll be able to dodge and burn.');
INSERT INTO "item_descriptions" VALUES(16294,'en','Use a good Fire attack with this Trophy and you''ll be able to dodge and burn.');
INSERT INTO "item_descriptions" VALUES(16295,'en','The result of Doctor Morose''s experiments, the Mastostroke was created by repeatedly crossing Angora Bow Meows with Evil Dandelions. Its mischievous character, inherited from its gene pool, has made it the target of much Iopery.');
INSERT INTO "item_descriptions" VALUES(16300,'en','There''s no shame in fleeing when there''s no chance of winning.');
INSERT INTO "item_descriptions" VALUES(16301,'en','There''s no shame in fleeing when there''s no chance of winning.');
INSERT INTO "item_descriptions" VALUES(16302,'en','There''s no shame in fleeing when there''s no chance of winning.');
INSERT INTO "item_descriptions" VALUES(16303,'en','Knocking down so many enemies has made you a happy feller.');
INSERT INTO "item_descriptions" VALUES(16305,'en','Knocking down so many enemies has made you a happy feller.');
INSERT INTO "item_descriptions" VALUES(16306,'en','Knocking down so many enemies has made you a happy feller.');
INSERT INTO "item_descriptions" VALUES(16308,'en','Solid but not unbreakable. This is how your allies will describe you just before breaking your two big toes following a terrible joke.');
INSERT INTO "item_descriptions" VALUES(16309,'en','Solid but not unbreakable. This is how your allies will describe you just before breaking your two big toes following a terrible joke.');
INSERT INTO "item_descriptions" VALUES(16310,'en','Solid but not unbreakable. This is how your allies will describe you just before breaking your two big toes following a terrible joke.');
INSERT INTO "item_descriptions" VALUES(16311,'en','Sometimes it''s just better to be never than late.');
INSERT INTO "item_descriptions" VALUES(16312,'en','Sometimes it''s just better to be never than late.');
INSERT INTO "item_descriptions" VALUES(16313,'en','Sometimes it''s just better to be never than late.');
INSERT INTO "item_descriptions" VALUES(16314,'en','This Trophy may come in useful as a dirt dish. If used upside down, logic dictates that it could also be used to dish the dirt.');
INSERT INTO "item_descriptions" VALUES(16315,'en','This Trophy may come in useful as a dirt dish. If used upside down, logic dictates that it could also be used to dish the dirt.');
INSERT INTO "item_descriptions" VALUES(16316,'en','This Trophy may come in useful as a dirt dish. If used upside down, logic dictates that it could also be used to dish the dirt.');
INSERT INTO "item_descriptions" VALUES(16318,'en','This Trophy protects you from all the ditherers who can''t choose sides during a fight.');
INSERT INTO "item_descriptions" VALUES(16319,'en','This Trophy protects you from all the ditherers who can''t choose sides during a fight.');
INSERT INTO "item_descriptions" VALUES(16320,'en','This Trophy protects you from all the ditherers who can''t choose sides during a fight.');
INSERT INTO "item_descriptions" VALUES(16321,'en','This Trophy will make an excellent ashtray if you prefer to use the Peace Pipe rather than fight.');
INSERT INTO "item_descriptions" VALUES(16322,'en','This Trophy will make an excellent ashtray if you prefer to use the Peace Pipe rather than fight.');
INSERT INTO "item_descriptions" VALUES(16323,'en','This Trophy will make an excellent ashtray if you prefer to use the Peace Pipe rather than fight.');
INSERT INTO "item_descriptions" VALUES(16324,'en','This Trophy protects you from Crocodyl Tears.');
INSERT INTO "item_descriptions" VALUES(16325,'en','This Trophy protects you from Crocodyl Tears.');
INSERT INTO "item_descriptions" VALUES(16326,'en','This Trophy protects you from Crocodyl Tears.');
INSERT INTO "item_descriptions" VALUES(16327,'en','Taking refuge under this Trophy will protect you from wind, but will not prevent you from generating your own. This can lead to an uncomfortable case of trapped wind.');
INSERT INTO "item_descriptions" VALUES(16328,'en','Taking refuge under this Trophy will protect you from wind, but will not prevent you from generating your own. This can lead to an uncomfortable case of trapped wind.');
INSERT INTO "item_descriptions" VALUES(16329,'en','Taking refuge under this Trophy will protect you from wind, but will not prevent you from generating your own. This can lead to an uncomfortable case of trapped wind.');
INSERT INTO "item_descriptions" VALUES(16330,'en','You took it literally when she said to ''get up and go''.');
INSERT INTO "item_descriptions" VALUES(16331,'en','You took it literally when she said to ''get up and go''.');
INSERT INTO "item_descriptions" VALUES(16332,'en','You took it literally when she said to ''get up and go''.');
INSERT INTO "item_descriptions" VALUES(16333,'en','This Trophy emits little electric shocks to keep you active. You can use it on your abs, in your underwear or in an aquarium, if you like to watch fish float.');
INSERT INTO "item_descriptions" VALUES(16335,'en','You like to call yourself a nomad. Which is really just a nicer way of describing a coward.');
INSERT INTO "item_descriptions" VALUES(16336,'en','Perched high up in a tree, far from the fight, and armed only with a telescope, observers often play a decisive role in a battle. Most importantly, they are the first to be able to flee when they detect the battle is turning against their allies.');
INSERT INTO "item_descriptions" VALUES(16337,'en','Your friends salivate when they see you butcher but refuse to eat your delicious garlic soup. Strange.');
INSERT INTO "item_descriptions" VALUES(16338,'en','Your friends salivate when they see you butcher but refuse to eat your delicious garlic soup. Strange.');
INSERT INTO "item_descriptions" VALUES(16339,'en','Your friends salivate when they see you butcher but refuse to eat your delicious garlic soup. Strange.');
INSERT INTO "item_descriptions" VALUES(16343,'en','This rare paintbrush, made with Treechnidian wood and Moowolf hairs will help you entertain your friends.');
INSERT INTO "item_descriptions" VALUES(16500,'en','Now you can re-enact your favourite operas in the comfort of your own home!');
INSERT INTO "item_descriptions" VALUES(16501,'en','By wearing this cape, you can make the Incarnam Chafers think you''re their captain. Too bad they don''t have eyes to see it.');
INSERT INTO "item_descriptions" VALUES(16502,'en','Made from Chafer bone, this magnificent bracelet will protect your wrist from sword blows looking to cut it, all while building your muscles. A very valuable item for beginners like you.');
INSERT INTO "item_descriptions" VALUES(16503,'en','Thanks to the light coming from this headpiece, no one will be able to surprise you, which is a useful feature for walking around Incarnam in peace.');
INSERT INTO "item_descriptions" VALUES(16504,'en','If you haven''t got a lively spirit and a virtuous spirit, you can at least look like you do, thanks to these wings made from pure celestial matter.');
INSERT INTO "item_descriptions" VALUES(16505,'en','The legend says that this amulet contains the soul of a powerful magician who challenged Ecaflip to a game of celestial belote – the favourite card game of the Twelve – and won. If you wear it around your neck while playing cards, maybe he''ll make an appearance...');
INSERT INTO "item_descriptions" VALUES(16527,'en','You just have to hold this hammer to be overtaken by a sudden desire to break everything. There''s a reason Hargnok is called the Smasher...');
INSERT INTO "item_descriptions" VALUES(16541,'en','An indispensable tool for collecting minerals.');
INSERT INTO "item_descriptions" VALUES(16843,'en','This bag has long been popular in Incarnam. Lady adventurers find it as elegant as they do practical; gentleman adventurers use it to hold the detached teeth of their enemies.');
INSERT INTO "item_descriptions" VALUES(16953,'en','If you''re going to dig your own grave, you might as well use a shovel crafted by the Terra Cogita clan. At least that way you know you''ll get a first-class burial.');
INSERT INTO "item_descriptions" VALUES(17012,'en','Decorated with Crocodyl teeth as sharp as a Sword of Iop, this belt will make you look like a seasoned old hunter that you''d rather not mess with.');
INSERT INTO "item_descriptions" VALUES(17013,'en','"Tap dancing or butt kicking, the choice is yours!" You can finally say goodbye to this old dilemma, thanks to these marvelous boots that protect your feet without skipping a beat...ing.');
INSERT INTO "item_descriptions" VALUES(17023,'en','Bontarians are fond of the Bontick''s loyalty and devotion, although others find it a bit too clingy. Once it''s decided it likes you, you''ll be stuck together like glue and the bond it''s formed will be unbreakable, no matter how hard you try. You''ll never be alone, not even in the bathroom.');
INSERT INTO "item_descriptions" VALUES(17028,'en','Brakarinas are a real pain in the neck. After the extermination of Brakmar''s Vilinsekts, they spread like a plague through the houses. You''ll find them creepy crawling in your mattresses, carpets and household linens. Some Brakmarians like their cantankerous nature and keep them as pets.');
INSERT INTO "item_descriptions" VALUES(17078,'en','The Kanniballs claim that the Moon''s Tree is actually a sleeping dragon. The immortal being came down from the moon and took the form of a great Kokokonut tree to shade a princess from the blistering sun. Then he dozed off... So does that mean the Dokoko, fruit of the Moon''s Tree, is a genuine Dofus? The jury''s still out on that one.');
INSERT INTO "item_descriptions" VALUES(17079,'en','Preferring music to hunting, Kanniball Tams use a mask with white hair instead of black to distinguish themselves from other members of their tribe, which gives them style beyond compare.');
INSERT INTO "item_descriptions" VALUES(17092,'en','Moon found this magical hammer when he was captured by a Poacher pirate. In his hands, a single hammer strike to the ground is enough to cause an earthquake, which is especially handy when trying to shake down the Kokokonuts in the highest branches.');
INSERT INTO "item_descriptions" VALUES(17093,'en','This cloak is made from Kokoko Leaves and Citronanas, which explains its exotic colours and undeniable charm. Unfortunately, it emits a less charming odour that attracts every kind of wild animal imaginable, who take you for a giant, delicious banana.');
INSERT INTO "item_descriptions" VALUES(17094,'en','The Kanniballs fashioned this item with an image of Moon, who they consider the God-Monkey of the island. According to legend, it was a strike of the monkey hammer that gave it the shape of a crescent moon. At least, that''s what the employees at Charlie''s Agents tell travellers who come to spend their holidays on the island when they''re trying to extort a few kamas for the amulet.');
INSERT INTO "item_descriptions" VALUES(17095,'en','This sword''s formidable power can strike your enemies with lightning. Please note that for best results, this technique should be attempted during a storm, when the sword is held towards the sky and when your enemies are holding the blade.');
INSERT INTO "item_descriptions" VALUES(17096,'en','The rope of this belt is made with an extremely rare material that absorbs lightning bolts and retains their energy. It''s just the thing to protect you on stormy days when you can''t find anywhere to take shelter.');
INSERT INTO "item_descriptions" VALUES(17097,'en','Legend has it that whoever wears the ‘Circle of Lightning'' contained in this cloak will be able to control lightning. It might be nothing more than a legend, but it''s worth a shot!');
INSERT INTO "item_descriptions" VALUES(17098,'en','Ideal for disguising yourself as an old hermit, this beard will make you look like you''ve spent your whole life meditating in order to understand and master the mysteries of Pandawushu.');
INSERT INTO "item_descriptions" VALUES(17099,'en','Adjusted for a large waist, this solid belt will help you get around more easily and reduce your efforts if you''re carrying a few extra pounds. Conversely, you could always use it to tie up your most hefty enemies.');
INSERT INTO "item_descriptions" VALUES(17100,'en','It is said that this staff lets its owner locate nearby sources of alcohol. It may just be superstitious nonsense, but it can''t hurt to try!');
INSERT INTO "item_descriptions" VALUES(17103,'en','It is said that Voldelor locked up part of his soul in this amulet. Maybe Larry Poller knows more about it.');
INSERT INTO "item_descriptions" VALUES(17104,'en','This belt is a mark of membership in the Breatheater brotherhood. They say it''s what lets them digest all the gold they ingest.');
INSERT INTO "item_descriptions" VALUES(17105,'en','Voldelor hasn''t worn his boots since he learned to levitate. But he developed a weakness that fateful day: ticklishness.');
INSERT INTO "item_descriptions" VALUES(17106,'en','Though Kongoku hide makes a top-quality fabric, wearing this cloak could be particularly dangerous if you have an unfortunate run-in with an animal rights activist.');
INSERT INTO "item_descriptions" VALUES(17107,'en','This somewhat rebellious earring has an annoying tendency to change from the right ear to the left ear depending on which direction its wearer is looking.');
INSERT INTO "item_descriptions" VALUES(17108,'en','Actually, Kongoku wears this belt on his wrists, which speaks volumes about the monster''s girth.');
INSERT INTO "item_descriptions" VALUES(17109,'en','This cloak once belonged to LeChouque, the most famous pirate to have ever sailed the seas of Amakna if he does say so himself (and he does). They said that the pirate and his crew were doomed to live out their days as ghosts and skeletons after their ship fell victim to a mysterious curse.');
INSERT INTO "item_descriptions" VALUES(17110,'en','Much more chic than a plumed hat, this pirate hat will tell you where all sorts of treasure in hidden on the high seas of Amakna. Unfortunately, you''ll be the only one who can hear its voice, so everyone else will just think you''re not rowing with both oars, if you catch my drift.');
INSERT INTO "item_descriptions" VALUES(17111,'en','This magical wedding ring, which was found in an ancestral treasure, has the power to change the colour of its wearer''s pee. Too bad it''s not especially useful at sea...');
INSERT INTO "item_descriptions" VALUES(17119,'en','The Warrior of KOs wore this belt to show everyone he was the KO Champion. Now that it belongs to you, it''s your turn to show off!');
INSERT INTO "item_descriptions" VALUES(17120,'en','According to legend, this amulet is supposed to protect its wearer from all sorts of possible death scenarios. But considering what you did to its last owner, it''s probably just a false rumour.');
INSERT INTO "item_descriptions" VALUES(17121,'en','Crushing, squeezing, breaking, stamping, grinding... Those are just some of the things these boots are made for, besides walking.');
INSERT INTO "item_descriptions" VALUES(17213,'en','These size 2 waders were made for Ecaflips with small feet. Unless you share a shoe size with Kerub, they''ll make a lovely decoration for your living room.');
INSERT INTO "item_descriptions" VALUES(17214,'en','This marvellous piece of armour is an exact replica of the breeches worn by Kerub. It will stop any enemy weapons heading cruelly towards your intimate areas.');
INSERT INTO "item_descriptions" VALUES(17292,'en','These boots are the cause of your favourite team''s speediness, and are just as useful for racing to victory as fleeing from a thrashing.');
INSERT INTO "item_descriptions" VALUES(17293,'en','These racing boots are prickly as a rose and will help you cover great distances both horizontally and vertically, thanks to the spikes fastened securely to the front.');
INSERT INTO "item_descriptions" VALUES(17294,'en','‘It''s a bird... It''s a plane... No, it''s a Pamu!'' is the slogan that every loyal Pamus supporter yells when a member of their team scores.');
INSERT INTO "item_descriptions" VALUES(17295,'en','Running swifter than the swiftest wild animals, Zalblaks owe part of their fame to these splendid boots, made especially for racing.');
INSERT INTO "item_descriptions" VALUES(17300,'en','This belt, which bears a picture of the reward earned by the Gobbowl World Cup winners, will let you gloat excessively to the other teams'' supporters by giving you an air of superiority and snobbery.');
INSERT INTO "item_descriptions" VALUES(17301,'en','This belt, which protects its wearer''s intimate parts, was designed specifically for Redroz supporters, since they''re known for starting brawls in Gobbowl stadiums.');
INSERT INTO "item_descriptions" VALUES(17302,'en','This belt falls somewhere between a kilt and a championship belt. It has been worn by countless generations of Pamus supporters. Honour your team and be the next in line!');
INSERT INTO "item_descriptions" VALUES(17303,'en','These skin-tight shorts will make you look like a strong athlete with an untamed spirit, ready to jump on anything that moves. Just like a real Zalblak!');
INSERT INTO "item_descriptions" VALUES(17379,'en','The Groogler is one of the most curious animals in all the World of Twelve. Its bulging eyes and flat face give it a particularly ridiculous appearance, while its spiky crest and ample tail evoke a ferocious beast. So many contradictions in such a little creature...');
INSERT INTO "item_descriptions" VALUES(17448,'en','Emanating a chromatic light with sumptuous colours, this headdress reacts to its wearer''s power by modulating the intensity of its glow.');
INSERT INTO "item_descriptions" VALUES(17449,'en','Traditionally worn during ceremonies and journeys, this cape is imbued with a powerful magic that gives its wearer incredible charisma, a heroic attitude, and foolproof protection against the rain and mud chips.');
INSERT INTO "item_descriptions" VALUES(17450,'en','With these boots on your feet, you''ll always be first at everything, from going off on an adventure to fleeing from a fight.');
INSERT INTO "item_descriptions" VALUES(17451,'en','Created to catalyse the energy of the Quadramental Breeze, this belt is the first piece of the traditional Huppermage tunic to be created. The style and colours were largely inspired by Bonta''s, where its creator, The legendary Huppermage Ouatsonne, is from.');
INSERT INTO "item_descriptions" VALUES(17452,'en','Forged in Huppermage fire, this ring of power is full of mystery. Inside, there''s an inscription that reads: "Fire wets, water burns, and all piwis fly in the sky." What does it mean? Your guess is as good as anyone''s.');
INSERT INTO "item_descriptions" VALUES(17456,'en','You''ll be pining for these shoes once you realise how great they are.');
INSERT INTO "item_descriptions" VALUES(17457,'en','Whether you put this ring on your finger or on a Kwismas Tree, it''s the ideal accessory to be displayed during the festive season.');
INSERT INTO "item_descriptions" VALUES(17460,'en','This magic wand has an enchantment which lets it open a passage to the Dark Hornbeam Wood. It would be much more popular if it opened a passage to the tavern.');
INSERT INTO "item_descriptions" VALUES(17487,'en','Inspire terror among your adversaries by wearing this necklace in the form of a skull, the symbol of strength and brutality. If Khan does it, it must mean it works!');
INSERT INTO "item_descriptions" VALUES(17488,'en','Many Bontarians think that the Monarch''s beard is made of gold, but it''s really just his Torque riding up a bit.');
INSERT INTO "item_descriptions" VALUES(17495,'en','Avoid wearing these boots if you''re planning on trying out for a Gobbowl Ball team. You might end up flailing around lamentably.');
INSERT INTO "item_descriptions" VALUES(17496,'en','Gold like the sun, these shiny boots blind all the King''s loyal followers who kneel at his feet.');
INSERT INTO "item_descriptions" VALUES(17502,'en','Wearing these briefs won''t make you a Gobbowl champion, but they''ll sure show off your goods.');
INSERT INTO "item_descriptions" VALUES(17503,'en','If this belt is big, it''s only to contain all the extra weight the King of Bonta has put on during his reign. At least you won''t feel restricted in it!');
INSERT INTO "item_descriptions" VALUES(17504,'en','Worn as a necklace by very large beings, this torque is the main piece of Kerub''s armour, protecting his entire upper torso.');
INSERT INTO "item_descriptions" VALUES(17506,'en','As the King''s close guard, you must be prepared for any eventuality. Even getting hit in your sensitive bits.');
INSERT INTO "item_descriptions" VALUES(17507,'en','The wings on these boots are the symbol of the city you protect, but also a reminder of the Bonta guard''s oath: "Go, run, fly and flee."');
INSERT INTO "item_descriptions" VALUES(17508,'en','A very fashionable accessory, this necklace set with small gold-plated bones will be all the rage, especially if you go walking in the Sidimote Moors.');
INSERT INTO "item_descriptions" VALUES(17511,'en','Unfortunately, heartfelt kisses aren''t enough to keep your Minikron fed.');
INSERT INTO "item_descriptions" VALUES(17524,'en','This magnificent pair of boots will make you a wee bit smarter.');
INSERT INTO "item_descriptions" VALUES(17525,'en','This wonderful bouquet will show your beloved that you''re ready to brave a thousand and one dangers for their sweet little face.');
INSERT INTO "item_descriptions" VALUES(17572,'en','The clubs on these boots are scented, and can therefore be placed on the inside, in order to avoid certain unpleasant odours, or to be combined with said odours to create something unique and unpredictable.');
INSERT INTO "item_descriptions" VALUES(17573,'en','The few serious topics that reach the King Playa''s ears go over his head, and therefore arrive at this headpiece. Over time, it has thus become burdened with the weight of seriousness. This gravity may explain how the golden rings surrounding it are kept in place, but also why it doesn''t move when you do an about-turn.');
INSERT INTO "item_descriptions" VALUES(17574,'en','King Playa uses his Signet Ring to mark his victims. Now where could the wax that he uses for that come from...?');
INSERT INTO "item_descriptions" VALUES(17575,'en','These comfortable slippers leave impressive paw prints behind them. They must be handled with caution, as they can attract massive canine monsters such as Moowolves.');
INSERT INTO "item_descriptions" VALUES(17576,'en','Inside this pendant is a portrait of the person you love the most. In other words, yourself.');
INSERT INTO "item_descriptions" VALUES(17577,'en','There''s an inscription inside this cape:
"Whoever stole this cape must return it to me, and OFF WITH THEIR HEAD!
xoxo, your Queen."');
INSERT INTO "item_descriptions" VALUES(17578,'en','These boots were made specifically for moving between tiles. However, they''ll be of no use to you in a labyrinth, for example.');
INSERT INTO "item_descriptions" VALUES(17579,'en','This Helmet will make you look much more serious.');
INSERT INTO "item_descriptions" VALUES(17580,'en','A six-pack on your back not being of any real use, this cape can be used as an apron.');
INSERT INTO "item_descriptions" VALUES(17581,'en','Don''t forget to write your and your master''s names on this collar. If you get lost, it could prove necessary so you can be given back to the right person.');
INSERT INTO "item_descriptions" VALUES(17582,'en','If these gloves look like they have only enough room for three of your fingers, that actually is the case. All that''s left to do is curse the tailor who made them, or to cut off two of your fingers.');
INSERT INTO "item_descriptions" VALUES(17583,'en','Have you always dreamt of having four tails? Then here you go!');
INSERT INTO "item_descriptions" VALUES(17584,'en','This cape can be split in two. Each half can then be used as a semi-cape. Impressive, huh?');
INSERT INTO "item_descriptions" VALUES(17585,'en','These sandals are also used as slideskates, letting you slide across certain surfaces as if you were wearing nothing more than socks. Wearing socks with these sandals does not increase the sliding effect.');
INSERT INTO "item_descriptions" VALUES(17586,'en','These sabres are very sharp – so much so that if Atcham had any hair, he''d have a hard time holding them without slicing off his fur.');
INSERT INTO "item_descriptions" VALUES(17587,'en','There are few materials as resistant as the fabric used to make this collar, which will protect you from any sword blows that might be aimed at your neck...');
INSERT INTO "item_descriptions" VALUES(17588,'en','These boots are as comfortable as slippers when they''re on your feet, and as hard as rock when worn to protect certain more sensitive bits.');
INSERT INTO "item_descriptions" VALUES(17589,'en','Each of Ush''s swords represents a part of himself. This one represents his flamboyant side, so you''ll be leaving him with only his darker, serious side.');
INSERT INTO "item_descriptions" VALUES(17590,'en','With its tiger-striped motif, the Weremoggy Cape will let you scramble your opponent''s vision so completely they''ll be effectively blind.');
INSERT INTO "item_descriptions" VALUES(17591,'en','You thought you''d be able to blend in with the Weremoggies by wearing their symbol around your waist, but this cat''s head is actually used to mark their next target. Too bad for you.');
INSERT INTO "item_descriptions" VALUES(17592,'en','This ring has the strange characteristic of making its wearer''s phrases start with the phrase "Zounds!". However, it doesn''t seem to work on you. Maybe it''s just an old legend...');
INSERT INTO "item_descriptions" VALUES(17593,'en','When you walk with these boots, each step causes an annoying little metallic sound, as if they were made of steel.');
INSERT INTO "item_descriptions" VALUES(17594,'en','Like a champion''s belt, Colousses''s Belt shows the world which of you two won out in your battle against this immense creature.');
INSERT INTO "item_descriptions" VALUES(17595,'en','This scalp is created from hairs from Colousses''s skull, and it''s particularly hideous, but at least you''ll have some hair handy in case of any sudden baldness.');
INSERT INTO "item_descriptions" VALUES(17596,'en','Only an exceptional jeweller could have conceived such a marvel, made with unparalleled attention to detail and exceptional attention to minutia.');
INSERT INTO "item_descriptions" VALUES(17597,'en','Worn on a necklace, this Bytbul will bring you luck in the most disastrous situations.');
INSERT INTO "item_descriptions" VALUES(17598,'en','Give the Melouse a hiding and make yourself a Melcape!');
INSERT INTO "item_descriptions" VALUES(17627,'en','Don''t forget that in equipping this shield, you''re supporting science. Here''s hoping you don''t end up regretting it.');
INSERT INTO "item_descriptions" VALUES(17628,'en','What''s white, smells really bad, and keeps you warm in winter? No, it''s not a dead Wabbit wrapped around your neck. Will you ever stop saying silly things?');
INSERT INTO "item_descriptions" VALUES(17629,'en','The origin of the elastic green material covering this shield is very mysterious. The only thing we know is that the Goblins consider it sacred.');
INSERT INTO "item_descriptions" VALUES(17681,'en','Upon receiving, possibly painfully, an arrow from this bow, the message is obvious: someone''s spotted you.');
INSERT INTO "item_descriptions" VALUES(17682,'en','This sceptre would have made King Nidas lose his mind during a high-stakes card game.');
INSERT INTO "item_descriptions" VALUES(17683,'en','The three-die-face on this axe forms a passage between you and your victim, allowing for the exchange of material, sometimes living.');
INSERT INTO "item_descriptions" VALUES(17684,'en','With this device on your head, you''ll be able to see things that no one else can. And when they say that it causes hallucinations, well... you crossed that bridge a long time ago!');
INSERT INTO "item_descriptions" VALUES(17700,'en','More agile than a Tofu at dinner time, the Maulleycat surprises its prey with its extreme speed, which makes it an exceptional predator, and also uncatchable. It''s said that anyone that can tame the beast while naked will acquire its speed.');
INSERT INTO "item_descriptions" VALUES(17733,'en','The rockets installed on these boots can have two entirely different purposes: either they allow you to snatch a narrow victory thanks to the acceleration they provide, or they will transform your Dragoturkey into roast meat if you lose the race.');
INSERT INTO "item_descriptions" VALUES(17734,'en','In an accident, this belt will protect you from injuries just as much as a set of your briefs worn as a helmet would.');
INSERT INTO "item_descriptions" VALUES(17795,'en','Generally causing onomatopaeic spasms and hot flashes among lovers of cute things, Kerubabies are adorable little Kikitties raised in the Ecaflipus Dimension. Nobody knows if the magical aura that resides there is the reason they look like Kerub.');
INSERT INTO "item_descriptions" VALUES(17809,'en','It''s heresy to use this hammer for anything other than advancing science. Smashing enemies'' skulls can be classed in this category if it''s done with a scientific goal.');
INSERT INTO "item_descriptions" VALUES(17813,'en','Straight from the Depths of Sufokia, this Glub owes its name to the sounds it makes when you pull it out of an underwater cavity – its natural habitat. Its cuddly side and its funny shape make it Trituns'' best friend.');
INSERT INTO "item_descriptions" VALUES(17833,'en','Ratchams are often mistaken for rats, due to their tail, long ears and lack of bodily hair. But if you adopt one, you''ll soon find out how little this pawed predator has in common with a rodent. As cuddly as they come, it''ll lick your face, and you''ll discover that no, Ratchams are not completely lacking in hair.');
INSERT INTO "item_descriptions" VALUES(17849,'en','To make the most of summer, why not show off your feet? They''re just asking to get a tan!');
INSERT INTO "item_descriptions" VALUES(17961,'en','Deks has assured you that this helmet will allow you to resist the Resonance Crystals'' influence. You hope it''s effective: if you''re going to look this ridiculous, it had better not be for nought.');
INSERT INTO "item_descriptions" VALUES(17997,'en','Making a necklace out of a Crabtun Lantern is rather daring: the light might attract a certain type of person, and your skull probably isn''t strong enough to deal with it like a Crabtun does.');
INSERT INTO "item_descriptions" VALUES(17998,'en','This robust ring will leave quite an impression on anybody you hit with it.');
INSERT INTO "item_descriptions" VALUES(18000,'en','Furious insanity, masked madness, monstrous hallucinations... Some things would be better left in the abyss.');
INSERT INTO "item_descriptions" VALUES(18001,'en','Having a trashcan within arm''s reach to throw away anything you like seems interesting, and this pendant could effectively fill that role. However, it gets heavier with each item ingested, so you''ll have to work out your neck to keep wearing it.');
INSERT INTO "item_descriptions" VALUES(18002,'en','This cape sucks up water to inflate itself and thusly regains the shape of a globe-fish.');
INSERT INTO "item_descriptions" VALUES(18003,'en','Finding a name for these boots is really hard. So their name goes without saying.');
INSERT INTO "item_descriptions" VALUES(18004,'en','This amulet represents a simplified version of a Spookkoth. Not that you needed to be reminded of their appearance – you''re not likely to forget any time soon.
P.S.: The necklace is elastic.');
INSERT INTO "item_descriptions" VALUES(18005,'en','Don''t Mantaze me, bro!');
INSERT INTO "item_descriptions" VALUES(18006,'en','You might start to wonder why this loincloth has tentacles – don''t ask questions you don''t want to know the answers to.');
INSERT INTO "item_descriptions" VALUES(18007,'en','Underwater, these palms will make you feel like a fish in the water.');
INSERT INTO "item_descriptions" VALUES(18008,'en','It''s an interesting experiment, trying to come up with a description for an indescribable item. Some would opt for the easy and economic solution of not describing the item at all. But we''re better than that. If a wall of text must be written, so be it! Here we go. 
There''s a lot that you can say about what it means to be indescribable. It could have several meanings. It might mean that we don''t have the right words to describe the thing in question, because it''s completely unprecedented, because it''s unlike anything we''ve ever known, or maybe also because we don''t have the lexical knowledge necessary to choose the right words that will best express the indescribable nature of the thing. So we hide all this uncertainty behind phrases like, "You see?! It''s indescribable!", said with deep conviction. But is that really the end of the story? 
If we search deep inside, maybe an exact and appropriate description will reveal itself. Something sufficiently clear, and at the time sufficiently abstract to facilitate understanding of the described thing. If the words aren''t sufficient, maybe it''s necessary to invent new ones? Words coming from the heart. Words which speak for themselves when the limits of language have been reached. The indescribable, in the end, is actually an unknown, which requires only that we put forth the effort to understand it, to let your imagination, your reason, and your feelings intermingle in order to better understand and therefore find the words that could describe it.
But that would be too much work for a simple cape description.');
INSERT INTO "item_descriptions" VALUES(18009,'en','This belt didn''t belong to Meno – it was used to mark his prisoners.');
INSERT INTO "item_descriptions" VALUES(18010,'en','Formed from Tryde Tridents, this staff is used for fishing.');
INSERT INTO "item_descriptions" VALUES(18011,'en','Disquieting to look at, this wand will sow doubt in the minds of your opponents.');
INSERT INTO "item_descriptions" VALUES(18012,'en','The second in a long line of bows where an eye replaces the cord. Nobody really understands how it works, but it seems as if the arrows it fires come from another dimension.');
INSERT INTO "item_descriptions" VALUES(18013,'en','For those passionate about underwater treasure who just can''t stop themselves from digging up every possible spot in the hopes of finding something, this shovel-harpoon will help you defend yourself if you happen to accidentally unearth an unfriendly crustacean.');
INSERT INTO "item_descriptions" VALUES(18014,'en','Blessed with the natural abilities of a Mantaze, this axe uses electricity to augment its abilities.');
INSERT INTO "item_descriptions" VALUES(18015,'en','This sword strikes straight at the soul of your enemies.');
INSERT INTO "item_descriptions" VALUES(18017,'en','When they hit their target, these daggers let out a viscous and disquieting liquid, as if they were sucking it out of their victim''s body.');
INSERT INTO "item_descriptions" VALUES(18018,'en','This hammer was created to cause suffering. First, visually, with its appearance. It also generates sounds imitating a cheap plastic flute, which makes your ears suffer. And, of course, it can generate massive physical damage.');
INSERT INTO "item_descriptions" VALUES(18019,'en','With a Sashucker equipped, you''ll be ready to scale any wall. No need to hang on – you just need to press your adhesive hips against it. It also works on other living beings, but it''s generally viewed as harassment.');
INSERT INTO "item_descriptions" VALUES(18020,'en','Quite practical for walking underwater, these shoes will stick you to the ground, so long as you don''t lift both feet.');
INSERT INTO "item_descriptions" VALUES(18021,'en','Not as popular as Pol the Octopus''s Hat, the Octat doesn''t give the gift of clairvoyance. But it''s sure stylish.');
INSERT INTO "item_descriptions" VALUES(18022,'en','Why decide between pinching and kicking when you can do both at the same time?');
INSERT INTO "item_descriptions" VALUES(18023,'en','This hat, which comes with a respirator mask, will give you the genuine look of a genuine captain of a genuine sunken submarine.');
INSERT INTO "item_descriptions" VALUES(18024,'en','Although some might believe that the symbol on this cape indicates that a powerful sorcerer took possession of it, it''s really just Meno''s insignia.');
INSERT INTO "item_descriptions" VALUES(18025,'en','What is unspeakable cannot be said.');
INSERT INTO "item_descriptions" VALUES(18026,'en','What is unspeakable cannot be said.');
INSERT INTO "item_descriptions" VALUES(18028,'en','What is unspeakable cannot be said.');
INSERT INTO "item_descriptions" VALUES(18029,'en','This very elegant ring is the perfect engagement ring. For Trituns.');
INSERT INTO "item_descriptions" VALUES(18030,'en','If you ignore their colour, these boots are perfect for getting around underwater: they''re impermeable and assist in swimming.');
INSERT INTO "item_descriptions" VALUES(18031,'en','This mask won''t let you pass for a Tritun, sadly. But it will let you breathe underwater, so it''s got that going for it, which is nice.');
INSERT INTO "item_descriptions" VALUES(18032,'en','Two eyes are better than none, and two extra eyes are even better. They''ll make you look serious. Or annoyed. Or thoughtful.');
INSERT INTO "item_descriptions" VALUES(18033,'en','This belt sticks its tongue out when it''s too tight. So it will also let you know when it becomes time to do a sit-up or two.');
INSERT INTO "item_descriptions" VALUES(18034,'en','Wearing a Yoloinist Crab shell is very dangerous: they have a tendency to pinch similar things with all their strength to test them.');
INSERT INTO "item_descriptions" VALUES(18035,'en','This is the pendant you give to your loved ones to reassure them, and keep them from knowing the true nature of Koutoulou.');
INSERT INTO "item_descriptions" VALUES(18036,'en','This helmet will give you a look that''s completely normal and acceptable – for a lunatic.');
INSERT INTO "item_descriptions" VALUES(18037,'en','This ring constantly biting into your finger will remind you not to make stupid decisions. Like wearing this ring.');
INSERT INTO "item_descriptions" VALUES(18043,'en','According to official sources, this unusual-looking Dofus is a creation of the Foggernauts of Sufokia: it can therefore be concluded that it is not a real dragon egg. Well, that''s what the authorities would like us to believe... Anyway, who really knows what''s hiding in the abysses?');
INSERT INTO "item_descriptions" VALUES(1018088,'en','A ridiculous giant Borbat, the Skrot is an unfailingly faithful mount. Its love for you will manifest itself in many ways: sometimes it will lick you from head to toe, and it won''t hesitate to swallow and suck on the former! Never has such an affectionate animal been seen, so long as it doesn''t take you for its next snack...');
INSERT INTO "item_descriptions" VALUES(18145,'en','This hat is invisible in the dark, in the same way that light is.');
INSERT INTO "item_descriptions" VALUES(18146,'en','This cloak is invisible in the dark, in the same way that light is.');
INSERT INTO "item_descriptions" VALUES(18229,'en','As the swimsuit version was too risky, you opted for this belt to force you to keep an eye on your waistline, and thus keep a flat stomach.');
INSERT INTO "item_descriptions" VALUES(18230,'en','Created by a witch of questionable morals, this amulet can tighten on command. Weirdly, the witch was never short of volunteers to wear it.');
INSERT INTO "item_descriptions" VALUES(18279,'en','The wand points towards the north of the Castuc Territory.');
INSERT INTO "item_descriptions" VALUES(18290,'en','A tool of advanced technology which should allow you to confront a storm.');
INSERT INTO "item_descriptions" VALUES(18350,'en','These gloves are disposable after use, due to their side effects on the skin, caused by the synthetic material they''re made from.');
INSERT INTO "item_descriptions" VALUES(18375,'en','You just need to bless this wand, then go off in search of Nonexistent Water.');
INSERT INTO "item_descriptions" VALUES(18423,'en','If you''re looking for a way to camouflage yourself in the desert, this cape could prove useful.');
INSERT INTO "item_descriptions" VALUES(18424,'en','This ring suddenly starts to shine in extreme heat, which can warn you about dramatic incidents if ever you don''t realise on your own.');
INSERT INTO "item_descriptions" VALUES(18425,'en','Essential for walking on the hot sand without damaging the arch of your foot, these boots will also prevent you from sinking into quicksand.');
INSERT INTO "item_descriptions" VALUES(18426,'en','If fur isn''t necessarily the most highly recommended clothing for an arid environment, Fennex fur actually protects you from external heat.');
INSERT INTO "item_descriptions" VALUES(18427,'en','Using Fennex tails to make quilts... that''s right.');
INSERT INTO "item_descriptions" VALUES(18428,'en','"But it''s hot!" – at least you have that excuse.');
INSERT INTO "item_descriptions" VALUES(18429,'en','The objective here is not to slice; a mere pinprick is already dangerous enough.');
INSERT INTO "item_descriptions" VALUES(18430,'en','Sometimes, there''s no point in being subtle.');
INSERT INTO "item_descriptions" VALUES(18431,'en','This cape can by equipped in two ways: one being recommended for anyone who isn''t a Sacrier.');
INSERT INTO "item_descriptions" VALUES(18432,'en','One might be tempted to knock you on the head, given the shape of this helmet... that''s where the thorns come in handy.');
INSERT INTO "item_descriptions" VALUES(18433,'en','Wearing this belt isn''t easy – nor is removing it.');
INSERT INTO "item_descriptions" VALUES(18434,'en','Who''s never dreamed wearing this type of sombrero, at least for a few seconds?');
INSERT INTO "item_descriptions" VALUES(18435,'en','It''s better to have small fingers for this ring to be comfortable, even if abrupt gestures aren''t advised.');
INSERT INTO "item_descriptions" VALUES(18436,'en','This lucky cactus lives off the water in your body.');
INSERT INTO "item_descriptions" VALUES(18437,'en','This daggers cut, prick, tear and stun. You just have the predicament of choosing.');
INSERT INTO "item_descriptions" VALUES(18438,'en','Are you a musician at heart? This sabre will add a sound atmosphere to your choreography of combat.');
INSERT INTO "item_descriptions" VALUES(18439,'en','In bright weather, this headset will blind your opponents by reflecting the sun''s rays.
In cloudy weather, it''ll blind them all the same, because that''s how this bright gold works.');
INSERT INTO "item_descriptions" VALUES(18529,'en','This belt won''t be enough to turn you into a brave little tailor capable of defeating seven giant Moskitos in one fell swoop, nor will it allow you to capture Unikrons.');
INSERT INTO "item_descriptions" VALUES(18530,'en','With your little feet protected from the cold, you''re now ready to face the long winter evenings slouched in front of the fireplace.');
INSERT INTO "item_descriptions" VALUES(18584,'en','Once this hat is on your head, its fangs sink into your flesh to prevent it from flying off at the slightest gust of wind. You don''t care that it''s sucking up your cerebral matter, since it was of no use to you anyway.');
INSERT INTO "item_descriptions" VALUES(18585,'en','Its appearance makes it more effective for fending off suitors than a chastity belt.');
INSERT INTO "item_descriptions" VALUES(18586,'en','The merchant who sold you this necklace assured you it was harmless. Yet, you have the unpleasant sensation that it''s about to stick its fangs into your neck at any moment.');
INSERT INTO "item_descriptions" VALUES(18587,'en','Nicknamed the jaws of the sands, these boots are worn only by the boldest nomads and Iops.');
INSERT INTO "item_descriptions" VALUES(18588,'en','This cape is still alive and ready to bite anyone who dares caress it, which makes it very popular among celebrities who hate mingling with the crowds.');
INSERT INTO "item_descriptions" VALUES(18589,'en','Because this ring is permeated with the personality of the Wurmlord, it pushes its owner to wear it in other places than on a finger.');
INSERT INTO "item_descriptions" VALUES(18590,'en','Monday in the sun is something people around you will never see, because they''ll be so dazzled by the brilliance of your headgear.');
INSERT INTO "item_descriptions" VALUES(18591,'en','Ambitious Enutrofs have led great conquests with the sole purpose of getting a head of hair as thick as this.');
INSERT INTO "item_descriptions" VALUES(18592,'en','Tal Kasha couldn''t stand people walking on her feet, which is why her sandals have evolved to look like this.');
INSERT INTO "item_descriptions" VALUES(18593,'en','These boots are designed to produce a metallic rattling noise with every step. The shrill sound that results from walking on the stone floor of the pyramid is amplified by the resonance of the vast corridors. This leads us to believe that like Astrubians, Mumystics like to be the centre of attention.');
INSERT INTO "item_descriptions" VALUES(18594,'en','Legend gives this ring strange powers, like the ability to turn on itself without intervention from its wearer.');
INSERT INTO "item_descriptions" VALUES(18595,'en','This solid gold torque is essentially used to flaunt one''s wealth to everyone.');
INSERT INTO "item_descriptions" VALUES(18596,'en','Since he''s getting senile with old age, Moum-Ra regularly loses his hood, which forces him to steal them from other Mumystics.');
INSERT INTO "item_descriptions" VALUES(18597,'en','According a recent study, the symbol on this cape is a one-legged gnome with his arms spread wide.');
INSERT INTO "item_descriptions" VALUES(18598,'en','Anyone who has already faced a Sneerena knows that this loincloth delineates the healthy part from the atrophied part of the monster. Since you wear it around your waist, everyone knows what to expect.');
INSERT INTO "item_descriptions" VALUES(18599,'en','This snake''s garnet eyes can hypnotise an Enutrof for hours on end.');
INSERT INTO "item_descriptions" VALUES(18601,'en','Whoever christened this ring was no more inspired than whoever was responsible for describing it to the common man.');
INSERT INTO "item_descriptions" VALUES(18604,'en','Originally, this weapon''s crystals were white, but they became engorged with the blood of the people that its wearer guided with the Heqaxe.');
INSERT INTO "item_descriptions" VALUES(18615,'en','This ring is given to young Ouginaks so that they lick their paws instead of chewing their claws.');
INSERT INTO "item_descriptions" VALUES(18616,'en','Ouginaks form a big pack, until conflicts eat away at it from the inside. The pack ends up breaking apart into several independent tribes that never stop mad dogging each other.');
INSERT INTO "item_descriptions" VALUES(18617,'en','This is the favourite cape of Ouginak exhibitionists who like to surreptitiously show their pelt off to strangers.');
INSERT INTO "item_descriptions" VALUES(18621,'en','It''s said that once they''re decked out in this hat, some old Ouginaks can predict changes in the weather – in the next ten seconds.');
INSERT INTO "item_descriptions" VALUES(18622,'en','Used as a whip, this belt can make you scream with pleasure – whether you''re the whipper or the whippee.');
INSERT INTO "item_descriptions" VALUES(18626,'en','If in some dreadfully unfortunate circumstance, someone were to push granny into a bunch of cacti, don''t worry! Dauge won''t hesitate for a second before helping her and becoming the sole beneficiary of her will.');
INSERT INTO "item_descriptions" VALUES(18639,'en','Like all Bow Wows, you now have the right to wag your tail in public without worrying about reprisals from the vice squad.');
INSERT INTO "item_descriptions" VALUES(18640,'en','"Did you see that bo...?" Such were the last words of Patsy VeDross the Iop to her friend Jon Drumpf while visiting the Ouginak Temple. Nobody ever figured out if she was talking about the big bone that she had just noticed, or the watchdog guarding it.');
INSERT INTO "item_descriptions" VALUES(18659,'en','This porous but absorbent yellow shield was made from the remains of a creature who used to live in a Pineapi Mask at the bottom of the sea.');
INSERT INTO "item_descriptions" VALUES(18660,'en','This shield is a replica of the trophy given to the winners of the famous Dragoturkey race. It''s not as prestigious as the original, of course, but if it stops you from getting sliced in two by an anonymous madman, who are you to complain?');
INSERT INTO "item_descriptions" VALUES(18661,'en','Looking to fend off a frenzied attack? This shield from the village of Aerdala should do the trick.');
INSERT INTO "item_descriptions" VALUES(18662,'en','Looking to fend off a frenzied attack? This shield from the village of Feudala should do the trick.');
INSERT INTO "item_descriptions" VALUES(18663,'en','Looking to fend off a frenzied attack? This shield from the village of Terrdala should do the trick.');
INSERT INTO "item_descriptions" VALUES(18664,'en','This stone shield is, in fact, made from a Crackler''s head, smashed by the foot of a Minotoror. A perfect combination of big head and smelly feet.');
INSERT INTO "item_descriptions" VALUES(18665,'en','This shield is a tribute to Bowisse''s Cloak, which itself was a tribute to a famous relic composed of three triangular shapes. Blimey, all this history is putting me to sleep.');
INSERT INTO "item_descriptions" VALUES(18666,'en','Although it''s all but useless, its stench alone will spread your fame far and wide. This shield accompanies many young adventurers on their first quests – maybe that''s why so few make it to thirty.');
INSERT INTO "item_descriptions" VALUES(18667,'en','LeChouque used this shield to protect himself from the big cannonballs his friends regularly tossed to him. Some crazy stories tell that some of those balls were even alive.');
INSERT INTO "item_descriptions" VALUES(18668,'en','As strange as it might sound, some say this shield of wood and hair enables the lightest adventurers to become airborne for a brief moment... a final attempt to shock their enemies before falling flat on their faces.');
INSERT INTO "item_descriptions" VALUES(18669,'en','This huge shield once saved the famous adventurer Kloome from an awful death squashed under the weight of a Crackler who had fallen in love with him. The legend doesn''t say if he survived the side effects of his passionate romance with the Crackler.');
INSERT INTO "item_descriptions" VALUES(18670,'en','A young adventurer dreamed of enrolling in Bonta''s militia to defend the oppressed. Although he was refused for being too weak, he was contacted by an alchemist in Amakna who was determined to use him as a guinea pig to test one of his new magic potions. The effect was immediate, and the young adventurer quickly turned into a real warrior, becoming incredibly strong... and incredibly stupid. In short, he became a Iop. This reputedly indestructible shield was forged for him, and he would forevermore be known as Captain Amakna (after the famous Captain Chafer who disappeared in very mysterious circumstances).');
INSERT INTO "item_descriptions" VALUES(18671,'en','This skin shield will fit you like a glove. Don''t forget to treat its warts and furuncles from time to time to prevent them from getting worn.');
INSERT INTO "item_descriptions" VALUES(18672,'en','Not all Wabbits are nice little creatures. In fact, all Wabbits are vile creatures. Some get their kicks by smashing up Cawwots with this huge shield and taking baths in the juice.');
INSERT INTO "item_descriptions" VALUES(18673,'en','A renowned adventurer and collector spent his whole life looking for all four quarters of this shield. Some say that when the shield is complete, it has the exact opposite effect of that of breaking a mirror.');
INSERT INTO "item_descriptions" VALUES(18674,'en','If your dearest dream is to become a real imp, this is the shield you need. Passed down from generation to generation, it will let you rob all the young Astrubian adventurers you like without getting hurt.');
INSERT INTO "item_descriptions" VALUES(18675,'en','Greenish and smelly, this shield remains a first choice for protection when it comes to fighting the creatures of green and smelly Mount Stinkky.');
INSERT INTO "item_descriptions" VALUES(18676,'en','This shield used to protect lumberjacks from falling trees. Its function quickly changed, and now it is more often used to protect warriors from enemies who tend to land on them without warning!');
INSERT INTO "item_descriptions" VALUES(18677,'en','This shield will protect you from rain and slobber, and will also give your opponents plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(18678,'en','This shield will protect you from stone-throwing, mud-slinging, and will give your opponents plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(18679,'en','This shield will protect you from the winds of your opponents, and will give them plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(18680,'en','This shield will protect you from meteorites and fire-breathers, as well as giving your opponents plenty of time... Time to make their last wishes that is!');
INSERT INTO "item_descriptions" VALUES(18681,'en','Perfect if you want to fit in on Pandala, or to stand out anywhere else! The biggest advantage of this shield is that it''s entirely covered with hypoallergenic Pandawa hair. Now you don''t need to pack your underwear and your armour in separate suitcases when you go on holiday.');
INSERT INTO "item_descriptions" VALUES(18682,'en','When you''re hidden behind this shield, some naive adventurers could mistake you for a Treechnid and run off screaming. Most will attack all the more eagerly, thinking they can get some amber out of you.');
INSERT INTO "item_descriptions" VALUES(18683,'en','This magnificent shield contains a few drops from the Asse Sea. Not only does it bring good luck, but it can also be used as a flask.');
INSERT INTO "item_descriptions" VALUES(18684,'en','This strange-looking shield is covered with used underpants that once belonged to a Chafer – certainly the best way show your opponents that you intend to beat the pants off of them.');
INSERT INTO "item_descriptions" VALUES(18685,'en','Sadidas originally used this shield as a stool when they needed to rest. If you fold the feet in, it will protect you from a wide range of attacks. Nothing will protect you from the cruel laughter of your opponents, however.');
INSERT INTO "item_descriptions" VALUES(18686,'en','When your allies run out of breath, or when you want to clear the air after an unexpected Wind of Panic, this shield can save your life. The only thing you need to do is to shake it energetically in all directions, like you''d do with a hungry baby.');
INSERT INTO "item_descriptions" VALUES(18687,'en','Looking to fend off a frenzied attack? This shield from the village of Akwadala should do the trick.');
INSERT INTO "item_descriptions" VALUES(18688,'en','The Innkeeper at the Feubuk Brewery in Bonta was bored to death one day, when he suddenly got the idea of equipping his bouncers with neon advertising shields.');
INSERT INTO "item_descriptions" VALUES(18689,'en','This shield is covered with peepers to allow you to give one of those devastating multi-evil-eyes. Unstoppable.');
INSERT INTO "item_descriptions" VALUES(18690,'en','This shield will remind your opponents you grew up in the Sidimote Moors. That alone could be enough to scare them away.');
INSERT INTO "item_descriptions" VALUES(18691,'en','This shield protects you from taxes and from having to share your riches.');
INSERT INTO "item_descriptions" VALUES(18692,'en','This shield only works if you''re facing the sun, and then its giant gemstone will let you blind your enemies. Does not work against zombie pumpkins or any other blind but dangerous creatures.');
INSERT INTO "item_descriptions" VALUES(18693,'en','Used by Brouce Boulgoure himself when he was looking for a Rescue Board.');
INSERT INTO "item_descriptions" VALUES(18694,'en','Every rose has its thorns. And this does too.');
INSERT INTO "item_descriptions" VALUES(18695,'en','This giant Cawwot slice can absorb numerous magic attacks, but won''t hold up for long against nibbling Wabbits.');
INSERT INTO "item_descriptions" VALUES(18696,'en','If this amber breaks in combat, it''s likely the villainous Arachnee that''s been locked inside for fifty-three years will try to bite you.');
INSERT INTO "item_descriptions" VALUES(18697,'en','This shield could have helped you travel back in time if it wasn''t missing its time-travel system.');
INSERT INTO "item_descriptions" VALUES(18698,'en','This shield is a good pick to keep you from becoming a skeleton.');
INSERT INTO "item_descriptions" VALUES(18699,'en','This shield can resist any attack except, apparently, whatever weapon was used to kill the poor creature that thought it was protected by this shell.');
INSERT INTO "item_descriptions" VALUES(18700,'en','Four''s a good number. A lot of things come in fours: seasons, doors, tops, lokos, squares... Most say the elements do too, but some rumours say there''s a fifth one.');
INSERT INTO "item_descriptions" VALUES(18701,'en','This shield is made of a very fragile mirror. It won''t protect you against much of anything at all, but if your opponent breaks it, you can be sure they''ll suffer seven years bad luck. Or at least, that''s what you can tell yourself after your humiliating defeat.');
INSERT INTO "item_descriptions" VALUES(18702,'en','Designed to protect the skull, this hat was used as a shield by an adventurer who was hard-headed enough that he didn''t need extra protection.');
INSERT INTO "item_descriptions" VALUES(18703,'en','When it''s warm, this shield opens and a smelly juice leaks out. Nature in all its splendour.');
INSERT INTO "item_descriptions" VALUES(18709,'en','You can use this shield''s propeller to mess up your enemy''s hair and get in an attack of opportunity while they''re fixing it.');
INSERT INTO "item_descriptions" VALUES(18710,'en','This is the Chafer Foot Soldier''s last line of defence against getting his bones rattled in a fight.');
INSERT INTO "item_descriptions" VALUES(18711,'en','Don''t pretend like you understand what the artisan wanted to express with this work.');
INSERT INTO "item_descriptions" VALUES(18712,'en','Unfortunately, this shield doesn''t taste like honey, just imminent defeat.');
INSERT INTO "item_descriptions" VALUES(18713,'en','The shape of this shield makes it easier for you to collect Crocodyl tears from your enemies after their defeat.');
INSERT INTO "item_descriptions" VALUES(18714,'en','You''ll have to hold tight to this shield because it will always try to turn towards the sun.');
INSERT INTO "item_descriptions" VALUES(18715,'en','This shield was designed to be carried on the back. Some use it because they need to protect their backsides while fighting, and others use it because they''ll turn tail and run at the first sign of trouble.');
INSERT INTO "item_descriptions" VALUES(18718,'en','This shield was designed by Harry Stottel. While it might not help you avoid certain death, it will make your silhouette much curvier.');
INSERT INTO "item_descriptions" VALUES(18774,'en','Among all Count Razof''s trophies, the Boar whose remains embellish this belt hold a special place in his heart: it was his first victim. It was a very aggressive Boar that was threatening farmers near Bonta.');
INSERT INTO "item_descriptions" VALUES(18775,'en','The Hunters who arrived on Mishell Island weren''t expecting such a show. Some even overdosed on all the colours and had to leave early. As for Count Razof, he got so accustomed to all the lively colours that he even went as far as incorporating them into his own wardrobe.');
INSERT INTO "item_descriptions" VALUES(18776,'en','This helmet protects the Count from getting his bell rung.');
INSERT INTO "item_descriptions" VALUES(18777,'en','This cape symbolises the madness of the Chassulliers, prisoners to their passion for hunting.');
INSERT INTO "item_descriptions" VALUES(18778,'en','Licking these boots will drastically increase your saliva production, giving you more than enough spit to shine your shoes, clean countless children''s faces, and do a lot whatever else you might normally use spit for.');
INSERT INTO "item_descriptions" VALUES(18779,'en','Since the Chassulliers aren''t really sensitive, they slip this ring on just before dealing the final blow to their prey.');
INSERT INTO "item_descriptions" VALUES(18780,'en','Hunderps are into a different sort of cleavage...');
INSERT INTO "item_descriptions" VALUES(18808,'en','This belt is used as part of many diets, due to its ability to burn fat without its wearer lifting so much as a finger.');
INSERT INTO "item_descriptions" VALUES(18853,'en','Thanks to this sword, you won''t need a torch or campfire any more. Simply roast your meat and treats by impaling them!');
INSERT INTO "item_descriptions" VALUES(1019044,'en','Its atrocious personality is inexcusable, but you can''t help but forgive and kiss it every time it does something stupid.');
INSERT INTO "item_descriptions" VALUES(19075,'en','What would a vampire be without their measure of masked balls? The one in Forfut seems to be going on a little longer than usual: Anerice has refused to take her mask off for several years now.');
INSERT INTO "item_descriptions" VALUES(19076,'en','Due to the fact it looks like a Prespic, when wearing this cloak, you may have a little more difficulty finding travelling companions.');
INSERT INTO "item_descriptions" VALUES(19077,'en','Some ghouls, in a flurry of clarity, suddenly start attacking their masters. Anerice originally designed this shield to defend herself in this kind of situation, but it never really worked; she just ends up stunning them with it.');
INSERT INTO "item_descriptions" VALUES(19078,'en','This ring sticks out its tongue when you''re hungry. In other terms, it always sticks its tongue out.');
INSERT INTO "item_descriptions" VALUES(19079,'en','Specially designed to give you that oh-so-desirable Ghoul limp!');
INSERT INTO "item_descriptions" VALUES(19080,'en','This shield once belonged to one General de Ghoul. He was a valiant ghoul who prepared a secret rebellion against the vampires, but who had a hard time finding allies among his peers. Eventually, one eighteenth of Junssidor, he went into action alone: the most notable thing he did was throwing a shovel at a vampire.
Even if he didn''t have much of an impact, this event is still foremost in the minds of the ghouls, who will never forget it and still today talk of the heroic actions General de Ghoul and his shovel on that eighteenth of Junssidor.');
INSERT INTO "item_descriptions" VALUES(19081,'en','Scurvions may be among the best-armed monsters, but paradoxically, this helmet gives you everything you need to defend yourself where they cannot: on your head.');
INSERT INTO "item_descriptions" VALUES(19082,'en','This cloak has settled on your back, which explains its colour.');
INSERT INTO "item_descriptions" VALUES(19083,'en','Some intellectuals regularly get together to classify venoms depending on how dangerous they are: ranging from "slightly deadly" to "agonisingly deadly". To do so, they work off the density of ghosts present around the various venoms'' sources. According to this data, Scurvion Venom is expected to make one "mildly dead". Wearing this amulet can mean one of two things: either you have little use for it, or you will soon understand the meaning of this classification system.');
INSERT INTO "item_descriptions" VALUES(19084,'en','This shield''s resemblance to Captain Amakna''s ends at its appearance: optical illusions do have their limits.');
INSERT INTO "item_descriptions" VALUES(19085,'en','These boots will allow you to find out one of Cauldini''s best-kept secrets: it''s not his boots that make him levitate. You can probably "boot" that information, for all it''s worth.');
INSERT INTO "item_descriptions" VALUES(19086,'en','By wearing this mask, you''ll look strangely like a rodent. Goes to show that magic can really make things prettier!');
INSERT INTO "item_descriptions" VALUES(19087,'en','For some people, it''s not the costume that makes the man. This saying doesn''t really apply to the Riktus.');
INSERT INTO "item_descriptions" VALUES(19088,'en','As acrobats, the Riktus know that a cloak can sometimes be a deadly disadvantage. But some people still can''t do without one, so they shorten it as much as possible in order to limit the risks involved.');
INSERT INTO "item_descriptions" VALUES(19089,'en','Riktus – how to endlessly amuse other people and yourself: that''s your belief.');
INSERT INTO "item_descriptions" VALUES(19090,'en','Don''t take its nonchalant style and empty gaze at face value: the Boowoldlum makes them all crack up, whether it''s a Boowonoké or your ribs.');
INSERT INTO "item_descriptions" VALUES(19091,'en','Regardless of how other people look at you, regardless of their prejudices, you can make the choice of wearing this Boowoldlum fur as a sign of rebelliousness: being ridiculed only makes you stronger. Possibly.');
INSERT INTO "item_descriptions" VALUES(19092,'en','An entire ecosystem seems to have grown around this hair, so take care of it!');
INSERT INTO "item_descriptions" VALUES(19093,'en','In Forfut, there are ghouls by the shovelful.');
INSERT INTO "item_descriptions" VALUES(19096,'en','If a ghoul starts asking themselves existential questions, they will be hit over the head with this hammer until they return to their habitual state.');
INSERT INTO "item_descriptions" VALUES(19105,'en','This sword''s creation sits somewhere between the invention of fire and modern torches.');
INSERT INTO "item_descriptions" VALUES(19116,'en','This shield won''t protect you from ridicule.');
INSERT INTO "item_descriptions" VALUES(19139,'en','Thing is a hand that can think, write and act by itself. It''s a very obliging creature. It''s believed that it once worked for the prestigious Dadums family from Forfut. However, they used this hand in ways we wouldn''t want to mention in polite company, and it was eventually driven to run away and find a less twisted owner. It happened to find you, and there''s a good chance you won''t be much better than the Dadums family. Thing''s destiny is nothing if not tragic.');
INSERT INTO "item_descriptions" VALUES(19165,'en','The reason this item resembles the Kwismas Nightmare Mask is because it was made by the same artisan: Jack the Sram. Sneaky skeleton, eccentric Frigostian and unlucky joker... Jack had many faces. That could explain the exceptional power held by these death masks: that of allowing a living being to enter the kingdom of the dead.');
INSERT INTO "item_descriptions" VALUES(19241,'en','This amulet symbolises courage and bravery. At least, that''s what some intellectuals think.');
INSERT INTO "item_descriptions" VALUES(19242,'en','These stone boots are perfect in combat, as long as your legs are strong enough to lift them.');
INSERT INTO "item_descriptions" VALUES(19243,'en','This cape has a kind of integrated belt. You can use it to tie it to your waist at any time, to prevent enemies from grabbing it and slowing you down.');
INSERT INTO "item_descriptions" VALUES(19244,'en','This amulet symbolises courage and bravery. At least, that''s what some intellectuals think.');
INSERT INTO "item_descriptions" VALUES(19245,'en','These stone boots are perfect in combat, as long as your legs are strong enough to lift them.');
INSERT INTO "item_descriptions" VALUES(19246,'en','This cape has a kind of integrated belt. You can use it to tie it to your waist at any time, to prevent enemies from grabbing it and slowing you down.');
INSERT INTO "item_descriptions" VALUES(19247,'en','Have these wings been strategically placed to send you some sort of message? Now all you have to do is figure it out.');
INSERT INTO "item_descriptions" VALUES(19248,'en','Sometimes you can find out who someone is just by looking at their shoes. So, what do these ones say?');
INSERT INTO "item_descriptions" VALUES(19249,'en','If you don''t already know what you''re wearing next Karnaval, here''s an interesting idea.');
INSERT INTO "item_descriptions" VALUES(19250,'en','Have these wings been strategically placed to send you some sort of message? Now all you have to do is figure it out.');
INSERT INTO "item_descriptions" VALUES(19251,'en','Sometimes you can find out who someone is just by looking at their shoes. So, what do these ones say?');
INSERT INTO "item_descriptions" VALUES(19252,'en','If you don''t already know what you''re wearing next Karnaval, here''s an interesting idea.');
INSERT INTO "item_descriptions" VALUES(19253,'en','This discreet and lightweight cape is perfect for your spying missions, especially when you have to hide in the snow.');
INSERT INTO "item_descriptions" VALUES(19254,'en','This hood preserves your anonymity so you can steal from the rich to give to the poor, without any of that pesky glory.');
INSERT INTO "item_descriptions" VALUES(19255,'en','This amulet is normally worn by Bonta''s spies. But anybody can own one. If not, they would be too easy to spot.');
INSERT INTO "item_descriptions" VALUES(19256,'en','This discreet and lightweight cape is perfect for your spying missions, especially when you have to hide in the dark.');
INSERT INTO "item_descriptions" VALUES(19257,'en','This hood preserves your anonymity so you can steal from the poor to give to the rich, without any of that pesky glory.');
INSERT INTO "item_descriptions" VALUES(19258,'en','This amulet is normally worn by Brakmar''s spies. But anybody can own one. If not, they would be too easy to spot.');
INSERT INTO "item_descriptions" VALUES(19259,'en','Having been under threat of destruction many a time, the White City is always in need of warriors, priests and spies to protect it. Behind this shield hides one of these Bontarians, who''s potentially willing to risk their life for their city.');
INSERT INTO "item_descriptions" VALUES(19260,'en','Sometimes destroyed, sometimes rebuilt, the Black City is always in need of warriors, priests and spies to protect it. Behind this shield hides one of these Brakmarians, who''s potentially willing to risk their life for their city.');
INSERT INTO "item_descriptions" VALUES(19261,'en','It is said that this amulet harnesses a small amount of the Opaline Dofus''s power. That''s an awfully good selling point!');
INSERT INTO "item_descriptions" VALUES(19262,'en','Ilyzaelle is so charismatic that some knights have offered to serve her personally. This is particularly the case for the unsung knights of the Doziak: the best of them wore a golden armour of their own making to imitate that of Ilyzaelle, so the story goes.');
INSERT INTO "item_descriptions" VALUES(19263,'en','The artisan who forged this shield seems to have encrusted a single opal in place of the Dofus of Kings.');
INSERT INTO "item_descriptions" VALUES(19264,'en','Did you know that Soul-Blazes try to possess mortal bodies? Probably not, or you wouldn''t be wearing a Soul-Blaze Wedding Ring.');
INSERT INTO "item_descriptions" VALUES(19265,'en','Since they couldn''t possess your body, two Soul-Blazes decided to possess these shoes instead. They seem happy.');
INSERT INTO "item_descriptions" VALUES(19266,'en','It''ll take a lot more than that to look as threatening as a Soul-Blaze, but it''s a good start.');
INSERT INTO "item_descriptions" VALUES(19267,'en','If you don''t really know how to use a spear, you could always use it like a staff.');
INSERT INTO "item_descriptions" VALUES(19268,'en','Ilyzaelle rarely gets these daggers out in combat. She prefers to use them like actual knives.');
INSERT INTO "item_descriptions" VALUES(19269,'en','It looks like a Skoul has possessed this sword. It''s therefore recommended that you take care when using it, and wear gloves so you don''t touch the Soul-Blaze.');
INSERT INTO "item_descriptions" VALUES(19270,'en','Corrupted by energies originating from Externam, this bow is linked to the kingdom of the dead. So, if one of its arrows hits its target, that''s where they''re headed!');
INSERT INTO "item_descriptions" VALUES(1019286,'en','Gobbalator has been training for war since he was a nipper. He can open a can of beer or a Brakmarian''s head with his teeth alone.');
INSERT INTO "item_descriptions" VALUES(1019291,'en','Gobbalux has been training for war since he was a nipper. He can skewer barbecued meat or a Bontarian''s forehead with just a jab of his horns.');
INSERT INTO "item_descriptions" VALUES(19398,'en','Despite its somewhat unusual appearance, this Dofus is a genuine dragon egg; it would be a shame to hock it for a few nails. It will keep warm you during the long winter nights, and let you to organise barbecues in the summer. In any case, avoid going too close to haystacks or bundles of kindling with it; otherwise, you could be mistaken for a dangerous arsonist.');
INSERT INTO "item_descriptions" VALUES(19415,'en','These gloves have been made to take precise samples; they aren''t suitable for combat.');
INSERT INTO "item_descriptions" VALUES(19482,'en','This sword forged by the divine hammer of Gobannus allows you to use the power of Necronyx to petrify the Veriun Dead.');
INSERT INTO "item_descriptions" VALUES(19531,'en','From the volcanoes of Sidimote, this magma Bow Wow is descended from a long line of Cerberus trained by the Ouginaks. Some legends claim that sacrifices of young, innocent souls were necessary to stir up its ferocity, but this is no longer the case.');
INSERT INTO "item_descriptions" VALUES(19585,'en','Your feet will stay warm whenever you''re hot to trot.');
INSERT INTO "item_descriptions" VALUES(19586,'en','Your burning gaze will melt anyone, and your enemies will see only smoke.');
INSERT INTO "item_descriptions" VALUES(19589,'en','This fireproof cape''s full potential can be seen in the heat of inaction.');
INSERT INTO "item_descriptions" VALUES(19590,'en','The back of this amulet is inscribed with the following proverb: "When you light a candle for your god, light two for Rushu."');
INSERT INTO "item_descriptions" VALUES(19591,'en','This bag will allow you to communicate easily using smoke signals. Watch out, though, as where there''s smoke, there''s fire.');
INSERT INTO "item_descriptions" VALUES(19592,'en','The metallic soles of these clogs allow you to slide on any surface and create a shower of sparks that will satisfy your most primal pyromaniac instincts.');
INSERT INTO "item_descriptions" VALUES(19593,'en','More dangerous than a fireball, more terrifying than a ball afire, this axe will devour your adversaries'' bravery.');
INSERT INTO "item_descriptions" VALUES(19594,'en','Crush heads or nuts? With the Steelymace, the choice is yours.');
INSERT INTO "item_descriptions" VALUES(19595,'en','With this helm, you might finally have your shoulders on your head.');
INSERT INTO "item_descriptions" VALUES(19596,'en','The cobbler who produced this marvel reached his highest potential in the last-minute rush. His favourite saying was "Always put off what you can do today until tomorrow." He remains widely misunderstood to this day.');
INSERT INTO "item_descriptions" VALUES(19597,'en','It puts out a terrifying heat. And is not meant for all sands, err, bands, err, lands, err.... Oh, you know what I mean!');
INSERT INTO "item_descriptions" VALUES(19598,'en','This shield reflects light. Don''t bother trying to see your reflection in it: just like Solar''s, yours won''t appear in it.');
INSERT INTO "item_descriptions" VALUES(19599,'en','Among dungeon keepers, the ones with the most bark have the least bite.');
INSERT INTO "item_descriptions" VALUES(19600,'en','If you hold this giant shell to your ear, you just might hear the sound of the Hermaffrodaight Sea.');
INSERT INTO "item_descriptions" VALUES(19601,'en','This indescribable pile of foam and decomposing coral surprisingly does not give off any putrid odours – a sufficiently strange occurrence in the World of Twelve to be noteworthy.');
INSERT INTO "item_descriptions" VALUES(19602,'en','The seams are reinforced and the inside is as soft as the outside. Once soiled, you can therefore turn them inside out and wear them another month.');
INSERT INTO "item_descriptions" VALUES(19603,'en','"Comfortable on the inside, spiky on the outside." These slippers remind you of someone who hurt you horribly, but whom you miss terribly all the same.');
INSERT INTO "item_descriptions" VALUES(19604,'en','Hard to know which way is up with this mask... Big teeth and small ears, or the opposite? This difficult decision will keep you busy during those long winter nights.');
INSERT INTO "item_descriptions" VALUES(19605,'en','The artisan who created this wand used a few drops of sea foam, a pinch of decomposing matter, an ounce of a bad faith, and a piece of good will.');
INSERT INTO "item_descriptions" VALUES(19606,'en','This magic lance has the amazing power to transform offal into sweets and boiled celery into Turkish delight. A curse for foodies, a blessing for the younger generation.');
INSERT INTO "item_descriptions" VALUES(19607,'en','This cape belonged to a dangerous aquatic criminal whose sins were forgiven.');
INSERT INTO "item_descriptions" VALUES(19608,'en','It will make you world famous – among crustaceans.');
INSERT INTO "item_descriptions" VALUES(19609,'en','According to ancient writings translated with only a passing glance at the text, this strange necklace seems to have belonged to a pawnbroker willing to do anything to pass on his knowledge to the students living in the fields near his home.');
INSERT INTO "item_descriptions" VALUES(19610,'en','"The advantage of these dead fish boots is that they mask the smell of my feet." Ah, what poetry emerges from the depths of the sea!');
INSERT INTO "item_descriptions" VALUES(19622,'en','You won''t be able to rule them all with this ring, but you will at least feel more powerful when you put it on. It''s a start.');
INSERT INTO "item_descriptions" VALUES(19629,'en','Created by Ratathrosk, the grey dragon, this egg is an enigma. It may not be as powerful as a Primordial Dofus, but it seems older than time... You''d do well to guard it closely. After all, only the Norrai and the god Xelor know what the future holds.');
INSERT INTO "item_descriptions" VALUES(19637,'en','This curse is more effective against your spouse than wheat.');
INSERT INTO "item_descriptions" VALUES(19639,'en','You can tell an adventurer''s fight history just by looking at the hits taken by this shield.');
INSERT INTO "item_descriptions" VALUES(19641,'en','Once used in religious ceremonies, nowadays this item of clothing can be worn for any occasion.');
INSERT INTO "item_descriptions" VALUES(19676,'en','The metal of this pickaxe is as tough as diamond. Now this is a tool that can probably cut through anything.');
INSERT INTO "item_descriptions" VALUES(19976,'en','The inside of this belt is lined with the fuzz of young Stubbyobs who were voluntarily volunteered to be donors against their will.');
INSERT INTO "item_descriptions" VALUES(19977,'en','This ring is designed to fit Stubbyobs: it can be worn readily around anything short and stubby. Like fingers or toes, of course! What else?
It might fit your wrist.');
INSERT INTO "item_descriptions" VALUES(19978,'en','With that much weight on your noggin, it won''t be easy to hold your head high for long.');
INSERT INTO "item_descriptions" VALUES(19979,'en','Having a beard down your back is not as practical as having eyes in the back of your head.');
INSERT INTO "item_descriptions" VALUES(19980,'en','There''s nothing better than a fake beard to disguise a misleading appearance.');
INSERT INTO "item_descriptions" VALUES(19981,'en','Axe head or tiny anchor? Either way, your neck will be cursing the Stubbyob who made this "jewel".');
INSERT INTO "item_descriptions" VALUES(19982,'en','The tiny antennae on this helmet let you understand the Rhineetle''s complex dialect consisting of the words Vrrr, Brrr, Trrr, and Krrr, which signify eat, eat, eat, and eat, respectively.');
INSERT INTO "item_descriptions" VALUES(19983,'en','The huge antennae located in the back of this belt are pheromone receptors.
They alert you whenever anyone (or anything) genetically compatible with you comes close.
Oh, no, that won''t be awkward at all!');
INSERT INTO "item_descriptions" VALUES(19984,'en','Made by a former Rhineetle breeder, this amulet gives off a delicate scent of stables, a mixture of manure, sweat, and underpaid labour.');
INSERT INTO "item_descriptions" VALUES(19985,'en','The tiny wings beat rapidly to maximise your ability to tickle anyone you touch. Torture for some, pleasure for others... You may test it on yourself to figure out which camp you''re in.');
INSERT INTO "item_descriptions" VALUES(19986,'en','The antenna serves as an arrow rest, the horn serves to intimidate opponents, and the wings serve no purpose whatsoever. Just remember to grip it properly to shoot accurately.');
INSERT INTO "item_descriptions" VALUES(20210,'en','The legendary sword that Grougalorasalar gave to his son is now in your possession. But if the weapon you removed from the rock is indeed Crocobur, it is only the shadow of what it was... It''s up to you to return its powers and history.');
INSERT INTO "item_descriptions" VALUES(20213,'en','After much effort, you finally hold in your hands the sword of the emperor who nearly conquered the world long ago. Nevertheless, don''t forget the deal you made with Volkaragnar. Once you have the Ebony Dofus, you will have to give Crocobur back to its creator. Can''t have it all...');
INSERT INTO "item_descriptions" VALUES(20286,'en','When the dragon Ratathrosk created the Silver Dofus, when the World of the Twelve did not yet exist, a miracle happened: the first of the Phoenixes came back to life. Time has passed, gods have vanished, stars have gone out. Now, the egg that you hold in your hands sparkles brightly like it once did... like a lost love whose flame burns yet again.');
INSERT INTO "item_descriptions" VALUES(20353,'en','"The Crocodyls numbered in the thousands, a few hundred kametres from the city gates. We had prepared for the assault, the full guard were assembled in front of the main gate, and the war machines had been set up on the ramparts. The sight of the gigantic army of reptiles was already terrifying, but the worst was when we saw them. Crocoburio stood in the midst of his soldiers, several heads taller than all of them, brandishing his cursed sword towards us. When the green mass began to march, a shiver ran through our ranks, and we knew that the coming battle would be terrible."

– A Bontarian soldier');
INSERT INTO "item_descriptions" VALUES(20354,'en','This item is legendary – you, however, are not.');
INSERT INTO "item_descriptions" VALUES(20355,'en','This item is legendary – you, however, are not.');
INSERT INTO "item_descriptions" VALUES(20356,'en','"There was a time before safes existed. Enutrofs would hide their savings in socks or under their mattresses, squirrels would hide their hazelnuts inside tree trunks, and dragons would stockpile their gold coins in dark, damp caves. Then the Firm created the banking network. What a revolution! Finally, Twelvians could keep their belongings safe behind reinforced doors. Of course, there are still Rogues setting off bombs and illegal kama dealers cheating overly greedy adventurers, but that''s no big deal. You just need good insurance."

– Buhorado');
INSERT INTO "item_descriptions" VALUES(20357,'en','"Any Feca heading into combat must carry a shield. But the best protection against adversity, the best rampart against all those who seek to harm or destroy us, is union. Mercenaries! Time has come to set our quarrels aside and unite under a single banner. Astrub is not merely an old merchant city founded by a gang of bandits who''ve grown tame. Astrub is also an ancient city, with its own heritage and culture. Astrub is a nation! Today, dear council members, you are going to elect a new leader. I have applied for the position. Will you place your trust in me? It''s your decision."

– Fallanster, Head of the Council of Astrub');
INSERT INTO "item_descriptions" VALUES(20358,'en','"Death is a necessary evil, but even so, we''d all prefer it comes for someone else, isn''t that so? That''s why I forged this shield. It is indestructible; it will never wear out and never rust. It turns away all blows that could take you from living to dead. Despite its impressive size, it is light and manageable. Plus, its macabre looks will intimidate your opponents; the most cowardly among them won''t be able to bear the dark pits of its empty eyes and will run away screaming. Still need convincing? Time for a demonstration. You''re up, Sargent Kocksis."

– a craftsman who wishes to remain anonymous');
INSERT INTO "item_descriptions" VALUES(20359,'en','"They think us small and weak. They mock our costumes and our ancestral traditions. They take us for smelly barbarians, greedy and uncouth. They think us happy to stay in our mines, digging in the dark like Rotceres. But they are wrong! I will show them the Stubbyobs'' true nature. I will burn their farms and crops. I will flatten their cities. I will shave their heads and eyebrows. I will shear their Gobballs. I will take their gold, empty their barrels, shred their banners. I am the King Under the Mountain... and soon, I shall be king of the world!

– Bram Worldbeard');
INSERT INTO "item_descriptions" VALUES(20360,'en','"When a young soul leaves the temple in Incarnam, that soul dreams of the life waiting for it outside. A life full of thrilling adventures, personal exploits, enriching exchanges, and communion with others. The soul has forgotten who it was before. Perhaps it reigned over an empire, only a little rubble of which remains. Perhaps it was a humble shepherd watching over a herd of Gobballs. The past is of little importance when one looks to the future. The Celestial Eagles ensure that every being gets a new start, without fear or regret, until destiny has been fulfilled."

– Master Ganymede');
INSERT INTO "item_descriptions" VALUES(20361,'en','"I''ve been training to fight dragons since I was very young. I am a knight, and knights assail huge fire-breathing lizards. That''s what all the children''s history books say, so it must be true! You can imagine my surprise when I met Bolgrot, then. Who would have ever thought that I''d become his best friend? Not me, that''s for sure! I was as surprised as anyone. It just goes to show that you can''t count on appearances... We''ve been together constantly for weeks. I can''t wait to introduce him to Helsephine! I''m sure they''ll get along famously."

– Rykke Errel, Iop knight');
INSERT INTO "item_descriptions" VALUES(20362,'en','"While our troops were gathering to fight off the army of the Dark City, I climbed to the top of the closest hill for one last prayer. Today, many Twelvians shall die. I wonder. Is all this violence necessary? Must we sacrifice thousands of souls so that harmony might reign again? But now is not the time for questions or doubts. Spirit of Balance, send me your wisdom. Show me the path of justice that leads to peace. And if my path should cross that of the Butcher of Brakmar... then give me the strength to fight her so that hope can be reborn in this world."

– Jahash Jurgen');
INSERT INTO "item_descriptions" VALUES(20363,'en','"They say that the first lumberjacks could travel the length and breadth of Amakna without ever tiring. The boots they wore had been enchanted by the four guardians and let them cross the country in the blink of an eye. In a single step, the sentinels with piercing eyes leapt from border to border, from the shores of the Asse Sea to the rocky valleys full of Bworks and Goblins. Alas! The power of these miraculous boots declined when the Four left... But scouts who are lucky enough to own a pair stay a few steps ahead of the kingdom''s enemies."

– Cornelia Granpa');
INSERT INTO "item_descriptions" VALUES(20364,'en','"Come close, newcomers! Don''t hang back. I won''t repeat myself. First, know this: Only Masters of the Order are allowed to wear the sacred boots during official boot-kissing ceremonies. You must be able to fill the boots, you see. Anyone who dares disobey will be trampled by all their peers before being booted out on their backsides. Does everyone have their polishing brushes and Blibli wax? Good! Line up and enter the room in silence. I only want to hear one pair of heels!"

– Bowisse, Grand Master of the Kicked Ass');
INSERT INTO "item_descriptions" VALUES(20365,'en','"When you''re unlucky, it''s tempting to do nothing and stay at home filing one''s claws so you don''t trigger a disaster... But if you must be jinxed with bad luck, you might as well make it count! Audacity can break the paralysing grip of an unlucky jinx. There''s nothing like a bit of nerve to ward off bad luck. You tried something and failed? Brilliant! You just have to try again! ''Tis better to try and fail because of bad luck than because you lacked nerve. What''s important is landing on your feet."

– Dodge the Ecaflip');
INSERT INTO "item_descriptions" VALUES(20366,'en','"A master''s passing is a tragedy for his students. When Prosperus Elementor disappeared, all Huppermages were orphaned. How can we survive the emptiness left in his wake? How can the young generations receive their heritage when questions remain unanswered? I''m leaving today for the lush green island of Ohwymi to open a door that will let me find our guide. May the Scales tip in my favour... and may the god Xelor grant me the time I need to reach my goal."

– Lady Jhessica');
INSERT INTO "item_descriptions" VALUES(20391,'en','Is eating your enemies'' hearts a barbaric practice from another time, or an ancestral tradition to pass on? Start by using this knife on someone, and you''ll be able to form your own opinion on the question.');
INSERT INTO "item_descriptions" VALUES(20463,'en','The sandals worn by Paztek warriors give them all the sensations of going barefoot, while considerably reducing the risk of slipping clumsily on the blood of their enemies.');
INSERT INTO "item_descriptions" VALUES(20464,'en','The tinkling of the gold coins attached to the hem of this cape lets the wearers play music to accompany Paztek ritual dances, especially the dance celebrating human sacrifice. From there, it''s just a tiny leap to saying that this cape trivialises murder.');
INSERT INTO "item_descriptions" VALUES(20465,'en','Masks are a very important aspect of Paztek culture. They protect their faces, scare their enemies and evil spirits, and even identify the roles Pazteks play in their tribe: warrior, priest, merchant, or worker, for example. Paztek masks therefore make lovely gifts for friends or family living on the continent and, as wall hangings, are wonderfully suited to provide the most exotic touch to any home.');
INSERT INTO "item_descriptions" VALUES(20833,'en','All your cares and worries seem to melt away as you carry this massive cocoa egg. You do indeed feel the effects of the chocolate: you are both comforted and a bit wider and heavier.');
INSERT INTO "item_descriptions" VALUES(20848,'en','This sceptre controls the hunger of whoever wields it. If you wave it in front of the Waddicts, it''s highly likely that they''ll start obeying you.');
INSERT INTO "item_descriptions" VALUES(20850,'en','After trudging leagues and leagues through chocolate, the soles of these boots have absorbed so much that they leave footprints wherever you go. Discretion NOT guaranteed...');
INSERT INTO "item_descriptions" VALUES(20851,'en','There''s nothing better than this belt to offset all chocolate excesses and sculpt a dreamy Iop body.');
INSERT INTO "item_descriptions" VALUES(20852,'en','This furry ring will warm any finger you put in it.');
INSERT INTO "item_descriptions" VALUES(20924,'en','This amulet has a secret compartment that contains a small piece of very concentrated chocolate. This cocoa piece is used by Chocomancers who need to shore up their power during a fight, but since you don''t practice chocomancy, it''ll just make a welcome snack if you get hungry. Be warned, it''s a bit bitter.');
INSERT INTO "item_descriptions" VALUES(20925,'en','Chocomancy requires its practitioners ingest large quantities of chocolate. Traditional belts that squeeze practitioners'' tummies too tightly often prevent their stomachs from welcoming the precious cocoa. This belt is remarkably stretchy, so it lets them stuff themselves with chocolate without losing their pants.');
INSERT INTO "item_descriptions" VALUES(20926,'en','You might doubt just how effective an edible shield can be, but this one is surprisingly very resistant. Do wait until the end of the fight before nibbling on your shield, though, or you might never get another chance to taste it.');
INSERT INTO "item_descriptions" VALUES(20935,'en','This giant spatula is a very versatile tool. With it, you can prepare a huge and delicious chocolate cake, then mercilessly slice into any gluttons who try to taste it without your permission.');
INSERT INTO "item_descriptions" VALUES(20956,'en','Wearing this mask, you can try to found a sect based on excessive chocolate consumption. But be sure you''re never unmasked or your own followers will grind you up like a common cocoa bean.');
INSERT INTO "item_descriptions" VALUES(20981,'en','Whoever designed this item wasn''t very clever: if you don''t want to be stumbling around in the dark (chocolate), you need to eat one side of the helmet.');
INSERT INTO "item_descriptions" VALUES(20982,'en','Made by two brothers, Ay-Ess and Em-Ar, these boots make the delicious sound of cracking chocolate with every step you take.');
INSERT INTO "item_descriptions" VALUES(20983,'en','This little bag will bring back fond memories of childhood (either yours or someone else''s): your mum''s homemade snacks, skipping down the path to school ready to take a bite out of life, and getting your precious snacks stolen by bigger kids... Ah, those were the days.');
INSERT INTO "item_descriptions" VALUES(20987,'en','You close your eyes and suddenly the divine egg''s chocolate scent fills your nose. You bring the mythical object to your innocent lips, heady with temptation and yearning for a new culinary pleasure. As your taste buds are flooded with bitterness, you learn to your great dismay that not all divine essences taste good.');
INSERT INTO "item_descriptions" VALUES(21009,'en','You''ll finally be able to take a breather thanks to the air in this tank.');
INSERT INTO "item_descriptions" VALUES(21010,'en','When combined with a chronoxygene tank, this time-dive suit lets you travel through time and never fear working overtime.');
INSERT INTO "item_descriptions" VALUES(21186,'en','The dragon who laid this Dofus decided to remain anonymous. Even the wisest adventurers still wonder why.');
INSERT INTO "item_descriptions" VALUES(21223,'en','This ring will make you stronger, but might take off your finger.');
INSERT INTO "item_descriptions" VALUES(21224,'en','This belt was made by an aspiring designer. Frustrated because inspiration wouldn''t come, the designer threw the Crocodyl scales and teeth on the ground, which resulted in this oh-so-very unique pattern. He loved the results so much that he now only ever uses that method for his new designs.');
INSERT INTO "item_descriptions" VALUES(21225,'en','Crocodyl scales are as hard as Iops'' heads. This shield is covered in them, making it a must-have accessory for adventurers everywhere who like to jump carelessly into the fray.');
INSERT INTO "item_descriptions" VALUES(21226,'en','The creation of these boots was one small step for the shoemaker who made them and one giant leap for the Twelvians who wear them.');
INSERT INTO "item_descriptions" VALUES(21227,'en','They say you''ll turn into a Boowolf if you wear this necklace under a full moon.');
INSERT INTO "item_descriptions" VALUES(21228,'en','If you like wearing your rings on your thumbs, you''re out of luck. This ring can only be worn on your ring finger. You do get to choose which hand, though. So what will it be, the right or the left?');
INSERT INTO "item_descriptions" VALUES(21229,'en','After being bossed around by Turtelonia, the Arkelon turtle, with a wave of her wand, the Crocuzkoians decided to make exact replicas of her wand so they could boss silly adventurers around when they came to the island. Some were more successful than others, but it''s the thought that counts.');
INSERT INTO "item_descriptions" VALUES(21230,'en','Make sure you don''t land on your back while you''re wearing this carapace. You might not be able to roll back over.');
INSERT INTO "item_descriptions" VALUES(21235,'en','Some say you can tell how old an Arkelon turtle is by the size of its horn. If you wear this one, you won''t look your age anymore.');
INSERT INTO "item_descriptions" VALUES(21451,'en','This prysmaradite will protect you against the first arrow from a Iop who only just became a Cra.');
INSERT INTO "item_descriptions" VALUES(21452,'en','This prysmaradite will protect you against the first arrow from a Iop who only just became a Cra.');
INSERT INTO "item_descriptions" VALUES(21453,'en','This prysmaradite will protect you against the first arrow from a Iop who only just became a Cra.');
INSERT INTO "item_descriptions" VALUES(21506,'en','First put an adorable creature in a ball, then launch it at your opponent... Quite the recipe for a franchise. And you''re responsible for it.');
INSERT INTO "item_descriptions" VALUES(21507,'en','First put an adorable creature in a ball, then launch it at your opponent... Quite the recipe for a franchise. And you''re responsible for it.');
INSERT INTO "item_descriptions" VALUES(21508,'en','First put an adorable creature in a ball, then launch it at your opponent... Quite the recipe for a franchise. And you''re responsible for it.');
INSERT INTO "item_descriptions" VALUES(21509,'en','First put an adorable creature in a ball, then launch it at your opponent... Quite the recipe for a franchise. And you''re responsible for it.');
INSERT INTO "item_descriptions" VALUES(21510,'en','First put an adorable creature in a ball, then launch it at your opponent... Quite the recipe for a franchise. And you''re responsible for it.');
INSERT INTO "item_descriptions" VALUES(21711,'en','These wings won''t let you soar: they were merely built to scuttle Kat, Zen and Jammer.');
INSERT INTO "item_descriptions" VALUES(21712,'en','This helmet was designed for a single purpose: to prevent Goblins from getting to Moon Island. Don''t look for another use for it, as you''ll only end up disappointed.');
INSERT INTO "item_descriptions" VALUES(21878,'en','How could something so fragile-looking be used to capture four monsters that are spookier than an undertaker? Only one way to find out... Be sure to equip the nightmare catcher before challenging a Horlamare, or you''ll likely regret it.');
INSERT INTO "item_descriptions" VALUES(21996,'en','This prysmaradite will put you under pressure, so don''t lose your cool.');
INSERT INTO "item_descriptions" VALUES(21997,'en','This prysmaradite will put you under pressure, so don''t lose your cool.');
INSERT INTO "item_descriptions" VALUES(21998,'en','This prysmaradite will put you under pressure, so don''t lose your cool.');
INSERT INTO "item_descriptions" VALUES(21999,'en','This prysmaradite brings luck! How lucky! Since your last adventure to Ohwymi, you''ve really needed some.');
INSERT INTO "item_descriptions" VALUES(22000,'en','This prysmaradite brings luck! How lucky! Since your last adventure to Ohwymi, you''ve really needed some.');
INSERT INTO "item_descriptions" VALUES(22001,'en','This prysmaradite brings luck! How lucky! Since your last adventure to Ohwymi, you''ve really needed some.');
INSERT INTO "item_descriptions" VALUES(22002,'en','This prysmaradite is perfect for slow and resentful adventurers. Kind of like you, actually.');
INSERT INTO "item_descriptions" VALUES(22003,'en','This prysmaradite is perfect for slow and resentful adventurers. Kind of like you, actually.');
INSERT INTO "item_descriptions" VALUES(22004,'en','This prysmaradite is perfect for slow and resentful adventurers. Kind of like you, actually.');
INSERT INTO "item_descriptions" VALUES(22005,'en','This prysmaradite is perfect for getting close to adventurers who would have liked to put some distance between you and them. As a very wise person, you know the secret of heroes who can be a drag: perseverance.');
INSERT INTO "item_descriptions" VALUES(22006,'en','This prysmaradite is perfect for getting close to adventurers who would have liked to put some distance between you and them. As a very wise person, you know the secret of heroes who can be a drag: perseverance.');
INSERT INTO "item_descriptions" VALUES(22007,'en','This prysmaradite is perfect for getting close to adventurers who would have liked to put some distance between you and them. As a very wise person, you know the secret of heroes who can be a drag: perseverance.');
INSERT INTO "item_descriptions" VALUES(22008,'en','This prysmaradite is a bit like a fountain of youth, just without the water... and without the fountain, come to think of it. It won''t really make you any younger, either. Actually, as analogies go, this is a pretty bad one.');
INSERT INTO "item_descriptions" VALUES(22009,'en','This prysmaradite is a bit like a fountain of youth, just without the water... and without the fountain, come to think of it. It won''t really make you any younger, either. Actually, as analogies go, this is a pretty bad one.');
INSERT INTO "item_descriptions" VALUES(22010,'en','This prysmaradite is a bit like a fountain of youth, just without the water... and without the fountain, come to think of it. It won''t really make you any younger, either. Actually, as analogies go, this is a pretty bad one.');
INSERT INTO "item_descriptions" VALUES(22011,'en','This prysmaradite gives you the feeling that you''re always late. Maybe it''s not just a feeling...');
INSERT INTO "item_descriptions" VALUES(22012,'en','This prysmaradite gives you the feeling that you''re always late. Maybe it''s not just a feeling...');
INSERT INTO "item_descriptions" VALUES(22013,'en','This prysmaradite gives you the feeling that you''re always late. Maybe it''s not just a feeling...');
INSERT INTO "item_descriptions" VALUES(22014,'en','This prysmaradite lifts its bearer''s spirits, but without teaching them good manners, so you''re safe.');
INSERT INTO "item_descriptions" VALUES(22015,'en','This prysmaradite will give your body what it needs to endure the hardships of an adventurer''s life.

This is a stone. Do not ingest. Our products are not tested on Ecaflips or Ouginaks. Non alcoholic. Does not contain palmiflower oil.');
INSERT INTO "item_descriptions" VALUES(22016,'en','This prysmaradite will give you that cheeky quality that teens have these days without sacrificing the obscene comfort of your privileged position.');
INSERT INTO "item_descriptions" VALUES(22017,'en','This prysmaradite will give you that cheeky quality that teens have these days without sacrificing the obscene comfort of your privileged position.');
INSERT INTO "item_descriptions" VALUES(22018,'en','This prysmaradite will give you that cheeky quality that teens have these days without sacrificing the obscene comfort of your privileged position.');
INSERT INTO "item_descriptions" VALUES(22019,'en','This prysmaradite will give you the wildest experiences that involve disappearing temporarily. For example, imagine the disappointment on your mother-in-law''s face when she sees you reappear!');
INSERT INTO "item_descriptions" VALUES(22020,'en','This unbewitching prysmaradite is perfect if you want to train for the Kolossium after a rather boozy party. You Lousy Pig breath will even be an ally in close combat.');
INSERT INTO "item_descriptions" VALUES(22022,'en','This prysmaradite is perfect for slugs and snails, and that''s not just a metaphor.');
INSERT INTO "item_descriptions" VALUES(22023,'en','This prysmaradite protects introverts at gatherings where a few too many people have... well, gathered.');
INSERT INTO "item_descriptions" VALUES(22024,'en','This prysmaradite will be the delight of adventurers who don''t show the slightest drop of initiative.');
INSERT INTO "item_descriptions" VALUES(22025,'en','This is one heavy prysmaradite. It''s quite remarkable for something so small. It reminds you of someone.');
INSERT INTO "item_descriptions" VALUES(22027,'en','This weapon was fortified by dragon''s breath and can bend any kind of metal. The disadvantage is that it can only be used once. So make sure you only use it as a last resort.');
INSERT INTO "item_descriptions" VALUES(22163,'en','A pickaxe with a rudimentary appearance, but which seems capable of breaking almost anything, except perhaps the voice of Jon Lemon.');
INSERT INTO "item_descriptions" VALUES(22186,'en','Treacherous, calculating and manipulative: Misery is always one, two, even three steps ahead when it comes to achieving her goals. Lying comes naturally to her, and her intelligence is equalled only by her greed.');
INSERT INTO "item_descriptions" VALUES(22187,'en','"If you''re havin'' cash problems,
I feel bad for you, son!
I got 99 problems,
But tax ain''t one!

I''ve got the tax patrol on the cash patrol,
Foes that wanna make sure my purse is closed! 
Miserites that say he''s Money, Tax, Clothes!
I''m from Misery''s Desert, stupid! What type of facts are those?
If you''re havin'' cash problems, I feel bad for you, son!
I got 99 problems, but tax ain''t one!"


– Song written by Pay-Z, Misery''s favourite minstrel, to motivate collectors to tax more to earn less.');
INSERT INTO "item_descriptions" VALUES(22188,'en','To make the Miserites believe that she also lives in poverty, but above all to avoid spending the countless resources she accumulates, Misery eats very little. That explains why she''s so skeletal.');
INSERT INTO "item_descriptions" VALUES(22189,'en','To feed the Bloodforge, War''s soldiers stamp on corpses with their feet to extract the blood, in much the same way as their local wines are produced. This is a practice in which they excel and of which War often boasts: "In blood there is wisdom."');
INSERT INTO "item_descriptions" VALUES(22190,'en','"In wine there is strength. In water there are creepy crawlies. You decide." 

– War');
INSERT INTO "item_descriptions" VALUES(22191,'en','According to a rumour among the Warmongers, War''s shield is a representation of her true appearance. Surprisingly, no one has ever dared asked her to her face.');
INSERT INTO "item_descriptions" VALUES(22192,'en','Everyone has his or her own way of being respected. For War, it''s an iron fist in an iron glove. For you, it''s a velvet fist in a glove that''s too heavy to lift.');
INSERT INTO "item_descriptions" VALUES(22200,'en','No one has ever seen Servitude''s entire face because of his scarf. Perhaps he''s scared he''ll catch a cold, or he''s trying to hide something that would damage his credibility – like a bum chin.');
INSERT INTO "item_descriptions" VALUES(22201,'en','When you have so many slaves, it''s hard to know what to do with them. To keep them busy, Servitude has assigned no less than 100 prisoners to keep his precious coat looking great. Any trace of a scratch or stain is of course punishable by death. In other words, this coat looks impeccable whatever the circumstances.');
INSERT INTO "item_descriptions" VALUES(22202,'en','"You who dreamed of wide open spaces and got nothing but windows: would you like to be reborn, to flee this life of slavery? Of course you would, but you can just keep dreaming! Or not, Mwahaha!!"

– Servitude, bullying one of his slaves');
INSERT INTO "item_descriptions" VALUES(22205,'en','This ring was forged by corrupt Sadidas in honour of Corruption to signify their allegiance and devotion. They designed a special alloy to ensure that the ring won''t disintegrate upon coming into contact with the highly toxic skin of the Horseman.');
INSERT INTO "item_descriptions" VALUES(22206,'en','Even though it might seem like a good idea, avoid offering this ring to your betrothed. Indeed, Corruption crafted it himself from the Tree of Death and as far as poisoned gifts go, it''s hard to do better.');
INSERT INTO "item_descriptions" VALUES(22209,'en','Like the old proverb says: "If Corruption''s waters run deep, don''t teach your grandmother to suck eggs if she''s sleeping with one eye open". No one has ever really understood what it means, but when in doubt, keep away from grandmothers.');
INSERT INTO "item_descriptions" VALUES(22213,'en','This spade is the ideal tool if you want to start your first corrupt vegetable garden. No more typical fruits and vegetables! Make room for some more exotic products from rotten squash to poisonous mushrooms and you''ll have something for everyone!');
INSERT INTO "item_descriptions" VALUES(22214,'en','If you wear it too tightly, this collar is likely to make you slobber.');
INSERT INTO "item_descriptions" VALUES(22215,'en','If you don''t have wings of your own, you can always wear these and use your hands to fly.');
INSERT INTO "item_descriptions" VALUES(22368,'en','"When the Prince of Brakmar and the King of Bonta impaled each other, spilling their entrails over the blood-reddened ground, I felt deep satisfaction. And thus ended the war between the two cities, surrounded by a mountain of corpses! It was a scene of great beauty. So when the cawing of the Crobaks mingled with the agonising death rattles, nostalgia washed over me. Poignant memories of the first Crimson Dawn flooded my mind. The charge of the Karne Riders, Menalt''s decapitation, Raval''s theatrics... It was the opening of a murderous and jubilatory conflict, one that would have kept me on tenterhooks for nearly a thousand years! Today, the curtain has fallen. But the show must go on... There will always be other battles."

– War');
INSERT INTO "item_descriptions" VALUES(22412,'en','"Oh, how lovely it is to smell the scent of despair in the air... Mercenaries once so proud, so brave, so... arrogant. Look at you, your faces covered in tears, throwing your loved ones in mass graves. Attachments, promises, feelings... All swept away by the madness crawling under your skin. Is there anything more delicious than seeing the horror and disgust wash over your peers'' faces at the first signs of your own pestilence? Tremble, Astrub... Implore the gods, those imposters who can do nothing for you... This gangrene that you fear so deeply... come not from the sky... but from each and every one of you."

– Corruption');
INSERT INTO "item_descriptions" VALUES(22429,'en','"Look at you, you proud Kanigs, subjugated by your enemies... What a fall! You could have built a true empire if you weren''t so weak. There was a time when you dreamed of glory and conquest, when prisoners worked in your rock quarries and moaned under the lash of whips... But the road from master to slave is sometimes very short. Kowtowing under the weight of your chains, crawling in the mud like larvae, you''ve forgotten who you once were. You are pathetic. When your matriarch dies, you destiny shall be complete. Your sacrifice will have been less vain than your existence... since it will change history."

– Servitude');
INSERT INTO "item_descriptions" VALUES(22444,'en','"Do you hear the cries carried, the growling of Troolgodytes, and the rumbling of starving stomachs? What a sweet symphony it is for my ears... The desert is spreading. Advancing, dune by dune. Grains of sand replacing grains of wheat. Wells running dry. Plates emptying. Castucs drying up. Soon, fertile lands will be but a fairy tale to raise the useless hopes of sickly children as night falls. Soon, I shall reign alone and uncontested over Ohwymi... The land will finally be mine."

– Misery');
INSERT INTO "item_descriptions" VALUES(23094,'en','You need this traditional shield to enter the Pandassembly Hall where the dignitaries who govern Pandala Island sit. Careful you don''t damage it because if you do, you''ll have to craft a new one.');
INSERT INTO "item_descriptions" VALUES(23237,'en','Like a moon veiled behind dark clouds at night, the brightest light is often hidden in the blackest of inks.');
INSERT INTO "item_descriptions" VALUES(23248,'en','This headband marks the first step towards becoming a Pandawushuka. Patience and self-control are the qualities needed for the long apprenticeship before you.');
INSERT INTO "item_descriptions" VALUES(23253,'en','Despite the rumours, jumping on the back of a Kwapa won''t ensure victory.');
INSERT INTO "item_descriptions" VALUES(23254,'en','Never stand around idly with these boots on your feet or you just might take root.');
INSERT INTO "item_descriptions" VALUES(23255,'en','This headgear has many uses. These include as a head-covering, of course, but also as a bucket, chamber pot, or spittoon.');
INSERT INTO "item_descriptions" VALUES(23256,'en','Swallow this amulet and it''ll release a small seed in your stomach. If you open your mouth regularly on sunny days and drink enough water, maybe a shrub will grow inside you.');
INSERT INTO "item_descriptions" VALUES(23257,'en','Bakas typically use cucumbers to make handles for their axes... but this was clearly an exception. That said, it is true that a wood and metal handle is more appropriate than cucumber for a weapon.');
INSERT INTO "item_descriptions" VALUES(23258,'en','Thanks to this shield, win your battles without buckling under the weight of flowers!');
INSERT INTO "item_descriptions" VALUES(23259,'en','Accused of stealing children to drown and devour them, the Lady of the Water really just wants to adopt them. So, she turns them into Kwapa so they don''t drown.');
INSERT INTO "item_descriptions" VALUES(23260,'en','If you''ve always dreamed of having lots of children, don this cape and dance through the fields. When you return in the spring, your babies will have sprouted.');
INSERT INTO "item_descriptions" VALUES(23261,'en','Very useful for shelling small nuts, these gloves are also – and above all – formidable weapons against opponents of the male persuasion.');
INSERT INTO "item_descriptions" VALUES(23262,'en','The Ino-Naru use this nunchaku-boomerang hybrid in everything they do: hunting, fishing, and traditional activities.');
INSERT INTO "item_descriptions" VALUES(23263,'en','If you''ve ever meanly swiped this hat from someone, know that someday someone will make you eat this titfertat hat.');
INSERT INTO "item_descriptions" VALUES(23264,'en','This cape will do a marvellous job of protecting you from the most violent of winds, but it won''t stop you from being ignored by everyone you try to talk to.');
INSERT INTO "item_descriptions" VALUES(23265,'en','With a belt such as this one, it''s hard not to imagine what''s below it. And equally hard not to think of what''s below other people''s belts.');
INSERT INTO "item_descriptions" VALUES(23266,'en','If you drop the pearls on this necklace, you''ll be certain to hurl in frustration.');
INSERT INTO "item_descriptions" VALUES(23267,'en','What''s the secret to a roasty breadstick? Know-how and love! Available only from the best local artisans. And maybe elsewhere.');
INSERT INTO "item_descriptions" VALUES(23268,'en','Hanshi has performed many a feat with this extendable staff. While it''s truly impressive in size, don''t be ashamed if yours is smaller – you, too, can do big things.');
INSERT INTO "item_descriptions" VALUES(23269,'en','The craftsman who designed this ring clearly wanted to revolutionise how jewellery is worn. As you can see, this beautiful object doesn''t fit around one finger but instead between two fingers thanks to its clever design.');
INSERT INTO "item_descriptions" VALUES(23270,'en','Don''t fan yourself shamelessly with these fans: you wouldn''t want to lose your life or your sight.');
INSERT INTO "item_descriptions" VALUES(23271,'en','With the fireworks on this belt, you''ll get the party hopping in no time!');
INSERT INTO "item_descriptions" VALUES(23272,'en','This Firefoux cannon is fantastic for launching fireworks far and high. Sadly, replacing the fireworks with tiny humans has been forbidden ever since the incident with a... Oh, never mind.');
INSERT INTO "item_descriptions" VALUES(23273,'en','Ideal for those spontaneous and oh-so-explosive games of lawn bowling among friends, this handmade cloth bag contains a full set of the highest quality Firefoux balls. Burn ointment not included.');
INSERT INTO "item_descriptions" VALUES(23312,'en','This katana gives off an intense heat without actually burning you. When you use it, you seem to be able to detect your enemies'' weak points more easily.');
INSERT INTO "item_descriptions" VALUES(23313,'en','This katana is unusually light, which helps you pull off aerial moves and effective dodges. When you lower this weapon, it seems to disappear in a puff of wind.');
INSERT INTO "item_descriptions" VALUES(23314,'en','This katana has tried and true handling, which helps you perform fluid and unpredictable movements. When carrying it, you are filled with a sense of calm and serenity.');
INSERT INTO "item_descriptions" VALUES(23315,'en','This katana is extremely heavy for its size but also rock solid. It''s difficult to handle for a novice but is a formidable weapon in a sabre duel.');
INSERT INTO "item_descriptions" VALUES(23316,'en','This katana gives off a subtle mossy odour and its blade is remarkably flexible for a weapon of this type. Striking a nice balance between weight and sturdiness, you seem to hear a leaf rustling when it cuts through the air.');
INSERT INTO "item_descriptions" VALUES(23408,'en','They say that every one of the Dorigami''s thousand folds hides a mystery, the reflection of a lie or painful truth, of blinding purity, like as many facets of a paper diamond.');
INSERT INTO "item_descriptions" VALUES(23501,'en','This shield seems way too heavy for training purposes. Your body becomes a lot heavier and your movements sluggish. No one said Pandawushuka training would be a walk in the park.');
INSERT INTO "item_descriptions" VALUES(23522,'en','You crafted this staff from a branch from the forest''s last spirit bamboo. It wasn''t easy to convince Shinotake, but he ultimately agreed to give you a branch. It will make a nice staff for your future training sessions.');
INSERT INTO "item_descriptions" VALUES(23563,'en','To get rid of this ring, wear it for one day, then take it back to the spot where you met the Sacrificial Spirit.');
INSERT INTO "item_descriptions" VALUES(23578,'en','Nothing can resist this tool.');
INSERT INTO "item_descriptions" VALUES(23590,'en','This katana is truly a work of art and perfectly balanced even though its blade is unusually long. It takes incredible physical strength to wield it properly, but it''s slicing edge is unparalleled. Among other things, when you pull it out, a wave of wellness runs through your body, filling you with gentle serenity before the fight.');
INSERT INTO "item_descriptions" VALUES(23618,'en','Jiangshi-Nobi use this bag to carry the remains of their mummified bodies, which reside both in the material world and Externam. Despite the persistent smell of putrefaction coming from this bag, it was designed to be kept for many a long year. With it, you''ll have a friend to talk to whenever you''re feeling lonely.');
INSERT INTO "item_descriptions" VALUES(23619,'en','Don these boots and your legs will feel lighter and you''ll move around more discretely, giving off clouds of mist with every step. With a bit of practice, you too might inherit the nickname "mist rider".');
INSERT INTO "item_descriptions" VALUES(23620,'en','It took many tries to obtain this piece of armour able to protect its wearer''s flanks while still allowing for optimal mobility. Originally designed for the Tsukinochi so that the complex circular movements of their dual blades were not hindered by heavier armour.');
INSERT INTO "item_descriptions" VALUES(23621,'en','This shield looks like a Yokomainu, the Yokai protector of temples. Tradition says it can push evil spirits away. If it doesn''t, at least it will scare off annoying children begging for sweets during Al Howin season.');
INSERT INTO "item_descriptions" VALUES(23622,'en','The two rubies set into this ring represent the gaze of the goddess Inali. Minuscule flames dance in the gems. Could the spirit of a real Kitsou live within this ring?... It''s probably just a reflection of your own greed.');
INSERT INTO "item_descriptions" VALUES(23623,'en','In addition to giving you an elegant eastern style, these geta will let you walk through ectoplasm without staining the rest of your outfit. If you''re cold, you can also wear these sandals with socks. It''s probably the only time you can wear socks with sandals and not look absolutely ridiculous.');
INSERT INTO "item_descriptions" VALUES(23624,'en','Each people has its own warrior caste, and the Yokai are no exception with the Onigori. Truly vengeful demons, they don the armour taken from the samurai they massacre. Despite its age, this reinforced belt will protect your delicate hips just as effectively as it did the very first day.');
INSERT INTO "item_descriptions" VALUES(23625,'en','It is often said that the Kaonashi are the spirits of Twelvians who died in complete obscurity, which would explain their lack of a face. Obviously, this is patently false, but nothing is stopping you from wearing this mask and masquerading as one of your slightly naive friends'' late great-great grandfather. ');
INSERT INTO "item_descriptions" VALUES(23626,'en','Slayspirits use these headbands to stop their vision and develop their other senses. This lets them more easily detect the ghosts they''ve sworn to fight. It''ll mainly prevent you from seeing the ugly mugs of your companions, however.');
INSERT INTO "item_descriptions" VALUES(23627,'en','This Slayspirit katana able to banish ghosts took Nasumara, the Nolifis smith, four long years to make. Unfortunately, after a combat mishap, it lost its anti-ghost properties. It''s still a high-quality weapon for someone who knows how to wield this type of blade.');
INSERT INTO "item_descriptions" VALUES(23628,'en','Combined with a slayoover, this tank can store Dark Vlad''s curse, which traps spectres on Nolifis Island. This one broke under the force of the evil energy it contained. The residual traces of the curse left in this tank strengthen you when it''s on your back.');
INSERT INTO "item_descriptions" VALUES(23805,'en','Weighing at least 20 kilopods, this shell is used for muscle strengthening during Master Tor Toise''s training sessions.');
INSERT INTO "item_descriptions" VALUES(24022,'en','This ink amulet is both solid and liquid and makes an excellent calligraphy tool. Its very fine point will allow you to draw exquisite characters with precision, as long as you have some basic training in this skilled art.');
INSERT INTO "item_descriptions" VALUES(24023,'en','According to respectable belt makers, crafting engirdle ishisms may seem tempting, but you can quickly get carried away and start putting them everywhere. Although sometimes used subtlety and sparingly, the aforementioned respectable craftsmen generally don''t make them because they consider their usage to be lazy and unsuited to the World of Twelve. Ah, belt makers and their principles! That being said, this belt is a must-have.');
INSERT INTO "item_descriptions" VALUES(24024,'en','These boots were made in honour of Kian Zhi, the legendary mute dreamer. Unscrupulous retailers tout the fine detail in the Kianzhi they leave on the ground as you walk. Anyone who knows how to read Kianzhi will, however, tell you that they simply say: "Made in Pandala. Size 5".');
INSERT INTO "item_descriptions" VALUES(24026,'en','"While my consonant slept,
My vowels wept,
My capsonant crept,
My spirit leapt."

- Maestro Ghymsse, zombie and professional troubadour.');
INSERT INTO "item_descriptions" VALUES(24027,'en','Forgetting your cape ostrophe once in a while isnt a catastrophe.');
INSERT INTO "item_descriptions" VALUES(24028,'en','Phonemenal scythes cut down enemies just as easily as they cut up words.');
INSERT INTO "item_descriptions" VALUES(24029,'en','When she was still young, Wulan pretended to be a samurai to take part in a battle in place of her elderly father. She ultimately became a real samurai and climbed the ranks through skill and bravery. She now commands the samurai order that serves the Daimya no less. Her story of success and liberation is a great example for all young girls (and boys)!');
INSERT INTO "item_descriptions" VALUES(24030,'en','"Be a Iop
We must be swift as the coursing river
Be a Iop
With all the force of the great typhoon
Be a Iop
With all the strength of the raging fire
Mysterious as the dark side of a moon."

Despite her devotion to Pandawa, Wulan has much respect for the fighting spirit of the disciples of Iop, and takes inspiration from them to motivate her troops.');
INSERT INTO "item_descriptions" VALUES(24031,'en','"Tranquil as the forest but on fire within, once you find your centre, you are sure to win."

- Wulan');
INSERT INTO "item_descriptions" VALUES(24032,'en','This ring will be your strongest ally when you need to name a large quantity of things while sticking to a logical and coherent framework. Not sure how useful it will be to adventurers.');
INSERT INTO "item_descriptions" VALUES(24033,'en','"Tall and tan and young and lovely
The girl from Pandala goes walking
And when she passes, each one she passes
Goes "a-a-a-h"

- Song written by a travelling bard in honour of Queen Ginju, the first souverain of Pandalucia.');
INSERT INTO "item_descriptions" VALUES(24034,'en','Authentic or not, this scythe lets you cut anyone short before they can mispronounce your beautiful name again.');
INSERT INTO "item_descriptions" VALUES(24035,'en','"Ewe can never over slate the the impotence of proffer spilling because if you right thinks wrong, know won can under strand ewe and that wood bee holey terrible."

- Mila Tyloar, a dyslexic Pandawan poet of consummate skill.');
INSERT INTO "item_descriptions" VALUES(24036,'en','Did you know? In the ancestral language of the Pandawas, the word "etymology" – like all other words – draws its roots from the Kianzhi, the Spwrites. "Etymo-" derives from the Kianzhi meaning "truth", while "-logy" is derived from the Kianzhi for both "knowledge" and "hidden meaning" (among other things).');
INSERT INTO "item_descriptions" VALUES(24037,'en','Not only is this hammer is an elegant tool for bludgeoning enemies to a pulp, but its intricate folds also hide a sombre epitaph:

"Oh unknown warrior, without a grave or portrait, You who knew that the words of heroes are written forever in the hearts of the living."');
INSERT INTO "item_descriptions" VALUES(25214,'en','The few sailors who have ventured near the Atoll are spreading the strangest of rumours. According to them, that monstrous coral reef appeared as if by magic. Part of it is surrounded by a shroud of fog. Through the fog, pierced here and there by blazing fires, they say they could hear a worrying clamour, punctuated by war drums and heady litanies. Some even say they could see a gigantic ghostly figure moving in the mist and a pair of eyes glowing like red embers, staring at them, piercing deep inside their souls. Those who came back were terrified by these hellish visions, and there''s no telling what happened to those who weren''t so lucky...');
INSERT INTO "item_descriptions" VALUES(25215,'en','"Hey shushus, you''re shushumi!"

– Typical saying used by the Possessed to provoke Rushu''s shushus');
INSERT INTO "item_descriptions" VALUES(25216,'en','"Godless and lordless", "Neither god nor pastor": behind these resolutely anarchist mottoes, the Possessed seem to observe many customs and rites that allow them to coexist despite the survival of the fittest that reigns as law amongst them. There is also another, less well-known motto: "Never insult mothers". Indeed, the Possessed don''t respect anything or anyone, but when the name of the Mother of the Seven Seas is mentioned, it''s in a hushed voice full of respect tinged with fear.');
INSERT INTO "item_descriptions" VALUES(25217,'en','"... the Atoll of the Possessed is made up of two distinct parts. First is the Destroyers'' Port, where the corrupted coral reef is arranged in a half-moon where a large number of demonic ships drop anchor. The entrance to the crescent is guarded by two impressive black statues that seem sentient, controlling all entries and exits. The other part of the Atoll, called the Pandamonium, overlooks the Port and is the true stronghold of the Possessed. It''s still difficult to say what they are fomenting there and how many of them there are. The whole area is covered with cabalistic signs and traces of rituals, which portends the use of dark, powerful magic. Finally, their leader is a Pandawa shaman who has emaciated wings and an imposing arm covered with claws and horns... May the goddess bless us, we weren''t spotted, but it was close. I regret to inform you, Lady Hikomi, that the threat to Pandala and the World of Twelve is great, and significant losses must be expected."

– Dolan Aichson, mission report to the Daimya about the Atoll');
INSERT INTO "item_descriptions" VALUES(25218,'en','"Why this quarrelsome love, this loving hate, this everything created from nothing, this burdensome lightness, this serious vanity, this unspeakable chaos of the nicest forms?"

– Author unknown');
INSERT INTO "item_descriptions" VALUES(25219,'en','"Anarchism should not be confused with lawlessness: lawlessness is the absence or rejection of any law or rule, which inevitably leads to the disintegration of society. On the contrary, anarchy is order without concentration of power or any other form of hierarchy, meaning a just and egalitarian social order, because it is decided upon collectively."

– Alfy Hobman, excerpt from the book "Steal This Book"');
INSERT INTO "item_descriptions" VALUES(25220,'en','"Overlooking the sea, they growl,
Those ghosts and demons,
Skimming the waves aprowl,
Free to devour our companions,
But we are stuck on the shore,
Where the fog has slammed
Our boat for a moment or more,
Let us sing for the damned."

– Pandalan sailor''s song');
INSERT INTO "item_descriptions" VALUES(25221,'en','"We always imagine chaos as a bottomless pit, a dark abyss, a downward spiral of destruction and suffering. It is actually a far more complex and elusive notion, intimately linked to life itself. To create is sometimes to destroy, and vice versa. Having no rules is a rule in itself, and what would freedom be without the disorder it sows in its wake?

Without the movement caused by chaos, what would the world be like? A nice painting, no doubt, with everything in its place. A mortifying painting that one would gaze upon, drowning in the lazy eternity of immutable and absolute order. That is, indeed, one deep pit.

Chaos isn''t a pit. Chaos is a ladder. Many who try to climb it fail, and never get to try again. The fall breaks them. And some are given a chance to climb, but refuse. They cling to the realm, or love, or the gods... Illusions. Only the ladder is real. The climb is all there is."

– Kabaal, leader of the Possessed');
INSERT INTO "item_descriptions" VALUES(25222,'en','"Nor stony tower, nor walls of beaten brass, nor airless dungeon, nor strong links of iron can be retentive to the strength of spirit. But life, being weary of these worldly bars, never lacks power to dismiss itself. If I know this, know all the world besides, that part of tyranny that I do bear I can shake off at pleasure."

– Juliam Shaykzar, Twelvian missing since 6 Jullier 651');
INSERT INTO "item_descriptions" VALUES(25235,'en','This blade is the property of the leader of the Slayspirits herself.');
INSERT INTO "item_descriptions" VALUES(25245,'en','Assembled and sculpted according to Pandawa tradition, the brush is an extension of the artist''s body. Take a calligrapher''s brush away, and you cut off their wings. Unable to break free from the fetters of silence, their thoughts will no longer take flight.');
INSERT INTO "item_descriptions" VALUES(25248,'en','Blessed by the first ever calligrapher, this brush is at one with you. To part with it would be like cutting off a finger, an arm, or any other small but important part of your body. It would probably be painful, so best keep it forever and use it only on great occasions... to save the world, for example.');
INSERT INTO "item_descriptions" VALUES(1025292,'en','The larva of this charming creature – the Tae''Niak – hides in the uncooked and under-cooked meat eaten by the demonic boats known as Kar''Draks. They grow in the guts of all those unfortunate enough to taste the meat by mistake. At least, that''s what Bwork parents tell their children to dissuade them from nibbling on everything that comes their way, be it putrid old carcasses or the ears of their playmates. Never forget: you are what you eat.');
INSERT INTO "item_descriptions" VALUES(1025293,'en','A quick glance sideways to anticipate an opponent''s attack, a quick snap, and then a searing pain at the base of the skull. The pain spreads as fast as lightning to your jaw, ripping a cry of anguish from you and leaving you paralysed. With its special armour and well-muscled neck, Tortikoli is immune!');
INSERT INTO "item_descriptions" VALUES(25752,'en','"Do you know how to tell the difference between a mouse and a rat? It''s very easy. Even if it''s huge and voracious, if the rodent is in your house, it''s a mouse. And no matter how small and shy it is, if the rodent is in my house, it''s a rat."');
INSERT INTO "item_descriptions" VALUES(25753,'en','A white rat said to one of his kind: "I''ve trained my psychologist very well. Every time I ring a bell, he brings me something to eat."');
INSERT INTO "item_descriptions" VALUES(25952,'en','Adventurer, prepare to play the match of your life!

Once a Gobbowler, always a Gobbowler!');
INSERT INTO "item_descriptions" VALUES(26006,'en','How can you tell a good Destroyer from a bad Destroyer? Bad Destroyers have spikes and tentacles; if they see something moving, they destroy it. When good Destroyers see something moving, they destroy it... but they''re good Destroyers!');
INSERT INTO "item_descriptions" VALUES(26007,'en','According to the rather odd craftsman who made this glove, "There is no such thing as art without the demon''s collaboration." Luckily, you''ve never understood art.');
INSERT INTO "item_descriptions" VALUES(26008,'en','The Nightmare is a perfect place for Destroyers because they can give in to their nastiest urges: killing, destroying, pillaging, torturing and other similar acts, such as speaking backwards or drinking non-alcoholic beer.');
INSERT INTO "item_descriptions" VALUES(26009,'en','"The angel differs from the devil by a reflection that did not yet appear to him."

Paul Yrelav, "Tales of Dawn"');
INSERT INTO "item_descriptions" VALUES(26010,'en','"So, whether the world is going to pieces or not, whether you are on the side of the angels or the devil himself, take life for what it is, have fun, spread joy and confusion."

— Henry "Mewler" Valentine, "Tales of Dawn"');
INSERT INTO "item_descriptions" VALUES(26011,'en','"Actual life was chaos, but there was something terribly logical in the imagination."

— Oskar Wyld');
INSERT INTO "item_descriptions" VALUES(26018,'en','"Septangel 12 of the year 26. The dawn was cold, and light could barely penetrate the morning gloom. The Bontarian outposts, held by the knights of the Order, were white with the first signs of frost, the sentinels numb from the early onset of winter. They huddled around the braziers, trying in vain to warm up. The forest, whose multitude of little noises usually started rustling to life at this hour of the morning, was completely silent but for a cry that had been heard several times during the night. At first, the sentinels had paid it no heed, but now they squinted into the distance towards its apparent source in the south. The cry – which they couldn''t believe had come from the throat of any ordinary creature – was getting closer.

"Crimson Dawn: Found Fragments, Volume IX"');
INSERT INTO "item_descriptions" VALUES(26019,'en','"At his command, the ghosts of the knights of the Order of the Valiant Heart arose. Their discarded armour hit the ground with metallic clangs and thuds. Burnt, flayed and cut, they all bore gaping wounds. Raval walked through the ranks in silence, then pointed towards the Brakmarian army. Hyrkul''s troops had reached the gates of Bonta. Any minute now, they were sure to give way to the Trools'' steady hammering. Militia men under Jiva''s command had formed a wall of armour. But goblins were already trying to sneak in through the gaps in the door, which were widening with each passing second. Hyrkul had put his sword back in its sheath and was striking heavy blows with his mace. All of a sudden, he paused mid-motion, and turned back as though someone had called out to him..."

"Crimson Dawn: Found Fragments, Volume X"');
INSERT INTO "item_descriptions" VALUES(26020,'en','"Cries of distress were coming from the rear. The huge warrior, taken aback, paused to listen carefully. But it was not the cries of fear that worried him. He had cast his eyes to the south. There, he saw his troops being overcome by the knights of the Order – the very knights he had killed with his black lightning! A white tide rolled slowly over the Brakmarians. Just then, Bonta''s horns rang out. Jiva had opened up the doors and the militia was moving forward to take on the Brakmarian troops, taking back the ground that had been conquered, metre by metre."

"Crimson Dawn: Found Fragments, Volume X"');
INSERT INTO "item_descriptions" VALUES(26021,'en','"My name is Hyrkul, and it''ll follow you into the other world, centaur!" roared the enemy, and both of them rushed forward to strike. In less than a second, everything was over. Menalt brandished his spear, whose point glowed with white fire. He lunged forward, aiming at the hollow of the throat where there was just enough space between the plates of black armour for his blow to be lethal. But the warrior dodged and the spear jabbed uselessly into the darkness. Hyrkul''s wide, shadowy wings swirled to lash and blind his opponent. Before the centaur could launch a second attack, Hyrkul grabbed his spear in one hand, and his throat in the other. They both bellowed – one in rage and the other in pain. A blaze of lightning sprang from the black helmet, hitting Menalt in the face for a few seconds that seemed like an eternity. Then the warrior pushed the stunned and twitching centaur back to deliver the deathblow. He twirled his sword; the blade spun with a whistling sound and cut swiftly downwards. Menalt dropped noiselessly into the dust."

"Crimson Dawn: Found Fragments, Volume X"');
INSERT INTO "item_descriptions" VALUES(26022,'en','"A dragon of black lightning materialised from the end of Hyrkul''s sword. The beast reared up to its full height, towering over them all. It then dove downwards through the Bontarian troops. They caught fire instantly. Knights fell one after the other, and the other Bontarian warriors were blown away by the explosion. Pouchecot only survived thanks to his magic. He shot roots deep down into the earth, like a hundred-year-old tree. The battlefield was strewn with the cracked armour of fallen knights. A freezing rain started to pour down. The Brakmarian troops started to make their way towards Bonta. Hyrkul turned to face the gigantic tree that Pouchecot had become. His transformation had protected him from danger, but also prevented him from moving. The black giant roared with spine-chilling laughter.

''I shall carve your coffin in your own wood, Pouchecot! But first... I want to see Jiva''s head hanging in your branches!'' He spat and strode away to join his army. The fortified walls of Bonta stood out in the distance, as pale as chalk."

"Crimson Dawn: Found Fragments, Volume X"');
INSERT INTO "item_descriptions" VALUES(26023,'en','"He struggled to extricate himself from the fray, and, knowing the battle was lost, Hyrkul glanced one last time at Bonta, so close, before fleeing towards the Treechnid Forest. He may not have been victorious, but now he knew for sure that Bonta did not have any Dofus. Jiva and Pouchecot would not have hesitated to brandish them at the battle''s most critical moment, to show their power and scare the Brakmarian troops away... This simple detail was worth all the losses the troops of Brakmar had borne... Hyrkul disappeared into the dark forest."

"Crimson Dawn: Found Fragments, Volume X"');
INSERT INTO "item_descriptions" VALUES(26058,'en','The humblest of objects sometimes conceal the most wondrous of powers.');
INSERT INTO "item_descriptions" VALUES(26066,'en','"Night is dark so that nothing can distract us from our nightmares," said young Kilvan before going to sleep, comforted by his stuffed chtiger.
Why is night so dark? Because it hides within itself all the fears and mysteries contained in the eternighty. Bejabers, red coals and bronze glyphs mingle and merge in the cradle of good and evil, the source of an eternally revived conflict.');
INSERT INTO "item_descriptions" VALUES(26085,'en','To capture a bad dream without weakening its influence, there''s nothing quite like a demonic nightmare catcher.');
INSERT INTO "item_descriptions" VALUES(26099,'en','Similar to the weapon borne by the tragically famous Aermyne, Ayuto''s rolling pin is said to have been sculpted by Maimane. Does it hold some weighty secret? That might explain why it''s so incredibly heavy.');
INSERT INTO "item_descriptions" VALUES(26131,'en','Though much despised by vampires, this Enutrof shovel is highly prized by exorcists and the froogs that live in holy water basins. It has more than proven its worth in any number of conjuring rituals.');
INSERT INTO "item_descriptions" VALUES(26198,'en','This pick isn''t made for combat. It is very effective for mining even the toughest materials, but it''s quite hard to handle and extremely fragile. One good hit on a hard surface and it''ll break.');
INSERT INTO "item_descriptions" VALUES(26308,'en','This ring is imbued with the power of Malters, dark creatures capable of melting into the omnipresent obscurity of the Evil Forest. Unfortunately for you, its stealth power doesn''t work on Twelvians.
As a side note, there''s a rumour that a certain gobbowl player on the Bonta Blues team once tried to sneak into the women''s locker room wearing this ring. When he came out, the black and blue bruises covering his face clashed horribly with the blue of his jersey.');
INSERT INTO "item_descriptions" VALUES(26309,'en','These boots give off the faint sound of rustling through dry leaves with every step you take, making every stroll a relaxing jaunt.');
INSERT INTO "item_descriptions" VALUES(26310,'en','Malters use this vegetal scythe made from woven brambles to punish dissident Malteregos. The angle of the thorns makes it impossible to pull it out of its target''s body without causing incredible physical suffering.');
INSERT INTO "item_descriptions" VALUES(26311,'en','Slip this ring on your finger to feel Hell Mina''s burning fury. Just imagine what it''d feel like to don the full set!');
INSERT INTO "item_descriptions" VALUES(26313,'en','This well-made cape will make you look triumphant during battle – the perfect accessory to accompany the burning determination contained in each of your blows.');
INSERT INTO "item_descriptions" VALUES(26314,'en','They say that Dark Vlad himself lit the eternal flame that flickers at the end of Hell Mina''s partisan. You''ve managed to procure a copy for yourself. We strongly recommend practicing excellent weapon care by regularly coating it in petroolleum.');
INSERT INTO "item_descriptions" VALUES(26336,'en','By putting on this patched headgear, you too will be able to accomplish all the exploits goblin magi are famous for: making socks disappear, brewing up questionable potions... And so much more!');
INSERT INTO "item_descriptions" VALUES(26337,'en','Be ready for Wittika the goblin''s reaction if you go to the Temple of Scriptures wearing these boots – they''re a likely reminder of certain traumatic events from his adolescence.
More times than he cares to remember, a practical joke that made too much noise was quickly followed by the sound of Director Grunob''s footsteps echoing down the hallways of the Akademy heralding the start of a stern and memorable lecture.');
INSERT INTO "item_descriptions" VALUES(26343,'en','A strip of orange fabric dyed with cawwot extracts. It''s covered with bow meow hairs of the same colour. Do you think it''d be possible to dye a whole bow meow to go with your look?');
INSERT INTO "item_descriptions" VALUES(26344,'en','The masterfully shaped blade makes this the perfect tool for scraping dried-out bogeys off the underside of tables.');
INSERT INTO "item_descriptions" VALUES(26366,'en','Created thousands of years ago, this magic ring looks as new as the day it was made. It won''t make you invisible or turn you into a lord. But it will be useful if you need to honour the forest dragon''s solemn vow. So try not to lose it and don''t let it get all banged up at the bottom of your bag.');
INSERT INTO "item_descriptions" VALUES(27265,'en','This brooch seems to be the template for the famous amulet crafted by Boulgur, blacksmith to the gods.');
INSERT INTO "item_descriptions" VALUES(27266,'en','This belt is delightfully light, but very fragile: keep it well away from water. If you get it wet, it won''t hide anything at all. And no one wants to see that!');
INSERT INTO "item_descriptions" VALUES(27267,'en','Everyone knows this legendary cloak. But did you know there''s a khardboard version that you can even paint blue?');
INSERT INTO "item_descriptions" VALUES(27268,'en','The Khardboard Goultard sword''s been soaked in the blood of piglets so it''s a bit soft and smells a bit like black pudding.');
INSERT INTO "item_descriptions" VALUES(27278,'en','These khardboard getas were crafted by the best khardboard makers in the World of Twelve. Be careful not to step in any puddles with them on. Getting them wet voids the warranty.');
INSERT INTO "item_descriptions" VALUES(27280,'en','This buckle symbolises renewal. Made entirely of recycled khardboard, it can be remade every time it''s destroyed.');
INSERT INTO "item_descriptions" VALUES(27282,'en','What''s more iconic than this headgear? Absolutely nothing. Except maybe the version not made of khardboard.');
INSERT INTO "item_descriptions" VALUES(27284,'en','Everyone knows certain items. And the Gelano is the best-known of them all. Often imitated, but never equalled, it is an unattainable goal for many. You''ve managed to get your hands on a pale imitation – and it should do for now.');
INSERT INTO "item_descriptions" VALUES(27431,'en','This gobbly has followed you from Incarnam to help you as you make your first steps in the World of Twelve. He''s still a bit puny, but he''ll do his best to help you break in your weapons.');
INSERT INTO "item_descriptions" VALUES(27510,'en','If someone tries to steal your things, the Claymomore will kill them in one fell swoop and suck their soul from them like an ominous black storm-bringing sword. At least, that''s what was written in big letters on the instructions that came with the weapon, right above the safety precautions and the no-liability clause in the event of accidental disembowelling.');
INSERT INTO "item_descriptions" VALUES(27511,'en','You''ve already seen his mask, so now, here''s Cire''s helmet. Does this helmet contain macabre magic – as the pale glow coming from it seems to suggest – or does it simply smell musty? You''d have to try it on to find out for sure... but if you start crying your eyes out and just can''t stop, don''t bother complaining.');
INSERT INTO "item_descriptions" VALUES(27512,'en','This dark and twisted cloak is said to be woven from the cries of Cire Momore''s victims. Being trapped in a suit of armour for centuries would make anyone want to scream.');
INSERT INTO "item_descriptions" VALUES(27513,'en','"...!"

— Cire Momore, seeing stars.');
INSERT INTO "item_descriptions" VALUES(27514,'en','"He who fights and runs away may live to die sometime today" – those were the last words of a fable writer who was always making things up. Fate – and Cire Momore, it seems – caught up with him.');
INSERT INTO "item_descriptions" VALUES(27515,'en','There was a Iop who led a hectic life, burning the candle at both ends. He claimed to have found a hidden treasure on a cursed island and to have defeated its guardian. As proof, he brandished a ring taken from the monster''s finger as a trophy.
One day, the Iop was found burnt to ashes among the ruins of his manor; a lit candle was apparently the cause of the fire. A sad lot for a sad sot.');
INSERT INTO "item_descriptions" VALUES(27522,'en','Do you have any idea how many timongooses had to be skinned to make these boots? Raccooper does... and it was far, far too many.');
INSERT INTO "item_descriptions" VALUES(27523,'en','This is actually just a large assortment of furs sewn roughly together. So if the spirit moves you, you could also turn them into a coat, a scarf, or even a loincloth...');
INSERT INTO "item_descriptions" VALUES(27524,'en','This eco-friendly ring was roughly carved from a pine branch and is stamped with a loutbear symbol. That way, you''ll know what these creatures look like before venturing into their territory to look for resources.');
INSERT INTO "item_descriptions" VALUES(27525,'en','The blacksmith Barb Umpy worked stubbin'' hard to create this full-face helmet. It is solid, original and rustproof, and it even comes with a lifetime guarantee. Pop it on and run screaming towards your enemies – you''re sure to be beard!');
INSERT INTO "item_descriptions" VALUES(27526,'en','Certain persistent rumours claim that Berylbell wanted to put a ring on Tom Stumb''s finger. So she forged a metal ring in his likeness that was both an offering and a symbol of a promising partnership. Sadly, the librarian turned down her proposal, claiming that he wasn''t really on the same page. Lady Copperbeard was left empty-handed... but chances are she hasn''t said her last word on the subject.');
INSERT INTO "item_descriptions" VALUES(27527,'en','The height of Albueran fashion, this cap topped with an authentic Raccooper tail will turn the workers in the colony green with envy.');
INSERT INTO "item_descriptions" VALUES(27528,'en','At first glance, this mace looks like something straight out of Fleaster Island... But when it comes down hard on an enemy''s head, the crunchy bits flying around won''t be from a crispy chocolatey shell.');
INSERT INTO "item_descriptions" VALUES(27529,'en','Raccooper''s fur is thick enough to protect him from the brutal cold during his many long walks in the heights of the Snowbound Timberland. Among other things, that makes it easy for him to perch high in a tree and spy on Twelvians to his heart''s content.');
INSERT INTO "item_descriptions" VALUES(27530,'en','Raccooper never parts with his XXL-sized billhook, a tool that his family has passed down between generations. It lets him fight and pick adventurers'' pockets, not to mention move freely over the steepest walls.');
INSERT INTO "item_descriptions" VALUES(27531,'en','This amulet is very popular among the Albuera guard and gives its bearer a definite advantage in the many skirmishes with the local wildlife.');
INSERT INTO "item_descriptions" VALUES(27532,'en','This ring was specifically designed not to interfere with the wearer''s movements while handling a lance. As you can imagine, sprained ring fingers are common with weapons this heavy.');
INSERT INTO "item_descriptions" VALUES(27533,'en','Many young Forgelance initiates are issued a lance like this as part of their training. Strong, lightweight and well-balanced, it''s an ideal weapon for getting used to handling a lance as the first step in specialising in a specific style of combat.');
INSERT INTO "item_descriptions" VALUES(27534,'en','This weapon has saved the lives of more than one hunter from the colony. Not only does it have a handguard that keeps the wielder''s fingers warm, but it will also let you reach a loutbear while keeping you out of reach of its claws.');
INSERT INTO "item_descriptions" VALUES(27535,'en','A belt crafted by trappers from the colony of Albuera to keep their trousers up even in the wildest storms.');
INSERT INTO "item_descriptions" VALUES(27536,'en','Tough yet cosy leather boots to keep your toes from freezing in the snow.');
INSERT INTO "item_descriptions" VALUES(27537,'en','If a bitter old bugger with bats in his belfry tries to put a boot in your behind for burgling his bounty, boldly break out this bitter-shield to bounce back his blows, and we bet he''ll think better of it.');
INSERT INTO "item_descriptions" VALUES(27538,'en','When a Bitter-Hammer turns 77, they collar their friends to come and celebrate until they''re up to their neck in gifts.');
INSERT INTO "item_descriptions" VALUES(27539,'en','This crescent-shaped weapon would make any warrior interested in astronomy most happy. Don''t be fooled, though – if an Ereborian Bylhuk tells you you''re going to the moon, it won''t be to see whether it''s made of cheese. The Reaper can take on many guises, but it''s always the same outcome: you''ll get nothing but a one-way ticket to the Grey Country.');
INSERT INTO "item_descriptions" VALUES(27540,'en','This hammer, which is typical of the Stubbyobs living in the tunnels of Ereboria, has many uses. You can whack, bang, hit, break, smash, nail, pound, pulverise, crush and – obviously – hammer with it. It''s a yobligatory and universal tool that works well in anyone''s hands, as long as they aren''t too attached to their fingers.');
INSERT INTO "item_descriptions" VALUES(27541,'en','Jokes abound when adventurers challenge Berylbell in her stronghold. "She''s gonna knock seven bells out of you!" "She''ll ring your bells!" "She''s as sound as a bell!" They all stop ringing once the Stubbyob''s fists have spoken. To bell with subtlety.');
INSERT INTO "item_descriptions" VALUES(27542,'en','You have to wonder what could inspire the guardian of Ereboria to wear an item of clothing more commonly associated with one of Srambad''s less reputable sports. Are Stubbyobs really a nation of wrestling fans? Not that it really stubbin'' matters. You can''t judge a book by its yobber, and Berylbell does what she wants anyhow. After all, she''s the one who wears the pants in the Bitter-Hammer clan! She''s not trying to be a pain in the rear... quite the opposite, in fact.');
INSERT INTO "item_descriptions" VALUES(27543,'en','A few winters back, when the Bitter-Hammers were despairing of ever returning home, a Pandawa marched into the tunnels of Ereboria to give Berylbell Copperbeard a piece of her mind. A storm was brewing in her stern, black-ringed eyes. She was a master of a unique variant of the art of Pandawushu.
The two warriors had already fought many battles, and this confrontation went on for a long time. A very long time. Such a long time, in fact, that the Stubbyobs who had gathered around to cheer on their leader eventually yobbed off to sleep. When they opened their eyes, startled awake by the sound of their own snoring, the disciple of the Big Bear and the daughter of the Smith were saluting each other with great respect. They exchanged weapons. Their pitched battle had ended in a draw, and yet Berylbell''s face was lit up with a smile. The dark clouds of discouragement had cleared.
Ever since that day, Berylbell has carefully preserved her honourable adversary''s tonfas as both a souvenir and trophy. Who would have thought she could be so sentimental?');
INSERT INTO "item_descriptions" VALUES(27544,'en','When you''re village chief, even the heaviest shield doesn''t have to be just for protection or for showing off. For example, this one seems to have been designed by a Crackler who took one too many rocks to the head as a child. Chiselled from a block of bramblestone, it will truly be the jewel of your collection.');
INSERT INTO "item_descriptions" VALUES(27545,'en','According to popular belief, the executioner of the ancient kingdom of Ephedrya wielded an axe called Gallows. He would stand next to the pillars of justice, impassive, still as a statue, only lifting his heavy weapon to shorten by a head those bull-headed enough to try and step ahead of the queen. Those were the good old days.');
INSERT INTO "item_descriptions" VALUES(27546,'en','This lance was sculpted in honour of Ephedrya''s famous pillars of justice. Well, they WERE famous, back when they were used as a gallows. Nowadays, everyone has forgotten them, and the gentle aroma of corpses rotting in the sun for everyone to see has been replaced by the scent of belladonna. Of course, since the leaves of that plant have an especially putrid odour, it doesn''t make that much difference in the end.');
INSERT INTO "item_descriptions" VALUES(27547,'en','"They say witches are wicked and cruel. They boil children in cauldrons, tear the wings off butterflies, stick needles under innocents'' nails and do business with shushus. Personally, I''m not like that. I love flowers, for example. Oleander petals are a delight to behold. If it were up to me, every pleasure garden would have some."

— Belladonna, the evil witch of Ephedrya');
INSERT INTO "item_descriptions" VALUES(27548,'en','"A faceless god decreed that we must submit to the passage of time. The hourglass of our existence slowly drains. In the end, nought remains but a few grains of bitterness in a gaping void. What an excruciating waste."

— Belladonna, the evil witch of Ephedrya');
INSERT INTO "item_descriptions" VALUES(27549,'en','"The World of Twelve is beautiful, not despite its sorrows, but because of them. There could be no joy without pain, no tenderness without loneliness. It''s how things are. And it''s a good thing."

— Belladonna, the evil witch of Ephedrya');
INSERT INTO "item_descriptions" VALUES(27551,'en','Although this helm makes you look like a villain, it''s actually the hallmark of great heroes whose epic feats will make the real monsters tremble.');
INSERT INTO "item_descriptions" VALUES(27552,'en','When a Forgelance dies, they are buried with some of their equipment placed all around them so that it will stay by their side in death. The cloak, which bears the scars of their battles, thus serves as a shroud and bears witness to a heroic life.');
INSERT INTO "item_descriptions" VALUES(27553,'en','Contrary to what you might think, this metal harness can be adjusted as you like and adapts to every person''s shape. We mustn''t forget that all bodies are beautiful and that feasting all over the world is also a story worth telling.');
INSERT INTO "item_descriptions" VALUES(27554,'en','As tradition dictates, during their lifetime or after death, a Forgelance can bequeath their personal belongings to a friend, a brother-in-arms or a member of their family. Unfortunately, when it comes to hosiery, there are many times when the size doesn''t quite fit and – as if that weren''t bad enough – you can still smell the feet of the dearly departed. Still, it''s a great source of pride for whoever inherits it.');
INSERT INTO "item_descriptions" VALUES(27555,'en','Forgelances attach particular symbolism to their gloves because they protect their hands, which are the symbol of their ability to seize their destiny and shape the world as they see fit, whether it be through battle or crafting.');
INSERT INTO "item_descriptions" VALUES(27644,'en','This bow once belonged to a legendary warrior who specialised in tracking automatons and other monstwous wobots. Supposedly, she defeated Sylargh himself; he was wounded by a single arrow of the archer with blazing red hair. He''s had trouble sitting ever since.

"It''s not about some distant hope of creating a new world... It''s about preserving the one we already have."
— The red-haired huntress');
INSERT INTO "item_descriptions" VALUES(27645,'en','This broom was found in the sawmill; it is used to sweep up the piles of wood shavings all over the floor.');
INSERT INTO "item_descriptions" VALUES(27803,'en','This pine cone is an authentic dragon egg. No really, a goblin told you so!
...
You''ll believe just about anything, won''t you?
...
Well, just to be sure, you''d better take good care of this item – you never know.');
INSERT INTO "item_descriptions" VALUES(29024,'en','Invented by a crafter whose ears were constantly buzzing, this weapon is effective not only against moskitos, but anyone who needs a swat.');
INSERT INTO "item_descriptions" VALUES(29110,'en','Once carried by Solar, the Menologium lets you not only deal with pressing matters, but it also manage the cycle of the seasons, which can be handy when dealing with climatic disturbances, temporal anomalies and time-consuming larvae. Oh, and it''s also the best way to shield yourself from the hammer attacks of angry Protectors.');
INSERT INTO "item_descriptions" VALUES(29133,'en','When you''re preparing to confront a force of nature corrupted by an eliocalyptic power, a divine blessing is every bit as important as caramel sauce on your vanilla ice cream: strictly indispensable.');
INSERT INTO "item_descriptions" VALUES(29134,'en','This Dofus was born of a promise made long ago, before the seasons laid the rhythm to the world''s dance through the void. Will you show yourself worthy of carrying it?');
INSERT INTO "item_descriptions" VALUES(29135,'en','To heal an immortal consumed by corruption, nothing beats the power of a goddess combined with the power of a Dofus in the hands of an egg-collecting adventurer.');
INSERT INTO "item_descriptions" VALUES(29136,'en','The sacrificial fruit sows the seeds of renewal. Whether painful metamorphosis, natural healing, or a simple passage of time, the end of an interminable winter is always a miracle.');
INSERT INTO "item_descriptions" VALUES(1029430,'en','An old legend told by historians of the Third Age claims that Mamukils used to have four tusks. Fascinating truth, or just a fable for children and fools who can''t count past two? Let the scholars fight it out in the arenas of the Kolossium.');
INSERT INTO "item_descriptions" VALUES(1029431,'en','After leading his troops across a river, the Great Lexander defeated King Sporo and stole his kolophants. These massive creatures were not only much more intelligent than dragoturkeys – their eyes also consistently pointed in the same direction. With war mounts like these, Lexander was ready to conquer the World of Ten! But alas, his time ran out too soon, as he fell victim to a severe fever three years later. It turns out that tiny creatures invisible to the naked eye can be every bit as deadly as kolophants.');
INSERT INTO "item_descriptions" VALUES(1029432,'en','The fur covering the kolophants of Tarkaj is not natural. In fact, it''s a thick mastostroke pelt cut to size. This hirsute blanket was created on the orders of Kanigal, a brilliant tactician in ancient times. It seemed that the general wanted to cross a mountain range with his army. His mastodons were sure-footed, but highly sensitive to cold. So Kanigal found a solution that enabled him to literally crush his enemies. When it comes to winning in battle, military genius knows no bounds.');
INSERT INTO "item_descriptions" VALUES(1029433,'en','In the inns of Madrestam, drinkers tell tales of a gigantic Zenusha wandering the seas with an island on its back. Its legs are so long that it doesn''t need to swim. It feels along the ocean floor with its trunk. But what is it searching for? The pirate king''s crown? A long-submerged chest? To find a treasure hidden that far beneath the waves, this kolophant would have to get incredibly lucky.');
INSERT INTO "item_descriptions" VALUES(1029434,'en','Often used by scouts patrolling the edges of the swamp, this agile reptile is more ferocious than a crocodyl with a toothache. Tenacious and sneaky, it''s not afraid of a fight... but it can also slip away like an eel, only to come back and finish the job when you''re least expecting it.');
INSERT INTO "item_descriptions" VALUES(1029435,'en','Have a hard time taking the initiative? Climb on this imposing snake''s back, and your wallflower days will be a thing of the past! And don''t be afraid that this mount will slow you down: the kobrapid is living proof that a well-styled head is more important than having legs.');
INSERT INTO "item_descriptions" VALUES(1029456,'en','As an extraordinary bird once said, "To fly as fast as thought, to anywhere that is, you must begin by knowing that you have already arrived." The truly spiritual words of a soul that refused to be weighed down by convention or taboo. Maybe that''s why you feel as light as a feather when riding on your Kwismas gull.');
INSERT INTO "item_descriptions" VALUES(29463,'en','Often seen on the arms of Bontarian soldiers, this shield is instantly recognisable by its fine detailing, the quality of its wood, its perfect curves, its... Oh... hang on... Sorry, this one''s just an especially good replica. The artisan who crafted it must have been blessed by Jember.');
INSERT INTO "item_descriptions" VALUES(30356,'en','With this Dofus granted by the guardians of Ankama, you can say "I was there!" and enjoy the fun side of nostalgia without feeling too old. See you again in twenty years?');
INSERT INTO "item_descriptions" VALUES(44,'fr','Épée de simple facture, elle ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(49,'fr','Une épée bien forgée, intéressante pour les novices.');
INSERT INTO "item_descriptions" VALUES(55,'fr','Cette épée très prisée des jeunes Iops vous permettra peut-être de faire vos preuves. Mais attention, ne vous attachez pas à elle, car on finit toujours par perdre l''épée d''Alle.');
INSERT INTO "item_descriptions" VALUES(58,'fr','Il s''agit d''une épée ayant baigné dans les larmes d''un jeune Mulou. Beaucoup de guerriers pensent qu''ainsi bénie, leur arme apportera chance et courage sur les champs de bataille.');
INSERT INTO "item_descriptions" VALUES(62,'fr','Conçue par un forgeron qui voyait double, cette épée est très populaire à Brâkmar. Il n''y a pas un milicien qui ne s''écrie « Je veux mon épée d''Ha ! » Sa seule vue fait loucher le plus courageux des adversaires.');
INSERT INTO "item_descriptions" VALUES(65,'fr','L''épée Goultard a été trempée dans le sang d''un Dragon Cochon. Le héros qui supportera l''odeur dégagée par cette puissante épée pourra se hisser à la hauteur des plus grands.');
INSERT INTO "item_descriptions" VALUES(66,'fr','Cette épée appartenait au célèbre Badoul, vaillant guerrier ayant perdu la boule lors d''un combat.');
INSERT INTO "item_descriptions" VALUES(67,'fr','Tranchante et infernale : tels ont été les mots de la succube qui l''a forgée. À moins que ce ne soit les mots utilisés par Vald pour décrire sa sœur, plus personne ne sait.');
INSERT INTO "item_descriptions" VALUES(70,'fr','Cette amulette augmente l''intelligence de son porteur.');
INSERT INTO "item_descriptions" VALUES(77,'fr','Cette amulette augmente la force de son porteur.');
INSERT INTO "item_descriptions" VALUES(84,'fr','Cette amulette augmente la vitalité de son porteur.');
INSERT INTO "item_descriptions" VALUES(91,'fr','Arc de simple facture, il ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(97,'fr','Dagues de simple facture, elles ne feront pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(103,'fr','Cet anneau renforce la sagesse de son porteur.');
INSERT INTO "item_descriptions" VALUES(112,'fr','Cet anneau renforce la chance de son porteur.');
INSERT INTO "item_descriptions" VALUES(121,'fr','Cet anneau augmente l''agilité de son porteur.');
INSERT INTO "item_descriptions" VALUES(127,'fr','Ces bottes exceptionnelles vous permettront de gagner un point de mouvement durant les combats.
Attention cependant aux odeurs qu''elles dégagent, car elles ont appartenu au tristement célèbre Bowisse.');
INSERT INTO "item_descriptions" VALUES(130,'fr','Ces bottes sont idéales lorsqu''il s''agit d''asséner un coup de grâce.');
INSERT INTO "item_descriptions" VALUES(134,'fr','Baguette de simple facture, elle ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(140,'fr','Bâton de simple facture, il ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(147,'fr','Marteau de simple facture, il ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(153,'fr','Pelle de simple facture, elle ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(156,'fr','La Ceinture de Puissance rend son porteur particulièrement puissant lors des combats, mais son poids réduit de manière conséquente son agilité.');
INSERT INTO "item_descriptions" VALUES(157,'fr','La Gougnole a été créée dans de la pierre de lune ayant trempé 5000 ans dans un baril de bière. Inévitablement, cela lui a conféré de terribles pouvoirs.');
INSERT INTO "item_descriptions" VALUES(158,'fr','La Destinée Dorée permet au héros qui la porte d''augmenter considérablement sa vitalité et son agilité.');
INSERT INTO "item_descriptions" VALUES(159,'fr','On dit que cette broche a été créée par l''illustre forgeron Boulgur, qui a la réputation de forger les armes des dieux.');
INSERT INTO "item_descriptions" VALUES(160,'fr','Cet objet a été moulé à partir d''un mélange d''œufs célestes et de poussières d''étoiles lactées. À conserver au frais.');
INSERT INTO "item_descriptions" VALUES(161,'fr','Cette puissante amulette a tout pour rendre son porteur célèbre.');
INSERT INTO "item_descriptions" VALUES(165,'fr','Une baguette bien sculptée, intéressante pour les novices.');
INSERT INTO "item_descriptions" VALUES(180,'fr','Cette baguette provient des Limbes de Syrastass. La légende raconte qu''elle permet de faire fleurir des champs entiers de pâquerettes à la simple demande de son porteur.');
INSERT INTO "item_descriptions" VALUES(181,'fr','Cette baguette fut bénie par Helle du haut des cieux. Elle procure à son porteur agilité et vitalité dans les batailles.');
INSERT INTO "item_descriptions" VALUES(183,'fr','Un bâton bien taillé, intéressant pour les novices.');
INSERT INTO "item_descriptions" VALUES(188,'fr','Ce bâton augmente la sagesse de son porteur. Peut entraîner une hypertrophie.');
INSERT INTO "item_descriptions" VALUES(194,'fr','Ce bâton augmente la vitalité de son porteur et peut, le cas échéant, être mangé.');
INSERT INTO "item_descriptions" VALUES(200,'fr','Le God Rod est une arme terrible. Très puissant, il permet à son porteur de se montrer digne des meilleurs lorsqu''il a une petite baisse de régime.');
INSERT INTO "item_descriptions" VALUES(201,'fr','Le Hook a été retrouvé sur un cadavre, près d''un énorme Crocodaille en décomposition.');
INSERT INTO "item_descriptions" VALUES(202,'fr','Cette épée a été bénie par les larmes de l''ange Raziel. Terriblement destructrice elle est suffisamment puissante pour permettre à son porteur d''affronter le plus terrible des adversaires.');
INSERT INTO "item_descriptions" VALUES(203,'fr','Si vous avez ce formidable objet autour des reins, c''est que vous êtes l''un des héros les plus chanceux de cet univers. Cette ceinture appartenait au héros barbu le plus fort et séduisant de tous les temps.');
INSERT INTO "item_descriptions" VALUES(204,'fr','Ce bâton vivant a traîné dans les endroits les plus sombres de l''univers d''Amakna. Il se réveille tous les 300 ans pour changer d''endroit ou de propriétaire, préférant emprunter les petits tunnels tout sombres, qui ne sentent pas très bon.');
INSERT INTO "item_descriptions" VALUES(208,'fr','Des dagues bien forgées, intéressantes pour les novices.');
INSERT INTO "item_descriptions" VALUES(214,'fr','D''excellente facture, les Dagues de Croclage feront de vous un vaillant combattant.');
INSERT INTO "item_descriptions" VALUES(218,'fr','Les Bashers sont de redoutables dagues d''assassin. Celui qui les possède est capable de rivaliser avec le plus sanguinaire des guerriers.');
INSERT INTO "item_descriptions" VALUES(219,'fr','Les Blessdags viennent du célèbre Ogre la Main Sombre qui périt en affrontant un paladin du Bimd''Oule. Il paraît que son sang anime ces dagues malsaines.');
INSERT INTO "item_descriptions" VALUES(220,'fr','Chakra Style est une paire de dagues ayant appartenu à l''une des plus grandes voleuses de tous les temps. Chakra fut la première à pouvoir forcer les portes du temple d''Osaroth et à y dérober de précieuses reliques.');
INSERT INTO "item_descriptions" VALUES(224,'fr','Un marteau bien travaillé, intéressant pour les novices.');
INSERT INTO "item_descriptions" VALUES(230,'fr','Ce marteau augmente l''intelligence du héros qui le porte.');
INSERT INTO "item_descriptions" VALUES(233,'fr','Kaiser est le nom d''un Dragon Cochon qui jadis dévasta le village de Bounkaïda. Lorsque la milice eut enfin raison du monstre, les forgerons créèrent de nombreuses armes à partir des restes de la bête. Ce marteau en fait partie.');
INSERT INTO "item_descriptions" VALUES(234,'fr','Le Ragnarok est un marteau très puissant, capable de déchaîner des tempêtes ou les foudres de vos alliés si vous leur tapez dessus.');
INSERT INTO "item_descriptions" VALUES(235,'fr','Ce marteau était détenu par le gardien de la Porte des Enfers. Il empêchait les vivants d''y entrer, les morts d''en sortir et les morts-vivants de bouger.');
INSERT INTO "item_descriptions" VALUES(236,'fr','Barabas est redoutable : il permet à son porteur de se déplacer plus facilement, et surtout d''être plus efficace en combat rapproché.');
INSERT INTO "item_descriptions" VALUES(237,'fr','Sargasse était détenue par un enfant aux terribles pouvoirs. On ne sait pas ce qu''est devenue cette arme lorsqu''elle fut échangée à un aventurier contre un sac de billes.');
INSERT INTO "item_descriptions" VALUES(241,'fr','Une pelle bien équilibrée, intéressante pour les novices.');
INSERT INTO "item_descriptions" VALUES(247,'fr','D''excellente facture, la pelle de rapage fera de vous un vaillant combattant.');
INSERT INTO "item_descriptions" VALUES(250,'fr','Mi-hache, mi-pelle, Ares fut l''une des sept armes utilisées par le démon Kajlir pour venir à bout de la Confrérie des Enutrofs collectionneurs de Dofus Pourpres.');
INSERT INTO "item_descriptions" VALUES(251,'fr','Barbe Grise était l''arme favorite du démon nain Assan Cehef, qui terrorisa de nombreux villageois, attaquant sans crier "gare", ni "train".');
INSERT INTO "item_descriptions" VALUES(255,'fr','Cette ceinture augmente la vie de son porteur, pour plus de sûreté en plein combat.');
INSERT INTO "item_descriptions" VALUES(259,'fr','Cette ceinture augmente la force de son porteur.');
INSERT INTO "item_descriptions" VALUES(263,'fr','Cette ceinture augmente l''agilité de son porteur.');
INSERT INTO "item_descriptions" VALUES(267,'fr','L''arc déroutant est un objet de base, mais son utilité n''est pas à négliger.');
INSERT INTO "item_descriptions" VALUES(270,'fr','Le Xaveur est un arc efficace. Il appartenait au grand Xavier le Boulanger. Entre deux fournées, il partait distribuer des pains aux monstres entourant sa boulangerie.');
INSERT INTO "item_descriptions" VALUES(271,'fr','Une belle arme étrange et fascinante, elle vous permettra de vous battre au corps à corps comme le ferait le meilleur des Chafers.');
INSERT INTO "item_descriptions" VALUES(272,'fr','Cet arc est assez puissant pour envoyer une flèche sur la lune.');
INSERT INTO "item_descriptions" VALUES(273,'fr','La Corde de Yamato a fait vibrer plus d''un cœur de monstre. Arme fine, elle est capable de diriger sa flèche dans les endroits les plus cachés.');
INSERT INTO "item_descriptions" VALUES(278,'fr','Anneau serti d''une pierre rare. Il doit son nom aux différentes pierres nécessaires à sa confection.');
INSERT INTO "item_descriptions" VALUES(279,'fr','Selon un illustre aventurier, cette amulette contient une larme de Bouftou, à l''odeur et aux propriétés semblables à celles des décoctions de cuir de bouftou.');
INSERT INTO "item_descriptions" VALUES(280,'fr','Ce collier est recherché par les collectionneurs, vous en tirerez un bon prix.');
INSERT INTO "item_descriptions" VALUES(296,'fr','La seule chose qui soit aussi solide qu''un Craqueleur, c''est un Craqueleur, voilà pourquoi cette pelle destinée à la chasse aux craqueleurs est en Pierre de Craqueleur.');
INSERT INTO "item_descriptions" VALUES(298,'fr','Ces sandales sont faites à partir de plumes de Tofu bouilli, et la semelle est en Bec de Tofu inusable. Pour des raisons encore inexpliquées, elles rendent parfois leur porteur un peu débile...comme un Tofu.');
INSERT INTO "item_descriptions" VALUES(299,'fr','La meilleure défense c''est l''attaque, ces bottes anti-agression vous permettront d''exterminer un groupe d''agresseurs sans aucune difficulté.');
INSERT INTO "item_descriptions" VALUES(320,'fr','Ce bâton servait à l''origine aux éleveurs d''Amakna qui voulaient contrôler plus facilement leurs troupeaux de Tabis, ce bâton est en effet si léger, qu''il permet à son porteur de courir après les Tabis égarés sans se fatiguer.');
INSERT INTO "item_descriptions" VALUES(323,'fr','Cette amulette donne des facultés très particulières à son porteur, en effet ce dernier se voit comme transporté par une aura mystérieuse parcourant son corps, ce qui généralement a pour effet de décupler ses capacités physiques.');
INSERT INTO "item_descriptions" VALUES(324,'fr','Cette amulette a la faculté de devenir rose les jours où son porteur est d''humeur guillerette. On raconte qu''elle décuple également vos chances de trouver de bons objets.');
INSERT INTO "item_descriptions" VALUES(325,'fr','Cette amulette confectionnée à partir de petits crânes taillés dans de l''os, par un des plus grands bijoutiers Sram, est unique en son genre. Elle permet à son porteur de s''évader plus facilement lors des situations périlleuses.');
INSERT INTO "item_descriptions" VALUES(326,'fr','Cette amulette provient des régions nordiques. Elle confère à son porteur la capacité d''invoquer plus facilement des créatures.');
INSERT INTO "item_descriptions" VALUES(327,'fr','Cette lame forgée à l''origine pour les Gob-Trotteurs, était en fait bien trop lourde pour ces faibles gobelins. Elle n''en reste pas moins très légère pour un individu normal, ce qui lui permet de frapper très vite.');
INSERT INTO "item_descriptions" VALUES(328,'fr','Cette lame double à la forme bien étrange servait à l''origine à élaguer les arbres pour progresser dans les forêts denses. Les bûcherons se sont vite aperçus qu''elle constituait une arme de choix pour exterminer toute forme de menace.');
INSERT INTO "item_descriptions" VALUES(329,'fr','Comme son nom l''indique, cet arc permet de gagner facilement un combat. Un grand architecte Crâ sans imagination a même utilisé le nom de cet arc pour nommer une de ses constructions.');
INSERT INTO "item_descriptions" VALUES(331,'fr','C''est l''arc le plus recherché de tout Amakna, on raconte que là où ses flèches retombent, on peut trouver un trésor. Étrangement, il ne semble être efficace que lorsque pluie et rayons de soleil se mêlent.');
INSERT INTO "item_descriptions" VALUES(332,'fr','Jeanne était un peu folle, elle entendait des Tabis roter dans sa tête. Pour éviter qu''elle ne se blesse avec son arc, il lui a été confisqué et on a décidé de la brûler vive pour réchauffer l''ambiance lors de l''inauguration de la taverne.');
INSERT INTO "item_descriptions" VALUES(333,'fr','À l''origine destinée à être mangée, cette baguette est devenue une arme redoutée. En effet, Xavier le Boulanger l''a oubliée dans son four pendant 234 ans alors qu''il était parti distribuer des pains aux monstres autour de sa boulangerie.');
INSERT INTO "item_descriptions" VALUES(334,'fr','Cette baguette appartenait à l''Eniripsa Liriel qui mourut d''une overdose de fraises dans d''atroces souffrances, perdant ses ailes dans un râle de douleur à vous glacer le sang. Les collectionneurs s''arrachent cette baguette réputée maudite.');
INSERT INTO "item_descriptions" VALUES(335,'fr','Sans leur bâton, les Bworks mages sont aussi inoffensifs que les Tofus sans leurs Bécos. Voilà qui en dit long sur la puissance de ce bâton.');
INSERT INTO "item_descriptions" VALUES(336,'fr','Ce bâton a la faculté de pouvoir faire léviter les Cawottes, on se demande bien à quoi cela peut servir en combat.');
INSERT INTO "item_descriptions" VALUES(337,'fr','C''est un arc très simple à utiliser, il a été conçu pour s''adapter à l''intelligence d''un Bwork Archer, ce qui le rend presque utilisable par un Tofu. En revanche, il nécessite une force de Craqueleur pour être bandé.');
INSERT INTO "item_descriptions" VALUES(339,'fr','Cette lame appartenait à Metzger le boucher, elle avait été forgée pour découper les os. Le Chafer a cependant réussi à lui dérober son outil, devenu maintenant une arme très redoutée qui est à l''origine de nombreuses amputations.');
INSERT INTO "item_descriptions" VALUES(340,'fr','Ces dagues permettent selon la légende de voler tout et n''importe quoi, mais surtout n''importe quoi à n''importe qui, ou l''inverse. Plus personne ne se souvient de la légende avec exactitude.');
INSERT INTO "item_descriptions" VALUES(341,'fr','Ces dagues légendaires constituent de vraies pièces de collection pour tout Sram qui se respecte, elles sont tellement vénérées, que certains Srams se refusent à les voler.');
INSERT INTO "item_descriptions" VALUES(342,'fr','Ce marteau très particulier a été confectionné à partir de becs de Kwaks, ce qui explique pourquoi il pique très fort lorsque l''on se prend un coup de ce marteau.');
INSERT INTO "item_descriptions" VALUES(346,'fr','Selon certaines légendes, cet anneau protège son porteur des intempéries. Mais ceci n''a jamais encore pu être prouvé, puisqu''il ne pleut jamais en Amakna.');
INSERT INTO "item_descriptions" VALUES(347,'fr','Cette pelle de jardinier est particulièrement efficace pour couper les rhizomes, des mauvaises herbes. C''est également une excellente arme dès qu''il s''agit de couper autre chose que des rhizomes.');
INSERT INTO "item_descriptions" VALUES(348,'fr','Ces bottes appartenaient à un cuisinier très pressé, qui allait chercher son céleri et son thé à toute vitesse à travers la campagne d''Amakna.');
INSERT INTO "item_descriptions" VALUES(354,'fr','Ce type d''épée était forgé pour les gardes d''un commerçant aussi riche que réputé. Plutôt destinée à effrayer les voleurs, elle n''en reste pas moins redoutable pour achever les voleurs ou les clients honnêtes, mais un peu usants.');
INSERT INTO "item_descriptions" VALUES(355,'fr','Cet anneau apporte force et courage à son porteur.');
INSERT INTO "item_descriptions" VALUES(356,'fr','Cette ceinture rend son porteur plus résistant et endurant.');
INSERT INTO "item_descriptions" VALUES(357,'fr','Epée symbolisant la partie de leur corps dont les Ecaflips sont le plus fier. Cette épée résume bien la façon de faire des joueurs.');
INSERT INTO "item_descriptions" VALUES(358,'fr','La Queue Infernale est vraiment infernale... De quoi rendre votre adversaire ou vos coéquipiers complètement fous, et surtout de transformer vos coéquipiers en adversaires si vous vous y prenez mal. En revanche, le cas inverse ne semble jamais se produire.');
INSERT INTO "item_descriptions" VALUES(359,'fr','Cet anneau a été offert il y bien longtemps à Isidor, un chat malin, par le roi Allister, qui reconnu l''agilité inégalable de cet Ecaflip.');
INSERT INTO "item_descriptions" VALUES(436,'fr','Ce bâton taillé dans une grosse racine d''Abraknyde est très efficace au corps à corps, attention à ne pas le laisser au contact de l''eau, il pourrait reprendre racines et se retourner contre son maître.');
INSERT INTO "item_descriptions" VALUES(455,'fr','Ce ridicule petit marteau servait à Zokrim le paysan, qui s''en servait pour planter ses piquets de clôtures à l''aurore. Personne ne sait pourquoi Zokrim plantait ses piquets à l''aurore, mais la légende raconte qu''il avait de bonnes raisons.');
INSERT INTO "item_descriptions" VALUES(456,'fr','Cette hache permet de couper facilement les arbres, même les plus gros. Elle est surtout appréciée pour son poids important qui lui permet de couper un Bwork en trois facilement, pour peu que son porteur soit capable de la soulever.');
INSERT INTO "item_descriptions" VALUES(458,'fr','Le Chafer est quelqu''un de sensible et distingué, il garde toujours avec lui une amulette faite des crânes de ses cousins tombés au combat. Le plus étrange, c''est que le Chafer n''a jamais eu de cousins.');
INSERT INTO "item_descriptions" VALUES(462,'fr','Le bois d''Abraknyde étant toujours vivant une fois coupé, cet arc est très difficile à utiliser. Cependant, il n''y a pas mieux pour ridiculiser un Abraknyde, que de le tuer avec un arc issu des racines de ses propres frères.');
INSERT INTO "item_descriptions" VALUES(469,'fr','Cette baguette utilise les propriétés magiques de la Racine d''Abraknyde qui est encore vivante, méfiez-vous des effets néfastes de cette baguette, il lui arrive parfois de se retourner contre son maître.');
INSERT INTO "item_descriptions" VALUES(478,'fr','Cette hache doit son nom à Woodee la Bûcheronne, qui savait user de ses charmes pour détourner l''attention des autres Bûcherons et ainsi garder secret l''emplacement des rares Charmes dont elle voulait préserver l''existence.');
INSERT INTO "item_descriptions" VALUES(484,'fr','Après une soirée un peu trop arrosée à la taverne qui a débouché sur une bagarre, un Enutrof s''est aperçu que cette pelle conçue à l''origine pour les grands travaux de construction était une excellente arme.');
INSERT INTO "item_descriptions" VALUES(489,'fr','La loupe permet d''examiner avec attention les éléments du décor pour y déceler des trésors.');
INSERT INTO "item_descriptions" VALUES(502,'fr','Cette hache est une des seules à pouvoir couper des arbres envoûtés, on peut donc par extension, affirmer qu''elle peut trancher tout ce qui est envoûté, vivant ou non.');
INSERT INTO "item_descriptions" VALUES(515,'fr','Cette hache a appartenu à Brouce Boulgoure le fameux Bûcheron, marié jadis avec Kassiopée Baine, fille d''un autre grand Bûcheron. Cette arme lui permit de se défendre maintes fois lorsqu''il partait la nuit couper des forêts entières.');
INSERT INTO "item_descriptions" VALUES(592,'fr','Cet arc a appartenu à Ivan Nowé, un Crâ téméraire, qui a pourfendu plus d''un Tofu égaré. Cet arc a la particularité de faire des coups pour le moins surprenants qui laissent perplexes puis agonisants les ennemis.');
INSERT INTO "item_descriptions" VALUES(610,'fr','Cette amulette blanchâtre est confectionnée avec du Crabe, ce qui en fait une amulette très fragile mais originale.');
INSERT INTO "item_descriptions" VALUES(616,'fr','Cette amulette, sertie d''écailles de poisson, est censée porter chance à son propriétaire lorsqu''il part en mer les jours de tempête.');
INSERT INTO "item_descriptions" VALUES(617,'fr','Cette amulette terrifiante a impressionné plus d''un marin, la porter sur soi suffit à faire de vous une personne redoutée.');
INSERT INTO "item_descriptions" VALUES(619,'fr','Ce bâton permettait à Farle Ingalsse, éleveur de Bouftous, d''invoquer plus facilement des Tofus gardiens de troupeaux. Au fil du temps, ce bâton s''est révélé être une excellente arme de combat.');
INSERT INTO "item_descriptions" VALUES(620,'fr','Cette épée a permis au célèbre marin Mobby Diqueriveurse, de découper en tranches, les tentacules du célèbre Kralamoure Géant de l''île de Moon, réputé pour étouffer les marins saouls et saouler les marins étouffés.');
INSERT INTO "item_descriptions" VALUES(629,'fr','Ce magnifique chapeau attirera toutes les convoitises lorsque vous irez au bal masqué, hohé, hohé.');
INSERT INTO "item_descriptions" VALUES(638,'fr','Pêcher un Somoon relève de l''exploit, mais avec cette amulette sur soi, plus rien n''est impossible.');
INSERT INTO "item_descriptions" VALUES(639,'fr','Cette amulette a été retrouvée dans l''épave échouée du célèbre pêcheur de Kralamoure, Moby Diqueriveurse, qui était également populaire pour ses boutades vaseuses au bar des pirates.');
INSERT INTO "item_descriptions" VALUES(640,'fr','Cet arc permettait aux pêcheurs de nettoyer les rivages de toute la vermine environnante sans avoir à se lever de leur siège, et cela depuis la fenêtre du bar des pirates.');
INSERT INTO "item_descriptions" VALUES(657,'fr','Ce bâton permettait à Shika Ingalsse, éleveuse de Tofus, d''invoquer plus facilement des Tofus gardiens de troupeaux. Au fil du temps, ce bâton s''est révélé être une excellente arme de combat.');
INSERT INTO "item_descriptions" VALUES(658,'fr','Ce bâton permettait à Gramine Ingalsse, éleveuse de Tabis, d''invoquer plus facilement des Tofus gardiens de troupeaux. Au fil du temps, ce bâton s''est révélé être une excellente arme de combat.');
INSERT INTO "item_descriptions" VALUES(673,'fr','Cette hache n''a rien de particulier si ce n''est que la légèreté naturelle du Bois de Châtaignier, permet à cette hache d''avoir un manche aussi léger qu''une plume de jeune Tofu Maléfique.');
INSERT INTO "item_descriptions" VALUES(674,'fr','"Cette hache a tout pour plaire" disait le fameux slogan de Brouce Boulgoure le célèbre bûcheron. En effet, son manche en Bois de Merisier permet d''amortir les vibrations lors de l''abattage des arbres ou des bworks au crâne un peu trop solide.');
INSERT INTO "item_descriptions" VALUES(675,'fr','Cette hache à l''aspect rudimentaire, n''en est pas moins efficace. C''est avec cet outil que Brouce Boulgoure le Bûcheron a gagné le concours de tranchage de Bworks nains. Voilà qui en dit long sur l''efficacité de cette hache.');
INSERT INTO "item_descriptions" VALUES(676,'fr','Cette hache a la particularité de ne jamais rouiller, pour éviter de désagréables surprises lorsque les Bûcherons gourmands décident de lécher le sirop d''érable sur la lame après une éprouvante journée d''abattage d''érables.');
INSERT INTO "item_descriptions" VALUES(677,'fr','Cette cape a appartenu à un vieux pirate du nom de Zokrim. Il devait être plutôt malchanceux...');
INSERT INTO "item_descriptions" VALUES(694,'fr','C''est le Dragon du Feu Ignemikhal qui créa le Dofus Pourpre, un Œuf dont le moins qu''on puisse dire, c''est qu''il sent le soufre - mais il sent bien d''autres choses encore...');
INSERT INTO "item_descriptions" VALUES(696,'fr','La Coiffe du Ploukosse, sous ses dehors "has been", est très efficace lors des combats pour un simple chapeau de paille.');
INSERT INTO "item_descriptions" VALUES(697,'fr','Makroute est un chien très affectueux... Le problème, c''est que lorsqu''il trouve un nouveau copain, il ne le lâche plus... Il a bien dû se faire 30 millions d''amis de cette façon...');
INSERT INTO "item_descriptions" VALUES(698,'fr','Le Choipo Podlard vient d''une grande école de magie. Créature vivante, il a rencontré les plus grands magiciens de notre temps, tels que Mme Magoa AlaGale, Mr Doublegore et le célèbre Remy Krokeur.');
INSERT INTO "item_descriptions" VALUES(699,'fr','Le Troma est aussi craignos qu''un Rasboul en poil de Bitouf. (Pour ceux qui ne savent pas ce qu''est un Rasboul en poil de bitouf, référez-vous aux grands livres des Craps à Poules).');
INSERT INTO "item_descriptions" VALUES(700,'fr','Ah le Pandawa, vraiment quelle grosse tête il a. Comme son pote Makroute, il passe son temps sur la tête de son maître. Nul besoin de se déplacer, lorsqu''il est motivé, il arrive même à subtiliser la nourriture de son porteur.');
INSERT INTO "item_descriptions" VALUES(701,'fr','Le Oiram a fait de nombreux adeptes de part le monde, du fait de son côté très classieux... Ce chapeau a longtemps été porté par un plombier qui passait son temps à sauter et courir...');
INSERT INTO "item_descriptions" VALUES(702,'fr','Ce crâne de démon reconstruit à partir d''ossements divers et variés apporte grâce et élégance à son porteur... Vos amies vont vous jalouser...');
INSERT INTO "item_descriptions" VALUES(703,'fr','Ce chapeau, en forme de corbeille à fruits en osier renversée, est en fait une corbeille à fruits renversée magique. Ce qui ne manquera pas d''impressionner votre entourage, surtout s''il est composé d''apprentis Bworks Mages.');
INSERT INTO "item_descriptions" VALUES(704,'fr','Ce chapeau, confectionné à partir de Slips en cuir de Chafer Lancier tressés entre eux, vous rendra de toute évidence irrésistible auprès des femelles Bwork Mages, réputées pour leur féminité débordante, accentuée par leur barbe rousse.');
INSERT INTO "item_descriptions" VALUES(705,'fr','Si vous voulez être traumatisé, il vous faut absolument cette magnifique noix de coco trouée. Nous rappelons à l''utilisateur que l''intérieur est équipé d''une paille et de boissons rafraîchissantes.');
INSERT INTO "item_descriptions" VALUES(706,'fr','Hugne "le sans mémoire" possédait une magnifique boule de crystal que lui avait donné son pépé. Bien décidé à la conserver toute sa vie, il la plaça sur son chapeau, qu''il ne quittait jamais... Il est mort de fatigue, en essayant de la retrouver.');
INSERT INTO "item_descriptions" VALUES(707,'fr','Ce chapeau en Corne de Minotoror est très efficace pour impressionner ses adversaires en se faisant passer pour un Minotoror. Cette ruse ne semble fonctionner que sur les adversaires simplets. Un Iop ou un Tofu devrait faire l''affaire.');
INSERT INTO "item_descriptions" VALUES(708,'fr','Ce chapeau en peau de larve verte magique donne à son porteur une allure guillerette, mais également un peu stupide. On ne peut pas tout avoir dans la vie, le porteur de ce chapeau en est d''ailleurs un excellent exemple.');
INSERT INTO "item_descriptions" VALUES(709,'fr','Ce chapeau en écorce enchantée appartenait à Lorko, un Bûcheron réputé qui n''a pas hésité à défier le célèbre Bûcheron Brouce Boulgoure, lors d''un fameux duel de déracinage d''Orme à mains nues dans la clairière de Liroye Merline.');
INSERT INTO "item_descriptions" VALUES(710,'fr','Lo Korko Klako ost ouno chapo kil‍o bo. Tros ostotiko, tros bolo, il so porto par los plus bo dos Sadida.');
INSERT INTO "item_descriptions" VALUES(711,'fr','Ce magnifique masque en cuir appartenait à Jouik Krampe, cousin de Zeurg. Tous deux étaient très portés sur les vêtements en cuir moulant. Un peu comme le Captain Chafer, la perversité en moins.');
INSERT INTO "item_descriptions" VALUES(712,'fr','Ce chapeau confectionné à partir d''oreilles cousues entre elles, vous rendra tout simplement unique tant il est original. On raconte qu''il a jadis permis à Rakmar Bilgout de séduire la reine des Bouftous, pour ensuite l''égorger plus facilement.');
INSERT INTO "item_descriptions" VALUES(732,'fr','Cette magnifique alliance a été volée à Silimelle la Brasseuse de Bière, lors d''une soirée un peu trop arrosée à la taverne. Voilà ce qui arrive lorsque l''on paie des coups à des inconnus...');
INSERT INTO "item_descriptions" VALUES(733,'fr','Ragalde était sûrement un des Guerriers Iop les plus téméraires, ces bottes magiques lui ont permis d''occire bon nombre d''indésirables.');
INSERT INTO "item_descriptions" VALUES(734,'fr','Cette ceinture permettait aux gardes du Château d''Amakna de contenir les émeutes et autres débordements lors des fêtes populaires.');
INSERT INTO "item_descriptions" VALUES(737,'fr','Plus vert qu''un Tofu malade, le Dofus Émeraude fut créé par Aerafal, le Dragon de l''Air. Pour créer quelque chose d''aussi vert, il devait avoir le mal de l''air. Un comble, non ?');
INSERT INTO "item_descriptions" VALUES(739,'fr','Le Dofus Turquoise fut créé par Aguabrial, le Dragon de l''Eau. Quand on y pense, c''est fou ce qu''un Dragon peut faire avec de l''eau...');
INSERT INTO "item_descriptions" VALUES(742,'fr','"Ce bâton a dû faire, toutes les guerres, pour être aussi fort aujourd''hui" tels ont été les derniers mots de Francisque Kabroule, le célèbre Ménestrel Forgeur de Haches, avant de périr écrasé par un œuf de Tofu géant.');
INSERT INTO "item_descriptions" VALUES(744,'fr','Cette cape est comme son porteur, unique en son genre et trop souvent sous-estimée.
Elle est constituée d''un assemblage de peaux de larves vertes, ce qui lui donne un aspect rugueux des plus sympathique.');
INSERT INTO "item_descriptions" VALUES(754,'fr','Cette cape rouge sang a baigné dans le sang pendant des années. Ce type de cape est très prisée lors des Fêtes Dalouhines.');
INSERT INTO "item_descriptions" VALUES(758,'fr','Cette cape ne peut être portée que par les grands justiciers bontariens, c''est à dire presque personne.');
INSERT INTO "item_descriptions" VALUES(759,'fr','Cette magnifique cape a été confectionnée avec les plumes du dernier Poolay d''Amakna. Véritable rareté, les collectionneurs rêvent de l''avoir dans leur collection.');
INSERT INTO "item_descriptions" VALUES(765,'fr','Cette Faux a appartenu à Farle Ingalsse en personne, elle est suffisamment aiguisée pour faucher tous les types de céréales et tous les types de monstres qui se cachent dans les champs de céréales.');
INSERT INTO "item_descriptions" VALUES(766,'fr','Cette amulette pique votre curiosité et votre cou également.');
INSERT INTO "item_descriptions" VALUES(767,'fr','Malgré un nom pompeux, cet anneau rend juste un peu plus fort, et un peu plus bête.');
INSERT INTO "item_descriptions" VALUES(768,'fr','Cet anneau influe sur le cours de votre destinée, il vous rend plus résistant, mais moins chanceux. Vous augmentez vos chances de vivre longtemps en diminuant vos chances de vivre heureux.');
INSERT INTO "item_descriptions" VALUES(769,'fr','Les bottes qui portent chance. Le problème c''est qu''elles vous rendent moins résistant en combat.');
INSERT INTO "item_descriptions" VALUES(771,'fr','Cette hache n''a rien d''exceptionnel, mais elle reste tout de même appréciée des Bûcherons débutants, qui l''aiment pour sa simplicité d''utilisation .');
INSERT INTO "item_descriptions" VALUES(772,'fr','On prétend que cette cape légendaire permet de devenir presque invincible si on la combine à l''épée légendaire des escrimeurs, le Dard Tagnan et au chapeau légendaire des Six Rameaux de Bergers Rahks.');
INSERT INTO "item_descriptions" VALUES(773,'fr','Cette cape vient du pays des Patitaliennes, un endroit où l''on parle avec les mains. Cela explique la grande liberté de mouvement laissée par celle-ci. Elle est en outre d''une légèreté surprenante.');
INSERT INTO "item_descriptions" VALUES(774,'fr','Venant du Mont Taigüe ou du monde Aigüe selon la manière dont vous le prononcez, cette cape a conduit à l''empoisonnement de son ancienne propriétaire, mais bizarrement elle augmente la résistance de son porteur.');
INSERT INTO "item_descriptions" VALUES(775,'fr','Tissée magiquement avec un soin infini, la Cape Abilité permet à son porteur de discerner les points faibles de ses adversaires pour leur porter des coups destructeurs.');
INSERT INTO "item_descriptions" VALUES(776,'fr','Ayant appartenu à une certaine Mulba, qui s''en servait pour transporter des objets encombrants dans sa quête des Sept Poules de Cristal venues des étoiles, cette cape augmente considérablement la force.');
INSERT INTO "item_descriptions" VALUES(777,'fr','Le Coq ayant donné ses plumes pour la confection de cette cape s''est débattu pendant plusieurs jours et plusieurs nuits avant de finalement tomber à bout de force et de se laisser déplumer. "Hû !" s''exclama son propriétaire, lui aussi à bout de souffle.');
INSERT INTO "item_descriptions" VALUES(778,'fr','Cette authentique cape de méchant est une preuve de votre appartenance à la bande du diaboliquement génial Mori Arty, dont on raconte que seule sa malchance égalait sa stupéfiante intelligence. Ne peut être portée que par les plus grands méchants.');
INSERT INTO "item_descriptions" VALUES(779,'fr','Cette cape d''apparence quelconque n''est en fait pas tout à fait quelconque. Elle rendrait invisible son porteur aux yeux de ceux qui ne le regardent pas. Impressionnant !');
INSERT INTO "item_descriptions" VALUES(781,'fr','Cette superbe cape a appartenu au Grand Stratéquerre. Ce célèbre seigneur de guerre et fin stratège, avide de conquête de l''univers, a bien vite abandonné tous ses projets après avoir revêtu cette cape. Étrange !');
INSERT INTO "item_descriptions" VALUES(782,'fr','Cette hache est assez particulière, elle est à la base destinée à l''apprentissage du métier de Bûcheron. Correctement utilisée, elle peut sectionner en deux un jeune Abraknyde trop insouciant, ce qui avouons-le, est très rare.');
INSERT INTO "item_descriptions" VALUES(783,'fr','Cette amulette, exclusivement fabriquée à partir de bois précieux, est très prisée des Bûcherons qui lui attribuent bien souvent des pouvoirs qu''elle n''a pas.');
INSERT INTO "item_descriptions" VALUES(784,'fr','Le Chat Buté est le surnom donné à un célèbre Ecaflip. Aucun Ecaflip n''aura été plus têtu que lui, et en combat seule sa chance le sauvait de son inexistante intelligence. 
"Qui qu''c''est qu''y''est buté comme un caillou ?", s''exclamait-il souvent.');
INSERT INTO "item_descriptions" VALUES(785,'fr','Cet anneau, transmis de grand-père Enutrof en père Enutrof, procure à son porteur une formidable force. Celui-ci n''en est qu''une pâle copie, mais il saura tout de même satisfaire les collectionneurs, qu''ils soient Enutrofs ou non.');
INSERT INTO "item_descriptions" VALUES(786,'fr','Née d''une erreur de manipulation d''un bijoutier, cette amulette augmente l''intelligence de son porteur. En revanche, elle donne généralement un puissant mal de crâne qui a pour effet d''amoindrir la condition physique de son propriétaire.');
INSERT INTO "item_descriptions" VALUES(787,'fr','Cet étrange petit anneau a la faculté d''augmenter l''agilité de son porteur, pourtant étrangement frappé d''un manque de chance.');
INSERT INTO "item_descriptions" VALUES(789,'fr','Cette ceinture fait fureur auprès de la jeune population d''Amakna. Un couturier Sadida en est à l''origine. Lors de sa première vente, il s''exclama : "La vie est courte, jouez durement !".');
INSERT INTO "item_descriptions" VALUES(790,'fr','Les effets magiques de cette cape sont souvent surestimés, ce qui a causé la perte de nombreux aventuriers, notamment, le tristement célèbre Ménestrel Francisque Kabroule.');
INSERT INTO "item_descriptions" VALUES(791,'fr','C''est un Bâton en racines d''Abraknyde encore vivantes. Attention, ce dernier a une fâcheuse tendance à se retourner contre son maître. Il peut être très efficace lorsqu''il décide de s''attaquer à la même cible que celle de son maître.');
INSERT INTO "item_descriptions" VALUES(821,'fr','Une épée sainte distribuée aux jeunes guerriers durant leur formation.');
INSERT INTO "item_descriptions" VALUES(824,'fr','L''épée du Chevalier est une épée solide et efficace. Bien utilisée, elle peut causer de gros dommages à vos ennemis.');
INSERT INTO "item_descriptions" VALUES(827,'fr','Cette épée d''apparence rudimentaire est très appréciée des Bworks les plus débiles, qui ne savent pas se servir d''un arc ou d''un bâton, certains confondent même la lame et le manche ce qui ne manque pas de faire rire leurs adversaires.');
INSERT INTO "item_descriptions" VALUES(828,'fr','Cet arc tire si rapidement ses flèches, que l''on entend ces dernières partir de très loin. Pensez donc à l''équiper d''un silencieux, si c''est la discrétion que vous recherchez.');
INSERT INTO "item_descriptions" VALUES(829,'fr','À cause de sa faible portée, cet arc n''est pas très efficace, mais il permet tout de même d''affaiblir suffisamment l''ennemi avant de l''achever avec une autre arme ou magie.');
INSERT INTO "item_descriptions" VALUES(832,'fr','Cette baguette permet à son porteur d''augmenter son intelligence.');
INSERT INTO "item_descriptions" VALUES(835,'fr','Cette baguette permet à son porteur d''augmenter sa sagesse.');
INSERT INTO "item_descriptions" VALUES(836,'fr','Cet anneau, forgé dans de l''écorce d''Abraknyde possède de grands pouvoirs et implique donc de grandes responsabilités. Cependant, malgré sa valeur, des rumeurs laissent entendre qu''il est maudit.');
INSERT INTO "item_descriptions" VALUES(837,'fr','Ces bottes augmentent la force de leur porteur, mais risquent de le rendre un peu idiot au bout d''un certain temps, voire de le transformer en Iop en cas d''utilisation régulière et prolongée');
INSERT INTO "item_descriptions" VALUES(841,'fr','Cet anneau permettra a votre héros d''augmenter ses PA, en contrepartie de sa force et de son intelligence.');
INSERT INTO "item_descriptions" VALUES(849,'fr','Ce petit anneau donne de la Force à son porteur.');
INSERT INTO "item_descriptions" VALUES(850,'fr','Étrangement, les collectionneurs Amaknéens s''arrachent cet anneau alors qu''il ne vaut pas tripette.');
INSERT INTO "item_descriptions" VALUES(851,'fr','Ce petit anneau augmente la vie de son porteur.');
INSERT INTO "item_descriptions" VALUES(852,'fr','Ce petit anneau augmente l''intelligence de son porteur.');
INSERT INTO "item_descriptions" VALUES(853,'fr','Ce petit anneau augmente la chance de son porteur.');
INSERT INTO "item_descriptions" VALUES(856,'fr','Cette petite amulette augmente l''agilité de son porteur.');
INSERT INTO "item_descriptions" VALUES(860,'fr','Cette modeste ceinture augmente la chance de son porteur.');
INSERT INTO "item_descriptions" VALUES(861,'fr','Ces bottes augmentent la force de leur porteur, sans pour autant le rendre moins idiot. Quand on n''a pas la tête, on a les poings.');
INSERT INTO "item_descriptions" VALUES(862,'fr','Ces bottes permettent d''augmenter l''intelligence de leur porteur, tout en lui conférant un style vraiment à la mode par les temps qui courent grâce à leur semelle en Bois de Noyer qui offre une adhérence remarquable.');
INSERT INTO "item_descriptions" VALUES(863,'fr','Ces bottes permettent d''augmenter l''agilité de leur porteur, afin qu''il puisse se prendre pour un Tofu plus facilement, lorsque l''envie lui prend de faire l''idiot.');
INSERT INTO "item_descriptions" VALUES(864,'fr','Ces bottes augmentent la chance de leur porteur afin de l''aider à trouver des objets très puissants, comme de la bave de Bouftou par exemple.');
INSERT INTO "item_descriptions" VALUES(867,'fr','Cette splendide amulette confectionnée à partir de restes de Dragoeuf, est suffisamment impressionnante pour faire battre en retrait la majorité des ennemis normalement constitués.');
INSERT INTO "item_descriptions" VALUES(889,'fr','Ces bottes sont si confortables qu''elles permettent au héros qui les chausse d''accroître sa concentration.');
INSERT INTO "item_descriptions" VALUES(892,'fr','Ces bottes sont confectionnées en cuir de Bouftou, elles permettent aux éleveurs de s''approcher plus facilement des Bouftous pour les tuer, grâce à l''odeur qu''elles dégagent.');
INSERT INTO "item_descriptions" VALUES(896,'fr','Ces dagues étaient particulièrement bien adaptées pour couper les racines ou les jeunes pousses, elles ont été détournées de leur usage pour en faire des armes presque mortelles.');
INSERT INTO "item_descriptions" VALUES(900,'fr','Ces dagues d''apparence modeste sont cependant très dangereuses. Elles sont de plus facilement dissimulables, ce qui en fait une arme de choix pour les assassins.');
INSERT INTO "item_descriptions" VALUES(905,'fr','La légende raconte que ces bottes ont été échangées contre d''autres bottes, défectueuses mais surpuissantes, qui avaient été fabriquées par un cordonnier maladroit manquant de sommeil.');
INSERT INTO "item_descriptions" VALUES(909,'fr','Ces bottes permettaient à Hogmeiser de poursuivre les seuls êtres vivants qu''il ne supportait pas, les enfants. Heureusement pour eux, la lourdeur de ces bottes l''empêchait de leur botter le derrière.');
INSERT INTO "item_descriptions" VALUES(910,'fr','Ces bottes ont appartenu à Hogmeiser pendant des années, avant qu''il ne les perde lors d''un pari stupide avec Grizmine. La morale de l''histoire, c''est qu''il ne faut jamais jouer avec un Ecaflip.');
INSERT INTO "item_descriptions" VALUES(911,'fr','Ces bottes ont appartenu à Hogmeiser pendant des années, elles sont tellement usées qu''elles sont surtout handicapantes. Un très bon cordonnier devrait pouvoir les réparer.');
INSERT INTO "item_descriptions" VALUES(912,'fr','Ces magnifiques bottes d''Hogmeiser sont recouvertes d''une fine couche de pierres précieuses, pour les rendre insensibles à certaines attaques magiques. C''est avec ces bottes que Brouce Boulgoure a écrasé la tête du Roi des Abraknydes il y a très longtemps, pour animer l''ouverture de la foire du Trool.');
INSERT INTO "item_descriptions" VALUES(916,'fr','Silicate a confectionné cette amulette un matin d''hiver pour un célèbre aventurier du nom de Rimb Vardi. Ce dernier pourchassait un vieux Bwork Mage responsable de plusieurs catastrophes naturelles déclenchées par sa magie trop approximative.');
INSERT INTO "item_descriptions" VALUES(917,'fr','Cette Broche a été confectionnée un matin d''automne au milieu d''une forêt de Hêtres et d''Ormes non loin de l''île d''Olag-lacustre. Elle est considérée par nombre de bûcherons comme une véritable relique.');
INSERT INTO "item_descriptions" VALUES(919,'fr','Ces puissantes dagues, forgées à l''ancienne à partir d''Ambre Ancestrale, ont servi pendant la colonisation de l''île de Moon, avant que cette dernière ne redevienne sauvage.');
INSERT INTO "item_descriptions" VALUES(923,'fr','Cette hache de guerre a été forgée par Kademlia Boulgoure, pour combattre les plus terrifiants Abraknydes. La légende raconte que cette arme légendaire a tué en une nuit plus d''Abraknydes qu''il n''existe d''arbres en Amakna.');
INSERT INTO "item_descriptions" VALUES(924,'fr','L''agilité que confèrent ces bottes permettait à Klime le cordonnier de monter facilement sur le dos de n''importe quel Bouftou. Il est mort en confondant un Bouftou avec une Gelée, après une soirée trop arrosée passée à la taverne.');
INSERT INTO "item_descriptions" VALUES(927,'fr','Cette hache de guerre a été forgée par Kademlia Boulgoure, pour combattre l''Abraknyde Ancestral. Seuls les meilleurs guerriers sont à même de pouvoir l''utiliser.');
INSERT INTO "item_descriptions" VALUES(928,'fr','Ogralimde était un grand guerrier qui devait sa force à Adyol son maître, un puissant Bwork Mage d''une intelligence surprenante. Mais l''élève n''a jamais dépassé le maître, contrairement à ce que raconte la légende.');
INSERT INTO "item_descriptions" VALUES(934,'fr','Cette cape augmente la vie de son porteur.');
INSERT INTO "item_descriptions" VALUES(937,'fr','Cette cape augmente la chance de son porteur.');
INSERT INTO "item_descriptions" VALUES(940,'fr','Le Louffeur prévient des dégâts physiques.');
INSERT INTO "item_descriptions" VALUES(941,'fr','Le Komintot permet d''augmenter la sagesse de son porteur.');
INSERT INTO "item_descriptions" VALUES(942,'fr','Le Lisseur prévient des dégâts magiques.');
INSERT INTO "item_descriptions" VALUES(947,'fr','Cette cape augmente la sagesse de son porteur.');
INSERT INTO "item_descriptions" VALUES(948,'fr','Cette magnifique cape est un brillant mélange entre l''essence d''Abraknyde et le bon Bouftou des familles.');
INSERT INTO "item_descriptions" VALUES(949,'fr','Ce Bandeau permet d''augmenter la vitalité de son porteur.');
INSERT INTO "item_descriptions" VALUES(952,'fr','Cette cape a été confectionnée grâce à des poils et autres éléments organiques provenant de divers mulous... On peut dire qu''elle respire la puissance.');
INSERT INTO "item_descriptions" VALUES(953,'fr','Cette cape, cousue main avec des plumes de Tofus, permet au héros qui la porte de courir plus vite et de s''échapper plus facilement des zones de tacle.');
INSERT INTO "item_descriptions" VALUES(954,'fr','La Samoulaille est une cape légendaire, brodée par les tailleurs pour les guerriers préférant les combats au corps à corps.');
INSERT INTO "item_descriptions" VALUES(955,'fr','La cape Hilère est un type de cape très demandée par les coiffeurs. Ils adorent se rouler dedans. Elle rend les cheveux de son porteur plus résistants aux chocs.');
INSERT INTO "item_descriptions" VALUES(956,'fr','Cette cape augmente la portée de son porteur, lui permettant d''atteindre des cibles très éloignées, ou d''impressionner les aventuriers un peu naïfs.');
INSERT INTO "item_descriptions" VALUES(957,'fr','La Boufteuse augmente les dégâts et la vitalité de son porteur. Cependant elle dégage une forte odeur, et il n''est pas rare qu''un bouftou vous prenne pour l''un des siens.');
INSERT INTO "item_descriptions" VALUES(958,'fr','Cette cape est certainement l''une des plus puissantes au monde. Elle augmente toutes les caractéristiques élémentaires de son porteur.');
INSERT INTO "item_descriptions" VALUES(967,'fr','Cette magnifique cape augmente les points d''action de son porteur. Elle augmente également sa vitalité et sa sagesse.');
INSERT INTO "item_descriptions" VALUES(968,'fr','Cette magnifique ceinture augmente les points d''action de son porteur. Elle augmente également sa vitalité et sa sagesse.');
INSERT INTO "item_descriptions" VALUES(969,'fr','Cette magnifique couronne a appartenu au tristement célèbre Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'fr','Ce bâton appartenait au tristement célèbre Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(971,'fr','Cette cape appartenait au tristement célèbre Wa Wabbit. Elle est encore imprégnée de sa transpiration, ce qui vous permettra de vous remémorer ce magnifique combat à chaque fois que vous la porterez.');
INSERT INTO "item_descriptions" VALUES(972,'fr','Si un dragon avait véritablement pondu cet œuf, il serait très aimable. Plus en tout cas que le Wa Wabbit, qui s''en sert pour attirer les aventuriers sur son île afin de les dépouiller de leur équipement et, accessoirement, de leur fierté. Un moyen ingénieux et peu onéreux de se procurer les panoplies dernier cri sans bouger de chez soi.');
INSERT INTO "item_descriptions" VALUES(976,'fr','La citwouille a la particularité d''empêcher la dispersion des particules de magie, cela en fait un très bon isolant magique. C''est d''ailleurs pour cela que certains guerriers se servent de ce légume comme couvre-chef.');
INSERT INTO "item_descriptions" VALUES(1019,'fr','Porter ce casque signifie adopter une apparence unique... À mi-chemin entre le ridicule et le comique.');
INSERT INTO "item_descriptions" VALUES(1021,'fr','Pour ceux qui ont toujours rêvé de voler comme un Kwak, allez vous recoucher, car ces ailes ne feront de vous qu''un danger public doublé d''un idiot.');
INSERT INTO "item_descriptions" VALUES(1029,'fr','L''illustre fou Stek Dardar aurait commandé ces couteaux étranges et redoutables. Nul n''en connaissait l''utilité jusqu''à ce qu''il tente d''offrir à manger à son dieu.');
INSERT INTO "item_descriptions" VALUES(1030,'fr','Cette paire de dagues est en fait un jouet magique. Créé pour amuser les jeunes Ecaflips, sa production fut interdite après qu''un enfant adepte de Sram prit part au jeu.');
INSERT INTO "item_descriptions" VALUES(1031,'fr','Ces magnifiques dagues auraient appartenu à la Sramette la plus cruelle qu''Amakna ait connu. Enfin, l''une des plus cruelles... En fait, juste un peu plus que les autres, enfin au moins autant que les autres, ce qui est déjà pas mal !');
INSERT INTO "item_descriptions" VALUES(1035,'fr','Cette dague était utilisée autrefois par la confrérie secrète de Fon. Cette guilde voulait plonger Amakna dans le chaos. Finalement, elle coula en premier quand l''île qui les cachait fut submergée par les flots.');
INSERT INTO "item_descriptions" VALUES(1039,'fr','Ces dagues Sram possèdent une forme particulièrement fourbe. Tellement fourbe qu''on se demande si ce sont vraiment des dagues. Lorsque la réponse vient, il est souvent trop tard...');
INSERT INTO "item_descriptions" VALUES(1040,'fr','Ortimus Contrari est une légende parmi les assassins. Il exécute toujours ses contrats d''une manière totalement opposée aux méthodes traditionnelles. N''en demandez pas plus, vous pourriez mourir dans l''instant.');
INSERT INTO "item_descriptions" VALUES(1041,'fr','Cette épée fut donnée à Souzé Schel, un jeune Iop, lors de son adoubement. Malheureusement, lors de sa première mission de chevalier, il glissa sur une pierre qui se trouvait être un craqueleur...');
INSERT INTO "item_descriptions" VALUES(1045,'fr','Cette pelle est faite d''un bois très rare. Selon la légende, toute jeune fille au contact de cette pelle tombera dans un sommeil éternel. Notez bien qu''en cas de contacts répétés, l''effet est applicable à n''importe qui.');
INSERT INTO "item_descriptions" VALUES(1049,'fr','Quoi de mieux qu''une pelle écologique pour mettre un terme aux mauvaises herbes ? Cette pelle est LA réponse, avec elle vous pourrez aisément arracher des pissenlits et les faire manger à vos ennemis, en commençant par la racine !');
INSERT INTO "item_descriptions" VALUES(1053,'fr','Cette pelle fut créée et utilisée par la famille Woukuis dans la guerre intestine entre les groupes Elle-Poma et Touge-Woukuis, concurrents directs d''exportation de tofus grillés. C''est une arme redoutable, son seul défaut est de rendre les mains grasses.');
INSERT INTO "item_descriptions" VALUES(1054,'fr','Croisement entre une pelle et une truelle, la pelle-truelle perdit son caractère utile pour devenir une arme incontournable. Rapide à manier et à ranger grâce à sa petite taille, c''est l''accessoire idéal de tout Enutrof aimant l''alcool.');
INSERT INTO "item_descriptions" VALUES(1058,'fr','Les habitants de l''île Koutoulou fabriquent artisanalement ces pelles affreuses avec du bric et du broc (surtout du broc). Pitoyables pour creuser, elles sont uniquement destinées à faire peur aux esprits et aux enfants pas assez sages.');
INSERT INTO "item_descriptions" VALUES(1059,'fr','Cette pelle est la petite favorite des cultivateurs de champs, surtout de pomme de tewe. Rien ne vous empêche cependant de retourner d''autres types de patate avec.');
INSERT INTO "item_descriptions" VALUES(1063,'fr','Une des armes fétiches créées par Ha. Cette masse, à l''aérodynamisme calculé, fend deux fois plus vite l''air, et donc deux fois plus vite les crânes. Au moins deux bonnes raisons pour posséder cette arme.');
INSERT INTO "item_descriptions" VALUES(1067,'fr','On dit que ce marteau est une pièce unique, car fabriqué de façon artisanale par d''anciens forgeurs Xelor. Certains racontent cependant qu''il s''agirait d''une lettre composant l''enseigne d''un forgeron. Testez-le donc sur une tête et faites votre choix.');
INSERT INTO "item_descriptions" VALUES(1071,'fr','Cette masse permet à son porteur de connaître le temps qu''il fera. Du moins, son inventeur le pensait-il avant de mourir foudroyé. On s''aperçut bien plus tard que cette masse était aussi habile à recevoir les coups qu''à les distribuer.');
INSERT INTO "item_descriptions" VALUES(1075,'fr','Outar Grand Bwork aurait commandé ces marteaux redoutables à un village Xélor contre un traité de paix: s''ils étaient efficaces, le village serait épargné. Quand les marteaux furent livrés, le village fut rasé. Après tout, il fallait bien les essayer !');
INSERT INTO "item_descriptions" VALUES(1079,'fr','Cette masse est l''héritage de l''ancienne tribu pacifique Aj Taye. Cela explique sa principale utilité : en la roulant sur les muscles endoloris la douleur disparaît. Les brutes épaisses vous diront qu''elle marche aussi très bien pour la faire apparaître.');
INSERT INTO "item_descriptions" VALUES(1083,'fr','Ce marteau est tellement ridicule que votre ennemi explosera de rire en vous voyant. Vous donnant juste assez de temps pour l''exploser vraiment.');
INSERT INTO "item_descriptions" VALUES(1084,'fr','Ce terrible marteau vous permettra enfin de prouver que les personnes pensant que le muscle prime sur le cerveau ont tort! (Ceci n''est valable uniquement sur des personnes moins fortes, les autres, n''oubliez pas, ont TOUJOURS raison)');
INSERT INTO "item_descriptions" VALUES(1085,'fr','Les Falistos sont des démons Xélors. Ayant renié leurs anciens principes, ils ont développé leur force en forgeant des marteaux toujours plus puissants. Après avoir apporté le chaos, ils furent battus et bannis sous terre. Mais quelques armes subsistèrent.');
INSERT INTO "item_descriptions" VALUES(1087,'fr','Cet anneau permet d''augmenter légèrement l''intelligence de son porteur.');
INSERT INTO "item_descriptions" VALUES(1088,'fr','Ce masque est la réplique exacte, en un peu plus grand, de ceux que portent fièrement les Kannibouls importants.');
INSERT INTO "item_descriptions" VALUES(1095,'fr','Cet arc est spécialement conçu pour chasser les oiseaux. Léger et facile à manier, il vous permettra de voler dans les plumes de n''importe qui ou presque.');
INSERT INTO "item_descriptions" VALUES(1104,'fr','L''eniripsa Mie Dopan confectionna cette série de baguettes piquantes pour lutter contre les vols. Capable en théorie de remonter le temps pour empêcher une agression, elle finit généralement dans l''œil d''un démon.');
INSERT INTO "item_descriptions" VALUES(1112,'fr','"Avec un Bouftou, on peut faire tout !" tel était le slogan d''un marchand dont la spécialité était le recyclage de Bouftou. Cet arc est l''un de ses produits, pas très esthétique il n''en est pas moins redoutable.');
INSERT INTO "item_descriptions" VALUES(1116,'fr','Type d''arc fabriqué seulement dans le grand nord d''Amakna, le Kéha est un arc peu cher, à monter soi-même. Ses performances dépendent ainsi fortement de la maîtrise de l''assembleur.');
INSERT INTO "item_descriptions" VALUES(1120,'fr','Le plan de fabrication de cet arc 100% biodégradable fut retrouvé au fond des ruines de Din par un aventurier apparemment célèbre pour son fouet. Rien ne dit s''il a troqué sa vieille babiole claquante contre ce magnifique arc.');
INSERT INTO "item_descriptions" VALUES(1124,'fr','Prenez un vieil arc usé, saupoudrez-le de poudre de perlinpinpin, demandez à un dragon de souffler sur le tout et vous obtenez un arc enchanteur. Cette recette de conte ne marche pas vraiment, les dragons visant étrangement toujours à côté.');
INSERT INTO "item_descriptions" VALUES(1128,'fr','Cet arc peu conventionnel fut conçu spécialement pour le roi autoproclamé d''un village de paysans, qui adorait se faire remarquer en tirant deux flèches simultanément.');
INSERT INTO "item_descriptions" VALUES(1131,'fr','Cette lourde baguette a fracassé plus d''un crâne de pécheur. Les prêtres Iop l''utilisant pour absoudre radicalement et définitivement un repenti.');
INSERT INTO "item_descriptions" VALUES(1132,'fr','Cette œuvre d''art symbolise l''alliance de la pureté... et de la stupidité. Son créateur devait l''être un peu aussi, car il lui conféra d''énormes pouvoirs magiques.');
INSERT INTO "item_descriptions" VALUES(1136,'fr','L''émancipation des ménagères Eniripsa de moins de 50 ans commença grâce à cette baguette : redoutable à la fois pour les monstres et pour la poussière. Pratique non ?');
INSERT INTO "item_descriptions" VALUES(1140,'fr','Houvette inventa cette baguette pour ramener son mari enutrof du bar où il passait ses journées. Bien utilisée, celle-ci permettait de redonner du piquant à leur couple, mais nul ne dit comment.');
INSERT INTO "item_descriptions" VALUES(1146,'fr','Selon l''étiquette, cette baguette aurait l''étrange pouvoir de faire obéir les gens. Le mode d''emploi stipule simplement de l''agiter fortement devant une personne. En cas de mauvais fonctionnement, l''agiter sur la personne marche bien aussi.');
INSERT INTO "item_descriptions" VALUES(1147,'fr','Ce bâton est la réplique d''un artefact légendaire, un peu de pouvoir en moins. Capable d''émettre de la Lumière lors d''un choc sur le sol (Oh!), de déformer un peu votre voix (Wah!), il vous fera passer pour ce que vous n''êtes pas : un grand mage.');
INSERT INTO "item_descriptions" VALUES(1151,'fr','La plupart des jeunes Féca possèdent de nombreux bâtons comme celui-ci, plus qu''une mode c''est presque un nouveau rituel. Quelqu''un devrait quand même leur dire qu''ils sont ridicules.');
INSERT INTO "item_descriptions" VALUES(1157,'fr','Une vieille Féca voyante malvoyante inventa accidentellement cette puissante arme lorsqu''elle fit rencontrer son bâton et sa boule de cristal à l''occasion d''une chute qu''elle ne sut prévoir.');
INSERT INTO "item_descriptions" VALUES(1162,'fr','Le succès du bâton du Wa Wabbit a contribué à l''apparition de divers bâtons, comme celui-ci, dont le nom singe le premier. Ceci afin de le vendre plus facilement. Une technique bien connue de certains promoteurs immobiliers.');
INSERT INTO "item_descriptions" VALUES(1331,'fr','Oly était une disciple de Iop dont le seul talent était la cuisine. On rapporte que Iop en personne lui aurait donné cette médaille pour compenser ses trop grandes faiblesses en combat. Cependant seuls les cœurs purs peuvent la porter.');
INSERT INTO "item_descriptions" VALUES(1350,'fr','Cet arc a été créé par un magicien porté sur la bouteille. Afin de résoudre son problème, il a inventé cet arc spécialisé dans l''eau.');
INSERT INTO "item_descriptions" VALUES(1351,'fr','« Avec un arc, ça passe ou ça casse », dit le proverbe. Les sages éviteront cet arc, il serait soi-disant porteur du mauvais œil...');
INSERT INTO "item_descriptions" VALUES(1352,'fr','Cet arc prend sa force aussi bien de la terre que de l''eau. Malheur à ceux qui ne maîtrisent ni l''un ni l''autre...');
INSERT INTO "item_descriptions" VALUES(1353,'fr','Cet arc, dont toutes les poulies ont été sciées, était, il y a fort longtemps, le symbole de la lutte du bien contre le mal.
Encore aujourd''hui, on peut sentir en lui la flamme des anciens justiciers.');
INSERT INTO "item_descriptions" VALUES(1354,'fr','Hick était un Crâ maudit : il n''arrivait jamais à se débarrasser de son hoquet. Cependant, il finit un jour par jeter son arc au feu pour le remplacer par une épée, et son mal disparu mystérieusement...');
INSERT INTO "item_descriptions" VALUES(1355,'fr','Le créateur de cet arc, un certain Marc Hidsad, n''a jamais très bien su s''en servir. Il pouvait tout autant infliger de sévères blessures à ses ennemis que de se blesser lui-même.');
INSERT INTO "item_descriptions" VALUES(1356,'fr','Rika Zarouil la boulangère fut connue pour avoir été l''eniripsa la plus petite de la contrée. Elle faisait son pain dans des petits-fours en carton et se battait avec des demi-baguettes.');
INSERT INTO "item_descriptions" VALUES(1357,'fr','Un sculpteur un peu farceur tenta de faire passer ses baguettes pour des dagues. Son stratagème n''eut aucun succès, mais ses baguettes, elles, en eurent.');
INSERT INTO "item_descriptions" VALUES(1359,'fr','Les origines de cette baguette restent obscures. Cependant, elle a toujours aidé ses heureux possesseurs à trouver les chemins les moins encombrés d''Amakna, ce qui peut servir les jours de grande affluence sur le domaine du bouftou royal.');
INSERT INTO "item_descriptions" VALUES(1360,'fr','Cette baguette fut créée il y a de nombreuses années dans les flammes de la forge de Mort Dur. Cette arme nécessite d''avoir toujours de l''eau à côté de soi pour pouvoir maitriser son feu intérieur...');
INSERT INTO "item_descriptions" VALUES(1361,'fr','La Baguette Sylvien a l''étrange pouvoir de conférer une vue perçante à son porteur. Charge ensuite à celui ci d''être suffisamment agile pour pouvoir fuir le danger.');
INSERT INTO "item_descriptions" VALUES(1362,'fr','Le pieu vampirique est en fait la baguette d''un vampire depuis longtemps retiré de la vie sociale et de la boucherie. Cet étrange bout de bois a cependant gardé quelques uns des avantages de son ancien maître...');
INSERT INTO "item_descriptions" VALUES(1363,'fr','Outre son nom insupportable, ce bâton possède bien d''autres moyens de rendre son propriétaire fou de rage.');
INSERT INTO "item_descriptions" VALUES(1364,'fr','Ce bâton fait oublier tous les soucis et les mauvaises pensées de son propriétaire. Malheureusement, il perd aussi parfois une partie de sa mémoire et devient sujet à des pertes de concentration de plus en plus fréquentes. À réserver aux sages...');
INSERT INTO "item_descriptions" VALUES(1365,'fr','Hête était vraiment un guerrier redoutable avec son bâton. Il était tellement efficace qu''on prétendait que son bâton était magique et qu''il lançait des flammes...');
INSERT INTO "item_descriptions" VALUES(1366,'fr','Bâton couramment utilisé lors de la transhumance par les bouftiers. Les bworks aiment déguster ces troupeaux de bouftous en fines tranches lors de l''apéritif (le plat principal étant constitué du bouftier lui-même).');
INSERT INTO "item_descriptions" VALUES(1367,'fr','Ce bâton a appartenu à la très belle Dina ''Mythe'', qui était surtout connue pour ses formes avantageuses et son caractère explosif... Bref c''était une vraie bombe.');
INSERT INTO "item_descriptions" VALUES(1368,'fr','« Les 110 » est le surnom donné aux cent dix valeureux pompiers amaknéens qui ont combattu le feu d''un dragonnet en mal de sensations fortes. Cette lance aurait appartenu à l''un d''eux. S''en servir demande courage et dévouement.');
INSERT INTO "item_descriptions" VALUES(1369,'fr','Ces couteaux étaient à l''origine censés servir dans un restaurant de luxe. Mais devant leur look plutôt... étrange, le patron du restaurant a préféré les revendre à un lanceur de couteaux ambulant.');
INSERT INTO "item_descriptions" VALUES(1370,'fr','La poignée de cette arme est grasse et glissante, mais elle a vraiment un look génial.');
INSERT INTO "item_descriptions" VALUES(1371,'fr','Eulasse était un bouftier du nord d''Amakna qui trouva un jour, au milieu du fumier de ses bouftous, une paire de dagues légèrement salies.
Que celui qui les porte fasse attention : le manche glisse, il est facile de manquer son coup.');
INSERT INTO "item_descriptions" VALUES(1372,'fr','Qui ne connait pas Aj''Deh''Là, l''ermite, légendaire disciple de Sram qui avait passé sa vie à refuser tout contact avec les autres. À sa mort, on retrouva ses dagues fétiches à côté de son corps, et seuls les plus agiles purent les apprivoiser.');
INSERT INTO "item_descriptions" VALUES(1373,'fr','Krys Razepa était un vieux disciple d''Enutrof qui portait la barbe, comme tous les disciples d''Enutrof dignes de ce nom. Lorsque madame Razepa, sa femme, lui offrit un rasoir, il préféra l''utiliser pour combattre...');
INSERT INTO "item_descriptions" VALUES(1374,'fr','Tylo était un scribe amaknéen réputé qui avait la particularité de graver ses cahiers de pierre avec des dagues. Il était si rapide qu''on lui confia la rédaction de l''encyclopédie des jurons Astrubiens. Il ne put jamais achever son œuvre.');
INSERT INTO "item_descriptions" VALUES(1375,'fr','Térophyle était un disciple de Iop capable de soulever des masses impressionnantes. Mais malheureusement pour lui, comme tous les Iop trop musclés, l''intelligence n''était pas son fort...');
INSERT INTO "item_descriptions" VALUES(1376,'fr','Cette hache, parfois lourde à manier, est parfaite pour terrasser les Trools : les runes magiques qu''elle contient permettent en effet de brûler les ennemis.');
INSERT INTO "item_descriptions" VALUES(1377,'fr','Huré était un jeune prêtre qui ne reculait pas devant les armes pour faire progresser la foi. Son arme de prédilection était une hache sur laquelle il avait dessiné de nombreux traits, dont la signification est perdue à jamais...');
INSERT INTO "item_descriptions" VALUES(1378,'fr','Cette hache de combat, réservée aux jeunes guerriers, comme son nom l''indique, a la particularité de produire un son strident particulièrement désagréable lorsqu''elle entrechoque une autre arme.');
INSERT INTO "item_descriptions" VALUES(1379,'fr','Ce marteau tirerait son nom du son qu''il produit lorsqu''il s''écrase sur un crâne ennemi. Malheureusement, nul ennemi n''est là pour confirmer cette légende.');
INSERT INTO "item_descriptions" VALUES(1383,'fr','Ce marteau a été forgé pendant des années et des années, par des dizaines de forgerons. Au final, on retrouve une arme splendide, mais qui a malheureusement hérité de ses concepteurs une certaine idée de la vitesse.');
INSERT INTO "item_descriptions" VALUES(1393,'fr','Ce marteau a été fabriqué à partir d''une horloge, la fameuse horloge avalée par le Crocodaille qui avait dévoré la main du Captain'' Brochet. Si on a pu récupérer l''horloge, on ne sait en revanche pas ce qu''il est advenu de la main...');
INSERT INTO "item_descriptions" VALUES(1399,'fr','Tout comme l''amulette du même nom, le Maillet Aclou a la particularité de transformer votre énergie vitale en puissance. À consommer avec modération...');
INSERT INTO "item_descriptions" VALUES(1403,'fr','Ce marteau a appartenu à Tau, un jeune disciple d''Osamodas qui passait son temps à raconter des blagues stupides. Son marteau, tout comme lui, ne rend pas très intelligent, mais peut parfois détendre l''atmosphère...');
INSERT INTO "item_descriptions" VALUES(1404,'fr','Vous aimez les animaux ? Toh''Lo aussi. Il leur avait même voué sa vie. Ce marteau raconte un peu son histoire , une grande communion avec les bêtes...');
INSERT INTO "item_descriptions" VALUES(1426,'fr','Thart'', le créateur de cette pelle, était un disciple de Iop. Un nom prédestiné, pour un Iop, n''est-ce pas ?');
INSERT INTO "item_descriptions" VALUES(1427,'fr','Cette pelle est utilisée par les grands prêtres Kannibouls de l''île de Moon pour invoquer Zébuth, une de leurs divinités souvent représentée sous une forme bovine. Seuls les personnages vils peuvent utiliser cette arme.');
INSERT INTO "item_descriptions" VALUES(1431,'fr','Cette pelle est utilisée par les Enutrof pour cueillir des fruits dans les arbres, mais elle peut s''avérer une arme de combat redoutable. Comme dirait son créateur, Mechba : ''eche est beche, ma pelle''.');
INSERT INTO "item_descriptions" VALUES(1432,'fr','Gaston Houze, jardinier disciple d''Enutrof, avait tendance à toujours trop abuser des plantes. Cette arme en est la preuve : puissante, elle aura tendance à vous jouer des tours et à mettre à mal votre intelligence.');
INSERT INTO "item_descriptions" VALUES(1433,'fr','Cette pelle fut l''arme d''autodéfense d''un petit groupe d''Enutrofettes. Ces dames, une fois l''instrument de puissance entre leurs mains, changèrent du tout au tout et tentèrent de conquérir le monde.');
INSERT INTO "item_descriptions" VALUES(1435,'fr','Pelle très lourde, donc réservée à l''usage des aventuriers les plus gr... larges.');
INSERT INTO "item_descriptions" VALUES(1436,'fr','Ikan etait le petit poisson de Chourros le guerrier. Il est important de préciser que le nom de cette pelle n''a aucun rapport avec ce poisson, mais plutôt avec son odeur...');
INSERT INTO "item_descriptions" VALUES(1439,'fr','Cette pioche a tendance à attirer le mauvais œil. Cependant, il parait qu''il ne manquerait pas grand-chose pour qu''elle devienne une bonne pioche.');
INSERT INTO "item_descriptions" VALUES(1474,'fr','Cette amulette surpuissante est le fruit du travail sur la maîtrise du temps d''un très vieux Xélor.');
INSERT INTO "item_descriptions" VALUES(1475,'fr','La Zulie Lame a été forgée par le célèbre forgeron Dave-Lol avant de mourir, pour la plus jolie des iopettes du royaume. On dit que cette lame n''a d''égal que la beauté de son porteur.');
INSERT INTO "item_descriptions" VALUES(1476,'fr','Cette puissante amulette contient toute la vie du Craqueleur, tous les objets qu''il a récoltés avant de mourir sous les coups de butoir d''aventuriers attirés par ses richesses.');
INSERT INTO "item_descriptions" VALUES(1477,'fr','Mulette était une petite Ecaflipette qui n''a jamais eu de chance dans sa vie, jusqu''au jour où sa grand-mère lui offrit cette amulette.');
INSERT INTO "item_descriptions" VALUES(1478,'fr','Ce pendentif aide son porteur à se retrouver en paix avec le monde qui l''entoure.');
INSERT INTO "item_descriptions" VALUES(1479,'fr','Ce marteau légendaire a déjà fait ses preuves en Amakna, appartenant au puissant Twote en Carton, qui n''hésita jamais à s''en servir, pour réduire ses adversaires en patte à mâcher et confettis.');
INSERT INTO "item_descriptions" VALUES(1480,'fr','Ce pendentif aide son porteur à se retrouver en paix avec le monde qui l''entoure.');
INSERT INTO "item_descriptions" VALUES(1481,'fr','Ce pendentif aide son porteur à se retrouver en paix avec le monde qui l''entoure.');
INSERT INTO "item_descriptions" VALUES(1482,'fr','Cette amulette est extrêmement utile, mais rend son porteur blanc comme un bouftou.');
INSERT INTO "item_descriptions" VALUES(1483,'fr','Symbole mystérieux d''un organisme mystérieux. D''ailleurs il n''existe pas, et vous n''en avez jamais entendu parler !');
INSERT INTO "item_descriptions" VALUES(1484,'fr','Excellent travail de l''apprenti-orfèvre Polma Kartnez, cette copie surpasse l''originale.');
INSERT INTO "item_descriptions" VALUES(1485,'fr','Cette amulette, est une amélioration de La Destinée Dorée. Étrangement, elles n''ont rien en commun, excepté leur aspect assez ridicule, il faut le reconnaître.');
INSERT INTO "item_descriptions" VALUES(1486,'fr','Holy était une disciple de Iop qui avait juré de terrasser le mal où qu''il soit. D''un calme redoutable, elle ne s''énervait jamais sauf quand on la comparait à une certaine Oly.');
INSERT INTO "item_descriptions" VALUES(1487,'fr','Cette ceinture, en plus d''habiller d''une manière élégante, procure à son porteur un effet massant vraiment agréable. L''heureux propriétaire, moins stressé, est alors plus apte à réfléchir.');
INSERT INTO "item_descriptions" VALUES(1488,'fr','Sous ce nom étrange se cache un objet tout aussi étrange, né on ne sait trop comment de précédentes amulettes. On ignore tout des circonstances dans lesquelles elle a été découverte.');
INSERT INTO "item_descriptions" VALUES(1489,'fr','Hète était l''un des plus grands guerriers d''Amakna. La légende dit qu''il tirait sa sagesse de la broche qu''il portait toujours sur lui.');
INSERT INTO "item_descriptions" VALUES(1490,'fr','Son créateur, un certain Ken Aton, était très célèbre pour ses habitudes assez étranges. Il passait ses journées à chasser le Minotoror pour se fabriquer une moquette pectorale.');
INSERT INTO "item_descriptions" VALUES(1491,'fr','La Liche était une sale créature connue pour s''incruster dans les groupes de valeureux guerriers afin de subtiliser une part du butin. Un jour, son petit manège fut découvert et elle dut prendre la fuite.');
INSERT INTO "item_descriptions" VALUES(1493,'fr','La pierre qui orne cet anneau est si aiguisée qu''elle pourrait trancher une carotide d''un effleurement. Heureusement, les Sacrieurs savent manier ce bijou avec habileté. Ils l''utilisent d''ailleurs communément pour s''infliger quelques dommages afin de s''arracher quelques larmes. De douleur ou de plaisir, peu importe : dans les deux cas, c''est ainsi qu''ils rendent hommage à leur déesse.');
INSERT INTO "item_descriptions" VALUES(1494,'fr','Ce joli anneau avait comme fonction première de permettre aux Osamodas de reconnaître leur tofu dans les combats.');
INSERT INTO "item_descriptions" VALUES(1495,'fr','Ce petit anneau qui ne paye pas de mine a été crée par Degun. Ce bijoutier était plus connu pour ses coups de gueule envers tout le monde et sa cruelle aversion pour la Liche, que pour sa créativité en matière d''orfévrerie.');
INSERT INTO "item_descriptions" VALUES(1496,'fr','Cet anneau a été créé pour augmenter la chance de son porteur lors de parties de cartes.');
INSERT INTO "item_descriptions" VALUES(1497,'fr','Anneaux engendrés lors des voyages temporels de Xélor.');
INSERT INTO "item_descriptions" VALUES(1498,'fr','Anneaux créés à partir de larmes d''Enutrof ayant perdu sa pelle. Cela donne une idée du désespoir dans lequel peut être plongé le bonhomme.');
INSERT INTO "item_descriptions" VALUES(1499,'fr','Cet anneau est destiné aux seuls Enutrofs. Leur dieu l''a enchanté pour qu''il ne soit porté que par ses disciples. Il permettra à tout Enutrof qui se respecte, d''avoir beaucoup plus de chance pour découvrir des trésors.');
INSERT INTO "item_descriptions" VALUES(1500,'fr','Cette splendide cape, tissée à partir de divers éléments fibreux de toute nature, est une pièce unique de par sa couleur et ses reflets.');
INSERT INTO "item_descriptions" VALUES(1501,'fr','Cette alliance symbolise l''union entre deux âmes follement amoureuses l''une de l''autre. Inutile de conter fleurette caché derrière les buissons, cette fois c''est pour de bon, vous allez pouvoir vous afficher sans scrupules.');
INSERT INTO "item_descriptions" VALUES(1503,'fr','Pour la fabrication de cette baguette lugubre, on dit qu''il faut mettre la baguette dans le corps d''un cadavre frais, et l''enterrer peu après. Mais personne n''ose imaginer comment faire.');
INSERT INTO "item_descriptions" VALUES(1504,'fr','O''Bert cou rouge était célèbre dans la campagne profonde. Un jour où il chantait à tue-tête il fut tué, la tête tranchée. D''où son surnom. La dague coupable fut retrouvée, mais personne ne chercha son propriétaire. O''Bert chantait vraiment trop mal.');
INSERT INTO "item_descriptions" VALUES(1505,'fr','Cette flûte très rare en bois d''Abraknyde vous permettra de divertir et émouvoir vos amis.');
INSERT INTO "item_descriptions" VALUES(1511,'fr','La légende veut qu''Ecaflip, lors du dantesque combat qui l''éleva au rang de dieu, utilisa une arme constituée de ses propres queues, chacune issue de l''une de ses vies.');
INSERT INTO "item_descriptions" VALUES(1559,'fr','Cet anneau, est en fait une excroissance du Chêne Mou, arrachée lors d''une tempête. Maintenant il est à vous, mais évitez de trop l''approcher de son maître, il pourrait décider de se retourner contre vous.');
INSERT INTO "item_descriptions" VALUES(1574,'fr','Cette épée appartenait au regretté Kih Bésans, dit le découpeur de Yench. C''etait, en effet, sa principale occupation d''amusement. Comme quoi, un rien amuse.');
INSERT INTO "item_descriptions" VALUES(1602,'fr','Cet anneau, permet à l''Abraknyde Sombre, de sortir en soirée tout en étant vraiment très chic. Et comme la vie est bien faite, c''est toujours la soirée dans la Forêt Sombre.');
INSERT INTO "item_descriptions" VALUES(1619,'fr','L''Abramu est une amulette très élégante. Si vous avez l''intention de la porter, nous vous conseillons de vous promener nu afin de bien mettre en valeur ce précieux bijou. Vous verrez, les dames n''y résistent pas.');
INSERT INTO "item_descriptions" VALUES(1620,'fr','Cet arc semble encore vivant et peut presque tirer des flèches tout seul, comme un grand. Il aurait pu être l''arc idéal des personnes dotées de deux mains gauches, mais malheureusement, il faut toujours encocher la flèche dans le bon sens.');
INSERT INTO "item_descriptions" VALUES(1621,'fr','Les bottes de Maîtrise augmentent l''agilité et l''intelligence de leur porteur au détriment de la force et de la chance. Contrairement à ce que l''on pourrait croire, elles ne vous permettent pas de maitriser votre adversaire.');
INSERT INTO "item_descriptions" VALUES(1622,'fr','Les bottes de puissance augmentent la force et la chance de leur porteur au détriment de l''intelligence et de l''agilité. Contrairement à ce que l''on pourrait croire, elles ne confèrent pas une puissance démentielle.');
INSERT INTO "item_descriptions" VALUES(1623,'fr','Les bottes d''Anticipation augmentent la force et l''agilité de leur porteur au détriment de l''intelligence et de la chance. Contrairement à ce que l''on pourrait croire, elles ne vous permettent pas d''anticiper les actions de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(1624,'fr','Ces bottes ont appartenu à Nexus, grand chevalier figé à jamais.');
INSERT INTO "item_descriptions" VALUES(1628,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
INSERT INTO "item_descriptions" VALUES(1629,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
INSERT INTO "item_descriptions" VALUES(1630,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
INSERT INTO "item_descriptions" VALUES(1631,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
INSERT INTO "item_descriptions" VALUES(1632,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
INSERT INTO "item_descriptions" VALUES(1633,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
INSERT INTO "item_descriptions" VALUES(1639,'fr','La créatrice de cette épée au charme certain a voulu retranscrire toute sa beauté gracieuse auréolée d''un caractère piquant. Le résultat est bien plus parlant que des mots.');
INSERT INTO "item_descriptions" VALUES(1651,'fr','Cette épée est totalement appropriée pour agresser de gentilles personnes. Rapide, maniable et surtout extrêmement coupante. Elle est, de ce fait, interdite à la vente depuis longtemps. Mais tolérée aujourd''hui comme défense anti-bwork.');
INSERT INTO "item_descriptions" VALUES(1656,'fr','Cet anneau est à même de protéger son porteur des petites attaques magiques et donc par extension, des petits monstres qui usent de la magie pour faire les malins et se rendre intéressants.');
INSERT INTO "item_descriptions" VALUES(1657,'fr','Cet anneau est à même de protéger son porteur des petites attaques physiques et donc par extension, des petits monstres qui jouent sur leur physique pour vous surprendre.');
INSERT INTO "item_descriptions" VALUES(1661,'fr','Porter autour du cou un Moskito pris dans un ambre, c''est un peu montrer à vos adversaires, que vous êtes un redoutable chasseur... de Moskitos. De quoi vous rendre ridicule en dehors du Berceau.');
INSERT INTO "item_descriptions" VALUES(1662,'fr','Porter autour du coup une Arakne prise dans l''ambre, lorsque vous attaquez une de ses sœurs, peut suffire à la décontenancer. Pauvre bête, on appelle cela l''ironie du sort.');
INSERT INTO "item_descriptions" VALUES(1665,'fr','Ces bottes bien étranges étaient utilisées sur les jeunes disciples un peu limités intellectuellement, pour leur permettre de rattraper leur retard. Elles conviendront particulièrement aux Iops.');
INSERT INTO "item_descriptions" VALUES(1666,'fr','Ces bottes ont été spécialement conçues pour ceux qui aiment laisser à leurs créatures le plaisir de faire tout le travail pendant les combats.');
INSERT INTO "item_descriptions" VALUES(1667,'fr','Cette ceinture porte le nom ridicule de son créateur, Luthuthu, un cordonnier beaucoup moins connu que Bowisse, mais encore très créatif malgré son âge avancé.');
INSERT INTO "item_descriptions" VALUES(1668,'fr','Le Dodu était un Sadida qui s''obstinait à faire trembler ses ennemis, il a commandé à Bowisse cette ceinture, assortie à la couleur de ses poils, car ne l''oublions pas, le Dodu en plus d''être un trembleur était un charmeur.');
INSERT INTO "item_descriptions" VALUES(1669,'fr','Cette ceinture a été créée pour la plus populaire des Crâs, qui aimait donner de son temps pour organiser tout un tas de fêtes et d''évènements hors du commun, histoire de divertir le peuple entre deux repassages de Slip en Cuir du Captain Chafer.');
INSERT INTO "item_descriptions" VALUES(1693,'fr','Jules Yanos, célèbre tailleur, était surtout célèbre pour avoir échangé sa femme contre un dé à coudre magique. Comme quoi, il existe encore des gens qui ont le sens des affaires.');
INSERT INTO "item_descriptions" VALUES(1695,'fr','On raconte que le Captain Chafer a tenté de voler cette cape pour remplacer ses célèbres sous-vêtements en cuir. Mais elle ne lui allait pas, elle n''incarnait pas assez la perversité et la perfidie pour lui.');
INSERT INTO "item_descriptions" VALUES(1697,'fr','Ce petit sac ne fera pas de vous une célébrité, mais il aura au moins le mérite de vous permettre de ranger quelques effets personnels.');
INSERT INTO "item_descriptions" VALUES(1698,'fr','Ce sac est spécialement étudié pour contenir quelques ressources collectables.
Seuls les vrais collecteurs sont à même de pouvoir le porter.');
INSERT INTO "item_descriptions" VALUES(1699,'fr','Ce sac est destiné à ceux qui ne partent pas trop loin de chez eux, et ont besoin d''emmener des choses pas importantes du tout, comme des Planches de Frêne par exemple.');
INSERT INTO "item_descriptions" VALUES(1700,'fr','Cette ceinture aérodynamique conçue par Tengra Reufrus vous rend agile comme l''air, et libre comme un Tofu. À moins que ça ne soit l''inverse.');
INSERT INTO "item_descriptions" VALUES(1701,'fr','Cette ceinture possède de petites poches permettant de stocker davantage d''objets dans votre inventaire.');
INSERT INTO "item_descriptions" VALUES(1702,'fr','Ce sac est spécialement étudié pour contenir des ressources collectables.
Seuls les vrais collecteurs sont à même de pouvoir le porter.');
INSERT INTO "item_descriptions" VALUES(1703,'fr','Ce sac est spécialement étudié pour contenir de nombreuses ressources collectables.
Seuls les vrais collecteurs sont à même de pouvoir le porter.');
INSERT INTO "item_descriptions" VALUES(1704,'fr','On raconte qu''un Mineur célèbre était capable de miner sans arrêt pendant des mois dans 4 mines différentes en même temps. Il s''agit en fait d''une légende inventée par la guilde du Marteau-Faucille pour inciter ses mineurs à récolter plus.');
INSERT INTO "item_descriptions" VALUES(1705,'fr','C''est le sac idéal pour ranger tous vos pains et potions lorsque vous partez pour plusieurs mois, dans le labyrinthe par exemple.');
INSERT INTO "item_descriptions" VALUES(1707,'fr','C''est le sac idéal pour ranger tous vos pains et potions lorsque vous partez en voyage vers des destinations exotiques, comme l''île de Moon.');
INSERT INTO "item_descriptions" VALUES(1711,'fr','Avec ce petit toutou, vous goûterez aux joies des petites promenades pipi. Fort de ses racines sauvages, il est déconseillé de lui donner à manger, sous peine de perdre une main.');
INSERT INTO "item_descriptions" VALUES(1718,'fr','Cet anneau fut enchanté par le souffle noir de Grougalorasalar, lui conférant un immense pouvoir, hélas aujourd''hui amoindri. Cette relique était destinée à Crocoburio car lui seul était à même d''équiper cet anneau sans subir sa domination.');
INSERT INTO "item_descriptions" VALUES(1719,'fr','Cette paire de bottes appartiendrait à Crocoburio. Le peu de personnes aptes à les chausser se sentent soudain envahis de pensées machiavéliques et ingénieuses. Ce maléfice étant, selon la légende, dû aux milliers de crânes qu''elles ont écrasés.');
INSERT INTO "item_descriptions" VALUES(1720,'fr','Grougalorasalar aimait garder des fragments d''os appartenant aux ennemis vaincus les plus forts. Son affection pour Crocoburio le poussa à les utiliser pour fabriquer cette ceinture surpuissante.');
INSERT INTO "item_descriptions" VALUES(1728,'fr','Cette petite boule de poil friponne et câline fait craquer la gent féminine toutes classes confondues. Un animal redoutable donc.');
INSERT INTO "item_descriptions" VALUES(1729,'fr','Cet anneau appartenait à Mèr, le plus gros fainéant de toute la contrée d''Amakna. Il vouait un culte aux doneuths, mais aussi aux côtelettes de ribs.');
INSERT INTO "item_descriptions" VALUES(1739,'fr','Cette baguette a d''étranges propriétés : au toucher, elle est brûlante. Mais le plus énigmatique reste son odeur de cendre, qui laisse à penser que le bois de cette baguette aurait survécu à un feu de forêt.');
INSERT INTO "item_descriptions" VALUES(1748,'fr','Ce petit Wabbit est domestiqué. Il ne vous mordra donc pas. En revanche pour les autres...');
INSERT INTO "item_descriptions" VALUES(1904,'fr','Une coquille de Dragoeuf Calcaire rembourrée de cuir et de laine, rien de tel pour se protéger des attaques classiques et des éclairs d''un Bwork Mage ivre. En revanche, vous avez l''air de sortir de l''œuf avec un pareil chapeau.');
INSERT INTO "item_descriptions" VALUES(1908,'fr','Même Spartapine le grand moissonneur, n''eut pas la chance de porter un tel casque, qui doit sa résistance aux métaux et pierres de qualité utilisés pour sa confection.');
INSERT INTO "item_descriptions" VALUES(1910,'fr','Cette cape provient d''un Ouginak, elle sent encore l''odeur de sa truffe, chaude et humide, un peu comme les mamelles d''une femelle Bouftou en rût.');
INSERT INTO "item_descriptions" VALUES(1934,'fr','Ce couteau est la marque typique de reconnaissance des chasseurs. Plus il est gros, coupant et brillant, plus ils se trouvent beaux... du moins selon leurs critères. Un chasseur équipé de cette arme aiguisée saura prélever les meilleurs morceaux sur les carcasses de ses proies.');
INSERT INTO "item_descriptions" VALUES(1942,'fr','L''arc de chasse est considéré comme l''arme de chasse la plus sûre. Un maximum de dégâts sans s''exposer pour un minimum de traces visibles.');
INSERT INTO "item_descriptions" VALUES(2061,'fr','Cette cape, pas très jolie au premier abord est pourtant très efficace, une fois que l''on s''habitue à son odeur de Corbac en décomposition.');
INSERT INTO "item_descriptions" VALUES(2063,'fr','Ces bottes, confectionnées avec de nombreuses parties de cadavres de Corbacs, donnent à leur porteur une étrange sensation de légèreté, comparable à celle apportée par la consommation de Bolets grillés.');
INSERT INTO "item_descriptions" VALUES(2066,'fr','Ce trident est la réplique approximative de la lance d''un Kanigrou, mais en trois fois plus efficace. Un peu comme un mot qui compte triple, ou une triple pinte de bière durant une soirée bien arrosée.');
INSERT INTO "item_descriptions" VALUES(2070,'fr','Ce casque en os a longtemps séjourné dans les poches d''un Kanigrou. Usé, rayé, il garde tout de même de belles propriétés.');
INSERT INTO "item_descriptions" VALUES(2074,'fr','Ce mignon petit bwak deviendra, plus tard, un affreux kwak. Jusque là n''ayez pas peur de le garder à vos cotés.');
INSERT INTO "item_descriptions" VALUES(2075,'fr','Ce mignon petit bwak deviendra, plus tard, un affreux kwak. Jusque là n''ayez pas peur de le garder à vos cotés.');
INSERT INTO "item_descriptions" VALUES(2076,'fr','Ce mignon petit bwak deviendra, plus tard, un affreux kwak. Jusque là n''ayez pas peur de le garder à vos cotés.');
INSERT INTO "item_descriptions" VALUES(2077,'fr','Ce mignon petit bwak deviendra, plus tard, un affreux kwak. Jusque là n''ayez pas peur de le garder à vos cotés.');
INSERT INTO "item_descriptions" VALUES(2094,'fr','Le Makroute Sombre est un chapeau qui provient d''un Makroute Déchiqueté recousu à la main et sans anesthésie.
Maintenant, il n''obéit plus qu''à son maître et adore mordre les inconnus.');
INSERT INTO "item_descriptions" VALUES(2095,'fr','Le Ours est un chapeau confectionné dans la tête d''un ours mort. Il a cependant gardé un poil soyeux. Le tailleur qui l''a confectionné devait être très habile pour avoir réussi a garder l''expression de mécontentement de l''ours d''origine.');
INSERT INTO "item_descriptions" VALUES(2096,'fr','C''est le fantôme Brave qui le premier comprit comment utiliser correctement de l''Osier Sombre à des fins autres que gastronomiques.');
INSERT INTO "item_descriptions" VALUES(2097,'fr','Le Champo appartenait à l''un des plus grands Maîtres Bolet d''Amakna. Vaillant et brillant, Gnion le Bolet était le seul de sa race à avoir réussi à se faire respecter des êtres humains.');
INSERT INTO "item_descriptions" VALUES(2104,'fr','Le Kraignosse est un casque inquiétant confectionné à partir de restes d''Ouginak et de divers détritus. Longtemps porté par Gourlo le Terrible, le Kraignosse fût l''image de la désolation.');
INSERT INTO "item_descriptions" VALUES(2118,'fr','Cette cape permet de passer incognito dans un cimetière, ou de se déguiser en Chafeuse lorsque le besoin d''extrême perversité se fait sentir.');
INSERT INTO "item_descriptions" VALUES(2119,'fr','Cette cape vous donne des ailes. La fumée qui s''en dégage lorsqu''elle brûle, pourra même vous faire planer.');
INSERT INTO "item_descriptions" VALUES(2154,'fr','Bague portée par Silaisie.');
INSERT INTO "item_descriptions" VALUES(2155,'fr','Amulette portée par Silaisie.');
INSERT INTO "item_descriptions" VALUES(2156,'fr','Cette épée permet de répandre la sainte parole.');
INSERT INTO "item_descriptions" VALUES(2233,'fr','Cette ceinture fut créée par Xof le Lenald, il eut la bonne idée de ramasser toutes les dents qu''il pouvait trouver sur un champ de bataille Wabbit. Depuis ce jour, ce geste est devenu une habitude.');
INSERT INTO "item_descriptions" VALUES(2341,'fr','Cet arc a été conçu par Mech Riorraw, il est calibré pour pouvoir traverser la rivière de lave et atteindre le haut des murailles de Brâkmar, ni plus, ni moins.');
INSERT INTO "item_descriptions" VALUES(2361,'fr','Cet arc est une invention du génial Mulic Bere. Sa portée maximum est tout bonnement incroyable. Le problème c''est que la portée minimum est presque aussi grande.');
INSERT INTO "item_descriptions" VALUES(2367,'fr','Léhunui savait se faire des amis, il conviait souvent ses camarades à de grandes soirées costumées. Il avait aussi pour réputation de mettre toujours les petits plats dans les grands et d''offrir de somptueux bijoux pour vous remercier de venir chez lui.');
INSERT INTO "item_descriptions" VALUES(2368,'fr','Ramoume était un ancien ami d''enfance de Nova, ils se sont perdus de vue quand Ramoume décida de faire une sieste éternelle.');
INSERT INTO "item_descriptions" VALUES(2369,'fr','Cette magnifique ceinture a été confectionnée suite à un pari fou. Le défi était d''améliorer une des plus belles ceintures conçue sur Amakna : la ceinture Fulgurante. Le pari fut réussi par Pakape Prométhé.');
INSERT INTO "item_descriptions" VALUES(2370,'fr','Équipement d''une légèreté incomparable, la Végète Hâtif vous apporte quelques pods de finesse dans ce monde de Bwork en rut.');
INSERT INTO "item_descriptions" VALUES(2371,'fr','Cette ceinture vous est conseillée par Jiva en personne, pour les nuits froides et rigoureuses. En cas de taches, elle se lave avec du Rimennelle.');
INSERT INTO "item_descriptions" VALUES(2372,'fr','Ces bottes donnent l''impression de marcher constamment dans l''herbe fraîche. Elles sont donc idéales pour ceux dont l''odeur des pieds se rapproche plus du Clakoss, que de la Gelée Menthe.');
INSERT INTO "item_descriptions" VALUES(2373,'fr','Portées sur l''île de Moon, ces bottes vous permettront de transpirer comme un vieux Porkass poilu coincé dans un chaudron posé sur un feu de camp au milieu du village des Bworks un jour d''été et en plein soleil.');
INSERT INTO "item_descriptions" VALUES(2374,'fr','Tarsy était un ermite qui n''appréciait pas trop les visites. Pour preuve, il recevait ses invités en leur montrant de très près la pointure de ses Bottes.');
INSERT INTO "item_descriptions" VALUES(2375,'fr','Grâce à ces bottes, vous serez à même d''entendre le vent dans les voiles d''un bateau situé en pleine Mer d''Asse, ou d''entendre les gémissements d''un Chafer Lancier, perdu dans les tréfonds du labyrinthe.');
INSERT INTO "item_descriptions" VALUES(2376,'fr','Cette hache fera mal à votre adversaire même s''il est matinal.');
INSERT INTO "item_descriptions" VALUES(2380,'fr','Cette Cape est bien étrange, elle est faite de bouts de boue du Boo, mais elle tient tout de même debout. Une fois sur vos épaules, elle pourra même faire de vous un boute-en-train.');
INSERT INTO "item_descriptions" VALUES(2381,'fr','Cette Cape fut découpée dans un fanion, anciennement situé sur la plus haute tour du chateau d''Amakna. C''est sûrement pour cela qu''elle sent le linge séché au grand air.');
INSERT INTO "item_descriptions" VALUES(2382,'fr','Maimpa était un Ecaflip qui se moquait du vide, prétextant qu''il retomberait toujours sur ses pattes. Mais un jour, il atterrit sur un Trool affamé. Il fût enterré le jour même à l''endroit où l''on a trouvé ses restes. Un peu partout en quelques sortes.');
INSERT INTO "item_descriptions" VALUES(2383,'fr','A base de tissu sanguin, la Cape Sanguine a un aspect cartonneux au toucher, comme si la teinture rougeâtre avait coagulé.');
INSERT INTO "item_descriptions" VALUES(2384,'fr','On peut le dire, ces Bottes ont un côté comment dire... Hmmm... Bestial. Ne vous étonnez donc pas si un Mulou tombe amoureux de vos Bottes. C''est peut-être la pire chose qui puisse vous arriver.');
INSERT INTO "item_descriptions" VALUES(2385,'fr','Idéale pour le jardin, la Brouteuse peut aussi servir de paillasson pour votre entrée de maison. Conçue à la base pour les Sadidas, elle n''abîme pas les poils, même les plus fragiles. Certains vont même jusqu''à dire qu''elle ralentit leur chute.');
INSERT INTO "item_descriptions" VALUES(2386,'fr','Cette étrange Cape puise toute sa force dans son aspect vétuste. Plus elle sera sale, et plus elle vous servira.');
INSERT INTO "item_descriptions" VALUES(2387,'fr','Il faut avouer que cette Cape possède une forte odeur très désagréable. En essayant de mettre des mots sur cette infection, on peut dire que c''est tout simplement un mélange de poils de monstres divers qui créent ce magnifique pot pourri.');
INSERT INTO "item_descriptions" VALUES(2388,'fr','Autrefois, un Ecaflip nommé Dodge, éclata en mille morceaux une carte au trésor gravée sur une pierre. Croyant réussir à reformer la carte, il garda la plus grosse partie pour en faire une Amulette mystérieuse. Nul ne sait ce que le trésor est devenu.');
INSERT INTO "item_descriptions" VALUES(2389,'fr','Dodge adorait exploser tout ce qui avait de la valeur à ses yeux. Il disait que c''était la preuve qu''il existait. Chacun son truc.');
INSERT INTO "item_descriptions" VALUES(2390,'fr','Cette Amulette est presque parfaite, elle accroît considérablement la sagesse de celui qui la porte autour du cou. Très utile pour paraître plus sage auprès de vos amis, ou vous faire passer pour un écolier modèle.');
INSERT INTO "item_descriptions" VALUES(2391,'fr','Un ancien proverbe de Sufokia dit : de la boule un jour, de la bouboule peut-être un autre jour. Qu''est-ce que cela veut dire ? Ça n''a pas vraiment d''importance.');
INSERT INTO "item_descriptions" VALUES(2392,'fr','Grâce aux multiples talents des artisans d''Amakna, la Dragolyre Remaniée excelle dans la perfection.');
INSERT INTO "item_descriptions" VALUES(2393,'fr','L''osamodas Onehaieuf Bek cherchait absolument à gagner du mérite devant les membres de sa guilde, et décida alors de faire une Amulette révolutionnaire. Il y parvint en préparant un petit déjeuner à ses amis. Étrange.');
INSERT INTO "item_descriptions" VALUES(2394,'fr','Gorgée de soleil, la Bourgeonette réchauffe les cœurs en plus de procurer une sensation d''invulnérabilité face à la terre. Elle est aussi tellement légère qu''on oublie souvent de l''enlever à l''heure du coucher.');
INSERT INTO "item_descriptions" VALUES(2395,'fr','Le Lard Fou était un petit démon bien vil qui ne pouvait s''empêcher de rester planté devant les gens sans bouger. Il était aussi résistant à la magie, ce qui imposait le respect à l''époque. Depuis, le Lard Fou se terre quelque part et attend.');
INSERT INTO "item_descriptions" VALUES(2396,'fr','Sylveline n''était pas très futée. Sa mère, Lou, lui offrit cette lanterne en disant "Tiens! Au moins tu seras une lumière !". Elle non plus n''était pas une lanterne. Ce qui ne l''a pas empêchée d''avoir un éclair de génie qui illumina la vie de sa fille.');
INSERT INTO "item_descriptions" VALUES(2397,'fr','Law-bibe était un vieillard qui adorait assembler n''importe quoi pour en faire un objet. Un jour, il créa ce médaillon aux formes intrigantes. Une fois autour du cou, il ressentit une étrange sensation. Bien étrange sensation même...');
INSERT INTO "item_descriptions" VALUES(2398,'fr','Offert à Melyonen par le célèbre Kanigrou Rook Y Balboua, pour la remercier de lui avoir présenté celle qui est maintenant sa femme, Ar d''rieeeeeeeeeneuh comme il aime à l''appeler.');
INSERT INTO "item_descriptions" VALUES(2399,'fr','Jozébo Vez était un berger de Boufmouths, lointains cousins des Bouftous. Dans son troupeau, quelques bêtes possédaient une fourrure plus douce que les autres. Elle se revendait bien plus cher et pour différencier ses bêtes, il attachait ce collier à leur cou.');
INSERT INTO "item_descriptions" VALUES(2400,'fr','On peut le dire, ces Bottes ont un côté comment dire, .....hmmm.... Sombre. Ne vous étonnez donc pas si un Vampire tombe en amour devant vous et vos Bottes. C''est peut-être la pire chose qui puisse vous arriver.');
INSERT INTO "item_descriptions" VALUES(2403,'fr','Autrefois utilisée pour les libertés conditionnelles, la Chtévu possède paraît-il un pouvoir supplémentaire par rapport aux autres ceintures. Mais personne n''a encore trouvé. Mieux vaut donc garder un œil sur cette ceinture.');
INSERT INTO "item_descriptions" VALUES(2404,'fr','Cette ceinture a appartenu à un Rat d''Egoûtant, elle lui allait à merveille, bien moulante au niveau des hanches, elle lui permettait de cacher ses poignées d''amour.');
INSERT INTO "item_descriptions" VALUES(2409,'fr','La Kwakoiffe de Flammes vous donne réellement une allure de tombeur, ce qui est très pratique pour mettre à terre vos adversaires, lorsque ceux-ci n''arrivent plus à tenir debout tellement ils rigolent, en vous voyant affublé de cette coiffe.');
INSERT INTO "item_descriptions" VALUES(2410,'fr','L''Abracaska permet d''éviter les gueules de bois.');
INSERT INTO "item_descriptions" VALUES(2411,'fr','Ce superbe chapeau permet à son porteur de gagner force et intelligence si ce dernier parvient à s''accommoder de l''odeur.');
INSERT INTO "item_descriptions" VALUES(2412,'fr','Très peu irritante, mais un peu quand même il faut l''avouer, cette cape ne pourra pas hélas vous faire voler, ni même planer. Même en y cousant un grand "M" dessus, ça ne marchera pas, certains y croyaient pourtant dur comme fer. Dommage.');
INSERT INTO "item_descriptions" VALUES(2413,'fr','Vêtu de Feuilles d''Abraknydes, vous pourrez vous pavaner au beau milieu de la forêt sans que l''on vous reconnaisse vraiment. Attention toutefois aux Abraknydes en quête de bourgeonnements printaniers.');
INSERT INTO "item_descriptions" VALUES(2414,'fr','Cette cape a tout pour plaire : sa résistance, son confort, sa couleur, sa rareté... En revanche son odeur est redoutable pour les parois nasales. Mais bon, on ne peut pas tout avoir non plus.');
INSERT INTO "item_descriptions" VALUES(2415,'fr','La Kwaklame de Flammes est une arme vraiment stylée. A défaut de faire peur à votre adversaire, elle vous servira à l''impressionner, pour ensuite mieux le surprendre par une vieille ruse de fourbe.');
INSERT INTO "item_descriptions" VALUES(2416,'fr','Le manuel de l''utilisateur explique que ce surprenant marteau est capable de libérer une énergie colossale lorsqu''il est correctement manié. Encore un manuel Osamodas traduit en Sadida...');
INSERT INTO "item_descriptions" VALUES(2417,'fr','Ce bâton a été sculpté à partir d''un Abraknyde d''un certain âge : on le reconnaît à sa forme agressive, mais il n''a pas conservé l''odeur de bois moisi qui caractérise souvent les vieilles branches.');
INSERT INTO "item_descriptions" VALUES(2418,'fr','Grâce à cet anneau, si vous vous perdez en allant délivrer un message, votre maître pourra peut-être vous retrouver.');
INSERT INTO "item_descriptions" VALUES(2419,'fr','Cet anneau provient du fameux Bouze le Clerc, sauveur des temps modernes. Sa phrase culte parlait d''un fin Eni et d''au-delà.');
INSERT INTO "item_descriptions" VALUES(2420,'fr','Travailler la Branche d''Abraknyde n''est pas chose aisée. Mais avec de la persévérance, on peut finir par obtenir un anneau à la fois sobre, élégant et raffiné. Tout le contraire d''un Sadida dans une taverne.');
INSERT INTO "item_descriptions" VALUES(2421,'fr','Muni de ces ergots de Kwak de Feu, il ne vous reste plus qu''à marcher sur des œufs pour ne pas vous les faire voler par un Sram mal intentionné.');
INSERT INTO "item_descriptions" VALUES(2422,'fr','Ces bottes sont d''un confort inégalé, l''intérieur a l''air d''être doublé en laine de Bouftou, mais on peut ressentir également comme un liquide circulant entre les orteils. Reste à savoir si c''est de la bave ou du sang de Bouftou. Peu importe.');
INSERT INTO "item_descriptions" VALUES(2423,'fr','Les effets de cette paire de Bottes peuvent aussi parfaitement être retrouvés en se rendant dans une taverne. Il faut ensuite consommer un peu, voire beaucoup pour un effet optimum. Le lendemain vous aurez des jambes aussi lourdes que ces bottes.');
INSERT INTO "item_descriptions" VALUES(2424,'fr','Avec toutes ces plumes autour du cou, vous ressemblerez à Aldo Rado, grand Sacrieur aventurier en quête d''une cité d''or.');
INSERT INTO "item_descriptions" VALUES(2425,'fr','Une bonne Corne de Bouftou, c''est une Corne qui procure calme et sagesse. Un Bon pendentif de Bouftou vous procurera donc sagesse et calme. Ou l''inverse. Ou autre chose. Ou alors rien.');
INSERT INTO "item_descriptions" VALUES(2426,'fr','Cette petite Arakne est la preuve vivante que l''on est pas obligé d''empailler un animal pour en faire une Amulette. Elle vous chatouillera le cou, et tissera peut-être une toile devant votre bouche, si vous baillez trop souvent, ou si vous avez trop mauvaise haleine.');
INSERT INTO "item_descriptions" VALUES(2427,'fr','Pour parader comme un Kwak de Flammes pendant la saison des amours, cette ceinture sera parfaite, à condition de ne porter que ça.');
INSERT INTO "item_descriptions" VALUES(2428,'fr','Rapide à équiper, cette ceinture s''avère tout de même assez légère pour sa taille. La laine donne l''impression d''être neuve. Normal, il a fallu selon la légende, dépecer une centaine de bouftons pour avoir cet aspect lisse et soyeux.');
INSERT INTO "item_descriptions" VALUES(2429,'fr','Cette ceinture vous apportera assurance et abdominaux en bois. Un traitement anti-Arakne est néanmoins recommandé tous les ans. Un peu comme la coiffure d''un Sadida, avec heureusement trois fois moins d''anti-parasites.');
INSERT INTO "item_descriptions" VALUES(2435,'fr','Kère fut le seul Eniripsa à remporter devant les Ecaflips le grand marathon d''Amakna. C''est grâce à ses bottes artisanales qu''il traversa la Mer d''Asse et distança tous les Ecaflips médusés de voir un Eni courir sur l''eau. La classe.');
INSERT INTO "item_descriptions" VALUES(2438,'fr','La Boufcoiffe Royale est un objet indémodable. Elégante, elle procure à son porteur force et intelligence.');
INSERT INTO "item_descriptions" VALUES(2440,'fr','Cette épée ne sait pas trop sur quel sabot danser... Elle inflige des dégâts de chaque élément.');
INSERT INTO "item_descriptions" VALUES(2441,'fr','Cet anneau augmente la vie de son porteur, tout comme l''odeur de la femelle du Bouftou Royal augmente son charme.');
INSERT INTO "item_descriptions" VALUES(2442,'fr','Elles brillent, elles respirent la puissance, ces bottes sont en tous points royales.');
INSERT INTO "item_descriptions" VALUES(2443,'fr','Cette amulette augmente la force et l''intelligence de son porteur.');
INSERT INTO "item_descriptions" VALUES(2444,'fr','Cette magnifique ceinture augmente la vitalité de son porteur et lui permet de porter plus facilement ses objets. Elle est si douce qu''elle permet même de ligoter sa dulcinée lorsque celle-ci refuse de rester à la maison.');
INSERT INTO "item_descriptions" VALUES(2445,'fr','Cette cape portée par le grand Bouftou Royal confère, en plus d''un style fabuleux, une force hors du commun.');
INSERT INTO "item_descriptions" VALUES(2446,'fr','Dépourvue de fils et de poils, cette Cape reste un mystère pour les têtes pensantes d''Amakna, ce qui ne doit pas représenter plus d''une dizaine de personnes.');
INSERT INTO "item_descriptions" VALUES(2447,'fr','Avec cette coiffe sur la tête, vous pouvez être certain que vos amis rêveront enfin de vous lécher. Voilà un chapeau qui aurait comblé le Captain Chafer à la grande époque.');
INSERT INTO "item_descriptions" VALUES(2469,'fr','Inutile de vous ronger les ongles avec cet anneau, léchez-vous les doigts !');
INSERT INTO "item_descriptions" VALUES(2470,'fr','Ces bottes sont très confortables en été, car elles libèrent une odeur de fraise des bois, couvrant facilement l''odeur de transpiration qui pourrait se dégager des orteils d''un vieux Sadida aux pieds poilus.');
INSERT INTO "item_descriptions" VALUES(2471,'fr','Le plus dur avec cette Geloture, c''est qu''en cas de fringale, on est vite tenté de croquer dedans.');
INSERT INTO "item_descriptions" VALUES(2472,'fr','Voilà une amulette, qui trahira votre goût prononcé pour les orgies de Gelée. On peut trouver mieux pour se mettre en valeur ou briller en société, mais il faut assumer jusqu''au bout votre faible pour la gelée.');
INSERT INTO "item_descriptions" VALUES(2473,'fr','Classe mais peu performante, cette cape comblera tout de même les jeunes aventuriers.');
INSERT INTO "item_descriptions" VALUES(2474,'fr','À part faire fuir les nanas, ce chapeau n''a pas vraiment grande utilité.');
INSERT INTO "item_descriptions" VALUES(2475,'fr','Un petit anneau sympathique pour les débutants, et qui amusera les jeunes enfants, ou les Ecaflips.');
INSERT INTO "item_descriptions" VALUES(2476,'fr','Bottes de simple facture mais idéales pour les jeunes se lançant sur le dur chemin de l''aventure.');
INSERT INTO "item_descriptions" VALUES(2477,'fr','Une petite ceinture pour les aventuriers en herbe.');
INSERT INTO "item_descriptions" VALUES(2478,'fr','Pas très classe, pas très efficace, mais sympathique lorsque l''on possède la panoplie.');
INSERT INTO "item_descriptions" VALUES(2485,'fr','Le top du top de la mode, mais uniquement au nord-est d''Amakna.');
INSERT INTO "item_descriptions" VALUES(2489,'fr','Une cape élégante qui vous rendra irrésistible auprès des amateurs de belles plantes.');
INSERT INTO "item_descriptions" VALUES(2498,'fr','La Vegamu a parfois tendance à attirer les Moskitos, qui de loin la prennent pour une copine. Ils sont souvent déçus une fois qu''ils tombent sur le porteur de l''amulette.');
INSERT INTO "item_descriptions" VALUES(2521,'fr','Roll, la gentille sœur du propriétaire de ces bottes, était spécialisée en taxidermie astrale. Jadis, personne n''était capable de comprendre la différence entre la taxidermie, et la taxidermie astrale. Mais on peut sans peine, imaginer de nos jours, que la taxidermie astrale permet de confectionner des créatures empaillées astrales. Si ça vous paraît évident maintenant, c''est peut-être parce que vos ancêtres étaient stupides.');
INSERT INTO "item_descriptions" VALUES(2522,'fr','Ces bottes permettaient au célèbre Jojo d''augmenter la puissance de son célèbre coup de pied rotatif, également connu sous le nom de "coup rouge et chaud". On se demande toujours pourquoi il était appelé ainsi, puisque ses bottes étaient blanches.');
INSERT INTO "item_descriptions" VALUES(2523,'fr','Cette ceinture a été spécialement conçue pour protéger les hanches des héros. Elle ne vous sera donc d''aucune utilité.');
INSERT INTO "item_descriptions" VALUES(2524,'fr','On raconte que cette ceinture aurait été fabriquée par le capitaine Bloue en personne. À peine croyable, et pourtant vous y croyez tout de même.');
INSERT INTO "item_descriptions" VALUES(2530,'fr','Elles sont un peu lourdes, mais ces charmantes Carabottes feront de vous la reine de la nuit.');
INSERT INTO "item_descriptions" VALUES(2531,'fr','Comme vous, la tortue a vraiment une toute petite tête. Ca tombe bien, ce chapeau est spécialement prévu pour ça.');
INSERT INTO "item_descriptions" VALUES(2532,'fr','Une cape pratique et résistante, qui ne fera pas de vous une célébrité, mais comme vous n''en étiez pas une jusqu''à maintenant, où est le problème ?');
INSERT INTO "item_descriptions" VALUES(2534,'fr','Idéale pour se rafraîchir sur l''île de Moon pendant la saison chaude, et parfaite pour refroidir les ardeurs de vos amis les plus entreprenants, cette cape saura répondre aux attentes de l''aventurier des temps modernes.');
INSERT INTO "item_descriptions" VALUES(2535,'fr','Cette Kwakoiffe de Glace vous permettra de toujours avoir des idées fraîches, même lorsque vous serez à court d''idées. Elle n''est cependant pas assez puissante pour un Iop.');
INSERT INTO "item_descriptions" VALUES(2537,'fr','Idéale pour vous raffermir les hanches, cette ceinture vous permettra de garder bien au frais ce que vous avez en dessous de la ceinture.');
INSERT INTO "item_descriptions" VALUES(2544,'fr','Terriblement tranchante et incroyablement classe, cette lame risque de faire des jaloux parmi votre entourage de Corbacs.');
INSERT INTO "item_descriptions" VALUES(2545,'fr','Ces bottes donnent à leur porteur une impression d''incroyable légèreté, mais aussi un air stupide.');
INSERT INTO "item_descriptions" VALUES(2546,'fr','Grâce à cette magnifique coiffe, vous aurez au moins autant de classe que le tristement célèbre Maître Corbac.');
INSERT INTO "item_descriptions" VALUES(2547,'fr','Les meilleurs tailleurs d''Amakna se sont associés jadis pour utiliser les restes de la dépouille du Maître Corbac afin d''en faire une cape somptueuse. Avec une telle cape sur les épaules, le maître c''est vous.');
INSERT INTO "item_descriptions" VALUES(2587,'fr','Cette hachette est l''outil indispensable à tout bûcheron. Non pas qu''elle soit réellement utile, impossible de couper un arbre avec, mais sa présence à la ceinture les calme et les rassure.');
INSERT INTO "item_descriptions" VALUES(2589,'fr','Cette petite hache ne sait pas couper les arbres, mais peut servir à se défendre contre certains petits monstres. Par contre il vous faudra toujours courir si c''est un Minotoror.');
INSERT INTO "item_descriptions" VALUES(2590,'fr','Cette série de haches fut conçue par un bwork apprenti forgeur. Elle est bien équilibrée et relativement puissante. Ce bwork venait de créer LA hache de guerre pour jeune aventurier.');
INSERT INTO "item_descriptions" VALUES(2592,'fr','Très légère et maniable, cette hache facilite les gestes amples nécessaires afin de couper le Bombu en toute sécurité.');
INSERT INTO "item_descriptions" VALUES(2593,'fr','Cette hache, faite d''Oliviolet, est la hache la plus à même à résister aux ondes violettes de l''Oliviolet. Combattre le mal par le mal en quelque sorte.');
INSERT INTO "item_descriptions" VALUES(2595,'fr','Cette hache, très primitive, n''en reste pas moins efficace. Un peu comme certains vieillards.');
INSERT INTO "item_descriptions" VALUES(2597,'fr','Cette longue hache se faufile dans les moindres interstices des arbres pour mieux les fendre en deux. Son utilité en combat est la même, l''adversaire ayant toujours un interstice ou deux à exploiter.');
INSERT INTO "item_descriptions" VALUES(2600,'fr','Cette grosse hache fait un bruit monstrueux lorsqu''elle s''abat sur quelque chose, ce qui a souvent pour effet de provoquer le silence autour de soi. C''est toujours ça de pris.');
INSERT INTO "item_descriptions" VALUES(2601,'fr','Darsson était un vaillant Enutrof adroit comme ses pieds. Faisant souvent tomber sa pelle en combat, il eût l''ingénieuse idée d''attacher une hache de rechange à sa ceinture. Cela lui sauva la vie plusieurs fois, jusqu''à ce qu''il fasse tomber sa hache...');
INSERT INTO "item_descriptions" VALUES(2603,'fr','Cette hache est très utile pour séparer certaines parties récalcitrantes d''un arbre, notamment les petites boursoufflures du tronc, ceci dans le but d''avoir un arbre parfaitement lisse et rond.');
INSERT INTO "item_descriptions" VALUES(2604,'fr','Cette bardiche est principalement employée par les miliciens d''Amakna. Sa longueur et son efficacité doit probablement compenser d''autres choses.');
INSERT INTO "item_descriptions" VALUES(2606,'fr','Cette hache est recouverte des lettres d''un alphabet primitif. Gégé Rudih pensait naïvement pouvoir l''utiliser pour dialoguer avec les arbres. Il a été aperçu pour la dernière fois dans la forêt des Abraknydes sombres.');
INSERT INTO "item_descriptions" VALUES(2608,'fr','Cette hache fait souvent le tour du monde en commençant par le bas. Et pour cause c''est dans le sud d''Amakna que ce type de hache est forgée, par une petite guilde de chasseurs de trésors réputée pour leur efficacité.');
INSERT INTO "item_descriptions" VALUES(2612,'fr','Cette longue hache est utilisée par les marins experts pour affronter les poissons géants qui attaquent leurs navires. On imagine assez bien les dégâts qu''elle peut faire contre des monstres plus petits.');
INSERT INTO "item_descriptions" VALUES(2614,'fr','La Dame Oise était une ravissante princesse qui respirait la candeur et la fraîcheur. Tout le monde fut bien surpris lorsque, lors d''un raid Bwork sur sa cité, elle sortit cette hache et fracassa à elle seule la moitié de l''armée adverse.');
INSERT INTO "item_descriptions" VALUES(2615,'fr','Cette hache est réputée pour son efficacité à terminer définitivement et très rapidement une querelle entre Enutrofs ivres.');
INSERT INTO "item_descriptions" VALUES(2616,'fr','Cette hache tire son nom du test qui fut utilisé pour prouver sa terrible efficacité : une hache géante, un mythophobiaque et une halle remplie de bardes.');
INSERT INTO "item_descriptions" VALUES(2629,'fr','Cette cape, d''allure royale, constitue pourtant une incroyable protection. C''est ce modèle qui a fait la réputation d''une célèbre tailleuse, juste avant de mourir de son succès, écrasée par la foule.');
INSERT INTO "item_descriptions" VALUES(2637,'fr','Cette lame recourbée, faite d''os, de cartilage et de corne, est aussi tranchante qu''une griffe d''Ecaflip. En un peu plus gros et plus propre.');
INSERT INTO "item_descriptions" VALUES(2638,'fr','Cent pour cent naturelle, cette épée est comme une sixième griffe pour une main Ecaflip. A ce propos, faites attention à ne pas vous grattouiller le museau avec cette griffe là !');
INSERT INTO "item_descriptions" VALUES(2639,'fr','Une forgeuse ecaflipette eut l''idée de forger cette épée après son échec à maitriser la technique ancestrale du même nom. Elle se disait qu''au moins cette griffe ne lui ferait pas faux bond.');
INSERT INTO "item_descriptions" VALUES(2640,'fr','Étrangement sculpté, ce Bâton ne provient pas du coin. Il sent les vieux endroits humides et sombres de Brâkmar.');
INSERT INTO "item_descriptions" VALUES(2641,'fr','Rouge, blanc et surtout somptueusement classe, ce chapeau vous permettra d''assurer un max lors des soirées de l''ambassadeur qui sont toujours une réussite.');
INSERT INTO "item_descriptions" VALUES(2655,'fr','Cette ceinture a été confectionnée à partir des restes du Maître Corbac, soigneusement cousus entre eux. Vous devriez vous sentir respecté une fois équipé de celle-ci. Le Chouque a même accepté de prêter sa boucle pour l''occasion.');
INSERT INTO "item_descriptions" VALUES(2677,'fr','Cette ceinture a été confectionnée à partir des éléments les plus puissants du Chouque, notamment son célèbre caleçon. De quoi mettre en émoi toutes les flibustières du bar des pirates.');
INSERT INTO "item_descriptions" VALUES(2678,'fr','Cette ceinture ressemble presque à un pagne, elle conviendra parfaitement si vous voulez vous camoufler parmi les Kokokos de l''île de Moon, ou tout simplement si vous désirez courtiser un Kokoko.');
INSERT INTO "item_descriptions" VALUES(2681,'fr','Cette petite ceinture est idéale pour protéger les parties sensibles, des coups critiques.
Vérifiez tout de même que le cordonnier a bien retiré le propriétaire de la carapace avant que vous ne l''essayez.');
INSERT INTO "item_descriptions" VALUES(2683,'fr','Cette petite ceinture est idéale pour protéger les parties sensibles, des coups critiques.
Vérifiez tout de même que le cordonnier a bien retiré le propriétaire de la carapace avant que vous ne l''essayez.');
INSERT INTO "item_descriptions" VALUES(2685,'fr','Cette petite ceinture est idéale pour protéger les parties sensibles, des coups critiques.
Vérifiez tout de même que le cordonnier a bien retiré le propriétaire de la carapace avant que vous ne l''essayez.');
INSERT INTO "item_descriptions" VALUES(2687,'fr','Cette petite ceinture est idéale pour protéger les parties sensibles, des coups critiques.
Vérifiez tout de même que le cordonnier a bien retiré le propriétaire de la carapace avant que vous ne l''essayez.');
INSERT INTO "item_descriptions" VALUES(2688,'fr','Le moins que l''on puisse dire, c''est qu''une fois enfilée, vous ne risquez plus de perdre cette ceinture. Elle fera le bonheur des étourdis et des victimes récurrentes de vols.');
INSERT INTO "item_descriptions" VALUES(2689,'fr','Le cordonnier qui a créé cette ceinture avec les restes d''une Dragodinde devait vraiment manquer d''imagination, pour lui donner un nom aussi stupide.');
INSERT INTO "item_descriptions" VALUES(2710,'fr','Comportant des renforts en fer, c''est une version améliorée de la classique Ceinture Banisation, elle a été spécialement conçue pour chasser les Dragodindes Sauvages dans les contrées sauvages.');
INSERT INTO "item_descriptions" VALUES(2803,'fr','Cette étrange ceinture est entièrement constituée de fragments de pince, et de carapace de crabe. Même en employant une magie très puissante, elle sentira toujours aussi mauvais, il faut vous rendre à l''évidence.');
INSERT INTO "item_descriptions" VALUES(2804,'fr','Le célèbre Mulou a fait don de ses plus précieux organes pour aider à la confection de cette ceinture incroyable qui respire la puissance malgré son apparence assez étrange qui comblerait le plus pervers des Chafers.');
INSERT INTO "item_descriptions" VALUES(2807,'fr','C''est Bowisse le Cordonnier en personne, qui a conçu cette ceinture. Il l''a offerte à Brouce Boulgoure lorsque celui-ci a réussi à déraciner à mains nues le Chêne Mou, il y a de ça très longtemps.');
INSERT INTO "item_descriptions" VALUES(2808,'fr','Cette ceinture fera de vous une personne irrésistible. Bowisse recommande cependant de ne pas s''approcher du Dragon Cochon avec cette ceinture, cela pourrait réveiller certaines de ses pulsions les plus tourmentées.');
INSERT INTO "item_descriptions" VALUES(2809,'fr','Derrière ce nom assez grotesque, se cache une belle création de Bowisse le Cordonnier qui lors d''une promenade dans le Donjon des Squelettes a eu l''idée de récupérer les restes de ses ennemis.');
INSERT INTO "item_descriptions" VALUES(2810,'fr','Cette magnifique ceinture de couleur rousse, vous permettra grâce à ses pouvoirs magiques de mieux vous concentrer et d''apprendre plus rapidement. Le rêve de tous les cancres d''Amakna.');
INSERT INTO "item_descriptions" VALUES(2811,'fr','Voilà une ceinture qui saura plaire aux amateurs de sensations fortes. En effet cette dernière a été conçue spécialement pour pouvoir s''approcher sans risques des Ouginaks. Son efficacité n''a cependant pas encore été prouvée.');
INSERT INTO "item_descriptions" VALUES(3203,'fr','L''origine de cet anneau est pour le moins douteuse, on pense qu''il a appartenu à une tribu de Sadidas Kannibouls végétariens mangeurs de fougères de la pire espèce qui soit. Sûrement une histoire pour faire peur aux jeunes Sadidas.');
INSERT INTO "item_descriptions" VALUES(3204,'fr','C''est la ceinture la plus à la mode dans les rues de Bonta. Elle est ornée au niveau de la boucle, de l''insigne d''une célèbre confrérie de cordonniers.');
INSERT INTO "item_descriptions" VALUES(3205,'fr','C''est la ceinture la plus en vogue dans les égouts de Brâkmar. Pour donner l''impression d''être un dur à cuir, elle est parfaite. Pour faire de vous un dur à cuir, vous pouvez trouver mieux.');
INSERT INTO "item_descriptions" VALUES(3206,'fr','Créée spécialement pour récompenser les guerriers les plus habiles de leurs mains, elle se porte sans sous-vêtements et uniquement en hiver.');
INSERT INTO "item_descriptions" VALUES(3207,'fr','Ces bottes sont si confortables, si légères, que l''on ne peut qu''en être satisfait. Seul un adversaire pourrait ne pas être satisfait si vous lui faites voir vos semelles d''un peu trop près. Et encore ce n''est pas dit.');
INSERT INTO "item_descriptions" VALUES(3356,'fr','Rien de mieux pour avoir la "doudi-attitude", que d''utiliser cette pelle surprenante. On se moquera peut-être de vous, mais qu''importe, il est temps d''assumer votre style et vos goûts différents.');
INSERT INTO "item_descriptions" VALUES(3357,'fr','En Amakna, lorsque les jeunes écoliers ne sont pas sages ou ne comprennent rien, on leur tape les doigts avec ce marteau. Celui-ci a écrasé surtout des doigts de Iops.');
INSERT INTO "item_descriptions" VALUES(3647,'fr','Cette dague en forme de faucille, servait à éviscérer les voyageurs égarés. Elle tire son nom, de toutes les beuveries à la taverne que son propriétaire se payait après avoir dépouillé ses pauvres victimes.');
INSERT INTO "item_descriptions" VALUES(3648,'fr','Si le Captain Chafer a disparu, sa dague elle, est bien entre vos mains. Si son manche est passé entre les mains du célèbre Captain Chafer, imaginez où la lame a pu passer...');
INSERT INTO "item_descriptions" VALUES(3649,'fr','C''est le célèbre artisan Daguiero qui eut l''idée de créer une telle dague. Plutôt versé dans les jeux d''argents et activités peu recommandables, ce fut sa dernière création réellement digne d''intérêt. On peut imaginer pire comme fin de carrière.');
INSERT INTO "item_descriptions" VALUES(3650,'fr','Ces puissantes dagues sont le fruit d''une coopération entre les seuls artisans capables de se mettre d''accord sur l''avenir de leur profession. Ils ne furent que deux. Ils moururent tous les deux en se disputant à propos du nom de ces dagues.');
INSERT INTO "item_descriptions" VALUES(3651,'fr','Un ridicule petit artisan du nom de Slaillehine, a eu la brillante idée de bricoler ces superbes dagues. Du jour au lendemain, tout le monde faisait la queue devant sa forge, c''est comme cela qu''il a trouvé un nom pour cette dague.');
INSERT INTO "item_descriptions" VALUES(3652,'fr','Marie Aigue savait y faire avec les hommes, son bâton savait repousser les avances des plus grands chevaliers Iops. Ce fut bien plus tard que l''on découvrit que Marie Aigue n''était autre qu''un garçon, habillé en fille.');
INSERT INTO "item_descriptions" VALUES(4241,'fr','Cette épée, d''une couleur peu commune, permet d''attendrir l''ennemi avant d''attendrir sa chair. Comme le ferait une douce Ecaflipette. Sa teinte particulière est obtenue en trempant la lame dans des viscères de monstres pendant plusieurs centaines d''années.');
INSERT INTO "item_descriptions" VALUES(4242,'fr','A l''origine, cette épée était un accessoire utile pour s''aérer le visage. Il suffisait juste de l''agiter avec vigueur. Après que quelques têtes sont tombées, il fut admis qu''utiliser du métal pour ce genre d''objet n''était pas une bonne idée.');
INSERT INTO "item_descriptions" VALUES(4381,'fr','Cette étrange amulette, permet à son porteur de s''endormir pour une bonne sieste en plein combat. Un peu comme un Féca le ferait contre un groupe de Craqueleurs.');
INSERT INTO "item_descriptions" VALUES(4382,'fr','Cette épée, à la lame froide et pointue, fait ressurgir les instincts les plus basiques de celui qui la porte. Chaque geste, si anodin soit-il, est alors exécuté comme un coup bas. Il vous faudra renforcer votre esprit pour résister à cette lame.');
INSERT INTO "item_descriptions" VALUES(4684,'fr','Cette amulette renferme une partie de l''histoire des Craqueleurs des Plaines qui pourrait se résumer en deux lignes si quelqu''un la connaissait. Malheureusement, les Craqueleurs eux-mêmes ne la connaissent pas.');
INSERT INTO "item_descriptions" VALUES(5122,'fr','Epuop Tik en personne a commandé cette amulette à un illustre bijoutier. Il désirait pouvoir habiller toutes ses poupées en même temps au lieu d''attendre qu''elles périssent pour en invoquer d''autres. Une maladie courante chez les Sadidas.');
INSERT INTO "item_descriptions" VALUES(5999,'fr','Cette baguette est fabriquée dans des conditions extrêmes, presque identiques à celles du cœur de la terre dit-on. Son énorme puissance viendrait de là. Personne ne peut vraiment vérifier hormis les artisans capables de la fabriquer.');
INSERT INTO "item_descriptions" VALUES(6438,'fr','Cette baguette est constituée d''éléments plutôt mous, ce qui en fait une baguette difficile à manier. Mais au cœur du combat, cette baguette révèle son véritable pouvoir.');
INSERT INTO "item_descriptions" VALUES(6439,'fr','Des mélanges magiques d''éléments surnaturels ont permis la création de cette baguette qui vogue aux frontières du réel. Tantôt terrifiante, tantôt délirante, cette baguette est l''exemple typique de l''instabilité.');
INSERT INTO "item_descriptions" VALUES(6440,'fr','Cette baguette n''est pas qu''un vulgaire amas de poils. Le cœur même de la baguette absorbe l''essence magique des diverses touffes et les fusionne entre elles. Aussi aberrant que cela puisse paraître, ça marche !');
INSERT INTO "item_descriptions" VALUES(6442,'fr','Toujours en quête d''un moyen de surprendre ses ennemis, le Sadida Aga Dou a pris soin d''accrocher une petite poupée au bout de sa lance. Les jeunes Iopettes se jettent dessus pour attraper la poupée et meurent empalées.');
INSERT INTO "item_descriptions" VALUES(6443,'fr','C''est le célèbre et non moins burlesque artisan Yamato, injustement méprisé pour son arc ridicule, qui le premier, eu l''audace de tenter d''enchanter une amulette avec autant d''effets, chose réputée infaisable depuis des lustres.');
INSERT INTO "item_descriptions" VALUES(6444,'fr','De la couleur du célèbre Dofus Turquoise, cette amulette n''a en fait aucun rapport avec ce dernier, ce qui ne l''empêche pas d''être très puissante pour autant. Comme quoi, les apparences ne sont pas toujours trompeuses.');
INSERT INTO "item_descriptions" VALUES(6445,'fr','Cet arc a une forme très étudiée, sa courbure est vraiment parfaite. On raconte à ce sujet que le sculpteur d''arcs s''est servi d''un fessier de boufette comme patron.');
INSERT INTO "item_descriptions" VALUES(6446,'fr','Chiduc était un sculpteur d''arcs, réputé pour avoir des problèmes de prononciation. Il était en effet incapable de prononcé le son "ar" sans rajouter un "keu" derrière. C''était tout de même un grand arctiste.');
INSERT INTO "item_descriptions" VALUES(6449,'fr','De quoi ressembler à une ombre, ou se déguiser en Maître Corbac pour impressionner les filles à la sortie de la Boulangerie avant la tombée de la nuit.');
INSERT INTO "item_descriptions" VALUES(6450,'fr','La célèbre Cordonnière Ha, avait un amant connu pour lui faire faux bond au dernier moment. Mais l''amour l''aveuglant, elle lui offrit tout de même cette magnifique ceinture comme témoin de leur union secrète.');
INSERT INTO "item_descriptions" VALUES(6451,'fr','À propos de cet arc, on est en droit de se demander pourquoi son nom est aussi stupide. Il en est de même pour vous.');
INSERT INTO "item_descriptions" VALUES(6452,'fr','Cet arc à l''apparence complexe est un véritable objet d''art. Le sculpteur d''arc qui l''a créé est également célèbre pour avoir exposé ses modèles les plus controversés dans la fameuse grotte de Loopine, interdite au public non averti depuis des lustres.');
INSERT INTO "item_descriptions" VALUES(6453,'fr','Issu d''un constat frappant (l''arc est très utile pour pêcher les poissons volants), cet arc est muni d''une canne à pêche intégrée qui permet de pêcher d''autres choses que des poissons volants.');
INSERT INTO "item_descriptions" VALUES(6454,'fr','Cette branche d''Abraknyde Sombre est en fait l''un de ses bras. Excellente pour s''entraîner au bras de fer, c''est surtout une excellente arme pour terroriser vos ennemis d''enfance ou torturer les Tronknydes.');
INSERT INTO "item_descriptions" VALUES(6459,'fr','La seule chance de survivre dans une mine infestée de Mineurs Sombres, c''est d''y voir clair. A défaut de leur voler leur bougie, portez cette amulette, elle vous portera chance.');
INSERT INTO "item_descriptions" VALUES(6460,'fr','Cette magnifique broche est un hommage à la célèbre résistance des mineurs de la mine d''argent de Grimoth, qui passèrent un hiver entier, à combattre un Rockailleux de la pire espèce, pour finalement mourir achevés par un vieux Tofu égaré.');
INSERT INTO "item_descriptions" VALUES(6461,'fr','Cette Amulette spécialement conçue pour les vieux Enutrofs, a permis il y a bien longtemps à Setag, de nettoyer la mine de Grimoth, de tous ses rivaux mineurs. Une méthode certes peu raisonnable, mais terriblement efficace.');
INSERT INTO "item_descriptions" VALUES(6462,'fr','Cette petite broche a vraiment du charme, destinée à la base pour les malchanceux fermement décidés à participer aux jeux de la fête foraine, on a vite remarqué, qu''elle était également bien adaptée pour les chasses épiques.');
INSERT INTO "item_descriptions" VALUES(6463,'fr','Cet anneau a été créé par un célèbre forain, dont personne ne se rappelle le nom. Il est mort lors du concours de tir à l''arc, en mettant comme cible sur sa tête, une Graine de Tournesol Sauvage à la place de la traditionnelle Citrouille.');
INSERT INTO "item_descriptions" VALUES(6464,'fr','Cet anneau est une version améliorée du célèbre Anneau de Satisfaction. Idéal pour laisser à vos petites bestioles le soin de faire le combat à votre place, ou tout simplement pour faire le malin en invoquant une armée de Tofus.');
INSERT INTO "item_descriptions" VALUES(6465,'fr','Loopine a jadis demandé comment créer un tel anneau au monstre qui hante sa grotte en échange de quelques services à rendre, qui l''ont changé à jamais. Les gens avertis vous diront qu''il a perdu au change...');
INSERT INTO "item_descriptions" VALUES(6466,'fr','Cette amulette a permis à de nombreuses reprises à Shika Ingalsse, de survivre aux rebellions des troupeaux de Bouftous bien décidés à lui mener la vie dure.');
INSERT INTO "item_descriptions" VALUES(6467,'fr','Personne ne connaît le propriétaire de cet anneau, qui a tenu a garder l''anonymat suite à un combat humiliant face à une Arackne invoquée. Cependant, il faut avouer que cette dernière venait d''être compulsée par un Iop.');
INSERT INTO "item_descriptions" VALUES(6468,'fr','A l''époque où tous les Iops de son âge recevaient pour leur communion, une monture Tabi, ou une Goultard en bois, Vald lui a reçu cet anneau. C''est un peu moins marrant pour jouer avec ses petits camarades, mais c''est plus utile en plein combat.');
INSERT INTO "item_descriptions" VALUES(6469,'fr','Cette alliance a été usée par le frottement des épis d''escourgeon pendant des centaines de moissons. Elle est également le témoin, de l''union entre Farle et Shika, lorsqu''ils se sont mariés au milieu d''un champs d''orge de printemps.');
INSERT INTO "item_descriptions" VALUES(6470,'fr','Ces magnifiques bottes, sont parfaites pour botter le derrière des Bouftous lorsqu''il faut les forcer à changer de pâtures et à traverser le village. Elles fonctionnent également pour forcer les enfants Iops à faire leurs devoirs et à aller à l''école.');
INSERT INTO "item_descriptions" VALUES(6471,'fr','Ces petits souliers ont été renforcés, remis en état, mais surtout désodorisés. Ils sont surtout utilisés pour attirer les Champ-Champ, tant le substrat laissé par le Porkass leur semble appétissant.');
INSERT INTO "item_descriptions" VALUES(6472,'fr','Cette coquille de Dragoeuf Argile rembourrée, vous rend presque insensible aux coups de foudre magiques du Bwork Mage. En revanche, il ne vous protège en rien contre les vrais coups de foudre...');
INSERT INTO "item_descriptions" VALUES(6473,'fr','Cette coquille de Dragoeuf Ardoise vous ira à merveille si vous savez la porter. Arborer une telle coiffe n''est pas à la portée de tout le monde, la preuve, les Iops ont tendance à la porter à l''envers.');
INSERT INTO "item_descriptions" VALUES(6474,'fr','Cette coquille de Dragoeuf Charbon est idéale pour rester discret la nuit, ou se protéger des chutes de pierres, courantes en montagne, ou lorsque l''on défie un Craqueleur au lancer de rochers.');
INSERT INTO "item_descriptions" VALUES(6477,'fr','Ce somptueux chapeau vous permet d''y voir plus clair même lorsqu''il fait déjà assez clair. Il est également très utile pour éblouir les bêtes qui hantent les mines mal famées, ou tout simplement, pour faire croire aux Iops que vous êtes une lumière.');
INSERT INTO "item_descriptions" VALUES(6481,'fr','Ce splendide chapeau a été imaginé sur l''île de Dora Bora un peu au sud de l''île de Moon. Parfaitement adapté au combat, il est également très apprécié comme corbeille à fruits, pour entreposer les noix de grokoko traumatisées par exemple.');
INSERT INTO "item_descriptions" VALUES(6482,'fr','Version retravaillée du Jouik Krampe, ce chapeau utilise les meilleures ressources de l''île de Moon, ce qui lui donne un cachet très terroir reconnaissons-le. A défaut de ressembler à un Kanniboul, vous pourrez sortir de très bons coups de boule.');
INSERT INTO "item_descriptions" VALUES(6483,'fr','Ce surprenant casque transforme son propriétaire en Bwork de Bronze selon la légende. A essayer d''urgence sur les gros lourds, vous pourrez les refondre ensuite et en tirer un bon prix.');
INSERT INTO "item_descriptions" VALUES(6484,'fr','Quand les dagues ne suffisent plus, que les dieux se moquent de vous, à vous de rechercher votre propre style de combat. Certains Srams l''ont bien compris, d''autres espèrent que les dieux leur viennent en aide.');
INSERT INTO "item_descriptions" VALUES(6485,'fr','Le Chafer Archer, n''aura jamais été assez astucieux et habile à cause de ses os tremblants, pour manier un tel arc. Excepté pour le problème des os tremblants, il est probable que vous soyez dans le même cas que ce ridicule Chafer.');
INSERT INTO "item_descriptions" VALUES(6491,'fr','Cet arc est issu du croisement raté d''un Tronknyde et d''un Abraknyde. Pour un Bûcheron, il s''agit de toute évidence d''un échec mais pour un Sculpteur d''Arcs, c''est une vraie réussite. Vos parents auraient aimé pouvoir en dire autant de vous.');
INSERT INTO "item_descriptions" VALUES(6492,'fr','L''écart entre les deux pointes de ce taille-haie correspond à celui des yeux des Lenalds... Mais jusqu''où iront ces howwibles Wabbits ?');
INSERT INTO "item_descriptions" VALUES(6493,'fr','Adoptez la « Cawotte attitude » avec ces tongues wabbits issues de la dernière collection. Elles sont recommandées par tous les experts en claquettes, en danses rituelles, et en Tango rapide du Captain Chafer.');
INSERT INTO "item_descriptions" VALUES(6494,'fr','Utilisée par les plus célèbres Eniripsas d''Amakna, cette baguette constitue l''arme idéale pour envoyer un sortilège sur ses adversaires ou tenter de rendre plus intelligents ses propres amis. Ainsi, vous pouvez transformer un Iop en citrouille.');
INSERT INTO "item_descriptions" VALUES(6495,'fr','Fabriquée à partir de restes du Chêne Mou ayant repris vie, cette baguette est tout simplement surpuissante. Il suffit de l''agiter à droite puis à gauche avec le bon rythme, pour déclencher des pluies de crapauds ou passer pour un idiot notoire.');
INSERT INTO "item_descriptions" VALUES(6496,'fr','Cette baguette a parfois tendance à reprendre vie et se révolter contre son maître. Dans ce cas-là, la meilleure chose à faire reste de la donner à votre ennemi, ou à un Iop qui pensera que vous lui faîtes un cadeau.');
INSERT INTO "item_descriptions" VALUES(6497,'fr','La femme de Brouce Boulgoure, une Eniripsa, ne cessait de lui voler sa célèbre hache. Pour mettre un terme à ces bêtises, il lui coupa une aile et un bras et pour s''excuser, il lui offrît cette Baguette. Voilà un homme qui savait y faire avec les femmes.');
INSERT INTO "item_descriptions" VALUES(6498,'fr','De taille plus que respectable, ce magnifique slip comporte encore les traces du passage de son ancien propriétaire et quelques poils bien étranges. Sur les fesses ou sur la tête, ce slip fera de vous une personnalité respectée de tout Amakna.');
INSERT INTO "item_descriptions" VALUES(6499,'fr','Les dents de cette amulette ont rongé plus de Cawottes que Brouce Boulgoure n''a déraciné d''arbres, ne vous étonnez donc pas si vous sentez la Cawotte, et si les Tiwabbits cherchent à vous faire des bisous dans le cou.');
INSERT INTO "item_descriptions" VALUES(6500,'fr','Ces oreilles ne vous permettront pas de mieux entendre, mais permettront à vos amis de mieux vous retrouver dans la foule, et à vos ennemis, de mourir de rire. Une paire d''oreilles qui s''avère avec le temps vraiment indispensable.');
INSERT INTO "item_descriptions" VALUES(6501,'fr','Avec ce sac sur les épaules, vous pouvez partir à l''aventure sans vous soucier des problèmes alimentaires. En effet, même si la Cawotte est vide comme un crâne de Iop, les feuilles du dessus repoussent toutes seules, de quoi se faire de bonnes tisanes.');
INSERT INTO "item_descriptions" VALUES(6503,'fr','La Polpoulette est le résultat d''un croisement entre un Kwak de Feu agressif et un Tofu maladif. Depuis la nuit des temps, la chasse à la Polpoulette est considérée comme un rituel immuable, chasser cette horrible créature est un vrai plaisir.');
INSERT INTO "item_descriptions" VALUES(6504,'fr','On ne connaît que le diminutif de son créateur, un certain Fantal, mais on sait qu''il avait très mauvais goût. En effet, il appréciait s''enduire de Gelée Royale pour ensuite se recouvrir de plumes de Tofu Royal. Et oui en plus, il avait des goûts de luxe.');
INSERT INTO "item_descriptions" VALUES(6505,'fr','Pour lutter contre les bêtes à cornes, ce marteau est idéal. En revanche, pour planter des clous, ou des choux, même à la mode de chez nous, c''est une autre histoire.');
INSERT INTO "item_descriptions" VALUES(6506,'fr','Chez les Enutrofs, on dit qu''un mineur est gogorifié lorsqu''il ne supporte plus la lumière du jour, à force de travailler dans sa mine. Ne tentez jamais d''approcher une bougie d''un tel mineur, il vous transformerait en bronze.');
INSERT INTO "item_descriptions" VALUES(6507,'fr','La Terps était une très vilaine créature aussi dangereuse et mal aimée que sa grande rivale, la vieille Liche. Déterminée à la surpasser, elle forgea ce marteau pour lui écraser les orteils, mais elle lui cassa surtout les pieds. Une grande histoire d''amour naquit.');
INSERT INTO "item_descriptions" VALUES(6508,'fr','Un marteau exceptionnel, destiné à soigner son petit prespic adoré, ou ses ennemis si vous êtes un disciple du Chaferfu.');
INSERT INTO "item_descriptions" VALUES(6509,'fr','Ce somptueux marteau a fait tourner la tête de plus d''un Osamodas. En effet, il est si puissant, que tout le monde se retourne quand on croise son propriétaire. Ce marteau est depuis ce temps-là, à l''origine d''une bien étrange pathologie.');
INSERT INTO "item_descriptions" VALUES(6510,'fr','Kahr était vraiment à la masse lorsqu''il s''agissait de combattre avec un marteau. Heureusement pour lui, il reçut en héritage cette véritable merveille, qui fit de lui une personne respectée et jalousée. Le succès ne tient parfois à rien.');
INSERT INTO "item_descriptions" VALUES(6511,'fr','C''est le marteau parfait des moments chauds, vous aurez un succès énorme parmi votre entourage si vous savez vous y prendre correctement. De toute évidence, à ne pas mettre entre toutes les mains...');
INSERT INTO "item_descriptions" VALUES(6512,'fr','C''est l''arme rêvée des Xélors un tantinet rebelles et en manque de sensations fortes. Ca leur permet surtout de compenser une vieille histoire de complexe à propos de leur taille franchement ridicule.');
INSERT INTO "item_descriptions" VALUES(6513,'fr','Ce marteau tire sa puissance d''un subtil enchantement. Ça ne se voit pas au premier coup d''œil, ni au second. C''est pour cela que l''on prend la peine de le préciser, histoire d''augmenter la valeur de cet objet aux yeux des acheteurs un peu naïfs.');
INSERT INTO "item_descriptions" VALUES(6516,'fr','Aucun Sram ne peut résister à l''envie d''agresser un ami avec ces sublimes dagues. Leur principal intérêt est donc de faire baisser de manière considérable l''insécurité en Amakna, en supprimant un à un les derniers Srams restants.');
INSERT INTO "item_descriptions" VALUES(6517,'fr','Ces dagues feraient craquer n''importe quelle petite Sramette en quête d''expériences nouvelles. En effet, ses pouvoirs étranges lui permettent d''accomplir les pires fourberies, aux amis comme aux ennemis. Le Captain Chafer aurait adoré.');
INSERT INTO "item_descriptions" VALUES(6518,'fr','Conçue par un célèbre Sculpteur, cette baguette a gagné 13 fois le grand concours de la Baguette N''hi, en réussissant à surpasser les anciens modèles de Boulgourdes aujourd''hui retirés du marché car trop dangereux pour les petites Eniripsas.');
INSERT INTO "item_descriptions" VALUES(6519,'fr','C''est un sculpteur réputé, connu également pour la ressemblance de son nom avec un des alliages les plus précieux d''Amakna, qui eut le premier, l''idée d''introduire des métaux dans ses créations. La folie mène parfois au succès.');
INSERT INTO "item_descriptions" VALUES(6520,'fr','Le sculpteur de cette baguette, a maintes fois demandé à changer de nom. Trop habitués à passer leurs journées à la Taverne, les responsables du registre d''Amakna, ont fini par avoir mal à la tête avec toutes ces histoires. Cette baguette leur est dédiée.');
INSERT INTO "item_descriptions" VALUES(6521,'fr','On raconte que ce bâton permet de faire rougir une femelle Abraknyde, ou de chatouiller les parties intimes du Chêne Mou pour mieux le séduire. Dans tous les cas, on vous déconseille d''essayer, le Chêne Mou est vraiment très possessif...');
INSERT INTO "item_descriptions" VALUES(6522,'fr','La légende raconte que cette racine est herbivore : elle aurait tendance à se faufiler très vite sous les feuilles mortes et avaler les jeunes pousses. Très impressionnant. Bon, à part si vous combattez des Pissenlits, ça ne sert à rien.');
INSERT INTO "item_descriptions" VALUES(6523,'fr','Création élégante et raffinée, cette racine sculptée fera de vous un invocateur confirmé. Pas de quoi frimer en soirée, mais pour rendre folles de vous les Sadidettes d''Amakna, il n''y a pas mieux.');
INSERT INTO "item_descriptions" VALUES(6524,'fr','Un Sadida, éperdument amoureux d''une Sadidette Sauvage a tenté de l''attirer sous un charme avec cette racine, il a attendu une centaine d''années. Elle lui a posé une sorte de Wabbit. Depuis ce jour, les Sadidas parlent de poser une Racine.');
INSERT INTO "item_descriptions" VALUES(6525,'fr','Les habitants d''Amakna en avaient assez d''entendre les disciples Fécas se plaindre à longueur de journée de leurs armures. Ils ont donc conçu ce bâton pour espérer les voir parler d''autre chose à la taverne.');
INSERT INTO "item_descriptions" VALUES(6526,'fr','Le forgeur de cette pelle a voulu rester anonyme pour faire le modeste, mais il a pris soin de laisser un indice dans le nom de cette pelle. Certains artisans sont vraiment irrécupérables...');
INSERT INTO "item_descriptions" VALUES(6527,'fr','"Pelle pelle pelle comme euh le jour, pelle pelle pelle comme euh l''amour" fredonnait Noh Yèle l''illustre forgeur d''épées. Il chantait si faux, que sa femme en est restée marquée à vie lorsqu''elle lui fabriqua cette pelle.');
INSERT INTO "item_descriptions" VALUES(6528,'fr','Cette pelle a traversé les continents, elle a vu le soleil se coucher sur la crête du Mont Crakelour, le soleil se lever là où la Mer d''Asse et l''horizon ne font plus qu''un. Et dire que vous vous n''êtes jamais allé plus loin que l''île de Moon, pitoyable.');
INSERT INTO "item_descriptions" VALUES(6535,'fr','Cette étrange pelle multi-usages, servait à tuer les poux des jeunes Iops, à leur enlever les pellicules, et à leur faire rentrer dans le crâne les bases de l''arithmétique.');
INSERT INTO "item_descriptions" VALUES(6536,'fr','Le Mineur Sombre se sert de cette pelle de la taille d''une main de Craqueleur pour écraser plusieurs Eniripsas d''un seul coup. On vous encourage à faire de même, histoire de ne pas mourir idiot.');
INSERT INTO "item_descriptions" VALUES(6537,'fr','Cette pelle est vraiment antipathique. Personne ne sait réellement pourquoi, mais les Pelles Mairhes sont toujours insupportables. Heureusement, qu''elles ont tout de même des bons côtés, même si on les cherche encore à l''heure actuelle.');
INSERT INTO "item_descriptions" VALUES(6538,'fr','Cette pelle permet aux Enutrofs de voir plus loin. Elle est faite pour qu''ils puissent la planter et monter dessus pour scruter l''horizon et se donner des airs intéressants. Idéal pour retrouver son hospice lorsque l''on est perdu entre deux fougères.');
INSERT INTO "item_descriptions" VALUES(6539,'fr','Cette pelle est vraiment différente des autres. Si vous l''utilisez pour combattre, on risque de beaucoup rire et de faire des blagues sur vous. En effet, les blagues sur la Pelle Gicque sont très populaires du côté de la Taverne.');
INSERT INTO "item_descriptions" VALUES(6540,'fr','On raconte que celui qui a forgé cette pelle ressemblait à une véritable bête. Une sorte de croisement entre un Sadida et un Mulou. Sa pelle serait tombée amoureuse de lui. Vraiment une histoire débile.');
INSERT INTO "item_descriptions" VALUES(6604,'fr','Au delà du Tofu, du Bouftou ou encore du Iop, le Kouin-kouin excelle dans la crétinerie.');
INSERT INTO "item_descriptions" VALUES(6654,'fr','Comble de l''ironie, le gardien des égouts s''est fait dévorer par la Gardienne des Égouts. Il a été digéré pendant plus de cent ans avant de finir par mourir. Heureusement, ses bottes étaient plus résistantes que lui et sont encore en excellent état.');
INSERT INTO "item_descriptions" VALUES(6660,'fr','Avec un tel chapeau qui saurait vous dire non ?
À vous la gloire et les conquêtes !');
INSERT INTO "item_descriptions" VALUES(6661,'fr','Cette canne vous permet de pêcher un koinkoin dans le stand de la foire du Trool.');
INSERT INTO "item_descriptions" VALUES(6662,'fr','Faites-le fondre comme une gelée menthe au soleil avec cette merveilleuse coiffe en soie de larve du sud, lavable à l''eau douce.');
INSERT INTO "item_descriptions" VALUES(6712,'fr','Cette magnifique cape sent la fleur des bois. Pas de quoi rendre folle de vous une Craêtte, mais suffisant pour couvrir les odeurs d''un Sadida qui se néglige.');
INSERT INTO "item_descriptions" VALUES(6713,'fr','Imprégnées du sang du terrible Lordsoth, ces dagues lui ont permis de terrasser le roi des Chafers lors du célèbre concours de lancer de dagues de la foire du Trool. Le roi des Chafers n''a plus jamais osé depuis ce jour, montrer le bout de son slip en cuir, et s''est exilé avec l''illustre Captain Chafer dans les environs du cimetière de Pandala.');
INSERT INTO "item_descriptions" VALUES(6716,'fr','Ce petit singe chapardeur semble s''être attaché à vous maintenant.');
INSERT INTO "item_descriptions" VALUES(6717,'fr','Avec ce petit toutou, vous goûterez aux joies des petites promenades pipi. Fort de ses racines sauvages, il est déconseillé de lui donner à manger, sous peine de perdre une main.');
INSERT INTO "item_descriptions" VALUES(6718,'fr','Cette petite boule de poil friponne et câline fait craquer la gent féminine toutes classes confondues. Un animal redoutable donc.');
INSERT INTO "item_descriptions" VALUES(6719,'fr','Cette étrange coiffe a appartenu au tristement célèbre Homme Ours. Cousue à partir des restes de la tête d''un ours en décomposition, cette coiffe vous permettra de ne pas passer inaperçu, et surtout, de laisser grâce à son odeur originale, une trace de votre passage.');
INSERT INTO "item_descriptions" VALUES(6720,'fr','Cette jolie cape a été portée pendant des années par le célèbre Homme Ours. Elle ne fera pas de vous un ours, mais vous pourrez rivaliser avec les plus grands.');
INSERT INTO "item_descriptions" VALUES(6721,'fr','Ces bottes sont rembourrées avec de la fourrure d''ours. De quoi garder les pieds au chaud même pour ceux qui ont le sang froid.');
INSERT INTO "item_descriptions" VALUES(6722,'fr','L''Homme Ours n''a jamais quitté cette alliance, bien que sa femme fût dévorée sous ses yeux, par un des ours qu''il venait d''invoquer, et cela pour impressionner sa dulcinée. Elle a effectivement été très impressionnée.');
INSERT INTO "item_descriptions" VALUES(6723,'fr','L''Homme Ours portait cette amulette autour du cou, lorsqu''il a affronté les brigandins de la tanière de Bimdhoul. La légende raconte qu''elle lui a sauvé la vie, mais quand on la regarde de près, on s''aperçoit qu''il s''agit bien d''une légende.');
INSERT INTO "item_descriptions" VALUES(6724,'fr','Cette petite ceinture recouverte de poils d''ours est idéale pour cacher vos poignées d''amour. Il est donc conseillé de ne jamais l''enlever, pour ne pas décevoir l''élu de votre cœur.');
INSERT INTO "item_descriptions" VALUES(6725,'fr','L''Homme Ours utilisait ce bâton pour dresser ses invocations d''ours, et parfois pour frapper les doigts de ses enfants, lorsque ces derniers ne faisaient pas leurs devoirs en revenant de l''école. Voilà un homme qui avait tout compris à l''éducation des enfants.');
INSERT INTO "item_descriptions" VALUES(6731,'fr','Avec cette amulette autour du cou, vous pourriez tenter de faire croire à votre entourage que vous avez une haleine fraîche. Laissez tomber, c''est peine perdue.');
INSERT INTO "item_descriptions" VALUES(6732,'fr','Ce petit anneau était jadis très convoité par les Enutrofettes qui préféraient s''en servir pour décorer leurs orteils. Une excellente façon de cacher leurs verrues.');
INSERT INTO "item_descriptions" VALUES(6742,'fr','Cette amulette est constituée d''un mélange de feuilles de Fourbasse et de détritus de l''île de Moon. Elle ressemble plus à un collier de fleurs qu''à une véritable amulette, mais elle vous permettra de séduire sans trop d''efforts la faune locale de l''île de Moon, composée presque exclusivement d''abominables créatures. Ainsi, plus aucune Fourbasse ne saura vous résister, elles vous sauteront toutes au cou pour vous faire des suçons. Les plus malchanceux en amour sauront s''en contenter.');
INSERT INTO "item_descriptions" VALUES(6743,'fr','Prenez des feuilles de Fourbasse, empilez-les, laissez-les macérer dans de l''alcool éventé, perforez-les, buvez le reste d''alcool, collez les feuilles autour d''un morceau d''écorce, fixez des morceaux de feuille de Tikoko avec une matière gluante, et voilà, vous avez une magnifique Fourballiance. Elle sent très mauvais, et vous sera particulièrement utile pour justifier et cacher l''odeur de vos doigts surtout si vous avez tendance à les mettre n''importe où. Surtout là où il ne faut pas.');
INSERT INTO "item_descriptions" VALUES(6744,'fr','Une fois que vous aurez essayé ces bottes, vous ne serez plus capable de vous en défaire. Non pas parce qu''elles sont exceptionnelles, mais car elles sont incroyablement collantes. Une caractéristique trop souvent partagée avec les femelles Fourbasses.');
INSERT INTO "item_descriptions" VALUES(6745,'fr','Remarquable création artisanale à base de restes de Fourbasses et de détritus ramassés le long des plages de Moon, au milieu de l''écume nauséabonde, cette ceinture si elle est portée toute seule, vous donnera une allure vraiment surprenante. De quoi décontenancer vos adversaires ou surprendre l''être aimé, pour mieux tirer partie de cet instant où pour une fois c''est vous qui aurez le dessus.');
INSERT INTO "item_descriptions" VALUES(6746,'fr','Jadis portée par Oto Mustam, chef des guerriers de Brâkmar, cette petite amulette ne lui servait qu''à se faire beau lors des orgies organisées à Brâkmar. Tout un programme.');
INSERT INTO "item_descriptions" VALUES(6747,'fr','Lorsque le vent souffle dans ses plumes, le Kwak du Vent se sent libre comme l''air, et se laisse planer tel une vieille feuille morte emportée par une bourrasque. Contrairement aux idées reçues, c''est assez impressionnant.');
INSERT INTO "item_descriptions" VALUES(6748,'fr','Judicieusement porté, cet anneau vous permettra d''embellir vos doigts boudinés. Malheureusement pour certains, il n''est efficace que sur les doigts.');
INSERT INTO "item_descriptions" VALUES(6749,'fr','Cet anneau est si léger, qu''il pourrait s''envoler au premier coup de vent. Mais ne rêvez pas, si cela se produit, vous ne vous envolerez pas avec lui. On se moquera de vous dans le meilleur des cas.');
INSERT INTO "item_descriptions" VALUES(6750,'fr','Lame froide et tranchante, elle réveillera les instincts les plus primitifs de ceux qui l''utilisent.');
INSERT INTO "item_descriptions" VALUES(6751,'fr','"Cette lame aiguisée mais pas déguisée, conviendra parfaitement aux aventuriers déjà expérimentés en quête de nouvelles sensations". Voici ce que l''on peut lire sur le manuel de cette épée. Les manuels ne sont plus ce qu''ils étaient décidément.');
INSERT INTO "item_descriptions" VALUES(6752,'fr','Idéale pour couper les nuages, cette lame pourra également vous servir à faire du vent si vous l''agitez comme un éventail. Une excellente technique pour décimer les Moskitos ou défigurer vos amis.');
INSERT INTO "item_descriptions" VALUES(6753,'fr','Idéales comme patins à glace sur les lacs gelés, ces bottes sont également très utiles pour garder les pieds au frais, ou pour y stocker votre goûter durant les journées de forte chaleur. Il est cependant déconseillé de les faire sécher au coin du feu, sous peine de ne plus jamais les revoir.');
INSERT INTO "item_descriptions" VALUES(6754,'fr','"Rien de mieux que les Kwakobottes de Terre pour marcher dans la terre", telles étaient les paroles de Rola Ingalsse la célèbre laboureuse, juste avant de devenir aveugle, en recevant une motte de terre géante dans les yeux.');
INSERT INTO "item_descriptions" VALUES(6755,'fr','Rudimentaires mais efficaces, ces bottes d''une légéreté surprenante sont parfois utilisées après avoir été retravaillées, comme manche à air pour indiquer la direction et la force du vent. Il est alors conseillé de se placer du bon côté de la manche à air, pour ne pas mourir asphyxié.');
INSERT INTO "item_descriptions" VALUES(6756,'fr','Idéale pour se camoufler en motte de terre géante, cette cape vous permettra d''attaquer par surprise les laboureurs et leur voler leurs richesses. Elle est donc avant tout réservée aux collectionneurs de silex.');
INSERT INTO "item_descriptions" VALUES(6757,'fr','Légère et raffinée, cette création peut accessoirement servir de rideau pour les plus dépourvus. Elle était jadis très convoitée par la Momie Nova en personne, qui désirait être correctement habillée pour sortir le soir. Un exemple à suivre pour certains.');
INSERT INTO "item_descriptions" VALUES(6758,'fr','Le Kwak de Terre n''est pas très social et surtout très chassé pour ses plumes, c''est bien connu. En portant cette ceinture autour des hanches, vous vous exposez donc à de multiples fourberies de la part des chasseurs de Kwaks de Terre, qui vous prendront de loin pour un vieux Kwak grabataire sur le déclin. Les apparences ne sont finalement pas toujours trompeuses.');
INSERT INTO "item_descriptions" VALUES(6759,'fr','"La seule façon d''attraper un vieux mâle Kwak du Vent contrarié, c''est de se déguiser en femelle Kwak du Vent contrariée. Dès lors, le mâle tentera de comprendre pourquoi la femelle est contrariée et tentera avec tous les moyens dont il dispose, de satisfaire la femelle. Une fois le mâle satisfait de sa prestation, il faut profiter de sa béatitude pour le plumer." Voici ce que l''on peut lire dans la section douze du tome trois sur la chasse aux Kwaks du Vent. Il y est en outre clairement indiqué, que cette ceinture est un élément indispensable pour se faire passer pour une femelle Kwak du Vent. Vous savez ce qu''il vous reste à faire.');
INSERT INTO "item_descriptions" VALUES(6760,'fr','Cette Kwakoiffe de Terre est tellement lourde qu''elle vous permettra de garder en permanence les pieds sur terre, mais vous fera également parfois tomber par terre. On ne peut pas tout avoir.');
INSERT INTO "item_descriptions" VALUES(6761,'fr','Pour garder les cheveux au vent même une fois équipé d''une coiffe, rien ne vaut cette sympathique Kwakoiffe du Vent, qui vous permettra sans aucun doute de laisser libre court à votre expression capillaire dans la plupart des circonstances. C''est suffisant pour réussir à interloquer le plus blasé des Chafers.');
INSERT INTO "item_descriptions" VALUES(6762,'fr','« Pour la baston, rien ne vaut une Fourbasse-Ton. » Voici ce que l''on pouvait lire sur le dépliant publicitaire de l''Agence Touriste, qui proposait de fabriquer une lance à partir de diverses ressources cachées un peu partout sur l''île de Moon. Une sorte de jeu de piste, mais sans aucune piste.');
INSERT INTO "item_descriptions" VALUES(6763,'fr','On raconte que les Fourbasses mortes sont très confortables une fois qu''elles ont pris le temps de se décomposer. Avec le temps elles deviennent beaucoup plus souples et douces. Beaucoup d''aventuriers aimeraient pouvoir en dire autant de leur dulcinée.');
INSERT INTO "item_descriptions" VALUES(6764,'fr','Avec cette coiffe sur la tête, vous n''avez vraiment pas l''air très futé. Mais plus que sans la coiffe, donc autant la garder.');
INSERT INTO "item_descriptions" VALUES(6766,'fr','Cette amulette d''apparence rudimentaire a été confectionnée à partir de trois épis de Blé magiques, recouverts de poussière de pierre précieuse, et fauchés dans les plaines de Snossios pendant la treizième moisson d''Istrabraq. Elle confère un courage hors du commun à son porteur, désormais à même de faucher plaines et vallées sans jamais faillir.');
INSERT INTO "item_descriptions" VALUES(6767,'fr','Ce bracelet en pierres précieuses a été recouvert d''une toile de Chanvre par Shika, pour éviter d''attirer l''attention des Corbacs, lorsque Farle semait son orge.');
INSERT INTO "item_descriptions" VALUES(6769,'fr','Cet outil est muni de très belles dents à son extrémité, ce qui en fait une excellente fourche. On raconte que c''est Brouce Boulgoure en personne qui aurait coupé le bois nécessaire à sa fabrication, en échange des rations quotidiennes de flocons d''avoine qu''il dévorait comme un ogre avant de partir raser des forêts entières.');
INSERT INTO "item_descriptions" VALUES(6773,'fr','Cette amulette est construite de façon Tude, d''où son nom. C''est l''une des premières méthodes de création, car l''une des plus simples, que l''on enseigne aux apprentis bijoutiers. Certes le produit n''est pas puissant mais il ne faut pas en demander trop non plus.');
INSERT INTO "item_descriptions" VALUES(6774,'fr','Ces sabots ont été taillés dans des bois rares, renforcés avec des pièces de cuirs d''une valeur inestimable, et rembourrés avec des céréales magiques. À la fois légère, élégante, et confortable, cette paire de sabots saura résister aux affres du temps. Beaucoup d''aventuriers un peu trop misogynes aimeraient pouvoir en dire autant de leur dulcinée.');
INSERT INTO "item_descriptions" VALUES(6775,'fr','Cette cape en tissu et en peaux permettait à Farle Ingalsse d''ensemencer des champs entiers pendant une saison complète sans jamais devoir s''arrêter. En effet, une fois repliée et utilisée comme une besace, sa capacité semble presque illimitée. Personne ne connaît réellement le tailleur à l''origine de cette merveille, la légende raconte seulement, qu''il s''est retiré de la profession lorsque ses clients ont commencé à confondre ses capes avec des serpillères. Quel triste départ en retraite !');
INSERT INTO "item_descriptions" VALUES(6776,'fr','Cette ceinture servait également de tablier de boucher à Farle Ingalsse lorsqu''il devait égorger ses troupeaux de Bouftous. Une tâche ingrate et cruelle, dont il s''affranchissait pourtant avec un plaisir non dissimulé.');
INSERT INTO "item_descriptions" VALUES(6778,'fr','Ce chapeau de paille a été confectionné à l''aide d''une multitude d''épis magiques tressés entre eux, puis l''intérieur a été rembourré avec divers poils et étoffes cousues à la main par Shika Ingalsse, femme de Farle. Plus classe que le Ploukosse, et plus stylé que le Kraignosse, ce chapeau vous protègera du cagnard comme il l''a fait pour Farle pendant des centaines de moissons, tout en vous donnant une allure guillerette et vraiment "cool". Suffisant pour s''improviser roi ou reine des champs.');
INSERT INTO "item_descriptions" VALUES(6780,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(6781,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(6782,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(6783,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(6784,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(6785,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(6786,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(6789,'fr','Cette petite amulette fleurit au printemps, mais se dessèche en été, se fane en automne, et pourrit en hiver.
L''occasion rêvée pour changer de look au fil des saisons.');
INSERT INTO "item_descriptions" VALUES(6791,'fr','Avec ce petit anneau autour du doigt, vous pourrez presque essayer de passer inaperçu au milieu des champs.');
INSERT INTO "item_descriptions" VALUES(6792,'fr','Ce bâton en forme de fleur a été confectionné à partir des restes de fleurs champêtres ayant succombé durant d''horribles et cruels combats. Toute la rage et la haine de ces pauvres plantes est contenue dans ce ridicule petit bâton. Cette arme est utilisée par les Srams les plus fourbes, qui tentent de persuader les ignorantes qu''ils comptent leur offrir un bouquet de fleurs. Une fois à portée, l''imprudente se retrouve souvent assénée de coups sur la tête bien mérités.');
INSERT INTO "item_descriptions" VALUES(6793,'fr','Cet anneau a fait ses preuves, une petite marque à l''intérieur le prouve. Il s''agit d''une confection unique faite par un apprenti bijoutier à l''occasion d''un test important. Il est fabriqué à partir d''un anneau de fer classique plongé dans une solution de Thé magique.');
INSERT INTO "item_descriptions" VALUES(6794,'fr','Rien de mieux que d''utiliser des bottes confectionnées à partir de restes de fleurs champêtres, pour écraser ces misérables fleurs qui poussent dans vos champs. De plus, ces bottes permettront à vos pieds de dégager une délicieuse odeur de fleur. Dommage qu''il n''existe pas un équivalent à ces bottes pour les caleçons.');
INSERT INTO "item_descriptions" VALUES(6795,'fr','Si vous voulez être la plus belle ce soir pour aller danser, c''est la cape qu''il vous faut.');
INSERT INTO "item_descriptions" VALUES(6796,'fr','Avec cette ceinture décorée de petits pétales autour de la taille, vous pourrez sans problème vous faire passer pour une danseuse étoile au milieu d''un combat perdu d''avance. De quoi décontenancer une armée de Chafers, pour retourner la situation à votre avantage.');
INSERT INTO "item_descriptions" VALUES(6797,'fr','Si vous avez toujours rêvé d''être fleuriste et d''avoir une haleine parfumée à l''eau de rose, c''est le moment d''adopter cette étrange coiffe.');
INSERT INTO "item_descriptions" VALUES(6799,'fr','Tranchante comme une lame de Bwork, cette lame du Chef Bwork a l''avantage de peser beaucoup plus lourd. Elle est certes moins maniable, mais il suffit de la laisser tomber sur son adversaire pour le trancher en deux, telle une vulgaire tranche de Tronknyde. Si votre ennemi ne meurt pas de douleur, il mourra de honte, et vous de rire.');
INSERT INTO "item_descriptions" VALUES(6800,'fr','Cette cape est faîte de laine de Boufton. Elle ne vous sera guère utile si ce n''est pour avoir l''air classe... Et encore...');
INSERT INTO "item_descriptions" VALUES(6804,'fr','D''apparence rudimentaire, cette amulette en forme de silex taillé est pourtant dotée d''une magie très puissante capable de transformer un Bwork en princesse, ou l''inverse, personne ne sait.');
INSERT INTO "item_descriptions" VALUES(6805,'fr','Muni de ce petit anneau, vous pourrez faire croire à votre entourage que vous avez épousé un grand Chef Bwork et qu''il vous a offert ce bracelet comme cadeau de mariage. De quoi vous rendre intéressant lors des soirées animées à la Taverne si vous n''avez pas beaucoup de conversation.');
INSERT INTO "item_descriptions" VALUES(6807,'fr','De loin, ces bottes ressemblent à de classiques bottes de Bwork. De près aussi. Et pourtant, ce sont des bottes de Chef Bwork. Plus résistantes, plus puissantes, et plus malodorantes, elles sauront faire la différence dans un combat perdu d''avance.');
INSERT INTO "item_descriptions" VALUES(6811,'fr','Cette cape déchirée et pleine de trous vous fera passer pour un très grand guerrier Bwork. Elle est parfaite si vous voulez terroriser les vieux du village. En revanche, pour séduire l''âme sœur, cela risque d''être un peu plus difficile, à moins de la porter entièrement nu, ce qui vous permettra en plus, de continuer à faire peur aux vieux du village.');
INSERT INTO "item_descriptions" VALUES(6812,'fr','Ce slip en cuir violet se suffit à lui-même, vous pouvez vous contenter de ne porter que ça, vous aurez tout de même fière allure, à condition qu''il soit à votre taille et qu''il ne vous tombe pas sur les genoux lors d''une partie de corde à sauter un peu trop mouvementée.');
INSERT INTO "item_descriptions" VALUES(6813,'fr','Si vous voulez réellement avoir une tête de gros débile, ce casque est fait pour vous. Avec un peu de chance, on ne verra même pas la différence lorsque vous l''enlèverez.');
INSERT INTO "item_descriptions" VALUES(6817,'fr','Cette surprenante amulette a en fait été confectionnée à partir d''un Bouclier Reptilien dont on a détaché les multiples pierres précieuses. C''est donc un bijou particulièrement lourd à porter mais vraiment très résistant. Votre cou sera parfaitement protégé des vampires, mais aussi des suçons des villageoises un peu trop entreprenantes.');
INSERT INTO "item_descriptions" VALUES(6819,'fr','Ce bracelet ressemble étrangement à un gant et pourtant ce n''est pas un gant mais bien un bracelet. Les apparences sont parfois trompeuses.');
INSERT INTO "item_descriptions" VALUES(6821,'fr','Fabriquée à partir de débris trouvés sur un Chef Crocodaille, cette arme saura se révéler très efficace si vous êtes assez beau, habile, intelligent et fort pour la manier. Avec un peu de chance, vous finirez par trouver quelqu''un qui acceptera de vous l''échanger contre une épée de boisaille.');
INSERT INTO "item_descriptions" VALUES(6825,'fr','Ces magnifiques pantoufles en peau et en écailles de Chef Crocodaille sont munies de dents acérées à leurs extrémités. Méfiez-vous lorsque vous ferez du pied à votre dulcinée, vous pourriez lui déchirer ses petits bas en laine de Tabi.');
INSERT INTO "item_descriptions" VALUES(6830,'fr','À Amakna aussi, la rentrée scolaire est une épreuve douloureuse pour les jeunes enfants. Surtout pour les jeunes Iops, pour qui la rentrée des classes est synonyme de véritable calvaire, parsemé d''épreuves insurmontables. Réconfortez-les avec ce magnifique sac d''écolier en peau et en écailles de Chef Crocodaille, et rembourré d''une multitude de poils.');
INSERT INTO "item_descriptions" VALUES(6831,'fr','Trop rigide pour servir de fouet, cette ceinture recouverte de minuscules pierres précieuses peut néanmoins être utilisée de manière plus conventionnelle, pour éviter que vos guêtres ne tombent sur vos genoux par exemple.');
INSERT INTO "item_descriptions" VALUES(6834,'fr','Si vous avez toujours rêvé de ressembler à un Crocodaille sans pour autant vous transformer en Crocodaille, cette coiffe est faîte pour vous. N''espérez pas pour autant utiliser cette coiffe pour faire croire à vos amis que vous avez un jour réussi à tuer vous-même un Crocodaille. Personne n''y croira, à part vous peut-être.');
INSERT INTO "item_descriptions" VALUES(6839,'fr','Cette arme estampillée par Meow Meow pourrait faire de vous un Ecaflip de légende, éventuellement...');
INSERT INTO "item_descriptions" VALUES(6840,'fr','Cette arme estampillée par Meow Meow pourrait faire de vous une Ecaflip de légende, éventuellement...');
INSERT INTO "item_descriptions" VALUES(6856,'fr','La forme de ces ciseaux est spécialement étudiée pour couper la tige de n''importe quelle rose démoniaque sans abîmer les pétales. Et ceci alors même qu''elle vous mord le mollet.');
INSERT INTO "item_descriptions" VALUES(6863,'fr','Casque des Mercenaires d''Astrub.');
INSERT INTO "item_descriptions" VALUES(6886,'fr','Cape des Mercenaires d''Astrub.');
INSERT INTO "item_descriptions" VALUES(6894,'fr','Ce surpuissant Chacha de combat incarne à merveille la surpuissance. Très impressionnant. Mais attention, il est réservé aux Maîtres de jeu qui le valent bien.');
INSERT INTO "item_descriptions" VALUES(6895,'fr','Moins surpuissant que le surpuissant Chacha de Combat, mais néanmoins très puissant, ce familier reste une valeur sûre pour tout Maître de jeu qui se respecte. En revanche, il faut avouer qu''il est nettement plus salissant. N''oubliez pas de le laver vigoureusement à l''eau bouillante de temps à autre pour qu''il garde toute sa splendeur.');
INSERT INTO "item_descriptions" VALUES(6908,'fr','Poilue mais élégante, cette ceinture devrait parfois vous faire penser à votre dulcinée.');
INSERT INTO "item_descriptions" VALUES(6909,'fr','Ces bottes sont parfaites pour marcher dans la boue et rayer les parquets. Elles sont généralement interdites sur toutes les pistes de danse.');
INSERT INTO "item_descriptions" VALUES(6910,'fr','Cet anneau était placé sur les pattes des sangliers en rut, pour que les éleveurs puissent facilement les reconnaître. Aujourd''hui, c''est vous qui portez cet anneau. Toutes les interprétations sont possibles.');
INSERT INTO "item_descriptions" VALUES(6911,'fr','Ce ridicule petit anneau vous permettra de combattre plus facilement votre phobie des Araknes.');
INSERT INTO "item_descriptions" VALUES(6912,'fr','Confectionnée à partir de vieux restes d''Araknes en décomposition, cette ceinture a tout pour plaire. Elle reprendra parfois vie et prendra un malin plaisir à vous mordre les hanches. Sales bêtes !');
INSERT INTO "item_descriptions" VALUES(6913,'fr','Affublé de cette coiffe, vous ressemblerez à une Arakne sauvage. Dans le meilleur des cas, vous effraierez les Moskitos un peu naïfs.');
INSERT INTO "item_descriptions" VALUES(6914,'fr','Fait très étrange, l''Arakne, n''a que quatre pattes velues, ce qui signifie qu''avec seulement quatre coups de haches, vous pourrez la transformer en Arakne Tronc.');
INSERT INTO "item_descriptions" VALUES(6915,'fr','Cet anneau est si léger qu''il vous permettra de réaliser n''importe quelle acrobatie avec vos doigts. Très pratique pour humilier un adversaire dix fois plus petit que vous, en lui écrasant la tête avec le pouce.');
INSERT INTO "item_descriptions" VALUES(6916,'fr','Ce sac en peau et en ailes de Moskitos faisait jadis fureur à la sortie des écoles. Aujourd''hui, il est totalement démodé, et a été remplacé dans le cœur des enfants par le Petit sac d''écolier du Chef Crocodaille. Du grand n''importe quoi, quand on voit que ce dernier est largement plus cher, et surtout beaucoup plus laid. Une sombre histoire de mode.');
INSERT INTO "item_descriptions" VALUES(6917,'fr','Cette coiffe doit son nom surprenant à l''excentricité du premier Enutrof qui l''a découverte en dépouillant un vieux Moskito malade. Très utile pour les aventuriers qui débutent, elle permet avant tout, de rendre folles de vous les Araknes affamées.');
INSERT INTO "item_descriptions" VALUES(6918,'fr','Moins efficace et moins prisée que la célèbre Araknamu, cette petite amulette a pourtant beaucoup de charme lorsqu''elle est portée toute seule, sur un corps très poilu.');
INSERT INTO "item_descriptions" VALUES(6919,'fr','Le Champ Champ n''a jamais été connu pour être une créature très sympathique. Il vous empoisonne la vie dès qu''il peut, il mord assez fort, et a très mauvais caractère. C''est étonnant comme ces vilaines petites créatures peuvent parfois vous faire penser à un conjoint.');
INSERT INTO "item_descriptions" VALUES(6920,'fr','Lorsque le Champ Champ se marie, il offre cette alliance à sa dulcinée. Cette dernière étant dépourvue de bras, l''alliance est déposée soigneusement sur une de ses épines. En vous équipant de cette alliance, vous briserez les liens du mariage qui unissaient ces deux créatures, et dans le meilleur des cas, le Champ Champ vous prendra pour sa dulcinée.');
INSERT INTO "item_descriptions" VALUES(6921,'fr','Autrefois utilisée en infusion et parfois même fumée, cette coiffe de Champ Champ a tout pour plaire.');
INSERT INTO "item_descriptions" VALUES(6922,'fr','La seule chose qui soit plus impressionnante qu''un Champ Champ enragé, c''est un Champ Champ enragé avec une cape. En effet, cette cape incarne une certaine forme de sur-puissance vestimentaire, bien qu''elle soit avouons-le, assez laide.');
INSERT INTO "item_descriptions" VALUES(6923,'fr','Cette amulette a jadis appartenu au grand bandit "Thisme", réputé pour sa cruauté sans limite et sa mort idiote. Sa vie fût digne d''un conte d''Eniripsa, il mourût noyé et écrasé dans un pressoir à huile alors qu''il venait tout juste de purger une peine de prison de plus d''une centaine d''années, pour avoir volé une noix de cajou.');
INSERT INTO "item_descriptions" VALUES(6924,'fr','Ces dagues aiguisées sont populaires auprès des bandits et impopulaires auprès des jeunes aventuriers pour les mêmes raisons, elles disposent d''un enchantement leur permettant de voler les kamas de ses adversaires. Une forme d''impôt assez originale.');
INSERT INTO "item_descriptions" VALUES(6925,'fr','Cette ceinture saillante vous ira à ravir si vous rejoignez un jour la cause des bandits de grand chemin. En attendant, elle ne vous rendra que plus ridicule.');
INSERT INTO "item_descriptions" VALUES(6926,'fr','Avec cette coiffe de Prespic sur la tête, vous ressemblez presque à Dévie Cloquette, célèbre chasseuse des temps modernes, prête à tout pour cacher sa calvitie naissante. Pas de chance pour vous si vous vouliez faire de même, vous devrez vous contenter d''une coiffe de couleur rousse, qui de toute évidence, dégagera une horrible odeur dès qu''il se mettra à pleuvoir.');
INSERT INTO "item_descriptions" VALUES(6927,'fr','Cette petite cape rousse peut également faire office de descente de lit, ou de paillasson, de quoi remettre au goût du jour l''intérieur de votre habitation, de manière économique.');
INSERT INTO "item_descriptions" VALUES(6928,'fr','À la fois sobre et tout de même original, cet anneau saura séduire les aventuriers avides d''apparat de luxes mais complètement fauchés, au point d''aller dépouiller de ridicules petites créatures sauvages pour s''orner de bijoux. La mesquinerie ne connaît aucune limite.');
INSERT INTO "item_descriptions" VALUES(6929,'fr','Idéale pour garder ses hanches au chaud, cette ceinture a tout de même l''inconvénient d''irriter et de démanger les peaux douces. À réserver aux durs à cuir.');
INSERT INTO "item_descriptions" VALUES(6930,'fr','Ce casque directement taillé dans la pierre vaut son pesant d''or. Il saura vous protéger des attaques d''un Craqueboule tout en vous permettant d''enchaîner des coups de boules dignes du Désiroboule. De quoi faire perdre la boule à tous vos adversaires.');
INSERT INTO "item_descriptions" VALUES(6931,'fr','Cette cape en pierre est un peu trop rigide, mais elle n''en reste pas moins une excellente protection contre les jets de pierres, ou plus dangereux encore, contre les crachats de Craqueleurs.');
INSERT INTO "item_descriptions" VALUES(6933,'fr','Incroyablement lourdes, mais néanmoins assez efficaces, ces bottes en pierre vous permettront enfin d''avoir une excuse, lorsque vous traînez des pieds pour défendre votre percepteur dans un combat perdu d''avance.');
INSERT INTO "item_descriptions" VALUES(6934,'fr','Cette amulette est aussi lourde qu''un Blop boulimique, voilà qui devrait décourager les aventuriers un peu trop fragiles de la porter. En revanche, une fois son poids supporté, il faut reconnaître qu''elle vous donne fière allure.');
INSERT INTO "item_descriptions" VALUES(6935,'fr','Porter cette ceinture autour des hanches fera de vous un aventurier respecté. La porter sur la tête en guise de bandeau fera de vous la risée du village d''Astrub.');
INSERT INTO "item_descriptions" VALUES(6936,'fr','Affublé de cette coiffe originale, vous pourrez enfin faire croire à vos amis que vous êtes un chasseur de Scarafeuilles.');
INSERT INTO "item_descriptions" VALUES(6937,'fr','Affublé de cette coiffe originale, vous pourrez enfin faire croire à vos amis que vous êtes un chasseur de Scarafeuilles.');
INSERT INTO "item_descriptions" VALUES(6938,'fr','Affublé de cette coiffe originale, vous pourrez enfin faire croire à vos amis que vous êtes un chasseur de Scarafeuilles.');
INSERT INTO "item_descriptions" VALUES(6939,'fr','Affublé de cette coiffe originale, vous pourrez enfin faire croire à vos amis que vous êtes un chasseur de Scarafeuilles.');
INSERT INTO "item_descriptions" VALUES(6940,'fr','Qui n''a jamais rêvé de revêtir une cape en coquille de Scarafeuilles ? Une fois équipée, vous devriez réussir à vous prendre pour un véritable Scarafeuille, et peut-être arriverez-vous à vous déplacer en glissant et en dérapant. De quoi décontenancer une horde de Trools.');
INSERT INTO "item_descriptions" VALUES(6941,'fr','Qui n''a jamais rêvé de revêtir une cape en coquille de Scarafeuilles ? Une fois équipée, vous devriez réussir à vous prendre pour un véritable Scarafeuille, et peut-être arriverez-vous à vous déplacer en glissant et en dérapant. De quoi décontenancer une horde de Trools.');
INSERT INTO "item_descriptions" VALUES(6942,'fr','Qui n''a jamais rêvé de revêtir une cape en coquille de Scarafeuilles ? Une fois équipée, vous devriez réussir à vous prendre pour un véritable Scarafeuille, et peut-être arriverez-vous à vous déplacer en glissant et en dérapant. De quoi décontenancer une horde de Trools.');
INSERT INTO "item_descriptions" VALUES(6943,'fr','Qui n''a jamais rêvé de revêtir une cape en coquille de Scarafeuilles ? Une fois équipée, vous devriez réussir à vous prendre pour un véritable Scarafeuille, et peut-être arriverez-vous à vous déplacer en glissant et en dérapant. De quoi décontenancer une horde de Trools.');
INSERT INTO "item_descriptions" VALUES(6944,'fr','Porter cet anneau autour du doigt vous permettra d''avoir une pensée émue pour tous les Scarafeuilles que vous avez exterminés. Alors peut-être, vous vous demanderez si tout cela en valait réellement la peine.');
INSERT INTO "item_descriptions" VALUES(6945,'fr','Porter cet anneau autour du doigt vous permettra d''avoir une pensée émue pour tous les Scarafeuilles que vous avez exterminés. Alors peut-être, vous vous demanderez si tout cela en valait réellement la peine.');
INSERT INTO "item_descriptions" VALUES(6946,'fr','Porter cet anneau autour du doigt vous permettra d''avoir une pensée émue pour tous les Scarafeuilles que vous avez exterminés. Alors peut-être, vous vous demanderez si tout cela en valait réellement la peine.');
INSERT INTO "item_descriptions" VALUES(6947,'fr','Porter cet anneau autour du doigt vous permettra d''avoir une pensée émue pour tous les Scarafeuilles que vous avez exterminés. Alors peut-être, vous vous demanderez si tout cela en valait réellement la peine.');
INSERT INTO "item_descriptions" VALUES(6948,'fr','La Scarature servait autrefois à donner une indication sur votre niveau en combat à mains nues. Posséder une Scarature verte signifiait que vous étiez un débutant, une rouge, signifiait que vous léchiez le sang de vos ennemis une fois ceux-ci exterminés, une blanche, signifiait que vous étiez une véritable machine à exterminer les ennemis, et une bleue signifiait que vous n''aviez pas assez de kamas pour vous acheter une des trois autres Scaratures.');
INSERT INTO "item_descriptions" VALUES(6949,'fr','La Scarature servait autrefois à donner une indication sur votre niveau en combat à mains nues. Posséder une Scarature verte signifiait que vous étiez un débutant, une rouge, signifiait que vous léchiez le sang de vos ennemis une fois ceux-ci exterminés, une blanche, signifiait que vous étiez une véritable machine à exterminer les ennemis, et une bleue signifiait que vous n''aviez pas assez de kamas pour vous acheter une des trois autres Scaratures.');
INSERT INTO "item_descriptions" VALUES(6950,'fr','La Scarature servait autrefois à donner une indication sur votre niveau en combat à mains nues. Posséder une Scarature verte signifiait que vous étiez un débutant, une rouge, signifiait que vous léchiez le sang de vos ennemis une fois ceux-ci exterminés, une blanche, signifiait que vous étiez une véritable machine à exterminer les ennemis, et une bleue signifiait que vous n''aviez pas assez de kamas pour vous acheter une des trois autres Scaratures.');
INSERT INTO "item_descriptions" VALUES(6951,'fr','La Scarature servait autrefois à donner une indication sur votre niveau en combat à mains nues. Posséder une Scarature verte signifiait que vous étiez un débutant, une rouge, signifiait que vous léchiez le sang de vos ennemis une fois ceux-ci exterminés, une blanche, signifiait que vous étiez une véritable machine à exterminer les ennemis, et une bleue signifiait que vous n''aviez pas assez de kamas pour vous acheter une des trois autres Scaratures.');
INSERT INTO "item_descriptions" VALUES(6952,'fr','Avec cette tête de Mulou sur le crâne, vous ressemblez à Bernaize Mainarht, illustre ménestrel en avance sur son temps, dont la tête fut retrouvée coincée dans la gueule d''un Mulou agonisant, n''ayant pas supporté les chansons que le ménestrel avait tenté de lui infliger.');
INSERT INTO "item_descriptions" VALUES(6953,'fr','Ces bottines recouvertes de poils de Mulou, sont très pratiques pour nettoyer les parquets poussiéreux, ou tout simplement pour nettoyer la tête de vos adversaires lorsqu''ils sont au sol en train d''agoniser.');
INSERT INTO "item_descriptions" VALUES(6954,'fr','Cette peau de Mulou constitue une excellente protection contre le froid, mais également contre les aventuriers aux sens olfactifs un peu trop développés.');
INSERT INTO "item_descriptions" VALUES(6955,'fr','Utilisé comme fouet, ce string peut se révéler plus efficace qu''il n''y paraît, pour remotiver vos compagnons de route, lorsque l''amour du risque commence à leur faire défaut.');
INSERT INTO "item_descriptions" VALUES(6956,'fr','Attention, cet anneau rendra votre doigt particulièrement malodorant. Une odeur qui risque d''en couvrir une autre. C''est peut-être pour votre doigt et votre entourage une très bonne chose...');
INSERT INTO "item_descriptions" VALUES(6957,'fr','Cette épée servait autrefois à découper des blocs de granit pour confectionner les murailles des cités prestigieuses telles que Bonta ou Brâkmar. Aujourd''hui, cette arme est avant tout recherchée pour sa capacité à écraser toutes sortes de créatures vivantes, consentantes ou pas.');
INSERT INTO "item_descriptions" VALUES(6961,'fr','Cet anneau est aussi populaire auprès des dentistes que des bandits, qui s''en servent pour casser une à une les dents des imprudents. Une forme de prévention comme une autre contre l''apparition des caries.');
INSERT INTO "item_descriptions" VALUES(6978,'fr','Cette créature ressemble de loin à un Chienchien. Sa tête montre clairement qu''elle a subi de lourds traumatismes, prenez-en soin.');
INSERT INTO "item_descriptions" VALUES(6980,'fr','Le Dofus Vulbis est source de rumeurs fort effrayantes. On dit que le dragon qui a créé cet œuf couleur de rubis serait plus impitoyable que la mort elle-même, et qu''il dévorerait ses victimes pour tenter de satisfaire son insatiable appétit. Légende ou vérité ? Seuls les héros à la fois valeureux et indigestes le savent.');
INSERT INTO "item_descriptions" VALUES(6981,'fr','La lame de ces dagues est en glace, ce qui est très pratique pour rafraîchir l''haleine de vos ennemis, ouvrez-leur la bouche, plantez-y votre grosse dague glacée, et le tour est joué.');
INSERT INTO "item_descriptions" VALUES(6982,'fr','Ces dagues ont baigné dans le sang de nombreuses créatures démoniaques agonisantes, comme des enfants par exemple, ce qui leur donne un cachet franchement original.');
INSERT INTO "item_descriptions" VALUES(6983,'fr','Affûtées une fois par décennie seulement, ces dagues n''en restent pas moins mortelles. Animées d''une magie des plus obscures, elles se déplacent parfois toutes seules la nuit, pour aller se planter dans le meilleur des cas, dans le derrière des imprudents... Encore une histoire que l''on raconte aux jeunes Iops pour leur faire peur.');
INSERT INTO "item_descriptions" VALUES(6984,'fr','Ces dagues ont appartenu à un pauvre Sadida, dont la richesse fulgurante fera date dans l''histoire d''Amakna. En effet, ce Sadida avait dédié son existence à la chasse aux Bouftons, ce qui ne manquait pas de faire rire tous les habitants du village. Certains badauds venaient même de loin, pour le regarder chasser ces ridicules créatures et pour se moquer de lui. Sa vengeance fut terrible, car entre temps, il était devenu assez riche pour mettre à prix toutes les sales têtes qui s''étaient moquées de lui.');
INSERT INTO "item_descriptions" VALUES(6986,'fr','Ce brave bouclier a vu trop de batailles, il n''est plus bon à rien dans son état. Peut-être que Bouwada, au village Pandala, pourra vous le remplacer.');
INSERT INTO "item_descriptions" VALUES(6988,'fr','Autrefois porté par un Xélor sauvage dont la sœur avait été enlevée par des esclavagistes sans scrupules, ce somptueux chapeau fera de vous un sauvage vraiment original.');
INSERT INTO "item_descriptions" VALUES(6989,'fr','Ce chapeau a été confectionné il y a bien longtemps par des apprentis tailleurs qui voulaient se protéger des crises de colères de Mirko le tailleur. Ce dernier avait la fâcheuse habitude de décimer ses apprentis avec des coups de pieds en pleine tête, lorsqu''ils ne travaillaient pas assez vite. Une façon comme une autre de les remotiver pour qu''ils se mettent au travail.');
INSERT INTO "item_descriptions" VALUES(6990,'fr','Cette coiffe est un hommage aux cousins lointains des Moskitos, les Phalènes. Bien plus gros, mais plus gentils que les Moskitos, les Phalènes avaient une fâcheuse tendance à chercher à se reproduire avec tout et n''importe quoi, mais surtout avec n''importe quoi, ce qui a conduit à une extinction progressive de leur espèce. Cette terrible histoire n''avait laissé personne indifférent, et de nos jours, il est courant d''insulter un aventurier de Phalène, lorsque l''on veut insinuer qu''il choisit très mal ses conjoints...');
INSERT INTO "item_descriptions" VALUES(6991,'fr','Cette étrange coiffe ressemble à un gros fruit déshydraté en décomposition, un peu comme vous après une soirée passée à la taverne.');
INSERT INTO "item_descriptions" VALUES(6992,'fr','Version embellie du célèbre masque Kanniboul, le Kannipiou vous permettra de passer pour un véritable chasseur de Pious, auprès de vos amis.');
INSERT INTO "item_descriptions" VALUES(6993,'fr','Hirvé Vélard, célèbre ménestrel de son état, aimait chanter à en perdre la voix. Il fut brûlé vif près de la banque de Bonta, après avoir fait scandale avec sa chanson "Fais-la frire, Mourir ou vivre".');
INSERT INTO "item_descriptions" VALUES(6994,'fr','Cette création hybride entre une hôte et une cape, est franchement étonnante. Si elle avait été confectionnée en cuir, le Captain Chafer l''aurait adorée.');
INSERT INTO "item_descriptions" VALUES(6995,'fr','Cette cape très puissante a renversé plus d''un imprudent ayant tenté de la porter, une caractéristique partagée avec la Momie Nova.');
INSERT INTO "item_descriptions" VALUES(6996,'fr','Stradamus était un vieil Enutrof complètement ivre qui lisait l''avenir dans les chopes de bière. La légende raconte qu''à sa demande, il fut enseveli à la verticale dans un des murs de la taverne de Brâkmar, pour « qu''aucun poltron ne puisse renverser une bière sur sa tombe ». Voilà le genre de légende colportée au fil des beuveries organisées par les Maîtres Sérianes.');
INSERT INTO "item_descriptions" VALUES(6997,'fr','Celle qui a créé cet anneau pensait que la fin du monde était proche, elle passait ses journées à graver sur les tables en bois à l''aide de son sertisseur, qu''il n''y avait plus d''avenir pour les habitants d''Amakna. La suite des événements, lui montra qu''elle avait tort.');
INSERT INTO "item_descriptions" VALUES(6998,'fr','Cette petite alliance est parfaitement adaptée aux petits doigts des Eniripsas. Elle est en revanche presque inutilisable par les Iops à cause de leurs gros doigts boudinés, et leur incapacité à comprendre où se met une alliance.');
INSERT INTO "item_descriptions" VALUES(6999,'fr','Lahilama était un grand chef spirituel qui officiait au fin fond des montagnes. Il s''ennuyait tellement, qu''il passait ses journées à coudre des bonnets jaunes pour ses disciples. La folie n''a pas de limites.');
INSERT INTO "item_descriptions" VALUES(7000,'fr','Ce ridicule petit morceau de bambou est doté de pouvoirs magiques bien étranges. Il était autrefois porté par les jeunes Pandawas, une fois la puberté passée. Vous devriez peut-être attendre encore quelques années avant de le porter autour du cou...');
INSERT INTO "item_descriptions" VALUES(7001,'fr','"Je ne suis pas un Tikoko, les Trukikols me collent à la peau, je ne suis pas un Tikoko, un Tikokooooooo...". Voilà ce que chantait à tue-tête en revenant de ses vacances sur l''île de Moon, Danioule le célèbre ménestrel paysan, connu pour battre l''Avoine en chantant.');
INSERT INTO "item_descriptions" VALUES(7002,'fr','Cette amulette en résine de Bambou diffusera autour de vous une odeur agréable. Très efficace pour dissimuler vos essais de Vents de Panique.');
INSERT INTO "item_descriptions" VALUES(7003,'fr','Ce Talisman a été confectionné avec de la poussière d''étoiles et de pierres précieuses, prises dans de l''ambre d''Abraknyde Ancestral. Le mélange étant parfois explosif, il est déconseillé d''en fabriquer une vous-même, laissez cela à un Bijoutier que vous n''aimez pas.');
INSERT INTO "item_descriptions" VALUES(7011,'fr','Cette cape presque vivante en poils de barbe roux est unique en son genre. Animée d''une magie extraordinaire, elle a tendance à jouer de nombreux tours à son porteur, en se cachant toujours au moment de partir à l''aventure, lorsqu''on a besoin d''elle. Elle compense heureusement sa fourberie, par une puissance en combat à toute épreuve, qui fait d''elle une "véwitable meuchine de guewe" d''après certains Wabbits.');
INSERT INTO "item_descriptions" VALUES(7012,'fr','Cette amulette est en fait une confiserie. Elle pourrait être mangée si elle n''avait pas auparavant été roulée sous les aisselles pendant 36 générations, par une horde de femelles Bwork en chaleur.');
INSERT INTO "item_descriptions" VALUES(7022,'fr','Ce bâton appartenait au grand-père de Sangroku, Sangrokrane, réputé pour avoir la grosse tête. La légende raconte que ce bâton magique est capable de s''allonger pour atteindre n''importe quel ennemi, ou tout simplement pour compenser certains complexes d''infériorité.');
INSERT INTO "item_descriptions" VALUES(7029,'fr','Lorsque Sangroku avait trop abusé des haricots magiques, il serrait bien fort cette ceinture autour de sa taille, pour contenir au maximum, les vents de panique qui l''ont rendu célèbre à travers toute la province d''Amakna.');
INSERT INTO "item_descriptions" VALUES(7031,'fr','Le pauvre Gudule a perdu la tête suite à un terrible combat avec Many. Heureusement, son amulette n''a pas été abîmée pendant l''affrontement. Elle a gardé ses pouvoirs hypnotisants, mais aussi laxatifs. À utiliser avec modération.');
INSERT INTO "item_descriptions" VALUES(7034,'fr','Transmis de générations en générations, ce casque difforme a même été porté par Crail en personne. Beaucoup d''aventuriers lui prêtent des pouvoirs qu''il n''a pas, caractéristique partagée avec beaucoup de divinités et de héros des temps modernes.');
INSERT INTO "item_descriptions" VALUES(7037,'fr','Cette canne appartenait à Mamie Bonbon en personne, une des trois terribles prêtresses de l''amour. Affûtée à une extrémité et lustrée à une autre, cette canne était surtout célèbre pour sa polyvalence et sa capacité à pouvoir se fourrer n''importe où. Personne ne pouvait y rester insensible.');
INSERT INTO "item_descriptions" VALUES(7038,'fr','Cette couronne a appartenu à l''illustre Roi Gelax, réputé pour son romantisme débordant et son pouvoir de séduction qui a marqué à vie plus d''une Gelée femelle... On raconte même, qu''il est plus ou moins le père de toutes les Gelées de la région d''Amakna, preuve s''il en est, de son endurance et de sa fertilité légendaire.');
INSERT INTO "item_descriptions" VALUES(7039,'fr','Célèbre combattant du dimanche, Frank s''est reconverti dans les arts martiaux après avoir lamentablement raté son diplôme de tailleur de pierres.');
INSERT INTO "item_descriptions" VALUES(7040,'fr','Cet arc a appartenu à Kuri en personne, célèbre prêtresse de l''amour et bras gauche de Mamie Bonbon. Ne tournez jamais le dos à une prêtresse de l''amour, une seule flèche de cet arc peut suffire à vous déchirer le cœur, voire même les fesses si vous ne faites pas face à votre adversaire.');
INSERT INTO "item_descriptions" VALUES(7043,'fr','La légende dit que ce splendide Dofus est sorti du trou givré d''Aguabrial le dragon de l''Eau. La légende ne dit pas qu''il était enrhumé ce jour-là, mais c''est pourtant facile à deviner.');
INSERT INTO "item_descriptions" VALUES(7056,'fr','Ce chapeau unique a appartenu à un Xélor, connu pour ses idées explosives et sa maîtrise du temps. Il est mort d''une façon assez peu commune en lançant un Vent de Panique décoiffant, et en oubliant que son chapeau lançait de petites étincelles autour de lui. Sa mort fut paraît-il assez douloureuse, mais si lumineuse, qu''on raconte qu''il aurait éclairé la cité de Brâkmar toute entière pendant quelques secondes.');
INSERT INTO "item_descriptions" VALUES(7058,'fr','Cette coiffe a été confectionnée à partir de restes de Kralamoures morts, séchés. Attention, elle risque de reprendre vie si vous vous en servez comme bonnet de bain.');
INSERT INTO "item_descriptions" VALUES(7069,'fr','Ce brave bouclier a vu trop de batailles, il n''est plus bon à rien dans son état. Peut-être que Bouwada, au village Pandala, pourra vous le remplacer.');
INSERT INTO "item_descriptions" VALUES(7070,'fr','Ce brave bouclier a vu trop de batailles, il n''est plus bon à rien dans son état. Peut-être que Bouwada, au village Pandala, pourra vous le remplacer.');
