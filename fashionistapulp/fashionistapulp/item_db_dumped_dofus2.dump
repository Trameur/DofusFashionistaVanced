CREATE TABLE item_or_conditions
             (item INTEGER, branch INTEGER, stat INTEGER, is_max INTEGER, value INTEGER,
              FOREIGN KEY(item) REFERENCES items(id),
              FOREIGN KEY(stat) REFERENCES stats(id));
CREATE TABLE item_recipe_ingredient_names (
            ingredient_ankama_id INTEGER,
            ingredient_subtype TEXT,
            language TEXT,
            name TEXT,
            PRIMARY KEY (ingredient_ankama_id, ingredient_subtype, language)
        );
