INSERT INTO "item_descriptions" VALUES(8235,'fr','Si vous êtes suffisamment petit, cette cape confectionnée à partir de quelques plumes de Piou, cachera vos fesses. Une protection assez modeste, mais qui a le mérite d''attirer l''attention des passants sur autre chose que vos cheveux gras ou vos grosses verrues.');
INSERT INTO "item_descriptions" VALUES(8236,'fr','Si vous êtes suffisamment petit, cette cape confectionnée à partir de quelques plumes de Piou, cachera vos fesses. Une protection assez modeste, mais qui a le mérite d''attirer l''attention des passants sur autre chose que vos cheveux gras ou vos grosses verrues.');
INSERT INTO "item_descriptions" VALUES(8237,'fr','Cette petite ceinture mettra vos hanches en valeur l''espace d''un combat. Elle servira ensuite à contenir vos tripes lorsqu''un sanglier des plaines un peu énervé vous aura éventré au fin fond des bois.');
INSERT INTO "item_descriptions" VALUES(8238,'fr','Cette petite ceinture mettra vos hanches en valeur l''espace d''un combat. Elle servira ensuite à contenir vos tripes lorsqu''un sanglier des plaines un peu énervé vous aura éventré au fin fond des bois.');
INSERT INTO "item_descriptions" VALUES(8239,'fr','Cette petite ceinture mettra vos hanches en valeur l''espace d''un combat. Elle servira ensuite à contenir vos tripes lorsqu''un sanglier des plaines un peu énervé vous aura éventré au fin fond des bois.');
INSERT INTO "item_descriptions" VALUES(8240,'fr','Cette petite ceinture mettra vos hanches en valeur l''espace d''un combat. Elle servira ensuite à contenir vos tripes lorsqu''un sanglier des plaines un peu énervé vous aura éventré au fin fond des bois.');
INSERT INTO "item_descriptions" VALUES(8241,'fr','Cette petite ceinture mettra vos hanches en valeur l''espace d''un combat. Elle servira ensuite à contenir vos tripes lorsqu''un sanglier des plaines un peu énervé vous aura éventré au fin fond des bois.');
INSERT INTO "item_descriptions" VALUES(8242,'fr','Cette petite ceinture mettra vos hanches en valeur l''espace d''un combat. Elle servira ensuite à contenir vos tripes lorsqu''un sanglier des plaines un peu énervé vous aura éventré au fin fond des bois.');
INSERT INTO "item_descriptions" VALUES(8243,'fr','Muni de ce petit chapeau sur la tête, vous aurez l''air bien ridicule, mais aussi terriblement irrésistible. La vie est une question de choix.');
INSERT INTO "item_descriptions" VALUES(8244,'fr','Muni de ce petit chapeau sur la tête, vous aurez l''air bien ridicule, mais aussi terriblement irrésistible. La vie est une question de choix.');
INSERT INTO "item_descriptions" VALUES(8245,'fr','Muni de ce petit chapeau sur la tête, vous aurez l''air bien ridicule, mais aussi terriblement irrésistible. La vie est une question de choix.');
INSERT INTO "item_descriptions" VALUES(8246,'fr','Muni de ce petit chapeau sur la tête, vous aurez l''air bien ridicule, mais aussi terriblement irrésistible. La vie est une question de choix.');
INSERT INTO "item_descriptions" VALUES(8247,'fr','Muni de ce petit chapeau sur la tête, vous aurez l''air bien ridicule, mais aussi terriblement irrésistible. La vie est une question de choix.');
INSERT INTO "item_descriptions" VALUES(8248,'fr','Muni de ce petit chapeau sur la tête, vous aurez l''air bien ridicule, mais aussi terriblement irrésistible. La vie est une question de choix.');
INSERT INTO "item_descriptions" VALUES(8253,'fr','Cette amulette est souvent confondue avec un jouet à trouver dans des pochettes surprises, alors qu''en fait elle se gagne au stand de tir.');
INSERT INTO "item_descriptions" VALUES(8254,'fr','Offert en alliance, cet anneau permet de faire passer deux messages à l''être aimé : "Je t''aime" et "Va faire la vaisselle". Idéal pour ne pas perdre son temps en répétant tous les soirs la même chose.');
INSERT INTO "item_descriptions" VALUES(8255,'fr','Cette arme terriblement puissante contre les mottes de terre, a marqué plus d''un aventurier débutant. Une fois mouillée, elle devient molle et peut être roulée, mais il faut généralement être à deux pour y arriver.');
INSERT INTO "item_descriptions" VALUES(8256,'fr','Avec ces bottes, un Eniripsa peut marcher sur l''eau, ce qui ne sert à rien puisqu''il peut voler, mais ça impressionne toujours les foules. Les autres pourront toujours se servir de ces bottes pour se gratter les pieds en marchant, ou tout simplement pour les nettoyer.');
INSERT INTO "item_descriptions" VALUES(8257,'fr','Cette ceinture permettait à Vald de prendre son bain sans danger car aucun Iop n''a encore réussi à apprendre à nager.');
INSERT INTO "item_descriptions" VALUES(8258,'fr','Cette cape est idéale pour le camouflage en milieu naturel, mais uniquement s''il n''y a personne pour vous voir.');
INSERT INTO "item_descriptions" VALUES(8259,'fr','Sur la notice de cette coiffe, on peut lire :"Offrez cette coiffe à votre mari, accrochez-la solidement sur sa tête et traînez-le par les pieds dans votre cuisine. Voilà le sol est propre désormais". Cela résume un peu la conception moderne du ménage et de la répartition des tâches ménagères au sein des couples épanouïs et qui s''assument.');
INSERT INTO "item_descriptions" VALUES(8260,'fr','Avec ce bandeau, les Iops n''auront jamais été aussi séduisants !');
INSERT INTO "item_descriptions" VALUES(8262,'fr','La Meulette renferme une étrange substance trouvée dans les entrailles du Meulou, d''aucuns prétendent qu''il s''agit de l''essence du monstre, d''autres pensent qu''il avait juste dévoré un Kirboule pas très frais.');
INSERT INTO "item_descriptions" VALUES(8263,'fr','Attention, cet anneau rendra votre doigt particulièrement malodorant. Une odeur qui risque d''en couvrir une autre. C''est peut-être pour votre doigt et votre entourage une très bonne chose...');
INSERT INTO "item_descriptions" VALUES(8264,'fr','Ces bottes sont encore animées d''une partie de l''appétit vorace du Meulou. Si vos pieds sentent le Clakoss, elles risquent de vous les mordre.');
INSERT INTO "item_descriptions" VALUES(8265,'fr','Le Meulou a la queue si belle et si longue qu''elle traîne au sol. Certains aventuriers jaloux la lui ont arrachée et la portent, espérant sûrement y gagner en virilité.');
INSERT INTO "item_descriptions" VALUES(8266,'fr','Cette ceinture colorée est dotée d''une superbe touffe violacée sur le devant, vous pouvez également la porter à l''envers pour vous travestir en Wabbit.');
INSERT INTO "item_descriptions" VALUES(8267,'fr','En dépeçant le Meulou, des chasseurs se sont aperçus qu''il ne possède qu''une seule grosse corne qui traverse son crâne de part en part, ce qui ne gêne nullement les Iops qui la portent avec un enthousiasme non dissimulé.');
INSERT INTO "item_descriptions" VALUES(8268,'fr','Ce collier permettait au Minotoror de ne pas avoir de puces, de tiques, ou même de poux. De toute évidence, vous en aviez besoin.');
INSERT INTO "item_descriptions" VALUES(8269,'fr','Contrairement à ce que certains aventuriers rapportent, cet anneau n''a jamais été porté par le Minotoror, incapable d''enfiler un tel anneau autour de ses sabots.');
INSERT INTO "item_descriptions" VALUES(8270,'fr','Ce bracelet permet de protéger entièrement le bras d''un Eniripsa, mais triple son poids.');
INSERT INTO "item_descriptions" VALUES(8271,'fr','Cet anneau en cuir et en ivoire permet de stimuler plus facilement vos partenaires.');
INSERT INTO "item_descriptions" VALUES(8272,'fr','Ce collier permettait aux Minotot, de protéger ses cervicales et d''éviter de périr à cause d''un stupide coup du Wabbit.');
INSERT INTO "item_descriptions" VALUES(8273,'fr','Ce collier dispose d''une petite boucle, qui permettait d''accrocher une laisse au cou du Dragon Cochon, lorsque son propriétaire voulait l''emmener faire une petite promenade nocturne.');
INSERT INTO "item_descriptions" VALUES(8274,'fr','Cette hache a permis de trancher la tête d''un des plus dangereux Minotorors que la province d''Amakna ait connu. Le plus incroyable dans cette histoire c''est qu''elle semble vous laisser indifférent.');
INSERT INTO "item_descriptions" VALUES(8275,'fr','Ce Sceptre orné à son extrémité d''une tête de Serpentin en pierres précieuses, permet d''effrayer les jeunes aventuriers, afin de les faire fuir, et de botter leurs petites fesses toutes roses.');
INSERT INTO "item_descriptions" VALUES(8276,'fr','De toute évidence, ces terribles bottes en poils et en cuir de Minotoror, sont bien trop lourdes pour vous faire gagner la légendaire course à pied de la baie d''Amakna. Cependant, elles devraient vous permettre d''écraser facilement les pieds des autres concurrents sur la ligne de départ.');
INSERT INTO "item_descriptions" VALUES(8277,'fr','Ces incroyables sandales vous permettront de vous baigner dans les eaux les plus dangereuses, sans risquer de vous abîmer les pieds. Attention cependant, elles ont la réputation de rayer le fond des baignoires.');
INSERT INTO "item_descriptions" VALUES(8278,'fr','Une bonne paire de mules et vous vous sentez de suite plus fort, plus puissant, plus performant. Alors que ce ne sont que des mules.');
INSERT INTO "item_descriptions" VALUES(8279,'fr','Prenez un Minotoror, attachez-le fermement, prenez un rabot géant, et pelez-lui (en un seul passage) le dos. Voilà, c''est fait, vous avez désormais entre les mains une cape du Minotoror.');
INSERT INTO "item_descriptions" VALUES(8280,'fr','Pour sortir en soirée, ou séduire au bal masqué du Captain Chafer, c''est la cape qu''il vous faut.');
INSERT INTO "item_descriptions" VALUES(8281,'fr','Cette cape ne fera pas de vous un petit Cochon de Lait, mais elle vous permettra peut-être de vous travestir l''espace d''une soirée, afin de séduire une belle Cochonne.');
INSERT INTO "item_descriptions" VALUES(8282,'fr','Cette ceinture est si souple, qu''elle peut servir à fouetter les fesses des enfants trop turbulents. Avec un peu de chance, ses ferrures permettront d''arracher quelques lambeaux de chair, et les terribles garnements qui vous servent de marmaille auront compris une bonne fois pour toute la leçon.');
INSERT INTO "item_descriptions" VALUES(8283,'fr','Cette ceinture rigide, permettait au Minotot, de contenir son énorme bedaine, afin de ne pas basculer en avant au moindre courant d''air.');
INSERT INTO "item_descriptions" VALUES(8284,'fr','Cette coiffe se transmet dans la famille du Minotot, de génération en génération. Ce qui explique en partie son odeur de pellicules en décomposition.');
INSERT INTO "item_descriptions" VALUES(8285,'fr','Affublé de cet énorme crâne, vous aurez l''air d''un Grizboule à poils durs, mais sans poils. De quoi laisser sans voix vos admiratrices.');
INSERT INTO "item_descriptions" VALUES(8286,'fr','Cette cape recouverte d''écailles vous protègera d''après la légende, de la foudre, des haricots, et surtout des femmes fatales.');
INSERT INTO "item_descriptions" VALUES(8287,'fr','Ce casque absolument terrifiant et d''une taille démesurée ferait passer un petit chérubin comme vous, pour un impitoyable guerrier venu de l''au delà. Cloué sur un mur, il fera un excellent porte manteau.');
INSERT INTO "item_descriptions" VALUES(8288,'fr','Les esprits les plus pervertis d''Amakna, racontent que cette ceinture pouvait servir de prothèse. Personne ne comprend pourquoi, et heureusement il n''en est rien, ce n''est qu''une banale ceinture du Dragoeuf.');
INSERT INTO "item_descriptions" VALUES(8289,'fr','Cet anneau directement taillé dans une écaille géante de Dragoeuf protègera une petite partie d''une de vos phalanges. Sûrement la plus importante.');
INSERT INTO "item_descriptions" VALUES(8290,'fr','Confectionnée à partir d''écailles de Dragoeufs, cette amulette protégera efficacement votre pomme d''Adam, ou vos amygdales. De quoi faire la différence sur un champ de bataille.');
INSERT INTO "item_descriptions" VALUES(8291,'fr','Ces bottes sont parfaites pour tuer le Bouftou lors d''une partie de Boufball ou pour faire souffrir un peu plus vos ennemis lors d''un botte-fesses.');
INSERT INTO "item_descriptions" VALUES(8292,'fr','Aiguisée comme le rasoir du soir, cette lame vous permettra tout de même de vous raser le matin, mais uniquement les aisselles.');
INSERT INTO "item_descriptions" VALUES(8293,'fr','Cette hache fend le beurre aussi facilement que les crânes, à moins que ça ne soit l''inverse.');
INSERT INTO "item_descriptions" VALUES(8294,'fr','Plus lourd qu''un crâne vide de Krokeur, mais moins solide qu''un fémur de Kirboule des cavernes, ce marteau reste néanmoins une arme redoutable.');
INSERT INTO "item_descriptions" VALUES(8295,'fr','Cet arc est si puissant qu''il permet d''envoyer des œufs pourris de Dragoeufs au dessus des murailles de Brâkmar. Quel beau gâchis !');
INSERT INTO "item_descriptions" VALUES(8296,'fr','Cette baguette semble plus efficace lorsqu''elle est utilisée comme un gourdin ou comme une tapette à Moskitos.');
INSERT INTO "item_descriptions" VALUES(8297,'fr','Ce bâton est muni à son extrémité, d''une grosse pointe dont personne ne connaît l''origine. En revanche, les aventuriers avertis connaissent sa destination...');
INSERT INTO "item_descriptions" VALUES(8298,'fr','Shika assistait Farle lors des moissons, en récupérant les épis magiques qui tombaient sous sa faux. Elle prit l''habitude au fil des moissons, de les accrocher autour de son cou. Privés de leurs racines et du reste de leur tige, ces épis magiques continuent tout de même de mûrir chaque année à la même période.');
INSERT INTO "item_descriptions" VALUES(8299,'fr','Ce bracelet couvrait les bras de Shika, la protégeant des coups de soleil, et des coups de bec des Corbacs attirés par sa beauté rayonnante. Ils sont encore imprégnés de sa sueur suave.');
INSERT INTO "item_descriptions" VALUES(8300,'fr','Cette binette taillée sur mesure permettait à Shika de créer les meules de foin les plus hautes de tout le royaume. La légende raconte qu''elles étaient si grandes que les marins s''en servaient de points de repère pour savoir s''ils approchaient ou non des côtes d''Amakna.');
INSERT INTO "item_descriptions" VALUES(8301,'fr','Ces sabots ont été conçus pour permettre à Shika de ne jamais écraser les semis, lorsqu''elle ensemençait les plaines de Snossios. Elle y fit rajouter des talons hauts, pour qu''elle puisse courir librement le matin dans les éteules, sans remplir ses sabots de rosée, ou sans abîmer ses chevilles fragiles.');
INSERT INTO "item_descriptions" VALUES(8302,'fr','Des fleurs des moissons ont été cousues sur cette cape confectionnée à partir de céréales magiques tissées entre elles. Elle est animée d''une magie si puissante, que Shika s''en servait de protection contre la foudre, les soirs d''orage.');
INSERT INTO "item_descriptions" VALUES(8303,'fr','Cette ceinture en cuir protégeait les cuisses de Shika, lorsqu''elle traversait des champs de blé en courant pour rattraper les Bouftous égarés de son troupeau. Recouverte de pollen de céréales magiques, on raconte qu''elle brillait au clair de lune, et permettait à Farle de ne pas sectionner les jambes de sa propre femme lorsqu''il fauchait des champs entiers de céréales une fois la nuit tombée.');
INSERT INTO "item_descriptions" VALUES(8304,'fr','Recouverte d''une multitude de fleurs des moissons, cette coiffe donnait une allure guillerette à Shika, lorsqu''elle partait au petit matin, labourer les collines Koln.');
INSERT INTO "item_descriptions" VALUES(8330,'fr','Cette petite coiffe permet au Draguaindrop de se jeter sur ses ennemis sans risquer de se faire de jolies bosses sur le crâne. Utilisée depuis longtemps sur les grands chantiers d''Amakna, cette coiffe a connu un regain de popularité après l''invasion d''Astrub par l''illustre troupe des Meulous débridés de la montagne de Kruup. Il n''y a aucune logique dans cette histoire, mais quelle importance ?');
INSERT INTO "item_descriptions" VALUES(8331,'fr','Equipé de cette coiffe, vous pourrez sans peine vous travestir et séduire le premier Astrubien un peu trop crédule que vous voudrez arnaquer, en lui proposant une folle nuit d''amour derrière un grand orme, pour 100 kamas seulement.');
INSERT INTO "item_descriptions" VALUES(8333,'fr','Cette mystérieuse cape fait son apparition lors des saisons froides, et permet aux imposteurs de se faire passer pour un vieillard généreux.');
INSERT INTO "item_descriptions" VALUES(8334,'fr','Ce chapeau vous permettra de cacher les cicatrices que vous avez sur le crâne. Vous pourrez enfin plaire aux enfants.');
INSERT INTO "item_descriptions" VALUES(8338,'fr','Cette étrange épée ne vous rendra pas invincible, mais vous pourrez peut-être vous en servir pour tuer des boules de neige.');
INSERT INTO "item_descriptions" VALUES(8341,'fr','Ces bottes sentent le jus d''ananas macéré dans du substrat de chaussette trouée. L''avantage, c''est qu''on ne vous demandera jamais de les enlever lorsque vous irez chez un ami.');
INSERT INTO "item_descriptions" VALUES(8366,'fr','Cette cape appartenait à un célèbre chapon, un volatile aux longues plumes qui aimait pavoiser près du zaap de Bonta et se rengorger devant sa basse-cour composée de volailles crédules et de poulardes immatures.');
INSERT INTO "item_descriptions" VALUES(8414,'fr','Ces dagues sont idéales pour découper le haut d''un œuf de Dragoeuf cuit à la coque. Elles sont aussi très légères, ce qui permet de courir vite lorsque le reste de la communauté des Dragoeufs s''en aperçoit.');
INSERT INTO "item_descriptions" VALUES(8417,'fr','Cette petite pelle a été offerte à un jeune Enutrof. Il y est resté si attaché qu''il l''utilisait encore juste avant sa mort.');
INSERT INTO "item_descriptions" VALUES(8419,'fr','Avec cette pelle, Le capitaine Machab a éventré Grobill Dick, le grand Kralamoure Blanc.');
INSERT INTO "item_descriptions" VALUES(8420,'fr','Les Dragoeufs aiment creuser des galeries, mais ne se servent pas de pelles, la communauté Enutrof a longtemps étudié l''énigme de celle-ci, et a fini par conclure qu''il était moins important de savoir d''où elle venait que de taper avec.');
INSERT INTO "item_descriptions" VALUES(8441,'fr','Bill voulait une auréole. Il cria si fort et fit si grand caprice qu''on la lui accorda. Un vrai petit diable.');
INSERT INTO "item_descriptions" VALUES(8442,'fr','Ce masque a servi à Brouce Boulgoure lorsqu''il infiltra subtilement un repaire de rats d''Egoûtants afin de couper un orme en commençant par les racines. Il finit tout de même par massacrer tous les rats du repaire, parce qu''il n''était en réalité pas très discret, avec ses gros sabots en bois.');
INSERT INTO "item_descriptions" VALUES(8443,'fr','Cette cape peut être confectionnée avec n''importe quels poils, à condition qu''ils soient les plus sales possibles. Ils sont tressés entre eux puis fixés à l''aide de sécrétions diverses. L''odeur n''est pas en option.');
INSERT INTO "item_descriptions" VALUES(8444,'fr','À la fois tranchantes et abîmées, les lames de ces dagues permettent de trancher les membres de vos adversaires avec une facilité déconcertante, tout en s''assurant que vous leur retirerez une quantité impressionnante de lambeaux de chair. Dommage qu''elles ne soient pas rouillées, chauffées à blanc et empoisonnées lorsque vous les utilisez.');
INSERT INTO "item_descriptions" VALUES(8445,'fr','Le rat qui possédait ce collier pensait devenir le chef de son clan. Il s''est fait manger par un Lenald enragé.');
INSERT INTO "item_descriptions" VALUES(8446,'fr','Attention en enfilant ces bottes, il n''est pas rare qu''elles contiennent encore un ou deux pieds du propriétaire précédent.');
INSERT INTO "item_descriptions" VALUES(8447,'fr','Contrairement à son cousin bontarien, le Rat Noir aime faire dans la discrétion et porte donc une simple ceinture d''étoffe. Mais il aime aussi emporter un maximum d''armes avec lui, qui font un bruit d''enfer en s''entrechoquant à chaque pas.');
INSERT INTO "item_descriptions" VALUES(8448,'fr','On raconte que le Rat Noir lui-même se grattait le dos grâce aux griffes tranchantes de ce gant. Mais attention tout de même, il se peut que vous retrouverez des poils encore attachés à ce dernier et l''odeur n''est absolument pas garantie. On se demande même s''il se grattait uniquement son dos...');
INSERT INTO "item_descriptions" VALUES(8450,'fr','Cette Arme est le symbole du Rat Blanc. Elle est réputée pour être capable de trancher ennemis et alliés avec la même facilité.');
INSERT INTO "item_descriptions" VALUES(8451,'fr','Avec ce chapeau, le Rat Blanc ressemble à un vrai mousquetaire de Bonta. Sans cette coiffe, il ressemble juste à un Rat Blanc de Bonta sans chapeau.');
INSERT INTO "item_descriptions" VALUES(8452,'fr','Cette cape est le symbole identifiant un rat blanc du réseau d''égouts de Bonta, elle lui est remise après un examen long et difficile, et il la porte fièrement jusqu''à sa mort, c''est-à-dire jamais longtemps.');
INSERT INTO "item_descriptions" VALUES(8453,'fr','Si vous le portez comme un collier, il vous protègera des émanations toxiques provenant des égouts. En revanche, si vous le portez comme une ceinture, ce sont vos alliés qui seront protégés de vos émanations toxiques.');
INSERT INTO "item_descriptions" VALUES(8454,'fr','Ce gant appartenait à Marie Thé, cuisinière du palais de Bonta. Elle s''en servait pour assommer les Bouftous qui refusaient de se faire égorger, les plantes sauvages qui ne voulaient pas aller dans le saladier et les clients qui ne voulaient pas les manger. Tout ceci bien évidemment avec classe, car il ne faut pas se salir les mains.');
INSERT INTO "item_descriptions" VALUES(8455,'fr','Contrairement à ce que pense son cousin brâkmarien, le rat blanc aime également faire dans la discrétion. C''est pour cela que cette ceinture est si légère et discrète pour compenser son corps bien trop imposant.');
INSERT INTO "item_descriptions" VALUES(8456,'fr','Avec ces bottes, votre équilibre est parfait, même par grand vent, vous ne bougerez plus d''un pouce.');
INSERT INTO "item_descriptions" VALUES(8457,'fr','Cette coiffe n''a rien à voir avec un Dora... Absolument rien on vous dit ! Il est donc inutile de répandre de fausses rumeurs à propos du manque d''inspiration ou de la fainéantise de son concepteur . En revanche elle est très jolie.');
INSERT INTO "item_descriptions" VALUES(8458,'fr','Cette cape colorée fait de vous une cible privilégiée. Seuls les aventuriers vifs et agiles ont su la porter longtemps.');
INSERT INTO "item_descriptions" VALUES(8459,'fr','Afin d''éviter qu''on le lui vole, ce collier est glissé autour du cou de l''héritier du Seigneur des rats à sa naissance. Ainsi, à l''âge adulte, le seul moyen de le lui enlever est de lui couper la tête. On le lui vole tout de même.');
INSERT INTO "item_descriptions" VALUES(8460,'fr','Cet anneau a été conçu à une époque où le seigneur des rats s''était mutilé et n''avait plus qu''un doigt. Les malheureux seigneurs suivants avaient encore tous les leurs.');
INSERT INTO "item_descriptions" VALUES(8461,'fr','Les motifs sur cette ceinture donnent l''impression que vous avez le feu au fondement. Le trompe-l''œil est si bon que la plupart des porteurs y croient eux-mêmes et courent partout en hurlant. Ce qui correspond exactement au rituel de la cérémonie.');
INSERT INTO "item_descriptions" VALUES(8462,'fr','Le tout premier Seigneur des rats est mort en marchant par inadvertance dans une flaque de lave en fusion. Ces bottes sont portées en hommage par ses seigneurs. Attention, elles ne sont pas ignifugées.');
INSERT INTO "item_descriptions" VALUES(8463,'fr','Cette Coiffe fut créée pour Jicé Aouaire car il a la tête plate, aucun soucis d''équilibre pour l''arborer donc.
Il l''a faite faire après avoir vaincu l''Abraknyde Ancestral en brisant ses noisettes entre ses fesses, mais il s''en vante moins.');
INSERT INTO "item_descriptions" VALUES(8464,'fr','En été, l''Abraknyde Ancestral aime se dorer au soleil, mais son bois habitué aux forêts sombres le supporte mal. Cette cape est confectionnée avec les pelures de son écorce.');
INSERT INTO "item_descriptions" VALUES(8465,'fr','Autour du cou, ce torque met en valeur votre barbe. Si vous n''avez pas de barbe, vous ne pouvez vous en prendre qu''à vous-même.');
INSERT INTO "item_descriptions" VALUES(8466,'fr','Les soirs où vous aurez trop bu, vous verrez peut-être le Moskito pris dans cet anneau vous faire un clin d''œil. Mais évitez d''en parler à vos amis, il fait seulement semblant.');
INSERT INTO "item_descriptions" VALUES(8467,'fr','Avec ces protège-tibias en bois massif, vos jambes ne craignent plus rien. Ils sont en revanche incompatibles avec le port de bottes. Vous pourrez les utiliser pour vous protéger lors des compétitions de Boufball, mais vous ne pourrez plus faire de pointu avec vos bottes coquées.');
INSERT INTO "item_descriptions" VALUES(8468,'fr','Cette ceinture est censée vous donner la virilité ancestrale. Que ce soit vrai ou pas, l''effet est périmé.');
INSERT INTO "item_descriptions" VALUES(8469,'fr','Cette pièce de bois prélevée au cœur du Chêne Mou renferme un grand pouvoir, comme celui de mettre le Chêne Mou en colère.');
INSERT INTO "item_descriptions" VALUES(8470,'fr','Cet anneau est un excrément du Chêne Mou, en bois, mais l''odeur est la même.');
INSERT INTO "item_descriptions" VALUES(8471,'fr','Le dimanche, le Chêne Mou fait la sieste, et lorsqu''il se réveille, il aime qu''un Tronknyde obéissant lui apporte ses tongues sans qu''il les demande. Il n''a malheureusement pas de pieds, elles sont donc encore neuves.');
INSERT INTO "item_descriptions" VALUES(8472,'fr','Il y a plus de 200 ans, une étoffe d''un tissu anodin s''est prise dans les branches du Chêne Mou. L''arbre a poussé autour et au travers, l''imprégnant ainsi de sa magie. Elle est désormais indissociable de ce gros morceau de bois ce qui la rend peu pratique et inflammable, mais sa puissance est indéniable.');
INSERT INTO "item_descriptions" VALUES(8473,'fr','En automne, le Chêne Mou porte son string pour protéger ses précieux glands. En été, il les trimballe à l''air.');
INSERT INTO "item_descriptions" VALUES(8474,'fr','Vous pouvez porter cette coiffe dans n''importe quel sens, on aura toujours l''impression qu''elle n''est pas droite.');
INSERT INTO "item_descriptions" VALUES(8513,'fr','Pour récolter des « morceaux » de créature, rien ne vaut le scalpel de Bworknroll qui préserve la vitalité des membres arrachés.');
INSERT INTO "item_descriptions" VALUES(8521,'fr','La cape rouge est l''artefact préféré des mégalomanes. Une fois posée sur leurs frêles épaules, ils ont l''impression d''incarner Superman ou un magicien surpuissant jusqu''à ce qu''ils croisent un Minotoror.');
INSERT INTO "item_descriptions" VALUES(8527,'fr','Ces bottes en peaux de gobelins ont été créées par Planbworksek afin de charger l''ennemi (si possible dans le dos) avec une grande vélocité. En chaussant ces bottes, il a sauvé plus d''un camarade Bwork dans la panade.');
INSERT INTO "item_descriptions" VALUES(8530,'fr','Cette coiffe tient chaud aux oreilles, et absorbe les effluves d''alcool qui s''échappent de votre haleine. Que demander de plus ?');
INSERT INTO "item_descriptions" VALUES(8533,'fr','Le Floude n''est pas réellement un chapeau mais un parasite se développant sur le crâne des personnes trop volubiles, excessivement bruyantes, ou simplement verbalement agressives. Son aspect repoussant fait fuir les gens, ce qui pousse son porteur à crier encore plus fort pour se faire entendre, sans succès évidement, puisqu''il n''a rien à dire de toute façon.');
INSERT INTO "item_descriptions" VALUES(8534,'fr','Cette cape molletonnée absorbe tous les bruits environnants, obligeant son porteur à hurler en permanence.');
INSERT INTO "item_descriptions" VALUES(8535,'fr','Ces Getas sont si légères qu''elles poussent leur propriétaire à courir dans tous les sens et à sauter partout lorsqu''un combat commence. Les aventuriers expérimentés détestent ces getas, qui permettent aux premiers venus de prendre part à un combat auquel ils n''ont pas été invités.');
INSERT INTO "item_descriptions" VALUES(8536,'fr','Cette ceinture se porte si serrée qu''elle force presque son porteur à bégayer, trembloter et faire n''importe quoi, tant que c''est en boucle.');
INSERT INTO "item_descriptions" VALUES(8537,'fr','Ce petit anneau ne sert à rien, sinon à être très voyant, histoire de montrer aux gens que vous existez.');
INSERT INTO "item_descriptions" VALUES(8538,'fr','Après plusieurs nuits de dur labeur pour réaliser cette amulette, le plus grand bijoutier d''Astrub, connu pour avoir été élevé par les Bworks s''exclama devant une foule ébahie : "C 1 pur amu tro bi1". Même l''illustre historien Champo Gnon ne parvint pas à déchiffrer ce que le bijoutier avait voulu dire.');
INSERT INTO "item_descriptions" VALUES(8561,'fr','Cet adorable bébé Pandawa adorera vous suivre partout pour découvrir le monde de ses grands yeux ronds.');
INSERT INTO "item_descriptions" VALUES(8569,'fr','Cette coiffe appartenait à une petite Xélorette, qui prenait un malin plaisir à dérégler l''écoulement du temps. La légende raconte qu''elle parvint à voler plusieurs jours aux habitants d''Amakna. Elle ne s''est soustraite à la colère de la population qu''en distribuant de nombreuses friandises.');
INSERT INTO "item_descriptions" VALUES(8575,'fr','Un célèbre guerrier Féca qui vivait dans la jungle de Pandala disait souvent "Pour gagner la guerre, il faut devenir la guerre".');
INSERT INTO "item_descriptions" VALUES(8596,'fr','Cette épée acérée a pris cette teinte pourpre si élégante après avoir éviscéré des milliers de Bworks. Alors qu''avant, elle n''était que violet foncé.');
INSERT INTO "item_descriptions" VALUES(8598,'fr','Ces dagues sont perforées tout au long de la lame, afin d''émettre un joli sifflement quand on les manie rapidement. Les trous sont également très efficaces pour entraîner les viscères de ses ennemis.');
INSERT INTO "item_descriptions" VALUES(8599,'fr','Ces dagues ont été forgées pour une Ecaflipette maniaque de la manucure. Elle trouvait que les lourdes épées s''accordaient mal à ses jolies griffes vernies.');
INSERT INTO "item_descriptions" VALUES(8604,'fr','Cette épée brillante est idéale pour cueillir des fleurs, même si elles se défendent. Elle est même parfaite pour cueillir des arbres.');
INSERT INTO "item_descriptions" VALUES(8605,'fr','Cette lame est lubrifiée afin de glisser plus facilement dans son fourreau. En revanche elle est impossible à nettoyer et doit être jetée après utilisation, surtout si elle est recouverte de sang. N''oubliez pas qu''elle sert avant tout à se protéger.');
INSERT INTO "item_descriptions" VALUES(8607,'fr','C''est un gros bâton, avec des clous plantés dedans. N''y cherchez pas autre chose, c''est la simplicité même, et pourtant, il est diablement efficace pour déchausser les dents de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(8608,'fr','On raconte qu''un disciple de Sadida du nom de Fraye a utilisé ce bâton pour défendre sa femme et son fils face à un troupeau de Bouftous enragés. Il est regrettable qu''il ait confondu sa famille avec les monstres pendant l''échauffourée.');
INSERT INTO "item_descriptions" VALUES(8609,'fr','Cet arc est léger, fin, élégant et sent bon la fleur de cerisier. Il est également meurtrier si l''on s''en sert pour autre chose que se pavaner.');
INSERT INTO "item_descriptions" VALUES(8610,'fr','Si vous tenez cet arc bien haut et prononcez avec entrain le mot "Pampulilu !", vous aurez vraiment l''air ridicule.');
INSERT INTO "item_descriptions" VALUES(8611,'fr','Cette baguette appartient au célèbre Grinegau, qui fait du très bon café, mais qui ne vendra pas son échelle.');
INSERT INTO "item_descriptions" VALUES(8612,'fr','Avec la Bidjiz, vous resterez vivant, sûrement parce que vos adversaires se mettront à danser en voyant les multiples facettes de la boule qui orne cette baguette.');
INSERT INTO "item_descriptions" VALUES(8613,'fr','Créée comme une œuvre d''art de la forgemagie, cette pelle creuse très mal, sauf dans la tête de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(8614,'fr','Magnifique invention, cette pelle deux-en-un permet de creuser une tombe et de la laisser comme croix. À condition de ne perdre qu''un compagnon à la fois, sous peine de creuser les tombes suivantes avec les mains.');
INSERT INTO "item_descriptions" VALUES(8615,'fr','Ce marteau réduit si facilement les crânes en bouillie qu''il a pris une élégante teinte rouge tomate.');
INSERT INTO "item_descriptions" VALUES(8616,'fr','Ce marteau a été créé à l''époque du Roi Stéphane, qui a terrorisé des millions de gens.');
INSERT INTO "item_descriptions" VALUES(8617,'fr','Pour dire je t''aime.');
INSERT INTO "item_descriptions" VALUES(8618,'fr','Cette étrange hache est profilée de façon à décapiter plus facilement les Bworks. L''aisance avec laquelle elle décapite aussi les habitants d''Astrub indique clairement qu''il existe un lien entre ces deux populations. Mais personne n''a encore trouvé lequel.');
INSERT INTO "item_descriptions" VALUES(8619,'fr','Grâce à cette coiffe guerrière, les Iops ont vraiment fière allure. Le seul problème est qu''elle leur cache une partie de leur champ de vision et les empêche d''entendre correctement les paroles de leurs adversaires. Le casque Keutumedi est vraiment fait pour les gens qui aiment frapper avant de réfléchir.');
INSERT INTO "item_descriptions" VALUES(8627,'fr','Confrère et ami du célèbre Guy-guy (proche parent du Chêne Mou), Sarr Ys est un troubadour dont les notes enchanteresses ont gravé leurs empreintes dans la mémoire d''Amakna. Malheureusement, ce brillant artiste est décédé tragiquement dans un accident de Koinkoin, lors d''une beuverie estivale.');
INSERT INTO "item_descriptions" VALUES(8628,'fr','Cette coiffe procure assurance et témérité à celui qui la porte. Grâce à elle vous irez toujours de l''avant, en pensant être capable de réaliser tous les exploits. Pensez toutefois à l''enlever de temps en temps, sinon elle vous entraînera dans des situations inextricables !');
INSERT INTO "item_descriptions" VALUES(8629,'fr','À cause de cette coiffe, les adversaires deviennent souvent muets comme une tombe. On n''ose demander à quoi est censé ressembler ce couvre-chef, on ne peut plus atypique. Mais ce n''est pas très grave. Les Srams ne sont guère susceptibles.');
INSERT INTO "item_descriptions" VALUES(8630,'fr','Cette coiffe ressemble beaucoup au Sulik et au Piruk. Mais comme elle est très confortable et que les Xélors ne la quittent jamais, même pour dormir, elle est communément nommée Bonnet Nufar. Elle dégage une agréable odeur de nymphéa qui contribue à l''endormissement. En revanche, les ronflements qu''elle provoque sont aussi insupportables que les chants de crapaud lors de la saison des amours.');
INSERT INTO "item_descriptions" VALUES(8631,'fr','Grâce à la Coiffe Fère, les Eniripsas savent toujours comment agir en cas d''urgence. En effet, la liste des gestes de premiers secours y est discrètement inscrite dans la doublure. Ce couvre-chef leur donne un air doctoral, comme s''ils venaient de recevoir leur diplôme, alors que personne n''oserait arborer un chapeau aussi ridicule lors d''une cérémonie scolaire !');
INSERT INTO "item_descriptions" VALUES(8632,'fr','On aurait pu croire que cette coiffe possédait une jolie couleur orangée. Ce n''est pas du tout le cas. De plus, cet accessoire de mode tient plus du masque que du chapeau... Alors pourquoi ses créateurs l''ont-ils nommé Chapeau Tyron ? Sûrement pour faire parler les bavards !');
INSERT INTO "item_descriptions" VALUES(8633,'fr','Les pointes acérées qui sortent de ce bonnet permettent non seulement de blesser l''adversaire mais aussi d''avoir plus de chance de se prendre la foudre sur le crâne par temps d''orage. Les Sacrieurs sont en effet une classe qui aime autant faire souffrir les autres qu''eux-mêmes. Une bonne odeur de chair grillée : rien de tel pour commencer la journée !');
INSERT INTO "item_descriptions" VALUES(8634,'fr','Grâce à cette coiffe, vous aurez vraiment l''air d''une bête à cornes. Nul doute que l''on se retourne pour admirer la très grosse paire qui orne votre tête. Cette ample capuche permet aussi de conserver au frais des aliments comme le foin pour Bouftou ou le pain pour Tofu.');
INSERT INTO "item_descriptions" VALUES(8635,'fr','Cette coiffe a la propriété de faire dire au porteur des promesses qu''il oublie aussitôt. Est-ce parce qu''elle exerce une pression sur les zones de la mémoire ou sur celle du langage ? Nul ne le sait précisément. L''important est de ne prendre en compte que les paroles les moins extravagantes.');
INSERT INTO "item_descriptions" VALUES(8636,'fr','Robbie Capuche était un célèbre Crâ qui vivait dans les bois, d''où la couleur verte de sa coiffe pour se fondre dans le paysage. Il se prenait pour un justicier et passait tout son temps à dérober l''argent des riches au profit d''une bonne cause : la sienne.');
INSERT INTO "item_descriptions" VALUES(8637,'fr','En revêtant cette coiffe, le Féca accroît sa chance et celle de ses alliés. Si votre groupe est guidé par un Féca portant un Bonnet Toual, vous êtes sûr d''arriver à bon port et ce presque sans une égratignure. Mais l''odeur est si nauséabonde que cela en fait l''objet idéal pour se protéger de la veuve et de l''orphelin.');
INSERT INTO "item_descriptions" VALUES(8638,'fr','Ce couvre-chef sert aussi bien de protection contre les intempéries que d''accessoire de cuisine, pour mitonner des plats à la bonne température. L''agitation du chapeau permet d''apporter l''afflux d''air nécessaire à la bonne tenue du feu de cuisson. Et, comme tout le monde sait que le pot au feu est un plat qui se mijote pendant longtemps, on comprend mieux pourquoi les Enutrofs ont des poignets si musclés.');
INSERT INTO "item_descriptions" VALUES(8639,'fr','La cape qui flotte au vent est indispensable pour vous procurer une aura de guerrier, surtout si vous tournez le dos à l''adversaire. Certains pensent qu''elle est renforcée par une plaque de métal qui permet de parer tous les coups sournois.');
INSERT INTO "item_descriptions" VALUES(8640,'fr','Faite dans un tissu doux et résistant, cette cape donne aux Ecaflips l''impression qu''ils sont toujours des as, quoi qu''il arrive. Lorsqu''ils remportent la victoire, ils adorent se draper dans ce vêtement avant de réclamer leur récompense : « Et maintenant, t''as qu''à payer ! »');
INSERT INTO "item_descriptions" VALUES(8641,'fr','Cette cape est si légère et si fine qu''elle s''envole à la moindre brise de vent, de n''importe quel vent. Pas toujours très pratique, surtout lorsque l''on veut se faire discret, après un repas composé de légumineuses et de diverses boissons fermentées.');
INSERT INTO "item_descriptions" VALUES(8642,'fr','La couleur sombre de cette cape lui permet d''être en harmonie avec n''importe quel vêtement, quel que soit son coloris. Comme elle est très ample, elle permet aussi de protéger la tête et le bout du nez.');
INSERT INTO "item_descriptions" VALUES(8643,'fr','La Cape Sulhit se met délicatement sur les épaules afin de protéger son porteur des tendinites et de l''enraidissement des articulations. Vêtement aux vertus médicales, il est regardé avec envie par les Pandawas, qui passent beaucoup de temps à porter leur adversaire comme leur allié. Eux-aussi, ils aimeraient avoir un vêtement de ce type.');
INSERT INTO "item_descriptions" VALUES(8644,'fr','Cet objet sert à cacher les surcharges pondérales des Sadidas. À force de dormir au lieu de faire de l''exercice physique, les personnages de cette classe développent une tendance à l''embonpoint. Si les Sadidettes possèdent des réserves anti-famine, avantageusement placées pour flatter les regards masculins, les Sadidas tentent plutôt de masquer les leurs grâce à cette cape.');
INSERT INTO "item_descriptions" VALUES(8645,'fr','Ce vêtement joue un rôle primordial dans la prestance des Sacrieurs. Ils s''en servent comme bandage pour panser les plaies, comme serpillière pour essuyer le sang, comme descente de lit pour ne pas avoir froid aux pieds. On ne dira jamais à quel point les personnages de cette classe redoutent les sols gelés !');
INSERT INTO "item_descriptions" VALUES(8646,'fr','Cette douce cape est parfois employée par les Osamodettes coquettes en guise de couvre-chef aux larges bords. Les Osamodas mâles ne s''en servent que comme pèlerine. Grâce au dessin qui orne cet habit, cette classe de personnages a hérité d''une réputation de grande franchise. On ne les voit jamais rire sous cape car le rire est cousu dessus.');
INSERT INTO "item_descriptions" VALUES(8647,'fr','Les Pandawas se servent de cette cape comme protection contre les intempéries et comme accessoire de danse. Ils la posent à terre, au centre d''un cercle de danseurs éméchés. Puis, ils commencent leur chorégraphie improvisée sans que le pied touche le sol en dehors de la zone délimitée par ce vêtement.');
INSERT INTO "item_descriptions" VALUES(8648,'fr','La cape Hulco tire son origine du nom d''un Crâ atypique. Celui-ci possédait un sens de l''orientation très particulier. Il était capable de se perdre chez lui. Et pourtant ce n''était pas bien grand ! Son problème résidait dans une déformation des fonctions du cerveau : pour lui, tous les lieux ressemblent une vaste plage, entourée de cocotiers, baignée par la lumière chaude d''un soleil couchant.');
INSERT INTO "item_descriptions" VALUES(8649,'fr','Les couleurs chaudes et réconfortantes de cette cape peuvent entraîner son porteur dans un voyage imaginaire, dans des contrées ensoleillées, pleines de canyons creusés par l''érosion, et de décors rupestres taillées dans les roches et les falaises. C''est extrêmement utile pour oublier le froid et la grisaille par temps de pluie.');
INSERT INTO "item_descriptions" VALUES(8650,'fr','Les Enutrofs ont pris l''habitude de dessiner une carte sur leur cape, car ils vivent dans un tel foutoir qu''il leur est difficile de retrouver le chemin des toilettes. Cela est très problématique, surtout lorsque l''on est sujet à des envies aussi pressantes qu''incontrôlables !');
INSERT INTO "item_descriptions" VALUES(8651,'fr','Cette magnifique sangle ajoute du prestige à la tenue des Iops. Certains prétendent que la croix centrale peut se transformer en une arme amovible, lorsque l''épée n''est pas à portée de main. C''est bien sûr une légende, car seuls les Srams seraient assez fourbes pour ce genre de pratique.');
INSERT INTO "item_descriptions" VALUES(8652,'fr','Lorsqu''un Ecaflip ne sait pas quoi faire, il dégaine son jeu de carte de sa ceinture et entame un solitaire. En combat, il se sert également de ses cartes en tant que projectiles. Il tire plus vite que son ombre et, après la victoire, il est toujours temps de faire une petite partie !');
INSERT INTO "item_descriptions" VALUES(8653,'fr','L''origine du nom de cette ceinture provient du bruit particulier qu''elle produit. L''entrechoc des os ornant la sangle empêche les Srams, même invisibles, de passer inaperçus. Aussi, on peut les entendre dire : « Surprendre quelqu''un avec la Sangle Glinglin ? Tu peux toujours attendre ! ».');
INSERT INTO "item_descriptions" VALUES(8654,'fr','Le tic-tac incessant du système d''horlogerie de la Ceinture Lupine empêche les Xélors de s''endormir lorsque les combats s''éternisent. Il est donc vivement recommandé d''enlever cette ceinture avant d''aller se coucher.');
INSERT INTO "item_descriptions" VALUES(8655,'fr','À défaut d''enrayer les pleurs, la sangle Holon permet de transporter du matériel médical. Inutile de faire jouer les violons de l''automne qui blessent les tympans d''une langueur monotone. Les diverses potions utiles pour soigner les maux de gorge et autres affections ORL s''y trouvent soigneusement rangées. En effet, un Eniripsa à la voix enrouée ne peut pas lancer correctement ses sorts. Lorsqu''il est aphone, il est aussi utile qu''une veste polaire en pleine canicule.');
INSERT INTO "item_descriptions" VALUES(8656,'fr','Les raisons qui ont poussé les concepteurs de cet accessoire de mode à placer une tête de poupée près de l''entrejambe restent mystérieuses. Bien des théories ont été avancées, mais chacun sait que tout ceci n''est que du pipeau !');
INSERT INTO "item_descriptions" VALUES(8657,'fr','Guerriers d''une ancienne tribu réputée pour son goût du sang, les Hans seraient les premiers adorateurs de la déesse Sacrieur. Sous son apparence inoffensive, cette ceinture est en réalité un instrument de torture sophistiqué.');
INSERT INTO "item_descriptions" VALUES(8658,'fr','Les Osamodas ont la réputation d''être un peu impulsifs. Ils ont tendance à démarrer au quart de tour. Cette ceinture aux multiples boucles leur sert à refréner cette spontanéité : « Avant d''allumer ta colère, et d''avoir les yeux injectés de sang, touche toutes les cornes de ta Ceinture Bodiézèle ! »');
INSERT INTO "item_descriptions" VALUES(8659,'fr','Cette ceinture aide les Pandawas à se tenir à peu près droit lorsqu''ils sont saouls, ce qui leur arrive souvent. Dans ces moments-là, ils ont tendance à se sentir englués au sol, alors que la gravité n''a aucun rapport avec cette sensation de pesanteur. Elle est bien trop occupée à assommer les scientifiques à coup de pommes.');
INSERT INTO "item_descriptions" VALUES(8660,'fr','Ce ceinturon permet à la fois de retenir les vêtements tombants (pour ne pas effrayer les âmes sensibles) et d''offrir une mire pour les jeunes Crâ en phase d''apprentissage. En effet, on leur apprend à ne jamais tirer en dessous de la ceinture, mais juste au milieu.');
INSERT INTO "item_descriptions" VALUES(8661,'fr','Prévoyants, les Fécas conservent des provisions de survie dans une petite sacoche. Celles-ci se composent essentiellement de pain en pierre de Craqueboule. C''est pourquoi cette nourriture dure si longtemps. La gaine arrime fermement la sacoche à la taille, car le choc lié à la chute de ce sac de nourriture fait encore trop de blessés graves, par négligence ou inconscience.');
INSERT INTO "item_descriptions" VALUES(8662,'fr','La Ceinture Gessant est un accessoire de mode très utile auprès des Enutrofs mâles. Grâce à la carte qui y est cousue, ils peuvent cacher certains accidents de parcours, lorsqu''ils se sont perdus sur le chemin des toilettes.');
INSERT INTO "item_descriptions" VALUES(8663,'fr','Avec les bottes Antrin aux pieds, les Iops sont toujours les premiers à arriver sur le champ de bataille et à mettre de l''ambiance. Il faut dire que cette classe de personnages adore amuser la galerie par ses exploits guerriers. Mais elle n''est jamais prise au sérieux en raison de son intelligence inversement proportionnelle à sa force.');
INSERT INTO "item_descriptions" VALUES(8664,'fr','On dit que les Sadidas ne se sentent jamais seuls, car ils peuvent invoquer plein de poupées pour leur tenir compagnie. Vous aussi, vous ne souffrirez plus de solitude grâce à ces chaussures ! Non seulement vous pourrez prendre votre pied pour lui parler, mais en plus, grâce à ces charentaises à poils, personne ne pourra plus mettre votre jeu à nu. Une fois qu''on les a enfilées, on se sent vraiment bien, même si on a un peu honte de sortir avec.');
INSERT INTO "item_descriptions" VALUES(8665,'fr','Imprégnées d''un produit repulpant à diffusion lente, ces bottes permettent d''améliorer le galbe des jambes et de lutter contre le teint naturellement cadavérique des Srams. Cette crème a des effets spectaculaires sur la plastique des Srams femelles, mais semble totalement inefficace sur les mâles. Serait-ce un problème d''hormone ?');
INSERT INTO "item_descriptions" VALUES(8666,'fr','Créées par un artiste Xélor, ces bottes devaient lui permettre de peindre plus rapidement. C''est le cas ! En revanche, elles ont tendance à déformer la vision et plus précisément le sens des distances. Avec ces bottes, tout paraît plus rond. Appréciés par les Sadidas, les tableaux de ce Xélor ont contribué à rendre populaires les courbes généreuses des femmes un peu fortes.');
INSERT INTO "item_descriptions" VALUES(8667,'fr','Grâce à ces mi-bottes, vous serez toujours protégés des toxines provenant du sol. On ne se méfie jamais assez des microbes et autres bestioles qui traînent. Selon certains observateurs, ces chaussures ressemblent plus à des pantoufles qu''à des bottes. Pourtant, les Eniripsas les nomment bien ainsi. Est-ce à cause de leur petite taille qu''ils voient les choses sous un angle si différent ?');
INSERT INTO "item_descriptions" VALUES(8668,'fr','L''amour des plantes pousse les Sadidas à s''équiper des seules chaussures à reconnaissance florale. Grâce à leur système de détection, elles permettent à son porteur d''éviter d''écraser les plantes rares. Par contre, elles ne vous empêchent pas de marcher sur des excréments divers et variés, si vous ne regardez pas où vous mettez les pieds.');
INSERT INTO "item_descriptions" VALUES(8669,'fr','Contrairement aux autres classes, les Sacrieurs aiment vivre avec une épine dans le pied plutôt que de l''enlever du talon. La douleur leur rappelle qu''ils sont vivants et leur donne la rage de massacrer leurs ennemis. De plus les traces de sang laissées en chemin permettent aux Sacrieurs de ne jamais se perdre. Ils sont toujours capables de retourner sur leur pas, ce qui n''aurait pas été le cas s''ils avaient des chaussures de mauvaise qualité.');
INSERT INTO "item_descriptions" VALUES(8670,'fr','Ces chaussures permettent aux Osamodas d''arpenter de longues distances à travers les continents, même les plus reculés. À part ça, on ne sait pas très bien à quoi elles peuvent servir. Certains estiment qu''il est possible d''en faire des nids à Tofus ou d''élégants vases pour mettre en valeur les fleurs des champs. Tout cela n''est guère convaincant. Bref, les Bottes Swana sont essentiellement des chaussures.');
INSERT INTO "item_descriptions" VALUES(8677,'fr','Ce magnifique Lapino est le familier préféré du célèbre Maître Noir Jack. Ne vous fiez pas à son apparence, il peut se montrer redoutable en combat.');
INSERT INTO "item_descriptions" VALUES(8693,'fr','Grâce à ce familier, n''importe quelle personne du sexe opposé vous fera les yeux doux. Un conseil : évitez de triompher. Bien vite, vous vous apercevrez qu''en réalité, votre prétendant(e) est hypnotisé(e) par Fëanor. N''espérez pas en profiter : désormais votre soupirant(e) mange du Pichon cru en se frottant contre vos jambes... Côté glamour, on a connu mieux, pas vrai ?');
INSERT INTO "item_descriptions" VALUES(8695,'fr','Comme disait Brice : « Ce n''est pas sa taille qui compte, mais la façon de s''en servir. »');
INSERT INTO "item_descriptions" VALUES(8698,'fr','Créé par l''amour de Khelebragon pour la prêtresse Méthée, ce Dofus est un concentré de nostalgie. Ne le contemplez pas trop longtemps, sans quoi vous risquez de verser quelques larmes... ce qui nuirait sans nul doute à votre réputation d''aventurier au cœur de pierre.');
INSERT INTO "item_descriptions" VALUES(8699,'fr','Avec cette coiffe sur le crâne, vous aurez toujours une tête en pétard, même si vous n''êtes pas en colère. Il faut dire que les écorces de la chevelure du Tynril frisent lorsque le temps est humide, ce qui fait de cet animal l''indicateur météorologique le plus sûr au monde. En revanche, il redoute le feu. Faites donc très attention aux flammes si vous ne voulez pas vous transformer en torche humaine.');
INSERT INTO "item_descriptions" VALUES(8701,'fr','Cette somptueuse épée appartenait à un voleur réputé pour se faire attraper à chaque fois qu''il commettait un délit.');
INSERT INTO "item_descriptions" VALUES(8704,'fr','Si vous agitez vos deux petits grelots rapidement, vous pourrez presque jouer de la musique.');
INSERT INTO "item_descriptions" VALUES(8713,'fr','Dans certaines contrées, il semble que les Geta Bernacle sont lancées en guise d''insulte pour provoquer les duels. Même si cela peut prêter à sourire, ce n''est finalement pas plus stupide que de frapper l''adversaire avec une paire de gants. L''avantage des Geta Bernacle est d''ajouter une commotion olfactive au coup physique. Les Pandawas n''ont jamais été réputés pour l''hygiène de leurs pieds...');
INSERT INTO "item_descriptions" VALUES(8714,'fr','Porter cet anneau est une marque honorifique. Cela signifie que vous êtes un digne fidèle de la déesse Crâ, la seule qui vous révèle comment bander plus vite afin de tirer efficacement.');
INSERT INTO "item_descriptions" VALUES(8715,'fr','La volubilité des Ecaflips est légendaire. Ils sont capables de vous sortir n''importe quel baratin pour vous faire jouer. Cette bague célèbre cette loquacité sans faille. Accessoirement, elle peut servir de dé de rechange et elle est également très pratique pour se gratter... à peu près partout.');
INSERT INTO "item_descriptions" VALUES(8716,'fr','Les Osamodettes adorent la bague Héra qui complète leur démarche féline d''une touche de grâce. Il faut dire qu''à force de côtoyer les monstres, elles finissent parfois par se comporter en vraies tigresses. Mais en réalité, elles sont aussi dévouées que des mères mulounes.');
INSERT INTO "item_descriptions" VALUES(8717,'fr','Les mauvaises langues prétendent que la bague Harre est l''accessoire de mode le plus inutile au monde. Les ailes sur le côté sont fort embarrassantes quand vous voulez chercher des mouchoirs dans vos poches. Or, comme les Iops n''ont ni mouchoir ni poche, tout va bien. De plus, elles permettent de déchiqueter un peu de chair à chaque fois qu''elles frôlent l''ennemi. C''est à se demander si ce n''est pas un bijou de Sacrieur.');
INSERT INTO "item_descriptions" VALUES(8718,'fr','Les mini boucliers de l''anneau Tassion servent de pense-bête aux Fécas qui peuvent y glisser des petits mots et des listes de choses à faire. Ce bijou est surnommé le bouclier anti-oubli. En revanche, il ne protège ni du bégaiement ni des lapsus.');
INSERT INTO "item_descriptions" VALUES(8719,'fr','Grâce à cet objet, les Enutrofs peuvent à tout moment se remémorer les instants heureux. Un doux parfum s''en échappe. Il suffit pour cela de retirer la pelle qui y est fichée. Au préalable, il faut bien sûr y mettre l''odeur que l''on veut conserver en souvenir, et ce n''est pas toujours facile.');
INSERT INTO "item_descriptions" VALUES(8720,'fr','Cet objet a été donné par la déesse Eniripsa à ses fidèles en signe d''alliance spirituelle lors de la séance d''initiation aux sorts de la classe. Accessoirement, les Eniripsas peuvent aussi s''en servir comme bracelet mousse pour éponger le sang des alliés.');
INSERT INTO "item_descriptions" VALUES(8721,'fr','Ce bijou a tendance à rendre les Pandawas un peu moqueurs, surtout après la troisième bière. Ils peuvent même aller jusqu''aux insultes. Mais ce n''est pas très important car, comme le dit le célèbre proverbe Pandawa, « Ventre imbibé n''a pas d''oreille ».');
INSERT INTO "item_descriptions" VALUES(8722,'fr','Ce bijou à tête de mort était traditionnellement offert en cadeau, lors d''une fête récompensant tous les enfants Sram pour leur fourberie et leurs coups bas. Les autres classes ont tendance à déconsidérer cette pratique, qui rend les gamins trop agités. Ils deviennent alors infernaux.');
INSERT INTO "item_descriptions" VALUES(8723,'fr','L''anneau Tilus est le seul bijou qui donne l''heure et qui est parfaitement résistant à l''eau. Certains pensent qu''en agrandissant les plans de cet objet et en les modifiant, on pourrait en faire un véhicule se déplaçant sous l''eau. Où peuvent-ils aller chercher tout cela ?');
INSERT INTO "item_descriptions" VALUES(8724,'fr','Contrairement à la rumeur, les Sadidas n''ont pas de poils dans la main. Non ! Ceux-ci sont en fait ajustés autour d''un superbe anneau, dont ils renforcent les effets bénéfiques : ils ne doivent en aucun cas être coupés. Grâce à l''Anneau Pwal, vous serez toujours parfait !');
INSERT INTO "item_descriptions" VALUES(8725,'fr','Si vous voyez un personnage qui n''est pas Sacrieur mettre un Anneau Pitale, emmenez-le d''urgence en soins intensifs. Ce bijou est en effet extrêmement blessant. En général, les gens perdent leur sang-froid devant le bain d''hémoglobine provoqué par cet anneau.');
INSERT INTO "item_descriptions" VALUES(8726,'fr','Ces chaussures permettent à son porteur de danser jusqu''au bout de la nuit, malgré les cors et les ampoules qu''elles occasionnent ! Elles bougent toutes seules au bruit de la musique et font des « bip bip » lorsqu''elles se trouvent à proximité de minerais précieux. C''est pourquoi les Enutrofs sont souvent appelés les « beat-machines ».');
INSERT INTO "item_descriptions" VALUES(8727,'fr','Lorsque les Fécas sont embarrassés et souhaitent détourner la discussion, ils évoquent toujours leurs bottes Antouche. Ils décrivent de quelle manière ces chaussures leur permettent d''arpenter tous types de terrains. Lorsque leurs alliés sont en grosse difficulté lors de combats, le confort de ces bottes leur permet de se ressaisir pour détourner la menace.');
INSERT INTO "item_descriptions" VALUES(8728,'fr','Les multiples sangles entourant ces chaussures peuvent servir de corde de remplacement, lorsque celle de l''arc est rompue. Les jeunes femmes Crâ les emploient aussi pour faire des bottes de légumes en cuisine. Il faut croire qu''elles n''ont pas peur des odeurs de pieds.');
INSERT INTO "item_descriptions" VALUES(8818,'fr','Constituée d''une étoffe de Roissingue, cette cape comporte des micro trous permettant une meilleure évacuation de la sueur en cas d''effort intense, comme lors de mêlées belliqueuses en zone marécageuse. Cette cape laisse passer l''humidité mais garde la chaleur. Ainsi, vous restez sec quelle que soit la situation. Dommage que l''odeur persistante de moisissure soit inaltérable.');
INSERT INTO "item_descriptions" VALUES(8819,'fr','Moins performante que la Cape du Roissingue, cette cape présente néanmoins les mêmes avantages quant à l''évacuation de la sueur. Avec elle, vous allez pouvoir faire face à toutes les situations... Si vous arrivez à combattre en apnée, car vu l''odeur, il est vraiment impossible de ne pas défaillir.');
INSERT INTO "item_descriptions" VALUES(8820,'fr','Grâce à ce masque, vous affronterez tous les dangers sans aucune crainte ! C''est normal vu qu''il obstrue tout le champ de vision.');
INSERT INTO "item_descriptions" VALUES(8821,'fr','De loin, cette coiffe ressemble à un abat-jour avec deux trous pour les yeux. De près, aussi.');
INSERT INTO "item_descriptions" VALUES(8822,'fr','Ce masque ne permet ni de prévenir ni de guérir la gueule de bois, mais il vous donne au moins l''occasion de la dissimuler de façon élégante.');
INSERT INTO "item_descriptions" VALUES(8823,'fr','Ce masque ne permet ni de prévenir ni de guérir la gueule de bois, mais il vous permet au moins de la dissimuler de façon élégante. La nuance sombre indique juste que vous êtes de mauvaise humeur et qu''il ne faut pas vous chauffer longtemps pour que vous lanciez à tout le monde une volée de bois vert.');
INSERT INTO "item_descriptions" VALUES(8824,'fr','Avec ça sur le crâne, vous aurez l''air d''un Kaskargo. Certes vous serez protégé des coups à la tête, mais est-ce une raison pour baver ainsi ? Vous n''avez pourtant pas besoin de ça pour vous déplacer !');
INSERT INTO "item_descriptions" VALUES(8825,'fr','Plus grande, plus lourde, plus puissante, cette masse s''abat plus bruyamment sur les ennemis. Mais curieusement, elle est plus légère et d''une prise en main plus agréable. Le Corailleur dont on s''est servi pour la confectionner n''était pas magistral pour rien.');
INSERT INTO "item_descriptions" VALUES(8826,'fr','Malgré sa petite taille, la Gamine Zoth arbore un immense marteau. C''est une façon comme une autre de renforcer la musculature. Pas besoin de mettre des poids aux pieds ou aux poignets pour augmenter la force : traîner le marteau est bien suffisant !');
INSERT INTO "item_descriptions" VALUES(8827,'fr','Le Guerrier Zoth a pris l''habitude de porter deux haches, car il est incapable de toucher le flanc gauche de son ennemi avec sa main droite. Problème de schéma corporel ou maladresse congénitale ? Difficile de se prononcer là-dessus. Mais avec ses deux haches, il fait feu de tout bois à défaut de s''en servir pour couper des rondins.');
INSERT INTO "item_descriptions" VALUES(8828,'fr','Le Poolay est un volatile malhabile qui a autant de vivacité qu''un Tofu déshydraté.');
INSERT INTO "item_descriptions" VALUES(8829,'fr','Ce chapeau était suffisamment large pour dissimuler la tête et la barbe ridiculement peu fournie de Barbroussa. Mais il n''est pas capable de couvrir le crâne de quelqu''un ayant la grosse tête.');
INSERT INTO "item_descriptions" VALUES(8833,'fr','Ce marteau tire sa jolie couleur des morceaux de Corailleur qui le composent. Contrairement à ce que l''on pourrait croire, il ne servait pas initialement à écrabouiller les Iops ou les ennemis. En réalité, il s''agit d''un objet d''artisanat laissé par une ancienne civilisation. Cette masse servait de heurtoir pour que les personnes ayant des problèmes d''audition puissent comprendre que quelqu''un frappe à la porte.');
INSERT INTO "item_descriptions" VALUES(8834,'fr','Cette branche servait à racler certaines parties du corps inaccessibles autrement. Mais rassurez-vous, la couleur sombre est d''origine. Aucun rapport avec les dépôts contenus dans les cavités les plus inaccessibles de l''Abrakleur.');
INSERT INTO "item_descriptions" VALUES(8835,'fr','Cette branche servait à racler certaines parties du corps inaccessibles autrement. Ceci explique peut-être l''odeur étrange de cette branche.');
INSERT INTO "item_descriptions" VALUES(8836,'fr','Les Broutures se servent de leur tige pour se nettoyer les oreilles. Les sculpteurs préfèrent les employer comme arme. Comme quoi, les goûts et les couleurs, ça ne discute pas.');
INSERT INTO "item_descriptions" VALUES(8837,'fr','Le Maître Zoth est capable de vaincre n''importe qui avec son bâton. Aucun adversaire ne lui fait peur ! Et c''est bien normal. Vu qu''avec sa coiffe il ne voit rien, il ne peut pas être terrorisé par son ennemi. Cette technique bien pratique au combat est toutefois problématique lorsqu''il s''agit de prendre les repas. Ayant un champ de vision limité, le Maître Zoth a toujours eu quelques problèmes pour manger sans en mettre partout.');
INSERT INTO "item_descriptions" VALUES(8838,'fr','Telle la mauvaise herbe, le Tynril est capable de se reproduire à l''infini grâce à un simple bout de rhizome. C''est à partir de cette constatation que certains sculpteurs ont créé un bâton à base de Tynril. Ils espéraient pouvoir le reproduire facilement et à moindre frais pour le revendre au plus offrant. C''est raté.');
INSERT INTO "item_descriptions" VALUES(8839,'fr','Ce masque Vaudou sert essentiellement à masquer le visage des Kannibouls qui aiment la fronde (comme Eth), mais qui ratent souvent leur cible. C''est pourquoi, ils sont toujours un peu verts de rage.');
INSERT INTO "item_descriptions" VALUES(8840,'fr','Les Kannibouls Jav ont souvent le "blues" et peignent leur coiffe en bleu. Est-ce lié à un chagrin d''amour ou à une autre raison ? Difficile de connaître le fin mot de cette histoire. Mais ce serait bien qu''ils se contentent de porter le masque et qu''ils arrêtent de chanter leur mélancolie.');
INSERT INTO "item_descriptions" VALUES(8841,'fr','À force de rire jaune car ils loupent leur objectif, certains Kannibouls ont peint leur masque de cette couleur. Ainsi, même lorsqu''ils rient de bon cœur, on a l''impression qu''ils se forcent.');
INSERT INTO "item_descriptions" VALUES(8842,'fr','Les Kannibouls Ark n''arrivaient pas à se concentrer et à bien viser sauf lorsqu''ils étaient très en colère. Ainsi, pour être toujours sûrs de voir rouge, ils ont peint leurs masques dans cette couleur.');
INSERT INTO "item_descriptions" VALUES(8843,'fr','Avec ce chapeau sur le crâne, le Crocodaille pense être à la pointe de la mode. Il faudrait que celle-ci soit vraiment bien émoussée pour ce que cela soit possible. Mais il vaut mieux éviter de lui faire remarquer son côté ridicule. Le Crocodaille est très susceptible...');
INSERT INTO "item_descriptions" VALUES(8844,'fr','Coiffe royale, cette capuche possède les mêmes vertus que la Cape du Roissingue. Ses micro-aérations contribuent à une meilleure évacuation de la sueur pour toujours garder la tête froide. Hélas, elle possède également les défauts de la cape : son odeur nauséabonde est si présente qu''on pourrait presque la découper au couteau.');
INSERT INTO "item_descriptions" VALUES(8845,'fr','Moins efficace que la Coiffe royale, cette capuche permet toutefois une très bonne évacuation de la sueur. Un peu trop bonne, en fait. Du coup, que l''on porte la capuche ou qu''on ne la porte pas ne fait aucune différence.');
INSERT INTO "item_descriptions" VALUES(8846,'fr','Le Chapeau de la Gamine Zoth a la particularité de lui faire voir les choses en double. Ainsi, lorsqu''elle voit une personne de sa tribu, elle zoth zoth.');
INSERT INTO "item_descriptions" VALUES(8847,'fr','Ce casque a les mêmes avantages que les autres coiffes Zoth : il protège des coups de soleil même en plein cagnard, il amortit les coups portés à la tête, et il empêche de prendre conscience du danger en restreignant le champ de vision de celui qui le porte. Bref, ceci est le couvre-chef idéal du guerrier.');
INSERT INTO "item_descriptions" VALUES(8848,'fr','La coiffe du Maître Zoth possède l''immense avantage de restreindre le champ de vision de manière encore plus importante que les autres casques. C''est grâce à lui que l''on peut accéder à la fameuse technique de combat dite « de la fouine ». En gros, il suffit de frapper n''importe où en utilisant toutes ses forces. Étant ainsi totalement imprévisible, vous êtes sûr de vaincre l''adversaire (ou du moins le surprendre suffisamment pour lui donner des coups bien placés).');
INSERT INTO "item_descriptions" VALUES(8849,'fr','Ce bâton est très branché auprès des femmes troncs. Mais si vous préférez séduire d''autres types de femmes, cela est aussi possible (même si cela risque d''être moins efficace).');
INSERT INTO "item_descriptions" VALUES(8850,'fr','Si vous êtes superstitieux et que vous avez toujours besoin de toucher du bois, choisissez cette Racine de Floribonde ! D''un autre côté, vous pouvez aussi essayer d''être prudent, de ne pas scier la branche sur laquelle vous êtes assis et de ne surtout pas mettre le doigt entre l''arbre et l''écorce.');
INSERT INTO "item_descriptions" VALUES(8854,'fr','Event Shika');
INSERT INTO "item_descriptions" VALUES(8855,'fr','Ce bouclier vous protège des impôts et d''une répartition égalitaire des richesses.');
INSERT INTO "item_descriptions" VALUES(8856,'fr','Lorsque le Rasboul a les boules, il porte sa ceinture Rasboulaire pour envoyer bouler tous les casse-boules.');
INSERT INTO "item_descriptions" VALUES(8858,'fr','Ces Bottes émettent un immonde bruit de succion à chaque pas, ce qui n''est pas sans vous rappeler le chant d''amour des Trools en rut. Un souvenir douloureux dont vous vous seriez bien passé.');
INSERT INTO "item_descriptions" VALUES(8859,'fr','Ce sceau désigne son possesseur comme étant le souverain incontesté de la Tourbière sans fond de l''île d''Otomaï. Difficile d''imaginer un royaume plus bucolique.');
INSERT INTO "item_descriptions" VALUES(8860,'fr','Cet anneau a été arraché au doigt encore chaud d''un jeune Corailleur fraichement massacré. Sa mère l''attendait pour le repas, jusqu''à ce qu''elle s''aperçoive que son rejeton venait d''être transformé en pierre tombale. Même le corail a un cœur, et pas forcément de pierre.');
INSERT INTO "item_descriptions" VALUES(8861,'fr','Seul le Kimbo et ses pieds totalement loufoques peuvent se sentir à l''aise dans ces sandales. En revanche il n''est pas le seul à pouvoir profiter de leur puissance. Attention tout de même de ne pas vous tromper de sens en les enfilant.');
INSERT INTO "item_descriptions" VALUES(8862,'fr','Prosper Youpla était persuadé de pouvoir voler grâce à cette ceinture ornée d''ailes de Bitouf. Ignorant que très peu de Bitoufs savent voler, il s''élançait du haut de l''arbre Hakam et s''écrasait systématiquement au sol, tant et si bien qu''il fût surnommé "Boum".');
INSERT INTO "item_descriptions" VALUES(8863,'fr','Cette amulette est un vulgaire morceau de bois et de tissu déchiré, mais les Zoths croient dur comme fer à ses pouvoirs. Les pauvres fous !');
INSERT INTO "item_descriptions" VALUES(8864,'fr','La corde de cet arc est faite de bave de Kaskargo, plus ou moins sèche, son élasticité est sans pareille, sa texture gluante et visqueuse en revanche rappelle... On ne sait pas trop ce que ça rappelle mais ça n''est pas agréable.');
INSERT INTO "item_descriptions" VALUES(8865,'fr','Sculpté dans une carapace de Kaskargo, cet anneau résiste à n''importe quoi ou n''importe qui.');
INSERT INTO "item_descriptions" VALUES(8866,'fr','Tissée dans des étoffes de Zoths, cette cape possède un pouvoir extraordinaire dont l''origine reste encore inconnue.');
INSERT INTO "item_descriptions" VALUES(8867,'fr','En portant cette cape, vous serez pris d''une furieuse envie de vinaigrette.');
INSERT INTO "item_descriptions" VALUES(8868,'fr','Le fait qu''un bec de Poolay orne cette arme ne sert absolument à rien, voire handicape l''utilisateur. Heureusement qu''elle est puissante.');
INSERT INTO "item_descriptions" VALUES(8869,'fr','Ces bottes sont si lourdes qu''elles seraient plutôt à classer dans la catégorie des armes tellement les coups de pieds deviennent meurtriers.');
INSERT INTO "item_descriptions" VALUES(8870,'fr','Taillée dans un Abrakleur sombre, cette ceinture n''est pas assez flexible pour permettre de bouger librement, mais au moins, elle protège bien.');
INSERT INTO "item_descriptions" VALUES(8871,'fr','Taillée dans un Abrakleur clair, cette ceinture ne protège pas bien, mais au moins, elle est assez flexible pour bouger librement.');
INSERT INTO "item_descriptions" VALUES(8872,'fr','Ce bijou n''est pas très précieux, mais il a la taille idéale pour servir à doser le mourgale dans un bon belgrouth à la glaviouze.');
INSERT INTO "item_descriptions" VALUES(8873,'fr','Enfin une bonne excuse de sentir la marée !');
INSERT INTO "item_descriptions" VALUES(8874,'fr','Ce bijou essaye parfois de vous voler des aliments au passage pendant votre repas, ne le laissez pas pendre trop bas.');
INSERT INTO "item_descriptions" VALUES(8876,'fr','Cette cape étrange semble faite d''encre noire, mais étrangement, elle se comporte comme une étoffe et ne coule pas. En revanche elle tâche. Votre arrière train n''aura jamais été aussi sale.');
INSERT INTO "item_descriptions" VALUES(8877,'fr','Une fois enfilé, vous ne pourrez plus jamais l''enlever tellement ses ventouses sont efficaces.');
INSERT INTO "item_descriptions" VALUES(8878,'fr','Ce marteau n''est pas pratique, pas spécialement beau, pas très ergonomique, pas puissant, pas assez lourd, trop fragile, mal équilibré, il brille trop et sent mauvais.
Mais il est coloré ! Enfin, un peu de couleurs dans ce monde de brutes.');
INSERT INTO "item_descriptions" VALUES(8879,'fr','Cet anneau n''est malheureusement poli qu''à l''extérieur. On y enfile le doigt par un trou orné d''éclats de roche acérés. Recommandé pour les Sacrieurs.');
INSERT INTO "item_descriptions" VALUES(8880,'fr','Ce collier donne une furieuse envie de rugir à son possesseur, simplement parce que les moustaches du Mufafah qui l''ornent lui chatouillent les tétons.');
INSERT INTO "item_descriptions" VALUES(8881,'fr','Solo était un gentil vaurien, d''ailleurs il le disait lui-même. Ça ne l''a pas empêché de mourir pendu sur la place du village après avoir dérobé une petite culotte à la femme du chef. Solo n''était vraiment pas futé, mais gentil quand-même...');
INSERT INTO "item_descriptions" VALUES(8918,'fr','Ce casque amélioré permet en théorie de chevaucher les Scarafeuilles les plus rapides sans perdre sa perruque. Tout simplement inestimable.');
INSERT INTO "item_descriptions" VALUES(8919,'fr','Ces ailes en bois améliorées ont été rembourrées et rendues plus légères grâce à des plumes et du tissu de qualité. L''armature étant toujours en bois, vous aurez tout de même du mal à ne pas vous écraser.');
INSERT INTO "item_descriptions" VALUES(8924,'fr','C''est l''histoire d''un homme appelé Chon, il avait un phare. C''était le Phare à Chon.');
INSERT INTO "item_descriptions" VALUES(8925,'fr','Cet arc étrange a été sculpté par une Sadida pendant une phase de somnambulisme créatrice. Il en émane une envie de sommeil qui affecte autant le porteur que ses cibles.');
INSERT INTO "item_descriptions" VALUES(8926,'fr','Ces dagues sont parfaites pour pousser les ananas ou moudre le café. Certains s''en servent même pour taper des pommes et des poires.');
INSERT INTO "item_descriptions" VALUES(8927,'fr','Eudin était un Sram complètement fou, il volait les pauvres pour donner aux riches.');
INSERT INTO "item_descriptions" VALUES(8928,'fr','Ruik est meilleur buveur que combattant et ça ne s''améliore pas au fil du temps. Il est tout de même déconseillé de ressembler à un bouchon quand il porte ses dagues.');
INSERT INTO "item_descriptions" VALUES(8929,'fr','A ne pas confondre avec le célèbre bâton au nom semblable, ces lames provoquent des carnages bien plus violents.');
INSERT INTO "item_descriptions" VALUES(8930,'fr','Plus d''un fier guerrier a refusé cette arme à cause de sa couleur, la majorité d''entre eux est morte sous sa lame.');
INSERT INTO "item_descriptions" VALUES(8931,'fr','Cette épée appartenait à un vieil Enutrof mégalomane, elle est en or massif, comme l''était son égo.');
INSERT INTO "item_descriptions" VALUES(8932,'fr','Souriez ! Dites cheese ! Voilà, vous êtes coupé en deux.');
INSERT INTO "item_descriptions" VALUES(8933,'fr','Ourag''han était un vieux Pandawa au derme si doux qu''on l''appelait Peau Lisse. Son odeur en revanche était si forte qu''il a hérité d''un autre surnom. Il l''a transmis à sa fidèle hache.');
INSERT INTO "item_descriptions" VALUES(8934,'fr','Fâché de s''être fait voler un grain de riz dans son assiette par un écureuil chenapan pendant ses vacances touristiques sur l''île de Pandala, Brouce Boulgour s''est servi de cette hache pour abattre chaque bambou au sommet duquel le voleur se réfugiait, afin de l''attraper. Les Pandawas du village ont dû le calmer avec la moitié de la réserve d''alcool de bambou pour éviter qu''il ne rase la forêt. Sacré Brouce.');
INSERT INTO "item_descriptions" VALUES(8935,'fr','Jeune Iopette, Mel se voyait déjà vaincre des dragons. Elle jouait à combattre les rochers du jardin de sa mère avec une pelle en guise d''épée. La rocaille a appris à redouter l''ustensile.');
INSERT INTO "item_descriptions" VALUES(8936,'fr','Cette pelle est sauvage et tente de mordre son propriétaire à chaque utilisation. Elle émet des sons bizarres quand elle est contente et ne se calme qu''en présence de grelots.');
INSERT INTO "item_descriptions" VALUES(8937,'fr','Un Enutrof futé s''était fait pirate après avoir fait le constat qu''on ramasse plus de trésor sur un cadavre frais que dans une tombe moisie. Sa pelle rouge sang était son symbole et faisait trembler l''équipage des bateaux de toutes les mers.');
INSERT INTO "item_descriptions" VALUES(8941,'fr','Cette épée vous démontrera que même dans les plus grandes chances, il y a parfois des petits malheurs.');
INSERT INTO "item_descriptions" VALUES(8956,'fr','Cette épée vous démontrera que même dans les plus grandes chances, il y a parfois des petits malheurs.');
INSERT INTO "item_descriptions" VALUES(8957,'fr','Cette épée vous démontrera que même dans les plus grandes chances, il y a parfois des petits malheurs.');
INSERT INTO "item_descriptions" VALUES(8958,'fr','Le dieu Ecaflip vous a tendu sa patte, mais vous n''avez pu saisir qu''une griffe... Et encore, elle ne coupait pas aussi bien que vous auriez pu le croire à première vue. En fait, ce n''était peut-être pas le dieu Ecaflip, finalement...');
INSERT INTO "item_descriptions" VALUES(8959,'fr','Le dieu Ecaflip vous a tendu sa patte, mais vous n''avez pu saisir qu''une griffe... Et encore, elle ne coupait pas aussi bien que vous auriez pu le croire à première vue. En fait, ce n''était peut-être pas le dieu Ecaflip, finalement...');
INSERT INTO "item_descriptions" VALUES(8960,'fr','Le dieu Ecaflip vous a tendu sa patte, mais vous n''avez pu saisir qu''une griffe... Et encore, elle ne coupait pas aussi bien que vous auriez pu le croire à première vue. En fait, ce n''était peut-être pas le dieu Ecaflip, finalement...');
INSERT INTO "item_descriptions" VALUES(8961,'fr','Certains superstitieux prétendent que les pattes de wapin apportent chance et fortune. Grâce à cette légendaire épée, vous pourrez briller à leurs yeux. Par ailleurs, son tranchant est très affuté et sa coupe vous rappelle légèrement celle d''une épée que vous avez déjà connue.');
INSERT INTO "item_descriptions" VALUES(8962,'fr','Certains superstitieux prétendent que les pattes de wapin apportent chance et fortune. Grâce à cette légendaire épée, vous pourrez briller à leurs yeux. Par ailleurs, son tranchant est très affuté et sa coupe vous rappelle légèrement celle d''une épée que vous avez déjà connue.');
INSERT INTO "item_descriptions" VALUES(8963,'fr','Certains superstitieux prétendent que les pattes de wapin apportent chance et fortune. Grâce à cette légendaire épée, vous pourrez briller à leurs yeux. Par ailleurs, son tranchant est très affuté et sa coupe vous rappelle légèrement celle d''une épée que vous avez déjà connue.');
INSERT INTO "item_descriptions" VALUES(8964,'fr','« La chance sourit aux audacieux ! » soufflent les adeptes du dieu Ecaflip. Vous voilà armé comme un as de pique, vous allez pouvoir abattre votre jeu. Cette épée de prestige est d''une rareté et d''une pureté exceptionnelles.');
INSERT INTO "item_descriptions" VALUES(8965,'fr','« La chance sourit aux audacieux ! » soufflent les adeptes du dieu Ecaflip. Vous voilà armé comme un as de pique, vous allez pouvoir abattre votre jeu. Cette épée de prestige est d''une rareté et d''une pureté exceptionnelles.');
INSERT INTO "item_descriptions" VALUES(8966,'fr','Cette épée constitue l''incarnation même de la chance du dieu Ecaflip. Vous tenez entre vos mains la plus pure version de la Patte d''Ecaflip, qui témoigne de votre chance aussi incroyable qu''insolente (et donc de votre célibat définitif).');
INSERT INTO "item_descriptions" VALUES(8989,'fr','Avec ce casque sur la tête, vous pouvez espérer vous élever dans les airs si vous tournez sur vous-même à la vitesse de l''éclair. Pour l''atterrissage, débrouillez-vous.');
INSERT INTO "item_descriptions" VALUES(8991,'fr','Cet anneau vous suce le doigt en permanence, il est gluant et froid, si vous supportez ça vous pourrez profiter de ses immenses pouvoirs.');
INSERT INTO "item_descriptions" VALUES(8992,'fr','Cette lame fauche vos ennemis comme les blés, mais elle attise également la jalousie de vos alliés. Tel est le destin des puissants.');
INSERT INTO "item_descriptions" VALUES(8993,'fr','Cette épée dégage un pouvoir impressionnant, les carnages qu''elle augure sont de ceux restant dans les livres d''histoire. On raconte qu''il existerait également une Faux Maudite, mais seul le plus célèbre des paysans pourrait vous confirmer cela.');
INSERT INTO "item_descriptions" VALUES(9001,'fr','Ce bouclier est censé rappeler à vos adversaires que vous avez grandi dans les Landes de Sidimote. Il paraît que cela pourrait suffire à les effrayer.');
INSERT INTO "item_descriptions" VALUES(9002,'fr','Ce bouclier est recouvert de divers yeux, pour permettre à son porteur de fixer plus facilement son adversaire dans les yeux.');
INSERT INTO "item_descriptions" VALUES(9003,'fr','Le tavernier de la brasserie Feubuk de Bonta devait certainement s''ennuyer fermement lorsqu''il eu soudainement l''idée d''équiper les videurs de sa taverne avec ces boucliers publicitaires.');
INSERT INTO "item_descriptions" VALUES(9004,'fr','Pour parer les coups de bourre ou les coups tordus, ce bouclier issu du village d''Akwadala devrait faire l''affaire.');
INSERT INTO "item_descriptions" VALUES(9005,'fr','Lorsque vos alliés commencent à s''essouffler ou même lorsque vous voulez dissiper les effets d''un Vent de Panique, ce bouclier peut vous sauver la vie, il suffit de l''agiter vigoureusement dans tous les sens, un peu comme si vous vouliez calmer un nourrisson un peu trop bruyant.');
INSERT INTO "item_descriptions" VALUES(9006,'fr','Ce bouclier servait à l''origine de tabouret aux Sadidas lorsque ces derniers devaient se reposer. Une fois les pieds repliés, il vous protègera de beaucoup d''attaques, mais pas des fous rires de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(9007,'fr','Ce bouclier à l''aspect inhabituel est recouvert d''un slip usagé ayant appartenu à un chafer. C''est sans doute un bon moyen de montrer à vos adversaires que vous comptez bien leur infliger une sévère déculottée.');
INSERT INTO "item_descriptions" VALUES(9008,'fr','Ce splendide bouclier contient un échantillon d''eau de la Mer d''Asse, ce qui en plus de vous porter bonheur, pourra vous servir de gourde, si votre dulcinée ne vous accompagne pas durant vos combats.');
INSERT INTO "item_descriptions" VALUES(9009,'fr','Caché derrière ce bouclier, les aventuriers les plus naïfs pourront vous prendre pour un Abraknyde et se sauver en courant. Les autres vous agresseront en pensant récupérer quelques ambres.');
INSERT INTO "item_descriptions" VALUES(9010,'fr','Idéal pour se faire discret sur Pandala, et pour se faire remarquer partout ailleurs, ce bouclier a surtout l''avantage d''être recouvert de poils de Pandawas, réputés pour ne jamais déclencher la moindre allergie. Vous pourrez donc sans crainte ranger ce bouclier directement dans votre slip en cuir.');
INSERT INTO "item_descriptions" VALUES(9011,'fr','Ce bouclier original vous protégera de l''élément Feu, et accessoirement, donnera l''heure à vos adversaires. Très utile pour les aider à chronométrer leur défaite.');
INSERT INTO "item_descriptions" VALUES(9012,'fr','Ce bouclier original vous protègera de l''élément Air, et accessoirement, donnera l''heure à vos adversaires. Très utile pour les aider à chronométrer leur défaite.');
INSERT INTO "item_descriptions" VALUES(9013,'fr','Ce bouclier original vous protégera de l''élément Terre, et accessoirement, donnera l''heure à vos adversaires. Très utile pour les aider à chronométrer leur défaite.');
INSERT INTO "item_descriptions" VALUES(9014,'fr','Ce bouclier original vous protégera de l''élément Eau, et accessoirement, donnera l''heure à vos adversaires. Très utile pour les aider à chronométrer leur défaite.');
INSERT INTO "item_descriptions" VALUES(9015,'fr','Ce bouclier servait à l''origine aux bûcherons qui voulaient se protéger de la chute des arbres. Il a vite été détourné de son usage, et sert maintenant à se protéger des chutes des ennemis qui ont parfois une fâcheuse tendance à vous tomber dessus sans prévenir.');
INSERT INTO "item_descriptions" VALUES(9016,'fr','Verdâtre et malodorant, ce bouclier n''en reste pas moins une protection de choix, lorsqu''il s''agît d''affronter les créatures du Mont Kipou.');
INSERT INTO "item_descriptions" VALUES(9017,'fr','Si vous avez toujours rêvé d''être un vrai Brigandin, c''est le bouclier qu''il vous faut. Transmis de générations en générations, il vous permettra de détrousser sans prendre le moindre coup, les jeunes aventuriers d''Astrub.');
INSERT INTO "item_descriptions" VALUES(9018,'fr','Un illustre aventurier collectionneur a passé sa vie à chercher ce type de bouclier. On raconte qu''une fois quatre de ces boucliers réunis, on pouvait jouir d''une meilleure vie.');
INSERT INTO "item_descriptions" VALUES(9019,'fr','Tous les Wabbits ne sont pas de petites créatures inoffensives. En réalité, tous les Wabbits sont d''infâmes créatures, certains ont même des moeurs barbares et écrasent les Cawottes avec cet énorme bouclier, pour en faire du jus.');
INSERT INTO "item_descriptions" VALUES(9020,'fr','Ce bouclier en peau, risque de vous coller à la peau, tellement vous l''apprécierez. N''oubliez pas de soigner ses verrues et ses furoncles de temps en temps pour éviter qu''il ne s''abîme.');
INSERT INTO "item_descriptions" VALUES(9021,'fr','Un jeune aventurier avait voulu s''enrôler dans la milice de Bonta pour défendre les opprimés. Réformé en raison de sa constitution trop faible, il fut tout de même contacté par un Alchimiste d''Amakna, déterminé à l''utiliser comme cobaye pour tester une de ses nouvelles potions magiques. L''effet fut immédiat, le jeune aventurier devint rapidement un véritable guerrier d''une force extraordinaire, mais aussi complètement stupide. Il avait en fait été transformé en Iop. Il se fit forger ce bouclier réputé indestructible, et le surnom de Captain Amakna (en hommage à l''illustre Captain Chafer qui disparut dans des circonstances bien mystérieuses) lui fut attribué pour l''éternité.');
INSERT INTO "item_descriptions" VALUES(9022,'fr','Cet énorme bouclier a jadis, permis au célèbre aventurier Kloume, de ne pas mourir écrasé sous le poids d''un Craqueleur qui était tombé amoureux de lui. L''histoire ne raconte pas s''il a survécu aux effets secondaires de sa relation passionnée avec le Craqueleur.');
INSERT INTO "item_descriptions" VALUES(9023,'fr','Aussi étrange que cela puisse paraître, on raconte que ce bouclier en bois et en poils, permet aux aventuriers les plus légers, de s''envoler quelques instants dans les airs, pour impressionner une dernière fois leurs adversaires avant de s''écraser stupidement sur le sol.');
INSERT INTO "item_descriptions" VALUES(9024,'fr','Le Chouque se servait de ce bouclier pour se protéger des gros boulets qui lui étaient régulièrement envoyés. Les histoires les plus folles, racontent même que certains boulets étaient vivants.');
INSERT INTO "item_descriptions" VALUES(9025,'fr','Assez inutile mais tout de même impressionnant grâce à l''odeur qu''il dégage, ce bouclier sera le compagnon de beaucoup de jeunes aventuriers.');
INSERT INTO "item_descriptions" VALUES(9026,'fr','Ce bouclier est clairement un hommage à la cape du Bowisse, elle-même étant un hommage à une célèbre relique composée de trois fragments de forme triangulaire. Encore une histoire à dormir debout.');
INSERT INTO "item_descriptions" VALUES(9027,'fr','Ce bouclier en pierre est en fait une tête de Craqueleur écrasée par le pied d''un Minotoror. Une façon comme une autre de combiner grosse tête et odeurs de pieds.');
INSERT INTO "item_descriptions" VALUES(9028,'fr','Pour parer les coups de bourre ou les coups tordus, ce bouclier issu du village de Terrdala devrait faire l''affaire.');
INSERT INTO "item_descriptions" VALUES(9029,'fr','Pour parer les coups de bourre ou les coups tordus, ce bouclier issu du village de Feudala devrait faire l''affaire.');
INSERT INTO "item_descriptions" VALUES(9030,'fr','Pour parer les coups de bourre ou les coups tordus, ce bouclier issu du village d''Aerdala devrait faire l''affaire.');
INSERT INTO "item_descriptions" VALUES(9031,'fr','En son temps, Maître Jarbo était très fort et il possédait richesses et femmes à foison. Mais il n''avait guère de mérite puisqu''il tirait tout son pouvoir de son joli anneau. Un jour, il traversa une route. Et PAF Maître Jarbo. Depuis, son anneau se transmet de main en main entre personnes peu scrupuleuses.');
INSERT INTO "item_descriptions" VALUES(9117,'fr','Ougah a la tête dure, plus dure que n''importe qui, c''est pourquoi un marteau créé avec son crâne est idéal pour fracasser celui des autres.');
INSERT INTO "item_descriptions" VALUES(9122,'fr','Une fois enfilé au bout d''un doigt, il n''est plus possible de se débarrasser de cet anneau. Plus vous y pensez, et plus il vous rappelle quelqu''un.');
INSERT INTO "item_descriptions" VALUES(9123,'fr','Une fois enfilé au bout d''un doigt, il n''est plus possible de se débarrasser de cet anneau. Plus vous y pensez, et plus il vous rappelle quelqu''un.');
INSERT INTO "item_descriptions" VALUES(9124,'fr','Une fois enfilé au bout d''un doigt, il n''est plus possible de se débarrasser de cet anneau. Plus vous y pensez, et plus il vous rappelle quelqu''un.');
INSERT INTO "item_descriptions" VALUES(9125,'fr','Une fois enfilé au bout d''un doigt, il n''est plus possible de se débarrasser de cet anneau. Plus vous y pensez, et plus il vous rappelle quelqu''un.');
INSERT INTO "item_descriptions" VALUES(9126,'fr','Kroula avait jadis tenté d''enfiler cet anneau autour de son gros orteil. Il espérait ainsi que ses ennemis daigneraient lui lécher les pieds dans l''espoir de récupérer quelques gouttes de jus de Blop Royal.');
INSERT INTO "item_descriptions" VALUES(9127,'fr','Kroula avait jadis tenté d''enfiler cet anneau autour de son gros orteil. Il espérait ainsi que ses ennemis daigneraient lui lécher les pieds dans l''espoir de récupérer quelques gouttes de jus de Blop Royal.');
INSERT INTO "item_descriptions" VALUES(9128,'fr','Kroula avait jadis tenté d''enfiler cet anneau autour de son gros orteil. Il espérait ainsi que ses ennemis daigneraient lui lécher les pieds dans l''espoir de récupérer quelques gouttes de jus de Blop Royal.');
INSERT INTO "item_descriptions" VALUES(9129,'fr','Kroula avait jadis tenté d''enfiler cet anneau autour de son gros orteil. Il espérait ainsi que ses ennemis daigneraient lui lécher les pieds dans l''espoir de récupérer quelques gouttes de jus de Blop Royal.');
INSERT INTO "item_descriptions" VALUES(9130,'fr','Cette réplique approximative du grand Ougah se porte autour du cou, avec un regard noir et une barbe correctement entretenue.');
INSERT INTO "item_descriptions" VALUES(9131,'fr','Colerette la jeune Crâ a perdu la tête dans les bois de Litneg. La pauvre fille a reçu une hache lancée par Brouce Boulgoure, qui l''avait prise par méprise pour une fougère géante. Être une belle plante ne paie pas toujours.');
INSERT INTO "item_descriptions" VALUES(9132,'fr','Avec cet anneau, en plus d''avoir un cheveu sur la langue et un poil dans la main, vous pourrez vous vanter d''avoir des cheveux autour des doigts.');
INSERT INTO "item_descriptions" VALUES(9133,'fr','Si vos ennemis sont allergiques aux champignons, laissez-les vous croquer les doigts.');
INSERT INTO "item_descriptions" VALUES(9134,'fr','Construites à la base pour servir de lattes pour les sommiers de lits, ces lamelles ont fini par être utilisées dans la fabrication de cet arc, qui vous permettra d''endormir vos ennemis pour l''éternité.');
INSERT INTO "item_descriptions" VALUES(9135,'fr','À l''origine, il suffisait de souffler très fort dans cette trompette fongique, pour faire arriver le ménestrel Francisque Kabroule. Ce dernier se mettait alors à chanter et tous les monstres mourraient sur place. Bon, comme c''était un peu trop facile comme technique pour tuer les monstres, les dieux ont décidé de la boucher et de la transformer en une vulgaire baguette.');
INSERT INTO "item_descriptions" VALUES(9136,'fr','Les trois pointes de ce bâton permettent de concentrer les résidus de plasmogrine présents dans la brise quadramentale. Mettez un peu de salive sur les pointes, orientez le bâton dans le sens des aiguilles d''une montre Xélor inversée, comptez jusqu''à soixante, ou essayez jusqu''à six si vous êtes Iop. Restez concentré, serrez les fesses, voilà vous avez une chance sur deux de vous prendre un coup de tonnerre, ou de transformer vos ennemis en Kirboules hirsutes.');
INSERT INTO "item_descriptions" VALUES(9137,'fr','Ces couteaux étaient autrefois utilisés pour retirer les mycoses qui parasitaient les pieds des aventuriers. On leur coupait les pieds juste au niveau du genou.');
INSERT INTO "item_descriptions" VALUES(9138,'fr','Les différentes lamelles de cette hache permettent de couper très rapidement le saucisson. Un seul coup de hache permet de couper trois tranches. Pour tuer les ennemis, c''est un peu moins utile, sauf si vous avez l''habitude de les manger en tranches.');
INSERT INTO "item_descriptions" VALUES(9139,'fr','Ces bottines sont parfaites pour marcher dans les sous-bois, sans écraser les feuilles mortes. Attention cependant, leurs origines végétales les poussent inexorablement à écraser tout ce qui s''apparente de près ou de loin à du fumier.');
INSERT INTO "item_descriptions" VALUES(9140,'fr','Ces chaussons sont recouverts de petites aérations qui, contrairement aux idées reçues, ne permettent pas à vos pieds de mieux s''aérer, mais plutôt aux spores des champignons installés sur vos pieds, de s''enfuir rapidement pour aller parasiter d''autres aventuriers plus facilement.');
INSERT INTO "item_descriptions" VALUES(9141,'fr','Si cette cape n''était pas recouverte de moisissure, elle pourrait servir de nappe. Ce n''est pas grave, elle pourra toujours vous servir de linceul.');
INSERT INTO "item_descriptions" VALUES(9142,'fr','Cette cape était autrefois réservée aux meilleurs grimpeurs, aux aventuriers qui étaient les plus rapides pour escalader la montagne des Craqueleurs. Aujourd''hui elle sert surtout à se faire remarquer dans les soirées mondaines.');
INSERT INTO "item_descriptions" VALUES(9143,'fr','Comme son nom l''indique, ce string est particulièrement efficace pour tuer les mouches un peu trop intéressées par votre anatomie. Il est déconseillé de l''arracher avec les dents, même si vous appréciez cela.');
INSERT INTO "item_descriptions" VALUES(9144,'fr','La meilleure façon de ne pas avoir de champignons dans l''entrejambe, c''est de les attirer ailleurs. Comme il n''y avait déjà plus de place dans vos chaussures pour loger d''autres champignons, vous pourrez utiliser cette ceinture, véritable substrat pour tout bon champignon digne de ce nom.');
INSERT INTO "item_descriptions" VALUES(9145,'fr','Prenez un Orme, retirez-lui son écorce, laissez-la tremper dans une flaque, enfouissez-la dans la vase pendant plusieurs mois, recouvrez-là de spores de champignons, mettez-là sous votre lit pendant une semaine en la badigeonnant de graisse de Blop tous les soirs, et voilà vous avez une ceinture en écorce qui sent très mauvais. Alors heureux ?');
INSERT INTO "item_descriptions" VALUES(9146,'fr','Sur l''étiquette de cette ceinture, on peut lire : "Nous sommes désolés mais ce n''est pas en portant cette ceinture que vous aurez le déhanchement légendaire d''Ougah". Et alors ?');
INSERT INTO "item_descriptions" VALUES(9147,'fr','Prenez un Dora, recouvrez-le de bave de Bouftou et de la sueur de Iop. Laissez le tout moisir pendant quelques semaines, et voilà vous avec une réplique de Chapignon. Attention, ce chapeau donne parfois des hallucinations.');
INSERT INTO "item_descriptions" VALUES(9148,'fr','Plutôt que de réduire sa consommation de jus de Blop frelaté, Shika Ingalsse préféra continuer de faucher en état d''ébriété. C''est en titubant dans les champs qu''elle tomba sur cet étrange anneau. Malheureusement, cette histoire ne comporte qu''une seule chute.');
INSERT INTO "item_descriptions" VALUES(9149,'fr','Quand Lorkos voulut pénétrer dans le Labyrinthe du Minotoror, il n''hésita pas une seconde à équiper son Amublop. Personne n''a jamais su pourquoi.');
INSERT INTO "item_descriptions" VALUES(9150,'fr','Quand Lorkos voulut pénétrer dans le Labyrinthe du Minotoror, il n''hésita pas une seconde à équiper son Amublop. Personne n''a jamais su pourquoi.');
INSERT INTO "item_descriptions" VALUES(9151,'fr','Quand Lorkos voulut pénétrer dans le Labyrinthe du Minotoror, il n''hésita pas une seconde à équiper son Amublop. Personne n''a jamais su pourquoi.');
INSERT INTO "item_descriptions" VALUES(9152,'fr','Quand Lorkos voulut pénétrer dans le Labyrinthe du Minotoror, il n''hésita pas une seconde à équiper son Amublop. Personne n''a jamais su pourquoi.');
INSERT INTO "item_descriptions" VALUES(9153,'fr','Cette amulette coûte beaucoup plus cher à fabriquer qu''une Amublop classique. Mais il faut voir le bon côté des choses, elle peut aussi se revendre plus cher, surtout si vous arnaquez un habitant d''Astrub.');
INSERT INTO "item_descriptions" VALUES(9154,'fr','Cette amulette coûte beaucoup plus cher à fabriquer qu''une Amublop classique. Mais il faut voir le bon côté des choses, elle peut aussi se revendre plus cher, surtout si vous arnaquez un habitant d''Astrub.');
INSERT INTO "item_descriptions" VALUES(9155,'fr','Cette amulette coûte beaucoup plus cher à fabriquer qu''une Amublop classique. Mais il faut voir le bon côté des choses, elle peut aussi se revendre plus cher, surtout si vous arnaquez un habitant d''Astrub.');
INSERT INTO "item_descriptions" VALUES(9156,'fr','Cette amulette coûte beaucoup plus cher à fabriquer qu''une Amublop classique. Mais il faut voir le bon côté des choses, elle peut aussi se revendre plus cher, surtout si vous arnaquez un habitant d''Astrub.');
INSERT INTO "item_descriptions" VALUES(9157,'fr','Sans additif ni colorant, cette amulette serait tout simplement transparente. Rassurez-vous, personne ne vous demandera de la manger.');
INSERT INTO "item_descriptions" VALUES(9158,'fr','Inutile de râler parce que le nom de ces bottes est imprononçable, cette particularité vous sauvera la vie, quand un brigand de grand chemin vous demandera : "Donne-moi tes Blopetes, non tes Blotpes, non tes Plobtes, non...". Vous aurez alors tout le temps nécessaire pour vous enfuir en courant.');
INSERT INTO "item_descriptions" VALUES(9159,'fr','Inutile de râler parce que le nom de ces bottes est imprononçable, cette particularité vous sauvera la vie, quand un brigand de grand chemin vous demandera : "Donne-moi tes Blopetes, non tes Blotpes, non tes Plobtes, non...". Vous aurez alors tout le temps nécessaire pour vous enfuir en courant.');
INSERT INTO "item_descriptions" VALUES(9160,'fr','Inutile de râler parce que le nom de ces bottes est imprononçable, cette particularité vous sauvera la vie, quand un brigand de grand chemin vous demandera : "Donne-moi tes Blopetes, non tes Blotpes, non tes Plobtes, non...". Vous aurez alors tout le temps nécessaire pour vous enfuir en courant.');
INSERT INTO "item_descriptions" VALUES(9161,'fr','Inutile de râler parce que le nom de ces bottes est imprononçable, cette particularité vous sauvera la vie, quand un brigand de grand chemin vous demandera : "Donne-moi tes Blopetes, non tes Blotpes, non tes Plobtes, non...". Vous aurez alors tout le temps nécessaire pour vous enfuir en courant.');
INSERT INTO "item_descriptions" VALUES(9162,'fr','Prononcez dix-huit fois le mot "Bloptes" le plus rapidement possible. Voilà, vous avez l''air d''un Iop.');
INSERT INTO "item_descriptions" VALUES(9163,'fr','Prononcez dix-huit fois le mot "Bloptes" le plus rapidement possible. Voilà, vous avez l''air d''un Iop.');
INSERT INTO "item_descriptions" VALUES(9164,'fr','Prononcez dix-huit fois le mot "Bloptes" le plus rapidement possible. Voilà, vous avez l''air d''un Iop.');
INSERT INTO "item_descriptions" VALUES(9165,'fr','Prononcez dix-huit fois le mot "Bloptes" le plus rapidement possible. Voilà, vous avez l''air d''un Iop.');
INSERT INTO "item_descriptions" VALUES(9166,'fr','Avec ou sans rembourrage ces bottes restent étranges. Il est donc inutile de les rembourrer avec autre chose que vos pieds.');
INSERT INTO "item_descriptions" VALUES(9167,'fr','Derrière ce nom stupide, se cache en réalité une ceinture originale, dont on ne connaît pas vraiment les défauts, ni les qualités. On sait tout de même qu''elle est reconnue d''utilité publique grâce à la protection exceptionnelle qu''elle confère aux poignées d''amour.');
INSERT INTO "item_descriptions" VALUES(9168,'fr','Derrière ce nom stupide, se cache en réalité une ceinture originale, dont on ne connaît pas vraiment les défauts, ni les qualités. On sait tout de même qu''elle est reconnue d''utilité publique grâce à la protection exceptionnelle qu''elle confère aux poignées d''amour.');
INSERT INTO "item_descriptions" VALUES(9169,'fr','Derrière ce nom stupide, se cache en réalité une ceinture originale, dont on ne connaît pas vraiment les défauts, ni les qualités. On sait tout de même qu''elle est reconnue d''utilité publique grâce à la protection exceptionnelle qu''elle confère aux poignées d''amour.');
INSERT INTO "item_descriptions" VALUES(9170,'fr','Derrière ce nom stupide, se cache en réalité une ceinture originale, dont on ne connaît pas vraiment les défauts, ni les qualités. On sait tout de même qu''elle est reconnue d''utilité publique grâce à la protection exceptionnelle qu''elle confère aux poignées d''amour.');
INSERT INTO "item_descriptions" VALUES(9171,'fr','Dépourvue de boucle, cette ceinture peut tout de même faire très mal si vous vous en servez comme fouet sur un postérieur à la peau fragile. Les pointes en fer rouillées sont à commander séparément.');
INSERT INTO "item_descriptions" VALUES(9172,'fr','Dépourvue de boucle, cette ceinture peut tout de même faire très mal si vous vous en servez comme fouet sur un postérieur à la peau fragile. Les pointes en fer rouillées sont à commander séparément.');
INSERT INTO "item_descriptions" VALUES(9173,'fr','Dépourvue de boucle, cette ceinture peut tout de même faire très mal si vous vous en servez comme fouet sur un postérieur à la peau fragile. Les pointes en fer rouillées sont à commander séparément.');
INSERT INTO "item_descriptions" VALUES(9174,'fr','Dépourvue de boucle, cette ceinture peut tout de même faire très mal si vous vous en servez comme fouet sur un postérieur à la peau fragile. Les pointes en fer rouillées sont à commander séparément.');
INSERT INTO "item_descriptions" VALUES(9175,'fr','En serrant suffisamment fort cette ceinture, on peut réussir à bloquer entièrement l''appareil digestif de son propriétaire. Il ne reste ensuite plus qu''à trouver une utilité à cet acte profondément débile.');
INSERT INTO "item_descriptions" VALUES(9176,'fr','Lorsque le Bworker commença à étriper lentement Francisque Kabroule, ce dernier se mit à chanter : "Et ça continue encore et encore, c''est que le début d''accord, d''accord...". Depuis, le Bworker est devenu sourd.');
INSERT INTO "item_descriptions" VALUES(9177,'fr','Les trois pointes de ce bracelet représentent les trois faiblesses du Bworker : sa soif de vengeance, sa soif de victoire, et sa soif tout court.');
INSERT INTO "item_descriptions" VALUES(9178,'fr','Cet anneau est recouvert des mucosités du Bworker. Les petites pointes lui permettent de se curer le nez avec plus d''efficacité.');
INSERT INTO "item_descriptions" VALUES(9179,'fr','Un jour, le Captain Chafer rencontra le Bworker, il prit l''initiative de lui dire : "ton postérieur, ta tête, quelle différence ?". Depuis ce jour, personne n''a revu le Captain Chafer. Même son célèbre slip moulant en cuir semble avoir disparu.');
INSERT INTO "item_descriptions" VALUES(9180,'fr','On raconte que le Bworker s''est cousu cette cape avec la peau des fesses de Rushu. Cette histoire aurait pu être crédible si le Bworker savait coudre.');
INSERT INTO "item_descriptions" VALUES(9181,'fr','Ce magnifique casque renferme bien des secrets, pendant de longues années, lorsqu''il était le seul compagnon du Bworker, et lorsqu''il était encore vivant, le Bworker lui aurait confié toutes ses histoires de protections usagées. A force d''entendre ces atrocités, le casque a fini par mourir.');
INSERT INTO "item_descriptions" VALUES(9182,'fr','Il y a bien longtemps, Danous Kouaide a voulu faire le malin et battre le Bworker dans un concours de blagues : "Si tes bottes sont recouvertes de boucles d''oreilles c''est parce que tu n''as pas compris que les bottes ne se mettaient pas aux oreilles". Le Bworker lui a répondu avec un coup de hache sur le crâne.');
INSERT INTO "item_descriptions" VALUES(9183,'fr','Les deux clous de la ceinture se plantaient directement dans les poignées d''amour du Bworker. Lorsqu''il se trémoussait en faisant la danse du ventre pour distraire ses ennemis, on pouvait parfois apercevoir les coutures de ses sous-vêtements en peau de Kilibriss. L''érotisme exacerbé du Bworker a fait vaciller plus d''un ennemi. Sa lame s''est contentée de les achever.');
INSERT INTO "item_descriptions" VALUES(9186,'fr','On ne connait que peu de chose sur Flash Gorgone, hormis sa passion pour les vases en porcelaine. Une légende raconte que ce héros courait tellement vite que même les Tofus ne parvenaient pas à le rattraper. Malheureusement, à force d''être tout le temps pressé, il arriva un jour où il attacha mal sa ceinture... et s''empêtra les pieds dedans. Sa collection de porcelaine s''en souvient encore...');
INSERT INTO "item_descriptions" VALUES(9192,'fr','Lorsque vous aurez équipé cette ceinture, vous vous apercevrez rapidement que vos hanches n''auront jamais été aussi alléchantes.');
INSERT INTO "item_descriptions" VALUES(9193,'fr','Si vous avez toujours rêvé de distribuer des tartes à vos amis, offrez-leur cette amulette.');
INSERT INTO "item_descriptions" VALUES(9198,'fr','Lorsque votre eau ou votre bière n''a plus de goût, trempez-y cet anneau.');
INSERT INTO "item_descriptions" VALUES(9199,'fr','Voilà ce qui arrive lorsque l''on essaye de casser des tasses à coups de bottes.');
INSERT INTO "item_descriptions" VALUES(9366,'fr','Ce tutu rose sera parfait pour la représentation de fin d''année de votre petite dernière. Fabriqué en coton ancestral et en mousse de Mob l''éponge extensible, doux et confortable avec une jupe en froufrou, ce tutu sera peut-être le premier d''une future danseuse étoile.');
INSERT INTO "item_descriptions" VALUES(9394,'fr','Cette coiffe stylée donne la Mitcho classe à n''importe qui, ainsi qu''une odeur de sous-bois dont vos amis se passeraient bien.');
INSERT INTO "item_descriptions" VALUES(9395,'fr','Ce couvre-chef a été porté par Kuri en personne pendant plusieurs années, jusqu''à ce qu''elle décide d''arrêter de porter des coiffes démodées.');
INSERT INTO "item_descriptions" VALUES(9396,'fr','En ancien langage Lenald, il se nomme « Zewouan Ling », ce qui signifie le sceau maudit des Zewouan.');
INSERT INTO "item_descriptions" VALUES(9402,'fr','Les petites ailes accrochées à ces pantoufles permettent d''aérer les pieds malodorants. Attention, il est déconseillé d''utiliser ces pantoufles pour jouer au Boufball, le Bouftou pourrait ne pas apprécier de se faire piquer les fesses.');
INSERT INTO "item_descriptions" VALUES(9408,'fr','Avec cet anneau, votre doigt fera de vous un véritable petit Porkass, ce qui ne devrait pas déplaire à vos amis les plus proches.');
INSERT INTO "item_descriptions" VALUES(9409,'fr','Votre petite queue en tire-bouchon fera plus d''un jaloux parmi votre entourage.');
INSERT INTO "item_descriptions" VALUES(9412,'fr','La fronde accrochée à cette ceinture est très bien accrochée. Tellement bien accrochée que vous ne pourrez pas la décrocher. Elle ne sert qu''à impressionner les petits bandits de grand chemin que vous croiserez.');
INSERT INTO "item_descriptions" VALUES(9413,'fr','Les éperons accrochés à ces bottes, permettent de lacérer le cuir de votre Dragodinde, pour pouvoir la dépecer plus rapidement lorsque vous aurez décidé de la manger.');
INSERT INTO "item_descriptions" VALUES(9416,'fr','Si votre eau n''a plus assez de goût, trempez-votre doigt avec cet anneau dans votre verre, agitez-le frénétiquement jusqu''à ce qu''il se décroche. Et voilà vous avez un délicieux cocktail à l''orange sanguine et au citron, ainsi qu''un doigt en moins. On ne peut pas tout avoir.');
INSERT INTO "item_descriptions" VALUES(9452,'fr','Avec cet anneau, votre doigt n''aura jamais été aussi éclatant.');
INSERT INTO "item_descriptions" VALUES(9453,'fr','Avec cette ceinture autour des hanches, plus personne n''osera vous les pincer de peur de se trancher les doigts.');
INSERT INTO "item_descriptions" VALUES(9454,'fr','Cette amulette pourra servir de bavoir pour les plus jeunes et les plus vieux.');
INSERT INTO "item_descriptions" VALUES(9455,'fr','Cet anneau peut être porté à un orteil si vous avez de mauvaises odeurs de pieds à cacher.');
INSERT INTO "item_descriptions" VALUES(9461,'fr','On dit que le Kimbo porte cette perruque en hommage à un bel éphèbe bronzé rencontré un jour sur son île, dont il appréciait le sourire aéré. Il la cache néanmoins sous sa coco parce qu''il la trouve quand même ridicule.');
INSERT INTO "item_descriptions" VALUES(9463,'fr','Ce bijou dégage une telle puissance qu''elle tuerait un Moskito à 30 pas, si son odeur n''empêchait pas ce dernier d''approcher à moins d''un kilokamètre.');
INSERT INTO "item_descriptions" VALUES(9464,'fr','Cette effrayante amulette est longtemps restée cachée dans un manoir perdu. Autrefois vivante, elle voulait conquérir le monde. Finalement elle n''aura que votre cou. La pauvre.');
INSERT INTO "item_descriptions" VALUES(9468,'fr','Cette pelle est dangereuse, elle volera votre vitalité, votre jeunesse, l''eau de votre corps et vos précieux gâtrools.');
INSERT INTO "item_descriptions" VALUES(9469,'fr','Fabriquée à partir de fragments de mycoses, cette épée parasitera à merveille les intestins de vos ennemis.');
INSERT INTO "item_descriptions" VALUES(9542,'fr','Ces souliers brillent de mille feux, même lorsqu''ils sont complètement usés. Très efficace pour éblouir vos adversaires lorsqu''ils les recevront en pleine tête.');
INSERT INTO "item_descriptions" VALUES(9543,'fr','Cette lourde bague permet de donner un peu plus d''inertie à vos gifles, et un peu plus de piquant à vos caresses.');
INSERT INTO "item_descriptions" VALUES(9549,'fr','Le slogan du couturier à l''origine de cette merveille était : "Même dans le feu de l''action, ce caleçon restera solidement accroché à votre postérieur, grâce à ses bretelles en lin d''une qualité supérieure". Avant d''être couturier, il était mauvais poète.');
INSERT INTO "item_descriptions" VALUES(9575,'fr','Cette ceinture peut se porter dans les deux sens, suivant ce que vous désirez cacher ou montrer...');
INSERT INTO "item_descriptions" VALUES(9576,'fr','Ces bottines en peau de fesse de Black Wabbit, vous permettront de prendre une bonne revanche sur ces terribles créatures, en ayant l''impression de leur botter le derrière à chaque fois que vous taperez dans quelque chose. La vie est parfois faîte de plaisirs simples.');
INSERT INTO "item_descriptions" VALUES(9594,'fr','Ce bouloute a l''air tout à fait normal... Pourtant on dirait que sa laine vire au noir par endroits... Laissez-lui un peu de temps et vous pourriez bien avoir une surprise !');
INSERT INTO "item_descriptions" VALUES(9617,'fr','Cette boule de poils est mieux protégée contre le froid que le Chacha classique, elle est plus douce, mais il paraît que son caractère est encore plus insupportable.');
INSERT INTO "item_descriptions" VALUES(9619,'fr','Cette créature est un peu stupide, la seule façon de la faire avancer est de lui accrocher dans le dos un bâton soutenant une Cawotte. Heureusement, ce familier a été correctement dressé, et ne tentera pas d''envoyer des vents de panique.');
INSERT INTO "item_descriptions" VALUES(9620,'fr','Cette créature est un Minimino élevé par le Minotot en personne. Il lui a malheureusement transmis son caractère, ainsi qu''une partie de ses odeurs corporelles à force de le cajoler sous ses aisselles.');
INSERT INTO "item_descriptions" VALUES(9623,'fr','Ne vous méprenez pas, les dents pointues de cette créature finiront un jour ou l''autre par se planter dans votre postérieur.');
INSERT INTO "item_descriptions" VALUES(9624,'fr','Prenez une Dragoune Rose, teignez-la en noir, saupoudrez-la de poussière d''or, trempez-la dans l''huile, trempez-la dans l''eau, et vous aurez une Dragoune Noire.');
INSERT INTO "item_descriptions" VALUES(9627,'fr','Ce bâton permet à certaines personnes désignées par les dieux de se faire connaître afin d''aider leur prochain. Quelle noble quête que voilà !');
INSERT INTO "item_descriptions" VALUES(9655,'fr','La semelle de ces sandales est renforcée afin de supporter le poids des Papayous les plus lourds.');
INSERT INTO "item_descriptions" VALUES(9656,'fr','Les roulettes présentes sur ces bottes permettent de descendre les escaliers sans efforts tout en augmentant considérablement vos chances de vous casser quelques os. À vous de choisir.');
INSERT INTO "item_descriptions" VALUES(9658,'fr','Cette amulette n''est en réalité qu''un assortiment de fleurs accrochées autour d''un fil. Elle est censée diffuser un parfum magique à même de transformer un Papayou en Papayou Lélé.');
INSERT INTO "item_descriptions" VALUES(9659,'fr','Erala a porté cette amulette pendant toute son enfance. Personne ne sait exactement ce qu''elle renferme.');
INSERT INTO "item_descriptions" VALUES(9662,'fr','Certains aventuriers s''amusent à collectionner ce type d''anneau pour des raisons encore inconnues.');
INSERT INTO "item_descriptions" VALUES(9667,'fr','Ces bottes permettaient à l''illustre Slait de courir sans rayer les parquets avec ses griffes.');
INSERT INTO "item_descriptions" VALUES(9785,'fr','Ce démon mineur à peine sorti de la Shukrute vous accompagnera durant toutes vos pérégrinations, du zaap d''Astrub au cimetière, voire même du cimetière au zaap d''Astrub. Comme tous ses semblables, et comme vous, il n''a qu''une seule obsession : détruire, jusqu''à ce qu''il ne reste plus rien.');
INSERT INTO "item_descriptions" VALUES(9919,'fr','Prendre l''apparence d''un hibou.');
INSERT INTO "item_descriptions" VALUES(9921,'fr','Ce bracelet est censé briller, mais uniquement la nuit et dans les tavernes.');
INSERT INTO "item_descriptions" VALUES(9922,'fr','Cette ceinture est dotée d''un mécanisme magnétique incroyablement puissant qui lui permet de rester fermée sans utiliser la moindre boucle. Attention, il est déconseillé de l''utiliser en même temps qu''un slip de plomb.');
INSERT INTO "item_descriptions" VALUES(9923,'fr','Si vous êtes bien musclé, et que vous voulez danser comme un robot, ces chaussures sont faîtes pour vous. Attention, les lacets sont en option.');
INSERT INTO "item_descriptions" VALUES(9925,'fr','Cet anneau est plus proche du gant ou de la moufle que de l''alliance mais qu''importe, plus personne ne vous serrera la main comme avant.');
INSERT INTO "item_descriptions" VALUES(9927,'fr','Olcar portait ces bottes lorsqu''il aperçut du haut du mont Jifu d''étranges objets non identifiés traversant le ciel.');
INSERT INTO "item_descriptions" VALUES(9928,'fr','Il vous faudra environ 12 heures pour nouer les lacets de ces bottes et 16 heures pour les dénouer. Si vous décidez de les enlever une fois par jour, vous prendrez donc du retard tous les jours, à moins de prendre de l''avance dès aujourd''hui pour les jours suivants.');
INSERT INTO "item_descriptions" VALUES(9929,'fr','Chez certains combattants, le talon d''Achille se situe au niveau du nombril. Avec cette ceinture autour des hanches, vos amis vous trouveront deux fois plus lourd, mais vous serez mieux protégé.');
INSERT INTO "item_descriptions" VALUES(9942,'fr','La construction de cet anneau, aussi connu sous le nom "Anneau noir", ne semble pas encore achevée. Mais qu''importe, sa puissance est suffisante pour détruire une lune.');
INSERT INTO "item_descriptions" VALUES(9943,'fr','Ces magnifiques chaussures sont recouvertes d''un vernis à base de... Personne ne sait réellement, mais tant qu''elles brillent tout le monde s''en moque.');
INSERT INTO "item_descriptions" VALUES(9944,'fr','À la fois amulette et cravate, cet objet d''apparat permettra à vos proches de vous tenir en laisse facilement. Et vous aimerez ça.');
INSERT INTO "item_descriptions" VALUES(9961,'fr','Ce marteau de piètre qualité a été conçu pour leurrer les forgerons, en leur faisant croire qu''ils avaient entre leurs mains un marteau d''excellente qualité. Il est fortement déconseillé de s''en servir, même pour ne rien faire.');
INSERT INTO "item_descriptions" VALUES(9972,'fr','Ce marteau destiné à la forge a été conçu pour un usage précis, ce qui rend son utilisation difficile pour autre chose. Seule une personne désespérée ou marginale s''en servirait pour forger des armes.');
INSERT INTO "item_descriptions" VALUES(9974,'fr','Si vous utilisez cette tailladeuse en combat, vous vous battrez comme un manche. Par contre, si vous vous en servez pour sculpter des manches, les tailleurs se retrouveront sur la paille, ce qui rendra les paysans mécontents.');
INSERT INTO "item_descriptions" VALUES(10054,'fr','Cet anneau a trempé pendant trois ans dans de la fiente de chauve-souris. Mais il est magique.');
INSERT INTO "item_descriptions" VALUES(10055,'fr','Cette amulette est censée prévenir les Vampyres qui voudraient vous mordre dans le cou, qu''il est tout simplement inutile d''essayer de vous sucer le sang, puisque vous êtes vous-même un Vampyre.');
INSERT INTO "item_descriptions" VALUES(10056,'fr','Sur le slogan publicitaire de cette ceinture vous pouvez lire "Et en plus elle brille la nuit !". Oui mais en plus de quoi ?');
INSERT INTO "item_descriptions" VALUES(10058,'fr','Bram avait raison, il faut toujours se méfier des personnes aux dents longues, surtout lorsqu''elles portent la cape du Vampyre.');
INSERT INTO "item_descriptions" VALUES(10061,'fr','On raconte qu''Elizabeth Bythora en personne a porté ces bottes. Ça vous fait une belle jambe.');
INSERT INTO "item_descriptions" VALUES(10102,'fr','Ce masque vous protégera des rayons du soleil à défaut d''autre chose.');
INSERT INTO "item_descriptions" VALUES(10106,'fr','Cette créature au teint blafard prendra un malin plaisir à sucer le sang de vos amis, ou celui de vos chevilles si elles sont un peu trop grosses. Mais ce qu''elle aime par-dessus tout, son péché mignon, c''est que vous affrontiez d''horribles monstres pour les saigner à blanc. Vous allez donc devoir passer votre temps à vous battre... Pauvre de vous, c''est vraiment terrible.');
INSERT INTO "item_descriptions" VALUES(10107,'fr','Ce familier a eu une enfance très difficile : il a hérité d''un nom franchement stupide. C''est peut-être ce qui explique ses coups de chaud et son humeur quelque peu volatile... Constatant que vous aviez les mêmes problèmes que lui, il s''est pris d''affection pour vous. Depuis, il ne vous lâche plus, bien décidé à hanter le Monde des Douze en votre compagnie.');
INSERT INTO "item_descriptions" VALUES(10155,'fr','Cette amulette est censée vous protéger des décapitations aléatoires, et des oblitérations épilatoires.');
INSERT INTO "item_descriptions" VALUES(10156,'fr','Ces pantoufles sont plus confortables que des pantoufles ordinaires, mais vous ne saurez jamais exactement pourquoi. Peut-être que les milliers d''acariens masseurs qui y vivent y sont pour quelque chose.');
INSERT INTO "item_descriptions" VALUES(10157,'fr','Cette ceinture a été fabriquée à partir de chutes de ficelles de lin. Elle doit pouvoir servir à fermer les sacs poubelles.');
INSERT INTO "item_descriptions" VALUES(10158,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10159,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10160,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10161,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10162,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10163,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10164,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10165,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10166,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10167,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10168,'fr','Ponch cirait ses bottes tous les matins avant de partir en mission sur sa Dragodinde pour sauver la veuve et l''orphelin, mais surtout la veuve... Un sacré charmeur ce Ponch.');
INSERT INTO "item_descriptions" VALUES(10171,'fr','Ces mitaines en cuir sont parfaites pour donner des fessées déculottées.');
INSERT INTO "item_descriptions" VALUES(10172,'fr','Cette amulette peut nourrir une limace vorpale pendant deux jours, ou trois jours si elle l''accompagne d''une purée de votre tête.');
INSERT INTO "item_descriptions" VALUES(10173,'fr','La semelle de ces bottes est recouverte d''une bave collante et l''intérieur est rempli d''une bave glissante. À moins que ça ne soit l''inverse.');
INSERT INTO "item_descriptions" VALUES(10180,'fr','Ce médaillon est censé servir de clé pour accéder à une mystérieuse cité oubliée.');
INSERT INTO "item_descriptions" VALUES(10181,'fr','Cet anneau a été retrouvé dans une mystérieuse cité dont personne ne soupçonnait réellement l''existence jusqu''à ce que l''on commence à soupçonner son existence.');
INSERT INTO "item_descriptions" VALUES(10186,'fr','Cette amulette en dents de sanglier effraiera les sangliers et par extension votre belle-mère.');
INSERT INTO "item_descriptions" VALUES(10189,'fr','Cet anneau appartenait à un sabotier connu sous le surnom de "Le Glaude", dont il avait hérité après avoir fait un long voyage en trottant. Ses proches l''avaient surnommé "Le Glaude trotteur".');
INSERT INTO "item_descriptions" VALUES(10190,'fr','Si vous décidez de planter des choux, à la mode de chez nous, pensez à équiper ces bottines conçues pour ne pas écraser les choux. N''essayez pas de les utiliser pour danser avec votre partenaire, elles ne permettent pas d''éviter les écrasements de pieds.');
INSERT INTO "item_descriptions" VALUES(10191,'fr','Cette ceinture permet de contenir vos ballonnements après une indigestion de soupe aux choux.');
INSERT INTO "item_descriptions" VALUES(10223,'fr','Cette pelle est principalement destinée à un usage médical, malgré l''utilisation très controversée qu''en fait l''Enutrof Resat en tant qu''arme d''autodéfense.');
INSERT INTO "item_descriptions" VALUES(10438,'fr','Ces bottes ont appartenu à l''inoubliable Maidarte, un génie incompris, qui s''était spécialisé dans les boucles infinies et la récursivité. Personne ne comprenait réellement ce qu''il expliquait ni pourquoi il répétait continuellement les mêmes histoires. Tel le ressac des vagues qui se heurtent aux rochers, ses diatribes ont fini par faire partie du paysage en se heurtant éternellement à l''obstacle du bon sens.');
INSERT INTO "item_descriptions" VALUES(10544,'fr','Dressée par son ancien maître pour ne manger que les monstres vivant près du lac de Cania, cette créature venue d''ailleurs a fini par diversifier son régime alimentaire. Néanmoins, elle a toujours une haleine de blop.');
INSERT INTO "item_descriptions" VALUES(10557,'fr','Ce gantelet marqué par les années facilite la prise en main de ballon ou toute autre bestiole ronde recouverte de laine. Ce que vous en faites après ne regarde que vous.');
INSERT INTO "item_descriptions" VALUES(10558,'fr','Ce gantelet permettra au jeune Chienchien fou que vous êtes de jouer à la baballe comme un grand boufbowler.');
INSERT INTO "item_descriptions" VALUES(10559,'fr','Initialement conçue pour absorber les chocs lors de matches de boufbowl musclés, cette ceinture pourra aussi vous servir de bouée si d''aventure vous souhaitez prendre un bain. Quelle drôle d''idée.');
INSERT INTO "item_descriptions" VALUES(10560,'fr','Cette ceinture montre à quel point le boufbowl n''est pas un sport de fillette, d''où les protections judicieusement placées sous la ceinture pour éviter tout coup bas un peu trop bas. Idéal pour assurer l''entraînement de petits Srams.');
INSERT INTO "item_descriptions" VALUES(10561,'fr','Ces bottes ont vécu, et ça se sent. Avec elles, vous pourrez vous faire passer pour un grand boufbowler, et planter vos crampons dans le postérieur de quelques bouftous devant vos fans.');
INSERT INTO "item_descriptions" VALUES(10562,'fr','Ces bottes dans l''air du temps feront fureur auprès de tous les jeunes aventuriers fascinés par le boufbowl. Elles facilitent les chutes pour pouvoir plus facilement faire semblant d''avoir été poussé par un adversaire. Idéal pour apprendre les rudiments du sport.');
INSERT INTO "item_descriptions" VALUES(10623,'fr','Grüt le Bwork n''était pas très malin. Il était même complètement stupide. Pendant des années, sa compagne a essayé de remplir le crâne de son chéri avec autre chose que de la bière, mais c''était peine perdue. Grüt est juste resté aussi bête, mais sans mousse.');
INSERT INTO "item_descriptions" VALUES(10624,'fr','Ceux qui ont eu à affronter Grüt le Bwork vous le diront, "ne visez pas la tête, elle est vide". Ce conseil est valable pour tous ceux qui affrontent les Iops, les gobelins ou les belles-mères.');
INSERT INTO "item_descriptions" VALUES(10625,'fr','Les bottes de Grüt dégagent une odeur tellement répugnante, qu''elles peuvent étouffer vos adversaires d''un simple coup de pied à la tête. Ces bottes ont été interdites en combat par la convention de Sufokia il y a très longtemps. Personne ne reviendra sur cette décision qui a permis d''éviter de nombreuses morts atroces.');
INSERT INTO "item_descriptions" VALUES(10627,'fr','Kocksis avait de nombreux plaisirs plutôt malsains, comme manger des chips au vinaigre avec de la pâte à tartiner ou pire encore, manger des poils de chacha. Nombreux sont ceux qui ont tenté de le ramener dans le droit chemin et se sont perdus sur le chemin du retour.');
INSERT INTO "item_descriptions" VALUES(10628,'fr','Rien de plus bruyant que le claquement des os sur un cercueil en orme. Grâce à ces bottes d''échauffement, Kocksis le Chafer pouvait répéter et danser l''Ankarmagniole toute la nuit sans craindre de réveiller les voisins, les morts, ni même les voisins morts.');
INSERT INTO "item_descriptions" VALUES(10629,'fr','Kocksis avait deux rêves : gravir la montagne des Craqueleurs et devenir ménestrel. La vie fut très cruelle avec lui, puisqu''il dut se contenter de faire les premières parties des concerts de Francisque Kabroule avant de mourir. Parfois, le sort s''acharne sur vous. Sur Kocksis, il s''est plutôt décharné.');
INSERT INTO "item_descriptions" VALUES(10631,'fr','Voici une des devises les plus populaires chez le peuple mauve : « Parfoâ, c''est toâ qui kognes le bar et parfoâ, c''est le bar qui te kogne. »');
INSERT INTO "item_descriptions" VALUES(10632,'fr','Gobeuf le gobelin adorait gober les œufs en état de putréfaction avancée. Si son appareil digestif supportait sans problème cette fâcheuse habitude, les gens situés à proximité de son haleine putride tombaient comme des moomouches. Cette ceinture permettait à tous ses proches de se rattraper avant de s''écrouler lamentablement au sol.');
INSERT INTO "item_descriptions" VALUES(10633,'fr','Gobeuf était passionné par le jardinage, surtout lorsqu''il s''agissait de donner des coups de râteau sur les imprudents qui s''approchaient de ses terres. Il a trouvé cet anneau en ratissant le doigt d''un imprudent qui avait marché sur un de ses pieds de salace.');
INSERT INTO "item_descriptions" VALUES(10635,'fr','Lorsque les deux petites boules accrochées à cette amulette s''entrechoquent, elles produisent un léger bruit de claquement qui vous permet d''être informé de l''arrivée d''un Kanniboul. Lorsque vous entendez ce bruit, il est généralement trop tard pour vous enfuir, mais il est encore temps de choisir à quelle sauce vous voulez être dévoré.');
INSERT INTO "item_descriptions" VALUES(10636,'fr','Cet anneau diffuse des épices afin d''aromatiser facilement le bouillon lorsqu''il est mélangé avec les mains. Ces épices sont si bonnes, qu''une fois cet anneau équipé, vous risquez de vous en mordre les doigts.');
INSERT INTO "item_descriptions" VALUES(10637,'fr','Le Kanniboul Laikteur a utilisé ces bottes pendant plusieurs années avant de les échanger contre un touriste de l''île de Moon. La faim justifie les moyens.');
INSERT INTO "item_descriptions" VALUES(10639,'fr','Rekto avait un frère, appelé Verso Litaire. Il aimait voyager seul et explorer les tunnels sombres qui ne sentent pas très bon.');
INSERT INTO "item_descriptions" VALUES(10640,'fr','Cette ceinture est censée être réversible mais personne n''a jamais osé utiliser l''autre face de peur de découvrir qu''elle n''est en fait pas réversible.');
INSERT INTO "item_descriptions" VALUES(10641,'fr','Rekto Topi a confectionné ces bottes lui-même, à partir de morceaux de bois et d''un peu de tissu. Elles ne ressemblent pas du tout à des bottes, mais qu''importe elles sont magiques tout de même.');
INSERT INTO "item_descriptions" VALUES(10643,'fr','Cet anneau change de couleur lorsqu''il est trempé dans du jus de Chmoule bouillant. C''est sûrement ce qui explique pourquoi Grizou le Mineur Sombre tenait autant à cet anneau.');
INSERT INTO "item_descriptions" VALUES(10644,'fr','La semelle magique de ces bottes permet de casser les blocs de charbon en envoyant les vibrations nécessaires à leur fragmentation. La notice indique qu''elles sont même capables de vibrer toutes seules dès qu''un son de Bouftonik est joué à proximité.');
INSERT INTO "item_descriptions" VALUES(10645,'fr','Cette ceinture renforcée à l''aide de nombreux métaux était assez solide pour supporter le poids des énormes bourses de Grizou le Mineur Sombre. Elle devrait convenir pour les bourses plus légères.');
INSERT INTO "item_descriptions" VALUES(10657,'fr','Cet étrange familier est issu du croisement des meilleurs chercheurs de truffes de tout Amakna. Son énorme groin lui permet de repérer l''Ogrine, même lorsqu''elle est cachée sous l''eau. Otomaï aurait mis plusieurs années à obtenir cette espèce, et l''on raconte qu''il l''utiliserait pour tenter de retrouver quelque chose qu''il aurait égaré, ou une créature qu''il aurait laissé s''enfuir. Lui seul connaît le fin mot de l''histoire...');
INSERT INTO "item_descriptions" VALUES(10685,'fr','Équipée de ce casque en or, votre tête sera rapidement mise à prix et vaudra son pesant d''or.');
INSERT INTO "item_descriptions" VALUES(10686,'fr','Cette cape en tissu, recouverte d''une fine couche d''or est magique. Elle attire les regards et renvoie la lumière directement dans les pupilles des fourbes qui tenteraient de vous poignarder par derrière. Indispensable si vous avez des amis Srams.');
INSERT INTO "item_descriptions" VALUES(10687,'fr','Cet anneau est si lourd qu''il augmente considérablement l''inertie de votre poing quand vous distribuez des claques à vos adversaires. Lorsque vous aurez commencé à punir les manants, il vous sera quasiment impossible de vous arrêter.');
INSERT INTO "item_descriptions" VALUES(10688,'fr','Cette ceinture est parfaite pour accrocher vos lingots d''or autour de votre taille, ils passeront inaperçus.');
INSERT INTO "item_descriptions" VALUES(10784,'fr','Personne ne sait exactement ce que vous apporte cette amulette, mais tout le monde sait ce qu''elle vous retire : votre crédibilité.');
INSERT INTO "item_descriptions" VALUES(10785,'fr','Cet anneau protégera vos doigts des crottes de nez de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(10794,'fr','Chaudes à l''intérieur et froides à l''extérieur, ces bottes vous permettront de botter les fesses des bonshommes de neige sans leur faire fondre le postérieur.');
INSERT INTO "item_descriptions" VALUES(10797,'fr','Sortie de son fourreau, cette épée peut couper le jambon, les Enutrofs, les unijambistes, les danseurs et les Enutrofs unijambistes enroulés dans une tranche de jambon qui dansent un soir de pleine lune. En revanche pour trancher les monstres, elle est plutôt inefficace.');
INSERT INTO "item_descriptions" VALUES(10798,'fr','Ce bouclier ne vous protégera pas de votre bêtise.');
INSERT INTO "item_descriptions" VALUES(10799,'fr','Vous n''arriviez pas à cacher votre épée ? Pas de problème, vous pourrez la coincer entre vos poignées d''amour et cette ceinture.');
INSERT INTO "item_descriptions" VALUES(10800,'fr','Cette cape permet de voler, il suffit de fermer les yeux, serrer les poings, ouvrir la bouche et sauter d''une falaise en écartant les bras tout en criant "je vole". Quelques instants plus tard, vous vous réveillerez avec deux jambes cassées.');
INSERT INTO "item_descriptions" VALUES(10801,'fr','Ce chapeau cache admirablement votre calvitie. Malheureusement, il n''en n''existe pas d''assez grand pour cacher votre fausse modestie.');
INSERT INTO "item_descriptions" VALUES(10802,'fr','Plus dorée que la Dragoune Noire, moins rose que la Dragoune Rose, et plus rare que la Dragoune Squelette, ce familier attirera tous les regards sur vous, même si vous êtes laid comme un Piou.');
INSERT INTO "item_descriptions" VALUES(10818,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(10828,'fr','Il est dit que le ridicule ne tue pas. C''est exact, mais avec ce casque vous aurez vraiment l''air ridicule.');
INSERT INTO "item_descriptions" VALUES(10829,'fr','Grâce à ce bâton les négociations pécuniaires tourneront à votre avantage.');
INSERT INTO "item_descriptions" VALUES(10830,'fr','Ikko, un célèbre artiste d''Amakna fut le premier à oser porter cette cape. Tout le monde lui répétait pourtant : "Quand c''est trop, c''est trop Ikko".');
INSERT INTO "item_descriptions" VALUES(10834,'fr','Il faut peu de choses pour que vous ressembliez à un Ouginak. Attention aux puces.');
INSERT INTO "item_descriptions" VALUES(10836,'fr','Vous portez fièrement cette amulette, symbole de votre participation à cette grande manifestation sportive. Il faut ça pour rester fier après être passé sous la mêlée du B.C Trool.');
INSERT INTO "item_descriptions" VALUES(10846,'fr','Pris d''une étrange frénésie, les tofus que vous croisez veulent se frotter contre votre jambe. Ce n''est tout de même pas cette cape qui les attire ?');
INSERT INTO "item_descriptions" VALUES(10847,'fr','Hulkrap enfilait ces bottes une fois par an, mais il les enlevait tous les jours. On peut donc en déduire que ces bottes sont magiques.');
INSERT INTO "item_descriptions" VALUES(10848,'fr','Ces bottes coquées peuvent servir d''enclumes. Son ancien propriétaire vous conseille vivement de ne pas danser avec.');
INSERT INTO "item_descriptions" VALUES(10849,'fr','Cette ceinture est fabriquée autour d''une armature métallique aimantée qui attire les bourses des imprudents qui oseraient se frotter à vous.');
INSERT INTO "item_descriptions" VALUES(10850,'fr','Klüme avait trois faiblesses, les araknes, les chatouilles et les araknes chatouilleuses.');
INSERT INTO "item_descriptions" VALUES(10851,'fr','Cette ceinture est encore recouverte de farine. Peut-être parce qu''elle servait de tablier à Kloug le Boulanger Sombre. À moins que ce ne soit la farine qu''il utilisait pour se poudrer le postérieur.');
INSERT INTO "item_descriptions" VALUES(10852,'fr','Hulkrap a jadis volé cette amulette à Gonztipay, un gobelin dénué de toute forme d''humour, même le plus lourd.');
INSERT INTO "item_descriptions" VALUES(10853,'fr','Cette amulette vous permet de pétrir la peau de votre cou sans utiliser vos mains.');
INSERT INTO "item_descriptions" VALUES(10854,'fr','Gontran Klüme le forgeron a échangé cet anneau contre une épée qui appartenait à la Dame Antium.');
INSERT INTO "item_descriptions" VALUES(10855,'fr','Cet anneau a été trempé dans une multitude de levures différentes. On raconte qu''il est capable de transformer en moisissure ceux qui le portent. Certains aventuriers ne perçoivent aucune différence après l''avoir porté.');
INSERT INTO "item_descriptions" VALUES(10863,'fr','Cette Arakne est vraiment très mal élevée, elle saute partout, elle crie, elle mord n''importe qui, mais vous l''aimez beaucoup sans savoir pourquoi.');
INSERT INTO "item_descriptions" VALUES(10864,'fr','Ce Champ Champ pas comme les autres a été élevé par une meute de Mulous. Ça n''explique pas pourquoi il a du poil sous les aisselles.');
INSERT INTO "item_descriptions" VALUES(10865,'fr','Ce Tofu a reçu la foudre 11 fois durant sa croissance. Vous recevrez des décharges électriques si vous le caressez et il vous foudroiera si vous ne le caressez pas. Pour une fois vous avez le choix.');
INSERT INTO "item_descriptions" VALUES(10866,'fr','Ce familier aime les cœurs d''artichauts au sang de Rasboul, les endives aux poils de Bitouf, et les chansons de Francisque Kabroule. Il semble également apprécier votre compagnie.');
INSERT INTO "item_descriptions" VALUES(10907,'fr','Vous y étiez, vous l''avez fait : participer au plus grand contrôle de natalité draconique. Conséquence de quoi vous avez dû manger des omelettes pendant des semaines.');
INSERT INTO "item_descriptions" VALUES(10955,'fr','Quoi de plus normal pour un volatile que d''être bagué !');
INSERT INTO "item_descriptions" VALUES(10956,'fr','Cette paire de bottes, comme tout le reste de la panoplie du Corbeau Noir, est passée de pied en pied à travers les âges. Ce qui explique sa forte odeur de Clakoss...');
INSERT INTO "item_descriptions" VALUES(10963,'fr','La semelle de ces bottes est spongieuse, elle permet d''absorber la boue des égouts et de la diffuser à chaque pas. Vous pourrez ainsi facilement revenir sur vos pas.');
INSERT INTO "item_descriptions" VALUES(10964,'fr','Cette ceinture permettait à Rapine d''y accrocher son butin. On peut apercevoir sur la face intérieure une petite valve qui permet de la gonfler et de la transformer en bouée. Indispensable pour toutes les sorties dans les égouts.');
INSERT INTO "item_descriptions" VALUES(10965,'fr','Cette amulette a été spécialement conçue pour ne pas se coincer dans les poils du cou de Rapine. Vous pourrez donc la porter sans crainte sur vos aisselles ou même la garder dans votre main.');
INSERT INTO "item_descriptions" VALUES(10971,'fr','Équipé de ce sac, vous pourrez faire les quatre cents coups. Et toujours avec le sourire, petit galopin va !');
INSERT INTO "item_descriptions" VALUES(10976,'fr','Les champignons portent généralement des collerettes. Phong Huss préférait les anneaux. Peut-être parce qu''il voulait se vanter d''avoir des doigts.');
INSERT INTO "item_descriptions" VALUES(10977,'fr','Phong Huss essayait de porter cette ceinture en bandoulière afin d''y coincer l''étui de son sabre. Elle lui pinça les tétons à de multiples reprises, mais c''est le prix à payer pour dégainer avec une certaine classe.');
INSERT INTO "item_descriptions" VALUES(10978,'fr','Les pieds des champignons sont rarement très propres, ils sont souvent recouverts de mycélium. Ceux de Phong Huss n''échappaient pas à cette règle et il prenait soin de les cacher avec ses bottes. Elles ne sentent pas très bon, mais elles sont particulièrement adaptées à la culture des champignons. Qui de votre estomac ou de votre nez l''emportera ?');
INSERT INTO "item_descriptions" VALUES(10980,'fr','L''amulette d''un fantôme ne peut être qu''un objet magique très puissant, vu qu''elle brille dans le noir.');
INSERT INTO "item_descriptions" VALUES(10981,'fr','Les fantômes sont immatériels. Alors comment explique-t-on qu''ils puissent porter des anneaux ? Cela semble complètement irrationnel. Un peu comme vous, en somme.');
INSERT INTO "item_descriptions" VALUES(10982,'fr','Le capitaine Kradoc a jadis rencontré Hectaupe en sortant d''un concours de beuverie à la taverne du Ripate. « Ectoplasme à roulettes » s''exclama-t-il en hurlant. Pauvre capitaine Kradoc, l''alcool lui jouait de mauvais tours, Hectaupe n''a jamais eu de roulettes.');
INSERT INTO "item_descriptions" VALUES(10985,'fr','Ce chacha a connu l''hiver du grand nord, même s''il n''a jamais vu le grand nord. Personne ne sait comment il a pu arriver en Amakna, les anciens prétendent qu''il aurait été importé de l''île de Frigost pour lutter contre la pénurie de glaçons à l''heure de l''apéritif.');
INSERT INTO "item_descriptions" VALUES(10987,'fr','Elle refroidit les hanches, les organes situés à proximité et les ardeurs de tous ceux qui osent la porter. À offrir à vos courtisans un peu trop entêtés.');
INSERT INTO "item_descriptions" VALUES(10990,'fr','Lourdes et rigides, ces bottes ne semblent pas très intéressantes. Mais leur semelle de glace vous permettra de faire du patin à glace sans glace. À condition de trouver une surface recouverte de lames de patins à glace.');
INSERT INTO "item_descriptions" VALUES(11011,'fr','Plus fou que le Tifoux commun mais surtout beaucoup moins roux, ce familier peut être trempé dans l''eau sans qu''il ne soit nécessaire de se boucher le nez.');
INSERT INTO "item_descriptions" VALUES(11012,'fr','Ce n''est pas parce qu''il est tigré qu''il ne cherchera pas à vous renifler le postérieur ou à se soulager sur votre tapis. Mais qu''espériez-vous ?');
INSERT INTO "item_descriptions" VALUES(11013,'fr','Ce vilain petit Kouin-Kouin Noir a été rejeté par sa propre famille car il était différent : il adorait écouter le chant du ménestrel Francisque Kabroule. Peut-être était-il tout simplement incompris...');
INSERT INTO "item_descriptions" VALUES(11014,'fr','Ce familier a dormi trop longtemps sous une pluie acide. Il ne brille pas la nuit, il n''est pas magique, mais si vous en faites de la vinaigrette, elle sera très puissante.');
INSERT INTO "item_descriptions" VALUES(11015,'fr','Cette étrange créature a traversé les océans sur un bloc de glace pour s''échouer sur un port perdu. Elle semble désormais vous prendre pour un bloc de glace.');
INSERT INTO "item_descriptions" VALUES(11042,'fr','Cadeau d''un père pour son fils, cette ceinture fut remise à Goultard pour ses 5 ans. Bien que de simple facture, elle est solide et maintiendra votre pantalon sur vos hanches. Elle peut même servir de corde à linge ou de corde à sauter.');
INSERT INTO "item_descriptions" VALUES(11051,'fr','En trempant cette amulette dans votre verre, votre eau insipide et se transformera en un délicieux breuvage arômatisé aux agrumes.');
INSERT INTO "item_descriptions" VALUES(11052,'fr','La semelle de ces bottes est confectionnée avec la peau rugueuse de fruits récoltés sur une île ensoleillée dont personne ne soupçonne l''existence.');
INSERT INTO "item_descriptions" VALUES(11057,'fr','Cette ceinture est composée d''écailles arrangées en spirale suivant la suite de Vibronacci.');
INSERT INTO "item_descriptions" VALUES(11058,'fr','Mais qui comptez-vous réussir à séduire avec un anneau pareil ?');
INSERT INTO "item_descriptions" VALUES(11080,'fr','Cette paire de bottes souples vous garantira une totale liberté de mouvement. C''est d''ailleurs pour cette raison que Lonne Jenone les porte lorsqu''il danse avec les Mulous.');
INSERT INTO "item_descriptions" VALUES(11082,'fr','Ces bottes ont été spécialement conçues pour détruire les protèges-tibias de vos adversaires, puis leurs tibias et ensuite vos propres orteils.');
INSERT INTO "item_descriptions" VALUES(11083,'fr','Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(11085,'fr','En mettant cette ceinture à l''envers et en la serrant suffisamment fort, vous pourrez peut-être activer le module intégré de rétromagie. Il n''a jamais fonctionné, mais vous pourrez l''activer tout de même. Vous pourrez donc la revendre à une personne aussi naïve que vous.');
INSERT INTO "item_descriptions" VALUES(11087,'fr','Porté par plusieurs générations de Bricoleurs, cet anneau protège une phalange de vos coups de marteau. Malheureusement, il n''est jamais vendu par lot de cinq.');
INSERT INTO "item_descriptions" VALUES(11091,'fr','Grilliane le magicien a échangé un anneau magique contre cette paire de bottes. Il semblerait qu''il ait perdu au change puisqu''elles ne sont même pas rembourrées.');
INSERT INTO "item_descriptions" VALUES(11092,'fr','Grilliane portait cette amulette autour du coup lorsqu''il... Lorsqu''il... Quelle importance ? Il est mort et désormais cette amulette vous appartient.');
INSERT INTO "item_descriptions" VALUES(11104,'fr','Au delà du Tofu, du Bouftou ou encore du Iop, le Kouin-kouin excelle dans la crétinerie.');
INSERT INTO "item_descriptions" VALUES(11306,'fr','Vous pouvez lire gravé sur son pommeau : « Elle vole la vie des pauvres pour la redistribuer aux riches ». Dommage que vous soyez pauvre.');
INSERT INTO "item_descriptions" VALUES(11343,'fr','Rapiat a fabriqué ses bottes lui-même, sans que ça ne lui coûte un Kama. On ne peut pas en dire autant de deux de ses congénères, à qui ça a coûté la vie.');
INSERT INTO "item_descriptions" VALUES(11344,'fr','Au plus grand malheur de sa ceinture, le seul pêché mignon de Rapiat étaient les pains Gre de Danioul Garnioul le Boulanger. Il a d''ailleurs été le seul à continuer à en manger après avoir appris qu''il était pétri avec les pieds, affirmant que c''était ce qui lui donnait ce petit arrière-goût unique.');
INSERT INTO "item_descriptions" VALUES(11345,'fr','Cette magnifique amulette ambrée semble être en réalité faite d''une matière bien moins noble, ce qui explique son odeur nauséabonde ainsi que son petit prix. Mais n''est-ce pas le résultat qui compte ?');
INSERT INTO "item_descriptions" VALUES(11346,'fr','Cet anneau orné d''un os en or permettait à Ougicle de ne plus se ronger les griffes. D''ailleurs il est toujours reluisant de bave.');
INSERT INTO "item_descriptions" VALUES(11347,'fr','Dans sa jeunesse, Ougicle portait sa ceinture comme un pagne, sans pantalon. Il a arrêté le jour où il a réalisé pourquoi les gens se moquaient de lui dès qu''il leur tournait le dos.');
INSERT INTO "item_descriptions" VALUES(11348,'fr','Ougicle affectionnait tout particulièrement son collier en or : il faisait résonner ses hurlements à tel point que le sol autour de lui vibrait. Très pratique pour débusquer les Kolérats.');
INSERT INTO "item_descriptions" VALUES(11350,'fr','La Cawotte obscure qui orne l''anneau de Karotz n''a rien de magique et encore moins de maléfique, elle a juste le même âge que lui.');
INSERT INTO "item_descriptions" VALUES(11351,'fr','L''amulette de Karotz n''est autre qu''une amulette « Dents de Wabbits » de luxe, ornée de fourrure. Dommage que ça l''ait rendue moins puissante.');
INSERT INTO "item_descriptions" VALUES(11352,'fr','Les bottes de Karotz sont légères et doublées de fourrure, ce qui les rend très confortables. Malheureusement, en tant que Wabbit, il n''a jamais réussi à les enfiler.');
INSERT INTO "item_descriptions" VALUES(11354,'fr','Sur la tombe érigée en l''honneur de Grouillot, on peut lire que pour ne pas mourir carbonisé par sa propre lampe comme les autres Gargrouilles, il a éteint la sienne. Il s''est finalement perdu dans l''obscurité du Champ du Repos.');
INSERT INTO "item_descriptions" VALUES(11355,'fr','Les bottes de pierre de Grouillot le rendaient terriblement lent malgré les ailes qui lui étaient attachées. Personne n''a jamais compris à quoi cela pouvait bien être dû.');
INSERT INTO "item_descriptions" VALUES(11356,'fr','Grouillot aimait faire parler sa ceinture en utilisant ses talents de ventriloque. Nul n''a jamais su comment est-ce qu''il faisait pour en animer la langue sans utiliser ses mains.');
INSERT INTO "item_descriptions" VALUES(11358,'fr','Kubitus était un Chafer très polyvalent : l''affronter à distance signifiait devoir faire face à son grand talent d''archer, tandis que s''en approcher à moins d''une dizaine de kamètres vous infligeait une atroce mort par suffocation. Comme quoi garder les mêmes bottes des décennies durant peut avoir ses avantages.');
INSERT INTO "item_descriptions" VALUES(11359,'fr','L''os sur l''avant de la ceinture de Kubitus a grossièrement la forme d''un coccyx : il pensait qu''en ayant deux paires de fesses, il gagnerait en attrait auprès de la gent féminine. En pratique ça le rendait juste ridicule.');
INSERT INTO "item_descriptions" VALUES(11360,'fr','Cette amulette unique, autrefois animée par la même magie que celle des Obvijevans, s''obstinait à appeler Kubitus « Ulna ». Ce dernier, exaspéré, a fini par la rendre muette en lui arrachant la mâchoire.');
INSERT INTO "item_descriptions" VALUES(11362,'fr','Piggy Paupe hurlait si fort quand il s''essayait à la chanson qu''il a fini par devenir sourd. La magie insufflée dans les oreilles de son anneau lui a rendu l''ouïe. Le groin a remédié aux dégâts causés par sa puanteur.');
INSERT INTO "item_descriptions" VALUES(11363,'fr','L''inconfort de la ceinture de Piggy Paupe avait tendance à lui faire adopter une démarche très particulière, à envoyer sans cesse son bassin en avant ou en arrière. N''espérez pas pour autant gagner en intérêt auprès du genre opposé, vous n''en seriez que plus grotesque.');
INSERT INTO "item_descriptions" VALUES(11364,'fr','Le sabot qui orne l''amulette de Piggy Paupe est celui de sa femme et muse Yque Paupe, qu''elle lui a offert en cadeau. Mais Piggy a toujours pensé que c''était davantage un prétexte pour ne plus venir à ses concerts qu''une preuve d''amour.');
INSERT INTO "item_descriptions" VALUES(11374,'fr','Il reste assez de place pour qu''un de vos amis écrive votre nom sur cette amulette en papier. C''est ce que font les éleveurs pour reconnaître leurs Bouftous.');
INSERT INTO "item_descriptions" VALUES(11375,'fr','Ce sous-vêtement solide et rigide n''est pas très confortable, mais il a été réalisé avec du papier mâché. Avoir la salive d''un inconnu sur les fesses ne semble pas déranger tous les aventuriers.');
INSERT INTO "item_descriptions" VALUES(11378,'fr','Plus légères que des sandales classiques, elles n''ont qu''un seul véritable inconvénient, elles ne conviennent pas du tout aux chatouilleux.');
INSERT INTO "item_descriptions" VALUES(11379,'fr','Elle chatouille le cou et fera sortir les chats coincés dans votre gorge.');
INSERT INTO "item_descriptions" VALUES(11384,'fr','Accrochez cet anneau autour du cou des enfants que vous devez surveiller, reliez l''anneau à une corde que vous accrochez à un arbre. Et voilà vous êtes tranquille et les enfants ne se sauveront pas.');
INSERT INTO "item_descriptions" VALUES(11386,'fr','Elles sont parfaites pour donner des fessées avec vos pieds sans vous salir les mains. Les enfants vont vous adorer !');
INSERT INTO "item_descriptions" VALUES(11395,'fr','Cette petite chaîne pourrait passer pour une amulette si elle n''avait pas un embout dédié à l''accroche des boulets et des cadenas.');
INSERT INTO "item_descriptions" VALUES(11396,'fr','L''homme qui a donné un nom aussi stupide à cette ceinture est activement recherché, les années qu''il aurait passées en prison ne justifiant pas du tout un tel manque de créativité.');
INSERT INTO "item_descriptions" VALUES(11399,'fr','Vous pouvez lire sur l''emballage : "A réserver aux justiciers qui n''ont pas froid aux yeux". Et vous qui pensiez l''utiliser...');
INSERT INTO "item_descriptions" VALUES(11400,'fr','Le cordonnier qui a conçu ces bottes les a munies d''ailes de Chauffe-souris pour permettre à son propriétaire de voler. C''est en tout cas ce que vous a expliqué le marchand ambulant à qui vous les avez achetées et qui hurlait en boucle au zaap d''Astrub un discours presque inaudible.');
INSERT INTO "item_descriptions" VALUES(11416,'fr','Cette paire de bottines a été sculptée dans un tronc d''arbre. À moins que ça ne soit l''inverse.');
INSERT INTO "item_descriptions" VALUES(11417,'fr','Cet anneau a été confectionné à partir de sciure de bois et de quelque chose de très collant. Il est préférable ne pas en savoir plus.');
INSERT INTO "item_descriptions" VALUES(11419,'fr','Une paire de bottes que Francisque Kabroule n''oublie jamais d''enfiler quand il va faire sa petite commission... dans sa cabane, au fond du jardin.');
INSERT INTO "item_descriptions" VALUES(11468,'fr','Une amulette votive, dédiée au culte d''une déesse oubliée. « Protège tes frères et sœurs » est inscrit dessus. C''est bien les déesses, ça. Toujours à chouchouter les morveux. Et si on a ni frère, ni sœur, qu''est-ce qu''on fait, hein ?');
INSERT INTO "item_descriptions" VALUES(11469,'fr','« Notes sur les Dragons : dents (énormes), griffes (acérées), souffle (ardent), cupidité (phénoménale). Certains Dragons pourraient prédire la météo. Mais un Dragon est plus encombrant qu''une grenouille. » Comte Harebourg, mais où allez-vous chercher tout ça ?');
INSERT INTO "item_descriptions" VALUES(11470,'fr','« Le porteur de cet anneau aurait été prisonnier d''un Dragon. De mémoire de sage, on n''a jamais vu un Dragon retenir quelqu''un contre son gré. Pour un Dragon, c''est si simple d''en faire un bon barbecue, pourquoi s''embêter ? » - Pensée du comte Harebourg');
INSERT INTO "item_descriptions" VALUES(11471,'fr','« Le porteur de ces bottes était très remonté contre un certain Dragon. Ne pas faire comme lui : toujours penser au respect ancestral qui leur est dû. Et se rappeler qu''un Dragon est grand, très grand. Et qu''il n''a aucun sens de l''humour » - Pensée du comte Harebourg');
INSERT INTO "item_descriptions" VALUES(11472,'fr','« Cette cape est censée protéger son porteur des rêves et des illusions de la dimension éthérée. Est-elle réellement efficace ? Il faudrait pouvoir aller et venir à travers les dimensions pour en avoir le cœur net. A part le Mage Ax les jours de grande forme (ou de beuverie), peu s''en sont jamais vantés. » - Pensée du Comte Harebourg.');
INSERT INTO "item_descriptions" VALUES(11473,'fr','Le Comte Harebourg a inscrit sur cette ceinture : « celui qui ceint cette ceinture pourra passer à travers le temps et l''espace ! » Spéculation théorique ? Une chose est sûre : elle retient votre pantalon. Ce n''est déjà pas si mal.');
INSERT INTO "item_descriptions" VALUES(11474,'fr','« En cas de perturbations dans l''astral, revêtez d''urgence ce couvre chef ». Une consigne de sécurité gravée par le Comte Harebourg lui-même. Vous ignorez ce qu''est l''astral, mais coiffé de ce chapeau pas ordinaire, vous pourrez foncer vers l''aventure... ou dans le mur !');
INSERT INTO "item_descriptions" VALUES(11514,'fr','Une fois cette arme au poing, vous crierez vengeance et vous réclamerez justice. Se venger de qui ? Justice pour quoi ? On dirait bien que les réponses à ces questions n''appartiennent pas à cet Âge...');
INSERT INTO "item_descriptions" VALUES(11563,'fr','Portée autour du cou, cette amulette montrera à tous votre maîtrise des quatre énergies élémentales primordiales. Elle ne vous rendra pas plus riche pour autant.');
INSERT INTO "item_descriptions" VALUES(11571,'fr','Les cornes de cette coiffe viennent se poser directement contre les tempes de l''aventurier qui ose la porter. Les cornes entrent ainsi en résonance avec le cerveau et vous permettent de communiquer à distance avec les Gélikans, sans avoir besoin d''ouvrir la bouche ou les oreilles. Très pratique lorsque l''on cherche à infiltrer une tribu de Gélikans.');
INSERT INTO "item_descriptions" VALUES(11572,'fr','Les quatre énormes boules luisantes qui ornent cette couronne sont d''après certains experts en mansologie de Frigost, une représentation plutôt imagée de l''incroyable fertilité du Mansot Royal. Mais où peuvent-ils aller chercher des idées aussi farfelues ?');
INSERT INTO "item_descriptions" VALUES(11573,'fr','Ben le Ripate portait ce chapeau pour montrer qui était le chef à bord du Grolandais violent. Cela n''a pas empêché ses fidèles moussaillons de l''avoir surnommé "le cloporte manteau", "le démineur de gloire", "l''abajour de chance" ou encore "l''octopus tule".');
INSERT INTO "item_descriptions" VALUES(11574,'fr','Il faut reconnaître qu''avec ce casque sur la tête vous n''avez pas l''air très malin. Le problème étant que sans ce casque, vous semblez l''être encore moins.');
INSERT INTO "item_descriptions" VALUES(11575,'fr','Elle rend votre cou éclatant, juste avant qu''il ne se fasse éclater pour que l''on vous la vole.');
INSERT INTO "item_descriptions" VALUES(11576,'fr','Les bijoutiers de Frigost dispensaient autrefois un très bon conseil lorsqu''ils voulaient vendre des bijoux assez lourds : offrez des bijoux lourds pour le cou de votre dulcinée, cela lui évitera de partir trop loin.');
INSERT INTO "item_descriptions" VALUES(11577,'fr','Une légende frigostienne raconte qu''une bande de pleutres aurait tenté de jeter cet anneau dans le cratère d''un volcan afin de le détruire. Heureusement ils n''ont pas réussi.');
INSERT INTO "item_descriptions" VALUES(11578,'fr','Ben le Ripate aimait beaucoup les câlins et les poignées de mains viriles et parfois les deux en même temps. Malheureusement pour ceux qu''il aimait, il oubliait régulièrement qu''il était armé d''un énorme crochet rouillé. À force d''éborgner, de griffer, de piquer, de pincer ou de découper ses proches, il a hérité des surnoms suivants : « le sans cœur et sans valoche », « le taure et facteur » ou encore « le surprenant tourloupeur ».');
INSERT INTO "item_descriptions" VALUES(11579,'fr','Les bijoutiers de Frigost dispensaient autrefois un très bon conseil lorsqu''ils avaient des bijoux légers à vendre : n''offrez pas de bijoux trop lourds pour les mains de votre dulcinée, elle pourrait avoir du mal à essuyer le haut de vos étagères.');
INSERT INTO "item_descriptions" VALUES(11580,'fr','Cette cape aurait pu faire une très belle descente de lit, mais le Tailleur qui l''a confectionnée dormait dans un hamac.');
INSERT INTO "item_descriptions" VALUES(11581,'fr','Un peu rigide, un peu lourde et d''une autre époque, cette cape vous rappelle une ancienne collègue avec qui vous avez cassé des cailloux au fond d''une mine.');
INSERT INTO "item_descriptions" VALUES(11582,'fr','En les chaussant et en courant dans la neige, vous devriez être capable de laisser les mêmes traces que celles du Royalmouth. Il ne manquera que la trace de la queue.');
INSERT INTO "item_descriptions" VALUES(11583,'fr','Ces bottes ne vous apporteront pas une démarche très gracieuse, mais comme vous n''avez pas de démarche gracieuse personne ne s''en apercevra.');
INSERT INTO "item_descriptions" VALUES(11584,'fr','Cette ceinture était autrefois utilisée comme ceinture de chasteté. Il s''agit d''une anecdote assez surprenante lorsque l''on connaît le faible du Royalmouth pour les parties de sabots en l''air.');
INSERT INTO "item_descriptions" VALUES(11585,'fr','Cette ceinture fait également office de pagne. Elle permettait au célèbre Ben le Ripate de cacher son trésor le plus précieux, le plus envié, et le plus convoité. Les marins jaloux de son immense trésor l''ont surnommé pour des raisons plutôt floues "l''illuminé crochu", ou encore "l''écumeur massacrante". Lorsqu''il fut pendu pour la treizième fois, il lança à la foule "Mon trésor à celui qui comprendra !".');
INSERT INTO "item_descriptions" VALUES(11586,'fr','Comme tout véritable pirate fantôme qui se respecte, Ben le Ripate possédait un sabre pour trancher les nœuds, les têtes, et les têtes de nœuds. Mais il était si sensible qu''il ne pouvait pas se retenir de verser une larme. Ses adversaires qui ont perdu la tête ont profité de cette anecdote avant de mourir pour le surnommer « la fine larme ».');
INSERT INTO "item_descriptions" VALUES(11598,'fr','Avec ce casque sur la tête, vous avez enfin une bonne excuse pour avoir une tête de gland.');
INSERT INTO "item_descriptions" VALUES(11599,'fr','C''est bien connu, le Frichochère aime faire des fricochoncetés. Porter cette coiffe vous permettra de justifier les vôtres.');
INSERT INTO "item_descriptions" VALUES(11600,'fr','Difficile de savoir si le Fantimonier a choisi délibérément ce masque ou s''il a été victime d''un très violent accident maritime avec un coquillage. Difficile également de savoir qui est le plus à plaindre entre le coquillage et le Fantimonier.');
INSERT INTO "item_descriptions" VALUES(11601,'fr','Parfois surnommé "tête de patelle", le Harpirate n''aime pas trop les blagues sur les fruits de mer, et encore moins les blagues sur sa mère impliquant des fruits.');
INSERT INTO "item_descriptions" VALUES(11602,'fr','Pourih était un Frigostien connu pour cacher tout et n''importe quoi dans son chapeau, mais surtout n''importe quoi. Son chapeau avait la même particularité que celle des sacs à main d''aventurières : ce sont les seuls réceptacles dont la taille du contenu dépasse la capacité du conteneur, défiant ainsi toutes les lois de la physique frigostienne moderne.');
INSERT INTO "item_descriptions" VALUES(11603,'fr','Ce chapeau n''est assorti qu''avec les chevelures blondes. Il semble troué, vous devriez le faire échanger auprès de l''assistante de Justin Dwa, le fabricant de skis de la Bourgade de Frigost.');
INSERT INTO "item_descriptions" VALUES(11604,'fr','Le tailleur qui a confectionné ce chapeau était persuadé que l''avenir de Frigost allait être très sombre. Comme tous les prophètes du slip qui ont voulu faire des prévisions, il s''est trompé. Le futur de Frigost était juste froid.');
INSERT INTO "item_descriptions" VALUES(11605,'fr','Les tailleurs naïfs de Frigost pensent qu''il s''agit d''une version améliorée de la célèbre cape Rice. Sur l''étiquette de la cape, on peut y lire l''inscription suivante : "Elle tient son nom de sa capacité à devenir transparente au niveau des postérieurs lorsqu''ils sont galbés". Il s''agit en réalité d''une cape Vicieuse ! Vous venez subitement de comprendre que tout le monde peut voir vos fesses.');
INSERT INTO "item_descriptions" VALUES(11606,'fr','Cette cape attire tous les regards et permet de faire diversion. Si l''on vous ordonne de la porter sur un champ de bataille, vous pourrez alors estimer plus précisément votre espérance de vie.');
INSERT INTO "item_descriptions" VALUES(11607,'fr','Une barde connue sous le nom de Silvie Vatan a porté ce collier durant sa jeunesse. Tous ses fans portaient le même collier. Si vous faites de même, attendez-vous à ce que même les monstres d''Incarnam se moquent de vos goûts musicaux.');
INSERT INTO "item_descriptions" VALUES(11608,'fr','Ce talisman peut s''accrocher autour du cou d''une seule main.');
INSERT INTO "item_descriptions" VALUES(11609,'fr','A chaque fois que vous vous gratterez le cou, cette amulette fera vibrer vos cordes vocales et émettra le son suivant : "Dzoing dzoing". Si avec ça vous n''arrivez pas à courtiser, on ne peut plus rien pour vous.');
INSERT INTO "item_descriptions" VALUES(11610,'fr','Cela ne fait aucun doute, ce pagne a appartenu à un ou plusieurs Kaniglous. Un de plus désormais. Toutefois il semble mal conçu, vous devriez pouvoir le faire échanger auprès de l''assistante de Justin Dwa, le fabricant de skis de la Bourgade de Frigost.');
INSERT INTO "item_descriptions" VALUES(11611,'fr','Ce slip assorti aux cheveux longs dispose d''un cendrier intégré et d''une réserve de plectres. Avant la glaciation de Frigost, il était très utilisé par les jeunes rebelles contestataires qui fauchaient de l''herbe pour leur consommation personnelle. Il s''agissait sûrement d''éleveurs qui voulaient nourrir leurs Bouftous.');
INSERT INTO "item_descriptions" VALUES(11612,'fr','Si vous fixez ce slip sans détourner le regard, en bougeant la tête de droite à gauche pendant plusieurs jours, vous pourrez peut-être finir par vous endormir.');
INSERT INTO "item_descriptions" VALUES(11617,'fr','Ces bottes étaient réservées aux frigostiens dont les parents étaient eux-mêmes frigostiens et dont les parents des parents étaient frigostiens et dont les parents des parents des parents étaient frigostiens. Si vous n''êtes pas frigostien vous-même, nous vous déconseillons de les porter.');
INSERT INTO "item_descriptions" VALUES(11618,'fr','On raconte que le nom de ces sandales vient de celui d''un très grand mathématicien frigostien appelé Hannibal Gorithme. Il portait toujours des sandales, même après la glaciation de l''île. Il marchait en boucle dans la neige jusqu''à trouver la condition qui allait lui permettre d''arrêter sa promenade. Il s''arrêtait quand il avait les doigts de pieds gelés.');
INSERT INTO "item_descriptions" VALUES(11619,'fr','Ces sandales seront bientôt assorties à la couleur de vos cheveux ou aux couleurs du drapeau que vous brandirez lors de votre prochain combat contre un percepteur.');
INSERT INTO "item_descriptions" VALUES(11620,'fr','Cet anneau aurait pu permettre d''éviter quelques déconvenues maritimes à l''illustre Ben le Ripate. Et au lieu de boire la tasse, il aurait ainsi pu sabrer des bouteilles de Cocalane, la fameuse boisson qui fait tout passer.');
INSERT INTO "item_descriptions" VALUES(11621,'fr','Cet anneau se déplace tout seul en roulant si vous ne le laissez pas autour d''un doigt. Il pourra également vous servir d''excuse si vous avez les mains baladeuses et que vous fourrez vos doigts n''importe où.');
INSERT INTO "item_descriptions" VALUES(11622,'fr','L''artisan frigostien qui a confectionné ce petit bijou a failli mourir de fatigue en essayant d''écrire quelque chose d''intéressant sur l''étiquette de cet anneau. Il a préféré "passer à autre chose". Ce qui en langage frigostien pourrait se traduire par "aller faire la fête et se saouler dans toutes les tavernes de la bourgade".');
INSERT INTO "item_descriptions" VALUES(11623,'fr','Création typiquement frigostienne, cet anneau a été confectionné par un artisan qui n''avait pas froid aux yeux ni aux mains.');
INSERT INTO "item_descriptions" VALUES(11624,'fr','La lame de ce sabre a été spécialement conçue pour couper les bretelles de vos adversaires. Une fois leurs braies tombées sur les chevilles, vous pourrez facilement les faire trébucher ou tout simplement les humilier d''un rire moqueur avant de les achever.');
INSERT INTO "item_descriptions" VALUES(11625,'fr','Cette hache était très utilisée par les bouchers de Frigost qui désiraient hacher la viande en tout petits morceaux afin que l''on ne puisse pas s''apercevoir qu''ils vendaient à leur aimable clientèle des cloaques de Gélikans. Cette pratique explique un grand nombre de préjugés à propos de la gastronomie Frigostienne.');
INSERT INTO "item_descriptions" VALUES(11626,'fr','Difficile de savoir s''il s''agit d''une hache ou d''une ancre. Le Fancrôme lui-même ne connaît pas la réponse à cette question. Dans le doute, il l''utilise comme une hache sur tous les aventuriers qu''il croise.');
INSERT INTO "item_descriptions" VALUES(11627,'fr','À l''aide des mathématiques frigostiennes les plus élémentaires, cet arc permet de calculer la hauteur de certains édifices de façon très pragmatique. Malheureusement il ne donne aucune indication sur l''unité de mesure du résultat.');
INSERT INTO "item_descriptions" VALUES(11628,'fr','Cette pelle appartenait à un barde. Son approche musicale avant-gardiste qui consistait à appuyer sur les touches de son instrument avec une pelle ne faisait pas encore l''unanimité sur Frigost lorsqu''il se produisait dans les rues de la bourgade.');
INSERT INTO "item_descriptions" VALUES(11629,'fr','Ces dagues ont appartenu à un célèbre Sram qui aimait parader et faire le beau devant les braves du village. Mais il était avant tout populaire pour ses multiples titres de champion de Jongle Cidre. Un jeu plutôt stupide qui consiste à boire de l''alcool chez un ami, tenter de récupérer un morceau de bois et de renverser un maximum de choses liquides sur le sol de celui qui héberge la partie. Un jeu fortement recommandé par les marchands de tapis frigostiens.');
INSERT INTO "item_descriptions" VALUES(11630,'fr','Ce marteau a été construit dans l''unique but de pouvoir distribuer des baffes au Yech''Ti. Il a depuis été légèrement détourné de son usage initial depuis que les frigostiens se sont aperçus qu''il fonctionnait très bien sur toutes les créatures qui présentaient une ou plusieurs de ces caractéristiques : des poils longs, une haleine de hareng, un air stupide, ou encore l''œil torve. Vous comprenez enfin pourquoi l''on vous a déjà frappé avec ce marteau par le passé.');
INSERT INTO "item_descriptions" VALUES(11631,'fr','La Vigie Pirate avait une approche du combat assez singulière, elle commençait par décrire son marteau de la sorte : "il est lourd, il fait mal et il flotte". Ses assaillants se posaient alors la question suivante : "il flotte et alors ?". Ce qui laissait assez de temps à la Vigie Pirate pour écraser ses advers... *sprotch*');
INSERT INTO "item_descriptions" VALUES(11632,'fr','Cette baguette a été confectionnée par un expert frigostien de la discrétion et de la furtivité. Sur le manuel d''utilisation, il est inscrit : « Si vous arrivez derrière votre ennemi par surprise pour lui donner un coup de baguette bien placé dans l''arrière-train et que vous êtes subitement pris d''une envie d''éternuer, enfoncer rapidement cette baguette dans la narine impaire de votre nez et comptez jusqu''à trois. »
Le manuel qui explique comment connaître votre narine impaire est payant.');
INSERT INTO "item_descriptions" VALUES(11633,'fr','Il est mou et tout le monde sait que les bons bâtons sont ceux bien durs. Que peut-on faire d''un bâton mou, d''un bâton qui ne tient pas en main ? Sûrement la même chose qu''avec une baguette molle.');
INSERT INTO "item_descriptions" VALUES(11634,'fr','Difficile de croire que toute la magie de ce bâton puisse provenir de la tête de poisson en décomposition qui orne son extrémité. Le mystère derrière tout cela doit également permettre d''expliquer les idées intelligentes qui sortent de la vôtre.');
INSERT INTO "item_descriptions" VALUES(11635,'fr','Cette lance munie d''un morceau de coquillage aiguisé peut faire office de harpon, de javelot, de piquet de tente ou encore de cure-boyaux. Ne demandez jamais de démonstration si vous croisez un Harpirate.');
INSERT INTO "item_descriptions" VALUES(11667,'fr','Ces bottes étaient réservées aux frigostiens dont les parents étaient eux-mêmes frigostiens et dont les parents des parents étaient frigostiens et dont les parents des parents des parents étaient frigostiens. Si vous n''êtes pas frigostien vous-même, nous vous déconseillons de les porter.');
INSERT INTO "item_descriptions" VALUES(11686,'fr','Cela ne fait aucun doute, ce pagne a appartenu à un ou plusieurs Kaniglous. Un de plus désormais.');
INSERT INTO "item_descriptions" VALUES(11706,'fr','Ce chapeau n''est assorti qu''avec les chevelures blondes.');
INSERT INTO "item_descriptions" VALUES(11707,'fr','Affublé de cette coiffe, une bonne partie de la gent féminine du Monde des Douze vous trouvera un air de peluche terriblement mignon. Vous qui vouliez les terroriser avec la dépouille d''un monstre aussi féroce que Tengu Givrefoux, c''est raté.');
INSERT INTO "item_descriptions" VALUES(11708,'fr','Ni Tengu Givrefoux, ni aucun de ses cousins Givrefoux n''a de triple queue, pourtant vous avez demandé à votre tailleur de vous confectionner cette cape à trois pans. Vous avez décidément un profond complexe d''infériorité.');
INSERT INTO "item_descriptions" VALUES(11709,'fr','Après avoir arraché autant de bandelettes au Tengu Givrefoux pour confectionner cette ceinture, vous aurez vous aussi besoin de quelques pansements.');
INSERT INTO "item_descriptions" VALUES(11710,'fr','Ces chaussons à base de fourrure de Givrefoux sont si confortables que vous aurez largement la place d''y caser vos doigts de pied. Mais seulement trois d''entre eux.');
INSERT INTO "item_descriptions" VALUES(11711,'fr','Couper du bois avec une hache en bois, voilà qui est sadique. C''est sans doute la raison pour laquelle vous ne pouvez vous empêcher de massacrer inlassablement tous ces pauvres Bouftous.');
INSERT INTO "item_descriptions" VALUES(11712,'fr','L''accroche commerciale de cette cape indique : "Jamais copiée mais souvent égalée, cette cape se distingue surtout par ses coutures doubles qui la rendent plus solide que les capes qui ne la copient pas mais l''égalent." Vous sentez subitement une odeur d''arnaque quelque part.');
INSERT INTO "item_descriptions" VALUES(11713,'fr','Cette amulette était très à la mode sur Frigost. Il y a plusieurs siècles.');
INSERT INTO "item_descriptions" VALUES(11714,'fr','Son odeur laisse penser que quelqu''un d''autre l''a porté aux orteils.');
INSERT INTO "item_descriptions" VALUES(11715,'fr','Cette coiffe ne vous donnera pas une gueule de porte-bonheur.');
INSERT INTO "item_descriptions" VALUES(11716,'fr','Cette ceinture recouverte de fourrure tient vos hanches bien au chaud pour faire fondre plus rapidement vos poignées d''amour.');
INSERT INTO "item_descriptions" VALUES(11717,'fr','Piautre est né dans une ancienne ferme collective de Frigost, près du lac gelé. Il a confectionné cet anneau en pensant réinventer la débroussailleuse à doigts. Il s''est coupé la main trois fois seulement.');
INSERT INTO "item_descriptions" VALUES(11718,'fr','Lorsque le Glourséleste veut se déplacer discrètement à l''extérieur de sa ruche, il se coiffe d''un masque afin de se faire passer pour un Meliglours. Parfois son ventre le trahit.');
INSERT INTO "item_descriptions" VALUES(11719,'fr','Lorsqu''il n''y a plus rien à faire dans la ruche des Gloursons, ces derniers n''hésitent pas à s''offrir un peu de bon temps et à utiliser ce type de cape en guise de luge. Une étude Frigostienne approfondie de leur faciès et de leur moeurs semble avoir démontré qu''ils sont très mauvais pour éviter les obstacles et qu''ils protègent généralement leurs mains avec leur tête.');
INSERT INTO "item_descriptions" VALUES(11720,'fr','De cette amulette s''écoule un miel délicieux mais plutôt collant. Si vous la portez autour du cou, vous bénéficierez d''une épilation gratuite et progressive du torse. A moins d''aimer les recettes à base de poils, il est conseillé de la mettre dans votre bouche avant de la mettre autour du cou.');
INSERT INTO "item_descriptions" VALUES(11721,'fr','Des chasseurs frigostiens racontent avoir déjà vu le Glourséleste réussir à enfiler cette ceinture autour de ses hanches. Il s''agit sûrement des mêmes chasseurs qui affirment avoir croisé un Yech''Ti sur Frigost.');
INSERT INTO "item_descriptions" VALUES(11722,'fr','Générations après générations, les Gloursons ont travaillé pour obtenir la semelle parfaite, celle qui ne colle pas sur le miel.');
INSERT INTO "item_descriptions" VALUES(11723,'fr','Avec ce chapeau sur la tête, tout le monde pensera que vous avez l''air ridicule, mais personne n''en dira mot. Maintenant, vous savez ce qu''ils pensent, mais eux ne savent pas que vous savez ce qu''ils pensent. Enfin, vous savez bien.');
INSERT INTO "item_descriptions" VALUES(11724,'fr','Jadis porté par des Frigostiens peu recommandables, ce chapeau est désormais devenu un objet de mode presque incontournable. Sur son étiquette vous pouvez lire : "Il attirera toutes les créatures sauvages qui veulent votre corps plutôt que votre or". Il n''est cependant pas précisé s''il s''agit des frigostiennes de la bourgade ou des créatures qui peuplent les forêts de Frigost.');
INSERT INTO "item_descriptions" VALUES(11725,'fr','Avec l''air endormi, pantouflard et nonchalant que vous donne ce bonnet, vos ennemis baisseront leur garde, on ne vous demandera plus rien, les monstres vous passeront à côté pour attaquer vos amis, on vous traitera de fainéant, vous ne trouverez pas de travail, votre couple ira mal, on vous oubliera... Ça avait l''air plus drôle au début.');
INSERT INTO "item_descriptions" VALUES(11726,'fr','Portez cette cape attachée et complotez contre le roi Allister, ce qui vous permettrait, entre autres, de manger fort souvent du museau, ou même de vous procurer une ombrelle. Puis disparaissez de sa présence.');
INSERT INTO "item_descriptions" VALUES(11727,'fr','Cette création très approximative n''a aucune forme, pas la moindre esthétique et semble pouvoir tomber en lambeaux d''un moment à un autre, mais est pourtant très puissante. Ne dit-on pas que l''habit ne fait pas le moine ?');
INSERT INTO "item_descriptions" VALUES(11728,'fr','Le Comte Harebourg, avant la glaciation, aurait dit un jour que si les capes Hiculteur venaient à disparaître de la surface de l''île, le Monde des Douze n''aurait plus que quatre années à vivre. Il n''a en fait jamais dit ça, c''est simplement une rumeur lancée par le créateur de la cape, Hiculteur, qui était au bord de la faillite. Il est depuis devenu immensément riche.');
INSERT INTO "item_descriptions" VALUES(11729,'fr','Cætera était un guerrier terriblement puissant, mais qui était incapable de finir ce qu''il commençait. Il mutilait ses adversaires par dizaines sans jamais avoir su en tuer un seul. Il est mort le jour où ils ont décidé de tous se liguer contre lui pour obtenir vengeance. Vous y réfléchirez à deux fois la prochaine fois que vous voudrez laisser la vie sauve à quelqu''un.');
INSERT INTO "item_descriptions" VALUES(11730,'fr','Le bijoutier qui a créé cette amulette était un peu fou, et l''a assemblée sans le moindre respect des règles de base de la bijouterie Frigostienne, à partir de composants tous plus différents les uns que les autres. Par on ne sait quel miracle, ça lui a plutôt bien réussi.');
INSERT INTO "item_descriptions" VALUES(11731,'fr','Enfilez l''amulette Hendart, chevauchez votre plus fière Dragodinde, équipez vos armes les plus étincelantes, portez haut et fort votre blason et guidez vos hommes vers la victoire avec le plus grand air chevaleresque qui soit ! Taïaut ! Attention toutefois à ne pas trop effrayer les citoyens si vous ne voulez pas finir au bûcher.');
INSERT INTO "item_descriptions" VALUES(11732,'fr','Les vieux chasseurs frigostiens ont longtemps cherché la signification du motif tissé sur ce pagne. Après de longues délibérations, ils ont conclu qu''il s''agissait d''un avertissement concernant l''odeur de ce qu''il est supposé cacher.');
INSERT INTO "item_descriptions" VALUES(11733,'fr','Avec cette ceinture, que ce soit dans l''air ou dans l''eau, vous serez capable de générer d''importantes quantités d''énergie. A vous de voir ce que vous en ferez, d''autant plus que celle-ci est inutilisable. Vous devriez l''échanger auprès de l''assistante de Justin Dwa, le fabricant de skis de la bourgade de Frigost.');
INSERT INTO "item_descriptions" VALUES(11734,'fr','Cette ceinture au rayonnement vert fluorescent vous permettra de faire faner les fleurs autour de vous, de rendre vos invocations originales, ou encore de tuer vos ennemis à (très) petit feu. Garantie 4,47 milliards d''années.');
INSERT INTO "item_descriptions" VALUES(11735,'fr','Le bijoutier qui a jadis confectionné cet anneau que vous vous passez de génération en génération, n''était assurément pas de grand talent. Le « N » qui orne son sceau apparaît à l''envers lorsque vous scellez une enveloppe avec.');
INSERT INTO "item_descriptions" VALUES(11736,'fr','Cet anneau extrêmement puissant permet de manipuler l''esprit de celui ou celle qui le porte à volonté. C''est peut-être là une occasion en or de sauver votre couple.');
INSERT INTO "item_descriptions" VALUES(11737,'fr','Cet anneau, qui semble avoir des tendances suicidaires, requiert toute votre attention. Si vous cessez de vous en occuper, il risque de se mettre à rouler inexorablement pour aller se jeter de la falaise la plus proche.');
INSERT INTO "item_descriptions" VALUES(11738,'fr','Cet anneau tient son nom de l''étrange interjection qu''il suscite auprès d''aventuriers peu expérimentés, parmi d''autres comme "gégé", "pétédéaire", "nide", ou encore "owoui". Les voies de l''habitant du monde des douze sont impénétrables.');
INSERT INTO "item_descriptions" VALUES(11739,'fr','Une fois votre course lancée avec ces bottes aux pieds, rien ne pourra vous arrêter, à part peut-être le râteau que vous aurez laissé traîner sur le gazon de votre femme.');
INSERT INTO "item_descriptions" VALUES(11740,'fr','Hodore était un cordonnier très innovant. Il a créé ces bottines parcourues de nombreuses petites perforations pour qu''elles évacuent les mauvaises odeurs au lieu de les retenir dans la chaussure. Résultat, vous empestez à des kilokamètres, mais vos chaussures, elles, n''ont pas la moindre odeur.');
INSERT INTO "item_descriptions" VALUES(11741,'fr','Les sandales Pinistes ont un grave défaut de conception : parfaites pour grimper sur les sommets les plus hauts de Frigost, elles n''en sont pas moins des sandales et vos orteils risquent bien de tomber si vous réalisez l''ascension du Mont Torrideau en chaussettes. Elles restent cependant bien pratiques pour infliger de très douloureux coups bas à vos adversaires.');
INSERT INTO "item_descriptions" VALUES(11742,'fr','Cette épée très courte vous demandera une allonge importante afin d''avoir une chance de toucher vos adversaires. Vous éprouverez beaucoup de difficulté à blesser vos ennemis mais également vos alliés. Essayez pour une fois de voir le bon côté des choses.');
INSERT INTO "item_descriptions" VALUES(11743,'fr','C''est l''épée préférée des dentistes, des chasseurs de sangliers et des dentistes chasseurs de sangliers.');
INSERT INTO "item_descriptions" VALUES(11744,'fr','La lame de cette arme devient molle lorsque vos jambes commencent à trembler et vous donne ainsi un très bon prétexte pour fuir comme un lâche.');
INSERT INTO "item_descriptions" VALUES(11745,'fr','Cet étrange marteau est censé permettre à vos ennemis de voir leur futur quand vous l''abattez sur leur crâne. Il semble ne pas fonctionner correctement puisque ces derniers voient rouge systématiquement. Vous tapez peut-être un peu trop fort.');
INSERT INTO "item_descriptions" VALUES(11746,'fr','Malgré son nom féminin, ce marteau suinte la virilité, le poil, la force brute et la transpiration, ce qui ne va pas sans vous rappeler le Minotoror. Il va sans dire qu''avec cette petite merveille entre les mains, même la plus délicate des reines ferait un carnage sans nom.');
INSERT INTO "item_descriptions" VALUES(11747,'fr','Cet imposant marteau enduit de miel attire les gourmands et nourrit les mourants.');
INSERT INTO "item_descriptions" VALUES(11748,'fr','Thanos aurait exercé toutes sortes de professions peu recommandables, sergent instructeur, banquier, prêteur sur gage, conteur d''histoires ou encore prophète du S.L.I.P. par intermittence. Ce bâton lui servait à sanctionner ses apprentis et ses auditeurs; pratique quotidienne qui lui permettait de se maintenir en forme. Cet exemplaire a été mis à mal par un Rattedaugue affamé. L''assistante de Justin Dwa, le fabricant de skis, doit pouvoir vous l''échanger contre un exemplaire en bon état.');
INSERT INTO "item_descriptions" VALUES(11749,'fr','Il s''agit du bâton idéal pour vous protéger gracieusement du soleil et passer pour une brelle auprès de vos alliés.');
INSERT INTO "item_descriptions" VALUES(11750,'fr','Si vous avez décidé d''être un justicier assassin furtif noctambule, c''est le bâton qu''il vous faut. Assorti aux regards noirs et profonds, ce bâton possède l''extraordinaire pouvoir magique d''être invisible dans le noir total.');
INSERT INTO "item_descriptions" VALUES(11751,'fr','Version améliorée de la Shushette dague Hi''Mov'', cette paire de dagues vous permet d''effectuer deux bonnes actions en même temps : distribuer des confiseries et vous débarrasser des sales gosses.');
INSERT INTO "item_descriptions" VALUES(11752,'fr','Ces dagues ont tout pour exaspérer : irrégulières, imprévisibles, perfides, elles vous rappellent votre belle-mère. Vous vous faites déjà un véritable plaisir à la simple perspective de partager ce ressentiment avec votre pire ennemi.');
INSERT INTO "item_descriptions" VALUES(11753,'fr','Hirr était un aventurier en quête de conquêtes et un conquérant en quête d''aventures. On suppose qu''il ne trouva pas sur Frigost ce qu''il cherchait, mais qu''il y trouva tout ce qu''il ne cherchait pas. Il était connu pour scander son nom à chaque fois qu''il tuait un ennemi. Il est devenu aphone en décidant de s''attaquer à une hydre dont les têtes repoussaient indéfiniment.');
INSERT INTO "item_descriptions" VALUES(11754,'fr','Cet arc à la forme et aux couleurs des plus inhabituelles ne semble être apprécié que par une faible minorité d''aventuriers, ceux-ci se disant artistes, avant-gardistes, ou incompris, c''est selon. Laissez-les donc se triturer les méninges à lui trouver une utilité au combat, ça devrait vous laisser suffisamment de temps pour les trancher en deux.');
INSERT INTO "item_descriptions" VALUES(11755,'fr','Hétype était un sculpteur d''arcs renommé, ayant voué toute sa vie à la confection d''arcs d''une excellente qualité, bien que très basiques. À la fin de sa vie, regrettant de n''avoir rien fait d''atypique, il créa cet arc, son seul et unique coup de folie. Il a beau être étrange, vous lui trouverez forcément une utilité.');
INSERT INTO "item_descriptions" VALUES(11756,'fr','Cet arc date de bien avant la glaciation de Frigost. Démodé, il est tombé en désuétude jusqu''à il y a peu, quand un enfant qui en avait trouvé un vieil exemplaire dans un grenier a terrassé accidentellement une armée de Boufmouths se préparant à envahir la Bourgade.');
INSERT INTO "item_descriptions" VALUES(11757,'fr','Cette baguette était un signe distinctif pour les savants frigostiens qui étudiaient les caractères sociaux et culturels des habitants de Frigost. C''était également un signe distinctif très utile pour les monstres qui pouvaient ainsi facilement repérer les proies les plus faibles mais avec la cervelle la plus remplie.');
INSERT INTO "item_descriptions" VALUES(11758,'fr','Sur le manche en bois vous pouvez lire les inscriptions suivantes : "La femme de cette braguette brille pour l''éternité". Il s''agit sûrement d''un message codé, à moins que son sculpteur n''ait voulu écrire : "La flamme de cette baguette brille pour l''éternité".');
INSERT INTO "item_descriptions" VALUES(11759,'fr','Cette baguette est l''arme idéale pour faire la morale à vos adversaires, ou pointer du doigt les alliés désignés volontaires qui devront engager le combat en premier.');
INSERT INTO "item_descriptions" VALUES(11760,'fr','Cette hache a appartenu à un célèbre assassin qui prenait un malin plaisir à sauter dans les meules de foin du haut des tours du château d''Allister.');
INSERT INTO "item_descriptions" VALUES(11761,'fr','Les chances de traverser avec succès un champ de Hache Téroïde ne sont que d''une sur trois mille sept cent vingt.');
INSERT INTO "item_descriptions" VALUES(11762,'fr','Cette pelle provient d''une région mythique où l''or est supposé abonder. On raconte que Hirr en personne aurait cherché cette contrée pendant des années. Il aurait terminé sa vie sur un misérable radeau avec cette pelle pour seule pagaie.');
INSERT INTO "item_descriptions" VALUES(11763,'fr','Assortie aux cheveux longs et aux oreilles pointues, cette pelle saura réveiller la magie et la démarche efféminée qui sommeillent en vous.');
INSERT INTO "item_descriptions" VALUES(11765,'fr','Cette boule de poils à gratter déteste être caressée à rebrousse-poil. Il s''en faut parfois d''un poil pour qu''elle finisse de mauvais poil.');
INSERT INTO "item_descriptions" VALUES(11771,'fr','Inutile de poser la question, elle flotte.');
INSERT INTO "item_descriptions" VALUES(11777,'fr','Ce petit familier saura prendre soin de vos noisettes en allant les cacher quelque part. Ne comptez cependant pas les retrouver, puisqu''il oublie systématiquement où il les cache.');
INSERT INTO "item_descriptions" VALUES(11783,'fr','Plus grincheux qu''un Tifoux mais surtout moins poilu des aisselles, ce familier est réputé pour avoir réussi à mordre la Dame Antium sans se casser la moindre dent.');
INSERT INTO "item_descriptions" VALUES(11792,'fr','Vous excellez dans la maîtrise des quatre énergies élémentales primordiales et vous voulez que tout le monde le sache. Attention, ça pourrait vous jouer des tours.');
INSERT INTO "item_descriptions" VALUES(11794,'fr','Créée en deux exemplaires par un éminent biologiste Frigostien, cette racine devait permettre aux habitants du village enseveli de se débarrasser définitivement des créatures végétales de la forêt pétrifiée. Le biologiste a disparu sans laisser le mode d''emploi et son fils, parti à sa recherche, ne l''a jamais retrouvé. Des Frigostiens ont alors essayé de reproduire les effets des deux racines et ce que vous avez entre les mains n''est qu''une vulgaire copie.');
INSERT INTO "item_descriptions" VALUES(11811,'fr','De splendides bottes de marche tannées en Brâkmar.');
INSERT INTO "item_descriptions" VALUES(11816,'fr','Vous ne savez pas vraiment si cette ceinture vous gratouille ou vous chatouille. Qu''importe, puisque vous ferez fureur à la Fête du Slip du Captain Chafer si vous ne portez rien en-dessous.');
INSERT INTO "item_descriptions" VALUES(11819,'fr','Ce marteau, aussi lourd que l''humour d''un Rattedaugue, est très efficace pour écraser les sabots du Minotoror. Il est tout aussi efficace lorsqu''il s''agit de s''en prendre à d''autres parties du corps, elles aussi très sensibles.
Il peut être échangé auprès de Latem Sa, à l''atelier des forgerons d''Astrub.');
INSERT INTO "item_descriptions" VALUES(11820,'fr','Il a fallu plusieurs siècles pour construire cette pelle à base de poussière de lingots d''or. Très pratique pour couper les têtes de moines ou la tourte de Zoug.');
INSERT INTO "item_descriptions" VALUES(11850,'fr','Ce slip est la tenue de cérémonie des prophètes du S.L.I.P. Ils sont les seuls à pouvoir le porter sans risque de se faire couper la tête, ou tout autre membre sensible de leur anatomie.');
INSERT INTO "item_descriptions" VALUES(11855,'fr','Ces tongues laissent les pieds suffisamment dégagés pour pouvoir ramasser les Kamas avec les orteils. Leur forme est également étudiée pour mettre des coups dans les bourses de vos ennemis afin de vous enrichir plus facilement.');
INSERT INTO "item_descriptions" VALUES(11856,'fr','Munie de deux grosses bourses, cette ceinture vous permettra de vous en mettre plein les poches.');
INSERT INTO "item_descriptions" VALUES(11857,'fr','Cette pelle peut tout faire : creuser la terre, ramasser les kamas, assommer les brigands et même repousser votre belle-mère. Une arme indispensable, donc.
Elle peut être échangée auprès de Latem Sa, à l''atelier des forgerons d''Astrub.');
INSERT INTO "item_descriptions" VALUES(11858,'fr','Ce tofu est tombé dans une marmite de fromage étant petit. Depuis, il est un peu enrobé et subit constamment les moqueries de ses congénères. Qu''à cela ne tienne, il a décidé de s''assumer et de manger toutes les ressources qu''on lui présente.');
INSERT INTO "item_descriptions" VALUES(11947,'fr','Ne vous fiez pas aux apparences, cette hache bon marché peut se révéler très utile pour couper des arbres ou des touristes gelés.');
INSERT INTO "item_descriptions" VALUES(11950,'fr','Craint des autres familiers à cause de sa dentition à faire pâlir un vampire, il a passé son enfance à l''écart des autres et sa sociabilité en a pris un coup, jusqu''à ce que vous l''adoptiez.');
INSERT INTO "item_descriptions" VALUES(11955,'fr','Une fois adulte, ce familier donnera un superbe charme frigostien qui, à l''instar de son cousin d''Amakna, adore les câlins. En attendant, il vous fera plein de bisous pour vous témoigner son affection.');
INSERT INTO "item_descriptions" VALUES(11966,'fr','Ce gentil petit bléro a le poil aussi doux que les fesses d''une mama bwork, mais ne vous y trompez pas. Son caractère lui servait à endormir la méfiance de ses congénères pour mieux les dévorer pendant leur sommeil. Son attitude s''est bonifiée à votre contact puisqu''à présent, il se jette sur n''importe quelle créature, qu''elle soit éveillée ou pas.');
INSERT INTO "item_descriptions" VALUES(11971,'fr','Ce petit glourson s''est échappé du laboratoire du professeur Cœur d''Obsidienne et a été recueilli par Mamie Rexpress. En manque d''affection, il essayera de vous baiser à la moindre occasion. Il est donc recommandé de lui mettre de la crème sur les lèvres pour éviter qu''elles se dessèchent trop vite.');
INSERT INTO "item_descriptions" VALUES(11976,'fr','La plupart des aventuriers trouvent cette amulette particulièrement difficile à porter : non pas à cause de son poids trop élevé, de ses prérequis trop hauts ou de sa puissance trop faible, mais à cause de la moustache qui l''orne. C''est d''ailleurs probablement parce qu''il assume entièrement la sienne que le Boostache est un monstre aussi respecté.');
INSERT INTO "item_descriptions" VALUES(11977,'fr','Le Kanniboul Ebil a eu de nombreuses femmes, toutes plus jolies les unes que les autres. Lui-même disait qu''elles étaient délicieuses. Personne ne sait ce qu''elles sont devenues.');
INSERT INTO "item_descriptions" VALUES(11978,'fr','Peu importe au Boostache d''avoir perdu son anneau, puisqu''il n''a pas de doigts. D''ailleurs la seule chose qui lui importe c''est sa moustache. C''est un bien petit trophée que vous tenez là.');
INSERT INTO "item_descriptions" VALUES(11979,'fr','Le Kanniboul Ebil n''équipe ses bottes que pour affronter les plus valeureux guerriers du monde des Douze. Ce n''est pas demain la veille que vous le verrez les porter face à vous.');
INSERT INTO "item_descriptions" VALUES(11980,'fr','Avec cette cape qui, comme le Boostache, brille dans le noir, vous vous ferez repérer systématiquement lors de vos infiltrations, n''arriverez plus à dormir, et exaspérerez vos proches en soirée. Idéal pour se pimenter l''existence ou se faire passer pour une lumière.');
INSERT INTO "item_descriptions" VALUES(11981,'fr','Enfant, le Boostache ne cessait de jouer à 1, 2, 3, soleil. Encore aujourd''hui, il adore se faufiler dans le dos des aventuriers, s''arrêter net s''ils se retournent, l''air de rien, pour les attaquer sauvagement une fois qu''il a fini par les atteindre. C''est puéril et exaspérant, mais cette technique a fait ses preuves.');
INSERT INTO "item_descriptions" VALUES(11982,'fr','Maintenant que vous savez que le Kanniboul Ebil porte une cagoule sous son masque, cagoule dotée de deux trous pour les yeux, vous comprenez soudainement pourquoi il était si maladroit affublé de son masque de cyclope.');
INSERT INTO "item_descriptions" VALUES(11983,'fr','Entre les mains du Kanniboul Ebil, ce sceptre est doté d''étonnants pouvoirs magiques, capables de faire tomber de grotesques têtes de totem sur les adversaires. Entre les vôtres, il est juste ridicule et ne fera même pas tourner la tête de vos alliés.');
INSERT INTO "item_descriptions" VALUES(12009,'fr','Aussi vieux et coquet qu''une Enutrof, et aussi affectueux que la Déesse Eliatrope, ce Platypus brille de jour comme de nuit. Les contes pour enfants lui donnent pour origine Sufokia et l''élèvent au rang de vestige d''une ancienne civilisation, mais la véracité de ces affirmations n''a jamais été vérifiée.');
INSERT INTO "item_descriptions" VALUES(12018,'fr','À l''instar de ses sujets les Kwaks, le Kwakwa a une lame à son nom. Même si on ne sait toujours pas pourquoi ni en quel honneur un oiseau aurait une épée, celle-ci semble plus légère et plus maniable que les Kwaklames. Vous allez peut-être enfin pouvoir déplumer vos ennemis avec.');
INSERT INTO "item_descriptions" VALUES(12019,'fr','Alors qu''il n''a pas de maître, le Kwakwa a lui aussi un anneau matricule. Il se sert de celui des Kwaks pour les identifier et les retrouver lorsqu''ils se perdent pour les ramener au nid. Il se sert du sien pour qu''on puisse venir le chercher quand il se perd en cherchant les Kwaks perdus. À tourner ainsi en rond, ils ne sont jamais sortis de la montagne des Craqueleurs.');
INSERT INTO "item_descriptions" VALUES(12020,'fr','Pour séduire les Kwakeres, le Kwakwa effectue sa parade nuptiale, qui consiste à faire la roue avec les plumes de sa queue. Il se rend alors profondément ridicule puisqu''il n''en a que cinq. Une parfaite illustration de l''adage "femme qui rit, à moitié dans ton lit".');
INSERT INTO "item_descriptions" VALUES(12021,'fr','Cette coiffe, en plus de couvrir votre crâne d''œuf, vous donnera fière allure et fera peut-être même oublier votre tête de piaf. Que demander de plus ?');
INSERT INTO "item_descriptions" VALUES(12023,'fr','La ceinture de Traçon, bien attachée à son ventre grâce à ses deux sangles, absorbait les vibrations. Couplée à la graisse de sa bedaine, elle permettait à Traçon d''être totalement immunisé aux effets de ses propres attaques.');
INSERT INTO "item_descriptions" VALUES(12024,'fr','Ces lourdes bottes de métal carrées forçaient Traçon, qui savait manipuler les vibrations, à utiliser toute son énergie pour atténuer le bruit qu''elles émettaient. Sans cela, il aurait été possible de l''entendre venir à des kilokamètres à la ronde. De plus, elles l''empêchaient de tirer correctement au boufbowl.');
INSERT INTO "item_descriptions" VALUES(12025,'fr','Traçon ayant l''ouïe très sensible, il avait enlevé l''engrenage principal de sa pendule afin que cesse son tic-tac incessant, pour ensuite porter les rouages en amulette. Chaque personne qu''il croisait lui signalait alors qu''il n''était pas à l''heure, ce qui lui tapait encore plus sur les nerfs que le marteau de Xélor.');
INSERT INTO "item_descriptions" VALUES(12027,'fr','Mirh, comme tout bon percussionniste, ne peut pas s''empêcher de frapper comme un sourd, même pendant son sommeil. Il aura vraisemblablement du mal à se trouver une partenaire un jour qui sache rester en vie auprès de lui.');
INSERT INTO "item_descriptions" VALUES(12028,'fr','Mirh n''a jamais su invoquer de Bouate de Pandore. Pour compenser, il a équipé sa ceinture d''une petite boîte, dans laquelle il conserve différents poisons causant toutes sortes de maux. Hélas, il n''a jamais réussi à les utiliser efficacement sur ses adversaires... Il se sert uniquement de son somnifère sur lui-même quand il n''arrive pas à dormir.');
INSERT INTO "item_descriptions" VALUES(12029,'fr','Mirh se servait parfois de son amulette comme d''un pendule pour s''endormir plus facilement. Mais comme il la lâchait quand il s''assoupissait, le bruit du tambour rebondissant sur le sol le réveillait en fanfare.');
INSERT INTO "item_descriptions" VALUES(12031,'fr','Logram pensait toujours à enlever ses geta avant un combat. Cela datait de l''époque où il se métamourphosait, ses pattes décuplant alors de volume... La douleur est source de saignements et d''enseignements.');
INSERT INTO "item_descriptions" VALUES(12032,'fr','Logram maîtrisait l''art de l''origami et a confectionné la plupart de son équipement en pliant du papier. Cela dit, ce n''est pas parce que vous portez son collier que vous serez capable de contrôler le feu comme un Firefoux. Évitez donc de vous gratter le cou si vous ne voulez pas finir carbonisé... car chacun sait que Logram confondait amulette et allumette.');
INSERT INTO "item_descriptions" VALUES(12033,'fr','La tête de Foux en origami sur l''anneau de Logram lui permettait de projeter des illusions de lui-même, ce qui ne lui a jamais été d''une grande utilité en combat puisqu''il devait rester à courte portée et immobile pour ce faire. Vous réussirez peut-être à impressionner un ou deux badauds avec, mais c''est tout.');
INSERT INTO "item_descriptions" VALUES(12035,'fr','Nul ne sait quelle force mystérieuse maintenait le large slip de Kalkanéus en place sur ses fines jambes d''os. Certaines auraient bien une idée, mais personne n''a voulu le vérifier.');
INSERT INTO "item_descriptions" VALUES(12036,'fr','Kalkanéus ayant une jambe de bois, il n''avait qu''une botte. Il vous suffit donc de la porter, seule, pour adopter la même démarche chaloupée que lui.');
INSERT INTO "item_descriptions" VALUES(12037,'fr','Kalkanéus, malgré le fait qu''il n''avait plus qu''un bras, une jambe et un œil, rencontrait beaucoup de succès auprès de la gent féminine. Il n''avait jamais précisé qu''il était né ainsi et que la seule chose qu''il avait perdue au combat, c''était son pantalon.');
INSERT INTO "item_descriptions" VALUES(12039,'fr','Hichète a déjà été marié. Ça n''a malheureusement pas duré : il n''avait de cesse de pousser sa conjointe à bout. Dos au mur et comme piégée, elle a préféré partir. Pousser, piéger, c''est un peu l''histoire de la vie - et de la mort - d''Hichète.');
INSERT INTO "item_descriptions" VALUES(12040,'fr','Hichète avait beau avoir l''apparence d''un simple Barbroussa, il les surpassait tous en termes de fourberie et de mégalomanie. Même cette ceinture ne pouvait retenir son pantalon lorsqu''il se tordait de rire et se moquait de ses adversaires.');
INSERT INTO "item_descriptions" VALUES(12041,'fr','Hichète, tout fourbe et mauvais joueur qu''il était, a toujours triché au jeu de la barbichette : non seulement il gardait son chapeau pour éviter que l''on voie son visage, mais il remplaçait généralement la tapette par un coup de dague.');
INSERT INTO "item_descriptions" VALUES(12043,'fr','Haku n''a jamais été un Zoth très communicant, préférant de loin les activités d''intérieur à celles d''extérieur. C''est peut-être ce qui lui a valu de vivre si vieux, survivant aux incessants assauts d''aventuriers avides d''étoffes Zoth et de kristalite. Mais il a fini par faire un feumbeule.');
INSERT INTO "item_descriptions" VALUES(12044,'fr','Si Haku était considéré comme un Maître Zoth, ça n''était pas grâce à son statut social, ses études ou ses aptitudes au combat, mais uniquement grâce aux nombreuses et interminables soirées passées en tant que maître de jeu avec ses amis Zoths. Il se gardait bien de le crier sur tous les toits.');
INSERT INTO "item_descriptions" VALUES(12045,'fr','Haku n''a jamais su garder une femme bien longtemps. A chaque fois il avait le sentiment que les aventurières qui l''abordaient n''en voulaient qu''à sa Braguette du Maître Zoth. Situation qui conviendrait très bien à certains.');
INSERT INTO "item_descriptions" VALUES(12057,'fr','Thanos aurait exercé toutes sortes de professions peu recommandables, sergent instructeur, banquier, prêteur sur gage, conteur d''histoires ou encore prophète du S.L.I.P. par intermittence. Ce bâton lui servait à sanctionner ses apprentis et ses auditeurs; pratique quotidienne qui lui permettait de se maintenir en forme.');
INSERT INTO "item_descriptions" VALUES(12068,'fr','Avec cette ceinture, que ce soit dans l''air ou dans l''eau, vous serez capable de générer d''importantes quantités d''énergie. À vous de voir ce que vous en ferez.');
INSERT INTO "item_descriptions" VALUES(12069,'fr','Certains aventuriers présomptueux affirment à qui veut l''entendre qu''on ne dit pas un "Croc Gland" mais un "Croc Blanc". Cette amulette aux crocs noircis vous permettra de leur prouver qu''ils ont tort... Pensez à bien viser sous la ceinture.');
INSERT INTO "item_descriptions" VALUES(12070,'fr','Après réflexion, cette cape que l''on vous a présentée comme une authentique cape en fourrure de Nelween n''en n''est peut-être pas une. Cette dernière ne vous a paru ni bleue, ni brune et encore moins coupée en deux quand vous l''avez vue pour la dernière fois. Vous n''aurez qu''à vous en servir comme descente de lit.');
INSERT INTO "item_descriptions" VALUES(12071,'fr','Ces jolies bottes en cuir deviennent tout à coup moins enthousiasmantes quand on sait que la fourrure qui les orne a été arrachée au cadavre encore fumant d''un Croc Gland mort-vivant.');
INSERT INTO "item_descriptions" VALUES(12072,'fr','La fumée de Nelween préservée dans la boucle de cette ceinture est toujours chargée de magie. Elle vous permettra d''accomplir des miracles, comme éclairer devant vous la nuit et ainsi éviter de coincer n''importe quoi dans votre braguette.');
INSERT INTO "item_descriptions" VALUES(12084,'fr','Les poils présents sur le manche de ce marteau vous garantissent une excellente prise, même au milieu d''une horde de Boufmouths baveux.');
INSERT INTO "item_descriptions" VALUES(12085,'fr','Cet anneau est insupportable pour deux raisons : son odeur de Boufmouth mouillé et ses poils qui n''auront de cesse de vous chatouiller entre les doigts. N''espérez pas l''offrir à votre bien-aimée.');
INSERT INTO "item_descriptions" VALUES(12086,'fr','Réalisée à partir de l''or le plus fin extrait des cornes de Royalmouth, cette bague saura à coup sûr toucher le cœur de qui sait apprécier à leur juste valeur les efforts nécessaires à sa confection.');
INSERT INTO "item_descriptions" VALUES(12087,'fr','Correctement traînée dans la neige, cette cape laissera des traces de cornes pouvant effrayer suffisamment les monstres les plus faibles, mais ne duperont pas longtemps un Royalmouth enragé, qui lui se mettra automatiquement à votre recherche.');
INSERT INTO "item_descriptions" VALUES(12088,'fr','Frigostine, les baguettes, c''est sa spécialité. Celle-ci semble néanmoins légèrement différente des autres, attention à ne pas vous y casser les dents.');
INSERT INTO "item_descriptions" VALUES(12089,'fr','Une fois cette amulette autour du cou, une délicieuse odeur de pâtisserie fumante envoûtera vos sens et vous donnera l''impression d''être plus fort. Mais ce n''est qu''une impression.');
INSERT INTO "item_descriptions" VALUES(12090,'fr','Lorsque vous apprendrez que la chantilly Frigostienne est majoritairement conçue à partir de graisse de Mansot, vous aurez soudain beaucoup moins envie de lécher cet anneau.');
INSERT INTO "item_descriptions" VALUES(12091,'fr','Cette ceinture donnera envie à vos adversaires de croquer vos poignées d''amour. Les techniques modernes de régime sont décidément de plus en plus innovantes.');
INSERT INTO "item_descriptions" VALUES(12092,'fr','Ces bottes permettaient à Frigostine de réduire les pains en miettes. Elles servaient parfois sur les touristes qui ne versaient pas de pourboire. On ne plaisante pas avec le respect sur Frigost.');
INSERT INTO "item_descriptions" VALUES(12093,'fr','D''une excellente facture, cousue de fil d''or, cette cape vous apportera la crédibilité officielle qui vous fait tellement défaut.');
INSERT INTO "item_descriptions" VALUES(12094,'fr','Cet anneau est tout ce qu''il y a de plus officiel, mais il y a fort à parier que l''élue de votre cœur préfèrerait quelque chose de plus rutilant.');
INSERT INTO "item_descriptions" VALUES(12095,'fr','Depuis les nombreuses catastrophes induites par des épingles un peu trop pointues, le Maire Cantile a pour tradition de décorer les meilleurs artisans de Frigost à l''aide de cette amulette.');
INSERT INTO "item_descriptions" VALUES(12096,'fr','Ces bottes font tellement de bruit en marchant que l''on raconte souvent qu''elles ont été lestées de plomb par Lucette Brifian plus connue sous le sobriquet de "Lulu", afin de suivre le Maire Cantile à la trace.');
INSERT INTO "item_descriptions" VALUES(12097,'fr','Selon les prophètes du S.L.I.P, le pouvoir de cinq de ces anneaux combinés permettrait d''invoquer le Seigneur de Lave Inconnu du Public en slip. Encore une élucubration de l''Eca Lebar...');
INSERT INTO "item_descriptions" VALUES(12098,'fr','Cette ceinture est un soutien indispensable à tout prophète du S.L.I.P qui se respecte.');
INSERT INTO "item_descriptions" VALUES(12099,'fr','Ce bâton, extrait des entrailles de l''Obsidiantre, est une véritable relique. Son emplacement ainsi que sa méthode d''obtention font partie des secrets les mieux gardés des prophètes du S.L.I.P, juste après la recette de la tarte aux cailles.');
INSERT INTO "item_descriptions" VALUES(12100,'fr','Le bijoutier ayant confectionné cet anneau a tout juste eu le temps d''ébaucher la tête du Tengu Givrefoux dans un morceau de bois, avant que celui-ci ne le piétine impitoyablement.');
INSERT INTO "item_descriptions" VALUES(12101,'fr','On dit que c''est cette alliance que Guten Tak a tenté d''offrir à sa tendre Kami Givrefoux lors de leur première rencontre. Devant son refus, sa fourrure aurait blanchi de rage.');
INSERT INTO "item_descriptions" VALUES(12102,'fr','On raconte qu''un Frigostien a tenté un jour de domestiquer un bébé Givrefoux, en lui accrochant cette amulette autour du cou. Cela aurait sans doute fonctionné s''il n''avait jeté son dévolu sur un des rejetons de Guten Tak.');
INSERT INTO "item_descriptions" VALUES(12103,'fr','Même si les origines de cet arc demeurent mystérieuses, certains Frigostiens racontent avoir vu Guten Tak l''utiliser pour tricher à qui-lancera-le-stalactite-le-plus-loin.');
INSERT INTO "item_descriptions" VALUES(12104,'fr','Bien qu''elle soit composée d''un minerai très rare, présent uniquement dans certaines mines volcaniques des Crocs de Verre, et qu''elle ait demandé des années de polissage, Waldos FieldChester Potcobble n''a néanmoins jamais eu le courage de l''offrir à Aurore Boréale.');
INSERT INTO "item_descriptions" VALUES(12105,'fr','Aurore accordant une importance capitale à sa ligne, elle mesure chaque matin la longueur des cordons qui dépassent de sa ceinture. Personne n''a encore osé lui dire que le cuir se détendait avec le temps.');
INSERT INTO "item_descriptions" VALUES(12106,'fr','Issue de la haute aristocratie, Aurore fut horrifiée devant l''apparence de la coiffe que son tailleur en chef lui proposa, et le congédia immédiatement. Depuis la glaciation de Frigost cependant, il semblerait qu''il ait repris du service.');
INSERT INTO "item_descriptions" VALUES(12107,'fr','Parce qu''éprise de son projet d''hôtel entièrement creusé dans la glace, les bottes d''Aurore ont été spécialement conçues afin d''isoler ses pieds fragiles du froid. Pour ce qui est de ne pas glisser par contre, elles ne sont pas encore tout à fait au point.');
INSERT INTO "item_descriptions" VALUES(12108,'fr','De moindre facture, cette cape a néanmoins été enchantée par le grand Mage Ax afin de toujours voler de manière héroïque même quand il n''y a pas de vent. Pratique pour parader, le Professeur Xa l''a surtout choisie pour ne pas qu''elle se coince dans ses roues.');
INSERT INTO "item_descriptions" VALUES(12109,'fr','De réputation ladre, on dit que le Professeur Xa aurait confectionné cet anneau à partir d''un simple boulon tombé de sa chaise.');
INSERT INTO "item_descriptions" VALUES(12110,'fr','Le cordonnier ayant confectionné ces bottes étant un plaisantin de mauvais goût, le Professeur Xa l''élimina sans autre forme de procès, et décida de ne plus jamais porter de chaussures.');
INSERT INTO "item_descriptions" VALUES(12111,'fr','Ne vous laissez pas berner par l''apparence quelconque de cette amulette : elle est en fait la clé de la réserve secrète de Cerebios, les céréales favorites du Professeur Xa.');
INSERT INTO "item_descriptions" VALUES(12112,'fr','Qu''est ce que le Professeur Xa pouvait bien faire avec une pelle, me direz-vous ? Outre corriger ses Wolveros un peu trop indisciplinés, il semblerait qu''il l''utilisait également pour creuser la roche, non pas verticalement, mais horizontalement. Sans beaucoup de succès cela dit.');
INSERT INTO "item_descriptions" VALUES(12113,'fr','Trop paresseux pour extraire des diamants , le Glourséleste a préféré chaparder le glaçon d''un pauvre Apériglours pour l''enchâsser sur une bague en miel. Il n''avait pas prévu que le tout puisse fondre en un instant, une fois porté.');
INSERT INTO "item_descriptions" VALUES(12114,'fr','Réplique miniature de la couronne tant convoitée du Glourséleste, vous n''avez pas intérêt à la porter en sa présence, sous peine de déclencher son courroux. Qu''il a large, d''après les Frigostiens, à moins qu''ils ne parlent de son cou roux.');
INSERT INTO "item_descriptions" VALUES(12115,'fr','Il est inscrit sur cette épée que seul celui arrivant à l''extraire de son socle de miel pourrait devenir roi des Gloursons. On dit que le Glourséleste s''est fait aider de nombreux Glouragans, mais le résultat est là.');
INSERT INTO "item_descriptions" VALUES(12116,'fr','On n''a encore jamais vu de feuilles aussi grandes dans tout le périmètre du Mont Torrideau. C''est ce qui rend cette coiffe aussi rare.');
INSERT INTO "item_descriptions" VALUES(12117,'fr','Vu la quantité imposante de fourrure présente sur le dos de la Fuji Givrefoux, ce que vous avez prélevé ne devrait pas changer grand-chose à sa masse corporelle.');
INSERT INTO "item_descriptions" VALUES(12118,'fr','Avec cette coiffe sur la tête, c''est certain, vous allez attirer tous les Mahos Givrefoux en rut. A vous de voir si c''est précisément ce que vous voulez.');
INSERT INTO "item_descriptions" VALUES(12119,'fr','Le cuir de Givrefoux est reconnu pour être extrêmement résistant, mais son odeur insoutenable rebute même les meilleurs cordonniers. Avec le cuir de la Fuji Givrefoux, cet inconvénient est atténué, mais d''autres effets secondaires sont à prévoir.');
INSERT INTO "item_descriptions" VALUES(12120,'fr','Avant d''être la génitrice de tous les Givrefoux, la Fuji Givrefoux portait cet anneau comme une ceinture. De nos jours, il va parfaitement à ses doigts boudinés. Ainsi qu''aux vôtres.');
INSERT INTO "item_descriptions" VALUES(12133,'fr','Serpète n''a pas été gâté par la nature. Raillé par ses semblables à cause de son œil unique, il n''a aussi qu''un seul croc, qui s''est toutefois révélé très pratique pour cueillir des fleurs, des plantes, et les crânes de tous ceux qui ont osé se moquer de lui.');
INSERT INTO "item_descriptions" VALUES(12177,'fr','Aussi contradictoire que cela puisse paraître, Tofüm est un très gentil tofu maléfique. Sans pitié ni remords, il exterminera avec vous tout ce qui rampe, marche, vole ou nage, et il s''en délectera. Qui se ressemble s''assemble : vous avez la même définition de la gentillesse, il est donc normal que vous ayez sympathisé.');
INSERT INTO "item_descriptions" VALUES(12237,'fr','Confectionnée par Songrand de Nohto, cette amulette symbolise l''amour passionnel. En la portant, vous passerez de ballotin un jour à ballotin toujours.');
INSERT INTO "item_descriptions" VALUES(12238,'fr','Confectionnée par Songrand de Nohto, cette amulette symbolise l''amour passionnel. En la portant, vous passerez de ballotine un jour à ballotine toujours.');
INSERT INTO "item_descriptions" VALUES(12370,'fr','Poussez. Poussez encore. Toujours rien ? On vous avait pourtant dit de mettre cette amulette autour de votre cOu.');
INSERT INTO "item_descriptions" VALUES(12371,'fr','Enroulée autour de la taille et passée entre les jambes, cette cape mettra vos bourrelets en valeur.');
INSERT INTO "item_descriptions" VALUES(12372,'fr','Excellent pour protéger vos mains lors d''une séance de distribution de baffes, ce gantelet peut ensuite être essoré pour récupérer la graisse nécessaire à la confection de rillettes de Dragon Cochon.');
INSERT INTO "item_descriptions" VALUES(12373,'fr','En portant ces bottes, vous pourrez faire vibrer le sol en tapant du pied, ce qui ne manquera pas d''émoustiller toutes les Porkasses du quartier. Un moyen pas cher mais dangereux de se trouver une compagne.');
INSERT INTO "item_descriptions" VALUES(12379,'fr','En enfilant ce bracelet, vous aurez l''impression de revivre votre dernière rencontre avec Fuji, l''humidité en moins. A noter que vous pouvez aussi le mettre autour du poignet.');
INSERT INTO "item_descriptions" VALUES(12380,'fr','Vous ne voyez aucun différence entre ces bottes et vos pieds mais c''est pourtant évident : ces bottes sentent bon.');
INSERT INTO "item_descriptions" VALUES(12385,'fr','Le crâne dessiné sur le foulard des Roublards leur permet de se faire passer pour mort afin de mieux surprendre les adversaires simples d''esprits, comme les Tofus ou les Iops. On signale cependant des effets secondaires lorsqu''il est porté dans un cimetière pendant la saison des amours des Chafers.');
INSERT INTO "item_descriptions" VALUES(12386,'fr','Dérivé du Masque du Marwal, le Masque Arpone sent moins fort mais malheureusement, sa puissance en est d''autant diminuée. Il convient donc pour accompagner toutes sortes d''équipements et se marie très bien avec la Tiare à Missou.');
INSERT INTO "item_descriptions" VALUES(12387,'fr','Vil Smisse fut le premier à user du subterfuge de cette cape, ce qui lui sauva la vie à maintes reprises, notamment la fois où il fut pendu par les orteils. Depuis, les Roublards condamnés à mort ont pris l''habitude de l''imiter.');
INSERT INTO "item_descriptions" VALUES(12388,'fr','Les Zobals aiment combattre en musique et se servent de cette cape pour battre la mesure. Ils s''en servent aussi pour battre leurs enfants lorsqu''ils ne sont pas sages.');
INSERT INTO "item_descriptions" VALUES(12389,'fr','Les Roublards sont si rusés qu''ils cachent leurs plans machiavéliques et leurs ordres de mission dans leurs bottes. En effet, qui prendrait le risque de libérer des effluves pestilentielles en retirant ses bottes à un cadavre de Roublard ?');
INSERT INTO "item_descriptions" VALUES(12390,'fr','Avez-vous déjà combattu en faisant des acrobaties avec des sabots en guise de chaussures ? Essayez et vous saurez alors ce qu''est un sabotage.');
INSERT INTO "item_descriptions" VALUES(12391,'fr','Utile pour accrocher les bombes, évitez de la secouer si vous ne voulez pas finir en fée d''artifice.');
INSERT INTO "item_descriptions" VALUES(12392,'fr','Pour savoir si un Zobal était digne de porter son premier masque, une ancienne coutume consistait à ligoter les deux prétendants entre eux et à les plonger la tête en bas dans un tonneau de bière bwork. Le premier qui en sortait gagnait son masque et conservait les liens comme symbole de son passage à l''âge adulte. Même si cette coutume a disparu, les Zobals continuent de confectionner des ceintures en sa mémoire.');
INSERT INTO "item_descriptions" VALUES(12393,'fr','Ces mitaines furent longtemps portées par la Roublarde-magicienne Lina qui renforçait ses bombes à l''aide de la magie noire dans le but de créer des explosifs tueurs de dragon. Aujourd''hui encore, elles restent imprégnées de sa puissance.');
INSERT INTO "item_descriptions" VALUES(12394,'fr','Il paraît que ce bracelet vous fera entrer dans l''histoire. Il paraît aussi qu''il fera de vous le plus populaire des Zobals. Il paraît même que des idiots le croient et que les illettrés le croivent.');
INSERT INTO "item_descriptions" VALUES(12407,'fr','Cette amulette est le trophée montrant que vous avez décimé des hordes de Krokilles à peine matures. Evitez simplement de rendre compte de cet infanticide de masse à leurs pères, Grozilla et Grasmera : eux ne sont plus tout à fait juvéniles.');
INSERT INTO "item_descriptions" VALUES(12408,'fr','En demandant à votre bijoutier de vous confectionner cette amulette, vous pensiez que le bézoard qui l''orne finirait par refroidir. Malheureusement il est toujours aussi ardent : il s''enflamme à chaque courant d''air, et vous ferait bouillir vif si vous aviez l''audace de vouloir prendre un bain avec. La rançon de la gloire.');
INSERT INTO "item_descriptions" VALUES(12409,'fr','Cette boussole enchâssée sur un anneau se révèle très pratique pour retrouver le chemin de votre doux foyer après que tous vos amis se soient fait massacrer par des Krokilles enragées.');
INSERT INTO "item_descriptions" VALUES(12410,'fr','Autrefois, on donnait ce bracelet aux touristes visitant Vulkania pour s''assurer qu''ils ne se rendent pas sur l''île deux fois de suite avec un seul laisser-passer. L''office du tourisme Vulkain a vite arrêté sa distribution voyant que personne n''essayait jamais de revenir sur Vulkania. D''ailleurs personne n''en repartait non plus, en témoigne le cimetière de l''île.');
INSERT INTO "item_descriptions" VALUES(12411,'fr','Ces bottes, confectionnées à partir des restes de dizaines de Krokilles Juvéniles, sont très à la mode en dehors de Vulkania. En dedans, elles sont parfaites pour les expéditions suicidaires parmi les Krokilles Vénérables, qui prendront un soin tout particulier à venger leurs cadettes en bonne et due forme.');
INSERT INTO "item_descriptions" VALUES(12412,'fr','Le fait que Grozilla ait des bottes à son nom peut sembler ironique quand on connaît l''oisiveté dont il fait preuve depuis qu''il s''est installé sur Vulkania avec Grasmera. Ceci dit qui n''en ferait pas de même s''il était sur une île paradisiaque, en charmante compagnie, et livré en nourriture exotique à longueur de temps ?');
INSERT INTO "item_descriptions" VALUES(12413,'fr','La cape du Krokilleur est le pêché mignon des artisans Vulkains, qui adorent voir les aventuriers courir avec : la dure et lourde cape leur tape sur les mollets, leur fêle les omoplates et les fait tomber en arrière.');
INSERT INTO "item_descriptions" VALUES(12414,'fr','Ce sac sur le dos, vous voilà paré pour explorer Vulkania en toute sécurité. Attention, les artisans Vulkains ne donnent aucune garantie concernant son efficacité en dehors du port de Vulkania... bien que certains prétendent qu''un S.V.P.P.V. bien garni peut s''avérer indispensable quand on a la dalle et que l''on veut casser la croûte dans un coin.');
INSERT INTO "item_descriptions" VALUES(12415,'fr','La ceinture du Krokilleur est traditionellement passée aux adolescents Vulkains et devient impossible à enlever une fois ceux-ci devenus adultes, pour les forcer à se maintenir en bonne forme s''ils ne veulent pas qu''elle leur entame la chair. Vous n''aurez qu''à la passer à votre cuisse. Ou plutôt à votre mollet.');
INSERT INTO "item_descriptions" VALUES(12416,'fr','Les moeurs de Grozilla et de Grasmera envers les Dragueuses ont toujours été source de grands débats, scandalisant les aventurières et rendant les aventuriers admiratifs. Cette ceinture et son énorme... boucle sont devenues un moyen pour ces derniers de se proclamer de la même philosophie. Jusqu''ici sans le moindre succès, au contraire.');
INSERT INTO "item_descriptions" VALUES(12417,'fr','Ce chapeau vous donnera l''air d''un chasseur venu de sauvages contrées, faisant de vos adversaires des enfants apeurés. En tout cas c''est ce qu''un dénommé Pan Velt affirmait à qui voulait bien l''entendre.');
INSERT INTO "item_descriptions" VALUES(12418,'fr','Avec cette coiffe sur le crâne, vous comptez bien montrer à tout le monde que vous avez vaincu le terrible Grozilla. En pratique, tout ce que vous pourrez faire avec sera traumatiser des enfants, et jouer la mascotte pour votre équipe de Boufbowl préférée.');
INSERT INTO "item_descriptions" VALUES(12421,'fr','A la différence de la cape ou du marteau Tétriste, l''orientation de cette amulette reste la même quel que soit le sens dans lequel vous la tournez. Votre torticolis s''en souviendra.');
INSERT INTO "item_descriptions" VALUES(12423,'fr','Cet anneau magique, si vous le laissez tomber, ralentit seul sa chute en tombant par accoups.');
INSERT INTO "item_descriptions" VALUES(12463,'fr','Personne ne sait pourquoi les bretelles de ce slip sont aussi longues. A-t-il appartenu au corpulent Rushu ? A-t-il servi comme catapulte lors de la bataille de l''Aurore Pourpre ? Toujours est-il qu''il s''en dégage quelque chose de malsain.');
INSERT INTO "item_descriptions" VALUES(12465,'fr','Ces souliers vernis sont à la pointe de la mode dans les contrées les plus reculées du monde des douze. En Amakna, en revanche, vous risquez fort de passer pour un immigrant aux moeurs peu orthodoxes.');
INSERT INTO "item_descriptions" VALUES(12466,'fr','Le Boracelet est à la base un simple bracelet en plastique noir. Pourtant son créateur a réussi à en faire un succès commercial conséquent en lui inventant des usages tous plus loufoques les uns que les autres, voire un peu douteux, que la morale nous empêche de détailler ici.');
INSERT INTO "item_descriptions" VALUES(12502,'fr','Cette ceinture a été confectionnée pour être parfaitement assortie avec l''arme fétiche de Pandalida, le Sabre Ayassalama. À la base de simples ornements, le sabre a prouvé son efficacité au combat. Pas cette ceinture brodée de pièces d''or et le vacarme qu''elle fait à chaque mouvement de son porteur.');
INSERT INTO "item_descriptions" VALUES(12512,'fr','Tout mastiqueur qui se respecte sait qu''il ne faut pas récolter la gomme de l''arbre Rabalam à mains nues, sous peine de se retrouver les doigts collés à l''écorce et de rester planté là sans pouvoir se gratter le nez.');
INSERT INTO "item_descriptions" VALUES(1012541,'fr','Récompense des aventuriers s''étant illustrés en terrassant à plusieurs reprises Grozilla et Grasmera durant leur cycle de torpeur, ce Dragouf fait fureur auprès de la populace Astrubienne.');
INSERT INTO "item_descriptions" VALUES(12598,'fr','Cet anneau était autrefois le sceau du général de l''armée d''une lointaine contrée ayant voulu envahir Amakna. Ils ont été repoussés extrêmement facilement à cause de gros défauts tactiques : leurs troupes s''approchaient en se déplaçant en largeur des champs de bataille, n''avançant que très peu, au lieu d''avancer en ligne droite. Ce furent les cibles les plus faciles qu''aient jamais connu l''armée d''Allister.');
INSERT INTO "item_descriptions" VALUES(12599,'fr','Équipé de cette ceinture, vous vous sentez l''âme d''un héros, capable de décimer toute une armée à vous seul. Reste à trouver une armée qui veuille bien se laisser faire.');
INSERT INTO "item_descriptions" VALUES(12622,'fr','Ce Trophée permet de garder les pleutres à proximité. Pour mieux les piétiner.');
INSERT INTO "item_descriptions" VALUES(12623,'fr','Ce Trophée permet de garder les pleutres à proximité. Pour mieux les piétiner.');
INSERT INTO "item_descriptions" VALUES(12624,'fr','Ce Trophée permet de garder les pleutres à proximité. Pour mieux les piétiner.');
INSERT INTO "item_descriptions" VALUES(12625,'fr','Ce Trophée permet de se sauver au bon comme au mauvais moment.');
INSERT INTO "item_descriptions" VALUES(12626,'fr','Ce Trophée permet de se sauver au bon comme au mauvais moment.');
INSERT INTO "item_descriptions" VALUES(12627,'fr','Ce Trophée permet de se sauver au bon comme au mauvais moment.');
INSERT INTO "item_descriptions" VALUES(12628,'fr','Ce Trophée permet de mieux ralentir les déplacements des adversaires pour les rattraper plus rapidement et leur infliger une humiliation méritée, comme une fessée culotée par exemple.');
INSERT INTO "item_descriptions" VALUES(12629,'fr','Ce Trophée permet de mieux ralentir les déplacements des adversaires pour les rattraper plus rapidement et leur infliger une humiliation méritée, comme une fessée culotée par exemple.');
INSERT INTO "item_descriptions" VALUES(12630,'fr','Ce Trophée permet de mieux ralentir les déplacements des adversaires pour les rattraper plus rapidement et leur infliger une humiliation méritée, comme une fessée culotée par exemple.');
INSERT INTO "item_descriptions" VALUES(12631,'fr','Ce Trophée permet d''engourdir plus facilement les dégourdis. Il semble fonctionner sur les gourdes également.');
INSERT INTO "item_descriptions" VALUES(12632,'fr','Ce Trophée permet d''engourdir plus facilement les dégourdis. Il semble fonctionner sur les gourdes également.');
INSERT INTO "item_descriptions" VALUES(12633,'fr','Ce Trophée permet d''engourdir plus facilement les dégourdis. Il semble fonctionner sur les gourdes également.');
INSERT INTO "item_descriptions" VALUES(12634,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de vous empêcher d''atteindre votre destination. Ne fonctionne pas contre ceux qui vous empêchent d''atteindre votre destinée.');
INSERT INTO "item_descriptions" VALUES(12635,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de vous empêcher d''atteindre votre destination. Ne fonctionne pas contre ceux qui vous empêchent d''atteindre votre destinée.');
INSERT INTO "item_descriptions" VALUES(12636,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de vous empêcher d''atteindre votre destination. Ne fonctionne pas contre ceux qui vous empêchent d''atteindre votre destinée.');
INSERT INTO "item_descriptions" VALUES(12637,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de limiter vos actions. Ne fonctionne pas contre les banquiers.');
INSERT INTO "item_descriptions" VALUES(12638,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de limiter vos actions. Ne fonctionne pas contre les banquiers.');
INSERT INTO "item_descriptions" VALUES(12639,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de limiter vos actions. Ne fonctionne pas contre les banquiers.');
INSERT INTO "item_descriptions" VALUES(12640,'fr','Ce Trophée permet de faire un peu plus mal à vos adversaires lorsque vous les poussez contre un arbre, du marbre ou un autre adversaire glabre.');
INSERT INTO "item_descriptions" VALUES(12641,'fr','Ce Trophée permet de faire un peu plus mal à vos adversaires lorsque vous les poussez contre un arbre, du marbre ou un autre adversaire glabre.');
INSERT INTO "item_descriptions" VALUES(12642,'fr','Ce Trophée permet de faire un peu plus mal à vos adversaires lorsque vous les poussez contre un arbre, du marbre ou un autre adversaire glabre.');
INSERT INTO "item_descriptions" VALUES(12643,'fr','Ce Trophée permet de moins souffrir lorsque vos adversaires ou vos alliés vous poussent contre un arbre, une personne, une bestiole ou encore tout simplement un gros truc dur. Ne protège pas des gifles même celles prodiguées par des mains calleuses.');
INSERT INTO "item_descriptions" VALUES(12644,'fr','Ce Trophée permet de moins souffrir lorsque vos adversaires ou vos alliés vous poussent contre un arbre, une personne, une bestiole ou encore tout simplement un gros truc dur. Ne protège pas des gifles même celles prodiguées par des mains calleuses.');
INSERT INTO "item_descriptions" VALUES(12645,'fr','Ce Trophée permet de moins souffrir lorsque vos adversaires ou vos alliés vous poussent contre un arbre, une personne, une bestiole ou encore tout simplement un gros truc dur. Ne protège pas des gifles même celles prodiguées par des mains calleuses.');
INSERT INTO "item_descriptions" VALUES(12646,'fr','Ce Trophée protège des coups critiques dans les endroits critiques lors des situations critiques. Une fois équipé, vous subirez un effet secondaire désagréable pour vos proches : vous ne subirez plus la critique.');
INSERT INTO "item_descriptions" VALUES(12647,'fr','Ce Trophée protège des coups critiques dans les endroits critiques lors des situations critiques. Une fois équipé, vous subirez un effet secondaire désagréable pour vos proches : vous ne subirez plus la critique.');
INSERT INTO "item_descriptions" VALUES(12648,'fr','Ce Trophée protège des coups critiques dans les endroits critiques lors des situations critiques. Une fois équipé, vous subirez un effet secondaire désagréable pour vos proches : vous ne subirez plus la critique.');
INSERT INTO "item_descriptions" VALUES(12649,'fr','Ce Trophée protège des attaques d''élément Air mais pas des courants d''air.');
INSERT INTO "item_descriptions" VALUES(12650,'fr','Ce Trophée protège des attaques d''élément Air mais pas des courants d''air.');
INSERT INTO "item_descriptions" VALUES(12651,'fr','Ce Trophée protège des attaques d''élément Air mais pas des courants d''air.');
INSERT INTO "item_descriptions" VALUES(12652,'fr','Ce Trophée protège des attaques d''élément Eau mais pas des attaques de chasses d''eau.');
INSERT INTO "item_descriptions" VALUES(12653,'fr','Ce Trophée protège des attaques d''élément Eau mais pas des attaques de chasses d''eau.');
INSERT INTO "item_descriptions" VALUES(12654,'fr','Ce Trophée protège des attaques d''élément Eau mais pas des attaques de chasses d''eau.');
INSERT INTO "item_descriptions" VALUES(12657,'fr','Étrangement, les bijoutiers qui créent cette amulette poilue, ornée d''un museau de rat et d''oreilles repoussantes, refusent systématiquement de la signer. Et on ne peut pas vraiment les en blâmer.');
INSERT INTO "item_descriptions" VALUES(12658,'fr','Seuls les aventuriers d''un âge avancé comprennent pourquoi le symbole qui orne ce bracelet est celui d''une patte de félin alors que les objets qui lui sont associés représentent davantage un rat. Fourbes comme ils sont, ils se gardent bien de l''expliquer. Ou sont-ils déjà devenus séniles ?');
INSERT INTO "item_descriptions" VALUES(12659,'fr','Ce Trophée protège des attaques d''élément Feu mais pas des Feux de l''amour.');
INSERT INTO "item_descriptions" VALUES(12660,'fr','Ce bouclier affiche aux yeux de tous que vous avez quitté Incarnam et rejoint le Monde des Douze pour vous lancer dans la longue quête des Dofus.');
INSERT INTO "item_descriptions" VALUES(12661,'fr','Ce petit sac créé par Poss''Ybel fait fureur sur Incarnam. Les aventurières le trouvent aussi pratique qu''élégant ; les aventuriers endurcis s''en servent pour conserver les dents arrachées à leurs ennemis.');
INSERT INTO "item_descriptions" VALUES(12671,'fr','La note de musique qui orne la ceinture de Danioule est en fait un bouton qui, activé, lance un S.O.S. partant dans les airs, signalant un terrien en détresse aux planètes environnantes. Peut-être que le tragique accident de Scaéroplane de Danioule aurait pu être évité si elle l''avait envoyé en Amakna à la place.');
INSERT INTO "item_descriptions" VALUES(12672,'fr','Toujours à la pointe de la mode paysanne, Danioule est le père de cet hybride entre sabot et bottes qui combine le rusticisme et la solidité du sabot ainsi que la protection et la praticité des bottes. Il n''a cessé de batailler pour son adoption, allant jusqu''à les qualifier de "fruit de ses entrailles". Ce qui a probablement passé l''envie à qui que ce soit de les porter.');
INSERT INTO "item_descriptions" VALUES(12674,'fr','Vous venez d''adopter la même coiffure que celle que porte Daïgoro depuis sa plus tendre enfance. En revanche vous n''avez pas son excuse : lui n''a eu personne pour lui dire qu''elle est désormais démodée depuis une bonne décennie.');
INSERT INTO "item_descriptions" VALUES(12675,'fr','Daïgoro a récupéré ce collier de perles couleur sang sur la dépouille du chef des Kitsous ayant attaqué son village jadis, Red. Espérez que personne ne vous demande où vous avez récupéré le vôtre : avouer que vous en avez simplement demandé une copie à votre bijoutier ne vous fera pas passer pour un maître du Pandawushu.');
INSERT INTO "item_descriptions" VALUES(12676,'fr','Ce pagne porte les stigmates de l''entraînement acharné que s''est imposé Daïgoro des années durant dans le seul but de parvenir à vaincre Zatoïshwan un jour. Étonnamment, il ne sent le renfermé que depuis que vous l''avez enfilé.');
INSERT INTO "item_descriptions" VALUES(12677,'fr','Daïgoro s''est fabriqué ce bâton à partir des restes encore fumants de son village, après sa destruction. Il a bien failli pouvoir s''en créer un autre à partir des vôtres.');
INSERT INTO "item_descriptions" VALUES(12678,'fr','Ce Trophée protège des attaques d''élément Feu mais pas des Feux de l''amour.');
INSERT INTO "item_descriptions" VALUES(12679,'fr','Ce Trophée protège des attaques d''élément Feu mais pas des Feux de l''amour.');
INSERT INTO "item_descriptions" VALUES(12680,'fr','Ce Trophée protège des attaques d''élément Terre sauf si vous vous trouvez dans la terre du milieu.');
INSERT INTO "item_descriptions" VALUES(12681,'fr','Ce Trophée protège des attaques d''élément Terre sauf si vous vous trouvez dans la terre du milieu.');
INSERT INTO "item_descriptions" VALUES(12682,'fr','Ce Trophée protège des attaques d''élément Terre sauf si vous vous trouvez dans la terre du milieu.');
INSERT INTO "item_descriptions" VALUES(12683,'fr','Ce Trophée protège des attaques d''élément Neutre mais n''empêchera pas vos adversaires de sortir de leur neutralité lorsque les hostilités débuteront.');
INSERT INTO "item_descriptions" VALUES(12684,'fr','Ce Trophée protège des attaques d''élément Neutre mais n''empêchera pas vos adversaires de sortir de leur neutralité lorsque les hostilités débuteront.');
INSERT INTO "item_descriptions" VALUES(12685,'fr','Ce Trophée protège des attaques d''élément Neutre mais n''empêchera pas vos adversaires de sortir de leur neutralité lorsque les hostilités débuteront.');
INSERT INTO "item_descriptions" VALUES(12686,'fr','Ce Trophée augmente les dommages d''élément Air de ceux qui ne manquent pas d''air.');
INSERT INTO "item_descriptions" VALUES(12687,'fr','Ce Trophée augmente les dommages d''élément Air de ceux qui ne manquent pas d''air.');
INSERT INTO "item_descriptions" VALUES(12688,'fr','Ce Trophée augmente les dommages d''élément Air de ceux qui ne manquent pas d''air.');
INSERT INTO "item_descriptions" VALUES(12689,'fr','Ce Trophée augmente les dommages d''élément Eau mais il reste inutile si vous désirez mettre de l''eau dans votre vin.');
INSERT INTO "item_descriptions" VALUES(12690,'fr','Ce Trophée augmente les dommages d''élément Eau mais il reste inutile si vous désirez mettre de l''eau dans votre vin.');
INSERT INTO "item_descriptions" VALUES(12691,'fr','Ce Trophée augmente les dommages d''élément Eau mais il reste inutile si vous désirez mettre de l''eau dans votre vin.');
INSERT INTO "item_descriptions" VALUES(12692,'fr','Ce Trophée augmente les dommages d''élément Feu. L''étiquette qui y était accrochée indiquait : « Grâce à lui vous êtes tout feu tout flamme et le cœur de votre ennemi s''enflamme ».');
INSERT INTO "item_descriptions" VALUES(12693,'fr','Ce Trophée augmente les dommages d''élément Feu. L''étiquette qui y était accrochée indiquait : « Grâce à lui vous êtes tout feu tout flamme et le cœur de votre ennemi s''enflamme ».');
INSERT INTO "item_descriptions" VALUES(12694,'fr','Ce Trophée augmente les dommages d''élément Feu. L''étiquette qui y était accrochée indiquait : « Grâce à lui vous êtes tout feu tout flamme et le cœur de votre ennemi s''enflamme ».');
INSERT INTO "item_descriptions" VALUES(12695,'fr','Ce trophée augmente les dommages d''élément Neutre. Il a été imaginé par un célèbre forgeur de hache : Giuseppe Hacheneutre.');
INSERT INTO "item_descriptions" VALUES(12696,'fr','Ce trophée augmente les dommages d''élément Neutre. Il a été imaginé par un célèbre forgeur de hache : Giuseppe Hacheneutre.');
INSERT INTO "item_descriptions" VALUES(12697,'fr','Ce trophée augmente les dommages d''élément Neutre. Il a été imaginé par un célèbre forgeur de hache : Giuseppe Hacheneutre.');
INSERT INTO "item_descriptions" VALUES(12698,'fr','Ce Trophée augmente les dommages d''élément Terre. Seuls les vers de Terre seront impressionnés.');
INSERT INTO "item_descriptions" VALUES(12701,'fr','Ce Trophée permet d''augmenter l''initiative à défaut d''en prendre.');
INSERT INTO "item_descriptions" VALUES(12702,'fr','Ce Trophée permet d''augmenter l''initiative à défaut d''en prendre.');
INSERT INTO "item_descriptions" VALUES(12703,'fr','Ce Trophée permet d''augmenter l''initiative à défaut d''en prendre.');
INSERT INTO "item_descriptions" VALUES(12704,'fr','Ce Trophée permet d''augmenter le poids maximum portable. Mais il n''est pas assez puissant pour vous aider à supporter le poids de votre conscience.');
INSERT INTO "item_descriptions" VALUES(12705,'fr','Ce Trophée permet d''augmenter le poids maximum portable. Mais il n''est pas assez puissant pour vous aider à supporter le poids de votre conscience.');
INSERT INTO "item_descriptions" VALUES(12706,'fr','Ce trophée permet d''augmenter le poids maximum portable. Mais il n''est pas assez puissant pour vous aider à supporter le poids de votre conscience.');
INSERT INTO "item_descriptions" VALUES(12707,'fr','Ce Trophée permet d''augmenter les soins. Ce n''est pas avec ça que vous aurez l''air viril.');
INSERT INTO "item_descriptions" VALUES(12708,'fr','Ce Trophée permet d''augmenter les soins. Ce n''est pas avec ça que vous aurez l''air viril.');
INSERT INTO "item_descriptions" VALUES(12709,'fr','Ce Trophée permet d''augmenter les soins. Ce n''est pas avec ça que vous aurez l''air viril.');
INSERT INTO "item_descriptions" VALUES(12712,'fr','Ce Trophée permet d''augmenter son Agilité. Vous allez enfin réussir à monter sur une échelle sans tomber.');
INSERT INTO "item_descriptions" VALUES(12713,'fr','Ce Trophée permet d''augmenter son Agilité. Vous allez enfin réussir à monter sur une échelle sans tomber.');
INSERT INTO "item_descriptions" VALUES(12714,'fr','Ce Trophée permet d''augmenter son Agilité. Vous allez enfin réussir à monter sur une échelle sans tomber.');
INSERT INTO "item_descriptions" VALUES(12715,'fr','Ce Trophée permet d''augmenter sa Chance. Il ne semble pas fonctionner pour les tentatives de séduction désespérées.');
INSERT INTO "item_descriptions" VALUES(12716,'fr','Ce Trophée permet d''augmenter sa Chance. Il ne semble pas fonctionner pour les tentatives de séduction désespérées.');
INSERT INTO "item_descriptions" VALUES(12717,'fr','Ce Trophée permet d''augmenter sa Chance. Il ne semble pas fonctionner pour les tentatives de séduction désespérées.');
INSERT INTO "item_descriptions" VALUES(12718,'fr','Ce Trophée permet d''augmenter l''Intelligence. Mais pourquoi n''est-il pas offert aux vendeurs à la criée du Zaap d''Astrub ?');
INSERT INTO "item_descriptions" VALUES(12719,'fr','Ce Trophée permet d''augmenter l''Intelligence. Mais pourquoi n''est-il pas offert aux vendeurs à la criée du Zaap d''Astrub ?');
INSERT INTO "item_descriptions" VALUES(12720,'fr','Ce Trophée permet d''augmenter l''Intelligence. Mais pourquoi n''est-il pas offert aux vendeurs à la criée du Zaap d''Astrub ?');
INSERT INTO "item_descriptions" VALUES(12722,'fr','Ce Trophée permet d''augmenter la Force. Attention cet objet ne peut pas convenir pour remplacer un cerveau déficient.');
INSERT INTO "item_descriptions" VALUES(12723,'fr','Ce Trophée permet d''augmenter la Force. Attention cet objet ne peut pas convenir pour remplacer un cerveau déficient.');
INSERT INTO "item_descriptions" VALUES(12724,'fr','Ce Trophée permet d''augmenter la Force. Attention cet objet ne peut pas convenir pour remplacer un cerveau déficient.');
INSERT INTO "item_descriptions" VALUES(12725,'fr','Ce Trophée permet d''augmenter la Vitalité. Ses effets contre l''impuissance n''ont jamais pu être prouvés.');
INSERT INTO "item_descriptions" VALUES(12726,'fr','Ce Trophée permet d''augmenter la Vitalité. Ses effets contre l''impuissance n''ont jamais pu être prouvés.');
INSERT INTO "item_descriptions" VALUES(12727,'fr','Ce Trophée permet d''augmenter la Vitalité. Ses effets contre l''impuissance n''ont jamais pu être prouvés.');
INSERT INTO "item_descriptions" VALUES(12747,'fr','Ce Trophée augmente les dommages d''élément Terre. Seuls les vers de Terre seront impressionnés.');
INSERT INTO "item_descriptions" VALUES(12748,'fr','Ce Trophée augmente les dommages d''élément Terre. Seuls les vers de Terre seront impressionnés.');
INSERT INTO "item_descriptions" VALUES(12753,'fr','La balle entre les deux bandes du Ceinturong se déplace autour de celui-ci inexorablement, malaxant sans cesse vos poignées d''amour. Assez ridicule, pas vraiment glamour et plutôt désagréable. Mais il paraît que ça fait maigrir, alors pour vous, c''est forcément bon à prendre.');
INSERT INTO "item_descriptions" VALUES(12754,'fr','Ce que vous avez autour du cou est une version miniature de l''Amulettong originelle, qui était aussi haute et massive qu''un Abraknyde. Après plusieurs cas de nuques brisées et un succès mitigé, son créateur a eu la bonne idée d''en faire une version portable, qui a eu le succès qu''on lui connaît aujourd''hui.');
INSERT INTO "item_descriptions" VALUES(12756,'fr','Il ne faut surtout pas donner cette amulette à un enfant : il serait tenté de mastiquer les fantômes qui l''ornent, ce qui le tuerait instantanément. Bizarrement, mâcher une gomme spéciale permettrait de faire de ces dangereux fantômes un mets délicieux et inoffensif.');
INSERT INTO "item_descriptions" VALUES(12757,'fr','Ces bottes sont capables d''engloutir tout ce dans quoi l''on donne des coups de pied avec. En recevoir un coup entre les jambes est le pire cauchemar des aventuriers masculins.');
INSERT INTO "item_descriptions" VALUES(12774,'fr','Ces bottes équipées de raquettes en bois vous suivront à la trace. Elles sont résistantes aux sucs digestifs et à l''humour le plus corrosif.');
INSERT INTO "item_descriptions" VALUES(12775,'fr','Cette ceinture en bois permet de contenir les ventres rebondis ou de protéger les nombrils des coups critiques.');
INSERT INTO "item_descriptions" VALUES(12848,'fr','Ce manteau est une contradiction en soi. En effet, on le porte pour ne plus greloter mais on grelote quand même à cause des nombreux grelots accrochés à ses extrémités.');
INSERT INTO "item_descriptions" VALUES(12849,'fr','Avec ce bonnet sur la tête, vous offrez à vos compagnons une bonne excuse de vous sonner les cloches.');
INSERT INTO "item_descriptions" VALUES(12850,'fr','Ce caleçon gardera votre virilité bien au chaud et, grâce à des grelots savamment placés, informera votre entourage lorsqu''une demoiselle vous plaira.');
INSERT INTO "item_descriptions" VALUES(12851,'fr','Les glutins ont transformés ce hochet de bébé en un magnifique bracelet. En le secouant vivement, vous aurez une chance de couvrir les hurlements des touristes Astrubiens.');
INSERT INTO "item_descriptions" VALUES(12852,'fr','Jack aurait aimé être un vampire mais il dut se contenter toute sa vie d''être relégué au rang de squelette. Pour avoir un minimum de classe, il se fit confectionner cette cape.');
INSERT INTO "item_descriptions" VALUES(12853,'fr','La sournoiserie de Jack était telle qu''il avait eu l''idée saugrenue de se déguiser en lui-même pour accomplir ses méfaits et brouiller les pistes. En portant ce masque, vous pourrez faire de même, à condition d''être un Sram.');
INSERT INTO "item_descriptions" VALUES(12854,'fr','Jack était un Sram friand de farces et friandises. Il passait donc le plus clair de son temps à frapper aux portes des habitations pour obtenir des bonbons, jusqu''au jour où il frappa à la porte du Tengu Givrefoux tandis que ce dernier recevait la visite de Fuji Givrefoux. On ne retrouva du malheureux Jack que cette amulette.');
INSERT INTO "item_descriptions" VALUES(12855,'fr','Jack était considéré par les autres Frigostiens comme un excentrique, c''est pour cette raison que seul un cordonnier d''Amakna, membre de l''Ordre du Cul Botté, accepta de lui confectionner ces bottes. Leur forme est spécialement conçue pour amplifier les techniques secrètes de l''Ordre.');
INSERT INTO "item_descriptions" VALUES(12856,'fr','La facilité d''accès aux bouteilles qu''elle procure en combat rend cette sacoche très populaire auprès des aventuriers Pandawas.');
INSERT INTO "item_descriptions" VALUES(12857,'fr','Cette coiffe est un bon moyen de montrer à vos rivaux que vous cherchez un défi à votre hauteur. C''est aussi une façon simple d''envoyer un message explicite à toute la gent féminine, bien que le résultat ne soit pas garanti.');
INSERT INTO "item_descriptions" VALUES(12858,'fr','Portez ce licol autour du cou si vous craignez de vous perdre et qu''on ne vous retrouve pas. Cette astuce a été testée et approuvée par les éleveurs de Bouftous.');
INSERT INTO "item_descriptions" VALUES(12859,'fr','Ces sabots sont munis de semelles antidérapantes. Le cordonnier les ayant fabriqués affirme que c''est pour éviter de glisser sur la glace mais tout le monde sait qu''en réalité, c''est pour ne pas glisser dans les flaques d''alcool lors des soirées arrosées.');
INSERT INTO "item_descriptions" VALUES(12882,'fr','Chaussé de ces sabots, on vous entendra venir d''un "clop clop" trop mignon. Suivi la plupart du temps d''un "POUF" lourd quand vous serez tombé au sol parce que ces sabots ronds et rigides ne sont vraiment pas bons pour l''équilibre.');
INSERT INTO "item_descriptions" VALUES(12883,'fr','Recoiffez vous en un instant avec ce Peignentif qui vous permettra de faire face à toute situation un peu trop ébouriffante. En revanche ce n''est pas les maigres pouvoirs qu''il confère qui vous permettront de décoiffer vos adversaires.');
INSERT INTO "item_descriptions" VALUES(12887,'fr','Ce Gladialeçon, porté sans rien d''autre, va à ravir aux combattants virils et musclés. Vous devinez bien que sur vous il vous fera passer au mieux pour quelqu''un de vraiment très bizarre, au pire pour un pervers fou dangereux.');
INSERT INTO "item_descriptions" VALUES(12888,'fr','Ces bottes permettent d''amortir vos coups de pied, pour éviter que vous ne fassiez mal à votre adversaire. C''est bien gentil à vous, mais ça n''empêchera pas les Bouftous de vous croquer la jambe, cette fois sans ménagement.');
INSERT INTO "item_descriptions" VALUES(1012963,'fr','Fidèle compagnon de chasse des Glutins qui parcourent la taïga, le Hurledent a toujours les crocs, ce qui le rend un poil irritable.');
INSERT INTO "item_descriptions" VALUES(12969,'fr','Ce bracelet est si énorme qu''il pourrait vous servir de ceinture ou se mettre à vos chevilles tellement elles sont enflées. Il peut aussi servir de couronne aux grosses têtes dans votre genre. Le bijoutier qui l''a conçu a vraiment le sens pratique.');
INSERT INTO "item_descriptions" VALUES(12975,'fr','Ce tofu givré a bien un bec, ce qui permet de le différencier des bouboules de neige. Lassé de l''île des glutins et des chants de Nowel, il a décidé de vous suivre pour découvrir de nouveaux horizons. Sa présence à vos côtés n''est-elle pas le plus merveilleux des cadeaux ?');
INSERT INTO "item_descriptions" VALUES(12982,'fr','Sourisette est la végétarienne la plus vorace de tout Amakna. Parmi ses passe temps favoris : faire manger à ses ennemis des Pissenlits Diaboliques par la racine, les envoyer sur les Roses Démoniaques, puis déguster le tout en salade aux Champ Champ accompagnés d''huile de Tournesol Sauvage. Et on dit que les carnivores sont sanguinaires...');
INSERT INTO "item_descriptions" VALUES(12988,'fr','Scarakiri a une notion de l''honneur poussée à l''extrême. Ne supportant plus l''agressivité injustifiée de ses frères de l''Île du Minotoror, il s''est résigné à vous servir pour expier les fautes de ses semblables et rétablir l''honneur de sa longue lignée d''honorables Scaratos. En cas d''échec, il ne lui restera que la mort.');
INSERT INTO "item_descriptions" VALUES(12994,'fr','Rauleur est le plus petit de tous les Raul Mops, et il le vit très mal. Même les Pichons sont plus grands que lui et se font un plaisir de le tourner en ridicule. Sans cesse en traîn de râler après ceux qui l''insultent, il s''est décidé à leur montrer que la taille ne compte pas vraiment : l''important, quand on veut se faire respecter, c''est de devenir le meilleur ami d''une brute.');
INSERT INTO "item_descriptions" VALUES(13000,'fr','Contrairement à ce que vous croyiez quand vous avez choisi d''adopter Meulourd, il ne s''appelle pas ainsi à cause de son poids, mais à cause de son humour. Jamais drôle, toujours pénible, au goût douteux, Meulourd est lourd, et a fini par être banni de la Tanière du Meulou et des Landes de Sidimote.');
INSERT INTO "item_descriptions" VALUES(13017,'fr','Cette ceinture emplumée accompagnera à merveille votre ventre, qui s''est bien remplumé dernièrement.');
INSERT INTO "item_descriptions" VALUES(13018,'fr','Ces bottes duveteuses donnant l''impression que vous avez des pieds de Dragodinde feraient d''excellentes pantoufles. Vous savez, le genre dont vos invités s''amusent quand ils vous voient avec chez vous. Vous comptez vraiment les porter en extérieur ?');
INSERT INTO "item_descriptions" VALUES(13020,'fr','À cause de ses origines modestes, Féline n''a jamais su porter autre chose aux pieds que ses sabots. Pour conserver son allure de diva malgré cela, elle a demandé à l''un des plus grands cordonniers de Frigost de trouver une solution pour rendre ses sabots roses plus chics. Il finit par mettre fin à ses jours, ne pouvant supporter d''avoir créé un tel monstre.');
INSERT INTO "item_descriptions" VALUES(13022,'fr','Le cristal qui orne le collier de Féline peut entrer en résonance avec ses cordes vocales et créer de dévastatrices ondes de choc. Elles ne le seront en revanche jamais autant que sa voix seule qui, elle, peut percer des tympans sans effort et peut même fracturer un iceberg.');
INSERT INTO "item_descriptions" VALUES(13063,'fr','Arty a longtemps porté cette canne avec lui. Une extrémité était enrobée de mélasse sucrée pour attirer les troupeaux de Bouftous égarés et l''autre en bois rugueux pour mieux les fesser. L''outil parfait pour les parents qui peinent à se faire respecter. Cette canne-ci semble avoir un problème de conception et est inutilisable. L''assistante de Justin Dwa, le fabricant de skis de la bourgade de Frigost, doit pouvoit vous l''échanger contre une version fonctionnelle.');
INSERT INTO "item_descriptions" VALUES(13064,'fr','Cette coiffe est maudite, Katar son ancien propriétaire a perdu la tête deux fois : il est devenu fou et a fini décapité.');
INSERT INTO "item_descriptions" VALUES(13071,'fr','Mékrabe est le fruit (de mer) d''une toute première tentative de création d''une forme de vie entièrement mécanique. Comme tous les sujets d''expériences un peu folles, Mékrabe a mal tourné. Devenu obsédé par la recherche du sens de sa vie, aussi artificielle soit-elle, il s''est persuadé que vous l''aiderez à trouver des réponses, vous qui passez votre temps à mourir en boucle sans vous poser de questions.');
INSERT INTO "item_descriptions" VALUES(13091,'fr','Si les os du Chafer Rōnin sont noircis, c''est à cause de centaines d''années de vagabondage sans maître, uniquement guidés par de sombres desseins. Si vous l''êtes, c''est uniquement parce que vous ne vous êtes pas lavé depuis des lustres.');
INSERT INTO "item_descriptions" VALUES(13092,'fr','Se fiant à une obscure légende entendue sur les Chafers Draugr, certains aventuriers s''imaginent que si ils lancent ce marteau sur leurs ennemis, il leur reviendra dans la main tel un boomerang. On n''a jamais su si c''était vrai, personne n''ayant jamais réussi à le lancer plus loin que sur ses propres orteils.');
INSERT INTO "item_descriptions" VALUES(13093,'fr','Le Chafer Rōnin, dépourvu de toute chair, ne porte pas de sous-vêtements sous son pagne, ouvert sur l''avant : la vue de son coccyx n''a jamais choqué personne. La vue du vôtre, en revanche...');
INSERT INTO "item_descriptions" VALUES(13094,'fr','Le cordonnier qui a créé ces bottes s''est trompé et les a faites à l''image de celles du Chafer Rōnin. Il a sûrement pensé que vous aviez suffisamment l''air primitif sans ça.');
INSERT INTO "item_descriptions" VALUES(13095,'fr','Le bandeau que vous porterez en tant que Pandawushuka de grade Rokwa possède de nombreux usages : sur votre front, il montrera à tous que vous êtes un adepte des arts martiaux ; sur vos yeux, il vous permettra de faire la sieste en plein jour ; sur votre bouche, il vous empêchera de dire n''importe quoi.');
INSERT INTO "item_descriptions" VALUES(13099,'fr','Ploup est tout à fait inoffensif, mais il n''a jamais été accepté parmi les autres créatures aquatiques de Sufokia. Ces dernières sont terrorisées à l''idée que Ploup puisse grandir et ne devienne comme son très lointain cousin le Kralamoure Géant, qui les terrifie. Toute cette injustice et ces préjugés vous répugnent, aussi avez-vous décidé de tendre la main au petit céphalopode, qui s''est empressé de la saisir avec ses tentacules.');
INSERT INTO "item_descriptions" VALUES(13114,'fr','Cette ceinture a été confectionnée pour que Brouce Boulgoure puisse se déhancher correctement lorsqu''il chantait son célèbre refrain "Saga Amakna, attention les secousses, Saga Amakna, ambiance de Brouce".');
INSERT INTO "item_descriptions" VALUES(13115,'fr','Cet anneau possède une extrémité acérée qui permet de marquer les arbres à abattre. On raconte que Brouce Boulgoure après une soirée un peu arrosée, caressa les ailes et le bras de sa tendre épouse Kassiopée Baine avec cette bague, lui laissant la terrible marque des arbres à abattre. Celle-ci ayant une fâcheuse tendance à utiliser sa hache sans en demander la permission, il eut enfin deux bonnes raisons de lui couper une aile et un bras. On ne plaisante pas avec les bûcherons.');
INSERT INTO "item_descriptions" VALUES(13116,'fr','Ces bottes ont été spécialement conçues par Brouce Boulgoure avec l''aide d''Hogmeiser et de Bowisse pour dessoucher les frênes et les noyers. Vous ne voulez pas connaître leurs effets secondaires sur les postérieurs.');
INSERT INTO "item_descriptions" VALUES(13117,'fr','Otomaï est un alchimiste célèbre, notamment pour avoir créé la potion contre la Myxomawose. Il est cependant moins célèbre pour sa théorie contestée sur les Cawottes selon laquelle elles améliorent la vue puisqu''il est bien connu que les Wabbits ne portent jamais de lunettes.');
INSERT INTO "item_descriptions" VALUES(13118,'fr','Ces bottes de l''alchimiste de renom Otomaï ont une semelle en éponge afin d''absorber et nettoyer les liquides renversés sur le sol de son laboratoire. Elles sont certes un peu onéreuses mais gardez à l''esprit qu''elles permettent d''économiser chaque mois le salaire d''une femme ou d''un homme de ménage. Retour sur investissement garanti en moins de 248 ans.');
INSERT INTO "item_descriptions" VALUES(13119,'fr','Cette lame a tranché de nombreuses créatures innocentes.
Mais c''était pour la Science.');
INSERT INTO "item_descriptions" VALUES(13120,'fr','D''après certaines rumeurs, Danathor aurait fait empoisonner Rimaraf, le meilleur ami d''Amayiro en lui offrant un gâteau aux Blops mortel. Voici une histoire drôle à raconter à vos enfants avant de les coucher pour leur expliquer qu''on ne doit pas accepter la nourriture d''un inconnu, surtout quand elle a l''odeur de Blop.');
INSERT INTO "item_descriptions" VALUES(13121,'fr','Le revers de cette amulette est équipé d''une pierre abrasive pour épiler le torse de ceux qui la portent. Le marchand qui vous l''a vendue a dû oublier de vous préciser qu''il ne fallait pas dormir avec.');
INSERT INTO "item_descriptions" VALUES(13122,'fr','Danathor fut choisi par Jiva pour être intendant de la ville de Bonta. Il était si fourbe et manipulateur que la plèbe pensait qu''il officiait à Brâkmar.');
INSERT INTO "item_descriptions" VALUES(13123,'fr','Allister était un simple berger, avant de fonder - si l''on en croit la légende - la première guilde de l''histoire du Monde des Douze. Il a ensuite capturé le démon Uk''Not''Allag en le gavant de sang de Bouftou, puis l''a emprisonné en Amakna. Ces tours de force ont fait d''Allister un roi très apprécié et estimé de ses sujets : un exemple à suivre pour notre jeunesse dépravée qui ne pense qu''à jouer plutôt que de partir à l''aventure.');
INSERT INTO "item_descriptions" VALUES(13124,'fr','Cet anneau aurait été offert à Allister par son vieil ami Amayiro. Certains colporteurs de rumeurs peu scrupuleux aimeraient y voir une idylle cachée et non assumée, ou une tentative de corruption. Les fidèles d''Allister le voient comme une marque d''amitié inébranlable. Les idiots du village le voient comme un anneau.');
INSERT INTO "item_descriptions" VALUES(13125,'fr','C''est dans ces bottes qu''Allister cachait son ancien trocart qu''il utilisait jadis pour régler les soucis de météorisation de ses Bouftous. On raconte qu''une fois devenu roi, il s''en servait sur lui-même après les festins qu''il organisait au château d''Amakna.');
INSERT INTO "item_descriptions" VALUES(13127,'fr','Cette cape rend son porteur invisible dès qu''il se cache dans un placard sombre. Pour être furtif, n''oubliez pas de toujours vous déplacer avec votre placard sombre.');
INSERT INTO "item_descriptions" VALUES(13128,'fr','Léthaline Sigisbul est une mercenaire d''Astrub sans scrupules qui vend ses talents au plus offrant. La taille de votre bourse démontre que vous n''êtes pas concerné.');
INSERT INTO "item_descriptions" VALUES(13129,'fr','Du cuir, des talons et encore du cuir. De quoi en perdre la boule.');
INSERT INTO "item_descriptions" VALUES(13130,'fr','Ogivol Scalarcin a été condamné à six mois de geôle pour son mépris de l''autorité et sa fâcheuse tendance à voler tout ce qu''il trouve, mais surtout ce qui ne lui appartient pas. Les jeunes astrubiens le voient comme un héros révolutionnaire des temps modernes, qui défend la liberté de penser, d''emprunter et de partager de façon définitive les biens d''autrui.');
INSERT INTO "item_descriptions" VALUES(13131,'fr','Difficile de savoir si les os qui composent la cape d''Ogivol Scalarcin sont ceux de ses victimes ou juste des pièces de rechange pour ce vieux Sram arthritique.');
INSERT INTO "item_descriptions" VALUES(13132,'fr','Chaque jour qui s''écoule voit les os d''Ogivol Scalarcin s''écarter un peu plus les uns des autres. C''est la punition arthritique que Xélor a choisie. Cette ceinture lui permettait de maintenir ses os en place lorsqu''il danse l''Akmanarena.');
INSERT INTO "item_descriptions" VALUES(13135,'fr','Quand vous êtes venu le voir pour la première fois, tout frêle et bas niveau que vous étiez, Metag Robill a confié au Maître des Clefs : "Si celui-là fait le tour du monde, je mange mon chapeau". Ça aura pris du temps, et redonner forme au casque n''était pas une mince affaire, mais ça en valait totalement la peine.');
INSERT INTO "item_descriptions" VALUES(13136,'fr','Avec votre tête à l''intérieur, jamais le contenu d''un coffre n''aura été à ce point décevant.');
INSERT INTO "item_descriptions" VALUES(13137,'fr','Une fois cette ceinture équipée, il devient impossible de l''enlever sans sa clef. Elle est donc logiquement portée par les femmes aux maris trop jaloux, par les filles aux pères trop soucieux de leur vie privée, et par vous, pour le bien de l''humanité. (pensez à jeter la clef)');
INSERT INTO "item_descriptions" VALUES(13138,'fr','La clef de ce pendentif n''ouvre ni le Caskoffre, ni la Ceinture de Coffreté, ni les Boffes Cottre. Ni aucune des serrures que vous ayez jamais vues, d''ailleurs. Elle n''a donc de raison d''exister que dans l''espoir qu''elle serve un jour à quelque chose. Un peu comme vous.');
INSERT INTO "item_descriptions" VALUES(13139,'fr','Ces bottes sont les plus sûres de tout le Monde des Douze. Avec ça aux pieds, vous êtes assurés que plus personne ne viendra voler vos chaussettes. Ne protège pas vos petits orteils des coups de tables basses, chaises et autres ameublements meurtriers.');
INSERT INTO "item_descriptions" VALUES(13170,'fr','Si cette amulette est portée juste en dessous du menton, ses petites ailes vous aideront à rendre votre humour un peu plus léger.');
INSERT INTO "item_descriptions" VALUES(1013182,'fr','Aussi stupide qu''une dragodinde en armure, le Kramkram en possède tous les avantages et même plus encore. Certains éleveurs prétendent qu''il serait à l''origine du gène kraméléon chez les dragodindes, mais toutes les tentatives de reproduction entre les deux espèces se sont soldées par des échecs. Peut-être qu''Otomaï serait à l''origine de ce miracle, encore faudrait-il qu''il accepte de s''exprimer à ce sujet.');
INSERT INTO "item_descriptions" VALUES(13194,'fr','Porter ce chapeau est un bon prétexte pour toujours avoir la tête dans le gaz. Il vous sied donc à merveille les lendemains de soirées trop arrosées ou après un séjour prolongé sur l''île de Pandala. Il est également très utile pour se tenir informé des derniers commérages, mais l''Agence Touriste déconseille son port à ses clients souhaitant se rendre dans les landes de Sidimote.');
INSERT INTO "item_descriptions" VALUES(13197,'fr','Dernière création de Justin Dwa, cette cape vous permettra de mieux résister aux températures glaciales de Frigost. Épaisse, chaude et odorante, elle vous rappellera, avec une pointe de nostalgie, les câlins d''une mama bwork.');
INSERT INTO "item_descriptions" VALUES(13230,'fr','Trouvant la vie sur l''archipel de Vulkania vraiment trop injuste, cette créature a décidé de sortir de sa coquille et de vous suivre dans votre lutte pour un monde meilleur.');
INSERT INTO "item_descriptions" VALUES(13245,'fr','Arty a longtemps porté cette canne avec lui. Une extrémité était enrobée de mélasse sucrée pour attirer les troupeaux de Bouftous égarés et l''autre en bois rugueux pour mieux les fesser. L''outil parfait pour les parents qui peinent à se faire respecter.');
INSERT INTO "item_descriptions" VALUES(13261,'fr','Avec ce scaphandre sur le crâne, plus personne ne saura dire si vous êtes un homme ou une femme. Vos nouveaux amis en seront très incommodés et n''oseront pas vous poser la question, de peur de vous vexer. Et ce ne sont pas vos formes sans le moindre relief qui les aideront.');
INSERT INTO "item_descriptions" VALUES(13262,'fr','Ce sac-bouteille de plongée est censé contenir de l''air comprimé pour l''exploration des profondeurs. Vous l''avez rempli de bière sous pression à la place. On hésite entre crier au génie ou à l''ivrogne.');
INSERT INTO "item_descriptions" VALUES(13263,'fr','Ces lourdes bottes de plongée sont un concentré de technologie Steamer. Un automate leur permet de marcher à votre place, réduisant la fatigue engendrée par vos déplacements malgré le lest. Pensez à avoir votre scaphandre sous la main quand même, elles sont programmées pour se diriger vers la mer.');
INSERT INTO "item_descriptions" VALUES(13264,'fr','Cette ceinture de plongée fait son affaire, mais vous ne pouvez vous empêcher d''avoir un frisson de dégoût en pensant à la morphologie de l''inventeur de cette ceinture hexagonale rigide, dotée de hublots pour voir sous l''eau. Voir avec quoi ?');
INSERT INTO "item_descriptions" VALUES(13265,'fr','Cet anneau, comme son nom l''indique, est primordial pour les Steamers : il leur permet de surveiller la pression de l''air et donc le temps qu''il leur reste lors de leurs plongées sous-marines. Et surtout de perdre les imbéciles qui le prennent pour une boussole.');
INSERT INTO "item_descriptions" VALUES(13297,'fr','Les pièces métalliques de cet anneau y sont plantées mais repliées sur elles-mêmes à l''intérieur de celui-ci. Idéal pour les Sacrieurs douillets voulant laisser croire qu''ils aiment vraiment la douleur.');
INSERT INTO "item_descriptions" VALUES(13298,'fr','Vous avez bien fait de changer de bracelet au vu de votre manie de les ronger. Au moins celui-ci vous fera peut-être perdre un ou deux kilopods sur la trentaine que vous avez en trop.');
INSERT INTO "item_descriptions" VALUES(13301,'fr','Spécialité typique des cordonniers à bérets et pulls rayés, les bottes O''Feu sont idéales pour l''entraînement : elles vous assureront un flot de monstres continu, se jetant sur vous pour vous dévorer les bottes. Et laisser le reste qui est bien moins goûtu.');
INSERT INTO "item_descriptions" VALUES(13302,'fr','Ces bottes de peau ridée vous enlaidiraient suffisamment pour que l''on cesse de vous harceler de demandes en mariage.');
INSERT INTO "item_descriptions" VALUES(13303,'fr','On raconte que si vous portez cette ceinture et dites la formule magique "Tournicoti Tournicoton" de la manière la plus ridicule possible, vous serez transporté au Pays du Bois Joli. Et que ça fera beaucoup rire les témoins de la scène.');
INSERT INTO "item_descriptions" VALUES(13304,'fr','Cette ceinture d''écailles est jolie et plutôt puissante mais son utilisation est contraignante : au moindre danger son porteur est pris d''une envie irrépressible de se réfugier chez soi. Pas pratique quand on habite à Pandala et que l''on est en excursion sur Frigost.');
INSERT INTO "item_descriptions" VALUES(13320,'fr','Cet anneau fait aussi office de pinceau magique. Il est possible de créer de sublimes estampes avec, simplement en agitant la main. Pour conserver un semblant de crédibilité, il ne faut simplement pas que l''on vous voie à l''œuvre, tant son utilisation, demandant de gesticuler dans tous les sens, vous rend ridicule.');
INSERT INTO "item_descriptions" VALUES(13321,'fr','Ces bottes, considérées par les critiques de cordonnerie (oui, ça existe) comme une des preuves que celle-ci peut être considérée comme un art, vous amènent à penser que ce mot ne veut décidément plus rien dire de nos jours.');
INSERT INTO "item_descriptions" VALUES(13326,'fr','Dommage que vous ne soyez pas une lumière, vous feriez une jolie lanterne.');
INSERT INTO "item_descriptions" VALUES(13327,'fr','Les graines de Citwouille au dos de cette cape ont été ajoutées par Halouine, qui l''a conçue dans le but de semer des Citwouilles dans le monde entier pour répandre sa malédiction. En attendant, vous les grignotez quand vous avez un petit creux.');
INSERT INTO "item_descriptions" VALUES(13328,'fr','Halouine utilisait cette ceinture jusqu''à ce qu''elle s''anime toute seule par l''effet de sa malédiction et s''attaque à toutes les ceintures des gens qu''il croisait, sans qu''il puisse l''enlever. Ce fut très gênant et lui donna en plus la réputation d''être obscène.');
INSERT INTO "item_descriptions" VALUES(13329,'fr','Halouine a les cheveux tellement hirsutes qu''il ferait mieux de se donner un coup de râteau à lui plutôt qu''aux autres.');
INSERT INTO "item_descriptions" VALUES(13344,'fr','Ce Dofus change de couleur en fonction des saisons. Chaud et doré au cœur de l''été, il devient froid comme la glace à l''approche de l''hiver. Il aurait été pondu par un dragon tombé amoureux d''un colporteur qui se serait présenté à l''entrée de sa caverne pour lui refourguer un vieux calendrier.');
INSERT INTO "item_descriptions" VALUES(13423,'fr','L''authentique slip en cuir moulant du Captain Chafer a disparu en même temps que son propriétaire. Néanmoins, le célèbre danseur de tango a laissé derrière lui de nombreux sous-vêtements usagés, qui ont servi de modèles à certains tailleurs fétichistes. Confortable, élastique et bon marché, le Slip de Rechange est à la portée de toutes les bourses. Et en plus, il est réversible.');
INSERT INTO "item_descriptions" VALUES(13424,'fr','Ce couvre-chef appartenait au vieux John, célèbre flibustier des 107 océans. La légende dit que son perroquet est mort dans le chapeau un soir de tempête et que depuis ce jour funeste celui qui le porte se met à parler un peu comme le vieux John.');
INSERT INTO "item_descriptions" VALUES(13459,'fr','Cette amulette génère des interférences magiques qui modifient le fonctionnement de vos cordes vocales, vous ne pourrez plus vous empêchez de chanter "Di di di di di di".
Malheureusement, il s''agit quasiment du chant de parade nuptiale des Kidos. Il n''est pas trop tard pour apprendre à couver.');
INSERT INTO "item_descriptions" VALUES(13460,'fr','Cet anneau coloré vous rappelle votre enfance insouciante et naïve durant laquelle vos bras étaient recouverts de bracelets bons marchés multicolores. La mode n''épargne personne.');
INSERT INTO "item_descriptions" VALUES(1013465,'fr','Le Sakochère, cousin du sanglier, est plus grand que ce dernier, mais surtout plus robuste et bien plus docile. Tant que vous parviendrez à vous restreindre sur la charcuterie, il se fera un plaisir de transporter tout ce que vous n''arrivez pas à faire rentrer dans vos poches déjà ridiculement pleines.');
INSERT INTO "item_descriptions" VALUES(13480,'fr','Vous n''aimiez pas équiper l''Araknacoiffe ? Vous aimerez encore moins l''Araknacoiffe Velue ! Rembourrée à la toile d''Arakne, faite de plus encore de morceaux de celles-ci, et parfumée avec leurs phéromones de sorte à ce qu''une Arakne enamourée vous suive toujours, offrez-la à un araknophobe : soit il passe outre sa peur, soit il meurt de terreur. C''est pour son bien.');
INSERT INTO "item_descriptions" VALUES(13485,'fr','La boucle de cette ceinture a une fente sur le dessus pour que vous puissiez y stocker vos points GG. Votre cordonnier vous l''a montée à l''envers, parce qu''il sait très bien que vous avez plutôt tendance à en perdre qu''à en gagner.');
INSERT INTO "item_descriptions" VALUES(13486,'fr','À défaut de pouvoir le faire en tournoi de Krosmaster, ces chaussures vous permettront au moins de botter les fesses de vos ennemis en combat.');
INSERT INTO "item_descriptions" VALUES(13582,'fr','Ces magnifiques chaussons à bouts rembourrés sont une invitation à la danse. Ils peuvent être portés avec un tutu, ou avec d''autres tenues vestimentaires si vous n''avez pas peur du ridicule.');
INSERT INTO "item_descriptions" VALUES(13583,'fr','Cette baguette ressemble à s''y méprendre à une branche du Grand Glucid, l''arbre mythique qui pousse dans la Gelaxième Dimension. C''est sans doute pour cela qu''elle attire les Petites Gelées Fraises sucrées et tremblotantes.');
INSERT INTO "item_descriptions" VALUES(13584,'fr','Ce coffre qui se porte comme un sac est une invention fort pratique. Malheureusement, il semblerait qu''il attire les jeunes Koalaks et les ennuis. Seuls les aventuriers avec le dos suffisamment large peuvent espérer l''utiliser sans être poursuivis par la guigne.');
INSERT INTO "item_descriptions" VALUES(1013603,'fr','On dit que le Balafreux est l''un des sangliers les plus âgés du Monde des Douze. Combattant légendaire, considéré comme un dieu par les enfants marcassins, il a toujours été d''une droiture exemplaire. Il a longtemps combattu les pires truands, comme les Pandits ou les aventuriers sans scrupules qui tentent d''escroquer leurs semblables.');
INSERT INTO "item_descriptions" VALUES(13629,'fr','Cet anneau en forme de rouage tourne très lentement sur lui-même, dans le sens des aiguilles d''une horloge. Seul Henual se rend compte de l''importance de ce mouvement presque imperceptible. Une chose est sûre : l''anneau ne doit s''arrêter sous aucun prétexte. Faites très attention, le sort du Krosmoz tout entier pourrait bien se jouer autour de votre doigt.');
INSERT INTO "item_descriptions" VALUES(13630,'fr','Cette ceinture est censée protéger son porteur contre les paradoxes temporels, les rayons krosmiques, les retards à répétition et les sentiments de déjà-vu. En théorie, tout du moins. Mieux vaut l''utiliser uniquement pour ne pas perdre son pantalon, ce sera déjà un bon début.');
INSERT INTO "item_descriptions" VALUES(13631,'fr','Ce marteau est équipé d''un convecteur chronomagique. Lorsque vous le faites tournoyer au-dessus de votre tête et qu''il finit par atteindre la vitesse de 88 kamiles par heure, il vous permet de retourner vers le futur. En revanche, si la vitesse n''est pas suffisante, vous serez transformé en tas de fumier. Mais ça, on s''en balance !');
INSERT INTO "item_descriptions" VALUES(13632,'fr','En portant cette coiffe, vous aurez un air de chienchien battu. Avec une gueule pareille, vous risquez de tomber sur un os, mais vous pourrez aussi croiser des amis des bêtes qui se prendront d''affection pour vous. Si vous êtes chanceux, ils finiront peut-être par vous adopter, qui sait ?');
INSERT INTO "item_descriptions" VALUES(13633,'fr','Un collier que l''on porte quand on est fidèle et obéissant. Si ce n''est pas votre cas, vous pourrez toujours montrer les crocs et faire le laid.');
INSERT INTO "item_descriptions" VALUES(13634,'fr','Ces bottes laissent des empreintes très particulières, qui vous permettront de faire des blagues à vos amis chasseurs en brouillant les pistes. Attention, vous risquez tout de même de prendre une flèche perdue au passage.');
INSERT INTO "item_descriptions" VALUES(13635,'fr','Chaude, résistante et autonettoyante, cette cape est en plus très élégante. Comme quoi on peut être le plus grand chasseur du Monde des Douze et avoir le sens de la mode.');
INSERT INTO "item_descriptions" VALUES(13636,'fr','La dent qui orne cette amulette a été arrachée à un monstre légendaire. Est-ce un dragon, un Yech''Ti, une belle-mère ? Seul Nevark le sait, et il emportera ce secret dans la tombe.');
INSERT INTO "item_descriptions" VALUES(13637,'fr','On dit que quiconque porte cette ceinture devient capable d''atteindre un Moskito en plein vol à trois kilokamètres. Il est en revanche déconseillé de traverser un champ de tir avec cet accessoire autour de la taille.');
INSERT INTO "item_descriptions" VALUES(13638,'fr','La première cape de ce genre a été portée par le sergent-major Sombrefontaine. Le milicien aurait offert sa cape à Théodoran Ax pour le remercier de l''aide apportée dans la rédaction de ses mémoires. Il faut dire que la vie tumultueuse d''un officier brâkmarien fait toujours couler beaucoup d''encre.');
INSERT INTO "item_descriptions" VALUES(13639,'fr','Selon la légende, cette amulette permet d''effacer toutes les erreurs commises au cours d''une vie d''aventurier. Pour que cela soit efficace en ce qui vous concerne, il vous en faudrait un bon millier d''exemplaires.');
INSERT INTO "item_descriptions" VALUES(13640,'fr','Ces bottes ont tendance à laisser des traces noires sur les tapis et les carrelages, ce qui désespérera votre personnel de maison, sauf s''il s''agit de Gobelins.');
INSERT INTO "item_descriptions" VALUES(13641,'fr','Cette coiffe ressemble à la tête du dernier Scarabosse Ivoire, écrabouillé par Padgref durant ses jeunes années. Le marchand qui vous l''a vendue vous a assuré qu''il s''agissait de l''originale. Le mystère de l''étiquette indiquant « Fabriqué en 10 000 exemplaires » reste donc entier.');
INSERT INTO "item_descriptions" VALUES(13642,'fr','Longtemps, les sages se sont divisés sur la manière de porter un anneau aussi large. Les premiers prétendaient qu''il se portait au pouce, les seconds affirmant que c''était au gros orteil. La vérité ne fut découverte que récemment, grâce à la confirmation d''une rumeur selon laquelle Padgref ne pouvait porter cet anneau que les jours de grande forme.');
INSERT INTO "item_descriptions" VALUES(13643,'fr','Padgref est le champion incontesté du broyage de crâne en tongues. En chaussant ces getas, n''espérez pas le dépasser. Vous pourrez au mieux l''égaler le temps d''une journée passée à marcher sur les plates-bandes de votre voisin.');
INSERT INTO "item_descriptions" VALUES(13644,'fr','Comme tout chapeau de magicien qui se respecte, celui-ci ne paye pas de mine, et pourtant... Il a servi de chopine, de sac à vomi et de pot de chambre au grand Hel Munster lorsque celui-ci n''était encore qu''un jeune apprenti avide de connaissance. Même de nos jours, peu de coiffes peuvent se vanter d''assurer autant de fonctions simultanément.');
INSERT INTO "item_descriptions" VALUES(13645,'fr','Lorsqu''Hel Munster demanda à son maître comment lutter contre le froid, ce dernier lui déclara que la réponse se trouvait dans les pages de son grimoire. Il les arracha donc une par une et les cousit entre elles pour en faire cette cape originale.');
INSERT INTO "item_descriptions" VALUES(13646,'fr','La pierre précieuse de cette amulette renferme un condensé de Brise Quadramentale et c''est là tout son problème. En effet, pour pouvoir pleinement profiter de ses pouvoirs magiques, il faudrait la libérer mais seule une femme blonde, belle, intelligente, à forte poitrine et dotée du sens de l''orientation en est capable. Autant vous faire une raison, vous devrez vous contenter de ses pouvoirs de base.');
INSERT INTO "item_descriptions" VALUES(13647,'fr','Cette coiffe est passée de mode depuis longtemps, surtout chez les ménagères de moins de 50 ans. Cependant, personne n''a encore osé le dire à Aermyne. Enfin si, il y en a qui ont essayé, ils ont eu des problèmes.');
INSERT INTO "item_descriptions" VALUES(13648,'fr','Les ménagères de plus de 50 ans se procurent ce tablier à bas prix lors du salon de la cuisine. Comme vous n''y connaissez rien, vous l''avez acheté à un tailleur qui vous l''a vendu comme dernière cape à la mode. On vous avait pourtant prévenu qu''un bon commerçant est avant tout un bon menteur.');
INSERT INTO "item_descriptions" VALUES(13649,'fr','Originellement conçu pour préparer des tartes, ce rouleau sert maintenant à en distribuer. Vous pourrez donc vous en donner à cœur joie lorsque votre enfant invitera ses amis pour son goûter d''anniversaire.');
INSERT INTO "item_descriptions" VALUES(13657,'fr','Cette cape fut originellement portée par le prophète de Sylkauf, le Méryde de l''Hibernation. L''idée lui vint en voyant les Kaskargo trimballer leur maison sur leur dos. Las de s''endormir dans des lieux inconfortables, il saisit immédiatement le côté pratique à se promener avec son matelas sur soi.');
INSERT INTO "item_descriptions" VALUES(13658,'fr','Ces pantoufles sont très prisées de la nouvelle génération qui aime son confort mais refuse de faire le moindre effort pour le mériter. En les essayant, vous remarquez qu''elles vous siéent à merveille.');
INSERT INTO "item_descriptions" VALUES(13659,'fr','Ces sabots sont à l''image de votre vie, vous pouvez donc les exhiber fièrement à vos pieds pour faire fuir les rares personnes ayant encore pitié de vous. Ils sont également efficaces pour écraser les doigts des mendiants et botter l''arrière-train des enfants.');
INSERT INTO "item_descriptions" VALUES(13661,'fr','Vous voilà devenu le meilleur ami de cet insecte au regard innocent. Son air attachant suffira à peine à vous faire oublier à quel point il est exaspérant. Car Kafarce est un grand blagueur, toujours prêt à vous faire de mauvais coups. Mieux vaut en rire qu''en pleurer.');
INSERT INTO "item_descriptions" VALUES(13667,'fr','Comme son nom l''indique, Bulbouture a été créée par bouturage, ce qui signifie qu''elle est un clone, génétiquement identique à sa mère. Alors pourquoi aucun autre bulbe ne lui ressemble ? Bien décidée à résoudre le mystère de ses origines, elle s''est mis en tête d''arpenter le Monde des Douze pour effectuer le plus de prélèvements possibles sur tout ce qui bouge. Et tant pis si les spécimens ne survivent pas au processus : c''est pour la science.');
INSERT INTO "item_descriptions" VALUES(13673,'fr','Kokulte est un Kaskargo passionné par les sciences occultes. Son absence de mains ne l''aide pas à effectuer des incantations donc il n''est pas bien dangereux.');
INSERT INTO "item_descriptions" VALUES(13679,'fr','Toukancre porte bien son nom : il n''était pas très attentif à l''école des kidos. Vous ne savez pas comment vous y prendre avec lui. Il vous mènera la vie dure, mais il a plutôt bon fond, et il vous sera d''une aide précieuse en combat si vous l''aidez à combler ses lacunes. Après tout, vous n''étiez pas le premier de la classe et vous avez tout de même réussi à vous en sortir, non ?');
INSERT INTO "item_descriptions" VALUES(13748,'fr','Ce Trophée permet de coller les malotrus à vos bottes, ou l''inverse. N''oubliez pas de bien serrer vos lacets.');
INSERT INTO "item_descriptions" VALUES(13749,'fr','Ce Trophée permet de coller les malotrus à vos bottes, ou l''inverse. N''oubliez pas de bien serrer vos lacets.');
INSERT INTO "item_descriptions" VALUES(13750,'fr','Ce Trophée permet de coller les malotrus à vos bottes, ou l''inverse. N''oubliez pas de bien serrer vos lacets.');
INSERT INTO "item_descriptions" VALUES(13751,'fr','Ce Trophée n''est pas responsable de la fuite des cerveaux.');
INSERT INTO "item_descriptions" VALUES(13752,'fr','Ce Trophée n''est pas responsable de la fuite des cerveaux.');
INSERT INTO "item_descriptions" VALUES(13753,'fr','Ce Trophée n''est pas responsable de la fuite des cerveaux.');
INSERT INTO "item_descriptions" VALUES(13754,'fr','Ce Trophée vous permet de jouer au docteur avec vos alliés ou avec vos ennemis si vos combats sont trop faciles.');
INSERT INTO "item_descriptions" VALUES(13755,'fr','Ce Trophée vous permet de jouer au docteur avec vos alliés ou avec vos ennemis si vos combats sont trop faciles.');
INSERT INTO "item_descriptions" VALUES(13756,'fr','Ce Trophée vous permet de jouer au docteur avec vos alliés ou avec vos ennemis si vos combats sont trop faciles.');
INSERT INTO "item_descriptions" VALUES(13757,'fr','Ce Trophée permet de prouver que la Force est très puissante dans votre famille.');
INSERT INTO "item_descriptions" VALUES(13758,'fr','Ce Trophée permet de prouver que la Force est très puissante dans votre famille.');
INSERT INTO "item_descriptions" VALUES(13759,'fr','Ce Trophée permet de prouver que la Force est très puissante dans votre famille.');
INSERT INTO "item_descriptions" VALUES(13760,'fr','Ce Trophée vous rendra plus astucieux et vous permettra d''atteindre un score de 3 sur l''échelle de l''intelligence Bwork dont les bornes sont comprises entre moins l''infini et 1.');
INSERT INTO "item_descriptions" VALUES(13761,'fr','Ce Trophée vous rendra plus astucieux et vous permettra d''atteindre un score de 3 sur l''échelle de l''intelligence Bwork dont les bornes sont comprises entre moins l''infini et 1.');
