INSERT INTO "item_descriptions" VALUES(13763,'fr','Ce Trophée est assez puissant pour tout équilibrer. A part les sorts peut-être.');
INSERT INTO "item_descriptions" VALUES(13764,'fr','Ce Trophée est assez puissant pour tout équilibrer. A part les sorts peut-être.');
INSERT INTO "item_descriptions" VALUES(13765,'fr','Ce Trophée est assez puissant pour tout équilibrer. A part les sorts peut-être.');
INSERT INTO "item_descriptions" VALUES(13766,'fr','Un artisan inspiré a gravé au burin sur ce Trophée : "Mâle heureux en combat, mâle heureux pendant les ébats" .');
INSERT INTO "item_descriptions" VALUES(13767,'fr','Un artisan inspiré a gravé au burin sur ce Trophée : "Mâle heureux en combat, mâle heureux pendant les ébats" .');
INSERT INTO "item_descriptions" VALUES(13768,'fr','Un artisan inspiré a gravé au burin sur ce Trophée : "Mâle heureux en combat, mâle heureux pendant les ébats" .');
INSERT INTO "item_descriptions" VALUES(13769,'fr','Ce Trophée vous protégera des coups les plus fourbes mais vous empêchera d''en commettre. Saisissez cette opportunité de ressembler à quelqu''un de bien.');
INSERT INTO "item_descriptions" VALUES(13770,'fr','Ce Trophée vous protégera des coups les plus fourbes mais vous empêchera d''en commettre. Saisissez cette opportunité de ressembler à quelqu''un de bien.');
INSERT INTO "item_descriptions" VALUES(13771,'fr','Ce Trophée vous protégera des coups les plus fourbes mais vous empêchera d''en commettre. Saisissez cette opportunité de ressembler à quelqu''un de bien.');
INSERT INTO "item_descriptions" VALUES(13772,'fr','Ce Trophée vous permettra de toujours garder les pieds sur terre. Peut provoquer de terribles douleurs si vous utilisez une monture volante.');
INSERT INTO "item_descriptions" VALUES(13773,'fr','Ce Trophée vous permettra de toujours garder les pieds sur terre. Peut provoquer de terribles douleurs si vous utilisez une monture volante.');
INSERT INTO "item_descriptions" VALUES(13774,'fr','Ce Trophée vous permettra de toujours garder les pieds sur terre. Peut provoquer de terribles douleurs si vous utilisez une monture volante.');
INSERT INTO "item_descriptions" VALUES(13775,'fr','Le Rube ou la Pandrista ? Ce Trophée ne vous aidera pas à prendre une décision.');
INSERT INTO "item_descriptions" VALUES(13776,'fr','Le Rube ou la Pandrista ? Ce Trophée ne vous aidera pas à prendre une décision.');
INSERT INTO "item_descriptions" VALUES(13777,'fr','Le Rube ou la Pandrista ? Ce Trophée ne vous aidera pas à prendre une décision.');
INSERT INTO "item_descriptions" VALUES(13778,'fr','Ce Trophée vous permettra de mettre le feu au lac.');
INSERT INTO "item_descriptions" VALUES(13779,'fr','Ce Trophée vous permettra de mettre le feu au lac.');
INSERT INTO "item_descriptions" VALUES(13780,'fr','Ce Trophée vous permettra de mettre le feu au lac.');
INSERT INTO "item_descriptions" VALUES(13781,'fr','Nombreux sont les jeunes aventuriers qui pensent pouvoir vivre d''amour et d''eau fraîche. Les belles plantes peut-être.');
INSERT INTO "item_descriptions" VALUES(13782,'fr','Nombreux sont les jeunes aventuriers qui pensent pouvoir vivre d''amour et d''eau fraîche. Les belles plantes peut-être.');
INSERT INTO "item_descriptions" VALUES(13783,'fr','Nombreux sont les jeunes aventuriers qui pensent pouvoir vivre d''amour et d''eau fraîche. Les belles plantes peut-être.');
INSERT INTO "item_descriptions" VALUES(13784,'fr','On raconte à propos de ce Trophée qu''il force son propriétaire à combattre les fesses à l''air.
Soudain, vous êtes pris d''une irrésistible envie de l''équiper.');
INSERT INTO "item_descriptions" VALUES(13785,'fr','On raconte à propos de ce Trophée qu''il force son propriétaire à combattre les fesses à l''air.
Soudain, vous êtes pris d''une irrésistible envie de l''équiper.');
