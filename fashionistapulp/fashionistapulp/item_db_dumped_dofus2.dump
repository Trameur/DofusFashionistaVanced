INSERT INTO "item_descriptions" VALUES(7075,'es','Este pobre escudo ha visto demasiadas batallas, ya no sirve para nada en su estado actual. Tal vez Buwada, en el pueblo Pandala pueda reemplazarlo.');
INSERT INTO "item_descriptions" VALUES(7076,'es','Este pobre escudo ha visto demasiadas batallas, ya no sirve para nada en su estado actual. Tal vez Buwada, en el pueblo Pandala pueda reemplazarlo.');
INSERT INTO "item_descriptions" VALUES(7077,'es','Este escudo amarillo, poroso pero absorbente ha sido confeccionado con los restos de un animal que se había refugiado dentro de una Máscarapiña que se cayó luego en el fondo del mar.');
INSERT INTO "item_descriptions" VALUES(7078,'es','Este pobre escudo ha visto demasiadas batallas, ya no sirve para nada en su estado actual. Tal vez Buwada, en el pueblo Pandala pueda reemplazarlo.');
