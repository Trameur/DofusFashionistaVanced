INSERT INTO "item_descriptions" VALUES(13796,'es','Este trofeo rezuma un líquido viscoso gracias al cual podrás esquivar las tentativas de trabas de tus adversarios. ¡Pero ojo, no te quejes si tu pareja no quiere ni darte un besito!');
