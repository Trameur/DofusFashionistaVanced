INSERT INTO "item_descriptions" VALUES(8228,'pt','Além de perfeitas para proteger seus pezinhos delicados, essas sandálias são ótimas para esmagar pequenas criaturas que rastejam pela grama, como Xelores ou Eniripsas, por exemplo.');
INSERT INTO "item_descriptions" VALUES(8229,'pt','Além de perfeitas para proteger seus pezinhos delicados, essas sandálias são ótimas para esmagar pequenas criaturas que rastejam pela grama, como Xelores ou Eniripsas, por exemplo.');
INSERT INTO "item_descriptions" VALUES(8230,'pt','Além de perfeitas para proteger seus pezinhos delicados, essas sandálias são ótimas para esmagar pequenas criaturas que rastejam pela grama, como Xelores ou Eniripsas, por exemplo.');
INSERT INTO "item_descriptions" VALUES(8231,'pt','Se você for pequeno, esta capa feita de penas de Piu esconderá o seu traseiro. É uma proteção modesta, mas tem a vantagem de desviar os olhares dos passantes desse seu cabelo oleoso ou das suas verrugas gigantes.');
INSERT INTO "item_descriptions" VALUES(8232,'pt','Se você for pequeno, esta capa feita de penas de Piu esconderá o seu traseiro. É uma proteção modesta, mas tem a vantagem de desviar os olhares dos passantes desse seu cabelo oleoso ou das suas verrugas gigantes.');
