INSERT INTO "item_descriptions" VALUES(10000037,'es','¿A que es lindo? Armado hasta los dientes, sí, ¿pero qué esperabas de un aliado que viniera de Yopuka? Ahora eres su dueño, así que dale el gusto: ¡enséñale lo que significa la pelea de verdad!');
INSERT INTO "item_descriptions" VALUES(10000038,'es','¿A que es lindo? Armado hasta los dientes, sí, ¿pero qué esperabas de un aliado que viniera de Yopuka? Ahora eres su dueño, así que dale el gusto: ¡enséñale lo que significa la pelea de verdad!');
INSERT INTO "item_descriptions" VALUES(11812,'es','Cuando el osamodas tiene que sacar las garras, también parece natural que saque los colmillos... para defenderse. Algunos ven en este escudo un furioso puerkazo, otros un minotauroro embistiendo. También los hay que se dan media vuelta sin hacerse preguntas.');
INSERT INTO "item_descriptions" VALUES(12150,'es','Este escudo te protege tanto como te llena de gloria. Aunque la defensa no sea la estrategia favorita de Yopuka, admite que a veces puede ser útil.');
INSERT INTO "item_descriptions" VALUES(12650,'es','Una espada a la altura de tus hazañas durante el banquete de Yopuka. Seguro que está más afilada que el cerebro de tus amigos yopukas, aunque su dios piense otra cosa.');
INSERT INTO "item_descriptions" VALUES(12651,'es','Esta medalla es una recompensa por tu esfuerzo. Yopuka ha notado que la pelea es lo tuyo y ha querido regalártela para animarte a seguir por ese camino que a él tanto le gusta.');
INSERT INTO "item_descriptions" VALUES(12652,'es','Gracias a este anillo, tu puño también es un arma. Para Yopuka, siempre hay que estar preparado para el combate, aunque te hayas dejado el arma en la taberna.');
INSERT INTO "item_descriptions" VALUES(12653,'es','Gracias a esta alianza, tu puño también es un arma. Para Yopuka, siempre hay que estar preparado para el combate, aunque te hayas dejado el arma en la taberna.');
INSERT INTO "item_descriptions" VALUES(12654,'es','Unas botas bien robustas reforzadas con un metal precioso, para patear mejor el trasero de tus adversarios.');
INSERT INTO "item_descriptions" VALUES(12655,'es','Una espada a la altura de tus hazañas durante el banquete de Yopuka. Seguro que está más afilada que el cerebro de tus amigos yopukas, aunque su dios piense otra cosa.');
