INSERT INTO "item_descriptions" VALUES(1143,'fr','Selon l''étiquette, cette baguette aurait l''étrange pouvoir de faire obéir les gens. Le mode d''emploi stipule simplement de l''agiter fortement devant une personne. En cas de mauvais fonctionnement, l''agiter sur la personne marche bien aussi.');
INSERT INTO "item_descriptions" VALUES(1144,'fr','Selon l''étiquette, cette baguette aurait l''étrange pouvoir de faire obéir les gens. Le mode d''emploi stipule simplement de l''agiter fortement devant une personne. En cas de mauvais fonctionnement, l''agiter sur la personne marche bien aussi.');
