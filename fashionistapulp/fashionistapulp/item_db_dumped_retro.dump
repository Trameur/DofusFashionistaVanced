INSERT INTO "item_descriptions" VALUES(1131,'es','Esta pesada varita ha destrozado más de un cráneo de pecador. Los sacerdotes yopuka la utilizan para absolver radical y definitivamente a los arrepentidos.');
INSERT INTO "item_descriptions" VALUES(1132,'es','Esta obra de arte simboliza la alianza de la pureza... con la estupidez. Su creador tenía que serlo un poco también ya que le confirió enormes poderes mágicos.');
INSERT INTO "item_descriptions" VALUES(1133,'es','La emancipación de las amas de casa aniripsa de menos de 50 años empezó gracias a esta varita: a la vez temida por los monstruos y muy eficaz contra el polvo. Muy práctico, sí señora.');
INSERT INTO "item_descriptions" VALUES(1134,'es','La emancipación de las amas de casa Aniripsa de menos de 50 años empezó gracias a esta varita: a la vez temida por los monstruos y muy eficaz contra el polvo. Muy práctico, sí señora.');
