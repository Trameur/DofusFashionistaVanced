INSERT INTO "item_descriptions" VALUES(10000037,'pt','Não é fofo? Tudo bem que está armado até os dentes, mas o que esperar de um aliadozinho de Iop? Agora que você é o dono dele, faça um agrado ao bichinho: mostre o que é uma luta de verdade!');
INSERT INTO "item_descriptions" VALUES(10000038,'pt','Não é fofo? Tudo bem que está armado até os dentes, mas o que esperar de um aliadozinho de Iop? Agora que você é o dono dele, faça um agrado ao bichinho: mostre o que é uma luta de verdade!');
INSERT INTO "item_descriptions" VALUES(11812,'pt','Se ele mostra suas garras e presas, é natural que Osamodas também mostre suas defesas... para se defender. Tem gente que vê neste escudo um furioso Porco Imundo, enquanto outros veem um Minotoro preparando uma investida. Já a maioria dá meia-volta sem nem pensar nisso.');
INSERT INTO "item_descriptions" VALUES(12150,'pt','Além de proteger, este escudo cobrirá você de glória. Apesar da defesa não ser a estratégia favorita de Iop, ele admite que, de vez em quando, ela pode ser útil.');
INSERT INTO "item_descriptions" VALUES(12650,'pt','Uma espada à altura das suas proezas em combate durante o banquete de Iop. Ela é mais afiada que seus amigos Iops, mesmo que o deus deles pense o contrário.');
INSERT INTO "item_descriptions" VALUES(12651,'pt','Esta medalha é a recompensa pelos seus esforços. Iop reparou que combater é com você mesmo e decidiu oferecer-lhe esta medalha para encorajar você a continuar no caminho que ele tanto valoriza.');
INSERT INTO "item_descriptions" VALUES(12652,'pt','Com este anel, ai de quem pensa que um tapinha não dói... Para Iop, sempre devemos estar prontos para a batalha, mesmo tendo esquecido a espada na taverna.');
INSERT INTO "item_descriptions" VALUES(12653,'pt','Com esta aliança, ai de quem pensa que um tapinha não dói... Para Iop, sempre devemos estar prontos para a batalha, mesmo tendo esquecido a espada na taverna.');
INSERT INTO "item_descriptions" VALUES(12654,'pt','Botas robustas e reforçadas com um metal precioso, prontas para chutar o traseiro dos seus adversários.');
INSERT INTO "item_descriptions" VALUES(12655,'pt','Uma espada à altura das suas proezas em combate durante o banquete de Iop. Ela é mais afiada que seus amigos Iops, mesmo que o deus deles pense o contrário.');
