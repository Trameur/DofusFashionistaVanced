BEGIN TRANSACTION;
CREATE TABLE extra_lines (item INTEGER, line text, language text, FOREIGN KEY(item) REFERENCES items(id));
CREATE TABLE item_descriptions (
            item INTEGER,
            language TEXT,
            description TEXT,
            PRIMARY KEY (item, language),
            FOREIGN KEY (item) REFERENCES items(id)
        );
CREATE TABLE item_drops (item INTEGER, monster_ankama_id INTEGER, rate REAL);
