INSERT INTO "item_descriptions" VALUES(10952,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10953,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10954,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10955,'fr','Quoi de plus normal pour un volatile que d''être bagué !');
INSERT INTO "item_descriptions" VALUES(10956,'fr','Cette paire de bottes, comme tout le reste de la panoplie du Corbeau Noir, est passée de pied en pied à travers les âges. Ce qui explique sa forte odeur de Clakoss...');
INSERT INTO "item_descriptions" VALUES(10957,'fr','Du fil, une aiguille, quelques plumes prélevées sur des dépouilles de Corbacs en décomposition, et vous voilà en possession de la plus chic des capes !');
INSERT INTO "item_descriptions" VALUES(10958,'fr','Inutile de vous cacher ! On vous a démasqué, c''est donc vous, le Corbeau Noir !');
INSERT INTO "item_descriptions" VALUES(10959,'fr','Vous y avez laissé des plumes, mais la voilà enfin entre vos mains ! L''épée du Corbeau Noir...');
INSERT INTO "item_descriptions" VALUES(10971,'fr','Équipé de ce sac, vous pourrez faire les quatre cents coups. Et toujours avec le sourire, petit galopin va !');
INSERT INTO "item_descriptions" VALUES(10985,'fr','Ce Chacha a connu l''hiver du grand nord, même s''il n''a jamais vu le grand nord. Personne ne sait comment il a pu arriver en Amakna, les anciens prétendent qu''il aurait été importé de l''île de Frigost pour lutter contre la prolifération des Wabbits. Ce familier dévoreur d''âmes ne mange que les Wabbits.');
INSERT INTO "item_descriptions" VALUES(10000065,'fr','Ce Chacha a connu l''hiver du grand nord, même s''il n''a jamais vu le grand nord. Personne ne sait comment il a pu arriver en Amakna, les anciens prétendent qu''il aurait été importé de l''île de Frigost pour lutter contre la prolifération des Wabbits. Ce familier dévoreur d''âmes ne mange que les Wabbits.');
INSERT INTO "item_descriptions" VALUES(11011,'fr','Plus fou que le Tifoux commun mais surtout beaucoup moins roux, ce familier peut être trempé dans l''eau sans qu''il ne soit nécessaire de se boucher le nez. Ce familier se nourrit des créatures qui vivent dans l''Arbre Hakam.');
INSERT INTO "item_descriptions" VALUES(10000014,'fr','Plus fou que le Tifoux commun mais surtout beaucoup moins roux, ce familier peut être trempé dans l''eau sans qu''il ne soit nécessaire de se boucher le nez. Ce familier se nourrit des créatures qui vivent dans l''Arbre Hakam.');
INSERT INTO "item_descriptions" VALUES(11049,'fr','Grilliane était un très grand magicien, célèbre pour avoir réinventé la poudre d''escampette, après avoir oublié comment la fabriquer.');
INSERT INTO "item_descriptions" VALUES(11050,'fr','Cette cape est censée protéger votre postérieur des morsures de monstroplantes.');
INSERT INTO "item_descriptions" VALUES(11051,'fr','Grilliane portait cette amulette autour du coup lorsqu''il... Lorsqu''il... Quelle importance ? Il est mort et désormais cette amulette vous appartient.');
INSERT INTO "item_descriptions" VALUES(11052,'fr','Grilliane le magicien a échangé un anneau magique contre cette paire de bottes. Il semblerait qu''il ait perdu au change puisqu''elles ne sont même pas rembourrées.');
INSERT INTO "item_descriptions" VALUES(11055,'fr','Gadjète était l''un des bricoleurs les plus créatifs du Monde des 12. Malheureusement il était également l''un des plus étourdis. On raconte qu''il a confondu son enclume et la tête de sa femme plus d''une fois et qu''elle ne s''en plaignait pas.');
INSERT INTO "item_descriptions" VALUES(11056,'fr','Gadjète a fabriqué cette cape en espérant qu''elle puisse lui permettre de voler et ainsi échapper plus facilement aux punitions administrées quotidiennement par sa femme.');
INSERT INTO "item_descriptions" VALUES(11057,'fr','En mettant cette ceinture à l''envers et en la serrant suffisamment fort, vous pourrez peut-être activer le module intégré de rétromagie. Il n''a jamais fonctionné, mais vous pourrez l''activer tout de même. Vous pourrez donc la revendre à une personne aussi naïve que vous.');
INSERT INTO "item_descriptions" VALUES(11058,'fr','Porté par plusieurs générations de Bricoleurs, cet anneau protège une phalange de vos coups de marteau. Malheureusement, il n''est jamais vendu par lot de cinq.');
INSERT INTO "item_descriptions" VALUES(11465,'fr','Amoureux inconditionnel de l''humour douteux des glutins, Kometh a été subjugué par le vôtre. Il a donc décidé de quitter les forêts enneigées de l''île de Nowel pour vivre la plus formidable des aventures à vos côtés. Son secret pour accélérer la repousse de ses deux magnifiques appendices, une fois la période de mue passée ? Faire feu de tout bois... Jusqu''à se nourrir de ce dernier ! Avec lui : rien ne se perd, tout se transforme !');
INSERT INTO "item_descriptions" VALUES(10000048,'fr','Amoureux inconditionnel de l''humour douteux des glutins, Kometh a été subjugué par le vôtre. Il a donc décidé de quitter les forêts enneigées de l''île de Nowel pour vivre la plus formidable des aventures à vos côtés. Son secret pour accélérer la repousse de ses deux magnifiques appendices, une fois la période de mue passée ? Faire feu de tout bois... Jusqu''à se nourrir de ce dernier ! Avec lui : rien ne se perd, tout se transforme !');
INSERT INTO "item_descriptions" VALUES(11471,'fr','Très spéciale, cette cape comptabilise le nombre de personnes qui se sont intéressées à elle. Elle est parfois utilisée dans le but d''exposer ses trophées de guerre, en les y attachant, et ainsi jauger l''intérêt qu''ils peuvent susciter. Certains aventuriers et commerçants vont même parfois jusqu''à former une chaîne de Tioubes lorsqu''ils veulent promouvoir plusieurs objets à la fois.');
INSERT INTO "item_descriptions" VALUES(11472,'fr','En portant ce bouclier, vous serez visible de loin. Ceci permettra à n''importe qui de suivre vos aventures les plus palpitantes, où que vous soyez, y compris et surtout à la taverne d''Astrub.');
INSERT INTO "item_descriptions" VALUES(11473,'fr','Ce casque peut parler : il répète vos paroles et les transmet aux autres Caskwitteurs à proximité qui les répéteront à leur tour. Il fut très utile en complément des Pious voyageurs jusqu''à ce qu''il se popularise davantage : les messages transmis ont tendance à revenir au Caskwitteur d''origine, générant une boucle et donc un brouhaha incessant. Aujourd''hui il est utilisé dans le jeu du Ragekwitt visant à tester la patience des participants : chacun en pose un sur sa tête et celui qui supporte le bruit le plus longtemps est vainqueur.');
INSERT INTO "item_descriptions" VALUES(11476,'fr','Cette coiffe aux allures familières a été enchantée par Hel Munster lui-même suite aux demandes incessantes d''un célèbre couturier d''Astrub. Il désirait proposer une collection qui s''adapte aux couleurs de l''individu qui la porte. Décolorée par un procédé top secret, vous reconnaissez pourtant l''odeur caractéristique de la bave de Mulou qui s''en dégage... Beurk !');
INSERT INTO "item_descriptions" VALUES(11477,'fr','Cette coiffe aux allures familières a été enchantée par Hel Munster lui-même suite aux demandes incessantes d''un célèbre couturier d''Astrub. Il désirait proposer une collection qui s''adapte aux couleurs de l''individu qui la porte. Décolorée par un procédé top secret, vous reconnaissez pourtant l''odeur caractéristique de la bave de Mulou qui s''en dégage... Beurk !');
