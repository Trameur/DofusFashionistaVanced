INSERT INTO "item_descriptions" VALUES(10936,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10937,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10938,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10939,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
