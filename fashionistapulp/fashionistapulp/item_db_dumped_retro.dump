INSERT INTO "item_descriptions" VALUES(7075,'fr','Ce brave bouclier a vu trop de batailles, il n''est plus bon à rien dans son état. Peut-être que Bouwada, au village Pandala, pourra vous le remplacer.');
INSERT INTO "item_descriptions" VALUES(7076,'fr','Ce brave bouclier a vu trop de batailles, il n''est plus bon à rien dans son état. Peut-être que Bouwada, au village Pandala, pourra vous le remplacer.');
INSERT INTO "item_descriptions" VALUES(7077,'fr','Ce bouclier jaune, poreux mais absorbant a été conçu à partir des restes d''un animal qui avait élu domicile dans un Maskananas tombé au fond de la mer.');
INSERT INTO "item_descriptions" VALUES(7078,'fr','Ce brave bouclier a vu trop de batailles, il n''est plus bon à rien dans son état. Peut-être que Bouwada, au village Pandala, pourra vous le remplacer.');
