INSERT INTO "item_descriptions" VALUES(1136,'es','La emancipación de las amas de casa Aniripsa de menos de 50 años empezó gracias a esta varita: a la vez temida por los monstruos y muy eficaz contra el polvo. Muy práctico, sí señora.');
INSERT INTO "item_descriptions" VALUES(1137,'es','Huveta inventó estas varitas para que su marido anutrof regresara del bar donde se pasaba días enteros. Bien utilizadas, estas permitían poner picante a su pareja, pero nadie dijo cómo exactamente.');
INSERT INTO "item_descriptions" VALUES(1138,'es','Huveta inventó estas varitas para que su marido anutrof regresara del bar donde se pasaba días enteros. Bien utilizadas, estas permitían poner picante a su pareja, pero nadie dijo cómo exactamente.');
