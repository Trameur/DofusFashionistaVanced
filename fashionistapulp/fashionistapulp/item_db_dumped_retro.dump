INSERT INTO "item_descriptions" VALUES(1120,'de','Der Bauplan dieses uralten Bogens wurde in den Tiefen der Ruinen von Din von einem Abenteurer gefunden, der wegen seiner Peitsche gefürchtet war. Es ist allerdings nicht bekannt, ob die Gerüchte wahr sind, er habe sein altes, krachmachendes Lederding gegen diesen wunderschönen, biologisch abbaubaren Bogen eingetauscht.');
INSERT INTO "item_descriptions" VALUES(1121,'de','Nehmen Sie einen alten, gebrauchten Bogen, streuen Sie etwas Wunderpulver darauf und bittet einen Drachen, seinen Odem darauf zu hauchen. Sie erhalten dann einen verzauberten Bogen. Doch dieses märchenhafte Rezept funktioniert leider nicht wirklich... Drachen zielen nämlich immer daneben.');
INSERT INTO "item_descriptions" VALUES(1122,'de','Nehmen Sie einen alten, gebrauchten Bogen, streuen Sie etwas Wunderpulver darauf und bittet einen Drachen, seinen Odem darauf zu hauchen. Sie erhalten dann einen verzauberten Bogen. Doch dieses märchenhafte Rezept funktioniert leider nicht wirklich... Drachen zielen nämlich immer daneben.');
