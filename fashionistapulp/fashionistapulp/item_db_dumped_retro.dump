INSERT INTO "item_descriptions" VALUES(1104,'de','Der Eniripsa Mie Däpan fertigte eine ganze Reihe dieser spitzen Stäbe an, um gegen Diebstähle vorzugehen. Theroretisch sollen die Stäbe die Macht haben, in der Zeit zurückzureisen, um Überfälle zu verhindern. Doch in der Praxis landeten sie alle im Auge eines mächtigen und mächtig darüber erbosten Dämonen.');
INSERT INTO "item_descriptions" VALUES(1105,'de','Dieser schwere Stab hat bereits mehr als nur einen Sünderschädel zertrümmert. Es waren nämlich Iop-Priester, die sich seiner bedienten, um auf radikale und endgültige Weise Reuigen die Absolution zu erteilen.');
INSERT INTO "item_descriptions" VALUES(1107,'de','Dieser schwere Stab hat bereits mehr als nur einen Sünderschädel zertrümmert. Es waren nämlich Iop-Priester, die sich seiner bedienten, um auf radikale und endgültige Weise Reuigen die Absolution zu erteilen.');
INSERT INTO "item_descriptions" VALUES(1108,'de','Dieser schwere Stab hat bereits mehr als nur einen Sünderschädel zertrümmert. Es waren nämlich Iop-Priester, die sich seiner bedienten, um auf radikale und endgültige Weise Reuigen die Absolution zu erteilen.');
INSERT INTO "item_descriptions" VALUES(1109,'de','Dieser Stock ist ein genaues Duplikat eines legendären Artefaktes, nur etwas weniger mächtig. Doch da er hervorragend dazu geeignet ist, bei einem kurzen Schlag auf dem Boden waberndes Licht zu produzieren (Oh!), und immer bereit ist, ein wenig eure Stimme zu verändern (Wah!), wird er anderen etwas vorgaukeln, das gar nicht stimmt: nämlich dass ihr ein großer Magier seid.');
INSERT INTO "item_descriptions" VALUES(1110,'de','Dieser Stock ist ein genaues Duplikat eines legendären Artefaktes, nur etwas weniger mächtig. Doch da er hervorragend dazu geeignet ist, bei einem kurzen Schlag auf dem Boden waberndes Licht zu produzieren (Oh!), und immer bereit ist, ein wenig eure Stimme zu verändern (Wah!), wird er anderen etwas vorgaukeln, das gar nicht stimmt: nämlich dass ihr ein großer Magier seid.');
