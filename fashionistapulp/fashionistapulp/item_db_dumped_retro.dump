INSERT INTO "item_descriptions" VALUES(1112,'de','"Aus einem Fresssack lässt sich alles machen!", war der Slogan eines Händlers, der sich auf die Wiederverwertung von Fresssäcken spezialisiert hatte. Dieser Bogen ist ein gutes Beispiel dafür. Sieht zwar nicht sehr ästhetisch aus, ist aber dafür sehr wirkungsvoll.');
INSERT INTO "item_descriptions" VALUES(1113,'de','Dieses Sondermodell eines Bogens, welches es nur im hohen Norden Amaknas zu kaufen gibt, ist spottbillig. Allerdings muss man es auch selbst zusammenbauen, so dass das Endergebnis stark von der Kompetenz des Bastlers abhängt.');
INSERT INTO "item_descriptions" VALUES(1114,'de','Dieses Sondermodell eines Bogens, welches es nur im hohen Norden Amaknas zu kaufen gibt, ist spottbillig. Allerdings muss man es auch selbst zusammenbauen, so dass das Endergebnis stark von der Kompetenz des Bastlers abhängt.');
