INSERT INTO "item_descriptions" VALUES(13215,'pt','Esta arma lhe foi emprestada por Notend Less, que viu potencial em você... Bom... na verdade foi seu lado “bobo da feira” que ele viu. Não é bem um elogio... De qualquer forma, com ela você pode apropriar-se temporariamente das características de uma classe, o que não é nada mal.');
INSERT INTO "item_descriptions" VALUES(13216,'pt','Esta arma lhe foi emprestada por Notend Less, que viu potencial em você... Bom... na verdade foi seu lado “bobo da feira” que ele viu. Não é bem um elogio... De qualquer forma, com ela você pode apropriar-se temporariamente das características de uma classe, o que não é nada mal.');
INSERT INTO "item_descriptions" VALUES(13218,'pt','O Galeápagos é uma mascote conhecida por suas inúmeras traições. Ele forma alianças temporárias com outros convivas, mas não hesita em traí-los se a oportunidade for favorável.');
INSERT INTO "item_descriptions" VALUES(13219,'pt','O Sagum Troolex é uma capa confeccionada com as armas abandonadas nos combates pelos aventureiros que caíram para os golpes dos adversários na arena do Gladiatrool. Feita de uma trama tecida com esmero e de um tridente astuciosamente incorporado, ela alia estilo e bravura. Entretanto, não conte com ela para se aquecer!');
INSERT INTO "item_descriptions" VALUES(13220,'pt','O Galea Troolex, criado pelo próprio Notend Less, é bem mais do que um simples chapéu. Ele concede ao seu portador um estilo incomparável, tanto na arena do Gladiatrool quanto fora dela. Esta peça de armadura só pode ser usada por quem triunfou em vários combates na arena do Gladiatrool.');
INSERT INTO "item_descriptions" VALUES(13222,'pt','Com este certificado, você poderá buscar sua montaria em um estábulo.
Atenção: o certificado é válido por apenas 20 dias. Ao final do prazo, sua montaria será solta na natureza, e o certificado perderá a validade. Você não poderá mais pegar sua montaria de volta. Lembre-se sempre de deixar sua montaria em um estábulo quando for se ausentar por muito tempo.');
INSERT INTO "item_descriptions" VALUES(13224,'pt','Não o olhe diretamente nos olhos, infeliz! Você corre o risco de começar a latir e coçar a orelha com o pé. Ou coisa pior...');
INSERT INTO "item_descriptions" VALUES(13225,'pt','Balançar ao vento já concede a esta capa um efeito mágico, sem falar no cajado único que deve pelo menos brilhar no escuro se você souber manejá-lo.');
INSERT INTO "item_descriptions" VALUES(13226,'pt','Todo mago que se preze veste um capuz para ficar mais tenebroso e fazer entradas marcantes por onde quer que passe. Este até mesmo realça seus olhos!');
INSERT INTO "item_descriptions" VALUES(13227,'pt','Os padrões ancestrais certamente devem abrigar uma magia potente. E esta transparência! Ela já lhe deu a impressão de estar escondendo algo? Você tem quatro horas.');
INSERT INTO "item_descriptions" VALUES(13228,'pt','Ao contrário do que parece, este bichinho não tem remorsos nem empatia. Mas ele atrai a dos outros, o que compensa a sua impassibilidade.');
INSERT INTO "item_descriptions" VALUES(13229,'pt','Esta liga de couro e ferro fará você sentir que não é mais totalmente humano e que tem olhos na nuca. Fica a pergunta se sua aparência não é ainda mais ameaçadora de costas...');
INSERT INTO "item_descriptions" VALUES(13230,'pt','Dê um tapa no visual com esta cartola com óculos e máscara respiratória integrados. Mas, mesmo assim, cuidado para não respirar muita Stasis!');
INSERT INTO "item_descriptions" VALUES(13231,'pt','Depois de vestir esta manopla enorme, você ganha muito mais respeito quando bate na mesa. O quê? Ah, claro, quando você bate nos inimigos também.');
INSERT INTO "item_descriptions" VALUES(13233,'pt','Este magnífico escudo em forma de bola de neve de Nataw é a arma perfeita para quem desejam proteger a própria pele sem deixar o espírito festivo de lado. Atenção: sacudi-lo escudo pode provocar uma tempestade... de mau humor nos seus adversários.');
INSERT INTO "item_descriptions" VALUES(13234,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13235,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13236,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13237,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13240,'pt','Parabéns! Agora você é responsável por Hidwege. Esta ave possui um talento fora do comum: ela traz sua correspondência e se desfaz das más notícias. Contas esquecidas, convites incômodos ou publicidade indesejada, Hidwege faz tudo desaparecer como mágica, mantendo somente o que pode iluminar sua jornada.');
INSERT INTO "item_descriptions" VALUES(13241,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13242,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13243,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13244,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13245,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13246,'pt','Este chapéu é uma homenagem a Geraldo Izi, mais conhecido como Gegê. Ele era um grande "tryhard" que não recuava diante de desafio nenhum, até levar uma surra de um total desconhecido, fazendo ele cair em uma crise de nervos mortal. Ao usá-lo, você não conseguirá evitar de berrar seu nome depois de cada vitória.');
INSERT INTO "item_descriptions" VALUES(13247,'pt','Essa capa absorve e canaliza a raiva dos inimigos derrotados. Quanto mais eles choram, mais impregnada ela fica com o amargor deles, e mais ela brilha.');
INSERT INTO "item_descriptions" VALUES(13248,'pt','Seja qual for a sua frustração, este cajado vai continuar intacto, mesmo após ter sido arremessado contra a parede durante suas crises de raiva depois de uma derrota.');
INSERT INTO "item_descriptions" VALUES(13249,'pt','Forjado para aqueles que juraram lealdade aos reinos virtuais, este escudo protege seu portador da ameaça mais desafiadora: tocar grama.');
INSERT INTO "item_descriptions" VALUES(13250,'pt','Esta mascote é o único ser vivo capaz de suportar nosso odor sem nem torcer o nariz, como outros fariam. É preciso dizer que após semanas de combates acalorados sem um único momento para se banhar, fica difícil dizer se ele só tolera nosso odor... ou se ele é parte dele.');
INSERT INTO "item_descriptions" VALUES(13253,'pt','Este capa com aparência familiar foi encantado pelo próprio Hel Munster depois de muita insistência por parte de um famoso alfaiate de Astrub. Ele queria criar uma coleção cujas peças se adaptassem às cores de seu dono. Embora tenha sido tingido usando um método secreto, você reconhece o cheiro característico da baba do Milobo... Eca!');
INSERT INTO "item_descriptions" VALUES(13260,'pt','O Escudo de Mercenário ostenta orgulhosamente o emblema do clã, enquanto duas asas fixadas em sua parte traseira lhe concedem um aspecto majestoso... mas que não ajudarão você a escapar dos golpes.');
INSERT INTO "item_descriptions" VALUES(13261,'pt','No decorrer dos serviços, essa capa evolui, refletindo o prestígio e a fidelidade de seu portador em relação ao clã dos Mercenários.');
INSERT INTO "item_descriptions" VALUES(13262,'pt','O Veterano percorreu campos de batalha, esquivou-se de lâminas e sobreviveu a inúmeros combates. Hoje, ele já não combate mais. Ele permanece ao seu lado, preparado para rosnar ou mostrar seus dentes, se necessário.');
INSERT INTO "item_descriptions" VALUES(13263,'pt','Este chapéu concede um grande poder de persuasão. Seus interlocutores não conseguirão recusar nada que você peça, nem mesmo um pouco de azzúcar ou um carinho.');
INSERT INTO "item_descriptions" VALUES(13264,'pt','Mamãe e família vão passear! Pensa no falatório, na cantoria, nos piados e na barulheira infernal. Ai de quem tiver pena deles... Se não for para cima, vai levar bicada até dizer chega...');
INSERT INTO "item_descriptions" VALUES(13265,'pt','Dizem que o Sinistro congelado neste escudo parou de funcionar, parando consigo a passagem do tempo. Até parece que o fim do movimento deste metrônomo tem o poder congelar o tempo. Uma heresia da qual muitos Xelores vão dissuadir você.');
INSERT INTO "item_descriptions" VALUES(13266,'pt','O paradoxo desta mascote é que ela foi criada com inspiração no futuro. Mas, quando o modelo só é inventado anos depois da cópia usada na elaboração do original, como estabelecer qual versão é a autêntica? É a questão da Paradoxina.');
INSERT INTO "item_descriptions" VALUES(13267,'pt','Esta máquina semelhante a uma coruja parece estar ligada ao poder do Eliacubo. Isso se não for o próprio...');
INSERT INTO "item_descriptions" VALUES(13268,'pt','Este misterioso portal parece estar ligado a outra dimensão. Muito prático para sumir com qualquer projétil lançado na sua direção, mas cuidado para não entrar nele sem querer: ninguém sabe onde vai dar...');
INSERT INTO "item_descriptions" VALUES(13269,'pt','Esta capa não parece ser feita de tecido, e sim da trama das dimensões.');
INSERT INTO "item_descriptions" VALUES(13270,'pt','Esta máscara radiante poderia fazer de você um farol na noite, ou o destruidor de mundos.');
INSERT INTO "item_descriptions" VALUES(13271,'pt','Este dragãozinho pode até ser fofo agora, mas espere só para ver adulto.');
INSERT INTO "item_descriptions" VALUES(13272,'pt','Este dragãozinho apegadíssimo ao ovo é uma defesa perfeita contra quem tentar chegar perto dele.');
INSERT INTO "item_descriptions" VALUES(13273,'pt','Esta capa de pele de dragão vai proteger dos tiros que saírem pela culatra, mas não do seu carma ruim.');
INSERT INTO "item_descriptions" VALUES(13274,'pt','Com este capacete dragontino, seus inimigos verão a morte com seus próprios olhos, e você verá tudo cor-de-rosa.');
INSERT INTO "item_descriptions" VALUES(13275,'pt','O espesso bloco de gelo que cerca este piu o protege do frio invernal de Frigost.');
INSERT INTO "item_descriptions" VALUES(13276,'pt','Se estiver no meio de uma tempestade de neve, ponha este escudo na frente do rosto: ele vai proteger sua vista dos flocos e do vento e vai iluminar o caminho à sua frente. Por outro lado, ele não dá as horas.');
INSERT INTO "item_descriptions" VALUES(13277,'pt','Quanto a Frigost, é melhor se equipar bem: esta confortável capa de pele de Papamute será sua grande aliada na hora de encarar os ventos gelados da ilha.');
INSERT INTO "item_descriptions" VALUES(13278,'pt','Com este capuz grosso na cabeça, você com certeza não vai pegar friagem. Só tome cuidado para os servos do Conde não pegarem você. Seria mais difícil se recuperar.');
INSERT INTO "item_descriptions" VALUES(13279,'pt','Se você sabe manter a cabeça fria mas tem um toque de loucura, este capacete vai deixar você picolelé da cuca.');
INSERT INTO "item_descriptions" VALUES(13280,'pt','Feliz dono de um Smilaxé de pelagem quentinha e sedosa, Traspafrent logo percebeu que ele soltava uma quantidade absurda de pelo. Pragmático, fez capas para os invernos rigorosos de Frigost.');
INSERT INTO "item_descriptions" VALUES(13282,'pt','Uma maça imponente que emite um forte odor de cenouwawa, sinal de que passou muito tempo na toca do Wa Wabbit. Além de notável no combate, ela também serve para calçar a porta do Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(13283,'pt','Um Boon a seu serviço?! Quem poderia imaginar que essa mascote fofinha um dia faria parte do seu arsenal? Essa pelúcia ambulante, pequenininha sob qualquer ângulo, é, na verdade, um grande aliado: de dia, desorienta seus inimigos apelando à simpatia deles com um simples olhar; à noite, reconforta você depois de um dia difícil, deixando você se aconchegar em sua pelagem macia.');
INSERT INTO "item_descriptions" VALUES(13284,'pt','Com você vivo e armado com esse escudo, nenhum invasor cruzará o limiar da cidade de Brutas! Bom... você sabe que o escudo não faz todo o trabalho sozinho, né?');
INSERT INTO "item_descriptions" VALUES(13285,'pt','Forjado de acordo com a mais pura tradição dos artesãos-mercenários, este capacete é reconhecido por todos e perigoso como ninguém.');
INSERT INTO "item_descriptions" VALUES(13286,'pt','Tão conhecido quanto uma Orichama, esta capa deixa claro que você carrega toda Astrub nas costas!');
INSERT INTO "item_descriptions" VALUES(13287,'pt','A rendição é garantida com este guarda um pouco maior que um chaveiro! Não cometa o erro de subestimá-lo, pois ele poderia facilmente deixar você sem chão.');
INSERT INTO "item_descriptions" VALUES(13288,'pt','Quem ousaria cruzar espadas com alguém que ostenta esta capa de guerra? Talvez um Sram, levado pela ganância, que pensaria que não é só a sua roupa que tem a cor de kamas...? Malditos ladrões e assassinos! Eles sempre atacam pelas costas, esses malandros!');
INSERT INTO "item_descriptions" VALUES(13289,'pt','Assim como um espírito misterioso, fiel à sua gloriosa cidade, ninguém reconhecerá você – nem mesmo sua mãe – com esse fabuloso capacete com uma crista flamejante! Só esperamos que você consiga ver alguma coisa...');
INSERT INTO "item_descriptions" VALUES(13290,'pt','À primeira vista já dá para acreditar que ele vale o seu preço em kamas. No entanto, essa não é a melhor qualidade deste escudo: ele é, antes de mais nada, uma chama que é transmitida entre nobres guerreiros, fiéis a uma única e mesma cidade... Amakna!');
INSERT INTO "item_descriptions" VALUES(13291,'pt','Este pequeno tanque sobre patas não é do tipo que sai do caminho para você passar. Será preciso passar por cima dele se você quiser... ahn... passar.');
INSERT INTO "item_descriptions" VALUES(13292,'pt','Se a maioria das mascotes dá vontade de apertar, essa aqui pode acabar apertando de volta, sem dó nem piedade! Ah, e saiba que ela não curte muito regiões com um sol pra cada um, não...');
INSERT INTO "item_descriptions" VALUES(13293,'pt','Esse escudo dá um novo sentido à expressão "aguentar uma barra". Cuidado: seus inimigos podem acabar ficando viciados!');
INSERT INTO "item_descriptions" VALUES(13294,'pt','E PÁ! A gente fez um Chaprestígio.');
INSERT INTO "item_descriptions" VALUES(13295,'pt','Criada pelos maiores mestres chocolateiros do Mundo dos Doze, essa capa é uma verdadeira obra-prima à prova até de respingos de chocolate. Mas não de mordidas, viu?');
INSERT INTO "item_descriptions" VALUES(13300,'pt','O chato de ter sete vidas é que você precisa passar pela fase da "infância" toda vez que reencarna. Caso ache esse Beberubim um pouco ranzinza às vezes, tenha compaixão: ele já tentou largar a chupeta sete vezes, e nunca conseguiu!');
INSERT INTO "item_descriptions" VALUES(13301,'pt','O colar Ankafiliado é dado aos mais fiéis adeptos do universo do Krosmoz. Ele concede ao seu portador um passe que permite abrir qualquer porta relacionada ao universo Ankama, sem exceção.');
INSERT INTO "item_descriptions" VALUES(13304,'pt','Ficou triste? Ela pode ajudar. Ninguém consegue resistir à pequena Elante.');
INSERT INTO "item_descriptions" VALUES(13306,'pt','O Minichefe é uma criatura antiga muito talentosa que carrega uma pena por cada feito realizado ao longo dos anos. Talvez sua sabedoria recaia sobre você, mas saiba que, do ponto de vista dele, é VOCÊ a pequena mascote que o acompanha em suas aventuras!');
INSERT INTO "item_descriptions" VALUES(13307,'pt','Sempre com a praticidade em mente, o chefe antigo confeccionou seu símbolo ritualístico com uma placa sólida de pedra que podia lhe servir de escudo. Um objeto tão útil na guerra quanto nas cerimônias oficiais! Recomendamos lavá-lo bem entre os usos.');
INSERT INTO "item_descriptions" VALUES(13308,'pt','Dizem que, uma vez, o chefe antigo conseguiu abater dois pássaros com uma flecha só, com os olhos vendados. Este chapéu tradicional honra essa lenda, com duas penas representando os pássaros e um pedaço de tecido que impede você de enxergar qualquer coisa. Boa caçada!');
INSERT INTO "item_descriptions" VALUES(13309,'pt','O que não dá para fazer com essa capa? Cobertor, capa de chuva, pano, capacho... O chefe antigo era engenhoso, mas também tinha senso de estilo. Honre sua memória dando um novo uso para esta capa! Ou vista-a sobre seus ombros, também serve.');
INSERT INTO "item_descriptions" VALUES(13346,'pt','Ce petit dragogindonneau rêve de fêter nowel, encore faut-il qu''il ne se fasse pas rôtir pendant la Fête de Fanks Guivingue.');
INSERT INTO "item_descriptions" VALUES(13349,'pt','Este machado é muito especial. Sua lâmina vibratória toca belas músicas enquanto você dilacera a vida de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(13350,'pt','Au tréfonds des terres, ce phorreur amalgamé avec cette pierre rare qu''on appelle Bismuth fore à foison. Doué d''un sens aigu de l''orientation, c''est sans effort qu''il se repère dans les tranchées labyrinthiques ; une qualité inestimable quand on veut traverser un dédale, mais qui n''est pourtant rien comparée à sa bonté.');
INSERT INTO "item_descriptions" VALUES(13352,'pt','Quando foi criado, este escudo recebeu um feitiço para multiplicar os talentos do portador. Entretanto, em decorrência de um erro gramatical infeliz durante o encantamento, esse poder só pode ser ativado quando é usado para semear a cizânia. Em suma, o escudo ideal para os almoços de família.');
INSERT INTO "item_descriptions" VALUES(13353,'pt','Quando você coloca esses óculos no nariz, passa a ver a vida como através de um filtro. Seu rosto se contorce em caretas como o da famosa Bella Porche, e uma súbita vontade de dançar ao som de ritmos viciantes toma conta de você. Se olhar ao redor, verá que todos parecem afetados pela mesma loucura. Evite usá-los por muito tempo, senão pode acabar perdendo o contato com a realidade.');
INSERT INTO "item_descriptions" VALUES(20098,'pt','Como um bom Shushu, Budshu vai catar os seus piolhos. Nada comparado ao seu companheiro Goultard! A quem ele atirará pedras até que se ajoelhe diante de Rushu... Você sempre pode alimentá-lo com patê para aumentar suas estatísticas (e acalmá-lo).');
INSERT INTO "item_descriptions" VALUES(39,'de','Dieses Amulett erhöht die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(40,'de','Dieses Schwert einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(42,'de','Dieses Schwert einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(43,'de','Dieses Schwert einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(44,'de','Dieses Schwert einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(46,'de','Dieses liebevoll geschmiedete Schwert ist besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(47,'de','Dieses liebevoll geschmiedete Schwert ist besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(48,'de','Dieses liebevoll geschmiedete Schwert ist besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(49,'de','Dieses liebevoll geschmiedete Schwert ist besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(51,'de','Dieses Schwert, welches gerade von jungen Iops sehr angepriesen wird, zeigt, dass du nun ein echter Krieger bist. Doch Vorsicht: wer es lange Zeit getragen hat, dem passiert es leicht, dass er es einfach irgendwo fallen lässt.');
INSERT INTO "item_descriptions" VALUES(53,'de','Dieses Schwert, welches gerade von jungen Iops sehr angepriesen wird, zeigt, dass du nun ein echter Krieger bist. Doch Vorsicht: wer es lange Zeit getragen hat, dem passiert es leicht, dass er es einfach irgendwo fallen lässt.');
INSERT INTO "item_descriptions" VALUES(54,'de','Dieses Schwert, welches gerade von jungen Iops sehr angepriesen wird, zeigt, dass du nun ein echter Krieger bist. Doch Vorsicht: wer es lange Zeit getragen hat, dem passiert es leicht, dass er es einfach irgendwo fallen lässt');
INSERT INTO "item_descriptions" VALUES(55,'de','Dieses Schwert, welches gerade von jungen Iops sehr angepriesen wird, zeigt, dass du nun ein echter Krieger bist. Doch Vorsicht: wer es lange Zeit getragen hat, dem passiert es leicht, dass er es einfach irgendwo fallen lässt.');
INSERT INTO "item_descriptions" VALUES(58,'de','Dieses Schwert wurde in den Tränen eines jungen Wu-Wulfs getränkt. Viele Krieger glauben, das bringe ihnen Glück und Mut auf dem Schlachtfeld. Sie sind ja so naiv...');
INSERT INTO "item_descriptions" VALUES(59,'de','Dieses Schwert ausgezeichneter Machart wird aus euch einen tapferen Krieger machen. Denn der alleinige Anblick entmutigt gleich doppelt auch die tapfersten eurer Gegner.');
INSERT INTO "item_descriptions" VALUES(60,'de','Dieses Schwert ausgezeichneter Machart wird aus euch einen tapferen Krieger machen. Denn der alleinige Anblick entmutigt gleich doppelt auch die tapfersten eurer Gegner.');
INSERT INTO "item_descriptions" VALUES(61,'de','Dieses Schwert ausgezeichneter Machart wird aus euch einen tapferen Krieger machen. Denn der alleinige Anblick entmutigt gleich doppelt auch die tapfersten eurer Gegner.');
INSERT INTO "item_descriptions" VALUES(62,'de','Dieses Schwert ausgezeichneter Machart wird aus euch einen tapferen Krieger machen. Denn der alleinige Anblick entmutigt gleich doppelt auch die tapfersten eurer Gegner.');
INSERT INTO "item_descriptions" VALUES(65,'de','Da es gleich nach dem Schmieden im Blut eines Schweinedrachens abgeschreckt wurde, hat das Goultard einen eigentümlichen Geruch an sich. Riecht es nach Drachendung? Nach Schweineurin? Schwer zu sagen. Hat sich jedoch der Träger erst einmal an den Gestank gewöhnt, kann er sich mit diesem mächtigen Schwert mit den besten aller Kämpfer messen.');
INSERT INTO "item_descriptions" VALUES(66,'de','Dieses Schwert gehörte einst dem tapferen Badoul, der nach einem Kopftreffer geistig umnachtet ist.');
INSERT INTO "item_descriptions" VALUES(67,'de','Höllisch scharf: so äußerte sich der Succubus zufrieden mit seinem Werk nach Erschaffung dieser Waffe. Vielleicht waren das aber auch die Worte, mit denen Vald seine Schwester beschrieb. So genau weiß man das nicht mehr.');
INSERT INTO "item_descriptions" VALUES(68,'de','Dieses Amulett erhöht die Intelligenz seines Trägers.');
