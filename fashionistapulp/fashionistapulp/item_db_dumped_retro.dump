INSERT INTO "item_descriptions" VALUES(127,'es','Estas Botas excepcionales te permitirán ganar un punto de movimiento durante los combates.  
Pero ten cuidado con el olor que desprenden porque pertenecieron al desgraciadamente famoso Bowis.');
INSERT INTO "item_descriptions" VALUES(128,'es','Estas botas son tan cómodas que permiten que el héroe que las calza se concentre mejor.');
INSERT INTO "item_descriptions" VALUES(129,'es','Estas botas son tan cómodas que permiten que el héroe que las calza se concentre mejor.');
INSERT INTO "item_descriptions" VALUES(130,'es','Estas botas son ideales cuando se trata de rematar a un adversario.');
INSERT INTO "item_descriptions" VALUES(132,'es','Varita de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(133,'es','Varita de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(134,'es','La única cosa poderosa que tiene esta varita es su nombre y aún así...');
INSERT INTO "item_descriptions" VALUES(138,'es','Bastón de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(139,'es','Bastón de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(140,'es','Bastón de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(144,'es','Martillo de sencilla factura, no hará de tu héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(145,'es','Martillo de sencilla factura, no hará de tu héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(146,'es','Martillo de sencilla factura, no hará de tu héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(147,'es','Versión mejorada del Martillo de Maderucha, lo único potente que tiene es su nombre.');
INSERT INTO "item_descriptions" VALUES(150,'es','Pala de simple factura, no hará de su héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(151,'es','Pala de simple factura, no hará de su héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(152,'es','Pala de simple factura, no hará de su héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(153,'es','Pala de simple factura, no hará de su héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(156,'es','El cinturón de Potencia incrementa la potencia de su dueño durante los combates aunque su peso reduce sustancialmente su agilidad.');
INSERT INTO "item_descriptions" VALUES(157,'es','El Etirujo ha sido creado con piedra de luna que estuvo al remojo durante 5000 años dentro de un barril de cerveza. Inevitablemente, eso le confirió terribles poderes.');
INSERT INTO "item_descriptions" VALUES(158,'es','El Destino Dorado permite aumentar considerablemente la agilidad y la vitalidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(159,'es','Dicen que este broche a sido creado por el ilustre herrero Bulguro que tiene fama de forjar las armas de los dioses.');
INSERT INTO "item_descriptions" VALUES(160,'es','Este objeto ha sido moldeado a partir de una mezcla de huevos celestes y polvos de estrellas lácteas. Consérvese en frío.');
INSERT INTO "item_descriptions" VALUES(161,'es','Este poderoso amuleto lo tiene todo para que su portador se vuelva famoso.');
INSERT INTO "item_descriptions" VALUES(162,'es','Una varita muy bien esculpida, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(163,'es','Una varita muy bien esculpida, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(164,'es','Una varita muy bien esculpida, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(165,'es','Una varita muy bien esculpida, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(168,'es','Esta varita permite aumentar la inteligencia de quien la posea.');
INSERT INTO "item_descriptions" VALUES(174,'es','Esta varita permite aumentar la sabiduría de quien la posea.');
INSERT INTO "item_descriptions" VALUES(180,'es','Esta varita viene del Limbo de Syrastass. Cuenta la leyenda que su portador puede hacer que florezcan campos enteros de margaritas con la simple fuerza de su voluntad.');
INSERT INTO "item_descriptions" VALUES(181,'es','Esta varita ha sido bendecida por Hella desde lo más alto del cielo. Proporciona agilidad y vitalidad a su portador durante las batallas.');
INSERT INTO "item_descriptions" VALUES(182,'es','Un bastón bien tallado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(183,'es','Un bastón bien tallado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(184,'es','Un bastón bien tallado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(185,'es','Un bastón bien tallado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(188,'es','Este bastón aumenta la sabiduría de quien lo posea. Puede provocar una hipertrofia.');
INSERT INTO "item_descriptions" VALUES(194,'es','Este bastón aumenta la vitalidad de quien lo posea. También es comestible.');
INSERT INTO "item_descriptions" VALUES(200,'es','El God Rod es un arma terrible. Es tan poderosa que logra que su portador sea de los mejores hasta cuando le da un bajón.');
INSERT INTO "item_descriptions" VALUES(201,'es','El Hook ha sido encontrado en un cadáver, cerca de un enorme Cocodrail en descomposición.');
INSERT INTO "item_descriptions" VALUES(202,'es','Esta espada ha sido bendecida con las lágrimas del ángel Raziel. Es terriblemente destructora y suficientemente poderosa para permitir que su portador se pueda enfrentar al más terrible de los adversarios.');
INSERT INTO "item_descriptions" VALUES(203,'es','Si tienes este increíble objeto alrededor de la cintura es que eres uno de los héroes más afortunados de este universo. Este cinturón pertenecía al héroe barbudo más fuerte y seductor de todos los tiempos.');
INSERT INTO "item_descriptions" VALUES(204,'es','Este bastón viviente ha estado en los lugares más oscuros del universo de Amakna. Se despierta cada 300 años para cambiar de sitio o de dueño. Prefiere pasar por los pequeños túneles muy oscuros que no huelen muy bien.');
INSERT INTO "item_descriptions" VALUES(205,'es','Unas dagas bien forjadas, interesantes para los novatos.');
INSERT INTO "item_descriptions" VALUES(206,'es','Unas dagas bien forjadas, interesantes para los novatos.');
INSERT INTO "item_descriptions" VALUES(207,'es','Unas dagas bien forjadas, interesantes para los novatos.');
INSERT INTO "item_descriptions" VALUES(208,'es','Unas dagas bien forjadas, interesantes para los novatos.');
INSERT INTO "item_descriptions" VALUES(211,'es','De excelente factura, estas Dagas de Croclage harán de ti un valiente guerrero.');
INSERT INTO "item_descriptions" VALUES(212,'es','De excelente factura, estas Dagas de Croclage harán de ti un valiente guerrero.');
INSERT INTO "item_descriptions" VALUES(213,'es','De excelente factura, estas Dagas de Croclage harán de ti un valiente guerrero.');
INSERT INTO "item_descriptions" VALUES(214,'es','De excelente factura, estas Dagas de Croclage harán de ti un valiente guerrero.');
INSERT INTO "item_descriptions" VALUES(218,'es','Las Bashers son unas temibles dagas de asesino. El que las posea es capaz de rivalizar con el más sanguinario de los guerreros.');
INSERT INTO "item_descriptions" VALUES(219,'es','Las Blessdags pertenecían al célebre Ogro Mano Oscura que murió luchando contra un paladín del Bimd''Ulo. Dicen que su sangre es la que le da vida a estas malvadas dagas.');
INSERT INTO "item_descriptions" VALUES(220,'es','Las Chakra Style son un par de dagas que pertenecieron a una de las mayores ladronas de todos los tiempos. Chakra fue la primera en conseguir forzar las puertas del templo de Osaroth para robar las preciosas reliquias que había dentro.');
INSERT INTO "item_descriptions" VALUES(221,'es','Un martillo bien trabajado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(222,'es','Un martillo bien trabajado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(223,'es','Un martillo bien trabajado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(224,'es','Un martillo bien trabajado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(227,'es','Este martillo aumenta la inteligencia del héroe que lo posea.');
INSERT INTO "item_descriptions" VALUES(228,'es','Este martillo aumenta la inteligencia del héroe que lo posea.');
INSERT INTO "item_descriptions" VALUES(229,'es','Este martillo aumenta la inteligencia del héroe que lo posea.');
INSERT INTO "item_descriptions" VALUES(230,'es','Este martillo aumenta la inteligencia del héroe que lo posea.');
INSERT INTO "item_descriptions" VALUES(233,'es','Kaiser es el nombre de un Dragocerdo que antiguamente devastó el pueblo de Bunkaida. Cuando la milicia consiguió finalmente acabar con el monstruo, los herreros crearon numerosas armas a partir de los restos del animal. Este martillo forma parte de ellas.');
INSERT INTO "item_descriptions" VALUES(234,'es','El Ragnarok es un martillo muy poderoso, capaz de desencadenar tormentas o también capaz de atormentar a tus aliados si no sabes utilizarlo.');
INSERT INTO "item_descriptions" VALUES(235,'es','Este martillo pertenecía al guardián de la Puerta de los Infiernos. Impedía que los vivos entrasen, que los muertos saliesen y que los muerto vivos se moviesen.');
INSERT INTO "item_descriptions" VALUES(236,'es','Barabas es una temible arma: permite que su portador se desplace más fácilmente y sobre todo, ser más eficaz en el combate de cuerpo a cuerpo.');
INSERT INTO "item_descriptions" VALUES(237,'es','Un niño con terribles poderes guardaba Sargas como un tesoro. No se sabe lo que pasó con esta arma desde que un aventurero se la cambió por una bolsa de canicas.');
INSERT INTO "item_descriptions" VALUES(238,'es','Una pala bien equilibrada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(239,'es','Una pala bien equilibrada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(240,'es','Una pala bien equilibrada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(241,'es','Una pala bien equilibrada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(244,'es','De excelente factura, la pala de raspage hará de ti un luchador audaz.');
INSERT INTO "item_descriptions" VALUES(245,'es','De excelente factura, la pala de raspage hará de ti un luchador audaz.');
INSERT INTO "item_descriptions" VALUES(246,'es','De excelente factura, la pala de raspage hará de ti un luchador audaz.');
INSERT INTO "item_descriptions" VALUES(247,'es','De excelente factura, la pala de raspage hará de ti un luchador audaz.');
INSERT INTO "item_descriptions" VALUES(250,'es','Medio hacha, medio pala, Ares fue una de las siete armas utilizadas por el Demonio Kajlir para acabar con la ACDP (la cofradía de los Anutrofs Coleccionistas de Dofus Púrpura.');
INSERT INTO "item_descriptions" VALUES(251,'es','Barba Gris era el arma favorita del demonio enano Tehle Fónika, que aterrorizó a numerosos campesinos atacándoles a cobro revertido y gritando "¡Si te mueves, te cuelgo!".');
INSERT INTO "item_descriptions" VALUES(252,'es','Este cinturón aumenta la vida del que lo lleve puesto, para mayor seguridad en pleno combate.');
INSERT INTO "item_descriptions" VALUES(253,'es','Este cinturón aumenta la vida del que lo lleve puesto, para mayor seguridad en pleno combate.');
INSERT INTO "item_descriptions" VALUES(254,'es','Este cinturón aumenta la vida del que lo lleve puesto, para mayor seguridad en pleno combate.');
INSERT INTO "item_descriptions" VALUES(255,'es','Este cinturón aumenta la vida del que lo lleve puesto, garantizandote una mayor seguridad en pleno combate.');
INSERT INTO "item_descriptions" VALUES(256,'es','Este cinturón aumenta la fuerza de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(257,'es','Este cinturón aumenta la fuerza de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(258,'es','Este cinturón aumenta la fuerza de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(259,'es','Este cinturón te hará más fuerte.');
INSERT INTO "item_descriptions" VALUES(260,'es','Este cinturón aumenta la agilidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(261,'es','Este cinturón aumenta la agilidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(262,'es','Este cinturón aumenta la agilidad.');
INSERT INTO "item_descriptions" VALUES(263,'es','Este cinturón aumenta la agilidad.');
INSERT INTO "item_descriptions" VALUES(264,'es','El Arquito Desconcertante es un objeto básico, pero no se debe despreciar su utilidad.');
INSERT INTO "item_descriptions" VALUES(265,'es','El Arco Desconcertante es un objeto básico, pero no se debe despreciar su utilidad.');
INSERT INTO "item_descriptions" VALUES(266,'es','El Arco Desconcertante es un objeto básico, pero no se debe despreciar su utilidad.');
INSERT INTO "item_descriptions" VALUES(267,'es','El Arco Desconcertante es un objeto básico, pero no se debe despreciar su utilidad.');
INSERT INTO "item_descriptions" VALUES(270,'es','El Javiador es un arco eficaz. Pertenecía al gran Javier el Panadero. Entre dos hornadas, se marchaba a repartir tortas entre los monstruos que rodeaban su panadería.');
INSERT INTO "item_descriptions" VALUES(271,'es','Esta es una bonita arma. Extraña y fascinante te permitirá luchar en cuerpo a cuerpo como lo haría el mejor de los Chafers.');
INSERT INTO "item_descriptions" VALUES(272,'es','Este arco es suficientemente potente como para enviar una flecha sobre la luna.');
INSERT INTO "item_descriptions" VALUES(273,'es','La Cuerda de Yamato hizo vibrar a más de un corazón de monstruo. Es un arma refinada capaz de dirigir su flecha en los más recónditos lugares.');
INSERT INTO "item_descriptions" VALUES(278,'es','Este anillo está engastado con una piedra rara. Las distintas piedras que componen su nombre son imprescindibles para su creación.');
INSERT INTO "item_descriptions" VALUES(279,'es','Según un ilustre aventurero, este amuleto contiene una lágrima de Jalató. Su olor y sus propiedades son semejantes a las que producen las decocciones del cuero de un Jalató.');
INSERT INTO "item_descriptions" VALUES(280,'es','Este collar es muy rebuscado por los coleccionistas, conseguirás venderlo por un buen precio.');
INSERT INTO "item_descriptions" VALUES(293,'es','Lo único que puede ser tan sólido como un crujidor, es un crujidor. Esa es la razón por la cual esta pala, diseñada para cazar crujidores, está hecha con piedra de crujidor.');
INSERT INTO "item_descriptions" VALUES(294,'es','Lo único que puede ser tan sólido como un Crujidor, es un Crujidor. Esa es la razón por la cual esta pala, diseñada para cazar Crujidores, está hecha con piedra de Crujidor.');
INSERT INTO "item_descriptions" VALUES(295,'es','Lo único que puede ser tan sólido como un Crujidor, es un Crujidor. Esa es la razón por la cual esta pala, diseñada para cazar Crujidores, está hecha con piedra de Crujidor.');
INSERT INTO "item_descriptions" VALUES(296,'es','Lo único que puede ser tan sólido como un Crujidor, es un Crujidor. Esa es la razón por la cual esta pala, diseñada para cazar Crujidores, está hecha con piedra de Crujidor.');
INSERT INTO "item_descriptions" VALUES(297,'es','Estas botas están hechas con cuero de Jalató, permiten que los ganaderos puedan acercarse más facilmente a los Jalatós para matarlos gracias al olor que desprenden.');
INSERT INTO "item_descriptions" VALUES(298,'es','Estas sandalias están hechas con plumas de tofu cocido y la suela es de pico de tofu inalterable. Por motivos todavía inexplicados, hacen que su portador se vuelva un poco tonto... como un tofu.');
INSERT INTO "item_descriptions" VALUES(299,'es','La mejor defensa es el ataque, estas botas anti agresión te permitirá acabar con un grupo de agresores sin ninguna dificultad.');
INSERT INTO "item_descriptions" VALUES(317,'es','Los ganaderos de Amakna utilizaban este bastón cuando querían controlar más fácilmente a sus rebaños de Tabis, este bastón es tan ligero que permite correr detrás de los Tabis que se quieren escapar sin ni siquiera cansarse.');
INSERT INTO "item_descriptions" VALUES(318,'es','Los ganaderos de Amakna utilizaban este bastón cuando querían controlar más fácilmente a sus rebaños de Tabis, este bastón es tan ligero que permite correr detrás de los Tabis que se quieren escapar sin ni siquiera cansarse.');
INSERT INTO "item_descriptions" VALUES(319,'es','Los ganaderos de Amakna utilizaban este bastón cuando querían controlar más fácilmente a sus rebaños de Tabis, este bastón es tan ligero que permite correr detrás de los Tabis que se quieren escapar sin ni siquiera cansarse.');
INSERT INTO "item_descriptions" VALUES(320,'es','Los ganaderos de Amakna utilizaban este bastón cuando querían controlar más fácilmente a sus rebaños de Tabis. Es tan ligero que permite correr detrás de los Tabis que se quieren escapar sin cansarse en absoluto.');
INSERT INTO "item_descriptions" VALUES(323,'es','Este amuleto proporciona facultades muy particulares a su portador, pues este se verá como transportado por un aura misteriosa que irá recorriendo su cuerpo, lo cual generalmente acaba aumentando sus capacidades físicas.');
INSERT INTO "item_descriptions" VALUES(324,'es','Este amuleto tiene la facultad de volverse rosa los días en que su portador esté de humor vivaracha. Dicen que aumenta también tus posibilidades de encontrar buenos objetos.');
INSERT INTO "item_descriptions" VALUES(325,'es','Este amuleto confeccionado por uno de los más grandes joyeros Sram a partir de pequeñas calaveras talladas en el hueso, es único. Permite que su portador se escape más fácilmente de situaciones peligrosas.');
INSERT INTO "item_descriptions" VALUES(326,'es','Este amuleto proviene de las regiones nórdicas, le confiere a su portador la capacidad de invocar criaturas más fácilmente.');
INSERT INTO "item_descriptions" VALUES(327,'es','Esta hoja forjada en su origen para los Cabalgadores de Karne era en realidad demasiado pesada para estos frágiles goblins. Sin embargo, resulta muy ligera para un indivíduo normal, lo cual le permite golpear con mucha rapidez.');
INSERT INTO "item_descriptions" VALUES(328,'es','Esta hoja doble con una forma muy extraña servía en su origen como machete para poder avanzar en los bosques densos. Los leñadores se dieron rápidamente cuenta de que constituía un arma genial para romper las armaduras de sus adversarios.');
INSERT INTO "item_descriptions" VALUES(329,'es','Como lo indica su nombre, este arco permite ganar fácilmente un combate. Incluso un gran arquitecto Ocra sin imaginación utilizó este nombre para una de sus horribles construcciones.');
INSERT INTO "item_descriptions" VALUES(331,'es','Este arco es el más buscado de toda Amakna, algunos cuentan que donde caen sus flechas se puede hallar un tesoro. Cosa extraña, parece que sólo es eficaz cuando la lluvia se mezcla a los rayos del sol.');
INSERT INTO "item_descriptions" VALUES(332,'es','Juana estaba un poco loca, oía Tabis eructar dentro de su cabeza. Para evitar que se lastimara con su arco, se lo quitaron y decidieron quemarla viva para calentar el ambiente el día de la inauguración de la taberna.');
INSERT INTO "item_descriptions" VALUES(333,'es','En su origen era comestible pero se convirtió con el paso del tiempo en una temible arma. Pues Javier el Panadero la olvidó en su horno durante 234 años cuando se había marchado a repartir tortas a los monstruos que se encontraban alrededor de su panadería.');
INSERT INTO "item_descriptions" VALUES(334,'es','Esta varita pertenecía a la aniripsa Liriel que se murió de una sobredosis de fresas en una lenta y horrible agonía durante la cual perdió sus alas gritando como una desesperada. Los coleccionistas estarían dispuestos a matar para conseguir esta varita maldita.');
INSERT INTO "item_descriptions" VALUES(335,'es','Sin su bastón, los Bwork Magos son tan inofensivos como los Tofus sin sus Picos. Esto te dará una visión más clara del poder que encierra este bastón.');
INSERT INTO "item_descriptions" VALUES(336,'es','Este bastón tiene la facultad de hacer levitar las Zanahowias. Uno puede preguntarse para qué demonios le sirve hacer eso durante un combate.');
INSERT INTO "item_descriptions" VALUES(337,'es','Este es un arco de uso muy sencillo, ha sido diseñado para adaptarse a la inteligencia de un Bwork Arquero, por lo cual incluso un Tofu podría utilizarlo. En cambio, es necesario tener la fuerza de un Crujidor para tensarlo.');
INSERT INTO "item_descriptions" VALUES(338,'es','Esta espada aparentemente rudimentaria es muy apreciada por los Bworks más estúpidos que no saben servirse de un arco o de un bastón, incluso algunos confunden el filo con el mango lo cual provoca la risa de sus adversarios.');
INSERT INTO "item_descriptions" VALUES(339,'es','Esta cuchilla pertenecía a Metzger, el carnicero. Ha sido forjada para poder cortar huesos. Sin embargo un chafer consiguió robarle esta herramienta que actualmente se ha vuelto famosa por haber sido la causa de numerosas amputaciones.');
INSERT INTO "item_descriptions" VALUES(340,'es','Estas dagas permiten, según cuenta la leyenda, robar cualquier cosa a cualquier persona o al revés, pero ya nadie recuerda muy bien la leyenda.');
INSERT INTO "item_descriptions" VALUES(341,'es','Estas dagas legendarias constituyen verdaderas piezas de colección para cualquier sram que se respete, son tan veneradas que algunos srams se niegan a robarlas.');
INSERT INTO "item_descriptions" VALUES(342,'es','Este martillo muy particular se hizo con picos de Kwaks, esto explica por qué pincha mucho cuando uno es golpeado con él.');
INSERT INTO "item_descriptions" VALUES(345,'es','Después de una noche demasiado alcoholizada en la taberna que acabó con una pelea general, un Anutrof se dio cuenta de que esta pala, en su origen diseñada para los grandes trabajos de construcción, era una excelente arma.');
INSERT INTO "item_descriptions" VALUES(346,'es','Algunas leyendas cuentan que este anillo protege de las intemperies al que lo lleve puesto. Pero eso todavía no ha sido demostrado ya que en Amakna nunca llueve.');
INSERT INTO "item_descriptions" VALUES(347,'es','Esta pala de jardinero es especialmente eficaz para cortar los rhizomas, o las malas hierbas. Es una excelente arma también cuando se trata de cortar otra cosa que los rhizomas.');
INSERT INTO "item_descriptions" VALUES(348,'es','Estas botas pertenecieron a Rap y a Dhez, el primero tenía por costumbre hablar a una velocidad insuperable para proferir insultos salvajes sin que nadie le entendiese. En cambio Dhez, se pasaba las tardes escuchando música Chill Out para relajarse tras una dura jornada laboral. Parece que ambos rasgos dejaron huella sobre estas botas que te proporcionarán velocidad y calma a la hora de luchar contra un rival.');
INSERT INTO "item_descriptions" VALUES(352,'es','Esta es una espada santa que se entrega a los jóvenes guerreros durante su formación.');
INSERT INTO "item_descriptions" VALUES(353,'es','La Espada del Pequeño Caballero es una espada sólida y eficaz, si la usas de forma adecuada podrás causar enormes daños a tus adversarios.');
INSERT INTO "item_descriptions" VALUES(354,'es','Este tipo de espada fue forjada para los guardias de un comerciante rico y famoso. Aunque su función inicial consistía en asustar a los ladrones, no deja de ser una arma temible para rematar a los ladrones o a los clientes honrados pero un poco pelmas.');
INSERT INTO "item_descriptions" VALUES(355,'es','Este anillo proporciona fuerza y valentía.');
INSERT INTO "item_descriptions" VALUES(356,'es','Este cinturón vuelve más resistente a quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(357,'es','Esta espada simboliza la parte del cuerpo de la que los Zurcaráks están más orgullosos. También resume perfectamente la filosofía de los jugadores.');
INSERT INTO "item_descriptions" VALUES(358,'es','La Cola Infernal es verdaderamente infernal... Con ella harás que tus adversarios o que tus compañeros se vuelvan completamente locos, o que tus compañeros se conviertan en adversarios si no sabes usarla. En cambio, nunca se dará el caso contrario.');
INSERT INTO "item_descriptions" VALUES(359,'es','Este anillo le fue regalado hace mucho tiempo a Isidoro-es-genial por el rey Alister, que reconoció la agilidad inigualable de este zurcarák.');
INSERT INTO "item_descriptions" VALUES(436,'es','Este bastón, tallado en una enorme raíz de Abráknido, es muy eficaz en el cuerpo a cuerpo. Pero que no se te ocurra acercarlo al agua, podría retoñar y volverse contra ti.');
INSERT INTO "item_descriptions" VALUES(454,'es','Esta hacha es indispensable para los leñadores si quieren ejercer correctamente su oficio. También puede permitirles acabar con algunos monstruos...');
INSERT INTO "item_descriptions" VALUES(455,'es','Este ridículo martillito era de Zokrim el campesino. Lo utilizaba para plantar sus estacas de cercado durante la aurora. Nadie sabe por qué Zokrim plantaba sus estacas durante la aurora, pero cuenta la leyenda que tenía buenas razones.');
INSERT INTO "item_descriptions" VALUES(456,'es','Esta hacha permite cortar fácilmente los árboles, incluso los más gruesos. Es sobre todo apreciada por su importante peso que le permite cortar fácilmente un Bwork en tres, bueno... solamente si eres capaz de levantarla.');
INSERT INTO "item_descriptions" VALUES(458,'es','El Chafer es una persona sensible y refinada, siempre lleva consigo un amuleto hecho con las calaveras de sus primos caídos en combate. Lo más extraño es que el Chafer nunca tuvo primos.');
INSERT INTO "item_descriptions" VALUES(462,'es','Ya que la madera de Abráknido sigue viva incluso después de cortarla, este arco es muy difícil de usar. Sin embargo, no hay nada mejor para ridiculizar a un Abráknido ya que lo matarías con un arco hecho a partir de las raíces de sus propios hermanos.');
INSERT INTO "item_descriptions" VALUES(469,'es','Esta varita utiliza las propiedades mágicas de la raíz de abráknido todavía en vida, ten cuidado con los efectos nefastos que puede producir, a veces se vuelve contra su amo.');
INSERT INTO "item_descriptions" VALUES(478,'es','Esta hacha debe su nombre a Woody la Leñadora que sabía utilizar sus encantos para atraer la atención de los demás leñadores y de esta manera guardar secreto el emplazamiento de los escasos carpes cuya existencia quería preservar.');
INSERT INTO "item_descriptions" VALUES(482,'es','Después de una noche demasiado alcoholizada en la taberna que acabó con una pelea general, un Anutrof se dio cuenta de que esta pala, en su origen diseñada para los grandes trabajos de construcción, era una excelente arma.');
INSERT INTO "item_descriptions" VALUES(483,'es','Después de una noche demasiado alcoholizada en la taberna que acabó con una pelea general, un Anutrof se dio cuenta de que esta pala, en su origen diseñada para los grandes trabajos de construcción, era una excelente arma.');
INSERT INTO "item_descriptions" VALUES(484,'es','Después de una noche demasiado alcoholizada en la taberna que acabó con una pelea general, un Anutrof se dio cuenta de que esta pala, en su origen diseñada para los grandes trabajos de construcción, era una excelente arma.');
INSERT INTO "item_descriptions" VALUES(491,'es','Este objeto le permite al joyero engastar las piedras preciosas en las joyas.');
INSERT INTO "item_descriptions" VALUES(493,'es','Una herramienta indispensable para forjar martillos.');
INSERT INTO "item_descriptions" VALUES(494,'es','Una herramienta indispensable para forjar espadas.');
INSERT INTO "item_descriptions" VALUES(495,'es','Una herramienta indispensable para forjar dagas.');
INSERT INTO "item_descriptions" VALUES(496,'es','Una herramienta indispensable para forjar palas.');
INSERT INTO "item_descriptions" VALUES(497,'es','Herramienta indispensable para la extracción de minerales.');
INSERT INTO "item_descriptions" VALUES(498,'es','Esta es una herramienta indispensable para poder crear bastones.');
INSERT INTO "item_descriptions" VALUES(499,'es','Esta es una herramienta indispensable para poder crear varitas.');
INSERT INTO "item_descriptions" VALUES(500,'es','Esta es una herramienta indispensable para poder crear arcos.');
INSERT INTO "item_descriptions" VALUES(502,'es','Esta hacha es una de las únicas en poder cortar árboles embrujados, por lo cual podemos afirmar que por extensión, puede cortar todo lo que está embrujado, que esté vivo o no.');
INSERT INTO "item_descriptions" VALUES(515,'es','Esta hacha perteneció a Brus Bulguro, el famoso Leñador, casado con Kasiope Baine, hija de otro gran Leñador. Esta arma le permitió defenderse en muchas ocasiones cuando se marchaba de noche para cortar bosques enteros.');
INSERT INTO "item_descriptions" VALUES(577,'es','Esta guadaña no está muy afilada y además está un poco oxidada, lo cual hace de ella un arma poco peligrosa. En cambio, para la siega, es la herramienta ideal.');
INSERT INTO "item_descriptions" VALUES(579,'es','Esta es una herramienta indispensable para poder crear botas y cinturones.');
INSERT INTO "item_descriptions" VALUES(592,'es','Este arco perteneció a Ivan Nowe, un Ocra temerario que combatió a más de un Tofu perdido. Este arco tiene la particularidad de producir efectos muy extraños al ser disparado, pues deja perplejos y agonizantes a sus enemigos.');
INSERT INTO "item_descriptions" VALUES(610,'es','Este amuleto blanquecino está hecho con cangrejo, lo cual hace de él un amuleto muy frágil pero original.');
INSERT INTO "item_descriptions" VALUES(616,'es','Este amuleto, engastado con escamas de pescado, atrae supuestamente la suerte a su propietario cuando sale al mar los días de tempestad.');
INSERT INTO "item_descriptions" VALUES(617,'es','Este terrorífico amuleto ha impresionado a más de un marinero, llevarlo contigo es suficiente para hacer de ti una temible persona.');
INSERT INTO "item_descriptions" VALUES(619,'es','Este bastón le permitía al criador de Jalatós, Farle Ingals, invocar más fácilmente a Tofus guardianes de rebaños. Con el paso del tiempo, este bastón resultó ser una excelente arma de combate.');
INSERT INTO "item_descriptions" VALUES(620,'es','Esta espada ha permitido al célebre marinero Moby Chic, poder cortar en lonchas los tentáculos del célebre Kralamar Gigante de la isla de Moon, famoso por asfixiar a los marineros borrachos.');
INSERT INTO "item_descriptions" VALUES(629,'es','Este magnífico sombrero le permitirá a tu héroe ser el más hermoso para ir a bailar o a la playa (ho, hohohohooo...).');
INSERT INTO "item_descriptions" VALUES(638,'es','Pescar Salmoon es una verdadera hazaña, pero si llevas este amuleto, ya nada es imposible.');
INSERT INTO "item_descriptions" VALUES(639,'es','Este amuleto ha sido encontrado entre los restos del barco encallado del célebre pescador de Kralamares, Moby Chic, también famoso en el bar de los piratas por contar siempre chistes malos.');
INSERT INTO "item_descriptions" VALUES(640,'es','Este arco les permitía a los pescadores eliminar a toda la chusma de las costas vecinas sin tener que levantarse de su silla, pues disparaban desde la ventana del bar de los piratas.');
INSERT INTO "item_descriptions" VALUES(657,'es','Este bastón le permitía a la criadora de Tofus, Shika Ingals, invocar más fácilmente a Tofus guardianes de rebaños. Con el paso del tiempo, este bastón resultó ser una excelente arma para el combate.');
INSERT INTO "item_descriptions" VALUES(658,'es','Este bastón le permitía a la criadora de Tabis, Gramine Ingals, invocar más fácilmente a Tofus guardianes de rebaños. Con el paso del tiempo, este bastón resultó ser una excelente arma para el combate.');
INSERT INTO "item_descriptions" VALUES(670,'es','Esta guadaña perteneció a Gramine Ingals, una de las mejores segadoras de trigo de toda Amakna. Su contoneo legendario le permitió seccionar las piernas de muchos imprudentes.');
INSERT INTO "item_descriptions" VALUES(671,'es','La Fergusona es una guadaña legendaria, forjada por Mase Fergusona la tía mayor de Farle Ingals. Esta sólo utilizaba guadañas con mangos de madera, más agradables al tacto.');
INSERT INTO "item_descriptions" VALUES(672,'es','Esta guadaña estaba en un principio diseñada para segar Sorgho, pero los campesinos no tardaron en darse cuenta de que estaba tan bien afilada que podría utilizarse para segar cualquier cosa.');
INSERT INTO "item_descriptions" VALUES(673,'es','Esta hacha no tiene nada de particular excepto su ligereza natural debida a la Madera de Castaño con la que está hecha. Pues su mango es tan ligero como la pluma de un joven Tofu Maléfico.');
INSERT INTO "item_descriptions" VALUES(674,'es','"Esta hacha es la más mejor" decía el famoso eslogan de Brus Bulguro el célebre Leñador. Pues su mango de Madera de Cerezo permite amortiguar las vibraciones producidas por la tala de los árboles o por el contacto con los cráneos de Bwork demasiado duros.');
INSERT INTO "item_descriptions" VALUES(675,'es','Esta hacha aparentemente rudimentaria, no deja de ser increíblemente eficaz. Fue con esta herramienta que Brus Bulguro ganó el concurso de Corte de Bworks enanos. Eso demuestra su eficacia.');
INSERT INTO "item_descriptions" VALUES(676,'es','Esta hacha tiene la particularidad de nunca oxidarse, para evitar desagradables sorpresas cuando los golosos Leñadores deciden lamer el jarabe de Arce sobre su filo tras una agotadora jornada de tala.');
INSERT INTO "item_descriptions" VALUES(677,'es','Esta capa perteneció a un viejo pirata llamado Zokrim. Qué poca suerte tuvo...');
INSERT INTO "item_descriptions" VALUES(682,'es','Esta guadaña estaba en un principio diseñada para segar Centeno, pero los campesinos no tardaron en darse cuenta de que estaba tan bien afilada que podría utilizarse para segar cualquier cosa.');
INSERT INTO "item_descriptions" VALUES(694,'es','Este magnífico Dofus que se extrajo del agujero del uno de los más majestuosos dragones de Amakna, aumenta los daños de su portador.');
INSERT INTO "item_descriptions" VALUES(696,'es','Aunque parezca haber pasado de moda, el Sombrero del Paletoso es muy eficaz para poder dormirte en las pajas en pleno combate.');
INSERT INTO "item_descriptions" VALUES(697,'es','Mistetas es un perro muy cariñoso... El problema es que tiene cierta tendencia a perderse tontamente, lo cual provoca generalmente el bochorno de su ama al momento de preguntar por él.');
INSERT INTO "item_descriptions" VALUES(698,'es','El sombrero de Selección de Hoguarts ha sido creado en una gran escuela de magia. Es un objeto con vida propia y ha conocido a los magos más famosos de la historia, como la Señora Magonagal, el Señor Doblegore y el célebre Javi Popers.');
INSERT INTO "item_descriptions" VALUES(699,'es','El Etreuma es tan peligroso como un Afeitabola en pelo de pollufo. (Para los que no saben lo que es un Afeitabola en pelo de pollufo, consúltese el libro de los Craps para Gallinas).');
INSERT INTO "item_descriptions" VALUES(700,'es','Aja, el Pandawa, qué cabezón tiene. Como su colega Mistetas, se pasa el tiempo sobre la cabellera de su amo. No necesita desplazarse e incluso cuando está motivado, consigue robarle la comida a su portador.');
INSERT INTO "item_descriptions" VALUES(701,'es','El Oiram tiene adeptos en el mundo entero gracias a su aspecto elegante... Este sombrero perteneció durante mucho tiempo a un fontanero que no dejaba de saltar y correr en todas las direcciones...');
INSERT INTO "item_descriptions" VALUES(702,'es','Este cráneo de demonio reconstruido a partir de huesos diversos y variados procura gracia y elegancia a quien lo lleve puesto... Tus amigas te envidiarán mucho...');
INSERT INTO "item_descriptions" VALUES(703,'es','Este sombrero en forma de cesta de mimbre para fruta volcada es una cesta de mimbre para fruta volcada mágica. Impresionará a tu entorno, sobre todo si este está compuesto por aprendices Bworks Magos.');
INSERT INTO "item_descriptions" VALUES(704,'es','Este sombrero hecho a base de Slips de cuero de Chafer Lancero trenzados entre ellos, te volverá, sin duda alguna, irresistible con las hembras Bwork Magas, célebres por su desbordante feminidad, acentuada por su barba pelirroja.');
INSERT INTO "item_descriptions" VALUES(705,'es','Si quieres estar traumatizado, necesitas absolutamente esta magnífica nuez de coco perforada. Recordamos al usuario que el interior de esta máscara está equipada con una pajita y con bebidas refrescantes.');
INSERT INTO "item_descriptions" VALUES(706,'es','Hugne "el sin memoria" poseía una magnífica bola de crystal que le había regalado su abuelito. Ya que estaba decidido en conservarla toda su vida, se la puso sobre un sombrero que no se quitaba nunca... Se murió de cansancio, intentando encontrarla.');
INSERT INTO "item_descriptions" VALUES(707,'es','Este sombrero en Cuerno de Minotauroro es muy eficaz para impresionar a sus adversarios haciéndose pasar por un Minotauroro. Esta argucia sólo parece funcionar con los adversarios más ingenuos. Así que debería colar con los Yopuka o los Tofus.');
INSERT INTO "item_descriptions" VALUES(708,'es','Este sombrero de piel de larva verde mágica procura a su portador un aspecto vivaracho, pero también un poco estúpido. Uno no puede tenerlo todo en la vida, el portador de este sombrero llega a ser un excelente ejemplo de lo dicho.');
INSERT INTO "item_descriptions" VALUES(709,'es','Este sombrero cuya corteza está encantada pertenecía a Lorko, un reputado Leñador que no dudó en desafiar al célebre Leñador Brus Bulguro durante un famoso duelo de arrancamiento de Olmos con las manos en un claro de Liroy Mierlín.');
INSERT INTO "item_descriptions" VALUES(710,'es','Ol Korko Klako os un sombroro moy bonoto. Moy ostótico, moy hormoso, sólo poro los mos guopos do los Sadidas.');
INSERT INTO "item_descriptions" VALUES(711,'es','Esta magnífica máscara de cuero pertenecía a Juik Kramp, primo de Zeurg. Los dos eran muy aficionados a las prendas de cuero pegadas al cuerpo. Igual que Capitán Chafer, pero sin ser unos pervertidos.');
INSERT INTO "item_descriptions" VALUES(712,'es','Este sombrero ha sido creado a partir de orejas cosidas entre ellas, hará sencillamente de ti una persona única de lo original que es. Se dice que antiguamente permitió a Rakma Bilgut seducir a la reina de los Jalatós, para luego degollarla más fácilmente.');
INSERT INTO "item_descriptions" VALUES(732,'es','Esta magnífica alianza fue robada a Silimella la Cervecera durante una noche demasiado alcoholizada en la taberna. Esto es lo que ocurre cuando se pagan rondas a desconocidos...');
INSERT INTO "item_descriptions" VALUES(733,'es','Ragalde fue sin duda uno de los guerreros Yopuka más atrevidos, estas botas mágicas le permitieron cargarse a una cantidad impresionante de alimaña.');
INSERT INTO "item_descriptions" VALUES(734,'es','Los guardias del Castillo de Amakna utilizaban este cinturón para contener los disturbios y demás excesos de entusiasmo durante las fiestas populares.');
INSERT INTO "item_descriptions" VALUES(737,'es','Más verde que un Tofu enfermo, el Dofus Esmeralda ha sido creado por Aerafal, el Dragón del Aire.');
INSERT INTO "item_descriptions" VALUES(739,'es','El Dofus Turquesa aumenta los golpes críticos de su portador.');
INSERT INTO "item_descriptions" VALUES(742,'es','"Si tengo que morir, que sea debajo de ti" cantaba el célebre trovador Badiz Mustabante antes de ser aplastado por un huevo de tofu gigante. Ya iba siendo hora...');
INSERT INTO "item_descriptions" VALUES(744,'es','Esta capa es, como su portador, única y demasiado a menudo subestimada. Está hecha con un ensamblaje de pieles de larvas verdes lo cual le da un aspecto rugoso simpatiquísimo.');
INSERT INTO "item_descriptions" VALUES(754,'es','Esta capa de color rojo sangre estuvo metida en un baño de hemoglobina durante años. ¡Todos quieren una para las fiestas de Haluín!');
INSERT INTO "item_descriptions" VALUES(758,'es','Solamente los grandes justicieros de Amakna pueden ponérsela... o sea casi nadie.');
INSERT INTO "item_descriptions" VALUES(759,'es','Esta magnífica capa ha sido confeccionada con las plumas del último Pohoyo de Amakna. Son escasísimas y los coleccionistas sueñan con tener una en su colección.');
INSERT INTO "item_descriptions" VALUES(764,'es','Este pequeño amuleto encantará a los héroes novatos.');
INSERT INTO "item_descriptions" VALUES(765,'es','Esta guadaña perteneció a Farle Ingals en persona, está suficientemente afilada para segar cualquier tipo de cereal y todo tipo de monstruos que se esconden en los campos de cereales.');
INSERT INTO "item_descriptions" VALUES(766,'es','Este amuleto convierte la vitalidad en potencia y permite ocasionar más daños.');
INSERT INTO "item_descriptions" VALUES(767,'es','A pesar de su nombre pomposo, este anillo sólo te vuelve más fuerte y un poco más estúpido.');
INSERT INTO "item_descriptions" VALUES(768,'es','Este anillo influye sobre el curso de tu destino, te vuelve más resistente, pero menos afortunado. Aumentarás tus posibilidades de vivir más tiempo a la vez que disminuyes tus posibilidades de vivir feliz.');
INSERT INTO "item_descriptions" VALUES(769,'es','Estas botas traen suerte. El problema es que te vuelven menos resistente en combate.');
INSERT INTO "item_descriptions" VALUES(770,'es','Este magnífico par de botas convierte un poco de tu fuerza en inteligencia.');
INSERT INTO "item_descriptions" VALUES(771,'es','Esta hacha no tiene nada extraordinario, sin embargo no deja de ser muy apreciada por los Leñadores novatos que la aprecian por su simplicidad de uso.');
INSERT INTO "item_descriptions" VALUES(772,'es','Cuentan que esta legendaria capa permite volverse casi invencible si se combina con la espada legendaria de los esgrimidores, el Dar Takán y el sombrero legendario de Kurro Minéjez.');
INSERT INTO "item_descriptions" VALUES(773,'es','Esta capa viene del país de las Pastasitaliani, un lugar donde se habla con las manos. Lo cual explica la gran libertad de movimiento que esta procura. Además es muy ligera.');
INSERT INTO "item_descriptions" VALUES(774,'es','Viene del Monte Eide y cosa extraña, condujo al envenenamiento de su anterior propietaria aunque hoy en día aumente la resistencia del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(775,'es','Ha sido tejida con magia e infinito cuidado. La Capa Bilidad permite que su portador encuentre los puntos débiles de sus adversarios para poder alcanzarles y causarles daños destructores.');
INSERT INTO "item_descriptions" VALUES(776,'es','Ha pertenecido a una tal Mulba que la utilizaba para transportar objetos que le estorbaban en su búsqueda de Siete Ollas de Cristal que se cayeron de unas estrellas, esta capa aumenta la fuerza de forma considerable.');
INSERT INTO "item_descriptions" VALUES(777,'es','El Gallo que "regaló" sus plumas para poder crear esta capa no fue fácil de atrapar, de hecho su granjero y legítimo propietario anduvo corriendo tras él varias horas sin resultado hasta que decidió armar una trampa con tres botones, un alambre y un viejo calzón gastado... Más vale maña que fuerza.');
INSERT INTO "item_descriptions" VALUES(778,'es','Esta auténtica capa de malo demuestra que perteneces a la pandilla del diabólicamente genial Mori Arty del cual se dice que era tan desafortunado como inteligente. Solamente los más malos pueden ponérsela.');
INSERT INTO "item_descriptions" VALUES(779,'es','Aunque parezca normal y corriente, esta capa no es una cualquiera. Dicen que el que la lleve puesta se volverá invisible y que nadie podrá verlo si no miran para él. ¡Impresionante!');
INSERT INTO "item_descriptions" VALUES(781,'es','Esta magnífica capa perteneció al gran estratega Estrateguerra que creaba pesados artefactos de guerra para con ellos poder dominar el universo... Al ponerse esta capa abandonó todos sus maquiavélicos proyectos, qué extraño...');
INSERT INTO "item_descriptions" VALUES(782,'es','Esta hacha es bastante particular, en un principio se usaba para el aprendizaje del oficio de Leñador. Si se utiliza correctamente, puede partir en dos un joven Abráknido demasiado temerario, aunque haya que confesarlo, ese caso se da muy raras veces.');
INSERT INTO "item_descriptions" VALUES(783,'es','Este amuleto, exclusivamente hecho con madera preciosa, es muy rebuscado por los Leñadores. Pues a menudo le atribuyen poderes que no tiene.');
INSERT INTO "item_descriptions" VALUES(784,'es','El Gato con Gotas era el apodo que se le había dado a un famoso Zurcarák. Este era famoso por echarse unas gotitas de aguardiente en la leche del desayuno. Decía que eso era muy saludable y probablemente hubiera vivido muchos años si no se hubiera caído tontamente desde aquel puente... pues ese triste año, Amakna había sufrido los daños de la sequía, el Gato también.');
INSERT INTO "item_descriptions" VALUES(785,'es','Este anillo, transmitido de Abuelo Anutrof a Padre Anutrof, ofrece a su dueño una fuerza increíble. Se trata aquí de una pálida imitación, saciará sin embargo el apetito de los coleccionistas, ya sean Anutrof o no.');
INSERT INTO "item_descriptions" VALUES(786,'es','Fruto de un error de manipulación por parte de un joyero, este amuleto aumenta la inteligencia de su portador. En cambio, produce generalmente un fuerte dolor de cabeza, lo cual disminuye la condición física de su propietario.');
INSERT INTO "item_descriptions" VALUES(787,'es','Este extraño anillito tiene la facultad de aumentar la agilidad de su portador, sin embargo disminuye la suerte de este.');
INSERT INTO "item_descriptions" VALUES(789,'es','Este cinturón causó furor entre los jóvenes de Amakna. Fue un sastre Sadida el que lo creó. Cuando hizo su primera venta se exclamó: "¡La vida es corta, jugad duramente!"');
INSERT INTO "item_descriptions" VALUES(790,'es','Los efectos mágicos de esta capa son a menudo sobreestimados. Eso causó la pérdida de muchos aventureros, principalmente, la del tristemente famoso trovador Badiz Mustabante.');
INSERT INTO "item_descriptions" VALUES(791,'es','Se trata de un bastón de raíces de Abráknido todavía vivitas y coleando. Ten cuidado porque tiene cierta tendencia en volverse contra su amo. Puede ser muy eficaz cuando decide atacar al mismo blanco que el de su amo.');
INSERT INTO "item_descriptions" VALUES(819,'es','Esta es una espada santa que se entrega a los jóvenes guerreros durante su formación.');
INSERT INTO "item_descriptions" VALUES(820,'es','Esta es una espada santa que se entrega a los jóvenes guerreros durante su formación.');
INSERT INTO "item_descriptions" VALUES(821,'es','Esta es una espada santa que se entrega a los jóvenes guerreros durante su formación.');
INSERT INTO "item_descriptions" VALUES(822,'es','La Espada del Caballero es una espada sólida y eficaz, si la usas de forma adecuada podrás causar enormes daños a tus adversarios.');
INSERT INTO "item_descriptions" VALUES(823,'es','La Espada del Gran Caballero es una espada sólida y eficaz, si la usas de forma adecuada podrás causar enormes daños a tus adversarios.');
INSERT INTO "item_descriptions" VALUES(824,'es','La Espada del Poderoso Caballero es una espada sólida y eficaz, si la usas de forma adecuada podrás causar enormes daños a tus adversarios.');
INSERT INTO "item_descriptions" VALUES(825,'es','Esta espada aparentemente rudimentaria es muy apreciada por los bworks más estúpidos que no saben servirse de un arco o de un bastón, incluso algunos confunden el filo con el mango lo cual provoca la risa de sus adversarios.');
INSERT INTO "item_descriptions" VALUES(826,'es','Esta espada aparentemente rudimentaria es muy apreciada por los Bworks más estúpidos que no saben servirse de un arco o de un bastón, incluso algunos confunden el filo con el mango lo cual provoca la risa de sus adversarios.');
INSERT INTO "item_descriptions" VALUES(827,'es','Esta espada aparentemente rudimentaria es muy apreciada por los Bworks más estúpidos que no saben servirse de un arco o de un bastón, incluso algunos confunden el filo con el mango lo cual provoca la risa de sus adversarios.');
INSERT INTO "item_descriptions" VALUES(828,'es','Este arco dispara tan rápido sus flechas que se las oye desde muy lejos. Por lo cual piensa en equiparlo con un silenciador si necesitas ser discreto.');
INSERT INTO "item_descriptions" VALUES(829,'es','Por culpa de su escaso alcance, este arco no es muy eficaz aunque permita debilitar suficientemente al enemigo antes de rematarlo con otra arma o con la magia.');
INSERT INTO "item_descriptions" VALUES(830,'es','Esta varita permite aumentar la inteligencia de quien la posea.');
INSERT INTO "item_descriptions" VALUES(831,'es','Esta varita permite aumentar la inteligencia de quien la posea.');
INSERT INTO "item_descriptions" VALUES(832,'es','Esta varita permite aumentar la inteligencia de quien la posea.');
INSERT INTO "item_descriptions" VALUES(833,'es','Esta varita permite aumentar la sabiduría de quien la posea.');
INSERT INTO "item_descriptions" VALUES(834,'es','Esta varita permite aumentar la sabiduría de quien la posea.');
INSERT INTO "item_descriptions" VALUES(835,'es','Esta varita permite aumentar la sabiduría de quien la posea.');
INSERT INTO "item_descriptions" VALUES(836,'es','Este anillo fue forjado en la corteza de abráknido. Posee grandes poderes e implica por lo tanto grandes responsabilidades. Sin embargo, a pesar de su valor, existen rumores que cuentan que está maldito.');
INSERT INTO "item_descriptions" VALUES(837,'es','Estas botas aumentan la fuerza del que las lleva pero pueden hacer que se vuelva un poco idiota al cabo de un cierto tiempo e incluso pueden transformarlo en Yopuka si las utiliza demasiado a menudo y de forma prolongada.');
INSERT INTO "item_descriptions" VALUES(841,'es','Este anillo permitirá aumentar los PA de tu héroe, en contrapartida de su fuerza e inteligencia.');
INSERT INTO "item_descriptions" VALUES(849,'es','Este pequeño anillo procura Fuerza a su portador.');
INSERT INTO "item_descriptions" VALUES(850,'es','Curiosamente, los coleccionistas Amaknienses se disputan este anillo a pesar de que no valga un churro.');
INSERT INTO "item_descriptions" VALUES(851,'es','Este pequeño anillo aumenta la vida de su portador.');
INSERT INTO "item_descriptions" VALUES(852,'es','Este pequeño anillo aumenta la inteligencia de su portador.');
INSERT INTO "item_descriptions" VALUES(853,'es','Este pequeño anillo aumenta la suerte de su portador.');
INSERT INTO "item_descriptions" VALUES(854,'es','Este amuleto aumenta la fuerza de su portador.');
INSERT INTO "item_descriptions" VALUES(855,'es','Este amuleto aumenta la vida de su portador.');
INSERT INTO "item_descriptions" VALUES(856,'es','Este amuleto aumenta la agilidad de su portador.');
INSERT INTO "item_descriptions" VALUES(859,'es','Este modesto cinturón aumenta la agilidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(860,'es','Este modesto cinturón aumenta la suerte de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(861,'es','Esta botas aumentan la fuerza del que las lleva en detrimento de su agilidad, lo cual tiende a diferenciarlo de un Tofu sin que sea tampoco menos idiota.');
INSERT INTO "item_descriptions" VALUES(862,'es','Estas botas permiten aumentar la inteligencia del que las lleva al mismo tiempo que le confiere un estilo muy a la moda gracias a su suela de madera de nogal que ofrece una adherencia increíble.');
INSERT INTO "item_descriptions" VALUES(863,'es','Estas botas permiten aumentar la agilidad del que las lleva. De esta manera podrá imitar a un Tofu cuando le entren ganas de hacer el imbécil.');
INSERT INTO "item_descriptions" VALUES(864,'es','Estas botas aumentan la suerte del que las lleva para ayudarle a encontrar objetos muy poderosos, como por ejemplo la baba de Jalató.');
INSERT INTO "item_descriptions" VALUES(867,'es','Este espléndido amuleto confeccionado a partir de restos de Dragohuevo, es lo suficientemente impresionante como para alejar a la mayoría de los enemigos normalmente constituidos.');
INSERT INTO "item_descriptions" VALUES(888,'es','Estas botas son tan cómodas que permiten que el héroe que las lleve aumente su capacidad para concentrarse.');
INSERT INTO "item_descriptions" VALUES(889,'es','Estas botas son tan cómodas que permiten que el héroe que las lleve aumente su capacidad para concentrarse.');
INSERT INTO "item_descriptions" VALUES(890,'es','Estas botas están hechas con cuero de Jalató, permiten que los ganaderos puedan acercarse más fácilmente a los Jalatós para matarlos gracias al olor que desprenden.');
INSERT INTO "item_descriptions" VALUES(891,'es','Estas botas están hechas con cuero de Jalató, permiten que los ganaderos puedan acercarse más fácilmente a los Jalatós para matarlos gracias al olor que desprenden.');
INSERT INTO "item_descriptions" VALUES(892,'es','Estas botas están hechas con cuero de Jalató, permiten que los ganaderos puedan acercarse más fácilmente a los Jalatós para matarlos gracias al olor que desprenden.');
INSERT INTO "item_descriptions" VALUES(893,'es','Estas dagas fueron especialmente diseñadas para cortar raíces o pequeños brotes, ahora se usan para otros propósitos y se volvieron unas armas casi letales.');
INSERT INTO "item_descriptions" VALUES(894,'es','Estas dagas fueron especialmente diseñadas para cortar raíces o pequeños brotes, ahora se usan para otros propósitos y se volvieron unas armas casi letales.');
INSERT INTO "item_descriptions" VALUES(895,'es','Estas dagas fueron especialmente diseñadas para cortar raíces o pequeños brotes, ahora se usan para otros propósitos y se volvieron unas armas casi letales.');
INSERT INTO "item_descriptions" VALUES(896,'es','Estas dagas fueron especialmente diseñadas para cortar raíces o pequeños brotes, ahora se usan para otros propósitos y se volvieron unas armas casi letales.');
INSERT INTO "item_descriptions" VALUES(897,'es','Estas dagas aparentemente modestas son sin embargo muy peligrosas. Además son fáciles de esconder las vuelve ideales para los asesinos.');
INSERT INTO "item_descriptions" VALUES(898,'es','Estas dagas aparentemente modestas son sin embargo muy peligrosas. Además son fáciles de esconder las vuelve ideales para los asesinos.');
INSERT INTO "item_descriptions" VALUES(899,'es','Estas dagas aparentemente modestas son sin embargo muy peligrosas. Además son fáciles de esconder las vuelve ideales para los asesinos.');
INSERT INTO "item_descriptions" VALUES(900,'es','Estas dagas aparentemente modestas son sin embargo muy peligrosas. Además son fáciles de esconder las vuelve ideales para los asesinos.');
INSERT INTO "item_descriptions" VALUES(902,'es','La agilidad que confieren estas botas permitía a Klim el zapatero montar fácilmente sobre el lomo de cualquier jalató. Se murió al confundir un jalató con una gelatina, tras una noche demasiado alcoholizada en la taberna.');
INSERT INTO "item_descriptions" VALUES(903,'es','La agilidad que confieren estas botas permitía a Klim el zapatero montar fácilmente sobre el lomo de cualquier jalató. Se murió al confundir un jalató con una gelatina, tras una noche demasiado alcoholizada en la taberna.');
INSERT INTO "item_descriptions" VALUES(904,'es','La agilidad que confieren estas botas permitía a Klim el zapatero montar fácilmente sobre el lomo de cualquier jalató. Se murió al confundir un jalató con una gelatina, tras una noche demasiado alcoholizada en la taberna.');
INSERT INTO "item_descriptions" VALUES(905,'es','Cuenta la leyenda que estas botas han sido intercambiadas por otras botas, defectuosas pero superpoderosas, que habían sido fabricadas por un torpe zapatero que no había dormido lo suficiente.');
INSERT INTO "item_descriptions" VALUES(906,'es','Hogmeiser podía con estas botas perseguir a los únicos seres vivientes que no soportaba, los niños. Afortunadamente para ellos, estas botas eran tan pesadas que no conseguía patearles el trasero.');
INSERT INTO "item_descriptions" VALUES(907,'es','Estas botas permitían a Hogmeiser perseguir a los únicos seres vivientes que no soportaba, los niños. Afortunadamente para ellos, estas botas eran tan pesadas que no conseguía patearles el trasero.');
INSERT INTO "item_descriptions" VALUES(908,'es','Estas botas permitían a Hogmeiser perseguir a los únicos seres vivientes que no soportaba, los niños. Afortunadamente para ellos, estas botas eran tan pesadas que no conseguía patearles el trasero.');
INSERT INTO "item_descriptions" VALUES(909,'es','Estas botas permitían a Hogmeiser perseguir a los únicos seres vivientes que no soportaba, los niños. Afortunadamente para ellos, estas botas eran tan pesadas que no conseguía patearles el trasero.');
INSERT INTO "item_descriptions" VALUES(910,'es','Estas botas pertenecieron durante años a Hogmeiser, antes de que las perdiese en una apuesta estúpida con Grizmoh Guay. Moraleja: Nunca juegues con un Zurcarák.');
INSERT INTO "item_descriptions" VALUES(911,'es','Estas botas han pertenecido durante años a Hogmeiser, están tan usadas que son más que nada un estorbo. Un buenísimo Zapatero debería poder repararlas con un poco de suerte.');
INSERT INTO "item_descriptions" VALUES(912,'es','Estas magníficas botas de Hogmeiser están revestidas con una capa fina de piedras preciosas para que resistan a determinados ataques mágicos. Estas botas son las que Brus Bulguro utilizó para aplastar la cabeza del Rey de los Abráknidos hace mucho tiempo, para animar la apertura de la Feria del Trool.');
INSERT INTO "item_descriptions" VALUES(913,'es','Este gorro demostrará a todo el mundo que eres un aprendiz Panadero.');
INSERT INTO "item_descriptions" VALUES(914,'es','Este gorro demostrará a todo el mundo que eres un Panadero.');
INSERT INTO "item_descriptions" VALUES(915,'es','Este gorro demostrará a todo el mundo que eres un Maestro Panadero. Cueces y amasas más rápido que lo demás Panaderos, eso a algo que ahora todos saben.');
INSERT INTO "item_descriptions" VALUES(916,'es','Silicato realizó este Amuleto una mañana de invierno, para un famoso aventurero llamado Rimb Vardi, que perseguía a un viejo Bwork Mago, responsable de varias catástrofes naturales que su magia, demasiado aproximativa, había desencadenado.');
INSERT INTO "item_descriptions" VALUES(917,'es','Este Broche ha sido realizado una mañana de otoño en medio de un bosque de Hayas y Olmos no muy lejos de la isla de Olag-lacustre. Muchos leñadores la consideran como una auténtica reliquia.');
INSERT INTO "item_descriptions" VALUES(919,'es','Estas magníficas dagas, forjadas a partir de Ámbar Ancestral y usando antiguos métodos, sirvieron durante la colonización de la isla de Moon, antes de que ésta se volviera otra vez salvaje.');
INSERT INTO "item_descriptions" VALUES(922,'es','Una herramienta indispensable para forjar hachas.');
INSERT INTO "item_descriptions" VALUES(923,'es','Esta hacha de guerra ha sido forjada por Kademlia Bulguro para luchar contra los más terroríficos Abráknidos. Cuenta la leyenda que esta arma legendaria ha matado, en una noche, a más Abráknidos que árboles hay en Amakna.');
INSERT INTO "item_descriptions" VALUES(924,'es','La agilidad que confieren estas botas permitía a Klim el zapatero montar fácilmente sobre el lomo de cualquier jalató. Se murió al confundir un jalató con una gelatina, tras una noche demasiado alcoholizada en la taberna.');
INSERT INTO "item_descriptions" VALUES(927,'es','Esta hacha ha sido forjada por Kademlia Bulguro, para combatir el Abráknido Ancestral. Sólo los mejores guerreros pueden utilizarla.');
INSERT INTO "item_descriptions" VALUES(928,'es','Ogralimde era un gran guerrero que debía su fuerza a Adyol su maestro, un poderoso Bwork Mago cuya inteligencia era sorprendente. Pero, a pesar de lo que cuenta la leyenda, el alumno nunca superó al maestro.');
INSERT INTO "item_descriptions" VALUES(932,'es','Esta capa aumenta la vida del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(933,'es','Esta capa aumenta la vida del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(934,'es','Esta capa aumenta la vida del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(935,'es','Esta capa aumenta la suerte del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(936,'es','Esta capa aumenta la suerte del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(937,'es','Esta capa aumenta la suerte del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(940,'es','El Depedador te protege contra los daños físicos.');
INSERT INTO "item_descriptions" VALUES(941,'es','El Komuntot permite aumentar la sabiduría de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(942,'es','El Alisador te protege contra los daños mágicos.');
INSERT INTO "item_descriptions" VALUES(943,'es','Este pañuelo permite aumentar la vitalidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(944,'es','Este pañuelo permite aumentar la vitalidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(945,'es','Esta capa aumenta la sabiduría del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(946,'es','Esta capa aumenta la sabiduría del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(947,'es','Esta capa aumenta la sabiduría del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(948,'es','Esta magnífica capa es una sabia mezcla entre la esencia de abráknido y el buen jalató de siempre.');
INSERT INTO "item_descriptions" VALUES(949,'es','Este Pañuelo permite aumentar la vitalidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(952,'es','Esta capa ha sido creada con pelos y otros elementos orgánicos de varios mediulubos... Se puede decir que su olor es poderoso y duradero.');
INSERT INTO "item_descriptions" VALUES(953,'es','Esta capa, cosida con plumas de tofus, permite que el héroe que la lleve puesta corra más rápido y se escape más fácilmente de las zonas de placaje.');
INSERT INTO "item_descriptions" VALUES(954,'es','La Samulay es una capa legendaria, bordada por los mejores sastres para los guerreros que prefieren los combates de cuerpo a cuerpo.');
INSERT INTO "item_descriptions" VALUES(955,'es','La capa Ylar es un tipo de capa muy pedida por los peluqueros. Les encanta revolcarse en ella. Hace que los pelos del que la lleve puesta se vuelvan más resistentes.');
INSERT INTO "item_descriptions" VALUES(956,'es','Esta capa aumenta el alcance del que la lleve puesta, permitiéndole a su vez atinar los blancos muy alejados o impresionar a los aventureros un poco ingenuos.');
INSERT INTO "item_descriptions" VALUES(957,'es','La Jalatada aumenta los daños y la vitalidad del que la lleve puesta. Sin embrago, desprende un fuerte olor y puede ser que algún Jalató piense que eres uno de los suyos.');
INSERT INTO "item_descriptions" VALUES(958,'es','Esta capa es sin duda alguna una de las más poderosas del mundo. Aumenta todas las características del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(967,'es','Esta magnífica capa aumenta los puntos de acción del que la lleve puesta. También aumenta su vitalidad y su sabiduría.');
INSERT INTO "item_descriptions" VALUES(968,'es','Este magnífico cinturón aumenta los puntos de acción de quien lo lleve puesto. También aumenta su vitalidad y su sabiduría.');
INSERT INTO "item_descriptions" VALUES(969,'es','Esta magnífica corona perteneció al tristemente célebre Wey Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'es','Este bastón pertenecía al tristemente célebre Wey Wabbit.');
INSERT INTO "item_descriptions" VALUES(971,'es','Esta capa pertenecía al tristemente célebre Wey Wabbit. Todavía está impregnada por su transpiración lo cual te permitirá recordar siempre ese magnífico combate en cuanto te la pongas.');
INSERT INTO "item_descriptions" VALUES(972,'es','El Dofus Zanahowia aumenta la sabiduría de su portador.');
INSERT INTO "item_descriptions" VALUES(976,'es','La calawaza tiene la particularidad de evitar la dispersión de partículas de magia, esto hace de ella un buen aislante mágico. Por eso algunos guerreros utilizan esta legumbre como sombrero.');
INSERT INTO "item_descriptions" VALUES(1019,'es','Llevar este casco significa adoptar un look único... A medio camino entre lo cómico y lo ridículo.');
INSERT INTO "item_descriptions" VALUES(1021,'es','Quienes hayan soñado desde siempre con poder volar como un Kwak, pueden regresar a sus quehaceres porque estas alas solamente les convertirán en un peligro público y encima estúpido.');
INSERT INTO "item_descriptions" VALUES(1026,'es','El ilustre loco Stek Rokefor encargó hacer estos extraños y temibles cuchillos. Nadie sabía para qué servían hasta que intentó regalar comida a su dios.');
INSERT INTO "item_descriptions" VALUES(1027,'es','El ilustre loco Stek Rokefor encargó hacer estos extraños y temibles cuchillos. Nadie sabía para qué servían hasta que intentó regalar comida a su dios.');
INSERT INTO "item_descriptions" VALUES(1028,'es','El ilustre loco Stek Rokefor encargó hacer estos extraños y temibles cuchillos. Nadie sabía para qué servían hasta que intentó regalar comida a su dios.');
INSERT INTO "item_descriptions" VALUES(1029,'es','El ilustre loco Stek Rokefor encargó hacer estos extraños y temibles cuchillos. Nadie sabía para qué servían hasta que intentó regalar comida a su dios.');
INSERT INTO "item_descriptions" VALUES(1030,'es','Este par de dagas es en realidad un magnífico juguete. Ha sido creado para los jóvenes Zurcaráks, su producción ha sido prohibida cuando un niño adepto de Sram se puso a jugar con ellos.');
INSERT INTO "item_descriptions" VALUES(1031,'es','Estas magníficas dagas pertenecieron a la Sramita más cruel que Amakna haya conocido. Bueno, una de las más crueles... En realidad sólo lo era un poco más que las demás, vamos o por lo menos tanto como las demás, lo cual ya es bastante.');
INSERT INTO "item_descriptions" VALUES(1032,'es','Según cuenta la leyenda, el viejo Parra forjó estas hojas para que la Amaknidad estuviera a salvo de la desnudez. Así fue como la gente empezó a luchar entre sí para despojarse mutuamente y no pasar frío durante las noches de intenso frío. Bueno, todos te dirán que nunca hay que tomarse las leyendas al pie de la letra... Aunque esta sea cierta.');
INSERT INTO "item_descriptions" VALUES(1033,'es','Según cuenta la leyenda, el viejo Parra forjó estas hojas para que la Amaknidad estuviera a salvo de la desnudez. Así fue como la gente empezó a luchar entre sí para despojarse mutuamente y no pasar frío durante las noches de intenso frío. Bueno, todos te dirán que nunca hay que tomarse las leyendas al pie de la letra... Aunque esta sea cierta.');
INSERT INTO "item_descriptions" VALUES(1034,'es','Según cuenta la leyenda, el viejo Parra forjó estas hojas para que la Amaknidad estuviera a salvo de la desnudez. Así fue como la gente empezó a luchar entre sí para despojarse mutuamente y no pasar frío durante las noches de intenso frío. Bueno, todos te dirán que nunca hay que tomarse las leyendas al pie de la letra... Aunque esta sea cierta.');
INSERT INTO "item_descriptions" VALUES(1035,'es','Según cuenta la leyenda, el viejo Parra forjó estas hojas para que la Amaknidad estuviera a salvo de la desnudez. Así fue como la gente empezó a luchar entre sí para despojarse mutuamente y no pasar frío durante las noches de intenso frío. Bueno, todos te dirán que nunca hay que tomarse las leyendas al pie de la letra... Aunque esta sea cierta.');
INSERT INTO "item_descriptions" VALUES(1036,'es','Esta daga Sram tiene una forma particularmente engañadora. Tan engañadora que uno puede preguntarse si realmente se trata de una daga. Y cuando se consigue la respuesta, suele ser demasiado tarde.');
INSERT INTO "item_descriptions" VALUES(1037,'es','Esta daga Sram tiene una forma particularmente engañadora. Tan engañadora que uno puede preguntarse si realmente se trata de una daga. Y cuando se consigue la respuesta, suele ser demasiado tarde.');
INSERT INTO "item_descriptions" VALUES(1038,'es','Esta daga sram tiene una forma particularmente engañadora. Tan engañadora que uno puede preguntarse si realmente se trata de una daga. Y cuando se consigue la respuesta, suele ser demasiado tarde.');
INSERT INTO "item_descriptions" VALUES(1039,'es','Esta daga Sram tiene una forma particularmente engañadora. Tan engañadora que uno puede preguntarse si realmente se trata de una daga. Y cuando se consigue la respuesta, suele ser demasiado tarde.');
INSERT INTO "item_descriptions" VALUES(1040,'es','Ortimus Contrari es una leyenda que los asesinos suelen contar entre ellos. Dicen que Ortimus cumple con sus contratos de una forma totalmente opuesta a los métodos tradicionales. No pidas más explicaciones, podrías morirte al instante.');
INSERT INTO "item_descriptions" VALUES(1041,'es','Esta espada ha sido un regalo para la armadura de gala de un joven Yopuka llamado Bajo Skalera. Desafortunadamente, durante su primera misión como caballero, resbaló sobre una piedra. En realidad, aquella piedra era el dedo meñique del pie de un crujidor...');
INSERT INTO "item_descriptions" VALUES(1042,'es','Esta pala está hecha con una madera muy rara. Según la leyenda, cualquier joven muchacha que roce esta pala con sus cabellos, entrará en un sueño eterno. Téngase en cuenta de que en caso de contactos repetidos, los efectos se aplican a cualquiera.');
INSERT INTO "item_descriptions" VALUES(1043,'es','Esta pala está hecha con una madera muy rara. Según la leyenda, cualquier joven muchacha que roce esta pala con sus cabellos, entrará en un sueño eterno. Téngase en cuenta de que en caso de contactos repetidos, los efectos se aplican a cualquiera.');
INSERT INTO "item_descriptions" VALUES(1044,'es','Esta pala está hecha con una madera muy rara. Según la leyenda, cualquier joven muchacha que roce esta pala con sus cabellos, entrará en un sueño eterno. Téngase en cuenta de que en caso de contactos repetidos, los efectos se aplican a cualquiera.');
INSERT INTO "item_descriptions" VALUES(1045,'es','Esta pala está hecha con una madera muy rara. Según la leyenda, cualquier joven muchacha que roce esta pala con sus cabellos, entrará en un sueño eterno. Téngase en cuenta de que en caso de contactos repetidos, los efectos se aplican a cualquiera.');
INSERT INTO "item_descriptions" VALUES(1046,'es','Esta pala está enredada ¿Quién la desendredará? El buen desenrededador que la desenherede buen deresendadedor será...Además, con ella ¡podrás eliminar las malas hierbas!');
INSERT INTO "item_descriptions" VALUES(1047,'es','Esta pala está enredada ¿Quién la desendredará? El buen desenrededador que la desenherede buen deresendadedor será...Además, con ella ¡podrás eliminar las malas hierbas!');
INSERT INTO "item_descriptions" VALUES(1048,'es','Esta pala está enredada ¿Quién la desendredará? El buen desenrededador que la desenherede buen deresendadedor será...Además, con ella ¡podrás eliminar las malas hierbas!');
INSERT INTO "item_descriptions" VALUES(1049,'es','Esta pala está enredada ¿Quién la desendredará? El buen desenrededador que la desenherede buen deresendadedor será...Además, con ella ¡podrás eliminar las malas hierbas!');
INSERT INTO "item_descriptions" VALUES(1050,'es','Esta pala ha sido creada y utilizada por la familia Wukis durante la guerra intestina que hubo entre los grupos Ukis y Dukis, competidores directos de exportación de tofus asados. Es un arma temible, su único defecto es que te deja las manos grasientas.');
INSERT INTO "item_descriptions" VALUES(1051,'es','Esta pala ha sido creada y utilizada por la familia Wukis durante la guerra intestina que hubo entre los grupos Ukis y Dukis, competidores directos de exportación de tofus asados. Es un arma temible, su único defecto es que te deja las manos grasientas.');
INSERT INTO "item_descriptions" VALUES(1052,'es','Esta pala ha sido creada y utilizada por la familia Wukis durante la guerra intestina que hubo entre los grupos Ukis y Dukis, competidores directos de exportación de tofus asados. Es un arma temible, su único defecto es que te deja las manos grasientas.');
INSERT INTO "item_descriptions" VALUES(1053,'es','Esta pala ha sido creada y utilizada por la familia Wukis durante la guerra intestina que hubo entre los grupos Ukis y Dukis, competidores directos de exportación de tofus asados. Es un arma temible, su único defecto es que te deja las manos grasientas.');
INSERT INTO "item_descriptions" VALUES(1054,'es','Esta herramienta es un cruce entre una pala y una paleta, la Pala Paleta perdió su carácter útil para convertirse en un arma famosísima. Se maneja con rapidez y se puede guardar fácilmente gracias a su pequeño tamaño, es el accesorio ideal de cualquier Anutrof al que le guste el alcohol.');
INSERT INTO "item_descriptions" VALUES(1055,'es','Los habitantes de la isla Kutulú fabrican artesanalmente estas terribles palas con materias de aquí y de allí (pero sobre todo del allí). Malísimas para excavar, están hechas solamente para asustar a los espíritus y a los niños revoltosos.');
INSERT INTO "item_descriptions" VALUES(1056,'es','Los habitantes de la isla Kutulú fabrican artesanalmente estas terribles palas con materias de aquí y de allí (pero sobre todo del allí). Malísimas para excavar, están hechas solamente para asustar a los espíritus y a los niños revoltosos.');
INSERT INTO "item_descriptions" VALUES(1057,'es','Los habitantes de la isla Kutulú fabrican artesanalmente estas terribles palas con materias de aquí y de allí (pero sobre todo del allí). Malísimas para excavar, están hechas solamente para asustar a los espíritus y a los niños revoltosos.');
INSERT INTO "item_descriptions" VALUES(1058,'es','Los habitantes de la isla Kutulú fabrican artesanalmente estas terribles palas con materias de aquí y de allí (pero sobre todo del allí). Malísimas para excavar, están hechas solamente para asustar a los espíritus y a los niños revoltosos.');
INSERT INTO "item_descriptions" VALUES(1059,'es','Esta pala es la preferida de los agricultores, sobre todo de los cosechadores de pwatatas.  
Aunque nada te impida usarla para desnucar a tus enemigos.');
INSERT INTO "item_descriptions" VALUES(1060,'es','Se trata de una de las armas predilectas creadas por Da. Esta maza, tiene una aerodinámica calculada y parte dos veces mejor el aire, por lo cual también parte dos veces más rápidamente los cráneos. Dos buenas razones para poseer esta arma.');
INSERT INTO "item_descriptions" VALUES(1061,'es','Se trata de una de las armas predilectas creadas por Da. Esta maza, tiene una aerodinámica calculada y parte dos veces mejor el aire, por lo cual también parte dos veces más rápidamente los cráneos. Dos buenas razones para poseer esta arma.');
INSERT INTO "item_descriptions" VALUES(1062,'es','Se trata de una de las armas predilectas creadas por Da. Esta maza, tiene una aerodinámica calculada y parte dos veces mejor el aire, por lo cual también parte dos veces más rápidamente los cráneos. Dos buenas razones para poseer esta arma.');
INSERT INTO "item_descriptions" VALUES(1063,'es','Se trata de una de las armas predilectas creadas por Da. Esta maza, tiene una aerodinámica calculada y parte dos veces mejor el aire por lo cual también parte dos veces más rápidamente los cráneos. Dos buenas razones para poseer esta arma.');
INSERT INTO "item_descriptions" VALUES(1064,'es','Dicen que este martillo es una pieza única porque ha sido fabricado de forma artesanal por los antiguos forjadores Xelor. En cambio algunos cuentan que se trata de una de las letras del cartel publicitario de un herrero. Pruébalo sobre una cabeza y saca tus propias conclusiones.');
INSERT INTO "item_descriptions" VALUES(1065,'es','Dicen que este martillo es una pieza única porque ha sido fabricado de forma artesanal por los antiguos forjadores Xelor. En cambio algunos cuentan que se trata de una de las letras del cartel publicitario de un herrero. Pruébalo sobre una cabeza y saca tus propias conclusiones.');
INSERT INTO "item_descriptions" VALUES(1066,'es','Dicen que este martillo es una pieza única porque ha sido fabricado de forma artesanal por los antiguos forjadores Xelor. En cambio algunos cuentan que se trata de una de las letras del cartel publicitario de un herrero. Pruébalo sobre una cabeza y saca tus propias conclusiones.');
INSERT INTO "item_descriptions" VALUES(1067,'es','Dicen que este martillo es una pieza única porque ha sido fabricado de forma artesanal por los antiguos forjadores Xelor. En cambio algunos cuentan que se trata de una de las letras del cartel publicitario de un herrero. Pruébalo sobre una cabeza y saca tus propias conclusiones.');
INSERT INTO "item_descriptions" VALUES(1068,'es','Esta maza le permitió al gran Thuno hacerse con el corazón de su dulcinea llamada Damelklavel... se acercó a su balcón, trepó por las hiedras y le propinó un buen golpe en la cocorota. La leyenda no cuenta cómo hizo para sacarle el corazón... a veces es mejor no saber ciertas cosas.');
INSERT INTO "item_descriptions" VALUES(1069,'es','Esta maza le permitió al gran Thuno hacerse con el corazón de su dulcinea llamada Damelklavel... se acercó a su balcón, trepó por las hiedras y le propinó un buen golpe en la cocorota. La leyenda no cuenta cómo hizo para sacarle el corazón... a veces es mejor no saber ciertas cosas.');
