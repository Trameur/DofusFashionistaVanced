INSERT INTO "item_descriptions" VALUES(1071,'es','Esta maza le permitió al gran Thuno hacerse con el corazón de su dulcinea llamada Damelklavel... se acercó a su balcón, trepó por las hiedras y le propinó un buen golpe en la cocorota. La leyenda no cuenta cómo hizo para sacarle el corazón... a veces es mejor no saber ciertas cosas.');
INSERT INTO "item_descriptions" VALUES(1072,'es','Dicen que el Bwork, King Lacadog ha encargado hacer estos temibles martillos a un pueblo Xelor a cambio de un tratado de paz: si estos eran eficaces, el pueblo sería salvado. Cuando entregaron los martillos, el pueblo fue arrasado. Al fin de cuentas, ¡Había que probarlos!');
INSERT INTO "item_descriptions" VALUES(1073,'es','Dicen que el Bwork King Lacadog ha encargado hacer estos temibles martillos a un pueblo Xelor a cambio de un tratado de paz: si estos eran eficaces, el pueblo sería salvado. Cuando entregaron los martillos, el pueblo fue arrasado. Al fin de cuentas, ¡Había que probarlos!');
INSERT INTO "item_descriptions" VALUES(1074,'es','Dicen que el Bwork, King Lacadog ha encargado hacer estos temibles martillos a un pueblo Xelor a cambio de un tratado de paz: si estos eran eficaces, el pueblo sería salvado. Cuando entregaron los martillos, el pueblo fue arrasado. Al fin de cuentas, ¡Había que probarlos!');
INSERT INTO "item_descriptions" VALUES(1075,'es','Dicen que el Bwork King Lacadog ha encargado hacer estos temibles martillos a un pueblo Xelor a cambio de un tratado de paz: si estos eran eficaces, el pueblo sería salvado. Cuando entregaron los martillos, el pueblo fue arrasado. Al fin de cuentas, ¡Había que probarlos!');
INSERT INTO "item_descriptions" VALUES(1076,'es','Esta maza es la herencia de la antigua tribu pacífica Getay. Eso explica su principal utilidad: haciéndola rodar sobre los músculos doloridos, el dolor desaparece. Incluso los más brutos te dirán que también puede hacerlo aparecer.');
INSERT INTO "item_descriptions" VALUES(1077,'es','Esta maza es la herencia de la antigua tribu pacífica Getay. Eso explica su principal utilidad: haciéndola rodar sobre los músculos doloridos, el dolor desaparece. Incluso los más brutos te dirán que también puede hacerlo aparecer.');
INSERT INTO "item_descriptions" VALUES(1078,'es','Esta maza es la herencia de la antigua tribu pacífica Getay. Eso explica su principal utilidad: haciéndola rodar sobre los músculos doloridos, el dolor desaparece. Incluso los más brutos te dirán que también puede hacerlo aparecer.');
INSERT INTO "item_descriptions" VALUES(1079,'es','Esta maza es la herencia de la antigua tribu pacífica Getay. Eso explica su principal utilidad: haciéndola rodar sobre los músculos doloridos, el dolor desaparece. Incluso los más brutos te dirán que también puede hacerlo aparecer.');
INSERT INTO "item_descriptions" VALUES(1080,'es','Este martillo es tan ridículo que tu enemigo se partirá de la risa al verte. Eso te dará tiempo suficiente para reventarle el cráneo.');
INSERT INTO "item_descriptions" VALUES(1081,'es','Este martillo es tan ridículo que tu enemigo se partirá de la risa al verte. Eso te dará tiempo suficiente para reventarle el cráneo.');
INSERT INTO "item_descriptions" VALUES(1082,'es','Este martillo es tan ridículo que tu enemigo se partirá de la risa al verte. Eso te dará tiempo suficiente para reventarle el cráneo.');
INSERT INTO "item_descriptions" VALUES(1083,'es','Este martillo es tan ridículo que tu enemigo se partirá de la risa al verte. Eso te dará tiempo suficiente para reventarle el cráneo.');
INSERT INTO "item_descriptions" VALUES(1084,'es','Como lo indica su nombre, este martillo ha pertenecido a un Xelor llamado Tohr... Se murió electrocutado por un rayo cuando intentaba utilizar su arma para cobijarse de la lluvia. Triste final...');
INSERT INTO "item_descriptions" VALUES(1085,'es','Los Falistos eran demonios Xelors. Rechazaron sus antiguos principios y desarrollaron su fuerza forjando martillos cada vez más potentes. Después de haber aportado el caos, fueron derrotados y exiliados bajo tierra. Pero algunas de sus armas siguen en circulación.');
INSERT INTO "item_descriptions" VALUES(1087,'es','Este anillo puede aumentar levemente la inteligencia de su dueño.');
INSERT INTO "item_descriptions" VALUES(1088,'es','Esta máscara es la réplica exacta, en un poco más grande, de las que llevan con orgullo los Kaníbolas importantes.');
INSERT INTO "item_descriptions" VALUES(1090,'es','El Astrosombrero permite tener una hermosa pinta.');
INSERT INTO "item_descriptions" VALUES(1092,'es','Este arco fue especialmente diseñado para cazar pájaros. Ligero y de uso sencillo, te permitirá cazar un pájaro con dos tiros, o algo así...');
INSERT INTO "item_descriptions" VALUES(1093,'es','Este arco fue especialmente diseñado para cazar pájaros. Ligero y de uso sencillo, te permitirá cazar un pájaro con dos tiros, o algo así...');
INSERT INTO "item_descriptions" VALUES(1094,'es','Este arco fue especialmente diseñado para cazar pájaros. Ligero y de uso sencillo, te permitirá cazar un pájaro con dos tiros, o algo así...');
INSERT INTO "item_descriptions" VALUES(1095,'es','Este arco fue especialmente diseñado para cazar pájaros. Ligero y de uso sencillo, te permitirá cazar un pájaro con dos tiros, o algo así...');
INSERT INTO "item_descriptions" VALUES(1096,'es','"¡Con un Jalató, puedes hacerlo tó!" este era el eslogan de un comerciante del sur cuya especialidad consistía en reciclar Jalatós. Este arco era uno de sus productos. Aunque no sea muy estético no deja de ser un arma temible.');
INSERT INTO "item_descriptions" VALUES(1097,'es','"¡Con un Jalató, puedes hacerlo tó!" este era el eslogan de un comerciante del Sur cuya especialidad consistía en reciclar Jalatós. Este arco era uno de sus productos. Aunque no sea muy estético no deja de ser un arma temible.');
INSERT INTO "item_descriptions" VALUES(1098,'es','"¡Con un Jalató, puedes hacerlo tó!" este era el eslogan de un comerciante del Sur cuya especialidad consistía en reciclar Jalatós. Este arco era uno de sus productos. Aunque no sea muy estético no deja de ser un arma temible.');
INSERT INTO "item_descriptions" VALUES(1099,'es','Para hacer tests únicamente');
INSERT INTO "item_descriptions" VALUES(1101,'es','La aniripsa Migadepan confeccionó esta serie de varitas punzantes para luchar contra los robos. En teoría es capaz de remontar el tiempo para impedir una agresión, en general acaba plantándose en el ojo de algún demonio.');
INSERT INTO "item_descriptions" VALUES(1102,'es','La Aniripsa Migadepan confeccionó esta serie de varitas punzantes para luchar contra los robos. En teoría es capaz de remontar el tiempo para impedir una agresión, en general acaba plantándose en el ojo de algún demonio.');
