INSERT INTO "item_descriptions" VALUES(180,'en','This wand comes from the Syrastass Limbo. Legend has it can make entire fields of daisies bloom, if asked politely by its bearer.');
INSERT INTO "item_descriptions" VALUES(181,'en','Helle from High in the Sky blessed this wand. It gives its bearer agility and vitality in combat.');
