INSERT INTO "item_descriptions" VALUES(11497,'fr','Cette coiffe aux allures familières a été enchantée par Hel Munster lui-même suite aux demandes incessantes d''un célèbre couturier d''Astrub. Il désirait proposer une collection qui s''adapte aux couleurs de l''individu qui la porte. Décolorée par un procédé top secret, vous reconnaissez pourtant l''odeur caractéristique de la bave de Mulou qui s''en dégage... Beurk !');
INSERT INTO "item_descriptions" VALUES(11539,'fr','Cet arc a été assemblé avec des matériaux d''une grande qualité. En le saisissant, un grand pouvoir s''en dégage et cela se ressent également dans les flèches tirées.');
INSERT INTO "item_descriptions" VALUES(11542,'fr','En revêtant cet accoutrement, attendez-vous à une augmentation non négligeable des traquenards, des embuscades et autres attaques en tout genre des assaillants de la cité noire. Si ça se trouve, au fond, vous cherchez peut-être volontairement toute cette attention.');
INSERT INTO "item_descriptions" VALUES(11543,'fr','On vous a vendu cet anneau comme un objet unique en son genre, qui procurerait des pouvoirs convoités par des chevaucheurs de Dragodindes tout de noir vêtus. Il suffit d''observer les autres aventuriers à Bonta pendant l''heure de pointe pour constater que ce n''est pas le cas.');
INSERT INTO "item_descriptions" VALUES(11544,'fr','A première vue, cet anneau a l''air extrêment inconfortable voire même dangereux pour vos petits doigts. A bien y regarder de plus près : c''est le cas.');
INSERT INTO "item_descriptions" VALUES(11545,'fr','Cette ceinture vous permet, certes, de dissimuler efficacement votre postérieur; mais peut également être portée comme un couvre-chef pour vos soirées mondaines.');
INSERT INTO "item_descriptions" VALUES(11546,'fr','Sertie d''un oeil de démon, cette amulette à la forme originale vous embrochera dès que vous vous mettrez à courir. Une sorte de vengence de la part du démon qui vous rappellera sans cesse que toute action engendre une réaction.');
INSERT INTO "item_descriptions" VALUES(11547,'fr','Ces bottes sentent le souffre et le fromage. En plus de vous procurer de la puissance, elles dissimuleront vos odeurs de pieds, c''est tout bénef'' !');
INSERT INTO "item_descriptions" VALUES(11548,'fr','Qu''Tan se servait de ces cornes afin de punir ses sujets quand ils revenaient bredouille de la chasse, ou plutôt "brocouille" comme on dit dans le coin.');
INSERT INTO "item_descriptions" VALUES(11554,'fr','Inspirée par la légendaire Dragodinde en armure, ce spécimen rare de Dragoune en armure veut lui aussi entrer dans la légende... et peut-être même, voler la vedette à son aînée !');
INSERT INTO "item_descriptions" VALUES(10000003,'fr','Inspirée par la légendaire Dragodinde en armure, ce spécimen rare de Dragoune en armure veut lui aussi entrer dans la légende... et peut-être même, voler la vedette à son aînée !');
INSERT INTO "item_descriptions" VALUES(11555,'fr','Impossible de passer inaperçu avec ce casque sur la tête : les vieux de la vieille, les vrais de vrais, reconnaîtront aussitôt votre valeur, votre goût incontestable et surtout l''apparence de la célèbre Dragodinde en armure.');
INSERT INTO "item_descriptions" VALUES(11556,'fr','Forgé à partir de la même cuirasse que celle arborée par la célèbre Dragodinde en armure, ce bouclier freinera considérablement les attaques de votre adversaire, mais jamais votre ardeur sauvage.');
INSERT INTO "item_descriptions" VALUES(11557,'fr','Elle flotte au vent, avec la même magnificence que la Dragodinde en armure qui l''a inspirée. La cape Dragarmure vous donnera l''impression de voler. Veillez toutefois à redescendre sur terre au moment de combattre...');
INSERT INTO "item_descriptions" VALUES(11621,'fr','Façonné à partir d''une écaille de Grozilla, ce lourd bouclier est d''une prestance exceptionnelle. Seuls de rares et redoutables combattants arborent fièrement ce pavois, en plus, celui-ci est particulièrement coloré.');
INSERT INTO "item_descriptions" VALUES(11702,'fr','On raconte que cette Dragoune en avait marre d''être comparé aux fesses roses d''une femelle Bwork et voulait se différencier de ses confrères. C''est pour cela qu''elle s''est enfuit sur l''Île de Moon pour prendre un bon bain de soleil loin de tout. Regardez-là maintenant avec son nouveau teint de vrai dragon flamboyant !');
INSERT INTO "item_descriptions" VALUES(10000061,'fr','On raconte que cette Dragoune en avait marre d''être comparé aux fesses roses d''une femelle Bwork et voulait se différencier de ses confrères. C''est pour cela qu''elle s''est enfuit sur l''Île de Moon pour prendre un bon bain de soleil loin de tout. Regardez-là maintenant avec son nouveau teint de vrai dragon flamboyant !');
INSERT INTO "item_descriptions" VALUES(11703,'fr','Ce chapeau festif vous rappelle un rêve très étrange que vous aviez fait il y a déjà deux ans. Comme quoi, vous avez bonne mémoire quand vous y mettez du vôtre !');
INSERT INTO "item_descriptions" VALUES(11708,'fr','Elles vous font tourner la tête, occupent vos pensées nuit et jour. Les ogrines ! Aussi déterminé(e) que le familier qui les renifle à des kilokamètres à la ronde, vous avez à présent l''honneur de lui ressembler.');
INSERT INTO "item_descriptions" VALUES(11709,'fr','Aussi transparente que vos intentions (à savoir dénicher un max d''ogrines !), cet accessoire du plus bel effet reflète votre passion pour les larmes d''ogre précieuses. En plus, elle a des grelots.');
INSERT INTO "item_descriptions" VALUES(11710,'fr','Fait de véritables larmes d''ogre naturelles, ce bouclier ne sera néanmoins pas suffisant pour vous sauver face à l''une de ses créatures. Cela dit, il vous protégera de ses gigantesques postillons en cas d''éternuement.');
INSERT INTO "item_descriptions" VALUES(11711,'fr','Un problème, un bug ? Un aventurier malin vous a donné 10% de vos kamas ? Pas de panique ! Vous n''avez pas besoin de contacter le support Ankama car le Miniduk sera là pour vous guider mais aussi sécher vos larmes tout au long de votre aventure dans le Monde des Douze.');
INSERT INTO "item_descriptions" VALUES(10000082,'fr','Un problème, un bug ? Un aventurier malin vous a donné 10% de vos kamas ? Pas de panique ! Vous n''avez pas besoin de contacter le support Ankama car le Miniduk sera là pour vous guider mais aussi sécher vos larmes tout au long de votre aventure dans le Monde des Douze.');
INSERT INTO "item_descriptions" VALUES(10000083,'fr','Un problème, un bug ? Un aventurier malin vous a donné 10% de vos kamas ? Pas de panique ! Vous n''avez pas besoin de contacter le support Ankama car le Miniduk sera là pour vous guider mais aussi sécher vos larmes tout au long de votre aventure dans le Monde des Douze.');
INSERT INTO "item_descriptions" VALUES(10000084,'fr','Un problème, un bug ? Un aventurier malin vous a donné 10% de vos kamas ? Pas de panique ! Vous n''avez pas besoin de contacter le support Ankama car le Miniduk sera là pour vous guider mais aussi sécher vos larmes tout au long de votre aventure dans le Monde des Douze.');
INSERT INTO "item_descriptions" VALUES(10000085,'fr','Un problème, un bug ? Un aventurier malin vous a donné 10% de vos kamas ? Pas de panique ! Vous n''avez pas besoin de contacter le support Ankama car le Miniduk sera là pour vous guider mais aussi sécher vos larmes tout au long de votre aventure dans le Monde des Douze.');
INSERT INTO "item_descriptions" VALUES(11712,'fr','Aucun pirate n''a réussi à toucher ce chapeau lors d''un combat à l''épée dû à l''agilité et la souplesse des porteurs vêtus de ce magnifique tricorne. Si par malheur quelqu''un arrive à lui poser ne serait-ce qu''une simple égratignure, le porteur s''en verra maudit jusqu''à la fin de ses jours et ne sera plus digne de porter ce dernier.');
INSERT INTO "item_descriptions" VALUES(11713,'fr','Le Manteau de Pirate aussi appelé "Le trophée des milles batailles" est le symbole d''une grande prouesse, celle d''avoir triomphé d''au moins autant de batailles en pleine mer. Il vaut mieux y réfléchir à deux fois avant de s''attaquer à ce genre de pirate ! On raconte que porter ce manteau alors que la prouesse n''a pas été conquise, provoque un mal de mer plutôt désagréable... À vos risques et périls matelots !');
INSERT INTO "item_descriptions" VALUES(11714,'fr','Est-ce un bouclier ? ... Un fourreau ? ... Ou tout simplement les deux ! L''utilisation multiple de ce resplendissant Écu de Pirate vous permettra de non seulement bloquer les coups les plus redoutables de vos adversaires mais aussi de ranger vos armes les plus tranchantes.');
INSERT INTO "item_descriptions" VALUES(11715,'fr','La pilosité de cette adorable créature semble lui causer des problèmes de vue. Obnubilée par les flibustiers en tout genre, elle voit en vous l''un(e) des ses plus éminent(e)s représentant(e)s. On vous avait bien dit qu''elle voyait mal. Ce familier dévoreur d''âmes ne mange que des Pirates.');
INSERT INTO "item_descriptions" VALUES(11717,'fr','Quand vous portez ce bonnet, on ne peut pas vraiment dire que ce qu''il y a sous ce sapin là soit un cadeau.');
INSERT INTO "item_descriptions" VALUES(11719,'fr','Vous entendez cette clochette ? Vous entendez les bruissements des pas dans la neige ? C''est nowel, et ce familier est là pour vous le rappeler !');
INSERT INTO "item_descriptions" VALUES(10000049,'fr','Vous entendez cette clochette ? Vous entendez les bruissements des pas dans la neige ? C''est nowel, et ce familier est là pour vous le rappeler !');
INSERT INTO "item_descriptions" VALUES(11724,'fr','Tout droit revenu des Champs de glace en chasse-neige, ce bouclier montre vos prouesses d''apprenti skieur de l''Île de Nowel.');
INSERT INTO "item_descriptions" VALUES(11725,'fr','En portant ce sac à dos, vous ne portez pas qu''un simple sac à dos, vous portez un simple sac à dos qui porte une simple paire de skis.');
INSERT INTO "item_descriptions" VALUES(11726,'fr','"Aventurier, en ville ou en sport d''hiver, vous n''aurez jamais froids aux oreilles grâce à ce bonnet." Ça reste difficile de croire à ce slogan avec les oreilles qui dépasse, mais bon... On raconte que c''est la vérité, satisfait ou pas remboursé !');
INSERT INTO "item_descriptions" VALUES(11727,'fr','L''Oursolaire à toujours été fidèle au Papa Nowel et vous sera fidèle aussi. Grâce à sa fourrure si duveteuse, vous n''aurez jamais froid même sur les îles les plus glaciales. Grattez-lui le ventre de temps en temps pour réchauffer son corps.');
INSERT INTO "item_descriptions" VALUES(11729,'fr','Ne vous fiez pas à cette bouille si mignonne, les Shushus sont généralement des êtres sanguinaires, effrayants et cruels. Il serait donc préférable pour vous de ne pas utiliser ce familier comme objet de réconfort lors de vos longues nuits d''hiver. On ne sait pas de quelle partie du corps il pourrait vouloir vous amputer.');
INSERT INTO "item_descriptions" VALUES(11732,'fr','L''écu qui pète, s''ils s''y mettent tous, ça va faire beaucoup. Telles furent les paroles d''Halden le Sram lorsqu''il terrassa le Minotoboule de Nowel qui terrorisait le village d''Amakna.');
INSERT INTO "item_descriptions" VALUES(11733,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(11734,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(11735,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(11747,'fr','Cette coiffe symbolise l''amour. L''amour de la guerre. L''amour des cris de douleur de vos victimes. L''amour d''humilier les plus faibles que soi. En résumé : l''amour inconditionnel qui lie tout Iop, qu''il le soit de cœur ou de sang, à la bagarre avec un grand « B » comme dans « baston ». Tout cela est terriblement romantique, n''est-ce pas... ?');
INSERT INTO "item_descriptions" VALUES(11748,'fr','Porter une cape donne toujours un petit côté classe, presque héroïque, vous ne trouvez pas ? Bon, hormis lorsque vous vous prenez les pieds dedans ou qu''elle recouvre votre visage après une rafale de vent. Rhooo, mais faites un effort, aussi !');
INSERT INTO "item_descriptions" VALUES(11749,'fr','Les Iops qui savent se servir de leur tête autrement que pour donner des coups remarqueront la subtilité de ce bouclier : il permet à son propriétaire de se protéger, mais aussi de couper d''impeccables tranches de saucisson de porkass grâce à ses lames finement aiguisées. Malin... Accessoirement, il fait aussi de vilains bobos à l''ennemi.');
INSERT INTO "item_descriptions" VALUES(11750,'fr','Quand vous avez un coup de sang, ça part tout de suite en effusion. En plus d''épancher votre soif de vaincre, ce bouclier répandra le sang de vos adversaires, tout en vous protégeant des éclaboussures. Pratique, non ? En plus, le rouge lui va à merveille.');
INSERT INTO "item_descriptions" VALUES(11751,'fr','Roi de l''esbrouffe, reine de la duperie : ce bouclier colorable se destine à ceux dans les yeux desquels il est impossible de lire. Vous êtes particulièrement doué(e) pour brouiller les cartes ? Vous êtes capable d''esquiver une attaque tout en semant le trouble dans l''esprit de votre adversaire ? Décidément, quel(le) as vous faites...');
INSERT INTO "item_descriptions" VALUES(11752,'fr','Un foulard pour celles et ceux qui ont l''art et la manière de tout contester, puis se cachent pour mieux accuser leur voisin. Malin...');
INSERT INTO "item_descriptions" VALUES(11753,'fr','Inspirée du Maître Pandore en personne, cette cape est tellement vicieuse qu''elle est capable de mettre des coups de couteau dans le dos de son propre propriétaire. Admirez la fourberie de la chose...');
INSERT INTO "item_descriptions" VALUES(11754,'fr','Un bouclier pour s''offrir et accorder à l''adversaire un court instant de répit avant de retourner défendre sa chair et ses idéaux.');
INSERT INTO "item_descriptions" VALUES(11755,'fr','Ce familier vous défendra mieux que personne. Il vous défendra même mieux que vous-même ne sauriez le faire. Il va sans dire qu''il se défendra mieux que vous ne pourriez le défendre. Il paraît même qu''il sait mieux défendre vos idées et convictions que vous ne le feriez. Bref, vous l''aurez compris : n''importe qui semble bien minable face à ce petit panda armé (vous y compris, mais peu importe, du moment qu''il vous sauve la peau). Ce familier dévoreur d''âmes ne mange que des Pandits.');
INSERT INTO "item_descriptions" VALUES(10000058,'fr','Ce familier vous défendra mieux que personne. Il vous défendra même mieux que vous-même ne sauriez le faire. Il va sans dire qu''il se défendra mieux que vous ne pourriez le défendre. Il paraît même qu''il sait mieux défendre vos idées et convictions que vous ne le feriez. Bref, vous l''aurez compris : n''importe qui semble bien minable face à ce petit panda armé (vous y compris, mais peu importe, du moment qu''il vous sauve la peau). Ce familier dévoreur d''âmes ne mange que des Pandits.');
INSERT INTO "item_descriptions" VALUES(11756,'fr','Les rouages du temps ont cela d''impénétrable qu''un repas de famille de deux heures peut vous paraître interminable tandis qu''une partie de Chinq de 20 minutes beaucoup trop courte. Avec ce bouclier muni d''une aiguille tranchante, là au moins, le ressenti sera toujours le même : ça va piquer et vos ennemis reposeront en Externam pour l''éternité...');
INSERT INTO "item_descriptions" VALUES(11757,'fr','Les protecteurs dans l''âme, ceux prêts à tous les sacrifices et à encaisser les coups pour la vie d''autrui, le savent bien : certaines attaques, plus virulentes, méritent une réponse d''une autre ampleur. Le Bouclier Jyde est un rempart quasi impossible à franchir, capable de couvrir vos arrières... mais aussi vos devants et vos côtés, ce qui est plutôt appréciable !');
INSERT INTO "item_descriptions" VALUES(11758,'fr','Le clou de cette panoplie, c''est cette coiffe qui vous donne cet air cool, serein, pépère, dont personne ne se méfie... Et là, bim !!! Vous attaquez ! (Vous commencez à comprendre...)');
INSERT INTO "item_descriptions" VALUES(11759,'fr','Encore plus ancienne que Grand Pa Wabbit lui-même, qui la tiendrait de son arrière-grand-tante, cette cape est sans égal pour résister aux affres du temps.');
INSERT INTO "item_descriptions" VALUES(11760,'fr','Ne vous méprenez pas : avoir un trou au beau milieu de son bouclier, c''est stratégique ! Ça permet de voir arriver vos adversaires avant de vous enfuir.');
INSERT INTO "item_descriptions" VALUES(11766,'fr','Avec ce bonnet équipé, la chance d''Ecaflip vous sourira toujours... Ou pas du tout, qui sait ? Et puis bon... C''est pas comme si un aventurier devenait riche s''il était vêtu d''un bonnet en forme de tirelire.');
INSERT INTO "item_descriptions" VALUES(11771,'fr','Assez de sucre pour donner le diabète à un Trooll.');
INSERT INTO "item_descriptions" VALUES(11772,'fr','Sous cet imposant couvre-chef, certains penseront peut-être que vous essayez de dissimuler une gueule de bois. Vrai ou pas, au moins, on vous laissera tranquille.');
INSERT INTO "item_descriptions" VALUES(11773,'fr','La légende autour de cette cape voudrait que ceux qui cassent du bois dans votre dos finissent par s''en mordre les doigts. Ça peut se vérifier...');
INSERT INTO "item_descriptions" VALUES(11774,'fr','Malgré les insultes et les brimades les plus virulentes, ce bouclier vous aidera à rester de bois en toute circonstance.');
INSERT INTO "item_descriptions" VALUES(11775,'fr','Petit guerrier stoïque, Minipoth est monoexpressif. Vous le câlinez, ça le laisse de bois. Vous le disputez parce qu''il n''a pas débarrassé la table, il reste de bois. Vous menacez de l''abandonner, il part couper du bois... Cela peut être déstabilisant. 
Pourtant, vous devez savoir que tous ces signaux... enfin, « ce » signal est la seule chose qu''il puisse faire pour vous faire comprendre qu''il vous aime plus que tout au monde.');
INSERT INTO "item_descriptions" VALUES(10000056,'fr','Petit guerrier stoïque, Minipoth est monoexpressif. Vous le câlinez, ça le laisse de bois. Vous le disputez parce qu''il n''a pas débarrassé la table, il reste de bois. Vous menacez de l''abandonner, il part couper du bois... Cela peut être déstabilisant. 
Pourtant, vous devez savoir que tous ces signaux... enfin, « ce » signal est la seule chose qu''il puisse faire pour vous faire comprendre qu''il vous aime plus que tout au monde.');
INSERT INTO "item_descriptions" VALUES(11781,'fr','Un petit familier mû par de grandes valeurs. Êtes-vous bien certain(e) d''en être digne... ? Rhoo, mais oui, c''était pour vous taquiner.');
INSERT INTO "item_descriptions" VALUES(10000024,'fr','Un petit familier mû par de grandes valeurs. Êtes-vous bien certain(e) d''en être digne... ? Rhoo, mais oui, c''était pour vous taquiner.');
INSERT INTO "item_descriptions" VALUES(10000025,'fr','Un petit familier mû par de grandes valeurs. Êtes-vous bien certain(e) d''en être digne... ? Rhoo, mais oui, c''était pour vous taquiner.');
INSERT INTO "item_descriptions" VALUES(10000026,'fr','Un petit familier mû par de grandes valeurs. Êtes-vous bien certain(e) d''en être digne... ? Rhoo, mais oui, c''était pour vous taquiner.');
INSERT INTO "item_descriptions" VALUES(10000027,'fr','Un petit familier mû par de grandes valeurs. Êtes-vous bien certain(e) d''en être digne... ? Rhoo, mais oui, c''était pour vous taquiner.');
INSERT INTO "item_descriptions" VALUES(10000028,'fr','Un petit familier mû par de grandes valeurs. Êtes-vous bien certain(e) d''en être digne... ? Rhoo, mais oui, c''était pour vous taquiner.');
INSERT INTO "item_descriptions" VALUES(11804,'fr','Après des années à voir ses enfants engloutis sur l''île de Moon, Iop a décidé de renverser la tendance et d''apprivoiser le Gloutovore. Malgré son air mignon, il se nourrit de ses congénères... C''est tout de même mieux que se nourrir de Iops ! Ce dévoreur d''âmes mange les dépouilles des créatures de l''île de Moon.');
INSERT INTO "item_descriptions" VALUES(11809,'fr','N''est-il pas mignon ? Armé jusqu''au dents, certes, mais pouvez-vous en attendre autrement d''un petit allié de Iop ? En attendant, vous en êtes l''heureux propriétaire maintenant, alors faites lui plaisir : montrez lui ce que c''est de la vraie baston !');
INSERT INTO "item_descriptions" VALUES(10000034,'fr','N''est-il pas mignon ? Armé jusqu''au dents, certes, mais pouvez-vous en attendre autrement d''un petit allié de Iop ? En attendant, vous en êtes l''heureux propriétaire maintenant, alors faites lui plaisir : montrez lui ce que c''est de la vraie baston !');
INSERT INTO "item_descriptions" VALUES(10000035,'fr','N''est-il pas mignon ? Armé jusqu''au dents, certes, mais pouvez-vous en attendre autrement d''un petit allié de Iop ? En attendant, vous en êtes l''heureux propriétaire maintenant, alors faites lui plaisir : montrez lui ce que c''est de la vraie baston !');
INSERT INTO "item_descriptions" VALUES(10000036,'fr','N''est-il pas mignon ? Armé jusqu''au dents, certes, mais pouvez-vous en attendre autrement d''un petit allié de Iop ? En attendant, vous en êtes l''heureux propriétaire maintenant, alors faites lui plaisir : montrez lui ce que c''est de la vraie baston !');
INSERT INTO "item_descriptions" VALUES(10000037,'fr','N''est-il pas mignon ? Armé jusqu''au dents, certes, mais pouvez-vous en attendre autrement d''un petit allié de Iop ? En attendant, vous en êtes l''heureux propriétaire maintenant, alors faites lui plaisir : montrez lui ce que c''est de la vraie baston !');
INSERT INTO "item_descriptions" VALUES(10000038,'fr','N''est-il pas mignon ? Armé jusqu''au dents, certes, mais pouvez-vous en attendre autrement d''un petit allié de Iop ? En attendant, vous en êtes l''heureux propriétaire maintenant, alors faites lui plaisir : montrez lui ce que c''est de la vraie baston !');
INSERT INTO "item_descriptions" VALUES(11812,'fr','S''il lui arrive de sortir les griffes ou les crocs, il semble tout naturel qu''Osamodas sorte aussi les défenses... pour se défendre. Certains voient en ce bouclier un furieux porkass, d''autres un minotoror en train de charger. D''autres encore font volte-face sans se poser de questions.');
INSERT INTO "item_descriptions" VALUES(12150,'fr','Ce bouclier vous protège autant qu''il vous couvre de gloire. Même si la défense n''est pas la stratégie préférée de Iop, il admet qu''elle peut être utile, parfois.');
INSERT INTO "item_descriptions" VALUES(12650,'fr','Une épée à la hauteur de vos faits d''armes lors du banquet de Iop, elle est certainement plus affutée que vos amis Iop, quoiqu''en pense leur Dieu.');
INSERT INTO "item_descriptions" VALUES(12651,'fr','Cette médaille vous récompense pour vos efforts. Iop a bien remarqué que la castagne, c''était votre truc, et a tenu à vous l''offrir pour vous encourager à continuer dans cette voie qui lui est chère.');
INSERT INTO "item_descriptions" VALUES(12652,'fr','Grâce à cette anneau, votre poing est aussi une arme. Pour Iop, il faut toujours être prêt à vous battre, même si vous avez laissé votre épée à la taverne.');
INSERT INTO "item_descriptions" VALUES(12653,'fr','Grâce à cette alliance, votre poing est aussi une arme. Pour Iop, il faut toujours être prêt à vous battre, même si vous avez laissé votre épée à la taverne.');
INSERT INTO "item_descriptions" VALUES(12654,'fr','Des bottes bien robustes renforcées par un métal précieux, pour botter le plus efficacement possible le derrière de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(12655,'fr','Une épée à la hauteur de vos faits d''armes lors du banquet de Iop, elle est certainement plus affutée que vos amis Iop, quoiqu''en pense leur Dieu.');
