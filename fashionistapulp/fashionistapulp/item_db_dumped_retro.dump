INSERT INTO "item_descriptions" VALUES(1125,'fr','Cet arc peu conventionnel fut conçu spécialement pour le roi auto proclamé d''un village de paysans, qui adorait faire son show en tirant deux flèches simultanément.');
INSERT INTO "item_descriptions" VALUES(1126,'fr','Cet arc peu conventionnel fut conçu spécialement pour le roi auto proclamé d''un village de paysans, qui adorait se faire remarquer en tirant deux flèches simultanément.');
INSERT INTO "item_descriptions" VALUES(1127,'fr','Cet arc peu conventionnel fut conçu spécialement pour le roi auto proclamé d''un village de paysans, qui adorait se faire remarquer en tirant deux flèches simultanément.');
INSERT INTO "item_descriptions" VALUES(1128,'fr','Cet arc peu conventionnel fut conçu spécialement pour le roi auto proclamé d''un village de paysans, qui adorait se faire remarquer en tirant deux flèches simultanément.');
INSERT INTO "item_descriptions" VALUES(1131,'fr','Cette lourde baguette a fracassé plus d''un crâne de pécheur. Les prêtres Iop l''utilisant pour absoudre radicalement et définitivement un repenti.');
INSERT INTO "item_descriptions" VALUES(1132,'fr','Cette œuvre d''art symbolise l''alliance de la pureté... et de la stupidité. Son créateur devait l''être un peu aussi, car il lui conféra d''énormes pouvoirs magiques.');
INSERT INTO "item_descriptions" VALUES(1133,'fr','L''émancipation des ménagères Eniripsa de moins de 50 ans commença grâce à cette baguette: redoutable à la fois pour les monstres et pour la poussière. Pratique non ?');
INSERT INTO "item_descriptions" VALUES(1134,'fr','L''émancipation des ménagères Eniripsa de moins de 50 ans commença grâce à cette baguette: redoutable à la fois pour les monstres et pour la poussière. Pratique non ?');
