INSERT INTO "item_descriptions" VALUES(1068,'de','Dieser Streithammer ist besonders für die Zerschlagung von Sphären geeignet. Als zusätzlicher Effekt wird der Träger auch sehr wetterfühlig. Doch seinen Schöpfer konnte diese Eigenschaft nicht schützen; er wurde von einem Blitz erschlagen. Erst sehr viel später fand man heraus, dass der Hammer Schläge jeder Art und insbesondere Blitzschläge anzuziehen scheint.');
INSERT INTO "item_descriptions" VALUES(1069,'de','Dieser Streithammer ist besonders für die Zerschlagung von Sphären geeignet. Als zusätzlicher Effekt wird der Träger auch sehr wetterfühlig. Doch seinen Schöpfer konnte diese Eigenschaft nicht schützen; er wurde von einem Blitz erschlagen. Erst sehr viel später fand man heraus, dass der Hammer Schläge jeder Art und insbesondere Blitzschläge anzuziehen scheint.');
