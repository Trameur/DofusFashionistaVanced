INSERT INTO "item_descriptions" VALUES(1120,'en','The instructions for the making of this 100% biodegradable bow have been found in the ruins of Din by an adventurer apparently renowned for his mastery of the whip. I never trusted those Greenies... Many die each year in passionate and misguided embraces with sleeping Treechnids.');
INSERT INTO "item_descriptions" VALUES(1121,'en','Take an old worn bow, dust it with magical cure, ask a dragon to blow on it and you''ll have an enchanted bow. Be careful however, theorizing with fairy recipes is all very well, but in practice, dragons take a malicious pleasure in blowing on everything but the bow.');
INSERT INTO "item_descriptions" VALUES(1122,'en','Take an old worn bow, dust it with magical cure, ask a dragon to blow on it and you''ll have an enchanted bow. Be careful however, theorizing with fairy recipes is all very well, but in practice, dragons take a malicious pleasure in blowing on everything but the bow.');
