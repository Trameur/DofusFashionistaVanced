INSERT INTO "item_descriptions" VALUES(1046,'fr','Quoi de mieux qu''une pelle écologique pour mettre un terme aux mauvaises herbes ? Cette pelle est la réponse, avec elle vous pourrez aisément arracher des pissenlits et les faire manger à vos ennemis, en commençant par la racine !');
INSERT INTO "item_descriptions" VALUES(1047,'fr','Quoi de mieux qu''une pelle écologique pour mettre un terme aux mauvaises herbes ? Cette pelle est LA réponse, avec elle vous pourrez aisément arracher des pissenlits et les faire manger à vos ennemis, en commençant par la racine !');
INSERT INTO "item_descriptions" VALUES(1048,'fr','Quoi de mieux qu''une pelle écologique pour mettre un terme aux mauvaises herbes ? Cette pelle est LA réponse, avec elle vous pourrez aisément arracher des pissenlits et les faire manger à vos ennemis, en commençant par la racine !');
INSERT INTO "item_descriptions" VALUES(1049,'fr','Quoi de mieux qu''une pelle écologique pour mettre un terme aux mauvaises herbes ? Cette pelle est LA réponse, avec elle vous pourrez aisément arracher des pissenlits et les faire manger à vos ennemis, en commençant par la racine !');
INSERT INTO "item_descriptions" VALUES(1050,'fr','Cette pelle fut créée et utilisée par la famille Woukuis dans la guerre intestine entre les groupes Elle-Poma et Touge-Woukuis, concurrents directs d''exportation de tofus grillés. C''est une arme redoutable, son seul défaut est de rendre les mains grasses.');
INSERT INTO "item_descriptions" VALUES(1051,'fr','Cette pelle fut créée et utilisée par la famille Woukuis dans la guerre intestine entre les groupes Elle-Poma et Touge-Woukuis, concurrents directs d''exportation de tofus grillés. C''est une arme redoutable, son seul défaut est de rendre les mains grasses.');
INSERT INTO "item_descriptions" VALUES(1052,'fr','Cette pelle fut créée et utilisée par la famille Woukuis dans la guerre intestine entre les groupes Elle-Poma et Touge-Woukuis, concurrents directs d''exportation de tofus grillés. C''est une arme redoutable, son seul défaut est de rendre les mains grasses.');
INSERT INTO "item_descriptions" VALUES(1053,'fr','Cette pelle fut créée et utilisée par la famille Woukuis dans la guerre intestine entre les groupes Elle-Poma et Touge-Woukuis, concurrents directs d''exportation de tofus grillés. C''est une arme redoutable, son seul défaut est de rendre les mains grasses.');
INSERT INTO "item_descriptions" VALUES(1054,'fr','Croisement entre une pelle et une truelle, la pelle-truelle perdit son caractère utile pour devenir une arme incontournable. Rapide à manier et à ranger grâce à sa petite taille, c''est l''accessoire idéal de tout Enutrof aimant l''alcool.');
INSERT INTO "item_descriptions" VALUES(1055,'fr','Les habitants de l''île Koutoulou fabriquent artisanalement ces pelles affreuses avec du bric et du broc (surtout du broc). Pitoyables pour creuser, elles sont uniquement destinées à faire peur aux esprits et aux enfants pas assez sages.');
INSERT INTO "item_descriptions" VALUES(1056,'fr','Les habitants de l''île Koutoulou fabriquent artisanalement ces pelles affreuses avec du bric et du broc (surtout du broc). Pitoyables pour creuser, elles sont uniquement destinées à faire peur aux esprits et aux enfants pas assez sages.');
INSERT INTO "item_descriptions" VALUES(1057,'fr','Les habitants de l''île Koutoulou fabriquent artisanalement ces pelles affreuses avec du bric et du broc (surtout du broc). Pitoyables pour creuser, elles sont uniquement destinées à faire peur aux esprits et aux enfants pas assez sages.');
INSERT INTO "item_descriptions" VALUES(1058,'fr','Les habitants de l''île Koutoulou fabriquent artisanalement ces pelles affreuses avec du bric et du broc (surtout du broc). Pitoyables pour creuser, elles sont uniquement destinées à faire peur aux esprits et aux enfants pas assez sages.');
INSERT INTO "item_descriptions" VALUES(1059,'fr','Cette pelle est la petite favorite des cultivateurs de champs, surtout de pomme de tewe. Rien ne vous empêche cependant de retourner d''autres types de patate avec.');
INSERT INTO "item_descriptions" VALUES(1060,'fr','Une des armes fétiches créées par Ha. Cette masse, à l''aérodynamisme calculé, fend deux fois plus vite l''air, et donc deux fois plus vite les crânes. Au moins deux bonnes raisons pour posséder cette arme.');
INSERT INTO "item_descriptions" VALUES(1061,'fr','Une des armes fétiches créées par Ha. Cette masse, à l''aérodynamisme calculé, fend deux fois plus vite l''air, et donc deux fois plus vite les crânes. Au moins deux bonnes raisons pour posséder cette arme.');
INSERT INTO "item_descriptions" VALUES(1062,'fr','Une des armes fétiches créées par Ha. Cette masse, à l''aérodynamisme calculé, fend deux fois plus vite l''air, et donc deux fois plus vite les crânes. Au moins deux bonnes raisons pour posséder cette arme.');
INSERT INTO "item_descriptions" VALUES(1063,'fr','Une des armes fétiches créées par Ha. Cette masse, à l''aérodynamisme calculé, fend deux fois plus vite l''air, et donc deux fois plus vite les crânes. Au moins deux bonnes raisons pour posséder cette arme.');
INSERT INTO "item_descriptions" VALUES(1064,'fr','On dit que ce marteau est une pièce unique, car fabriqué de façon artisanale par d''anciens forgeurs Xelor. Certains racontent cependant qu''il s''agirait d''une lettre composant l''enseigne d''un forgeron. Testez-le donc sur une tête et faites votre choix.');
INSERT INTO "item_descriptions" VALUES(1065,'fr','On dit que ce marteau est une pièce unique, car fabriqué de façon artisanale par d''anciens forgeurs Xelor. Certains racontent cependant qu''il s''agirait d''une lettre composant l''enseigne d''un forgeron. Testez-le donc sur une tête et faites votre choix.');
INSERT INTO "item_descriptions" VALUES(1066,'fr','On dit que ce marteau est une pièce unique, car fabriqué de façon artisanale par d''anciens forgeurs Xelor. Certains racontent cependant qu''il s''agirait d''une lettre composant l''enseigne d''un forgeron. Testez-le donc sur une tête et faites votre choix.');
INSERT INTO "item_descriptions" VALUES(1067,'fr','On dit que ce marteau est une pièce unique, car fabriqué de façon artisanale par d''anciens forgeurs Xelor. Certains racontent cependant qu''il s''agirait d''une lettre composant l''enseigne d''un forgeron. Testez-le donc sur une tête et faites votre choix.');
INSERT INTO "item_descriptions" VALUES(1068,'fr','Cette masse permet à son porteur de connaître le temps qu''il fera. Du moins, son inventeur le pensait-il avant de mourir foudroyé. On s''aperçut bien plus tard que cette masse était aussi habile à recevoir les coups qu''à les distribuer.');
INSERT INTO "item_descriptions" VALUES(1069,'fr','Cette masse permet à son porteur de connaître le temps qu''il fera. Du moins, son inventeur le pensait-il avant de mourir foudroyé. On s''aperçut bien plus tard que cette masse était aussi habile à recevoir les coups qu''à les distribuer.');
INSERT INTO "item_descriptions" VALUES(1070,'fr','Cette masse permet à son porteur de connaître le temps qu''il fera. Du moins, son inventeur le pensait-il avant de mourir foudroyé. On s''aperçut bien plus tard que cette masse était aussi habile à recevoir les coups qu''à les distribuer.');
INSERT INTO "item_descriptions" VALUES(1071,'fr','Cette masse permet à son porteur de connaître le temps qu''il fera. Du moins, son inventeur le pensait-il avant de mourir foudroyé. On s''aperçut bien plus tard que cette masse était aussi habile à recevoir les coups qu''à les distribuer.');
INSERT INTO "item_descriptions" VALUES(1072,'fr','Outar Grand Bwork aurait commandé ces marteaux redoutables à un village Xélor contre un traité de paix: s''ils étaient efficaces, le village serait épargné. Quand les marteaux furent livrés, le village fut rasé. Après tout, il fallait bien les essayer !');
INSERT INTO "item_descriptions" VALUES(1073,'fr','Outar Grand Bwork aurait commandé ces marteaux redoutables à un village Xélor contre un traité de paix: s''ils étaient efficaces, le village serait épargné. Quand les marteaux furent livrés, le village fut rasé. Après tout, il fallait bien les essayer !');
INSERT INTO "item_descriptions" VALUES(1074,'fr','Outar Grand Bwork aurait commandé ces marteaux redoutables à un village Xélor contre un traité de paix: s''ils étaient efficaces, le village serait épargné. Quand les marteaux furent livrés, le village fut rasé. Après tout, il fallait bien les essayer !');
INSERT INTO "item_descriptions" VALUES(1075,'fr','Outar Grand Bwork aurait commandé ces marteaux redoutables à un village Xélor contre un traité de paix: s''ils étaient efficaces, le village serait épargné. Quand les marteaux furent livrés, le village fut rasé. Après tout, il fallait bien les essayer !');
INSERT INTO "item_descriptions" VALUES(1076,'fr','Cette masse est l''héritage de l''ancienne tribu pacifique Aj Taye. Cela explique sa principale utilité : en la roulant sur les muscles endoloris la douleur disparaît. Les brutes épaisses vous diront qu''elle marche aussi très bien pour la faire apparaître.');
INSERT INTO "item_descriptions" VALUES(1077,'fr','Cette masse est l''héritage de l''ancienne tribu pacifique Aj Taye. Cela explique sa principale utilité : en la roulant sur les muscles endoloris la douleur disparaît. Les brutes épaisses vous diront qu''elle marche aussi très bien pour la faire apparaître.');
INSERT INTO "item_descriptions" VALUES(1078,'fr','Cette masse est l''héritage de l''ancienne tribu pacifique Aj Taye. Cela explique sa principale utilité : en la roulant sur les muscles endoloris la douleur disparaît. Les brutes épaisses vous diront qu''elle marche aussi très bien pour la faire apparaître.');
INSERT INTO "item_descriptions" VALUES(1079,'fr','Cette masse est l''héritage de l''ancienne tribu pacifique Aj Taye. Cela explique sa principale utilité : en la roulant sur les muscles endoloris la douleur disparaît. Les brutes épaisses vous diront qu''elle marche aussi très bien pour la faire apparaître.');
INSERT INTO "item_descriptions" VALUES(1080,'fr','Ce marteau est tellement ridicule que votre ennemi explosera de rire en vous voyant. Vous donnant juste assez de temps pour l''exploser vraiment.');
INSERT INTO "item_descriptions" VALUES(1081,'fr','Ce marteau est tellement ridicule que votre ennemi explosera de rire en vous voyant. Vous donnant juste assez de temps pour l''exploser vraiment.');
INSERT INTO "item_descriptions" VALUES(1082,'fr','Ce marteau est tellement ridicule que votre ennemi explosera de rire en vous voyant. Vous donnant juste assez de temps pour l''exploser vraiment.');
INSERT INTO "item_descriptions" VALUES(1083,'fr','Ce marteau est tellement ridicule que votre ennemi explosera de rire en vous voyant. Vous donnant juste assez de temps pour l''exploser vraiment.');
INSERT INTO "item_descriptions" VALUES(1084,'fr','Ce terrible marteau vous permettra enfin de prouver que les personnes pensant que le muscle prime sur le cerveau ont tort! (Ceci n''est valable uniquement sur des personnes moins fortes, les autres, n''oubliez pas, ont TOUJOURS raison)');
INSERT INTO "item_descriptions" VALUES(1085,'fr','Les Falistos sont des démons Xélors. Ayant renié leurs anciens principes, ils ont développé leur force en forgeant des marteaux toujours plus puissants. Après avoir apporté le chaos, ils furent battus et bannis sous terre. Mais quelques armes subsistèrent.');
INSERT INTO "item_descriptions" VALUES(1087,'fr','Cet anneau permet d''augmenter légèrement l''intelligence de son porteur.');
INSERT INTO "item_descriptions" VALUES(1088,'fr','Ce masque est la réplique exacte, en un peu plus grand, de ceux que portent fièrement les Kanniboules importants.');
INSERT INTO "item_descriptions" VALUES(1090,'fr','L''Astrocoiffe permet d''avoir une belle coiffe, et c''est déjà pas mal !');
INSERT INTO "item_descriptions" VALUES(1092,'fr','Cet arc est spécialement conçu pour chasser les oiseaux. Léger et facile à manier, il vous permettra de voler dans les plumes de n''importe qui ou presque.');
INSERT INTO "item_descriptions" VALUES(1093,'fr','Cet arc est spécialement conçu pour chasser les oiseaux. Léger et facile à manier, il vous permettra de voler dans les plumes de n''importe qui ou presque.');
INSERT INTO "item_descriptions" VALUES(1094,'fr','Cet arc est spécialement conçu pour chasser les oiseaux. Léger et facile à manier, il vous permettra de voler dans les plumes de n''importe qui ou presque.');
INSERT INTO "item_descriptions" VALUES(1095,'fr','Cet arc est spécialement conçu pour chasser les oiseaux. Léger et facile à manier, il vous permettra de voler dans les plumes de n''importe qui ou presque.');
INSERT INTO "item_descriptions" VALUES(1096,'fr','"Avec un Bouftou, on peut faire tout !" tel était le slogan d''un marchand dont la spécialité était le recyclage de Bouftou. Cet arc est l''un de ses produits. Pas très esthétique, il n''en est pas moins redoutable.');
INSERT INTO "item_descriptions" VALUES(1097,'fr','"Avec un Bouftou, on peut faire tout !" tel était le slogan d''un marchand dont la spécialité était le recyclage de Bouftou. Cet arc est l''un de ses produits, pas très esthétique il n''en est pas moins redoutable.');
INSERT INTO "item_descriptions" VALUES(1098,'fr','"Avec un Bouftou, on peut faire tout !" tel était le slogan d''un marchand dont la spécialité était le recyclage de Bouftou. Cet arc est l''un de ses produits, pas très esthétique il n''en est pas moins redoutable.');
INSERT INTO "item_descriptions" VALUES(1099,'fr','Pour le test uniquement');
INSERT INTO "item_descriptions" VALUES(1101,'fr','L''eniripsa Mie Dopan confectionna cette série de baguettes piquantes pour lutter contre les vols. Capable en théorie de remonter le temps pour empêcher une agression, elle finit généralement dans l''oeil d''un démon.');
INSERT INTO "item_descriptions" VALUES(1102,'fr','L''eniripsa Mie Dopan confectionna cette série de baguettes piquantes pour lutter contre les vols. Capable en théorie de remonter le temps pour empêcher une agression, elle finit généralement dans l''oeil d''un démon.');
INSERT INTO "item_descriptions" VALUES(1103,'fr','L''eniripsa Mie Dopan confectionna cette série de baguettes piquantes pour lutter contre les vols. Capable en théorie de remonter le temps pour empêcher une agression, elle finit généralement dans l''oeil d''un démon.');
INSERT INTO "item_descriptions" VALUES(1104,'fr','L''eniripsa Mie Dopan confectionna cette série de baguettes piquantes pour lutter contre les vols. Capable en théorie de remonter le temps pour empêcher une agression, elle finit généralement dans l''oeil d''un démon.');
INSERT INTO "item_descriptions" VALUES(1105,'fr','Cette lourde baguette a fracassé plus d''un crâne de pécheur. Les prêtres Iop l''utilisant pour absoudre radicalement et définitivement un repenti.');
INSERT INTO "item_descriptions" VALUES(1107,'fr','Cette lourde baguette a fracassé plus d''un crâne de pécheur. Les prêtres Iop l''utilisant pour absoudre radicalement et définitivement un repenti.');
INSERT INTO "item_descriptions" VALUES(1108,'fr','Cette lourde baguette a fracassé plus d''un crâne de pécheur. Les prêtres Iop l''utilisant pour absoudre radicalement et définitivement un repenti.');
INSERT INTO "item_descriptions" VALUES(1109,'fr','Ce bâton est la réplique d''un artefact légendaire, un peu de pouvoir en moins. Capable d''émettre de la lumière lors d''un choc sur le sol (Oh!), de déformer un peu votre voix (Wah!), il vous fera passer pour ce que vous n''êtes pas : un grand mage.');
INSERT INTO "item_descriptions" VALUES(1110,'fr','Ce bâton est la réplique d''un artefact légendaire, un peu de pouvoir en moins. Capable d''émettre de la lumière lors d''un choc sur le sol (Oh!), de déformer un peu votre voix (Wah!), il vous fera passer pour ce que vous n''êtes pas : un grand mage.');
