CREATE TABLE item_descriptions (
            item INTEGER,
            language TEXT,
            description TEXT,
            PRIMARY KEY (item, language),
            FOREIGN KEY (item) REFERENCES items(id)
        );
INSERT INTO "item_descriptions" VALUES(39,'en','This amulet increases the wearer''s intelligence.');
INSERT INTO "item_descriptions" VALUES(40,'en','This basic sword won''t make a hero out of you, that''s for sure!');
INSERT INTO "item_descriptions" VALUES(42,'en','This basic sword won''t make a hero out of you, that''s for sure!');
INSERT INTO "item_descriptions" VALUES(43,'en','This basic sword won''t make a hero out of you, that''s for sure!');
INSERT INTO "item_descriptions" VALUES(44,'en','This basic sword won''t make a hero out of you, that''s for sure!');
INSERT INTO "item_descriptions" VALUES(46,'en','This well-forged sword is ideal for beginners.');
INSERT INTO "item_descriptions" VALUES(47,'en','This well-forged sword is ideal for beginners.');
INSERT INTO "item_descriptions" VALUES(48,'en','This well-forged sword is ideal for beginners.');
INSERT INTO "item_descriptions" VALUES(49,'en','This well-forged sword is ideal for beginners.');
INSERT INTO "item_descriptions" VALUES(51,'en','Forged by a Fencing Master, this sword will make a hero of you if you know how to handle it... However, be careful, the sword comes with a curse - It always falls down a well. Eventually, here or there, it''ll fall down a well. Don''t even try to avoid wells... you could be in a bloody desert and THIS SWORD WOULD FALL DOWN A WELL. Got it?');
INSERT INTO "item_descriptions" VALUES(53,'en','Forged by a Fencing Master, this sword will make a hero of you if you know how to handle it... However, be careful, the sword comes with a curse - It always falls down a well. Eventually, here or there, it''ll fall down a well. Don''t even try to avoid wells... you could be in a bloody desert and THIS SWORD WOULD FALL DOWN A WELL. Got it?');
INSERT INTO "item_descriptions" VALUES(54,'en','Forged by a Fencing Master, this sword will make a hero of you if you know how to handle it... However, be careful, the sword comes with a curse - It always falls down a well. Eventually, here or there, it''ll fall down a well. Don''t even try to avoid wells... you could be in a bloody desert and THIS SWORD WOULD FALL DOWN A WELL. Got it?');
INSERT INTO "item_descriptions" VALUES(55,'en','Forged by a Fencing Master, this sword will make a hero of you if you know how to handle it... However, be careful, the sword comes with a curse - It always falls down a well. Eventually, here or there, it''ll fall down a well. Don''t even try to avoid wells... you could be in a bloody desert and THIS SWORD WOULD FALL DOWN A WELL. Got it?');
INSERT INTO "item_descriptions" VALUES(58,'en','This sword, soaked in a young Boowolf''s tears, is said to bring luck and is supposed to fill warriors with courage on the battlefield. Ah, the naivety of terror.');
INSERT INTO "item_descriptions" VALUES(59,'en','This is an extremely well-forged sword, and will make you a worthy adversary. Your enemies will pant audibly when you enter the arena.');
INSERT INTO "item_descriptions" VALUES(60,'en','This is an extremely well-forged sword, and will make you a worthy adversary. Your enemies will pant audibly when you enter the arena.');
INSERT INTO "item_descriptions" VALUES(61,'en','This is an extremely well-forged sword, and will make you a worthy adversary. Your enemies will pant audibly when you enter the arena.');
INSERT INTO "item_descriptions" VALUES(62,'en','This is an extremely well-forged sword, and will make you a worthy adversary. Your enemies will pant audibly when you enter the arena.');
INSERT INTO "item_descriptions" VALUES(65,'en','The sword Goultard was quenched in the blood of a Dragon Pig. The hero who can resist the sword''s powerful stench will find himself climbing the social ladder very quickly indeed.');
INSERT INTO "item_descriptions" VALUES(66,'en','This sword captures the sights, the sounds and the smells of Badoul, the brave, bloodthirsty and above all punctual warrior who one day quit his clan due to artistic differences.');
INSERT INTO "item_descriptions" VALUES(67,'en','Sharp and diabolical: these were the wide-eyed words of the succubus who fathered this deadly little minx. Minx? Fathered? Damn, that was the page about Vald''s sister. Sorry about that...');
