INSERT INTO "item_descriptions" VALUES(1136,'fr','L''émancipation des ménagères Eniripsa de moins de 50 ans commença grâce à cette baguette: redoutable à la fois pour les monstres et pour la poussière. Pratique non ?');
INSERT INTO "item_descriptions" VALUES(1137,'fr','Houvette inventa ces baguettes pour ramener son mari enutrof du bar où il passait ses journées. Bien utilisées, celles-ci permettaient de redonner du piquant à leur couple, mais nul ne dit comment.');
