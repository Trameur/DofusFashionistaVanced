INSERT INTO "item_descriptions" VALUES(1116,'en','A type of bow only made in the far North of Amakna, the I Kea Bow is a cheap, conveniently flat-packed weapon. Its effectiveness will strongly depend on the owner''s ability to follow poorly translated instruction manuals.');
INSERT INTO "item_descriptions" VALUES(1117,'en','The instructions for the making of this 100% biodegradable bow have been found in the ruins of Din by an adventurer apparently renowned for his mastery of the whip. I never trusted those Greenies... Many die each year in passionate and misguided embraces with sleeping Treechnids.');
INSERT INTO "item_descriptions" VALUES(1118,'en','The instructions for the making of this 100% biodegradable bow have been found in the ruins of Din by an adventurer apparently renowned for his mastery of the whip. I never trusted those Greenies... Many die each year in passionate and misguided embraces with sleeping Treechnids.');
