INSERT INTO "item_descriptions" VALUES(7864,'pt','Este certificado autoriza a usar a montaria do curral. Aviso! Este certificado só é válido durante 20 dias. Uma vez expirado, sua montaria será retomada e seu certificado não terá mais validade. Você não poderá mais montar. Não se esqueça de deixar a sua montaria num curral se for sair por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7865,'pt','Este certificado autoriza você a pegar sua montaria em um galpão. Cuidado! Este certificado será válido por apenas 20 dias. Logo que esse tempo limite acabar, sua montaria será devolvida para a selva e seu certificado não será mais válido. Você não poderá pegar de volta sua montaria. Não se esqueça de deixar sua montaria em um galpão se você precisa ficar fora por um longo período.');
INSERT INTO "item_descriptions" VALUES(7866,'pt','Este certificado lhe autoriza a pegar sua montaria em um celeiro.
Atenção! Este certificado só será válido por 20 dias. Uma vez que o prazo terminar, sua montaria será solta na natureza e o certificado não será mais válido. Você não será capaz de recuperar sua montaria. Não se esqueça de deixar sua montaria em um celeiro se você for se ausentar por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7867,'pt','Este certificado lhe autoriza a pegar a sua montaria no curral.
Advertência! Este certificado será válido por apenas 20 dias. Quando esse tempo estiver acabado, sua montaria será enviada de volta para a natureza e o seu certificado já não será válido. Você não poderá pegar a sua montaria de volta. Não se esqueça de deixar a sua montaria em um curral se for ficar fora por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7868,'pt','Este certificado lhe autoriza a pegar a sua montaria no curral.
