INSERT INTO "item_descriptions" VALUES(12708,'fr','Grâce à cette alliance, votre poing est aussi une arme. Pour Iop, il faut toujours être prêt à vous battre, même si vous avez laissé votre épée à la taverne.');
INSERT INTO "item_descriptions" VALUES(12709,'fr','Des bottes bien robustes renforcées par un métal précieux, pour botter le plus efficacement possible le derrière de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(12710,'fr','Une épée à la hauteur de vos faits d''armes lors du banquet de Iop, elle est certainement plus affutée que vos amis Iop, quoiqu''en pense leur Dieu.');
INSERT INTO "item_descriptions" VALUES(12711,'fr','Cette médaille vous récompense pour vos efforts. Iop a bien remarqué que la castagne, c''était votre truc, et a tenu à vous l''offrir pour vous encourager à continuer dans cette voie qui lui est chère.');
