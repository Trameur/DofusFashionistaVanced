INSERT INTO "item_descriptions" VALUES(11494,'pt','Este chapéu com aparência familiar foi encantado pelo próprio Hel Munster depois de muita insistência por parte de um famoso alfaiate de Astrub. Ele queria criar uma coleção cujas peças se adaptassem às cores de seu dono. Embora tenha sido tingido usando um método secreto, você reconhece o cheiro característico da baba do Milobo... Eca!');
INSERT INTO "item_descriptions" VALUES(11495,'pt','Este chapéu com aparência familiar foi encantado pelo próprio Hel Munster depois de muita insistência por parte de um famoso alfaiate de Astrub. Ele queria criar uma coleção cujas peças se adaptassem às cores de seu dono. Embora tenha sido tingido usando um método secreto, você reconhece o cheiro característico da baba do Milobo... Eca!');
INSERT INTO "item_descriptions" VALUES(11496,'pt','Este chapéu com aparência familiar foi encantado pelo próprio Hel Munster depois de muita insistência por parte de um famoso alfaiate de Astrub. Ele queria criar uma coleção cujas peças se adaptassem às cores de seu dono. Embora tenha sido tingido usando um método secreto, você reconhece o cheiro característico da baba do Milobo... Eca!');
INSERT INTO "item_descriptions" VALUES(11497,'pt','Este chapéu com aparência familiar foi encantado pelo próprio Hel Munster depois de muita insistência por parte de um famoso alfaiate de Astrub. Ele queria criar uma coleção cujas peças se adaptassem às cores de seu dono. Embora tenha sido tingido usando um método secreto, você reconhece o cheiro característico da baba do Milobo... Eca!');
INSERT INTO "item_descriptions" VALUES(11539,'pt','Este arco é feito de material de alta qualidade. Ao ser empunhado, ele libera um grande poder, que também é perceptível nas flechas disparadas.');
INSERT INTO "item_descriptions" VALUES(11542,'pt','Ao vestir este traje, você notará um aumento considerável na quantidade de ciladas, emboscadas e ataques dos bandidos da cidade negra. Vai ver que, no fundo, você quer mesmo essa atenção toda.');
INSERT INTO "item_descriptions" VALUES(11543,'pt','Este anel foi vendido a você como um objeto único, capaz de conceder poderes cobiçados por cavaleiros negros montados em Dragoperus. É só observar os outros aventureiros de Bonta no horário de pico para ver que não é o caso.');
INSERT INTO "item_descriptions" VALUES(11544,'pt','À primeira vista, este anel parece extremamente desconfortável, até perigoso para os seus dedinhos. Se olhar com mais atenção, você verá que é isso mesmo.');
INSERT INTO "item_descriptions" VALUES(11545,'pt','Claro, este cinto esconde bem o seu traseiro, mas também pode ser usado de chapéu nas suas festas.');
INSERT INTO "item_descriptions" VALUES(11546,'pt','Ornado com um olho de demônio, este amuleto de formato original espetará você assim que começar a correr. Uma espécie de vingança da parte do demônio para lembrar o tempo todo que a toda ação corresponde uma reação.');
INSERT INTO "item_descriptions" VALUES(11547,'pt','Questi stivali sanno di zolfo e di formaggio. Oltre a darti potenza, nasconderanno l''odore dei tuoi piedi: davvero una serie completa di vantaggi!');
INSERT INTO "item_descriptions" VALUES(11548,'pt','Qu''Tan usava esses chifres para punir os súditos quando eles voltavam da caça de mãos abanando — ou outras partes abanando, como dizem por aí.');
INSERT INTO "item_descriptions" VALUES(11554,'pt','Inspirada pelo lendário Dragoperu com Armadura, esta espécie rara de Draguna com Armadura também quer ser uma lenda... e, quem sabe, tomar o lugar do irmão mais velho!');
INSERT INTO "item_descriptions" VALUES(10000003,'pt','Inspirada pelo lendário Dragoperu com Armadura, esta espécie rara de Draguna com Armadura também quer ser uma lenda... e, quem sabe, tomar o lugar do irmão mais velho!');
INSERT INTO "item_descriptions" VALUES(11555,'pt','É impossível passar despercebido com este capacete na cabeça: o pessoal das antigas vai reconhecer na hora o seu valor, o seu bom gosto inquestionável e, principalmente, a aparência do famoso Dragoperu com Armadura.');
INSERT INTO "item_descriptions" VALUES(11556,'pt','Forjado a partir da mesma couraça usada pelo famoso Dragoperu com Armadura, este escudo vai segurar os ataques dos adversários, mas não o seu ímpeto selvagem.');
INSERT INTO "item_descriptions" VALUES(11557,'pt','Ela flutua com a mesma imponência do Dragoperu com Armadura que serviu de inspiração para ela. A Capa de Dragarmadura vai fazer você ter a sensação de que está voando. Mas não se esqueça de voltar ao chão para lutar...');
INSERT INTO "item_descriptions" VALUES(11621,'pt','Criado a partir de uma das escamas do Grozilla, esse pesado escudo é muito imponente. Apenas os lutadores mais distintos têm a honra de usá-lo. E ainda por cima é colorido.');
INSERT INTO "item_descriptions" VALUES(11702,'pt','Dizem que esta Draguna já estava cansada de ser comparada ao traseiro rosado das Bworks e queria se destacar das demais. Por isso, ela fugiu para a ilha de Moon a fim de tomar um bom banho de sol longe de tudo. Olha só para ela agora com esse bronze de dragão flamejante!');
INSERT INTO "item_descriptions" VALUES(10000061,'pt','Dizem que esta Draguna já estava cansada de ser comparada ao traseiro rosado das Bworks e queria se destacar das demais. Por isso, ela fugiu para a ilha de Moon a fim de tomar um bom banho de sol longe de tudo. Olha só para ela agora com esse bronze de dragão flamejante!');
INSERT INTO "item_descriptions" VALUES(11703,'pt','Este chapéu festivo lembra um sonho estranhíssimo que você teve há dois anos. Quando quer, sua memória é excelente, né?');
INSERT INTO "item_descriptions" VALUES(11708,'pt','Elas fazem sua cabeça dar voltas, dominam seus pensamentos noite e dia. As ogrinas, é claro! Tão vidrado(a) quanto uma mascote que as fareja à kilokâmetros de distância, agora você pode ter a honra de ficar igual a elas.');
INSERT INTO "item_descriptions" VALUES(11709,'pt','Tão transparente quanto suas intenções (ou seja, conseguir o máximo de ogrinas!), esse acessório sofisticado reflete sua paixão pelas preciosas lágrimas de ogro. E ela tem até sininhos!');
INSERT INTO "item_descriptions" VALUES(11710,'pt','Feito de verdadeiras lágrimas de ogro naturais, esse escudo não será suficiente para salvar você de uma dessas criaturas. Dito isso, ele é perfeito para proteger você dos gigantescos perdigotos durante os terríveis casos de espirros.');
INSERT INTO "item_descriptions" VALUES(11711,'pt','Um problema, um bug? Um aventureiro safado te deu 10% dos seus kamas? Não entre em pânico! Não precisa procurar o suporte da Ankama: o Miniduk está aqui para guiar você e oferecer um ombro amigo nas suas aventuras pelo Mundo dos Doze. (Coloque esta mascote sobre outra mascote que já estiver usando para transmitir sua aparência)');
INSERT INTO "item_descriptions" VALUES(10000082,'pt','Um problema, um bug? Um aventureiro safado te deu 10% dos seus kamas? Não entre em pânico! Não precisa procurar o suporte da Ankama: o Miniduk está aqui para guiar você e oferecer um ombro amigo nas suas aventuras pelo Mundo dos Doze. (Coloque esta mascote sobre outra mascote que já estiver usando para transmitir sua aparência)');
INSERT INTO "item_descriptions" VALUES(10000083,'pt','Um problema, um bug? Um aventureiro safado te deu 10% dos seus kamas? Não entre em pânico! Não precisa procurar o suporte da Ankama: o Miniduk está aqui para guiar você e oferecer um ombro amigo nas suas aventuras pelo Mundo dos Doze. (Coloque esta mascote sobre outra mascote que já estiver usando para transmitir sua aparência)');
INSERT INTO "item_descriptions" VALUES(10000084,'pt','Um problema, um bug? Um aventureiro safado te deu 10% dos seus kamas? Não entre em pânico! Não precisa procurar o suporte da Ankama: o Miniduk está aqui para guiar você e oferecer um ombro amigo nas suas aventuras pelo Mundo dos Doze. (Coloque esta mascote sobre outra mascote que já estiver usando para transmitir sua aparência)');
INSERT INTO "item_descriptions" VALUES(10000085,'pt','Um problema, um bug? Um aventureiro safado te deu 10% dos seus kamas? Não entre em pânico! Não precisa procurar o suporte da Ankama: o Miniduk está aqui para guiar você e oferecer um ombro amigo nas suas aventuras pelo Mundo dos Doze. (Coloque esta mascote sobre outra mascote que já estiver usando para transmitir sua aparência)');
INSERT INTO "item_descriptions" VALUES(11712,'pt','Nenhum pirata nunca conseguiu acertar este chapéu em um duelo de espadas, tamanha a agilidade dos portadores deste magnífico tricórnio. Se alguém der o azar de fazer um simples arranhão nele, o portador será amaldiçoado até o fim de seus dias e não será mais digno de usá-lo.');
INSERT INTO "item_descriptions" VALUES(11713,'pt','O Manto do Pirata, também conhecido como o "troféu das mil batalhas", é símbolo de uma grande proeza: a de ter vencido esse número de batalhas em alto-mar. É melhor pensar duas vezes antes de atacar um pirata assim! Dizem que quem veste este manto antes de realizar a façanha sente enjoo no barco... É por sua própria conta e risco!');
INSERT INTO "item_descriptions" VALUES(11714,'pt','Será um escudo? Uma bainha?... E por que não os dois? Com este Escudo de Pirata resplandecente, você poderá bloquear os golpes mais perigosos do adversário E guardar suas armas mais afiadas.');
INSERT INTO "item_descriptions" VALUES(11715,'pt','Parece que a pilosidade dessa adorável criatura está lhe causando problemas de visão. Obcecada por flibusteiros de todos os tipos, ela vê você como um distinto representante da categoria. Nós bem que avisamos que ela não enxergava direito. Esse devorador de almas só comerá criaturas piratas.');
INSERT INTO "item_descriptions" VALUES(11717,'pt','Quando você usa este gorro, não se pode dizer que o que há debaixo deste pinheiro é um presente.');
INSERT INTO "item_descriptions" VALUES(11719,'pt','Está ouvindo esse sininho? Está ouvindo os passos na neve? É nataw, e esta mascote chegou para lembrar você disso!');
INSERT INTO "item_descriptions" VALUES(10000049,'pt','Está ouvindo esse sininho? Está ouvindo os passos na neve? É nataw, e esta mascote chegou para lembrar você disso!');
INSERT INTO "item_descriptions" VALUES(11724,'pt','Saído diretamente dos Campos de Gelo em um limpa-neves, este escudo demonstra suas habilidades de aprendiz de esquiador de a ilha de Nataw.');
INSERT INTO "item_descriptions" VALUES(11725,'pt','Com esta mochila nas costas, você não está com uma simples mochila nas costas: você está com uma mochila com um par de esquis nas costas.');
INSERT INTO "item_descriptions" VALUES(11726,'pt','"Aventureiro, na cidade ou praticando esportes de inverno, você nunca sentirá frio nas orelhas com este capuz." Meio difícil de acreditar nesse slogan com orelhas de fora, mas enfim... Dizem que é verdade. Satisfação garantida ou seu dinheiro de volta!');
INSERT INTO "item_descriptions" VALUES(11727,'pt','O Ursolar sempre foi leal ao Papai Nowel e será a você também. Graças à pelagem quentinha, você nunca mais vai sentir frio, nem nas ilhas mais glaciais. Coce a barriguinha dele de tempos em tempos para aquecê-lo.');
INSERT INTO "item_descriptions" VALUES(11729,'pt','Não se deixe enganar pela carinha fofa: em geral, os Shushus são criaturas sanguinárias, assustadoras e cruéis. Assim, é preferível que você não utilize esta mascote para se reconfortar nas longas noites de inverno. Sabe-se lá qual parte do seu corpo ela vai tentar amputar.');
INSERT INTO "item_descriptions" VALUES(11732,'pt','Este foi o escudo usado por Halden, o Sram, para derrotar o Minotobola de Nataw que aterrorizava o vilarejo de Amakna. O pobre Minotobola não aguentou nem 5 minutos antes de desmaiar por causa do cheiro.');
INSERT INTO "item_descriptions" VALUES(11733,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(11734,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(11735,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(11747,'pt','Este chapéu simboliza o amor. O amor à guerra. O amor aos gritos de dor das vítimas. O amor à humilhação dos mais fracos. Em suma: o amor incondicional que une todos os Iops, sejam eles de sangue ou de consideração, à pancadaria com "P" maiúsculo. Muito romântico, não é mesmo?');
INSERT INTO "item_descriptions" VALUES(11748,'pt','Vestir uma capa deixa a gente mais classudo, com jeito meio de herói, não acha? Bom, menos quando você tropeça nela ou quando dá um vendaval e ela tapa o seu rosto. Mas também é só fazer um esforcinho, né?');
INSERT INTO "item_descriptions" VALUES(11749,'pt','Os Iops que não usam a cabeça só para agredir os outros notarão a sutileza deste escudo: ele protege o dono, mas também corta fatias impecáveis de salsicha de Porkasso com suas lâminas afiadas. Muito esperto... Além disso, também machuca bem feio o inimigo.');
INSERT INTO "item_descriptions" VALUES(11750,'pt','Quando você está com sangue nos olhos, ninguém para o seu fluxo. Além de atiçar sua sede de vitória, este escudo espalhará o sangue dos adversários enquanto protege você de hematomas. Muito prático, não? E vermelho combina muito com ele.');
INSERT INTO "item_descriptions" VALUES(11751,'pt','Reis do blefe, rainhas dos truques: este escudo que se adapta às cores do personagem é feito para quem tem o olhar impenetrável. Você costuma ter sempre uma carta na manga? Você é capaz de embaralhar tanto a cabeça de um adversário a ponto de evitar um ataque? Definitivamente, você é um ás...');
INSERT INTO "item_descriptions" VALUES(11752,'pt','Um véu para quem adora protestar contra tudo e todos, mas depois se omite para poder acusar o próximo. Muito esperto...');
INSERT INTO "item_descriptions" VALUES(11753,'pt','Inspirada no próprio Mestre Pandora, esta capa é tão traiçoeira que ela é capaz de apunhalar o próprio dono pelas costas. Para você ver o grau de deslealdade da coisa...');
INSERT INTO "item_descriptions" VALUES(11754,'pt','Um escudo que permite que você e o seu adversário façam uma breve pausa, antes de retomar a luta pela própria vida e por seus ideais.');
INSERT INTO "item_descriptions" VALUES(11755,'pt','Essa mascote ira defendê-lo(a) como ninguém. Ele é capaz de defendê-lo(a) melhor do que você mesmo. E é óbvio que ele se defende melhor sozinho do que com a sua ajuda. Parece que ele defende até as suas ideias e convicções melhor que você mesmo. Bom, já deu para entender: perto deste panda armado, todo mundo fica parecendo um zero à esquerda (inclusive você, mas contanto que ele salve a sua pele, está valendo). Esse devorador de almas só comerá criaturas Pandits.');
INSERT INTO "item_descriptions" VALUES(10000058,'pt','Essa mascote ira defendê-lo(a) como ninguém. Ele é capaz de defendê-lo(a) melhor do que você mesmo. E é óbvio que ele se defende melhor sozinho do que com a sua ajuda. Parece que ele defende até as suas ideias e convicções melhor que você mesmo. Bom, já deu para entender: perto deste panda armado, todo mundo fica parecendo um zero à esquerda (inclusive você, mas contanto que ele salve a sua pele, está valendo). Esse devorador de almas só comerá criaturas Pandits.');
INSERT INTO "item_descriptions" VALUES(11756,'pt','As engrenagens do tempo são impenetráveis: um almoço em família de duas horas pode parecer interminável enquanto uma partida de Cassinco de 20 minutos passa voando. Com este escudo e seu ponteiro afiado, podemos garantir que a sensação será sempre a mesma: vai doer e seus inimigo descansarão em Externam por toda a eternidade...');
INSERT INTO "item_descriptions" VALUES(11757,'pt','Os protetores de coração, aqueles que estão dispostos a qualquer sacrifício, que sofrem os golpes no lugar dos outros... Eles sabem que alguns ataques, mais violentos, exigem uma resposta de outra magnitude. O Escudo de Jyde é uma muralha quase impenetrável, capaz de cobrir sua retaguarda... e também sua frente e seus lados, o que é muito louvável!');
INSERT INTO "item_descriptions" VALUES(11758,'pt','Este chapéu é o grande destaque do conjunto. Ele dá esse ar bacana, sereno, pacato, de que ninguém desconfia... E aí, pá!!! Você ataca! (Já está entendendo, né...)');
INSERT INTO "item_descriptions" VALUES(11759,'pt','Ainda mais antiga que o próprio Vovô Wabbit, que a recebeu de sua tia-bisavó, nada é melhor que esta capa para resistir à passagem do tempo.');
INSERT INTO "item_descriptions" VALUES(11760,'pt','Não se engane: esse buraco bem no meio do escudo é totalmente estratégico! Com ele você pode ver os adversários chegando antes de fugir correndo.');
INSERT INTO "item_descriptions" VALUES(11766,'pt','Com esta touca, a sorte de Ecaflip lhe sorrirá sempre... Ou não, né? Pois veja bem... Nenhum aventureiro fica rico só de usar uma touca em forma de cofrinho.');
INSERT INTO "item_descriptions" VALUES(11771,'pt','Açúcar suficiente para deixar um Trool diabético.');
INSERT INTO "item_descriptions" VALUES(11772,'pt','Tem gente que pensa que usar um capacete imponente assim é para tentar disfarçar que você é um baita pau d''água. Verdade ou não, pelo menos ninguém vai mexer com você.');
INSERT INTO "item_descriptions" VALUES(11773,'pt','Reza a lenda que, com esta capa, quem mete o pau pelas suas costas acaba vestindo o paletó de madeira. Pode apostar...');
INSERT INTO "item_descriptions" VALUES(11774,'pt','Mesmo diante dos insultos e provocações mais abomináveis, com este você se manterá casca-grossa em qualquer situação.');
INSERT INTO "item_descriptions" VALUES(11775,'pt','Um pequeno guerreiro estóico, Minipoth é uma mascote de uma palavra só. Você dá carinho, ele fica igual a um tronco. Você reclama que ele ainda não limpou a mesa, parado como um tronco. Você ameaça abandoná-lo, pau na máquina! Isso pode acabar traumatizando ele... 
Então pode ter certeza de que todos esses sinais... bom, “esse” sinal, é a única coisa que ele pode fazer para demonstrar que ama você mais do que qualquer coisa no mundo.');
INSERT INTO "item_descriptions" VALUES(10000056,'pt','Um pequeno guerreiro estóico, Minipoth é uma mascote de uma palavra só. Você dá carinho, ele fica igual a um tronco. Você reclama que ele ainda não limpou a mesa, parado como um tronco. Você ameaça abandoná-lo, pau na máquina! Isso pode acabar traumatizando ele... 
Então pode ter certeza de que todos esses sinais... bom, “esse” sinal, é a única coisa que ele pode fazer para demonstrar que ama você mais do que qualquer coisa no mundo.');
INSERT INTO "item_descriptions" VALUES(11781,'pt','Uma pequena mascote movida por grandes valores. E aí, tem certeza de que você é digno(a)? Ahhh, calma, foi só para provocar você.');
INSERT INTO "item_descriptions" VALUES(10000024,'pt','Uma pequena mascote movida por grandes valores. E aí, tem certeza de que você é digno(a)? Ahhh, calma, foi só para provocar você.');
