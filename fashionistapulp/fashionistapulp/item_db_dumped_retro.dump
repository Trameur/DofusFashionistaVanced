INSERT INTO "item_descriptions" VALUES(1099,'de','Nur zum testen');
INSERT INTO "item_descriptions" VALUES(1101,'de','Der Eniripsa Mie Däpan fertigte eine ganze Reihe dieser spitzen Stäbe an, um gegen Diebstähle vorzugehen. Theroretisch sollen die Stäbe die Macht haben, in der Zeit zurückzureisen, um Überfälle zu verhindern. Doch in der Praxis landeten sie alle im Auge eines mächtigen und mächtig darüber erbosten Dämonen.');
INSERT INTO "item_descriptions" VALUES(1102,'de','Der Eniripsa Mie Däpan fertigte eine ganze Reihe dieser spitzen Stäbe an, um gegen Diebstähle vorzugehen. Theroretisch sollen die Stäbe die Macht haben, in der Zeit zurückzureisen, um Überfälle zu verhindern. Doch in der Praxis landeten sie alle im Auge eines mächtigen und mächtig darüber erbosten Dämonen.');
