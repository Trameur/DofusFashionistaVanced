INSERT INTO "item_descriptions" VALUES(9735,'fr','Cette arme est une Shushette, elle est capable de voler les fragments d''âmes des Shushus de Rushu que possèdent les monstres. Une fois que vous les aurez récupérés, vous pourrez tenter de les incruster directement sur l''arme afin de la rendre plus puissante.');
