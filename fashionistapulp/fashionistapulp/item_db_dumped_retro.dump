INSERT INTO "item_descriptions" VALUES(13214,'fr','Cette arme vous est prêtée par Notend Less qui voit en vous du potentiel... Bon, en réalité c''est plutôt votre côté "bête de foire" qui l''intéressait. Pas très élogieux. Dans tous les cas, elle vous permet de revêtir temporairement les traits d''une classe et c''est déjà pas si mal.');
INSERT INTO "item_descriptions" VALUES(13215,'fr','Cette arme vous est prêtée par Notend Less qui voit en vous du potentiel... Bon, en réalité c''est plutôt votre côté "bête de foire" qui l''intéressait. Pas très élogieux. Dans tous les cas, elle vous permet de revêtir temporairement les traits d''une classe et c''est déjà pas si mal.');
INSERT INTO "item_descriptions" VALUES(13216,'fr','Cette arme vous est prêtée par Notend Less qui voit en vous du potentiel... Bon, en réalité c''est plutôt votre côté "bête de foire" qui l''intéressait. Pas très élogieux. Dans tous les cas, elle vous permet de revêtir temporairement les traits d''une classe et c''est déjà pas si mal.');
INSERT INTO "item_descriptions" VALUES(13218,'fr','Le Galeapagos est un familier réputé pour ses multiples trahisons. Il forme volontiers des alliances temporaires avec d''autres convives, mais n''hésite pas à les trahir dès que l''occasion lui est favorable.');
INSERT INTO "item_descriptions" VALUES(13219,'fr','Le Sagum Troolex est une cape confectionnée à partir des armes abandonnées lors des combats par des aventuriers tombés sous les coups de leurs adversaires dans l''arène du Gladiatrool. Faite d''un filet finement tissé et d''un trident astucieusement intégré, elle mêle style et bravoure. Toutefois, ne comptez pas sur elle pour vous tenir au chaud !');
INSERT INTO "item_descriptions" VALUES(13220,'fr','Le Galea Troolex, créé par Notend Less lui même, est bien plus qu''une simple coiffe. Elle confère à son porteur une classe incomparable, aussi bien dans l''arène du Gladiatrool qu''au-delà. Cette pièce d''armure n''est accessible qu''à ceux qui triomphent après de nombreux combats dans l''arène du Gladiatrool.');
INSERT INTO "item_descriptions" VALUES(13222,'fr','Ce certificat vous permet d''aller reprendre votre monture dans une étable. 
Attention, ce certificat n''est valide que 20 jours, une fois ce délai dépassé, votre monture sera relâchée dans la nature et votre certificat ne sera plus valide, vous ne pourrez plus récupérer votre monture. Pensez à laisser votre monture dans une étable si vous devez vous absenter longtemps.');
INSERT INTO "item_descriptions" VALUES(13224,'fr','Ne le regardez pas droit dans les yeux, malheureux ! Vous risqueriez d''aboyer en vous grattant derrière l''oreille avec le pied. Ou pire encore...');
INSERT INTO "item_descriptions" VALUES(13225,'fr','Flotter au vent confère déjà des attraits magiques à cette cape, auxquels s''ajoute un bâton unique qui doit au minimum briller dans le noir pour qui sait le manier.');
INSERT INTO "item_descriptions" VALUES(13226,'fr','Un mage ne saurait être un mage sans une capuche pour le rendre plus ténébreux et réussir ses entrées où qu''il aille. Celle-là permet même de faire ressortir vos yeux !');
INSERT INTO "item_descriptions" VALUES(13227,'fr','Ses motifs ancestraux doivent forcément recéler une puissante magie. Et cette transparence ! Vous a-t-elle déjà donné l''impression de dissimuler autant ? Vous avez quatre heures.');
INSERT INTO "item_descriptions" VALUES(13228,'fr','Contrairement aux apparences, cette bébête n''a aucune pitié, ni aucune empathie. Mais elle attire celles des autres, ce qui contrebalance avec votre impassibilité.');
INSERT INTO "item_descriptions" VALUES(13229,'fr','Cet alliage de cuir et de fer ferait croire que vous n''êtes plus vraiment humain et que vous avez un œil derrière la tête. À se demander si vous n''êtes pas encore plus menaçant de dos...');
INSERT INTO "item_descriptions" VALUES(13230,'fr','Votre allure prend du galon grâce à ce chapeau haut de forme avec lunettes et masque filtrant intégrés. Attention tout de même de ne pas trop respirer de Stasis !');
INSERT INTO "item_descriptions" VALUES(13231,'fr','Depuis que vous avez enfilé cet énorme gant, vous avez plus de considération quand vous tapez du poing sur la table. Comment ? Ah oui, quand vous frappez vos ennemis aussi.');
INSERT INTO "item_descriptions" VALUES(13233,'fr','Ce magnifique bouclier en forme de boule à neige de Nowel est l''arme parfaite pour ceux qui veulent protéger leur peau tout en répandant un esprit festif. Attention : secouer ce bouclier peut provoquer une tempête... de mauvaise humeur chez vos adversaires.');
INSERT INTO "item_descriptions" VALUES(13234,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13235,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13236,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13237,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13240,'fr','Félicitations ! Vous êtes l''heureux détenteur de l''Hidwege. Cet oiseau possède un talent hors du commun : il vous apporte votre courrier et se débarrasse des mauvaises nouvelles. Factures oubliées, invitations gênantes ou publicités indésirables, l''Hidwege les fait disparaître comme par magie, ne gardant que ce qui peut illuminer votre journée.');
INSERT INTO "item_descriptions" VALUES(13241,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13242,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13243,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13244,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13245,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13246,'fr','Cette coiffe fait hommage à Gérard Ysie, plus connu sous le nom de Gégé. Il s''agissait d''un grand traillardeur ne reculant devant aucun défi, jusqu''à ce qu''il prenne une rouste d''un parfait inconnu, lui valant de faire une crise de nerf mortelle. En la portant vous ne pourrez pas vous empêcher d''hurler son nom après chaque victoire.');
INSERT INTO "item_descriptions" VALUES(13247,'fr','Cette cape absorbe et canalise le sel de vos ennemis vaincus. Plus ils râlent, plus elle s''imprègne de leur amertume et gagne en éclat.');
INSERT INTO "item_descriptions" VALUES(13248,'fr','Quelle que soit votre frustration, ce bâton restera intact. même après avoir été violemment projeté contre un mur lors de vos crises de rage après une défaite.');
INSERT INTO "item_descriptions" VALUES(13249,'fr','Forgé pour ceux qui ont juré allégeance aux royaumes virtuels, ce bouclier protège son porteur de la menace la plus redoutée : les brins d''herbe.');
INSERT INTO "item_descriptions" VALUES(13250,'fr','Ce familier est le seul être vivant à supporter notre odeur, sans broncher face aux effluves que d''autres fuiraient. Il faut dire qu''après des semaines de combats acharnés sans une seconde pour se laver, il est difficile de savoir s''il tolère notre odeur... ou s''il en fait désormais partie.');
INSERT INTO "item_descriptions" VALUES(13253,'fr','Cette cape aux allures familières a été enchantée par Hel Munster lui-même suite aux demandes incessantes d''un célèbre couturier d''Astrub. Il désirait proposer une collection qui s''adapte aux couleurs de l''individu qui la porte. Décolorée par un procédé top secret, vous reconnaissez pourtant l''odeur caractéristique de la bave de Mulou qui s''en dégage... Beurk !');
INSERT INTO "item_descriptions" VALUES(13260,'fr','L''Écu du Mercenaire arbore fièrement l''emblème du clan, tandis que deux ailes fixées à l''arrière lui donnent une allure majestueuse... mais ne vous aideront pas à esquiver le moindre coup.');
INSERT INTO "item_descriptions" VALUES(13261,'fr','Au fil des missions, cette cape évolue, témoignant du prestige et de la fidélité de leur porteur envers le clan des Mercenaires.');
INSERT INTO "item_descriptions" VALUES(13262,'fr','Le Briscard a parcouru les champs de bataille, esquivé les lames et survécu à d''innombrables combats. Aujourd''hui, il ne combat plus. Il reste a vos côtés, prêt à grogner ou à montrer les crocs si nécessaire.');
INSERT INTO "item_descriptions" VALUES(13263,'fr','Cette coiffe vous donnera un grand pouvoir de persuasion. Vos interlocuteurs se retrouveront dans l''incapacité de vous refuser quoi que ce soit, pas même un susucre ni une caresse.');
INSERT INTO "item_descriptions" VALUES(13264,'fr','Maman et toute sa smala sont de sortie ! Ça babille, ça chante, ça gazouille et ça piaille à tout va. Gare à ceux qui oseraient leur voler dans les plumes... Un coup de bec, passe encore, 4 coups de bec, bonjour les dégâts...');
INSERT INTO "item_descriptions" VALUES(13265,'fr','On dit que le Sinistro congelé dans ce bouclier avait cessé de fonctionner, arrêtant avec lui le temps qui passe. Comme si la fin du balancement de ce métronome avait le pouvoir figer le temps. Une hérésie que bien des Xelors vous déconseilleront de croire.');
INSERT INTO "item_descriptions" VALUES(13266,'fr','Le paradoxe de ce familier est qu''il a été créé en s''inspirant du futur. Mais lorsque le modèle n''est inventé que des années après la copie qui a servi à l''élaboration de l''original, peut-on encore définir lequel est authentique ? C''est toute l''histoire de la Paradoxine.');
INSERT INTO "item_descriptions" VALUES(13267,'fr','Cette machine à l''effigie d''un hibou semble être liée au pouvoir de l''Eliacube, à moins qu''il s''agisse de l''Eliacube lui-même...');
INSERT INTO "item_descriptions" VALUES(13268,'fr','Ce mystérieux portail semble connecté à une autre dimension. Très pratique pour faire disparaître corps et âme tout projectile envoyé dans votre direction, attention toutefois à ne pas marcher dessus par inadvertance : personne ne sait où il mène...');
INSERT INTO "item_descriptions" VALUES(13269,'fr','Cette cape ne semble pas être constituée de tissu, mais de la trame dont les dimensions sont tissées.');
INSERT INTO "item_descriptions" VALUES(13270,'fr','Ce masque éblouissant pourrait faire de vous un phare dans la nuit, ou le destructeur des mondes.');
INSERT INTO "item_descriptions" VALUES(13271,'fr','Ce jeune dragon vous paraît peut-être mignon, mais attendez de le voir une fois adulte.');
INSERT INTO "item_descriptions" VALUES(13272,'fr','Ce petit dragon attaché à son œuf constitue une parfaite défense contre quiconque s''approchant de ce dernier.');
INSERT INTO "item_descriptions" VALUES(13273,'fr','Cette cape en peau de dragon vous protégera des retours de flamme, mais pas de votre mauvais karma.');
INSERT INTO "item_descriptions" VALUES(13274,'fr','Avec ce casque draconique, vos ennemis verront la mort en face, et vous la vie en rose.');
INSERT INTO "item_descriptions" VALUES(13275,'fr','L''épais bloc de glace qui entoure ce Piou le protège du froid hivernal de Frigost.');
INSERT INTO "item_descriptions" VALUES(13276,'fr','Si vous êtes pris dans une tempête de neige, placez ce bouclier devant votre visage : il protégera vos yeux des flocons et du vent, et éclairera le chemin devant vous. En revanche, il ne donne pas l''heure.');
INSERT INTO "item_descriptions" VALUES(13277,'fr','Quand on vit à Frigost, mieux vaut être bien équipé : cette confortable cape en poil de boufmouth sera votre meilleure alliée pour affronter les vents glacés de l''île.');
INSERT INTO "item_descriptions" VALUES(13278,'fr','Avec cette épaisse capuche sur la tête, vous n''attraperez certainement pas froid. Faites plutôt attention à ne pas vous faire attraper par les serviteurs du Comte, vous risqueriez d''avoir plus de mal à vous en remettre.');
INSERT INTO "item_descriptions" VALUES(13279,'fr','Si vous savez garder la tête froide mais que vous avez tout de même un grain de folie, ce casque vous rendra complètement givré.');
INSERT INTO "item_descriptions" VALUES(13280,'fr','Heureux maître d''un Chtigromouth à la fourrure plus chaude et soyeuse que jamais, Harebourg se rendit vite compte qu''il perdait une quantité astronomique de poils. Pragmatique, il en fit des capes pour les hivers rudes de Frigost.');
INSERT INTO "item_descriptions" VALUES(13282,'fr','Une massue imposante qui dégage une forte odeur de cawotte, signe qu''elle a longuement séjourné dans le terrier du Wa Wabbit. Bien que redoutable en combat, elle sert surtout de cale-porte pour le Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(13283,'fr','Un Boune à votre service ?! Qui aurait pu imaginer que ce familier à pompon ferait un jour partie de votre fourbi ? Cette peluche sur pattes, mignonne sous toutes les coutures, est pourtant un allié de taille : le jour, il désoriente vos ennemis, s''attirant leur sympathie d''un simple regard ; la nuit, il vous réconforte après une dure journée, en vous laissant contre sa douce fourrure vous blottir.');
INSERT INTO "item_descriptions" VALUES(13284,'fr','Vous vivant et armé de ce pavois, aucun envahisseur ne franchira le seuil de la cité de Brutas ! Bon... vous êtes tout de même au courant que ce n''est pas le bouclier qui fait tout, hein... ?');
INSERT INTO "item_descriptions" VALUES(13285,'fr','Forgé dans la plus pure tradition des artisans-mercenaires, ce casque est reconnaissable entre mille et dangereux comme pas deux.');
INSERT INTO "item_descriptions" VALUES(13286,'fr','Aussi reconnaissable qu''une oriflamme, cette cape révèle aux yeux de tous que vous avez tout Astrub derrière vous !');
INSERT INTO "item_descriptions" VALUES(13287,'fr','La relève est assurée avec ce garde à peine plus grand qu''un porte-clés ! Ne commettez pas l''erreur de le sous-estimer, il pourrait très bien vous couper l''herbe sous le pied.');
INSERT INTO "item_descriptions" VALUES(13288,'fr','Qui oserait croiser le fer avec celui ou celle qui arbore cette cape de guerre ? Peut-être un Sram, mené par l''appât du gain, qui se dirait qu''il n''y a pas que votre tenue qui a la couleur du kama... ? Maudits voleurs et assassins ! Ils attaquent toujours par-derrière, ces gredins !');
INSERT INTO "item_descriptions" VALUES(13289,'fr','Tel un esprit mystérieux, fidèle à sa glorieuse cité, vous ne serez reconnu par personne – pas même votre mère – sous ce fabuleux casque à la crête enflammée ! Espérons tout de même que vous, vous y verrez quelque chose...');
INSERT INTO "item_descriptions" VALUES(13290,'fr','À le voir comme cela, on pourrait croire qu''il vaut son pesant de kamas. Pourtant, ce n''est pas la première qualité de ce bouclier : il est avant tout un flambeau que l''on se transmet entre nobles guerriers, fidèles à une seule et même cité... Amakna !');
INSERT INTO "item_descriptions" VALUES(13291,'fr','Ce petit tank sur pattes n''est pas du genre à se laisser marcher sur les pieds. Il faudra lui passer sur le corps si vous voulez... heu... passer.');
INSERT INTO "item_descriptions" VALUES(13292,'fr','Si la plupart des familiers sont à croquer, pour celui-ci ça peut rapidement devenir fatal ! Notez également qu''il n''apprécie que moyennement les régions trop ensoleillées...');
INSERT INTO "item_descriptions" VALUES(13293,'fr','Ce bouclier offre un tout autre sens à l''expression « avoir un coup de barre ». Prenez garde, vos adversaires pourraient bien y prendre goût...');
INSERT INTO "item_descriptions" VALUES(13294,'fr','Et PAF ! On a fait un Chapopics.');
INSERT INTO "item_descriptions" VALUES(13295,'fr','Conçue par les plus grands artisans chocolatiers du Monde des Douze, cette cape est une véritable œuvre d''art à l''épreuve des taches de chocolat. Mais pas des coups de dents !');
INSERT INTO "item_descriptions" VALUES(13300,'fr','L''inconvénient d''avoir neuf vies, c''est qu''il faut obligatoirement passer par la case « petite enfance » à chaque réincarnation. Si ce Bébérubim vous semble parfois un peu ronchon, faites preuve de compassion : cela fait neuf fois qu''il essaye d''arrêter la tétine, et il n''y arrive toujours pas !');
INSERT INTO "item_descriptions" VALUES(13301,'fr','Le collier Ankaffilié est offert aux plus fidèles adeptes de l''univers du Krosmoz. Il accorde à son porteur un passe-droit lui permettant d''ouvrir n''importe quelle porte en lien avec l''univers d''Ankama, sans la moindre exception.');
INSERT INTO "item_descriptions" VALUES(13304,'fr','Quand vous serez triste, elle saura vous consoler. Rien ne résistera à la petite Élante.');
INSERT INTO "item_descriptions" VALUES(13306,'fr','Le Tichef est une antique créature aux multiples talents, qui porte une plume pour chaque exploit réalisé au fil des ans. Sa sagesse déteindra peut-être sur vous, mais sachez que de son point de vue, c''est VOUS, le familier mignon qui l''accompagne dans ses aventures !');
INSERT INTO "item_descriptions" VALUES(13307,'fr','Toujours l''esprit pratique, l''ancien chef a confectionné son symbole rituel à partir d''une solide dalle de pierre pouvant servir de bouclier. Un objet aussi utile à la guerre que durant les cérémonies officielles ! On vous recommande tout de même de le laver entre les deux.');
INSERT INTO "item_descriptions" VALUES(13308,'fr','On raconte que l''ancien chef a autrefois réussi à frapper deux oiseaux d''une seule flèche, les yeux bandés. Cette coiffe traditionnelle honore cette légende, avec deux plumes représentant les oiseaux et un morceau de tissu qui vous empêche de voir quoi que ce soit. Bonne chasse !');
INSERT INTO "item_descriptions" VALUES(13309,'fr','Que ne peut-on faire avec cette cape ? Couverture, imperméable, drapeau, paillasson... L''ancien chef était ingénieux, mais il avait aussi le sens du style. Honorez sa mémoire en trouvant à cette cape un nouvel usage ! Ou portez-la sur vos épaules, ça marche aussi.');
INSERT INTO "item_descriptions" VALUES(13346,'fr','Ce petit dragogindonneau rêve de fêter nowel, encore faut-il qu''il ne se fasse pas rôtir pendant la Fête de Fanks Guivingue.');
INSERT INTO "item_descriptions" VALUES(13349,'fr','Cette hache à la forme exceptionnelle, dispose d''une lame vibrante qui permet d''achever ses ennemis en musique.');
INSERT INTO "item_descriptions" VALUES(13350,'fr','Au tréfonds des terres, ce phorreur amalgamé avec cette pierre rare qu''on appelle Bismuth fore à foison. Doué d''un sens aigu de l''orientation, c''est sans effort qu''il se repère dans les tranchées labyrinthiques ; une qualité inestimable quand on veut traverser un dédale, mais qui n''est pourtant rien comparée à sa bonté.');
INSERT INTO "item_descriptions" VALUES(13352,'fr','Ce bouclier fût doté à sa création d''un puissant sortilège sensé augmenter de manière exponentielle les talents d''orateur de son porteur. Cependant une faute de grammaire malencontreuse dans l''incantation eu pour résultat de ne permettre l''activation de son pouvoir que lorsqu''il est utilisé pour semer la zizanie. Le bouclier idéal pour les fêtes de famille en somme.');
INSERT INTO "item_descriptions" VALUES(13353,'fr','Lorsque vous posez ces lunettes sur votre nez, vous voyez la vie comme à travers un filtre. Votre visage se met à grimacer comme la célèbre Bella Porche et vous ressentez une soudaine envie de danser sur des sons entêtants. Si vous regardez autour de vous, tout le monde semble pris de la même folie. Attention à ne pas les porter trop longtemps, si vous ne voulez pas décrocher de la réalité.');
INSERT INTO "item_descriptions" VALUES(20098,'fr','En digne Shushu, Budshu vous cherchera des poux. Rien du tout comparé à votre acolyte Goultard ! À qui il jettera des cailloux jusqu''à ce qu''il ploie le genou devant Rushu... Vous pouvez toujours lui donner du pâté pour faire augmenter ses statistiques (et le calmer).');
INSERT INTO "item_descriptions" VALUES(39,'es','Este amuleto aumenta la inteligencia de su portador.');
INSERT INTO "item_descriptions" VALUES(40,'es','Espada de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(42,'es','Espada de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(43,'es','Espada de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(44,'es','Espada de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(46,'es','Una espada bien forjada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(47,'es','Una espada bien forjada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(48,'es','Una espada bien forjada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(49,'es','Una espada bien forjada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(51,'es','Puede que esta espada muy buscada por los jóvenes Yopukas te permita hacer tus pruebas. Pero cuidado, una vez que su propietario se haya equipado con ella, acabará inevitablemente por volverse un poco chiflado.');
INSERT INTO "item_descriptions" VALUES(53,'es','Puede que esta espada muy buscada por los jóvenes Yopukas te permita hacer tus pruebas. Pero cuidado, una vez que su propietario se haya equipado con ella, acabará inevitablemente por volverse un poco chiflado.');
INSERT INTO "item_descriptions" VALUES(54,'es','Puede que esta espada muy buscada por los jóvenes Yopukas te permita hacer tus pruebas. Pero cuidado, una vez que su propietario se haya equipado con ella, acabará inevitablemente por volverse un poco chiflado.');
INSERT INTO "item_descriptions" VALUES(55,'es','Puede que esta espada muy buscada por los jóvenes Yopukas te permita hacer tus pruebas. Pero cuidado, una vez que su propietario se haya equipado con ella, acabará inevitablemente por volverse un poco chiflado.');
INSERT INTO "item_descriptions" VALUES(58,'es','Se trata aquí de una espada que ha sido bañada en lágrimas de un joven mediulubo. Muchos guerreros piensan que al estar bendita de esta manera, su arma les traerá suerte y valor en los campos de batalla.');
INSERT INTO "item_descriptions" VALUES(59,'es','De excelente factura, la espada Dha hará de ti un valiente guerrero. Incluso los más valientes de tus adversarios se estremecerán al verla.');
INSERT INTO "item_descriptions" VALUES(60,'es','De excelente factura, la espada Dha hará de ti un valiente guerrero. Incluso los más valientes de tus adversarios se estremecerán al verla.');
INSERT INTO "item_descriptions" VALUES(61,'es','De excelente factura, la espada Dha hará de ti un valiente guerrero. Incluso los más valientes de tus adversarios se estremecerán al verla.');
INSERT INTO "item_descriptions" VALUES(62,'es','De excelente factura, la espada Dha hará de ti un valiente guerrero. Incluso los más valientes de tus adversarios se estremecerán al verla.');
INSERT INTO "item_descriptions" VALUES(65,'es','La espada Gultar ha sido sumergida en la sangre de un Dragocerdo. El héroe que consiga soportar el olor que desprende esta poderosa espada podrá rivalizar con los más grandes.');
INSERT INTO "item_descriptions" VALUES(66,'es','Esta espada pertenecía al célebre Badulo, un valiente guerrero que perdió la cabeza durante un combate.');
INSERT INTO "item_descriptions" VALUES(67,'es','Afilada e infernal: estas fueron las palabras del súcubo que la forjó. Al menos que sean las palabras que utilizó Vald para describir a su hermana, eso ya nadie podría decirlo con certeza.');
INSERT INTO "item_descriptions" VALUES(68,'es','Este amuleto aumenta la inteligencia de su portador.');
INSERT INTO "item_descriptions" VALUES(69,'es','Este amuleto aumenta la inteligencia de su portador.');
INSERT INTO "item_descriptions" VALUES(70,'es','Este amuleto aumenta la inteligencia de su portador.');
INSERT INTO "item_descriptions" VALUES(74,'es','Este amuleto aumenta la fuerza de su portador.');
INSERT INTO "item_descriptions" VALUES(75,'es','Este amuleto aumenta la fuerza de su portador.');
INSERT INTO "item_descriptions" VALUES(76,'es','Este amuleto aumenta la fuerza de su portador.');
