INSERT INTO "item_descriptions" VALUES(156,'en','This Power Belt will render you particularly powerful during fights but its weight will considerably decrease your agility.');
INSERT INTO "item_descriptions" VALUES(157,'en','The Gougnole is made of Moon Stone that was marinated for 5,000 years in a barrel of beer. This has inevitably endowed it with terrific powers.');
INSERT INTO "item_descriptions" VALUES(158,'en','The Golden Destiny will considerably increase your vitality and agility.');
INSERT INTO "item_descriptions" VALUES(159,'en','People say the famous Blacksmith Boulgur made this brooch. Yes, the guy who created weapons for Gods.');
INSERT INTO "item_descriptions" VALUES(160,'en','This amulet, cast in a mixture of celestial eggs and milky stardust must be refrigerated.');
INSERT INTO "item_descriptions" VALUES(161,'en','This powerful amulet will certainly make a name for you.');
