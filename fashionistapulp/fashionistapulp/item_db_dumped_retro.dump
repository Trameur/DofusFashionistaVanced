INSERT INTO "item_descriptions" VALUES(7714,'es','Dicen que un Experto en Artes Marciales ha criado esta tortuga que se parece a una rata de alcantarillas. Si la alimentas con pescado se volverá buena y te ayudará a curar a los aventureros heridos. Si le das carne, se volverá más agresiva y te ayudará a luchar contra tus adversarios.');
INSERT INTO "item_descriptions" VALUES(7753,'es','Esta varita sale directamente de las profundidades más calientes de las entrañas de la tierra. Ten cuidado al manipularla. ¿Acaso no te han dicho que no se jugaba con el fuego?');
INSERT INTO "item_descriptions" VALUES(7754,'es','Ha sido puesto por Terrakurial, el Dragón de la Tierra. Este Dofus encierra grandes poderes por lo cual no debe dejarse entre las manos de cualquiera...');
INSERT INTO "item_descriptions" VALUES(7806,'es','Este certificado te permite ir a por tu montura en un establo. Ojo, este certificado sólo es válido durante 20 días, cuando este período haya transcurrido, tu montura se soltará en la naturaleza, tu certificado ya no será válido y no podrás recuperar tu montura. Piensa en dejar tu montura en algún establo si vas a estar ausente durante mucho tiempo.');
