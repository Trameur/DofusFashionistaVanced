INSERT INTO "item_descriptions" VALUES(1105,'es','Esta pesada varita ha destrozado más de un cráneo de pecador. Los sacerdotes yopukas la utilizan para absolver radical y definitivamente a los arrepentidos.');
INSERT INTO "item_descriptions" VALUES(1107,'es','Esta pesada varita ha destrozado más de un cráneo de pecador. Los sacerdotes yopukas la utilizan para absolver radical y definitivamente a los arrepentidos.');
INSERT INTO "item_descriptions" VALUES(1108,'es','Esta pesada varita ha destrozado más de un cráneo de pecador. Los sacerdotes Yopuka la utilizan para absolver radical y definitivamente a los arrepentidos.');
INSERT INTO "item_descriptions" VALUES(1109,'es','Este bastón es una réplica de un artefacto legendario, pero sin su poder. Era capaz de emitir una luz cuando chocaba contra el suelo (¡Oh!) y de deformar un poco tu voz (¡Wah!), te hará pasar por lo que no eres: un gran mago.');
INSERT INTO "item_descriptions" VALUES(1110,'es','Este bastón es una réplica de un artefacto legendario, pero sin su poder. Era capaz de emitir una luz cuando chocaba contra el suelo (¡Oh!) y de deformar un poco tu voz (¡Wah!), te hará pasar por lo que no eres: un gran mago.');
INSERT INTO "item_descriptions" VALUES(1111,'es','Este bastón es una réplica de un artefacto legendario pero sin su poder. Era capaz de emitir una luz cuando chocaba contra el suelo (¡Oh!) y de deformar un poco tu voz (¡Wah!), te hará pasar por lo que no eres: un gran mago.');
INSERT INTO "item_descriptions" VALUES(1112,'es','"¡Con un Jalató, puedes hacerlo tó!" este era el eslogan de un comerciante del Sur cuya especialidad consistía en reciclar Jalatós. Este arco era uno de sus productos. Aunque no sea muy estético no deja de ser un arma temible.');
INSERT INTO "item_descriptions" VALUES(1113,'es','Se trata de un arco fabricado únicamente en el gran norte de Amakna, el Diquea es un arco barato que puedes montar tú solo, por lo cual su calidad depende mucho de tu propia habilidad en materia de bricolaje.');
INSERT INTO "item_descriptions" VALUES(1114,'es','Se trata de un arco fabricado únicamente en el gran norte de Amakna, el Diquea es un poco caro y debes montarlo tú solo, por lo cual su calidad depende mucho de tu propia habilidad en materia de bricolaje.');
INSERT INTO "item_descriptions" VALUES(1115,'es','Se trata de un arco fabricado únicamente en el gran norte de Amakna, el Diquea es un poco caro y debes montarlo tú solo, por lo cual su calidad depende mucho de tu propia habilidad en materia de bricolaje.');
INSERT INTO "item_descriptions" VALUES(1116,'es','Se trata de un arco fabricado únicamente en el gran norte de Amakna, el Diquea es un poco caro y debes montarlo tú solo, por lo cual su calidad depende mucho de tu propia habilidad en materia de bricolaje.');
INSERT INTO "item_descriptions" VALUES(1117,'es','El esquema de fabricación de este arco 100% reciclable ha sido hallado en las ruinas de Din por un aventurero aparentemente famoso por su manejo del látigo. Nada indica que haya cambiado su vieja tralla de cuero por este magnífico arco.');
INSERT INTO "item_descriptions" VALUES(1118,'es','El esquema de fabricación de este arco 100% reciclable ha sido hallado en las ruinas de Din por un aventurero aparentemente famoso por su manejo del látigo. Nada indica que haya cambiado su vieja tralla de cuero por este magnífico arco.');
