INSERT INTO "item_descriptions" VALUES(9756,'fr','Cette arme est une Shushette, elle est capable de voler les fragments d''âmes des Shushus de Rushu que possèdent les monstres. Une fois que vous les aurez récupérés, vous pourrez tenter de les incruster directement sur l''arme afin de la rendre plus puissante.');
INSERT INTO "item_descriptions" VALUES(9757,'fr','Cette arme est une Shushette, elle est capable de voler les fragments d''âmes des Shushus de Rushu que possèdent les monstres. Une fois que vous les aurez récupérés, vous pourrez tenter de les incruster directement sur l''arme afin de la rendre plus puissante.');
INSERT INTO "item_descriptions" VALUES(9758,'fr','Cette arme est une Shushette, elle est capable de voler les fragments d''âmes des Shushus de Rushu que possèdent les monstres. Une fois que vous les aurez récupérés, vous pourrez tenter de les incruster directement sur l''arme afin de la rendre plus puissante.');
INSERT INTO "item_descriptions" VALUES(9759,'fr','Cette arme est une Shushette, elle est capable de voler les fragments d''âmes des Shushus de Rushu que possèdent les monstres. Une fois que vous les aurez récupérés, vous pourrez tenter de les incruster directement sur l''arme afin de la rendre plus puissante.');
INSERT INTO "item_descriptions" VALUES(9785,'fr','Ce démon mineur vous accompagnera durant toutes vos pérégrinations, du Zaap d''Astrub au cimetière, voire même du cimetière au Zaap d''Astrub. Cette créature est animée d''une haine viscérale envers les Ouassingues. Une sombre histoire de ménage paraît-il... Attaquez des Ouassingues, et elle se repaîtra de leurs dépouilles.');
INSERT INTO "item_descriptions" VALUES(10000063,'fr','Ce démon mineur vous accompagnera durant toutes vos pérégrinations, du Zaap d''Astrub au cimetière, voire même du cimetière au Zaap d''Astrub. Cette créature est animée d''une haine viscérale envers les Ouassingues. Une sombre histoire de ménage paraît-il... Attaquez des Ouassingues, et elle se repaîtra de leurs dépouilles.');
INSERT INTO "item_descriptions" VALUES(9919,'fr','Prendre l''apparence d''un hibou.');
INSERT INTO "item_descriptions" VALUES(9921,'fr','Ce bracelet est censé briller, mais uniquement la nuit et dans les tavernes.');
INSERT INTO "item_descriptions" VALUES(9922,'fr','Cette ceinture est dotée d''un mécanisme magnétique incroyablement puissant qui lui permet de se rester fermée sans utiliser la moindre boucle de ceinture. Attention, il est déconseillé de l''utiliser en même temps qu''un slip de plomb.');
INSERT INTO "item_descriptions" VALUES(9923,'fr','Si vous êtes bien musclé, et que vous voulez danser comme un robot, ces chaussures sont faîtes pour vous. Attention, les lacets sont en option.');
INSERT INTO "item_descriptions" VALUES(9924,'fr','La légende raconte que ces cornes servent de paratonnerre, concentrent la foudre pendant plusieurs heures puis projettent des éclairs contre tous les imprudents qui s''approchent un peu trop près. Une autre légende raconte qu''elles servent juste à vous faire passer pour un idiot.');
INSERT INTO "item_descriptions" VALUES(9925,'fr','Cet anneau est plus proche du gant ou de la moufle que de l''alliance mais qu''importe, plus personne ne vous serrera la main comme avant.');
INSERT INTO "item_descriptions" VALUES(9926,'fr','Cette hache composée de deux lames permet de trancher deux têtes simultanément et donc de décapiter un huitième d''une hydre à seize têtes.');
INSERT INTO "item_descriptions" VALUES(9927,'fr','Olcar portait ces bottes lorsqu''il aperçut du haut du mont Jifu d''étranges objets non identifiés traversant le ciel.');
INSERT INTO "item_descriptions" VALUES(9928,'fr','Il vous faudra environ 12 heures pour nouer les lacets de ces bottes et 16 heures pour les dénouer. Si vous décidez de les enlever une fois par jour, vous prendrez donc du retard tous les jours, à moins de prendre de l''avance dès aujourd''hui pour les jours suivants.');
INSERT INTO "item_descriptions" VALUES(9929,'fr','Chez certains combattants, le talon d''Achille se situe au niveau du nombril. Avec cette ceinture autour des hanches, vos amis vous trouveront deux fois plus lourd, mais vous serez mieux protégé.');
INSERT INTO "item_descriptions" VALUES(9930,'fr','Avec ce masque sur la tête, vous ressemblerez de loin à une larve géante mutante, mais de près vous ressemblerez à un terrible combattant. Évitez les combats en distance.');
INSERT INTO "item_descriptions" VALUES(9931,'fr','Nuque longue et crête de Pioute, cette coiffe vous ira comme un gant, surtout si vous l''enfilez ailleurs que sur vos mains.');
INSERT INTO "item_descriptions" VALUES(9933,'fr','Les poils de Bitoufs cousus sur le haut de cette cape, protégeront efficacement votre nuque lorsque le public décidera de vous envoyer quelques chaises afin de vous signifier la médiocrité de vos prestations.');
INSERT INTO "item_descriptions" VALUES(9936,'fr','Ce casque est parfait si vous voulez ressembler à un méchant malgré votre visage de chérubin et vos boutons d''acné.');
INSERT INTO "item_descriptions" VALUES(9937,'fr','Ce chapeau est livré avec une moustache postiche qui ne pousse pas, ce qui vous permettra d''économiser quelques séances chez le barbier.');
INSERT INTO "item_descriptions" VALUES(9938,'fr','La lame de ce sabre a été trempée pendant 18 mois dans un concentré de purée de lucioles. C''est franchement ignoble, mais au moins il brille dans le noir.');
INSERT INTO "item_descriptions" VALUES(9939,'fr','Cette canne souple en bambou a appartenu à un illustre vagabond aux manières raffinées.');
INSERT INTO "item_descriptions" VALUES(9942,'fr','La construction de cet anneau, aussi connu sous le nom "Anneau noir", ne semble pas encore achevée. Mais qu''importe, sa puissance est suffisante pour détruire une lune.');
INSERT INTO "item_descriptions" VALUES(9943,'fr','Ces magnifiques chaussures sont recouvertes d''un vernis à base de... Personne ne sait réellement, mais tant qu''elles brillent tout le monde s''en moque.');
INSERT INTO "item_descriptions" VALUES(9944,'fr','A la fois amulette et cravate, cet objet d''apparat permettra à vos proches de vous tenir en laisse facilement. Et vous aimerez ça.');
INSERT INTO "item_descriptions" VALUES(9945,'fr','Bouba a toujours prétendu être un prophète, porteur d''un message qu''il a fini par lui-même oublier. reconverti pendant plusieurs années comme chasseur de primes, il a terminé sa triste carrière, digéré dans le ventre d''une créature des sables.');
INSERT INTO "item_descriptions" VALUES(9961,'fr','Ce marteau de piètre qualité a été conçu pour leurrer les forgerons, en leur faisant croire qu''ils avaient entre leurs mains un marteau d''excellente qualité. Il est fortement déconseillé de s''en servir, même pour ne rien faire.');
INSERT INTO "item_descriptions" VALUES(9972,'fr','Ce marteau destiné à la forge a été conçu pour un usage précis, ce qui rend son utilisation difficile pour autre chose. Seule une personne désespérée ou marginale s''en servirait pour forger des armes.');
INSERT INTO "item_descriptions" VALUES(9974,'fr','Si vous utilisez cette tailladeuse en combat, vous vous battrez comme un manche. Par contre, si vous vous en servez pour sculpter des manches, les tailleurs se retrouveront sur la paille, ce qui rendra les paysans mécontents.');
INSERT INTO "item_descriptions" VALUES(10054,'fr','Cet anneau a trempé pendant trois ans dans de la fiente de chauve-souris. Mais il est magique.');
INSERT INTO "item_descriptions" VALUES(10055,'fr','Cette amulette est censée prévenir les Vampyres qui voudraient vous mordre dans le cou, qu''il est tout simplement inutile d''essayer de vous sucer le sang, puisque vous êtes vous-même un Vampyre.');
INSERT INTO "item_descriptions" VALUES(10056,'fr','Sur le slogan publicitaire de cette ceinture vous pouvez lire "Et en plus elle brille la nuit !". Oui mais en plus de quoi ?');
INSERT INTO "item_descriptions" VALUES(10058,'fr','Bram avait raison, il faut toujours se méfier des personnes aux dents longues, surtout lorsqu''elles portent la cape du Vampyre.');
INSERT INTO "item_descriptions" VALUES(10061,'fr','On raconte qu''Elizabeth Bythora en personne a porté ces bottes. Ça vous fait une belle jambe.');
INSERT INTO "item_descriptions" VALUES(10073,'fr','Le mythique Dal-Uk-Wet, unificateur des royaumes de HispaÑia, avait un bouclier magique. Son arrière petit-fils, Sir-Dal, en fit forger quelques reproductions pour récompenser les meilleurs guerriers de HispaÑia. Ce bouclier est l''une de ces rares copies.');
INSERT INTO "item_descriptions" VALUES(10076,'fr','Le mythique Dal-Uk-Wet, unificateur du royaume de HispaÑia, concentrait tout son pouvoir dans son bouclier, au grand dam de ses adversaires. Des années plus tard, Sir-Dal, son arrière petit-fils, en fit forger quelques reproductions pour récompenser les meilleurs guerriers de HispaÑia, mais celui-ci est l''original, l''unique, le plus puissant de tous !');
INSERT INTO "item_descriptions" VALUES(10102,'fr','Ce masque vous protégera des rayons du soleil à défaut d''autre chose.');
INSERT INTO "item_descriptions" VALUES(10106,'fr','Cette terrible créature prendra un malin plaisir à sucer le sang de vos amis, ou celui de vos chevilles si elles sont un peu trop grosses. Mais cela ne suffira pas à la divertir pour autant, elle aime par dessus tout que vous affrontiez avec elle des squelettes pour se repaître de leurs dépouilles. On vous avait bien dit qu''elle était terrible.');
INSERT INTO "item_descriptions" VALUES(10000070,'fr','Cette terrible créature prendra un malin plaisir à sucer le sang de vos amis, ou celui de vos chevilles si elles sont un peu trop grosses. Mais cela ne suffira pas à la divertir pour autant, elle aime par dessus tout que vous affrontiez avec elle des squelettes pour se repaître de leurs dépouilles. On vous avait bien dit qu''elle était terrible.');
INSERT INTO "item_descriptions" VALUES(10107,'fr','Ce familier a eu une enfance très difficile, il a hérité d''un nom franchement stupide. C''est peut-être ce qui explique pourquoi il est devenu un peu fou et n''a plus qu''une seule obsession dans la vie, tuer toutes les Ouassingues qu''il rencontre pour se nourrir de leurs dépouilles.');
INSERT INTO "item_descriptions" VALUES(10125,'fr','Cet arc appartenait à un ancien bandit archer qui s''en servait pour achever ses victimes à distance, afin de ne pas se salir. Il est imprégné d''une magie si puissante que vous risquez de vous transformer en bandit archer si vous l''équipez...');
INSERT INTO "item_descriptions" VALUES(10126,'fr','Cette épée appartenait à un ancien bandit fine-lame, qui ne supportait pas de devoir poursuivre ses adversaires. Il commençait par leur couper les deux jambes et posait ses questions ensuite. Elle est imprégnée d''une magie si puissante que vous risquez de vous transformer en bandit fine-lame si vous l''équipez...');
INSERT INTO "item_descriptions" VALUES(10127,'fr','Ce bâton appartenait à un ancien bandit baroudeur, constamment ivre, il était incapable de faire les poches de ses victimes sans s''écrouler. Ce bâton lui permettait de tenir debout le temps qu''il termine son office. Il est imprégné d''une magie si puissante que vous risquez de vous transformer en bandit baroudeur si vous l''équipez.');
INSERT INTO "item_descriptions" VALUES(10133,'fr','Cette baguette appartenait à un ancien bandit ensorceleur, qui s''en servait pour réduire en cendres les ennemis qu''il voulait fumer. Elle est imprégnée d''une magie si puissante que vous risquez de vous transformer en bandit ensorceleur si vous l''équipez...');
INSERT INTO "item_descriptions" VALUES(10155,'fr','Cette amulette est censée vous protéger des décapitations aléatoires, et des oblitérations épilatoires.');
INSERT INTO "item_descriptions" VALUES(10156,'fr','Ces pantoufles sont plus confortables que des pantoufles ordinaires, mais vous ne saurez jamais exactement pourquoi. Peut-être que les milliers d''acariens masseurs qui y vivent y sont pour quelque chose.');
INSERT INTO "item_descriptions" VALUES(10157,'fr','Cette ceinture a été fabriquée à partir de chutes de ficelles de lin. Elle doit pouvoir servir à fermer les sacs poubelles.');
INSERT INTO "item_descriptions" VALUES(10158,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10159,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10160,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10161,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10162,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10163,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10164,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10165,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10166,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10167,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(10168,'fr','Ponch cirait ses bottes tous les matins avant de partir en mission sur sa Dragodinde pour sauver la veuve et l''orphelin, mais surtout la veuve... Un sacré charmeur ce Ponch.');
INSERT INTO "item_descriptions" VALUES(10169,'fr','Ponch portait fièrement ce bouclier sur sa dragodinde lorsqu''il veillait à la sécurité des ruelles de Bonta.');
INSERT INTO "item_descriptions" VALUES(10170,'fr','Ce casque permet de se protéger très efficacement des chutes de dragodindes ou de passer pour un idiot sans en être un.');
INSERT INTO "item_descriptions" VALUES(10171,'fr','Ces mitaines en cuir sont parfaites pour donner des fessées déculottées.');
INSERT INTO "item_descriptions" VALUES(10172,'fr','Cette amulette peut nourrir une limace vorpale pendant deux jours, ou trois jours si elle l''accompagne d''une purée de votre tête.');
INSERT INTO "item_descriptions" VALUES(10173,'fr','La semelle de ces bottes est recouverte d''une bave collante et l''intérieur est rempli d''une bave glissante. A moins que ça ne soit l''inverse.');
INSERT INTO "item_descriptions" VALUES(10174,'fr','Une bave gluante sort des pores de cette cape. Prenez un peu d''élan, allongez-vous sur le dos et laissez-vous glisser.');
INSERT INTO "item_descriptions" VALUES(10175,'fr','Ce masque gluant et baveux alimentera votre cuir chevelu en gomina de façon continue. Les deux yeux accrochés au masque peuvent être connectés à votre crâne si vous acceptez d''insérer les terminaisons nerveuses dans vos oreilles.');
INSERT INTO "item_descriptions" VALUES(10180,'fr','Ce médaillon est censé servir de clé pour accéder à une mystérieuse cité oubliée.');
INSERT INTO "item_descriptions" VALUES(10181,'fr','Cet anneau a été retrouvé dans une mystérieuse cité dont personne ne soupçonnait réellement l''existence jusqu''à ce que l''on commence à soupçonner son existence.');
INSERT INTO "item_descriptions" VALUES(10182,'fr','Ce bouclier absorbe les rayons du soleil et les renvoie directement dans le visage de vos adversaires. A défaut de les éblouir avec votre intelligence, vous les aveuglerez temporairement grâce à ce bouclier.');
INSERT INTO "item_descriptions" VALUES(10183,'fr','Ce masque captera les rayons de soleil et les concentrera sur votre visage pour que vous puissiez rester bronzé toute l''année, même si vous habitez au nord d''Amakna.');
INSERT INTO "item_descriptions" VALUES(10184,'fr','Noké aimait beaucoup revêtir ce masque et se cacher dans les bois pour effrayer les promeneurs égarés. Il est mort de peur il y a bien longtemps en se regardant dans une flaque d''eau.');
INSERT INTO "item_descriptions" VALUES(10185,'fr','Noké rêvait d''être un grand méchant loup. Même avec cette cape sur les épaules, il ne ressemblait qu''à un petit méchant.');
INSERT INTO "item_descriptions" VALUES(10186,'fr','Cette amulette en dents de sanglier effraiera les sangliers et par extension votre belle-mère.');
INSERT INTO "item_descriptions" VALUES(10187,'fr','Ces dagues ont servi jadis à dépecer un sanglier belliqueux qui rêvait d''être un cerf.');
INSERT INTO "item_descriptions" VALUES(10188,'fr','Cette coiffe fera de vous un excellent Wobot de protocole grâce à son dispositif unique qui permet de traduire à la volée les discussions des choux. C''est également un excellent casque insonorisant.');
INSERT INTO "item_descriptions" VALUES(10189,'fr','Cet anneau appartenait à un sabotier connu sous le surnom de "Le Glaude", dont il avait hérité après avoir fait un long voyage en trottant. Ses proches l''avaient surnommé "Le Glaude trotteur".');
INSERT INTO "item_descriptions" VALUES(10190,'fr','Si vous décidez de planter des choux, à la mode de chez nous, pensez à équiper ces bottines conçues pour ne pas écraser les choux. N''essayez pas de les utiliser pour danser avec votre partenaire, elles ne permettent pas d''éviter les écrasements de pieds.');
INSERT INTO "item_descriptions" VALUES(10191,'fr','Cette ceinture permet de contenir vos ballonnements après une indigestion de soupe aux choux.');
INSERT INTO "item_descriptions" VALUES(10414,'fr','Cette couronne est généralement portée le jour de la fête qui commémore l''anniversaire d''une illustre reine. Ses pouvoirs magiques sont très puissants, puisqu''elle permet de changer les couleurs de son porteur pour le rendre intégralement orange et ainsi lui permettre de facilement se cacher parmi tous les gens déguisés de couleur orange.');
INSERT INTO "item_descriptions" VALUES(10544,'fr','Cette créature venue d''ailleurs a été dressée par son ancien maître pour ne manger que les monstres issus de la famille des Blops. C''est peut-être ce qui explique son apparence surprenante ou son haleine de Blop.');
INSERT INTO "item_descriptions" VALUES(10000047,'fr','Cette créature venue d''ailleurs a été dressée par son ancien maître pour ne manger que les monstres issus de la famille des Blops. C''est peut-être ce qui explique son apparence surprenante ou son haleine de Blop.');
INSERT INTO "item_descriptions" VALUES(10552,'fr','Cette coiffe surprenante protégera efficacement vos oreilles du froid et des mauvaises blagues de vos amis.');
INSERT INTO "item_descriptions" VALUES(10553,'fr','Seul un boufbowler peut avoir l''idée saugrenue de se déguiser en tofu pour impressionner son ennemi. A moins qu''il ne s''agisse de fendre l''air comme personne grâce à la forme fuselée de ce chapeau. Quoiqu''il en soit, vous ne passerez pas inaperçu.');
INSERT INTO "item_descriptions" VALUES(10554,'fr','Les lunettes intégrées dans ce casque vous permettront de voir rouge et de vous sentir plus boufton que jamais.');
INSERT INTO "item_descriptions" VALUES(10555,'fr','Cet imposant bouclier porte les traces de nombreux matches. D''apparence robuste, il n''est pourtant d''aucune utilité dans un vrai combat, si ce n''est pour impressionner vos ennemis ou faire ami-ami avec des bouftous.');
INSERT INTO "item_descriptions" VALUES(10556,'fr','Cet imposant bouclier illustre parfaitement la fougue et l''insolence de la jeunesse. Tout dans l''apparence et rien dans le ventre. C''est le cas de le dire, il ne vous protégera de rien dans un vrai combat, sauf si votre adversaire vous attaque à coups de ballon.');
INSERT INTO "item_descriptions" VALUES(10557,'fr','Ce gantelet marqué par les années facilite la prise en main de ballon ou toute autre bestiole ronde recouverte de laine. Ce que vous en faites après ne regarde que vous.');
INSERT INTO "item_descriptions" VALUES(10558,'fr','Ce gantelet permettra au jeune Chienchien fou que vous êtes de jouer à la baballe comme un grand boufbowler.');
INSERT INTO "item_descriptions" VALUES(10559,'fr','Initialement conçue pour absorber les chocs lors de matches de boufbowl musclés, cette ceinture pourra aussi vous servir de bouée si d''aventure vous souhaitez prendre un bain. Quelle drôle d''idée.');
INSERT INTO "item_descriptions" VALUES(10560,'fr','Cette ceinture montre à quel point le boufbowl n''est pas un sport de fillette, d''où les protections judicieusement placées sous la ceinture pour éviter tout coup bas un peu trop bas. Idéal pour assurer l''entraînement de petits Srams.');
INSERT INTO "item_descriptions" VALUES(10561,'fr','Ces bottes ont vécu, et ça se sent. Avec elles, vous pourrez vous faire passer pour un grand boufbowler, et planter vos crampons dans le postérieur de quelques bouftous devant vos fans.');
INSERT INTO "item_descriptions" VALUES(10562,'fr','Ces bottes dans l''air du temps feront fureur auprès de tous les jeunes aventuriers fascinés par le boufbowl. Elles facilitent les chutes pour pouvoir plus facilement faire semblant d''avoir été poussé par un adversaire. Idéal pour apprendre les rudiments du sport.');
INSERT INTO "item_descriptions" VALUES(10622,'fr','Cette épée permettait à Grüt le Bwork de couper les noisettes de ses adversaires en deux, ce qui suffisait généralement pour les faire abandonner le moindre combat. Cette arme magique est encore imprégnée de la personnalité de Grüt. En l''équipant, vous pourrez peut-être l''incarner.');
INSERT INTO "item_descriptions" VALUES(10623,'fr','Grüt le Bwork n''était pas très malin. Il était même complètement stupide. Heureusement, les méthodes d''enseignement ancestrales fonctionnaient aussi bien sur les enfants que sur les Bworks. Quelques coups de bâton bien mérités ont fini par avoir raison de sa stupidité et au fil des années, Grüt est devenu juste un peu bête.');
INSERT INTO "item_descriptions" VALUES(10624,'fr','Ceux qui ont eu à affronter Grüt le Bwork vous le diront, "ne visez pas la tête, elle est vide". Ce conseil est valable pour tous ceux qui affrontent les Iops, les gobelins ou les belles-mères.');
INSERT INTO "item_descriptions" VALUES(10625,'fr','Les bottes de Grüt dégagent une odeur tellement répugnante, qu''elles peuvent étouffer vos adversaires d''un simple coup de pied à la tête. Ces bottes ont été interdites en combat par la convention de Sufokia il y a très longtemps. Personne ne reviendra sur cette décision qui a permis d''éviter de nombreuses morts atroces.');
INSERT INTO "item_descriptions" VALUES(10626,'fr','La vie d''un Chafer Fantassin n''est pas aussi facile que l''on pourrait l''imaginer. Mais comme personne n''a jamais réussi à imaginer comment vit un Chafer Fantassin, tout le monde s''en moque et s''imagine que sa vie est facile. C''est à cause de raisonnements aussi stupides que celui-ci, que le Chafer Fantassin est devenu un Chafer Fantassin. Cette arme magique est encore imprégnée de la personnalité de Kocksis. En l''équipant, vous pourrez peut-être l''incarner.');
INSERT INTO "item_descriptions" VALUES(10627,'fr','Kocksis le Chafer Fantassin avait de nombreux plaisirs plutôt malsains, comme manger des chips au vinaigre avec de la pâte à tartiner ou pire encore, manger des poils de Chacha. Nombreux sont ceux qui ont tenté de le ramener dans le droit chemin et se sont perdus sur le chemin du retour.');
INSERT INTO "item_descriptions" VALUES(10628,'fr','Rien de plus bruyant que le claquement des os sur un parquet en orme. Grâce à ces bottes, Kocksis le Chafer Fantassin pouvait danser l''Ankarmagniole toute la nuit sans craindre de réveiller les voisins, les morts, ni même les voisins morts.');
INSERT INTO "item_descriptions" VALUES(10629,'fr','Kocksis le Chafer Fantassin avait deux rêves dans sa vie : gravir la montagne des Craqueleurs et devenir ménestrel. La vie fût très cruelle avec lui, puisqu''il dû se contenter de faire les premières parties des concerts de Francisque Kabroule. Parfois le sort s''acharne sur vous. Cette fois-ci il s''est acharné sur celui de Kocksis.');
INSERT INTO "item_descriptions" VALUES(10630,'fr','Ce bâton ressemble étrangement à une lance, Gobeuf le Gobelin a fait monter une lame aiguisée au bout de ce bâton afin de pouvoir transpercer les œufs de Tofu à distance. Il est inutile de chercher une explication rationnelle derrière tout cela, les Gobelins ont tout simplement toujours eu des jeux étranges. Cette arme magique est encore imprégnée de la personnalité de Gobeuf. En l''équipant, vous pourrez peut-être l''incarner.');
INSERT INTO "item_descriptions" VALUES(10631,'fr','Voici une des devises les plus populaires chez les Gobelins : "parfois, c''est toi qui cognes le bar et parfois c''est le bar qui te cogne". En regardant attentivement les Gobelins, on pourrait résumer cette devise à "Parfois le bar te cogne".');
INSERT INTO "item_descriptions" VALUES(10632,'fr','Gobeuf le gobelin adorait gober les œufs en état de putréfaction avancée. Si son appareil digestif supportait sans problème cette fâcheuse habitude, les gens situés à proximité de son haleine putride tombaient comme des Mosquitos. Cette ceinture permettait à tous ses proches de se rattraper avant de s''écrouler lamentablement au sol.');
INSERT INTO "item_descriptions" VALUES(10633,'fr','Gobeuf le Gobelin était passionné par le jardinage, surtout lorsqu''il s''agissait de donner des coups de râteau sur les imprudents qui s''approchaient de ses terres. Il a trouvé cet anneau en ratissant le doigt d''un imprudent qui avait marché sur un de ses pieds de Salace.');
INSERT INTO "item_descriptions" VALUES(10634,'fr','Le Kanniboul Laikteur utilisait cette arme pour chasser ses proies et divertir ses enfants en leur envoyant quelques flèches dans les fesses lorsqu''il était de bonne humeur. Cette arme magique est encore imprégnée de l''âme du Kanniboul Laikteur. En l''équipant, vous pourrez peut-être parvenir à l''incarner.');
INSERT INTO "item_descriptions" VALUES(10635,'fr','Lorsque les deux petites boules accrochées à cette amulette s''entrechoquent, elles produisent un léger bruit de claquement qui vous permet d''être informé de l''arrivée d''un Kanniboul. Lorsque vous entendez ce bruit, il est généralement trop tard pour vous enfuir, mais il est encore temps de choisir à quelle sauce vous voulez être dévoré.');
INSERT INTO "item_descriptions" VALUES(10636,'fr','Cet anneau diffuse des épices afin d''aromatiser facilement le bouillon lorsqu''il est mélangé avec les mains. Ces épices sont si bonnes, qu''une fois cet anneau équipé, vous risquez de vous en mordre les doigts.');
INSERT INTO "item_descriptions" VALUES(10637,'fr','Le Kanniboul Laikteur a utilisé ces bottes pendant plusieurs années avant de les échanger contre un touriste de l''île de Moon. La faim justifie les moyens.');
INSERT INTO "item_descriptions" VALUES(10638,'fr','Le Pandit Rekto Topi utilisait cette épée en frappant ses adversaires avec le plat de la lame, afin de les assommer sans les taillader. Un seul coup bien placé suffisait généralement pour les envoyer directement au tapis. Cette arme magique est encore imprégnée de l''âme du Pandit Rekto Topi. En l''équipant, vous pourrez peut-être parvenir à l''incarner.');
INSERT INTO "item_descriptions" VALUES(10639,'fr','Rekto avait un frère, appelé Verso Litaire. Il aimait voyager seul et explorer les tunnels sombres qui ne sentent pas très bon.');
INSERT INTO "item_descriptions" VALUES(10640,'fr','Cette ceinture est censée être réversible mais personne n''a jamais osé utiliser l''autre face de peur de découvrir qu''elle n''est en fait pas réversible.');
INSERT INTO "item_descriptions" VALUES(10641,'fr','Rekto Topi a confectionné ces bottes lui-même, à partir de morceaux de bois et d''un peu de tissu. Elles ne ressemblent pas du tout à des bottes, mais qu''importe elles sont magiques tout de même.');
INSERT INTO "item_descriptions" VALUES(10642,'fr','Grizou le Mineur Sombre a utilisé cette pioche pour creuser la célèbre mine sans fond de Kruup, dans laquelle le Gaddie a vécu plusieurs années. Cette arme est encore imprégnée de l''âme de Grizou. En l''équipant, vous pourrez peut-être l''incarner.');
INSERT INTO "item_descriptions" VALUES(10643,'fr','Cet anneau change de couleur lorsqu''il est trempé dans du jus de Chmoule bouillant. C''est sûrement ce qui explique pourquoi Grizou le Mineur Sombre tenait autant à cet anneau.');
INSERT INTO "item_descriptions" VALUES(10644,'fr','La semelle magique de ces bottes permet de casser les blocs de charbon en envoyant les vibrations nécessaires à leur fragmentation. La notice indique qu''elles sont même capables de vibrer toutes seules dès qu''un son de Bouftonik est joué à proximité.');
INSERT INTO "item_descriptions" VALUES(10645,'fr','Cette ceinture renforcée à l''aide de nombreux métaux était assez solide pour supporter le poids des énormes bourses de Grizou le Mineur Sombre. Elle devrait convenir pour les bourses plus légères.');
INSERT INTO "item_descriptions" VALUES(10657,'fr','Cet étrange familier est issu du croisement des meilleurs chercheurs de truffes de tout Amakna. Son énorme groin lui permet de repérer l''Ogrine, même lorsqu''elle est cachée sous l''eau. Otomaï aurait mis plusieurs années à obtenir cette espèce et l''on raconte qu''il l''utiliserait pour réparer une de ses erreurs, retrouver ce qu''il aurait égaré ou laissé s''enfuir. Personne ne sait... La recherche d''Ogrine implique un processus physiologique si complexe et coûteux en énergie, que cette créature est obligée de consommer les âmes des monstres pour grandir. Elle a été élevée sur les plages de l''île d''Otomaï et ne dévore que les âmes des créatures qui y vivent.');
INSERT INTO "item_descriptions" VALUES(10685,'fr','Équipée de ce casque en or, votre tête sera rapidement mise à prix et vaudra son pesant d''or.');
INSERT INTO "item_descriptions" VALUES(10686,'fr','Cette cape en tissu, recouverte d''une fine couche d''or est magique. Elle attire les regards et renvoie la lumière directement dans les pupilles des fourbes qui tenteraient de vous poignarder par derrière. Indispensable si vous avez des amis Srams.');
INSERT INTO "item_descriptions" VALUES(10687,'fr','Cet anneau est si lourd qu''il augmente considérablement l''inertie de votre poing quand vous distribuez des claques à vos adversaires. Lorsque vous aurez commencé à punir les manants, il vous sera quasiment impossible de vous arrêter.');
INSERT INTO "item_descriptions" VALUES(10688,'fr','Cette ceinture est parfaite pour accrocher vos lingots d''or autour de votre taille, ils passeront inaperçus.');
INSERT INTO "item_descriptions" VALUES(10784,'fr','Personne ne sait exactement ce que vous apporte cette amulette, mais tout le monde sait ce qu''elle vous retire : votre crédibilité.');
INSERT INTO "item_descriptions" VALUES(10785,'fr','Cet anneau protégera vos doigts des crottes de nez de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(10794,'fr','Chaudes à l''intérieur et froides à l''extérieur, ces bottes vous permettront de botter les fesses des bonshommes de neige sans leur faire fondre le postérieur.');
INSERT INTO "item_descriptions" VALUES(10797,'fr','Sortie de son fourreau, cette épée peut couper le jambon, les Enutrofs, les unijambistes, les danseurs et les Enutrofs unijambistes enroulés dans une tranche de jambon qui dansent un soir de pleine lune. En revanche pour trancher les monstres, elle est plutôt inefficace.');
INSERT INTO "item_descriptions" VALUES(10798,'fr','Ce bouclier ne vous protégera pas de votre bêtise.');
INSERT INTO "item_descriptions" VALUES(10799,'fr','Vous n''arriviez pas à cacher votre épée ? Pas de problème, vous pourrez la coincer entre vos poignées d''amour et cette ceinture.');
INSERT INTO "item_descriptions" VALUES(10800,'fr','Cette cape permet de voler, il suffit de fermer les yeux, serrer les poings, ouvrir la bouche et sauter d''une falaise en écartant les bras tout en criant "je vole". Quelques instants plus tard, vous vous réveillerez avec deux jambes cassées.');
INSERT INTO "item_descriptions" VALUES(10801,'fr','Ce chapeau cache admirablement votre calvitie. Malheureusement, il n''en n''existe pas d''assez grand pour cacher votre fausse modestie.');
INSERT INTO "item_descriptions" VALUES(10802,'fr','Plus dorée que la Dragoune Noire, moins rose que la Dragoune Rose, et plus rare que la Dragoune Squelette, ce familier attirera tous les regards sur vous, même si vous êtes laid comme un Piou. Ce familier dévoreur d''âmes ne mange que les Dopeuls présents dans les temples de classe.');
INSERT INTO "item_descriptions" VALUES(10000045,'fr','Plus dorée que la Dragoune Noire, moins rose que la Dragoune Rose, et plus rare que la Dragoune Squelette, ce familier attirera tous les regards sur vous, même si vous êtes laid comme un Piou. Ce familier dévoreur d''âmes ne mange que les Dopeuls présents dans les temples de classe.');
INSERT INTO "item_descriptions" VALUES(10818,'fr','Cette arme d''apparence rudimentaire vous donnera l''impression de savoir vous battre.');
INSERT INTO "item_descriptions" VALUES(10828,'fr','Il est dit que le ridicule ne tue pas. C''est exact, mais avec ce casque vous aurez vraiment l''air ridicule.');
INSERT INTO "item_descriptions" VALUES(10830,'fr','Ikko, un célèbre artiste d''Amakna fut le premier à oser porter cette cape. Tout le monde lui répétait pourtant : "Quand c''est trop, c''est trop Ikko".');
INSERT INTO "item_descriptions" VALUES(10834,'fr','Il faut peu de choses pour que vous ressembliez à un Ouginak. Attention aux puces.');
INSERT INTO "item_descriptions" VALUES(10836,'fr','Vous portez fièrement cette amulette, symbole de votre participation à cette grande manifestation sportive. Il faut ça pour rester fier après être passé sous la mêlée du B.C Trool.');
INSERT INTO "item_descriptions" VALUES(10846,'fr','Pris d''une étrange frénésie, les tofus que vous croisez veulent se frotter contre votre jambe. Ce n''est tout de même pas cette cape qui les attire ?');
INSERT INTO "item_descriptions" VALUES(10847,'fr','Hulkrap enfilait ces bottes une fois par an, mais il les enlevait tous les jours. On peut donc en déduire que ces bottes sont magiques.');
INSERT INTO "item_descriptions" VALUES(10848,'fr','Ces bottes coquées peuvent servir d''enclumes. Son ancien propriétaire vous conseille vivement de ne pas danser avec.');
INSERT INTO "item_descriptions" VALUES(10849,'fr','Cette ceinture est fabriquée autour d''une armature métallique aimantée qui attire les bourses des imprudents qui oseraient se frotter à vous.');
INSERT INTO "item_descriptions" VALUES(10850,'fr','Klüme avait trois faiblesses, les araknes, les chatouilles et les araknes chatouilleuses.');
INSERT INTO "item_descriptions" VALUES(10851,'fr','Cette ceinture est encore recouverte de farine. Peut-être parce qu''elle servait de tablier à Kloug le Boulanger Sombre. A moins que ce ne soit la farine qu''il utilisait pour se poudrer le postérieur.');
INSERT INTO "item_descriptions" VALUES(10852,'fr','Hulkrap a jadis volé cette amulette à Gonztipay, un gobelin dénué de toute forme d''humour, même le plus lourd.');
INSERT INTO "item_descriptions" VALUES(10853,'fr','Cette amulette vous permet de pétrir la peau de votre cou sans utiliser vos mains.');
INSERT INTO "item_descriptions" VALUES(10854,'fr','Gontran Klüme le forgeron a échangé cet anneau contre une épée qui appartenait à la Dame Antium.');
INSERT INTO "item_descriptions" VALUES(10855,'fr','Cet anneau a été trempé dans une multitude de levures différentes. On raconte qu''il est capable de transformer en moisissure ceux qui le portent. Certains aventuriers ne perçoivent aucune différence après l''avoir porté.');
INSERT INTO "item_descriptions" VALUES(10856,'fr','Hulkrap était un très mauvais bandit rongé par les remords, il se sentait obligé de rendre ce qu''il avait volé. Cette arme magique est encore imprégnée de l''âme du Bandit Hulkrap. En l''équipant, vous pourrez peut-être parvenir à l''incarner.');
INSERT INTO "item_descriptions" VALUES(10857,'fr','Ce marteau a permis de forger une braguette en Kriptonite pour le Captain Chafer. Cette arme magique est encore imprégnée de l''âme du Forgeron Sombre Klüme. En l''équipant, vous pourrez peut-être parvenir à l''incarner.');
INSERT INTO "item_descriptions" VALUES(10858,'fr','Kloug aimait se montrer généreux en distribuant des pains à ceux qui osaient lui parler. Il utilisait cette baguette pour rendre son jugement et punir les innocents. Cette arme est encore imprégnée de la magie de Kloug le Boulanger Sombre. Vous pourrez peut-être réussir à l''incarner en utilisant cette arme.');
INSERT INTO "item_descriptions" VALUES(10863,'fr','Cette Arakne est vraiment très mal élevée, elle saute partout, elle crie, elle mord n''importe qui, mais vous l''aimez beaucoup sans savoir pourquoi. La nature l''a en outre dotée d''un appétit féroce, ce familier dévoreur d''âme adore attaquer puis dévorer les Moskitos et les Larves.');
INSERT INTO "item_descriptions" VALUES(10000068,'fr','Cette Arakne est vraiment très mal élevée, elle saute partout, elle crie, elle mord n''importe qui, mais vous l''aimez beaucoup sans savoir pourquoi. La nature l''a en outre dotée d''un appétit féroce, ce familier dévoreur d''âme adore attaquer puis dévorer les Moskitos et les Larves.');
INSERT INTO "item_descriptions" VALUES(10864,'fr','Ce Champ Champ pas comme les autres a été élevé par une meute de Mulous. Ça n''explique pas pourquoi il a du poil sous les aisselles. Ce familier dévoreur d''âmes adore les fruits de mer et ne mange que les créatures des plages.');
INSERT INTO "item_descriptions" VALUES(10000064,'fr','Ce Champ Champ pas comme les autres a été élevé par une meute de Mulous. Ça n''explique pas pourquoi il a du poil sous les aisselles. Ce familier dévoreur d''âmes adore les fruits de mer et ne mange que les créatures des plages.');
INSERT INTO "item_descriptions" VALUES(10865,'fr','Ce Tofu a reçu la foudre 11 fois durant sa croissance. Vous recevrez des décharges électriques si vous le caressez et il vous foudroiera si vous ne le caressez pas. Pour une fois vous avez le choix. Ce dévoreur d''âme adore les rats et s''en nourrit dès que l''occasion se présente à lui.');
INSERT INTO "item_descriptions" VALUES(10866,'fr','Ce familier aime les cœurs d''artichauts au sang de Rasboul, les endives aux poils de Bitouf, et les chansons de Francisque Kabroule. Il semble également apprécier votre compagnie. Ce dévoreur d''âme ne mange que les créatures de la Jungle Obscure.');
INSERT INTO "item_descriptions" VALUES(10000067,'fr','Ce familier aime les cœurs d''artichauts au sang de Rasboul, les endives aux poils de Bitouf, et les chansons de Francisque Kabroule. Il semble également apprécier votre compagnie. Ce dévoreur d''âme ne mange que les créatures de la Jungle Obscure.');
INSERT INTO "item_descriptions" VALUES(10899,'fr','Le Manitou Zoth était un ancien manutentionnaire, il déplaçait les problèmes au lieu de les résoudre. Mais qu''importe, il était craint au sein de la communauté des Zoths et criait plus fort que tous les autres, ce qui suffit pour être chef chez les Zoths. Ce bâton est encore animé par l''âme du Manitou Zoth. Vous pourrez peut-être réussir à l''incarner en utilisant cette arme.');
INSERT INTO "item_descriptions" VALUES(10904,'fr','Cette amulette témoigne de votre incontestable capacité à casser les œufs sans faire d''omelettes.');
INSERT INTO "item_descriptions" VALUES(10906,'fr','Façonné à partir d''une écaille de Grozilla, ce lourd bouclier est d''une prestance exceptionnelle. Seuls de rares et redoutables combattants arborent fièrement ce pavois.');
INSERT INTO "item_descriptions" VALUES(10922,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10923,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10924,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10925,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10926,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10927,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10928,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10929,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10930,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
