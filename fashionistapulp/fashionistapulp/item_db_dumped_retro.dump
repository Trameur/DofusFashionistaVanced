INSERT INTO "item_descriptions" VALUES(100,'es','Este anillo refuerza la sabiduría de su portador.');
INSERT INTO "item_descriptions" VALUES(101,'es','Este anillo refuerza la sabiduría de su portador.');
INSERT INTO "item_descriptions" VALUES(102,'es','Este anillo refuerza la sabiduría de su portador.');
