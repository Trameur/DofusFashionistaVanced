INSERT INTO "item_descriptions" VALUES(12792,'pt','Esta arma lhe foi emprestada por Notend Less, que viu potencial em você... Bom... na verdade foi seu lado “bobo da feira” que ele viu. Não é bem um elogio... De qualquer forma, com ela você pode apropriar-se temporariamente das características de uma classe, o que não é nada mal.');
INSERT INTO "item_descriptions" VALUES(12793,'pt','Esta arma lhe foi emprestada por Notend Less, que viu potencial em você... Bom... na verdade foi seu lado “bobo da feira” que ele viu. Não é bem um elogio... De qualquer forma, com ela você pode apropriar-se temporariamente das características de uma classe, o que não é nada mal.');
INSERT INTO "item_descriptions" VALUES(12794,'pt','Confeccionado com os restos de dozeanos, esse escudo encantará os adeptos da reciclagem e do lixo zero. Mas não se preocupe, todos os ossos estão completamente limpos: eles foram cuidadosamente roídos durante horas por uma horda de carniceiros vorazes. Viu? Não tem nada com o que se preocupar.');
INSERT INTO "item_descriptions" VALUES(12795,'pt','Pode confiar: depois de entender como utilizá-lo sem se perfurar ou perder um dedo, esse escudo se tornará seu acessório de combate preferido.');
INSERT INTO "item_descriptions" VALUES(12796,'pt','Essa é, provavelmente, a invenção mais maliciosa (e maligna) que já saiu da mente de um Brakmariano. Seus chifres afiados foram posicionados em lugares estratégicos e espetam tudo o que estiver a menos de 30 centikametros de você. Só tome cuidado com uma coisa: lembre-se de retirá-la quando for cumprimentar seus amigos.');
INSERT INTO "item_descriptions" VALUES(12797,'pt','Essa capa foi tecida com um manto que pertencia a um pequeno demônio. Ele foi arrancado sem dó das suas mãos, enquanto estava tendo seus doces pesadelos. Ao perceber, o demônio gritou “Skribidibeudu reugneugneu scrouchniou boudoudoudi oh ”, o que não vamos traduzir para não corrermos o risco de não conseguir dormir à noite.');
INSERT INTO "item_descriptions" VALUES(12798,'pt','Desde sempre os Iops usam a cabeça para se defender. Agora, eles também poderão usar esse escudo. Uma nova linhagem de guerreiros vermelhos, com a cabeça um pouco menos amassada, está prestes a surgir...');
INSERT INTO "item_descriptions" VALUES(12799,'pt','Olhar para os outros de cima (com o maior olhar de desprezo, é claro) é um esporte nacional entre certos bontarianos. Como se não bastasse, um deles inventou uma capa alada na esperança de se colocar ainda mais acima dos outros. Um desastre total, mas é uma capa que faz jus ao seu nome, já que as penas utilizadas para a sua confecção provocam coceiras insuportáveis.');
INSERT INTO "item_descriptions" VALUES(12800,'pt','Esse chapeu bontariano dá a ilusão de que você possui um espírito puro. Tem gente que vai pensar que você veio direto do Ingloriom, sendo o(a) portadora da mensagem divina, anuciador(a) de boas novas ou, até mesmo, o(a) escolhido(a). Mas, na realidade, sua única intenção é massacrar todos que cruzarem seu caminho para alcançar a glória e provar, de uma vez por todas, que você é o(a) melhor.');
INSERT INTO "item_descriptions" VALUES(12801,'pt','Os altos dignatários do exército bontariano e os melhores ferreiros de Bonta trabalharam lado a lado para criar esse prestigioso escudo. Uma cabeça de felino gravada em um coração de ouro cindido por uma espada resplandescente. Nada consegue ser mais belo que isso para os defensores da Cidade Branca. Nada consegue ser mais, a propósito.');
INSERT INTO "item_descriptions" VALUES(12809,'pt','O Trool raspa a cabeça a cada cinco anos, quando as pontas da sua juba já estão mais secas que as unhas dos seus pés. Sem dúvida foi preciso muita paciência para confeccionar esta capa que parece ter sido feita sob medida para você.');
INSERT INTO "item_descriptions" VALUES(12810,'pt','Não dá para acreditar que combina com você... Não, sério, você parece uns dez anos mais jovem. Verdade, você nunca esteve tão atraente... O quê? Ah! Então tá, se é assim, não vou mais elogiar!');
INSERT INTO "item_descriptions" VALUES(12811,'pt','Este escudo lhe traz lembranças das longas sessões de tortura nas salas obscuras de calabouços sinistros. Mantenha-o longe das crianças. A não ser que você queira ensiná-las que, na vida, o perigo está por toda parte...');
INSERT INTO "item_descriptions" VALUES(12812,'pt','Ele fez o juramento de te proteger! (Até 1º de fevereiro, às 23h59, horário de Paris)');
INSERT INTO "item_descriptions" VALUES(12814,'pt','Sua energia interior é preciosa. Se você for capaz de dominá-la, ela lhe permitirá realizar grandes feitos. Mas se deixá-la transbordar, acabará consumindo você por inteiro. Essa capa, assim como a ira de Vlad Sombrio, pode ser devastadora. Dedique-se a dominá-la, caso contrário ela levará você a cometer o pior...');
INSERT INTO "item_descriptions" VALUES(12815,'pt','É preciso ser realmente cabeça quente para assumir o risco de vestir esse chapéu. Dito isso, é um risco que vale a pena correr... Costuma-se dizer que assim que você o coloca na cabeça, o chapéu Espírito Petulante faz nascer em você uma ira tão grande que torna você capaz de mover montanhas. Não, sério... capaz de REALMENTE mover montanhas. Onde você vai colocar uma montanha? Ah, se vira!');
INSERT INTO "item_descriptions" VALUES(12816,'pt','Esse escudo espelha perfeitamente o estado de espírito de Vlad Sombrio: incisivo e sanguinário. Com ele você poderá proteger sua retaguarda enquanto desce a porrada nos seus adversários. Ele também é muito prático para coçar a orelha, se você tiver a delicadeza necessária.');
INSERT INTO "item_descriptions" VALUES(12817,'pt','No começo você pode achá-la aterrorizante. Levar um susto toda vez que ela aparecer. E estar com ela ao seu lado provavelmente lhe causará calafrios e até mesmo enjôos. Mas dê tempo ao tempo... Daqui a pouco você não vai conseguir viver sem ela. Você vai estar enchendo a infame carinha dela de carinho e fazendo cócegas naquelas asinhas imundas. E amando cada segundo! A gente se acostuma com cada coisa...');
INSERT INTO "item_descriptions" VALUES(12818,'pt','O Ursolar sempre foi leal ao Papai Nowel e será a você também. Graças à pelagem quentinha, você nunca mais vai sentir frio, nem nas ilhas mais glaciais. Coce a barriguinha dele de tempos em tempos para aquecê-lo.');
INSERT INTO "item_descriptions" VALUES(12827,'pt','Esse certificado permite a você pegar sua montaria no estábulo. Aviso! Esse certificado é válido apenas por 20 dias. Quando o tempo acabar, sua montaria será solta para a natureza e seu certificado não terá mais validade. Você não poderá recuperar sua montaria. Sempre deixe sua montaria no estábulo se você for ficar longe durante muito tempo.');
INSERT INTO "item_descriptions" VALUES(12833,'pt','O armeiro que fez este capacete devia ter uma admiração infinita pelos dragões. Pode ser até que ele tenha sido devorado por um de tanto que ele andava com eles.');
INSERT INTO "item_descriptions" VALUES(12834,'pt','Este manto faz você se lembrar de como você pode ter estilo, ser do mal, mas, acima de tudo, ser mais forte do que todos os outros... Ei, quando foi mesmo a sua última vitória?');
INSERT INTO "item_descriptions" VALUES(12835,'pt','Diz a lenda que Daskartas foi o rei de uma civilização esquecida. Os mais religiosos acreditavam que conseguiam influenciar o destino em seu favor se colocassem muita fé em alguma coisa. Se quer minha opinião, isso não passa de um placebo.');
INSERT INTO "item_descriptions" VALUES(12836,'pt','Este elmo é de uma qualidade impressionante: além de fornecer uma boa proteção, ele brilha no sol a ponto de ofuscar os adversários.');
INSERT INTO "item_descriptions" VALUES(12837,'pt','Inspirada nos tecidos usados pelos imperadores mais prestigiosos, esta capa aumenta significativamente seu status social em relação aos outros. Mas cuidado para não tropeçar nela... Você cairia rapidamente, e não apenas no sentido figurado.');
INSERT INTO "item_descriptions" VALUES(12838,'pt','Este grande escudo serve para bloquear ataques, distribuir golpes de escudo, ser usado como mesa de piquenique, proteger da chuva... Exatamente nessa ordem.');
INSERT INTO "item_descriptions" VALUES(12846,'pt','Este escudo protegerá você de muitas coisas, menos do seu próprio furor agressivo!');
INSERT INTO "item_descriptions" VALUES(12847,'pt','Quando você usa este gorro, não se pode dizer que o que há debaixo deste pinheiro é um presente.');
INSERT INTO "item_descriptions" VALUES(12848,'pt','Quando você usa este gorro, não se pode dizer que o que há debaixo deste pinheiro é um presente.');
INSERT INTO "item_descriptions" VALUES(12849,'pt','Quando você usa este gorro, não se pode dizer que o que há debaixo deste pinheiro é um presente.');
INSERT INTO "item_descriptions" VALUES(12850,'pt','Este chapéu tem uma vantagem única: caso acabe se afogando, será possível identificar você de longe. Bom, já vai ser tarde demais, mas fazer o quê?');
INSERT INTO "item_descriptions" VALUES(12851,'pt','Ah, então é isso que chamam de ”mexido de frutos do mar”?');
INSERT INTO "item_descriptions" VALUES(12852,'pt','É impossível afundar este escudo. Agora você nunca mais precisa ter medo de água, nem mesmo nas situações mais perigosas.');
INSERT INTO "item_descriptions" VALUES(12853,'pt','Lembra daquela época em que a gente sabia aproveitar os pequenos prazeres da vida e se contentava com pouco? Quando uma laranja e um cajado era o suficiente para ficarmos felizes? Uma época marcada pela pobreza, mas que os dozeanos continuavam a sorrir mesmo cheios de privações... Nessa época, um deles teve a brilhante ideia de criar um chapéu feito totalmente de palha. E adivinha só? Conseguiu fazer um baita pé de meia. Enfim... São os pequenos prazeres da vida...');
INSERT INTO "item_descriptions" VALUES(12854,'pt','Usado pelos maiores agricultores do Mundo dos Doze, incluindo o trovador Vandja, essa capa se tornou um verdadeiro ícone da moda sertaneja. Uma notoriedade que permitiu ao seu criador nunca mais olhar para palha.');
INSERT INTO "item_descriptions" VALUES(12855,'pt','Nada como um fardo de palha bem compactada para nocautear seu adversário. Ela pinica, coça e, com um pouco de sorte, ainda tem um ou dois ratos do campo dentro, preparados para pular no pescoço do primeiro que aparecer para tirá-los de lá.');
INSERT INTO "item_descriptions" VALUES(12856,'pt','Está no fundo do poço? Este chapéu é o raio de esperança que você precisa para sair do buraco, sua luz no fim do túnel.');
INSERT INTO "item_descriptions" VALUES(12857,'pt','Não precisa cavar mais fundo, esta capa é perfeita para ser usada enquanto você enterra seus inimigos a sete palmos do chão.');
INSERT INTO "item_descriptions" VALUES(12858,'pt','Está no fundo do poço? Este chapéu é o raio de esperança que você precisa para sair do buraco, sua luz no fim do túnel.');
INSERT INTO "item_descriptions" VALUES(12859,'pt','O formato desse chapéu não é por acaso. Sua ponta foi planejada para conectar o cérebro do seu usuário aos espíritos divinos, cujo conhecimento é muitas vezes superior ao dos dozeanos. Dessa forma, alquimistas e outros adeptos das ciências ocultas almejam ganhar sabedoria, recorrendo diretamente ao conhecimento dos magos e dos deuses. Muito esperto! Ou totalmente absurdo e fora da casinha...');
INSERT INTO "item_descriptions" VALUES(12860,'pt','Com esse acessório você poderá levar consigo, para onde quer que vá, todos os utensílios necessários para preparar diversas poções e elixires, mas também geléias, bolos, tortas e outras preparações que requerem o uso de uma espátula e conhecimentos em química.');
INSERT INTO "item_descriptions" VALUES(12861,'pt','Quando os alquimistas não estão com a cabeça em seus tubos de ensaio, estão com ela em seus grimórios. Estudar, aperfeiçoar, sem parar, mais e mais... Não se engane, o lugar desses pesquisadores iluminados é em um laboratório, não em um campo de batalha. Com esse escudo eles conseguem matar dois pássaros com uma só pedra filosofal: continuar estudando enquanto se protegem dos ataques inimigos. Haja imaginação!');
INSERT INTO "item_descriptions" VALUES(12862,'pt','Vamos deixar os preconceitos de lado: um lenhador é um homem com um grande coração. Ele não se contenta em passar o dia cortando árvores com seus pesados golpes de machado, entoando gritos viris e roucos. Antes de dar o golpe final no tronco marcado com um “X” vermelho, ele abraça a árvore com seus grandes braços musculosos para lhe proporcionar um último abraço. Vale notar que esse é um favor que ele não concede a nenhuma de suas outras vítimas.');
INSERT INTO "item_descriptions" VALUES(12863,'pt','Essa capa com um machado incluso é uma ferramenta multifuncional por excelência, indispensável para todos os que adoram arriscar a vida se aventurando nas florestas. Ela livrará você de inúmeras situações delicadas. Atravessar um caminho tomado por sarças, afiar uma lâmina, cortar uma bela fatia de salsicha de Porco Imundo ou, quem sabe, aparar uma unha comprida demais: as possibilidades são infinitas. Dizem que serve até mesmo para cortar lenha! É de tirar o fôlego...');
INSERT INTO "item_descriptions" VALUES(12864,'pt','Duas ou três tábuas de madeira velha cheias de farpas, alguns pregos enferrujados e um bom martelo: esse é, sem dúvida, um escudo muito simples de ser construído. E, no entanto, tão eficaz quanto os modelos mais modernos! Atenção, certifique-se de estar com as vacinas em dia para manipulá-lo.');
INSERT INTO "item_descriptions" VALUES(12865,'pt','O chapéu perfeito para os dias em que seu humor varia entre Au-au e Boolobo.');
INSERT INTO "item_descriptions" VALUES(12866,'pt','Sim, esta capa tem cheiro de bicho morto. Você esperava o quê?');
INSERT INTO "item_descriptions" VALUES(12867,'pt','Com este escudo, quem tentar passar a perna em você vai acabar só o osso.');
INSERT INTO "item_descriptions" VALUES(12868,'pt','Ao dar de cara com o Homem Misterioso, todo mundo se pergunta por que ele está sempre com uma colher. Ninguém nunca desvendou esse mistério, mas cada um tem sua teoria. Um amuleto da sorte? Uma lembrança? Um objeto que o lembra que ele não está sonhando? Entretanto, para a maioria, ela representa o toque final da personalidade intrigante desse homem diferente.');
INSERT INTO "item_descriptions" VALUES(12869,'pt','A modéstia do Homem Misterioso sempre foi comparável a sua elegância. Em um mundo onde todo mundo anda igual, ele sabe se manter fiel a si mesmo e impõe seu estilo por onde passa. Se você o vir um ia no Mundo dos Doze ou no Externam, vai notar de cara a elegância do sujeito. Classe não se compra.');
INSERT INTO "item_descriptions" VALUES(12870,'pt','Dizem que o Homem Misterioso e seu acólito cabeludo passam a vida testando a resistência de todos os objetos que recebem. Entretanto, nunca se atrasam na hora de dar um intervalo para trocar uma ideia e fofocar. Isso deve ser graças a esse enorme relógio que indica sempre a hora certa. Afinal, um gentleman se distingue muitas vezes pela pontualidade.');
INSERT INTO "item_descriptions" VALUES(12871,'pt','Totalmente imune aos cheiros, este chapéu vai proteger seus cabelos das fragrâncias tenazes do mar.');
INSERT INTO "item_descriptions" VALUES(12872,'pt','Este escudo vai irritar tanto seus adversários quanto o já famoso ditado: “O Pesk morre pela boca”.');
INSERT INTO "item_descriptions" VALUES(12873,'pt','Graças a esta capa, você poderá empanar seus inimigos na farinha de rosca sem se sujar.');
INSERT INTO "item_descriptions" VALUES(12874,'pt','Este gorro imponente te dá o maior moral. Com ele, você vai tocar as tropas com uma mão na frente e a outra atrás!');
INSERT INTO "item_descriptions" VALUES(12875,'pt','Não levar este escudo a um combate é correr o risco de passar um perrengue daqueles!');
INSERT INTO "item_descriptions" VALUES(12876,'pt','Esta capa foi criada diretamente no âmbar que pertence ao Carvalho Mole. O inseto que ficou preso ali dá a ela um pequeno toque de originalidade que tem lá o seu charme.');
INSERT INTO "item_descriptions" VALUES(12877,'pt','Este chapéu é pesado, é claro, mas ela vai proteger o que você tem de mais precioso. Não... Seu cérebro, não seus cabelos...');
INSERT INTO "item_descriptions" VALUES(12878,'pt','Útil contra os aventureiros maldosos mas com frases lapidares, este escudo também protege as suas joias de família.');
INSERT INTO "item_descriptions" VALUES(12879,'pt','E aí? Quem disse que em casa de sapateiro o chinelo é de pau? Ah!');
INSERT INTO "item_descriptions" VALUES(12880,'pt','Uma capa reservada aos aventureiros que têm o couro resistente.');
INSERT INTO "item_descriptions" VALUES(12881,'pt','Pesado e robusto, este escudo é uma resposta eficaz àqueles que vêm curtir com a sua cara.');
INSERT INTO "item_descriptions" VALUES(12882,'pt','Como uma vela, esta capa vai te ajudar a manter o rumo mesmo quando bater aquela vontade de partir para longe.');
INSERT INTO "item_descriptions" VALUES(12939,'pt','Sob este elmo imponente talvez se escondam os traços delicados de um rosto poupado pelas chamas. Mas não vamos apostar nisso.');
INSERT INTO "item_descriptions" VALUES(12940,'pt','Morbido come la stoffa e solido come l''acciaio, questo mantello nato dalle fiamme veste solo i fabbri che hanno una certa tempra.');
INSERT INTO "item_descriptions" VALUES(12941,'pt','Este escudo é aproximadamente tão elegante quanto uma folha de aço martelada. No entanto, ele protege dos ataques tão bem quanto uma folha de aço martelada.');
INSERT INTO "item_descriptions" VALUES(12942,'pt','A madeira é um material nobre que não deve ser inalado! Então, proteja-se da poeira tapando o nariz e a boca com este lenço luxuoso.');
INSERT INTO "item_descriptions" VALUES(12943,'pt','I tuoi amici ti hanno ripetuto spesso che era assurdo voler fabbricare un mantello di legno. E avevano ragione!');
INSERT INTO "item_descriptions" VALUES(12944,'pt','Este escudo feito de madeira reciclada contém pedaços oriundos de mais de cem árvores diferentes. Muitas florestas ficariam com inveja de você!');
INSERT INTO "item_descriptions" VALUES(12945,'pt','Este chapéu esconde em seu interior tantas ferramentas de costura que nunca lhe faltará material para remendar seu conjunto preferido em caso de acidente.');
INSERT INTO "item_descriptions" VALUES(12946,'pt','Com seu forro de seda macia, esta capa não sacrifica o conforto em nome da estética. É muito simples: você tem vontade de se enrolar nela e nunca mais sair!');
INSERT INTO "item_descriptions" VALUES(12947,'pt','É uma pena que este escudo só possa ser usado em uma única batalha... Qualquer rasguinho acaba com seu estetismo refinado, então ele logo teria que ser substituído.');
INSERT INTO "item_descriptions" VALUES(12948,'pt','Estes óculos protegerão seus olhos frágeis das ideias brilhantes que iluminam diariamente o seu ateliê.');
INSERT INTO "item_descriptions" VALUES(12949,'pt','Esta é a brincadeira perfeita para crianças pequenas e Iops adultos: tentar adivinhar todos os diferentes objetos que compõem esta capa. Horas de diversão garantidas!');
INSERT INTO "item_descriptions" VALUES(12950,'pt','Este item personalizado é ao mesmo tempo um escudo, um barômetro, um nível de bolha e um esconderijo secreto para o seu lanche. Tudo ao alcance da sua mão, caso precise!');
INSERT INTO "item_descriptions" VALUES(12951,'pt','De que adianta ser forjamago se não for para ser reconhecido imediatamente como tal aonde quer que você vá? Este chapéu mágico deixará isso bem claro!');
INSERT INTO "item_descriptions" VALUES(12952,'pt','Cada milikametro de tecido desta capa luxuosa é recoberto de minúsculas fórmulas mágicas. Infelizmente, são tão pequenas que não podem ser vistas a olho nu. Que pena.');
INSERT INTO "item_descriptions" VALUES(12953,'pt','Esta runa gigantesca, usada como escudo, lembrará você a cada instante de que é preciso ler com muita atenção os anúncios de vendas por correspondência...');
INSERT INTO "item_descriptions" VALUES(12954,'pt','Nenhum Ladfox foi ferido na confecção deste chapéu... Pelo menos foi o que o artesão garantiu a Mogueta quando ela lhe deu um Ladfox de sua criação em troca de alguns novelos de lã para fazer bicho de pelúcia. Entretanto, diante do ligeiro cheiro de sangue, é normal ter dúvidas...');
INSERT INTO "item_descriptions" VALUES(12955,'pt','Sua dedicação lhe rendeu este capacete. Ele vai proteger suas orelhas, mas não serve para usar na Ronconeta.');
INSERT INTO "item_descriptions" VALUES(12956,'pt','Como saída de outra época, esta capa toca uma musiquinha hipnótiza. As pessoas passam olhando para você. Algumas reconhecem a melodia, mas não sabem onde ouviram...');
INSERT INTO "item_descriptions" VALUES(12957,'pt','Dizem que os espelhos são reflexos de um outro mundo. Parece ser o caso deste escudo, e, se quebrá-lo, você terá sete anos de azar. Diz a pessoa que o criou que é uma versão melhorada de um escudo antigo muito raro e feio.');
INSERT INTO "item_descriptions" VALUES(12958,'pt','Este velho chapéu de pergamante parece ter sido usado por muita gente antes de você. Ele cheira a poeira e pergaminho antigo. Nem adianta colocá-lo na cabeça de alguém para tentar adivinhar seu futuro, pois não vai funcionar.');
INSERT INTO "item_descriptions" VALUES(12959,'pt','Esta esplêndida capa de pergamante poderia lhe dar a aparência de um mero discípulo dos arcanos. Mas as aparências podem enganar. Dizem até que um mago que usava uma capa semelhante a esta mudou de cinza para branco depois de ser promovido dentro de sua ordem.');
INSERT INTO "item_descriptions" VALUES(12960,'pt','Para os ferozes guerreiros, o escudo é um equipamento indispensável para se proteger no combate. Para um pergamante, às vezes uma cola é necessária para se lembrar dos encantamentos mais loucos.');
INSERT INTO "item_descriptions" VALUES(12961,'pt','Faça chuva ou faça sol, este elmo protegerá sua cachola de golpes.');
INSERT INTO "item_descriptions" VALUES(12962,'pt','Se não apara estocadas, esta capa pelo menos aquecerá você em todas as circunstâncias. Ideal para a neve!');
INSERT INTO "item_descriptions" VALUES(12963,'pt','"A melhor defesa é o ataque." Quem falou isso nunca deve ter visto este escudo. Ele é tão sólido que vai deixar você mais tranquilo nas usas aventuras.');
INSERT INTO "item_descriptions" VALUES(13015,'pt','Este chapéu te deixa bem pouco atraente. Use nos dias em que você não estiver a fim de ficar na fila da padaria.');
INSERT INTO "item_descriptions" VALUES(13016,'pt','Uma capa preta que combina com tudo. Principalmente com outras coisas da mesma cor.');
INSERT INTO "item_descriptions" VALUES(13017,'pt','Inspirado no Dofus Ébano, este escudo requer uma manutenção regular à base de cera de ouvido de bwork, cuja aplicação deve ser feita com um pincel macio. Pois é... a madeira tem vida, você queria o quê?!');
INSERT INTO "item_descriptions" VALUES(13018,'pt','Já vem com uma plaquinha “Cuidado, mascote brava”.');
INSERT INTO "item_descriptions" VALUES(13019,'pt','Este chapéu vai te deixar tão sábio(a) quanto o dragão Dardondakal. A gente gostaria de dizer: até que enfim!');
INSERT INTO "item_descriptions" VALUES(13020,'pt','Esta capa fica toda suja rapidinho. Não esqueça de retirar antes comer pratos com molhos.');
INSERT INTO "item_descriptions" VALUES(13021,'pt','Réplica perfeita do Dofus Marfim, este escudo vai garantir sua defesa (marfim, defesa... Você tem isso aí?).');
INSERT INTO "item_descriptions" VALUES(13022,'pt','Esta mascote fica o tempo todo dando lição de moral nos outros, o que tem a vantagem de afastar os seus inimigos. E o inconveniente de te fazer morrer de vontade de se empanturrar de sikecis...');
INSERT INTO "item_descriptions" VALUES(13023,'pt','Fique alerta: este chapéu pode transformar todas as suas conversas em grandes papagaiadas.');
INSERT INTO "item_descriptions" VALUES(13024,'pt','Ah! Faltava justamente uma capa para você participar do concurso anual de grasnada de gaivotas!');
INSERT INTO "item_descriptions" VALUES(13025,'pt','Réplica exata do Dofus Esmeralda, este escudo é uma verdadeira joia de ourivesaria.');
INSERT INTO "item_descriptions" VALUES(13026,'pt','Esta mascote fica o tempo todo dando lição de moral nos outros, o que tem a vantagem de afastar os seus inimigos. E o inconveniente de te fazer morrer de vontade de se empanturrar de sikecis...');
INSERT INTO "item_descriptions" VALUES(13027,'pt','E aí? Qual é a sensação de ter a cara de um chum de Dathura?');
INSERT INTO "item_descriptions" VALUES(13028,'pt','Você precisa desta capa inspirada no dragão da água para dar nó em pingo d''água!');
INSERT INTO "item_descriptions" VALUES(13029,'pt','Graças a este escudo, cada tentativa de ataque dos seus adversários vai acabar dando com os burros n''água.');
INSERT INTO "item_descriptions" VALUES(13030,'pt','Esta mascote de aspecto tranquilo e pacífico é a prova, mais uma vez, de que a gente tem que desconfiar de águas muito calmas...');
INSERT INTO "item_descriptions" VALUES(13031,'pt','Se, assim que colocar este chapéu, uma vontade louca de construir um ninho no topo de uma Árvore Hakam tomar conta de você, não entre em pânico: isso é totalmente normal. É uma ideia estúpida, porém normal.');
INSERT INTO "item_descriptions" VALUES(13032,'pt','Com asas suficientemente grandes para te deixar imponentes, mas muito pequenas para que possa voar, esta capa permitirá que você mantenha os pés no chão. Muito esperto.');
INSERT INTO "item_descriptions" VALUES(13033,'pt','Luminoso, este escudo inspirado no Dofus Ocre capta os raios de sol para conferir uma cútis brilhante a quem o possuir.');
INSERT INTO "item_descriptions" VALUES(13034,'pt','Esta mascote fica o tempo todo ciscando a terre em busca de tesouros preciosos. Até agora, ela só encontrou meia bolota e um rato morto. Bom... A conferir.');
INSERT INTO "item_descriptions" VALUES(13035,'pt','Este chapéu vai te deixar com um olhar penetrante. Seus inimigos vão poder ler nos seus olhos sua temeridade. E também a hora da morte deles. Às 2h23 da tarde (talvez um pouquinho antes ou depois, é claro).');
INSERT INTO "item_descriptions" VALUES(13036,'pt','Esta capa flamejante que flameja. Não, isso é tudo, pode ir.');
INSERT INTO "item_descriptions" VALUES(13037,'pt','ATENÇÃO! VAI PEGAR FOGO! Quer dizer, nada, não.');
INSERT INTO "item_descriptions" VALUES(13038,'pt','Dizem que a respiração dela misturada com a água de um lago encantado permitiria forjar a mais sólida das espadas.');
INSERT INTO "item_descriptions" VALUES(13039,'pt','Gultar sempre teve bom gosto. Por exemplo, ele teve a ingênua idéia de prender as correntes usadas para assassinar sua família na ponta de sua espada... Bonito, não é? Muito mais eficiente que uma lâmina normal, esta espada permite que você faça a barba bem rente aos seus inimigos. Uma lâmina quebrada para maior precisão.');
INSERT INTO "item_descriptions" VALUES(13040,'pt','Este chapéu permite que você jogue um dado de 20 faces para tomar cada decisão importante na sua vida. Só tome cuidado com as falhas críticas...');
INSERT INTO "item_descriptions" VALUES(13041,'pt','Você sempre sonhou em se parecer com o belo e valente Gultar? Com esta cabeleira, a ilusão poderia ser perfeita se o seu cheiro não entregasse você.');
INSERT INTO "item_descriptions" VALUES(13042,'pt','Esta capa vai deixar você com muito estilo quando ficar toda esvoaçante com o vento do deserto. A única condição para equipá-la é estar sem camisa por baixo: já que é para parecer Gultar, melhor ir até o fim. Só não se esqueça de passar protetor.');
INSERT INTO "item_descriptions" VALUES(13043,'pt','Este escudo é uma relíquia que contém a esplêndida espada quebrada de Gultar. Talvez você esteja se perguntando como aquele Iop conseguia ser tão poderoso mesmo com uma arma quebrada. E tem razão, essa questão vai dar menos nó na sua cabeça que a próxima: qual seria o poder dele com uma espada intacta?');
INSERT INTO "item_descriptions" VALUES(13044,'pt','Este chapéu leve e macio feito uma nuvem proporciona um carisma meio etéreo a quem o usa na cabeça.');
INSERT INTO "item_descriptions" VALUES(13045,'pt','Com esta capa, a dor na lombar será uma mera lembrança ruim. Você poderá se deslocar sem ter a sensação de estar carregando o peso do Mundo dos Doze nas costas.');
INSERT INTO "item_descriptions" VALUES(13046,'pt','Segundo os rumores, a fumaça que sai deste escudo deixa seus movimentos mais fluidos aos olhos do adversário.');
INSERT INTO "item_descriptions" VALUES(13047,'pt','A armadura deste animal de estimação foi feita com um metal inovador tão leve quanto o peido de um Gobball. Mas não se preocupe, ela não tem cheiro. Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(10000072,'pt','A armadura deste animal de estimação foi feita com um metal inovador tão leve quanto o peido de um Gobball. Mas não se preocupe, ela não tem cheiro. Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(13049,'pt','Este chapéu relembrará imediatamente aos seus adversários que convém desconfiar de águas calmas.');
INSERT INTO "item_descriptions" VALUES(13050,'pt','Vestir esta capa é como andar sempre com um odrezinho cheio d''água. Mesmo se acabar se perdendo no deserto de Espetárida, você nunca passará sede com ela.');
INSERT INTO "item_descriptions" VALUES(13051,'pt','O suor é por causa do peso do escudo ou do prazer de bloquear os ataques dos adversários?');
INSERT INTO "item_descriptions" VALUES(13052,'pt','Este animalzinho de estimação é como um colete salva-vidas nos dias em que tudo parece ir por água abaixo! Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(10000081,'pt','Este animalzinho de estimação é como um colete salva-vidas nos dias em que tudo parece ir por água abaixo! Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(13054,'pt','Usando este chapéu, você ficará tão resplandecente quanto o sol no Mundo dos Doze!');
INSERT INTO "item_descriptions" VALUES(13055,'pt','Se você sente vontade de pôr um casaquinho assim que esfria um pouco, escolha esta capa. Com seu calor difuso, ela dá um quentinho agradável. Obviamente, não a vista no verão se não quiser se sentir fritando.');
INSERT INTO "item_descriptions" VALUES(13056,'pt','Este escudo iluminará os seus dias, mas não os do adversário.');
INSERT INTO "item_descriptions" VALUES(13057,'pt','Este animal de estimação tem uma armadura à prova de fogo. Cuidado, ela queima! Ah, na verdade não... Bem, queima sim, no fim das contas. Mas está tudo bem. Ufa, foi por pouco! Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(10000039,'pt','Este animal de estimação tem uma armadura à prova de fogo. Cuidado, ela queima! Ah, na verdade não... Bem, queima sim, no fim das contas. Mas está tudo bem. Ufa, foi por pouco! Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(13059,'pt','Este chapéu relembra aos outros aventureiros que você está em constante evolução, assim como as flores na primavera.');
INSERT INTO "item_descriptions" VALUES(13060,'pt','Com esta capa, é possível que passarinhos fofinhos venham pousar no seu ombro.');
INSERT INTO "item_descriptions" VALUES(13061,'pt','Este escudo não dá asas, mas pelo menos dá flor.');
INSERT INTO "item_descriptions" VALUES(13062,'pt','Este animalzinho vai quebrar muitos galhos para você durante o combate. Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(10000071,'pt','Este animalzinho vai quebrar muitos galhos para você durante o combate. Este animal de estimação devorador de almas só se alimenta de criaturas das Planícies de Grama.');
INSERT INTO "item_descriptions" VALUES(13064,'pt','Este chapéu vai te deixar com uma aparência astuciosa. Não deve ser confundido com o chapéu de burro, que, por sua vez, te deixará com cara de... burro.');
INSERT INTO "item_descriptions" VALUES(13065,'pt','Estilo é algo que você tem de sobra!');
INSERT INTO "item_descriptions" VALUES(13066,'pt','Seus adversários estão começando a te perturbar? Responda com flores! (E um golpe de escudo para completar.)');
INSERT INTO "item_descriptions" VALUES(13067,'pt','Este pequeno animal de estimação tem um lado místico e encantador que desestabilizará seus adversários.');
INSERT INTO "item_descriptions" VALUES(13068,'pt','Esta criatura é extremamente fofa, você só precisa encontrar seu olhar para cair em seu feitiço. Além disso, o pergaminho que ela leva para todos os lugares contém informações absolutamente essenciais para qualquer aventureiro que se preze. Em suma, uma criatura muito legal.');
INSERT INTO "item_descriptions" VALUES(13093,'pt','Esse escudo tem a forma de um receptáculo e pode conter muita energia.');
INSERT INTO "item_descriptions" VALUES(13096,'pt','Entre um dragão e ele, acaba que não tem muita diferença...');
INSERT INTO "item_descriptions" VALUES(13097,'pt','Este diadema dará um aspecto sensacional à mais medíocre das aventuras. Então imagina como não vai ficar em você...');
INSERT INTO "item_descriptions" VALUES(13098,'pt','Uma capa concebida em uma madeira tão leve quanto casca de ovo e tão robusta quanto couraça de dragão.');
INSERT INTO "item_descriptions" VALUES(13099,'pt','Proteja seus bens mais preciosos como um dragão protege a prole.');
INSERT INTO "item_descriptions" VALUES(13106,'pt','Se usada com um chapéu, essa máscara pode atrair magicamente abóboras com guloseimas. Nada como unir o útil ao agradável. Seu poder de atração é relativamente baixo e a máscara se desmanchará após alguns combates. Atenção: ela não protege da maldição de Relouin.');
INSERT INTO "item_descriptions" VALUES(13107,'pt','Se usada com um chapéu, essa máscara pode atrair magicamente abóboras com guloseimas. Nada como unir o útil ao agradável. Seu poder de atração é relativamente baixo e a máscara se desmanchará após alguns combates. Atenção: ela não protege da maldição de Relouin.');
INSERT INTO "item_descriptions" VALUES(13108,'pt','Se usada com um chapéu, essa máscara pode atrair magicamente abóboras com guloseimas. Nada como unir o útil ao agradável. Seu poder de atração é relativamente baixo e a máscara se desmanchará após alguns combates. Atenção: ela não protege da maldição de Relouin.');
INSERT INTO "item_descriptions" VALUES(13109,'pt','Se usada com um chapéu, essa máscara pode atrair magicamente abóboras com guloseimas. Nada como unir o útil ao agradável. Seu poder de atração é razoável, mas ela se desmanchará após alguns combates. Atenção: ela não protege da maldição de Relouin.');
INSERT INTO "item_descriptions" VALUES(13110,'pt','Se usada com um chapéu, essa máscara pode atrair magicamente abóboras com guloseimas. Nada como unir o útil ao agradável. Seu poder de atração é razoável, mas ela se desmanchará após alguns combates. Atenção: ela não protege da maldição de Relouin.');
INSERT INTO "item_descriptions" VALUES(13111,'pt','Se usada com um chapéu, essa máscara pode atrair magicamente abóboras com guloseimas. Nada como unir o útil ao agradável. Seu poder de atração é razoável, mas ela se desmanchará após alguns combates. Atenção: ela não protege da maldição de Relouin.');
INSERT INTO "item_descriptions" VALUES(13112,'pt','Se usada com um chapéu, essa máscara pode atrair magicamente abóboras com guloseimas. Nada como unir o útil ao agradável. Seu poder de atração é fenomenal, mas ela se desmanchará após alguns combates. Atenção: ela não protege da maldição de Relouin.');
INSERT INTO "item_descriptions" VALUES(13113,'pt','Este artefato foi usado para enviar aventureiros a terras desconhecidas. A cada exploração eles iam mais longe, e quando chegavam diante do portal, só conseguiam pensar: "Só mais uma vez!"');
INSERT INTO "item_descriptions" VALUES(13114,'pt','Você pode ficar tranquilo(a): seus pensamentos sombrios, mórbidos e suas ideias mais controversas agora estarão a salvo de julgamentos sob esse chapéu.');
INSERT INTO "item_descriptions" VALUES(13115,'pt','A mensagem por trás dessa capa é clara: o destino daquele que se aproximar demais de você será sombrio...');
INSERT INTO "item_descriptions" VALUES(13116,'pt','É incrível o que se pode fazer com tralhas recuperadas no fundo de uma caverna úmida e mal frequentada.');
INSERT INTO "item_descriptions" VALUES(13121,'pt','A única desvantagem desse capacete é que você acaba se esquecendo de como você é belo, como um deus/deusa...');
INSERT INTO "item_descriptions" VALUES(13122,'pt','Essa capa fará com que você se pareça com um deus. Tudo o que você precisa fazer é reunir uma horda de seguidores e encontrar o segredo da imortalidade para se tornar um deles!');
INSERT INTO "item_descriptions" VALUES(13123,'pt','Segundo a profecia, esse escudo enviará seus oponentes de volta para a perdição. Para nunca mais serem como você. Muito difícil...');
INSERT INTO "item_descriptions" VALUES(13124,'pt','Enriquecido com o sangue de seus oponentes, este capacete brilhará tanto quanto as entranhas deles.');
INSERT INTO "item_descriptions" VALUES(13125,'pt','Ah, aí está você! Você não tinha nada para vestir em suas pequenas festas de sacrifício!');
INSERT INTO "item_descriptions" VALUES(13126,'pt','Se você quiser estar na vanguarda da moda, adquira este escudo agora mesmo!');
INSERT INTO "item_descriptions" VALUES(13128,'pt','Livre do gelo no qual passou eras presa, esta criaturinha, parente do Miau vira-lata, só precisa de uma coisa: um lar quentinho onde reinam o amor e o cafuné. Você tem um?');
INSERT INTO "item_descriptions" VALUES(10000066,'pt','Livre do gelo no qual passou eras presa, esta criaturinha, parente do Miau vira-lata, só precisa de uma coisa: um lar quentinho onde reinam o amor e o cafuné. Você tem um?');
INSERT INTO "item_descriptions" VALUES(13129,'pt','Dizem que este diadema com as cores do herói de Astrub Fallanster, além da aparência nobre, é bom contra ressaca.');
INSERT INTO "item_descriptions" VALUES(13130,'pt','Nenhum Feca que se preze sai sem capa e cajado. Não poderia ser diferente para Fallanster, célebre representante da classe.');
INSERT INTO "item_descriptions" VALUES(13131,'pt','O escudo do Feca!');
INSERT INTO "item_descriptions" VALUES(13132,'pt','Dizem que o melhor amigo do pastor Feca é o Gobball. Gobster vai ainda mais longe: ele acredita piamente que é Fallanster!');
INSERT INTO "item_descriptions" VALUES(13133,'pt','Este broquel deixa seus inimigos tão deslumbrados que chegam a pensar que além de vencer todos os seus combates, você também venceu na vida.');
INSERT INTO "item_descriptions" VALUES(13134,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13135,'pt','Com suas pontas entalhadas em um bloco de gelo milenar, este capacete é um verdadeiro pedaço da história que derreterá o coração de cientistas e biólogos. Manuseie com cuidado.');
INSERT INTO "item_descriptions" VALUES(13136,'pt','Para conservar o brilho das suas cores e seu caimento delicado, esta capa deve ser obrigatoriamente lavada à frio.');
INSERT INTO "item_descriptions" VALUES(13137,'pt','Este escudo já foi uma peça essencial da sorveteria gigante pertencente a Walla Wonki. Talvez você ainda encontre nele algumas raspas da grande especialidade servida nele: o sorvete de Dofus Cacau.');
INSERT INTO "item_descriptions" VALUES(13138,'pt','Fabricada com um dos mais nobres materiais, esta capa é a representação perfeita da sua glória. Se você não sujá-la, claro!');
INSERT INTO "item_descriptions" VALUES(13139,'pt','O oricor é, sem dúvida, um recurso muito estimado por lembrar a grandeza do sol. Só tome cuidado para não deixar isso subir à cabeça...');
INSERT INTO "item_descriptions" VALUES(13140,'pt','Sua defesa: provocar a desconfiança! Assim que seus adversários se depararem com o olhar frio do Draconiano dourado ostentado em seu escudo, eles pensarão duas vezes antes de entrar em combate.');
INSERT INTO "item_descriptions" VALUES(13141,'pt','Seu tecido avermelhado, seus bordados de ouro e sua forma de espada remetem à nobreza que existe em cada combate. E o preto representa o seu resultado... sempre fatal. É, acabamos deixando o clima meio pesado.');
INSERT INTO "item_descriptions" VALUES(13142,'pt','Além da sua grande beleza, este capacete realçará sua personalidade forte. Mesmo aqueles que não conhecem você saberão que você só faz que quer!');
INSERT INTO "item_descriptions" VALUES(13143,'pt','Sob sua crina platinada arde um temperamento de fogo! O Draconiano dourado concede esse complemento para a sua alma e a confiança necessária para o combate. Quem sabe essa criatura não é seu animal de poder?');
INSERT INTO "item_descriptions" VALUES(13144,'pt','Este chapéu parece um escalpo arrancado da cabeça de uma criatura maléfica. Ah? Não só parece? Hum, que bom...');
INSERT INTO "item_descriptions" VALUES(13145,'pt','Dizem que, se vestida ao contrário, esta capa tem o mesmo efeito que um abraço mortal de um Necromo. Não quer mesmo provar?');
INSERT INTO "item_descriptions" VALUES(13146,'pt','Com seu único olho púrpura, este escudo criado a partir de uma rocha localizada bem próximo do coração do Mundo dos Doze deve ter testemunhado toda a liberação dos Necromos. Sua opinião: não foi nada legal.');
INSERT INTO "item_descriptions" VALUES(13147,'pt','Apesar de seu pequeno tamanho, a mordida desta criatura sórdida libera uma saliva que pode derreter metal. Sua aparência pouco atraente, no entanto, lhe deu um vislumbre de seu potencial limitado como um animal de estimação dócil.');
INSERT INTO "item_descriptions" VALUES(13148,'pt','O Krosmoz é grande, assim como sua quantidade de heróis. Será que você é capaz de derrotar esses guerreiros saídos de outras épocas ou de outros universos? Com este escudo, você pode pelo menos sonhar.');
INSERT INTO "item_descriptions" VALUES(13149,'pt','Este capa com aparência familiar foi encantado pelo próprio Hel Munster depois de muita insistência por parte de um famoso alfaiate de Astrub. Ele queria criar uma coleção cujas peças se adaptassem às cores de seu dono. Embora tenha sido tingido usando um método secreto, você reconhece o cheiro característico da baba do Milobo... Eca!');
INSERT INTO "item_descriptions" VALUES(13150,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13151,'pt','Com um grande poder vem um grande capuz. Faça bom proveito.');
INSERT INTO "item_descriptions" VALUES(13152,'pt','Ser herói também é carregar o peso mundo nos ombros, assim como todos os seus erros. Na situação em que você está, acrescentar uma capa não deve mudar grande coisa, mas ela trará conforto nesse caminho árduo.');
INSERT INTO "item_descriptions" VALUES(13153,'pt','Este chapéu despejará uma torrente de injúrias contra seus adversários. Prepare-se para descobrir um vocabulário floreado provindo direto da Shukrute. E, também, a rugir um pouco.');
INSERT INTO "item_descriptions" VALUES(13154,'pt','Com esta capa, a expressão "ter olhos atrás da cabeça" faz todo sentido.');
INSERT INTO "item_descriptions" VALUES(13155,'pt','Este escudo protegerá você de muitas coisas, mas do mau olhado, com certeza não. Ele foi forjado nas chamas da Shukrute, você esperava o quê?');
INSERT INTO "item_descriptions" VALUES(13156,'pt','Basta reparar em como ela olha para você para perceber que você é um colírio para os olhos dela...');
INSERT INTO "item_descriptions" VALUES(13157,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13158,'pt','Mas o que ele está fazendo aqui?');
INSERT INTO "item_descriptions" VALUES(13159,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13160,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13161,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13166,'pt','O Pandachado é um machado fantasma lendário, conhecido por sua lâmina intangível que atravessa a matéria. Reza a lenda que um corajoso Pandawa passou a vida inteira tentando cortar madeira de bambu sagrado com ele. No entanto, a lâmina espectral atravessava o bambu sem danificá-lo, condenando o artesão a uma missão sem fim.');
INSERT INTO "item_descriptions" VALUES(13167,'pt','O chapéu de Bill de Grobe, decorado com motivos místicos, está imbuído da energia espiritual da ilha de Grobe. Leve e intangível, ele parece flutuar ao redor da cabeça de quem o usa.');
INSERT INTO "item_descriptions" VALUES(13168,'pt','O amuleto Grobe Bambu emite um brilho suave e amplifica as energias espirituais ao redor. Para não perder, o ideal é andar com ele no pescoço o tempo todo. Do contrário, ele poderia atravessar o chão.');
INSERT INTO "item_descriptions" VALUES(13169,'pt','As Grollbes são sandálias fantasmas que parecem rígidas e desconfortáveis à primeira vista. Mas, quando você as calça, seus pés parecem estar envoltos em uma nuvem, proporcionando um conforto inesperado.');
INSERT INTO "item_descriptions" VALUES(13170,'pt','Diz a lenda que uma pessoa de moral duvidosa criou um conjunto de equipamentos espectrais para se exibir. Esses objetos desapareciam visualmente de forma aleatória, deixando o portador completamente nu às vezes. Depois que essa pessoa foi presa pela milícia de Amakna, os outros equipamentos foram perdidos, restando apenas o Kumokan, que continua desaparecendo de tempos em tempos, relembrando essa estranha anedota.');
INSERT INTO "item_descriptions" VALUES(13171,'pt','O Grobescudo é uma peça de equipamento tão intrigante quanto inútil. Fora proteger de golpes de fantasmas, ele não serve para mais nada. Em suma, é perfeito para ostentar na vida após a morte, mas não é ideal para uma batalha de vesrdade!');
INSERT INTO "item_descriptions" VALUES(13193,'pt','Com estes óculos, você detectará os fantasmas mais rápido que a sua própria sombra. Só reze para detectá-los antes de ser completamente engolido por eles...');
INSERT INTO "item_descriptions" VALUES(13194,'pt','Com esta capa, e especialmente com esta jaula antifantasma equipada com o mais novo modelo de desintegrador Grobetrônico, você tem uma boa chance, embora mínima, de escapar da ilha de Grobe.');
INSERT INTO "item_descriptions" VALUES(13195,'pt','Este item te protegerá dos respingos de gosma, mas, acima de tudo, ele serve para te lembrar de seu maior adversário nas terras de Grobe: o terrível Fantasma Werepeki!');
INSERT INTO "item_descriptions" VALUES(13196,'pt','Para te acompanhar em sua caçada ao espectro, você pensou em uma coisa inofensiva... vinda diretamente da sua infância... Algo gentil, fofo, que não poderia te fazer mal algum. O Leopardo. Bem, aquele que você tinha em mente não existe mais... Mas o fantasma dele está de volta!');
INSERT INTO "item_descriptions" VALUES(13199,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13200,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13201,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13202,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(13203,'pt','Graças a este Dofus dado pelos guardiões da Ankama, você poderá dizer "Eu fui!" sem ficar saudosista. Até daqui a vinte anos!');
INSERT INTO "item_descriptions" VALUES(13204,'pt','Este capa com aparência familiar foi encantado pelo próprio Hel Munster depois de muita insistência por parte de um famoso alfaiate de Astrub. Ele queria criar uma coleção cujas peças se adaptassem às cores de seu dono. Embora tenha sido tingido usando um método secreto, você reconhece o cheiro característico da baba do Milobo... Eca!');
INSERT INTO "item_descriptions" VALUES(13205,'pt','Esta arma lhe foi emprestada por Notend Less, que viu potencial em você... Bom... na verdade foi seu lado “bobo da feira” que ele viu. Não é bem um elogio... De qualquer forma, com ela você pode apropriar-se temporariamente das características de uma classe, o que não é nada mal.');
INSERT INTO "item_descriptions" VALUES(13206,'pt','Esta arma lhe foi emprestada por Notend Less, que viu potencial em você... Bom... na verdade foi seu lado “bobo da feira” que ele viu. Não é bem um elogio... De qualquer forma, com ela você pode apropriar-se temporariamente das características de uma classe, o que não é nada mal.');
