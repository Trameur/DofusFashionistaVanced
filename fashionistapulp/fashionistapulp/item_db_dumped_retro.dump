INSERT INTO "item_descriptions" VALUES(1121,'es','Coge un viejo arco usado, échale polvo de arena mágica, pídele a un dragón que sople encima y conseguirás este arco encantador. En realidad, esta receta de cuento de hadas no funciona, los dragones tienen muy mala puntería al soplar...');
INSERT INTO "item_descriptions" VALUES(1122,'es','Coge un viejo arco usado, échale polvo de arena mágica, pídele a un dragón que sople encima y conseguirás este arco encantador. En realidad, esta receta de cuento de hadas no funciona, los dragones tienen muy mala puntería al soplar...');
