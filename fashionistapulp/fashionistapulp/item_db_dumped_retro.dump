INSERT INTO "item_descriptions" VALUES(10942,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10943,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10944,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10945,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10946,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10947,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10948,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10949,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
INSERT INTO "item_descriptions" VALUES(10950,'fr','Ce bouclier permet de montrer à tous les aventuriers que vous êtes un précurseur dans l''exercice de votre métier.');
