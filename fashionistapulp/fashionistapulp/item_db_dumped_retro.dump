INSERT INTO "item_descriptions" VALUES(12792,'fr','Cette arme vous est prêtée par Notend Less qui voit en vous du potentiel... Bon, en réalité c''est plutôt votre côté "bête de foire" qui l''intéressait. Pas très élogieux. Dans tous les cas, elle vous permet de revêtir temporairement les traits d''une classe et c''est déjà pas si mal.');
INSERT INTO "item_descriptions" VALUES(12793,'fr','Cette arme vous est prêtée par Notend Less qui voit en vous du potentiel... Bon, en réalité c''est plutôt votre côté "bête de foire" qui l''intéressait. Pas très élogieux. Dans tous les cas, elle vous permet de revêtir temporairement les traits d''une classe et c''est déjà pas si mal.');
INSERT INTO "item_descriptions" VALUES(12794,'fr','Conçu à partir de restes de Douziens, ce bouclier ravira les adeptes de la récup et du zéro déchet. Pas d''inquiétude, tous les os sont propres : ils ont été soigneusement rongés durant des heures par une horde de charognards voraces. Vous voilà rassuré(e) ?');
INSERT INTO "item_descriptions" VALUES(12795,'fr','Faites-nous confiance : une fois que vous aurez compris comment l''utiliser sans perdre un doigt ou vous embrocher vous-même, ce bouclier deviendra votre accessoire de combat préféré.');
INSERT INTO "item_descriptions" VALUES(12796,'fr','Voici probablement l''invention la plus maline (et maligne) qui soit sortie d''un cerveau de Brâkmarien. Ses cornes affutées sont toutes placées à des endroits stratégiques et embrochent tous ceux qui se tiennent à moins de 30 centikamètres de vous. Seule précaution à prendre : bien penser à la retirer lorsque vous faites la bise à vos proches.');
INSERT INTO "item_descriptions" VALUES(12797,'fr','Cette cape a été conçue à partir d''une couverture qui appartenait à un petit démon. Elle lui a été arrachée des mains sans ménagement alors qu''il faisait de doux cauchemars. Celui-ci aurait alors crié « Skribidibeudu reugneugneu scrouchniou boudoudoudi oh ! », ce que nous n''allons pas traduire, autrement vous risquez de ne plus fermer l''œil de la nuit.');
INSERT INTO "item_descriptions" VALUES(12798,'fr','De tous temps, les Iops se sont servis de leur tête pour se défendre. Désormais ils pourront se servir de ce bouclier. Une nouvelle lignée de guerriers roux, à la cervelle un peu moins ratatinée, est peut-être sur le point de voir le jour...');
INSERT INTO "item_descriptions" VALUES(12799,'fr','Regardez les autres de haut (en prenant l''air le plus méprisant possible, évidemment) est un sport national chez certains Bontariens. Pour aller encore plus loin, l''un d''eux a conçu une cape ailée dans l''espoir de prendre un peu plus de hauteur encore. Un échec cuisant, mais une cape qui porte en partie bien son nom, puisque les plumes avec lesquelles elle est conçue provoquent d''insupportables démangeaisons.');
INSERT INTO "item_descriptions" VALUES(12800,'fr','Cette coiffe donnera l''illusion que vous êtes un esprit pur. Certains penseront même que vous venez tout droit de l''Ingloriom, porteur d''un message divin, annonciateur d''une bonne nouvelle, voire que vous êtes l''élu(e). Alors qu''en réalité, votre seule et unique intention est de massacrer tous ceux qui se mettent en travers de votre chemin pour accéder à la gloire et prouver, une fois de plus, que vous êtes le/la meilleur(e).');
INSERT INTO "item_descriptions" VALUES(12801,'fr','Les hauts dignitaires de l''armée bontarienne et les meilleurs forgerons de Bonta ont travaillé de concert pour concevoir ce prestigieux bouclier. Une tête de félin incrustée dans un cœur en or le tout fendu d''une épée rutilante. Rien n''est jamais trop beau pour les défenseurs de la Cité Blanche. Rien n''est jamais trop, d''ailleurs.');
INSERT INTO "item_descriptions" VALUES(12809,'fr','Le Trool se rase la tête environ une fois tous les cinq ans, quand les pointes de sa crinière deviennent plus sèches que la corne qu''il a aux pieds. Il aura fallu beaucoup de patience pour confectionner cette cape que vous parviendrez à sublimer mieux que personne, cela ne fait aucun doute.');
INSERT INTO "item_descriptions" VALUES(12810,'fr','C''est fou ce que ça vous va bien... Non, vraiment, vous avez rajeuni de dix ans ! À vrai dire, vous n''avez jamais été aussi séduisant(e)... Quoi ? Oh ! Bah, puisque c''est comme ça, on ne vous fera plus de compliments !');
INSERT INTO "item_descriptions" VALUES(12811,'fr','Ce bouclier vous rappellera vos longues soirées de torture dans les salles obscures de sinistres donjons. À ne jamais laisser entre les mains de vos enfants. Sauf si vous souhaitez leur apprendre que, dans la vie, le danger est partout...');
INSERT INTO "item_descriptions" VALUES(12812,'fr','Il a fait le serment de vous protéger ! (Jusqu''au 1er février inclus, 23 h 59)');
INSERT INTO "item_descriptions" VALUES(12814,'fr','Votre énergie intérieure est précieuse. Une fois maîtrisée, elle vous permet d''accomplir de grandes choses. Mais laissez-la déborder et elle finira par vous consumer tout entier(e). Cette cape, à l''instar de la colère du Dark Vlad, peut-être dévastatrice. Apprenez à la dominer, sans quoi elle vous poussera à commettre le pire...');
INSERT INTO "item_descriptions" VALUES(12815,'fr','Il faut vraiment être une tête brûlée pour prendre le risque d''enfiler cette coiffe. Cela dit, le risque vaut la peine d''être pris... On dit qu''une fois posée sur votre tête, la coiffe Esprit Pétulant fait naître en vous une rage telle qu''elle vous rend capable de déplacer des montagnes. Non, mais... on parle de VRAIMENT déplacer des montagnes. Pour les mettre où ? Oh, débrouillez-vous !');
INSERT INTO "item_descriptions" VALUES(12816,'fr','Ce bouclier reflète parfaitement l''état d''esprit du Dark Vlad : incisif et sanguinaire. Il vous permettra de protéger vos arrières tout en rentrant dans le lard de vos adversaires. Très pratique aussi pour se gratter l''oreille, à condition d''y aller en douceur.');
INSERT INTO "item_descriptions" VALUES(12817,'fr','Au début, vous le trouverez terrifiant. Vous sursauterez chaque fois que vous le verrez apparaître. Sa présence à vos côtés vous donnera probablement des frissons et peut-être même des nausées. Laissez faire le temps... D''ici peu, vous ne pourrez plus vous passer de lui. Il se peut même que vous lui fassiez des gros poutous d''amour sur son infâme front ou que vous lui chatouillez ses immondes ailes. Et tout ça, en prenant du plaisir ! On finit par s''habituer à tout, même au pire...');
INSERT INTO "item_descriptions" VALUES(12818,'fr','Sensible et dévoué, ce familier n''hésitera pas à vous donner un coup de pouce dans les moments difficiles. En revanche, son caractère effronté risque de vous donner du fil à retordre... Si vous voulez qu''il vous obéisse au doigt et à l''œil, il faudra faire preuve de fermeté et avoir de la poigne, autrement c''est vous qui finirez par lui manger dans la main !');
INSERT INTO "item_descriptions" VALUES(12827,'fr','Ce certificat vous permet d''aller reprendre votre monture dans une étable. 
Attention, ce certificat n''est valide que 20 jours, une fois ce délai dépassé, votre monture sera relâchée dans la nature et votre certificat ne sera plus valide, vous ne pourrez plus récupérer votre monture. Pensez à laisser votre monture dans une étable si vous devez vous absenter longtemps.');
INSERT INTO "item_descriptions" VALUES(12833,'fr','L''armurier qui a confectionné ce casque devait vouer une admiration sans limites aux dragons. Ce ne serait pas surprenant qu''il se soit fait dévorer par l''un d''eux à force de les cotoyer.');
INSERT INTO "item_descriptions" VALUES(12834,'fr','Ce manteau vous rappelle à quel point vous pouvez être stylé, maléfique, mais avant tout plus fort que les autres... A quand remonte votre dernière victoire déjà ?');
INSERT INTO "item_descriptions" VALUES(12835,'fr','Une vieille légende raconte qu''Eykards était le roi d''une civilisation oubliée. Les plus religieux d''entre eux étaient persuadés qu''en projetant beaucoup de croyance sur quelque chose, il était possible d''influencer le destin en leur faveur. Si vous voulez mon avis, c''est une juste un effet placebo.');
INSERT INTO "item_descriptions" VALUES(12836,'fr','Ce heaume est d''une facture impréssionante, en plus de vous protéger correctement, sa luisance au soleil permet d''éblouir les adversaires.');
INSERT INTO "item_descriptions" VALUES(12837,'fr','Inspirée des toiles portées par les empereurs les plus prestigieux, cette cape augmente signifiativement votre statut social auprès des autres. Après... il faut faire attention à ne pas se prendre les pieds dedans, au risque de redescendre très vite, et pas que figurativement.');
INSERT INTO "item_descriptions" VALUES(12838,'fr','Ce grand bouclier sert à parer des attaques sans se blesser, à distribuer des coups de bouclier, à être utilisé en tant que table de pique-nique, à vous protéger de la pluie. Dans cet ordre précis.');
INSERT INTO "item_descriptions" VALUES(12846,'fr','Ce bouclier vous protègera de bien des choses, mais certainement pas de votre propre fureur belliqueuse !');
INSERT INTO "item_descriptions" VALUES(12847,'fr','Quand vous portez ce bonnet, on ne peut pas vraiment dire que ce qu''il y a sous ce sapin là soit un cadeau.');
INSERT INTO "item_descriptions" VALUES(12848,'fr','Quand vous portez ce bonnet, on ne peut pas vraiment dire que ce qu''il y a sous ce sapin là soit un cadeau.');
INSERT INTO "item_descriptions" VALUES(12849,'fr','Quand vous portez ce bonnet, on ne peut pas vraiment dire que ce qu''il y a sous ce sapin là soit un cadeau.');
INSERT INTO "item_descriptions" VALUES(12850,'fr','L''avantage de cette coiffe, c''est que si vous vous noyez, on vous repèrera au loin. Bon, il sera sans doute déjà trop tard, mais ça...');
INSERT INTO "item_descriptions" VALUES(12851,'fr','C''est ça qu''on appelle un « méli-mélo de la mer sur son lit de cresson », non ?');
INSERT INTO "item_descriptions" VALUES(12852,'fr','Ce bouclier est insubmersible. Vous n''aurez désormais plus peur de vous jeter à l''eau, même dans les situations les plus périlleuses.');
INSERT INTO "item_descriptions" VALUES(12853,'fr','Vous vous souvenez de l''époque où l''on savait profiter des petits plaisirs de la vie et se contenter de peu ? Quand une orange et un bâton suffisaient à nous rendre heureux ? Une époque marquée par la pauvreté où les Douziens gardaient le sourire malgré un quotidien de privation... En ces temps, l''un d''eux eut l''idée lumineuse de fabriquer un chapeau entièrement fait de paille. Et devinez quoi ? Il se fit un maximum de blé. Alors, bon... Les p''tits plaisirs de la vie, hein...');
INSERT INTO "item_descriptions" VALUES(12854,'fr','Portée par les plus grands agriculteurs du Monde des Douze, à commencer par le troubadour Danioule Bat l''Avoine, cette cape est devenue une véritable pièce iconique dans le milieu de la mode paysanne. Une notoriété qui a permis à son créateur de ne plus jamais se retrouver sur la paille.');
INSERT INTO "item_descriptions" VALUES(12855,'fr','Rien de tel qu''une botte de paille bien tassée pour mettre K. O. son adversaire. Ça pique, ça gratte, et avec un peu de bol il reste un ou deux rats des champs à l''intérieur, prêts à sauter au cou du premier qui viendra l''en déloger.');
INSERT INTO "item_descriptions" VALUES(12856,'fr','Au fond du trou ? Cette coiffe est la lueur d''espoir qu''il vous fallait, celle qui vous fera voir le bout du tunnel.');
INSERT INTO "item_descriptions" VALUES(12857,'fr','Inutile de vous creuser la tête plus longtemps, cette cape fera largement l''affaire quand vous enterrerez vos ennemis six pieds sous terre.');
INSERT INTO "item_descriptions" VALUES(12858,'fr','Ce bouclier est l''accessoire parfait quand on tombe sur une tête de pioche.');
INSERT INTO "item_descriptions" VALUES(12859,'fr','La forme de ce chapeau n''est pas un hasard. On l''a voulu pointu pour connecter le cerveau de son porteur aux esprits divins dont le savoir est bien souvent supérieur à celui des Douziens. De cette façon, les alchimistes et autres adeptes des sciences occultes espèrent pouvoir gagner en sagesse en aspirant directement les connaissances des mages et des dieux. Malin ! Ou complètement absurde et illusoire, allez savoir...');
INSERT INTO "item_descriptions" VALUES(12860,'fr','Cet accessoire vous permettra d''emporter partout avec vous les ustensiles nécessaires pour élaborer divers potions et élixirs, mais aussi confitures, cakes, tourtes et autres préparations qui nécessitent l''usage de spatule ainsi que quelques connaissances en chimie.');
INSERT INTO "item_descriptions" VALUES(12861,'fr','Quand ils n''ont pas la tête dans leurs éprouvettes, les alchimistes l''ont dans leur grimoire. Apprendre, se perfectionner, sans cesse, encore et encore... Il ne faut pas se leurrer, ces chercheurs illuminés ont davantage leur place dans un laboratoire que sur le champ de bataille. Ce bouclier leur permet de faire d''une pierre philosophale deux coups : continuer à s''instruire tout en se protégeant des attaques ennemies. Il fallait y penser !');
INSERT INTO "item_descriptions" VALUES(12862,'fr','Luttons contre les idées reçues : le bûcheron est un homme de cœur. Il ne se contente pas de couper des arbres à grands coups de hache à longueur de journée en poussant des cris virils et rauques. Avant d''asséner le coup fatal dans le tronc préalablement marqué d''une croix rouge, il l''enlace de ses gros bras musclés pour lui offrir un ultime câlin. Notez qu''il n''accorde cette faveur à aucune autre de ses victimes.');
INSERT INTO "item_descriptions" VALUES(12863,'fr','Cette cape et sa hache intégrée est l''outil multifonction par excellence, indispensable à tous ceux qui s''aventurent dans la forêt au péril de leur vie. Elle vous sortira de bien des situations délicates. Dégager un chemin envahi de ronces, affûter une lame, couper une bonne tranche de saucisson de porkass ou encore un ongle d''orteil un peu trop long : les possibilités sont infinies. On raconte même que certains s''en servent pour couper du bois ! Époustouflant...');
INSERT INTO "item_descriptions" VALUES(12864,'fr','Deux ou trois vieux morceaux de bois bourrés d''échardes, quelques clous rouillés, un bon marteau : voilà sans doute le bouclier le plus simple à réaliser. Et pourtant tout aussi efficace que d''autres modèles plus modernes ! À ne manipuler qu''après avoir fait tous ses vaccins.');
INSERT INTO "item_descriptions" VALUES(12865,'fr','Une coiffe parfaite pour les jours où votre humeur est entre chienchien et mulou.');
INSERT INTO "item_descriptions" VALUES(12866,'fr','Oui, cette cape sent la bête faisandée. Vous vous attendiez à quoi ?');
INSERT INTO "item_descriptions" VALUES(12867,'fr','Un bouclier qui rappellera à ceux qui vous cherchent des poux qu''ils finiront forcément par tomber sur un os.');
INSERT INTO "item_descriptions" VALUES(12868,'fr','En croisant l''Homme Mystère, tout le monde se demande pourquoi il se promène toujours avec une cuillère sur lui. Ce secret n''a jamais été percé, mais chacun y va de sa théorie. Un porte-bonheur ? Un souvenir ? Un objet permettant de lui rappeler qu''il n''est pas dans un rêve ? Pour la majorité cependant, elle représente la touche finale de la personnalité intrigante de cet homme hors du commun.');
INSERT INTO "item_descriptions" VALUES(12869,'fr','La modestie de l''Homme Mystère a toujours tranché avec son élégance. Dans un monde où tout se ressemble, il sait rester fidèle à lui-même, et impose son style partout où il passe. Si vous le croisez un jour dans le monde des Douze ou bien en Externam, vous ne pourrez que constater la subtilité de cet homme. La classe, ça ne s''achète pas.');
INSERT INTO "item_descriptions" VALUES(12870,'fr','On dit que l''Homme Mystère et son acolyte chevelu passent leur vie à tester la solidité de chaque objet qu''on leur donne. Cependant, ils ne sont jamais en retard lorsqu''il s''agit de prendre une pause afin de se changer les idées et se raconter des anecdotes. C''est probablement grâce à cet énorme gousset qui indique toujours la bonne heure. Après tout, un gentleman se distingue souvent par sa ponctualité.');
INSERT INTO "item_descriptions" VALUES(12871,'fr','Totalement hermétique aux odeurs, cette coiffe préservera vos cheveux des fragrances tenaces de la mer.');
INSERT INTO "item_descriptions" VALUES(12872,'fr','Ce bouclier énervera autant vos adversaires que le fameux adage : « Y''a pas d''arêtes dans le bifteck, y''en a dans le pichon ».');
INSERT INTO "item_descriptions" VALUES(12873,'fr','Grâce à cette cape, vous pourrez rouler vos ennemis dans la farine sans risquer de vous salir.');
INSERT INTO "item_descriptions" VALUES(12874,'fr','Cette imposante toque vous donne du crédit. Elle vous permettra de mener vos troupes à la baguette !');
INSERT INTO "item_descriptions" VALUES(12875,'fr','Ne pas l''emporter avec soi au combat, c''est prendre le risque de se mettre dans un sacré pétrin !');
INSERT INTO "item_descriptions" VALUES(12876,'fr','Cette cape a été conçue directement dans de l''ambre appartenant au Chêne Mou. L''insecte qui y est resté emprisonné lui confère une petite touche d''authenticité non sans charme.');
INSERT INTO "item_descriptions" VALUES(12877,'fr','Cette coiffe est lourde, certes, mais elle protègera ce que vous avez de plus précieux. Non... Votre cerveau, pas vos cheveux...');
INSERT INTO "item_descriptions" VALUES(12878,'fr','Utile face aux aventuriers malveillants aux propos lapidaires, ce bouclier le sera également pour protéger vos bijoux de famille.');
INSERT INTO "item_descriptions" VALUES(12879,'fr','Alors ? Qui a dit que les cordonniers étaient les plus mal chaussés ? Ah !');
INSERT INTO "item_descriptions" VALUES(12880,'fr','Une cape réservée aux aventuriers qui ont le cuir épais.');
INSERT INTO "item_descriptions" VALUES(12881,'fr','Lourd et robuste, ce bouclier est une réponse efficace à ceux qui viendraient vous tanner le cuir.');
INSERT INTO "item_descriptions" VALUES(12882,'fr','À la manière d''une voile, cette cape vous aidera à garder le cap lorsque vous prendra l''envie de partir au large.');
INSERT INTO "item_descriptions" VALUES(12939,'fr','Sous ce heaume imposant se cachent peut-être les traits délicats d''un visage que les flammes ont épargnés. Mais on ne parierait pas trop là-dessus.');
INSERT INTO "item_descriptions" VALUES(12940,'fr','Souple comme l''étoffe et solide comme l''acier, cette cape née dans les flammes n''habille que les forgerons d''une certaine trempe.');
INSERT INTO "item_descriptions" VALUES(12941,'fr','Ce bouclier est à peu près aussi élégant qu''une feuille d''acier martelée de coups. Cependant, il protège des attaques aussi bien qu''une feuille d''acier martelée de coups.');
INSERT INTO "item_descriptions" VALUES(12942,'fr','Le bois est une matière noble qui n''est pas destinée à être inhalée ! Protégez-vous donc de la sciure avec ce foulard de luxe sur votre nez.');
INSERT INTO "item_descriptions" VALUES(12943,'fr','Vos amis vous ont souvent répété qu''il était saugrenu de vouloir fabriquer une cape en bois. Et ils avaient raison !');
INSERT INTO "item_descriptions" VALUES(12944,'fr','Ce bouclier en chutes de bois recyclées contient des morceaux provenant de plus de cent arbres différents. Il y a des forêts qui seraient jalouses de vous !');
INSERT INTO "item_descriptions" VALUES(12945,'fr','Ce chapeau cache en son sein tant d''instruments de couture que vous aurez toujours de quoi rapiécer votre panoplie préférée en cas d''accroc.');
INSERT INTO "item_descriptions" VALUES(12946,'fr','Avec son intérieur doublé de la soie la plus douce, cette cape ne sacrifie pas une once de confort au nom de l''esthétique. C''est bien simple : vous avez envie de vous enrouler dedans !');
INSERT INTO "item_descriptions" VALUES(12947,'fr','Il est malheureux que ce bouclier ne puisse servir que pour une seule bataille : la moindre entaille vient ruiner son esthétisme raffiné, et il vous faut alors le remplacer...');
INSERT INTO "item_descriptions" VALUES(12948,'fr','Ces lunettes sauront protéger vos yeux fragiles des éclairs de génie qui fusent régulièrement dans votre atelier.');
INSERT INTO "item_descriptions" VALUES(12949,'fr','Voilà un jeu parfait pour jeunes enfants et Iops adultes : essayez de deviner tous les objets disparates qui composent cette cape. Des heures d''amusement en perspective !');
INSERT INTO "item_descriptions" VALUES(12950,'fr','Cet objet personnalisé est à la fois un bouclier, un baromètre, un niveau à bulle et une cachette secrète pour votre goûter. Tout à portée de main, en cas de besoin !');
INSERT INTO "item_descriptions" VALUES(12951,'fr','À quoi bon être forgemage si l''on n''est pas reconnu immédiatement comme tel partout où l''on se rend ? Au moins, ce chapeau magique ne laissera plus aucun doute sur la question !');
INSERT INTO "item_descriptions" VALUES(12952,'fr','Chaque milikamètre d''étoffe de cette cape luxueuse est recouvert de minuscules formules magiques. Tellement petites, hélas, qu''elles en sont invisibles à l''œil nu. Dommage.');
INSERT INTO "item_descriptions" VALUES(12953,'fr','Cette rune taille XXXXL, utilisée comme bouclier, vous rappellera à chaque instant de bien lire les annonces de vente par correspondance jusqu''au bout...');
INSERT INTO "item_descriptions" VALUES(12954,'fr','Aucun Roufoux n''a été maltraité pour confectionner cette coiffe. C''est du moins ce qu''a assuré l''artisan à Mogueta lorsqu''elle lui a confié un Roufoux de son élevage en échange de quelques pelotes de laine afin de confectionner ses peluches. Toutefois, à la subtile odeur de sang qui s''en dégage, quelques doutes sont permis...');
INSERT INTO "item_descriptions" VALUES(12955,'fr','Votre dévotion vous a permis de mettre la main sur ce casque. Il vous protègera les oreilles, mais ne le portez pas sur votre Vrombilette car il n''est pas homologué.');
INSERT INTO "item_descriptions" VALUES(12956,'fr','Comme sortie d''une autre époque, cette cape semble émettre une musique envoutante : Poh-Lom Pim Boum Laaaaa, Pi-Li-Li-Laaam. Les passants vous dévisagent. Pour certains, cet air semble familier, mais ils n''arrivent pas à savoir où ils l''ont entendu...');
INSERT INTO "item_descriptions" VALUES(12957,'fr','On dit que les miroirs sont des reflets vers un autre monde. Ce bouclier semble en être un et si vous le brisez, vous risquez sept ans de malheur. La personne qui l''a confectionné prétendait qu''il était une version améliorée d''un ancien bouclier dont la rareté n''égalait que la laideur.');
INSERT INTO "item_descriptions" VALUES(12958,'fr','Ce vieux chapeau usé de parchomancien semble avoir été porté par de nombreuses personnes avant vous. Il sent la poussière et le parchemin trop vieilli. Inutile de le poser sur une tête pour deviner le destin d''une personne, ça ne fonctionnera pas.');
INSERT INTO "item_descriptions" VALUES(12959,'fr','Cette splendide cape de parchomancien peut donner l''apparence d''un simple disciple des arcanes. Mais les apparences peuvent être trompeuses. On raconte même qu''un magicien qui portait une cape similaire est passé du gris au blanc après une promotion au sein de son ordre.');
INSERT INTO "item_descriptions" VALUES(12960,'fr','Pour de féroces guerriers, un bouclier est un atout indispensable au combat pour se protéger. Pour un parchomancien, une antisèche est parfois nécessaire pour ne pas oublier les incantations les plus loufoques.');
INSERT INTO "item_descriptions" VALUES(12961,'fr','Contre vents et marais, ce couvre-chef protègera votre caboche des vilains coups.');
INSERT INTO "item_descriptions" VALUES(12962,'fr','À défaut de parer les coups d''estoc, cette cape vous tiendra chaud en toutes circonstances. Idéale pour les pays enneigés !');
INSERT INTO "item_descriptions" VALUES(12963,'fr','"La meilleure défense, c''est l''attaque." Celui qui a dit ça n''avait probablement jamais vu ce bouclier. En effet, sa solidité apaisera votre esprit lors de vos aventures.');
INSERT INTO "item_descriptions" VALUES(13015,'fr','Cette coiffe vous donne un air assez peu engageant. À porter les jours où vous n''avez vraiment pas envie de faire la queue à la boulangerie.');
INSERT INTO "item_descriptions" VALUES(13016,'fr','Une cape noire qui se marie avec tout. Surtout avec le noir, tant qu''à faire.');
INSERT INTO "item_descriptions" VALUES(13017,'fr','Inspiré du Dofus Ebène, ce bouclier nécessite un entretien régulier à base de cire d''oreille de bwork, à appliquer avec un pinceau à poils doux. Oui baaah, le bois ça vit, que voulez-vous ?!');
INSERT INTO "item_descriptions" VALUES(13018,'fr','Livré avec sa pancarte « Attention, familier méchant ».');
INSERT INTO "item_descriptions" VALUES(13019,'fr','Cette coiffe vous rendra aussi sage que le dragon Dardondakal. On a envie de dire : c''est pas trop tôt !');
INSERT INTO "item_descriptions" VALUES(13020,'fr','Cette cape est très salissante. Pensez donc bien à la retirer avant de manger des plats en sauce.');
INSERT INTO "item_descriptions" VALUES(13021,'fr','Parfaite réplique du Dofus Ivoire, ce bouclier assurera votre défense (ivoire, défense... vous l''avez ?).');
INSERT INTO "item_descriptions" VALUES(13022,'fr','Ce familier passe son temps à faire la morale aux autres, ce qui aura l''avantage de faire fuir vos ennemis. Et l''inconvénient de vous faire passer l''envie de vous gaver de rabmaracs...');
INSERT INTO "item_descriptions" VALUES(13023,'fr','Soyez prévenu(e) : cette coiffe risque de transformer chacune de vos prises de parole en prise de bec.');
INSERT INTO "item_descriptions" VALUES(13024,'fr','Ah ! Il vous manquait justement une cape pour le concours annuel de cris de mouette !');
INSERT INTO "item_descriptions" VALUES(13025,'fr','Réplique exacte du Dofus Émeraude, ce bouclier est un véritable bijou d''orfèvrerie.');
INSERT INTO "item_descriptions" VALUES(13026,'fr','Ce familier passe son temps à faire des blagues de prouts. Autant vous prévenir, avec lui, ça ne vole pas haut..');
INSERT INTO "item_descriptions" VALUES(13027,'fr','Alors ? Ça fait quoi d''avoir la tête du chum de Dathura ?');
INSERT INTO "item_descriptions" VALUES(13028,'fr','Il vous faut cette cape inspirée du dragon de l''eau, goutte que goutte !');
INSERT INTO "item_descriptions" VALUES(13029,'fr','Grâce à ce bouclier, chaque tentative d''attaque de vos adversaires se soldera par un coup d''épée dans l''eau.');
INSERT INTO "item_descriptions" VALUES(13030,'fr','Ce familier en apparence calme et pacifiste est la preuve, une fois encore, qu''il faut se méfier de l''eau qui dort...');
INSERT INTO "item_descriptions" VALUES(13031,'fr','Si, une fois cette coiffe sur votre crâne, vous prend l''envie de vous construire un nid au sommet de l''Arbre Hakam, ne paniquez pas : c''est tout à fait normal. C''est une idée stupide, mais c''est normal.');
INSERT INTO "item_descriptions" VALUES(13032,'fr','Munie d''ailes suffisamment grandes pour vous donner de la prestance, mais trop petites pour vous permettre de voler, cette cape vous permettra de garder les pieds sur terre. Malin.');
INSERT INTO "item_descriptions" VALUES(13033,'fr','Lumineux, ce bouclier inspiré du Dofus Ocre capte les rayons du soleil pour offrir un teint éclatant à son propriétaire.');
INSERT INTO "item_descriptions" VALUES(13034,'fr','Ce familier passe son temps à gratter la terre à la recherche de précieux trésors. Pour l''instant, il n''a trouvé qu''un demi-gland et un rat mort. Bon... Affaire à suivre.');
INSERT INTO "item_descriptions" VALUES(13035,'fr','Cette coiffe vous donnera un regard perçant. Vos ennemis pourront y lire votre témérité. Ainsi que l''heure de leur mort. 14 h 23 (à deux ou trois minutes près, évidemment).');
INSERT INTO "item_descriptions" VALUES(13036,'fr','Cette cape flamboyante flamboie. Non, c''est tout, vous pouvez y aller.');
INSERT INTO "item_descriptions" VALUES(13037,'fr','ATTENTION ! IL PREND FEU ! Ah non, au temps pour nous.');
INSERT INTO "item_descriptions" VALUES(13038,'fr','On dit que son souffle mélangé à l''eau d''un lac enchanté permettrait de forger la plus solide des épées.');
INSERT INTO "item_descriptions" VALUES(13039,'fr','Goultard a toujours eu bon goût. Il a par exemple eu l''idée ingénieuse d''attacher au bout de son épée les chaînes utilisées pour assassiner sa famille... Mignon, non ? Bien plus efficace qu''une lame normale, cette épée vous permet de raser vos ennemis de très près. Une lame cassée pour plus de précision.');
INSERT INTO "item_descriptions" VALUES(13040,'fr','Ce diadème, influencé par le hasard et le Tumulte, vous permettra de jouer votre vie. Il est capable de faire de tous vos choix une réussite, mais attention... un seul mauvais coup et tout peut basculer, surtout quand on le cherche.');
INSERT INTO "item_descriptions" VALUES(13041,'fr','Vous avez toujours rêvé de ressembler au beau et valeureux Goultard ? Avec cette tignasse, l''illusion aurait pu être parfaite si seulement votre odeur ne vous trahissait pas.');
INSERT INTO "item_descriptions" VALUES(13042,'fr','Cette cape vous donnera un air assurément stylé lorsqu''elle claquera au vent dans les déserts. La seule et unique condition pour l''équiper est d''être complétement torse nu en dessous, quitte à ressembler à Goultard, autant le faire jusqu''au bout. Prévoyez juste de quoi soigner vos coups de soleil.');
INSERT INTO "item_descriptions" VALUES(13043,'fr','Ce bouclier est une relique qui enferme la splendide épée brisée de Goultard. Vous vous demandez peut-être comment ce Iop pouvait être aussi puissant malgré son arme cassée ? Vous avez raison, cette question vous causera moins de nœuds au cerveau que la suivante : Quelle puissance aurait-il atteint avec une épée intacte ?');
INSERT INTO "item_descriptions" VALUES(13044,'fr','Cette coiffe légère et douce comme un nuage, procure un charisme presque éthéré à son porteur.');
INSERT INTO "item_descriptions" VALUES(13045,'fr','En adoptant cette cape, les douleurs lombaires ne seront plus qu''un lointain mauvais souvenir. Vous pourrez vous mouvoir avec légèreté sans avoir l''impression de porter le poids du monde des Douze sur les épaules.');
INSERT INTO "item_descriptions" VALUES(13046,'fr','Selon la rumeur, les volutes qui s''échappent de ce bouclier rendent vos mouvements flous aux yeux de votre adversaire.');
INSERT INTO "item_descriptions" VALUES(13047,'fr','L''armure de ce familier est conçue dans un métal innovant aussi léger qu''un pet de bouftou. Rassurez-vous, il n''en a pas l''odeur. Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(10000072,'fr','L''armure de ce familier est conçue dans un métal innovant aussi léger qu''un pet de bouftou. Rassurez-vous, il n''en a pas l''odeur. Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(13049,'fr','Cette coiffe rappellera sans aucun problème à vos adversaires qu''il faut se méfier de l''eau qui dort.');
INSERT INTO "item_descriptions" VALUES(13050,'fr','Porter cette cape, c''est un peu comme avoir toujours avec soi une petite outre remplie d''eau. Même perdu dans le désert de Saharach, grâce à elle vous ne connaitrez plus jamais la soif.');
INSERT INTO "item_descriptions" VALUES(13051,'fr','Dégoulinerez-vous de sueur en portant ce bouclier ou bien de plaisir en bloquant les attaques de vos adversaires ?');
INSERT INTO "item_descriptions" VALUES(13052,'fr','Ce petit familier est une véritable bouée de secours les jours où tout part à vau-l''eau ! Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(10000081,'fr','Ce petit familier est une véritable bouée de secours les jours où tout part à vau-l''eau ! Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(13054,'fr','En portant cette coiffe, vous rayonnez sur le monde des Douze comme un petit soleil !');
INSERT INTO "item_descriptions" VALUES(13055,'fr','Si vous êtes du genre à porter une petite laine dès que la température extérieure se rafraîchit, optez pour cette cape. Elle vous couvrira de sa chaleur diffuse pour une sensation des plus agréables. Évidemment, évitez de la porter en période caniculaire, vous auriez seulement la sensation de cuire sur place.');
INSERT INTO "item_descriptions" VALUES(13056,'fr','Ce bouclier illuminera vos journées, mais pas celles de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(13057,'fr','Ce familier est pourvu d''une armure à l''épreuve du feu. Attention, elle brûle ! Ah oui, mais non... Enfin si. Bref, tout va bien. Pfiou, on a eu chaud ! Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(10000039,'fr','Ce familier est pourvu d''une armure à l''épreuve du feu. Attention, elle brûle ! Ah oui, mais non... Enfin si. Bref, tout va bien. Pfiou, on a eu chaud ! Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(13059,'fr','Cette coiffe rappelle aux autres aventuriers que vous êtes vous aussi en perpétuelle évolution, tel un rameau de printemps.');
INSERT INTO "item_descriptions" VALUES(13060,'fr','En portant cette cape, il n''est pas impossible que de charmants petits volatiles viennent se poser sur vos épaules.');
INSERT INTO "item_descriptions" VALUES(13061,'fr','Ce bouclier fera pousser la flore à défaut de vous faire pousser des ailes.');
INSERT INTO "item_descriptions" VALUES(13062,'fr','Que vos adversaires n''essaient même pas de vous coller un pin ou de vous casser les noisettes, autrement ce petit soldat pètera aussitôt les plombs ! Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(10000071,'fr','Que vos adversaires n''essaient même pas de vous coller un pin ou de vous casser les noisettes, autrement ce petit soldat pètera aussitôt les plombs ! Ce familier dévoreur d''âme ne se nourrit que de créatures des Plaines Herbeuses.');
INSERT INTO "item_descriptions" VALUES(13064,'fr','Cette coiffe vous donnera un air rusé. À ne pas confondre avec la Coiffé Usée qui, elle, vous donnera l''air de rien.');
INSERT INTO "item_descriptions" VALUES(13065,'fr','Alors vous, vous ne manquez pas de panache !');
INSERT INTO "item_descriptions" VALUES(13066,'fr','Vos adversaires commencent à vous courir sur le pistil ? Dites-le avec des fleurs ! (Et un coup de bouclier sur la tête, accessoirement).');
INSERT INTO "item_descriptions" VALUES(13067,'fr','Ce petit familier a quelque chose de mystique et d''envoûtant qui ne tardera pas à déstabiliser vos adversaires.');
INSERT INTO "item_descriptions" VALUES(13068,'fr','Cette créature est extrêment mignonne, il suffit de croiser son regard pour tomber sous son charme. De plus, le parchemin qu''elle emmène partout avec elle comporte des informations absolument essentielles pour tout aventurier qui se respecte. En somme, une créature très chouette.');
INSERT INTO "item_descriptions" VALUES(13093,'fr','Ce bouclier est taillé comme un récéptacle et peut contenir beaucoup d''énergie.');
INSERT INTO "item_descriptions" VALUES(13096,'fr','Entre un dragon et lui, finalement, il n''y a pas tant de différences...');
INSERT INTO "item_descriptions" VALUES(13097,'fr','Ce diadème donnerait fière allure au plus médiocre des aventuriers. Alors, imaginez un peu l''effet qu''il aurait sur vous...');
INSERT INTO "item_descriptions" VALUES(13098,'fr','Une cape conçue dans un bois aussi léger qu''une coquille d''œuf et aussi robuste qu''une cuirasse de dragon.');
INSERT INTO "item_descriptions" VALUES(13099,'fr','Défendez vos biens les plus précieux comme un dragon défendrait sa progéniture.');
INSERT INTO "item_descriptions" VALUES(13106,'fr','Tant qu''il est revêtu sur une coiffe, ce masque peut magiquement attirer des citwouilles contenant des friandises, qui se ressemble s''assemble comme on dit ! Son pouvoir d''attraction est relativement faible et ce masque se désagrégera au bout de quelques combats. Attention, il ne semble pas protéger de la malédiction d''Halouine.');
INSERT INTO "item_descriptions" VALUES(13107,'fr','Tant qu''il est revêtu sur une coiffe, ce masque peut magiquement attirer des citwouilles contenant des friandises, qui se ressemble s''assemble comme on dit ! Son pouvoir d''attraction est relativement faible et ce masque se désagrégera au bout de quelques combats. Attention, il ne semble pas protéger de la malédiction d''Halouine.');
INSERT INTO "item_descriptions" VALUES(13108,'fr','Tant qu''il est revêtu sur une coiffe, ce masque peut magiquement attirer des citwouilles contenant des friandises, qui se ressemble s''assemble comme on dit ! Son pouvoir d''attraction est relativement faible et ce masque se désagrégera au bout de quelques combats. Attention, il ne semble pas protéger de la malédiction d''Halouine.');
INSERT INTO "item_descriptions" VALUES(13109,'fr','Tant qu''il est revêtu sur une coiffe, ce masque peut magiquement attirer des citwouilles contenant des friandises, qui se ressemble s''assemble comme on dit ! Son pouvoir d''attraction est correct mais il se désagrégera au bout de quelques combats. Attention, il ne semble pas protéger de la malédiction d''Halouine.');
INSERT INTO "item_descriptions" VALUES(13110,'fr','Tant qu''il est revêtu sur une coiffe, ce masque peut magiquement attirer des citwouilles contenant des friandises, qui se ressemble s''assemble comme on dit ! Son pouvoir d''attraction est correct mais il se désagrégera au bout de quelques combats. Attention, il ne semble pas protéger de la malédiction d''Halouine.');
INSERT INTO "item_descriptions" VALUES(13111,'fr','Tant qu''il est revêtu sur une coiffe, ce masque peut magiquement attirer des citwouilles contenant des friandises, qui se ressemble s''assemble comme on dit ! Son pouvoir d''attraction est correct mais il se désagrégera au bout de quelques combats. Attention, il ne semble pas protéger de la malédiction d''Halouine.');
INSERT INTO "item_descriptions" VALUES(13112,'fr','Tant qu''il est revêtu sur une coiffe, ce masque peut magiquement attirer des citwouilles contenant des friandises, qui se ressemble s''assemble comme on dit ! Son pouvoir d''attraction est phénoménal mais il se désagrégera au bout de quelques combats. Attention, il ne semble pas protéger de la malédiction d''Halouine.');
INSERT INTO "item_descriptions" VALUES(13113,'fr','Cet artefact servait à envoyer des aventuriers vers des terres inconnues. Allant de plus en plus loin à chaque exploration, ces derniers ne pouvaient s''empêcher de penser devant le portail : « Allez, une ptite der'' ! »');
INSERT INTO "item_descriptions" VALUES(13114,'fr','Vous pouvez être rassuré(e) : vos idées noires, pensées morbides et réflexions les plus difficiles à assumer seront désormais bien à l''abri des jugements sous ce couvre-chef.');
INSERT INTO "item_descriptions" VALUES(13115,'fr','Le message renvoyé par cette cape est assez clair : un sombre destin attend ceux qui vous approcheront d''un peu trop près...');
INSERT INTO "item_descriptions" VALUES(13116,'fr','C''est fou ce qu''on peut faire avec deux, trois bricoles récupérées au fond d''une vieille grotte humide et mal fréquentée.');
INSERT INTO "item_descriptions" VALUES(13121,'fr','Le seul inconvénient de ce casque, c''est qu''on finit par oublier à quel point vous êtes beau/belle comme un(e) dieu/déesse...');
INSERT INTO "item_descriptions" VALUES(13122,'fr','Cette cape vous donnera l''allure d''un dieu. Il ne vous restera plus qu''à réunir une horde de fidèles et à trouver le secret de l''immortalité pour en devenir réellement un !');
INSERT INTO "item_descriptions" VALUES(13123,'fr','La prophétie raconte que ce bouclier renverra à vos adversaires leur funeste destin. Celui de ne jamais vous ressembler. Trop dur...');
INSERT INTO "item_descriptions" VALUES(13124,'fr','Lustré avec le sang de vos adversaires, ce casque brillera autant que leurs entrailles.');
INSERT INTO "item_descriptions" VALUES(13125,'fr','Ah ! Bah voilà ! Vous n''aviez justement rien à vous mettre pour vos petites sauteries sacrificielles !');
INSERT INTO "item_descriptions" VALUES(13126,'fr','Pour être à la pointe de la mode, procurez-vous ce bouclier dare-dare !');
INSERT INTO "item_descriptions" VALUES(13128,'fr','Extirpée du permafrost dont elle était prisonnière depuis des lustres, cette petite créature, proche cousine du chacha de gouttière, n''a besoin que d''une chose : un foyer chaleureux où règne l''amour et les caresses. Vous auriez ça ?');
INSERT INTO "item_descriptions" VALUES(10000066,'fr','Extirpée du permafrost dont elle était prisonnière depuis des lustres, cette petite créature, proche cousine du chacha de gouttière, n''a besoin que d''une chose : un foyer chaleureux où règne l''amour et les caresses. Vous auriez ça ?');
INSERT INTO "item_descriptions" VALUES(13129,'fr','Ce diadème aux couleurs du héros d''Astrub Fallanster, en plus de sa noble apparence, serait un bon remède contre la gueule de bois.');
INSERT INTO "item_descriptions" VALUES(13130,'fr','Tout Féca digne de ce nom ne sort jamais sans sa cape et son bâton. Il ne pouvait en être autrement pour Fallanster, éminent représentant de cette classe.');
INSERT INTO "item_descriptions" VALUES(13131,'fr','L''écu du Féca !');
INSERT INTO "item_descriptions" VALUES(13132,'fr','On dit que le meilleur ami du berger féca n''est autre que le bouftou. Boufster va encore plus loin : il se prend carrément pour Fallanster !');
INSERT INTO "item_descriptions" VALUES(13133,'fr','Cette belle rondache éblouira vos ennemis et leur laissera penser qu''en plus de remporter vos combats, vous gagnez bien votre vie.');
INSERT INTO "item_descriptions" VALUES(13134,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13135,'fr','Avec ses pics taillés dans un bloc de glace vieux de plusieurs millénaires, ce casque est une véritable pièce historique qui fera fondre les scientifiques et biologistes. À manipuler avec précaution.');
INSERT INTO "item_descriptions" VALUES(13136,'fr','Pour conserver l''éclat de ses couleurs et son tombé délicat, cette cape doit impérativement être lavée à froid.');
INSERT INTO "item_descriptions" VALUES(13137,'fr','Ce bouclier était autrefois une pièce maîtresse de la sorbetière géante appartenant à Walla Wonki. Vous pourrez probablement y gratter quelques restes de sa spécialité : la glace au Dofus Cacao.');
INSERT INTO "item_descriptions" VALUES(13138,'fr','Fabriquée dans une matière des plus nobles, cette cape sera la parfaite illustration de votre gloire. Sauf si vous la salopez !');
INSERT INTO "item_descriptions" VALUES(13139,'fr','L''orichor est une ressource très prisée, sans doute parce qu''elle rappelle la grandeur du soleil. Attention quand même à ne pas choper le melon...');
INSERT INTO "item_descriptions" VALUES(13140,'fr','Votre défense : provoquer la défiance ! Quand vos adversaires croiseront le regard froid du Dragonnet doré estampillé sur votre bouclier, ils y regarderont à deux fois avant d''engager le combat.');
INSERT INTO "item_descriptions" VALUES(13141,'fr','Son tissu pourpre, ses broderies d''or et sa forme d''épée rappellent la part de noblesse qu''il y a dans chaque combat. Le noir illustre quant à lui leur issue... toujours fatale. Bon, on a bien cassé l''ambiance.');
INSERT INTO "item_descriptions" VALUES(13142,'fr','Au-delà de sa grande beauté, cette coiffe soulignera votre caractère bien trempé. Même ceux et celles qui ne vous connaissent pas sauront que vous n''en faites qu''à votre tête !');
INSERT INTO "item_descriptions" VALUES(13143,'fr','Sous cette crinière platine brûle un tempérament de feu ! Le Dragonnet doré vous apportera ce supplément d''âme et de confiance dont vous avez besoin au combat. Peut-être cette créature est-elle votre animal totem ?');
INSERT INTO "item_descriptions" VALUES(13144,'fr','Cette coiffe ressemble à s''y méprendre à un scalp directement arraché du crâne d''une créature maléfique. Ah ? C''est le cas ? Très bien...');
INSERT INTO "item_descriptions" VALUES(13145,'fr','On dit que, portée à l''envers, cette cape procure le même effet qu''une étreinte mortelle de Nécrome. Vous ne voulez vraiment pas essayer ?');
INSERT INTO "item_descriptions" VALUES(13146,'fr','De son unique œil violacé, ce bouclier conçu à partir d''une roche située au plus proche du cœur du Monde des Douze aurait tout vu de la libération des Nécromes. Son avis : vraiment pas jojo.');
INSERT INTO "item_descriptions" VALUES(13147,'fr','Malgré sa petite taille, la morsure de cette sordide créature dégage une salive pouvant faire fondre du métal. Son apparence peu avenante vous donnait cependant un petit aperçu de son potentiel limité en tant que docile animal de compagnie.');
INSERT INTO "item_descriptions" VALUES(13148,'fr','Le Krosmoz est vaste, tout autant que le nombre de ses héros. Seriez-vous capable de vaincre ces guerriers venus d''autres âges ou d''autres univers ? Avec ce bouclier, vous pouvez au moins en rêver.');
INSERT INTO "item_descriptions" VALUES(13149,'fr','Cette cape aux allures familières a été enchantée par Hel Munster lui-même suite aux demandes incessantes d''un célèbre couturier d''Astrub. Il désirait proposer une collection qui s''adapte aux couleurs de l''individu qui la porte. Décolorée par un procédé top secret, vous reconnaissez pourtant l''odeur caractéristique de la bave de Mulou qui s''en dégage... Beurk !');
INSERT INTO "item_descriptions" VALUES(13150,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13151,'fr','Un grand pouvoir implique une grande capuche, faites en bon usage.');
INSERT INTO "item_descriptions" VALUES(13152,'fr','Être un héros, c''est aussi porter le poids du monde sur ses épaules, tout comme celui de ses erreurs. Au point où vous en êtes, y ajouter une cape ne devrait pas changer grand-chose, mais elle vous apportera du réconfort sur ce chemin semé d''embûches.');
INSERT INTO "item_descriptions" VALUES(13153,'fr','Cette coiffe balancera un flot d''injures ininterrompu à vos adversaires. Préparez-vous à découvrir un vocabulaire fleuri en provenance directe de la Shukrute. Et à rougir un peu, aussi.');
INSERT INTO "item_descriptions" VALUES(13154,'fr','Avec cette cape, l''expression « avoir des yeux derrière la tête » prend tout son sens.');
INSERT INTO "item_descriptions" VALUES(13155,'fr','Ce bouclier vous protègera de beaucoup de choses, mais certainement pas du mauvais œil. Il a été forgé dans les flammes de la Shukrute, vous vous attendiez à quoi ?');
INSERT INTO "item_descriptions" VALUES(13156,'fr','Il suffit de voir comme il vous regarde pour comprendre que vous lui avez tapé dans l''œil...');
INSERT INTO "item_descriptions" VALUES(13157,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13158,'fr','Mais que fait-il ici ?');
INSERT INTO "item_descriptions" VALUES(13159,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13160,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13161,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13166,'fr','La Pandalache est une hache fantôme légendaire, connue pour sa lame intangible qui traverse la matière. Selon la légende, un courageux Pandawa a passé toute sa vie à essayer de couper un bois de bambou sacré avec cette hache. Cependant, la lame spectrale passait à travers le bambou sans l''abîmer, condamnant l''artisan à une quête sans fin.');
INSERT INTO "item_descriptions" VALUES(13167,'fr','La Coiffe de Bill de Grobe, ornée de motifs mystiques, est imprégnée de l''énergie spirituelle de l''île de Grobe. Légère et intangible, elle semble flotter autour de la tête de celui qui la porte.');
INSERT INTO "item_descriptions" VALUES(13168,'fr','L''amulette Grobe Bambou émet une douce lueur et amplifie les énergies spirituelles environnantes. Pour éviter de la perdre, on doit la garder constamment autour du cou, car elle pourrait traverser le sol.');
INSERT INTO "item_descriptions" VALUES(13169,'fr','Les Grollbes sont des sandales fantômes qui semblent rigides et inconfortables à première vue. Cependant, lorsqu''on les porte, on a la sensation agréable d''avoir les pieds enveloppés dans un nuage, procurant un confort inattendu.');
INSERT INTO "item_descriptions" VALUES(13170,'fr','La légende raconte qu''une personne aux mœurs douteuses avait créé une panoplie d''équipements spectrales pour se montrer. Ces objets disparaissaient visuellement de manière aléatoire, laissant le porteur totalement nu à certains moments. Après l''arrestation de cette personne par la milice d''Amakna, les autres équipements, furent perdus, ne laissant derrière que le Kumokan, qui continue de s''éclipser de temps à autre, rappelant cette étrange anecdote.');
INSERT INTO "item_descriptions" VALUES(13171,'fr','Le Grobouclier est une pièce d''équipement aussi intrigante qu''inutile. À part vous protéger des coups de fantômes, il n''arrête pas grand-chose. En somme, parfait pour parader dans l''au-delà, mais pas idéal pour une vraie bataille !');
INSERT INTO "item_descriptions" VALUES(13193,'fr','Grâce à ces lunettes, vous détecterez les fantômes plus vite que votre ombre. Priez pour que ce soit avant de vous faire tout engluer...');
INSERT INTO "item_descriptions" VALUES(13194,'fr','Avec cette cape, et surtout cette cage antifantôme surmontée du tout dernier modèle de posigrobeur désintégrant, vous avez une bonne chance, tout à fait infime, de vous en sortir sur l''île de Grobe.');
INSERT INTO "item_descriptions" VALUES(13195,'fr','Cet objet vous permettra de vous protéger des éclaboussures de slime, mais c''est surtout un mémo pour vous souvenir de votre plus grand adversaire sur les terres de Grobe : le terrible Fantôme Péki Garou !');
INSERT INTO "item_descriptions" VALUES(13196,'fr','Pour vous accompagner dans votre chasse au spectre, vous avez pensé à un machin inoffensif... qui vous venait du fond de votre enfance... Quelque chose de gentil, de mignon, qui ne pouvait pas vous faire de mal. Le Léopardo. Bon, celui auquel vous pensiez précisément n''est plus... Mais son fantôme est revenu !');
INSERT INTO "item_descriptions" VALUES(13199,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13200,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13201,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13202,'fr','Brandissez-le haut et fort, car même après votre mort, c''est le seul souvenir qui témoignera de tous vos efforts.');
INSERT INTO "item_descriptions" VALUES(13203,'fr','Grâce à ce dofus offert par les gardiens d''Ankama, vous pourrez dire « J''y étais ! » sans ressentir les affres de la nostalgie. Rendez-vous dans vingt ans ?');
INSERT INTO "item_descriptions" VALUES(13204,'fr','Cette cape aux allures familières a été enchantée par Hel Munster lui-même suite aux demandes incessantes d''un célèbre couturier d''Astrub. Il désirait proposer une collection qui s''adapte aux couleurs de l''individu qui la porte. Décolorée par un procédé top secret, vous reconnaissez pourtant l''odeur caractéristique de la bave de Mulou qui s''en dégage... Beurk !');
INSERT INTO "item_descriptions" VALUES(13205,'fr','Cette arme vous est prêtée par Notend Less qui voit en vous du potentiel... Bon, en réalité c''est plutôt votre côté "bête de foire" qui l''intéressait. Pas très élogieux. Dans tous les cas, elle vous permet de revêtir temporairement les traits d''une classe et c''est déjà pas si mal.');
INSERT INTO "item_descriptions" VALUES(13206,'fr','Cette arme vous est prêtée par Notend Less qui voit en vous du potentiel... Bon, en réalité c''est plutôt votre côté "bête de foire" qui l''intéressait. Pas très élogieux. Dans tous les cas, elle vous permet de revêtir temporairement les traits d''une classe et c''est déjà pas si mal.');
