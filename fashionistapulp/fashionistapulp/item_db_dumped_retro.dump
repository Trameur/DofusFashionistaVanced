INSERT INTO "item_descriptions" VALUES(10000027,'pt','Uma pequena mascote movida por grandes valores. E aí, tem certeza de que você é digno(a)? Ahhh, calma, foi só para provocar você.');
INSERT INTO "item_descriptions" VALUES(10000028,'pt','Uma pequena mascote movida por grandes valores. E aí, tem certeza de que você é digno(a)? Ahhh, calma, foi só para provocar você.');
INSERT INTO "item_descriptions" VALUES(11804,'pt','Após passar anos vendo seus filhos sendo devorados na Ilha da Lua, Iop decidiu virar o jogo e domar o Greedovore. Apesar de ser uma gracinha, ele se alimenta de seus semelhantes... Bom, melhor que de Iops! Esta alma esfomeada se alimentará das sobras das criaturas da Ilha da Lua.');
INSERT INTO "item_descriptions" VALUES(11809,'pt','Não é fofo? Tudo bem que está armado até os dentes, mas o que esperar de um aliadozinho de Iop? Agora que você é o dono dele, faça um agrado ao bichinho: mostre o que é uma luta de verdade!');
INSERT INTO "item_descriptions" VALUES(10000034,'pt','Não é fofo? Tudo bem que está armado até os dentes, mas o que esperar de um aliadozinho de Iop? Agora que você é o dono dele, faça um agrado ao bichinho: mostre o que é uma luta de verdade!');
