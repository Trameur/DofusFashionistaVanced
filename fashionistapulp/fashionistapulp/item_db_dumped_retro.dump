INSERT INTO "item_descriptions" VALUES(7822,'pt','Este certificado lhe autoriza a pegar a sua montaria no curral.
Advertência! Este certificado será válido por apenas 20 dias. Quando esse tempo estiver acabado, sua montaria será enviada de volta para a natureza e o seu certificado já não será válido. Você não poderá pegar a sua montaria de volta. Não se esqueça de deixar a sua montaria em um curral se for ficar fora por muito tempo.');
