INSERT INTO "item_descriptions" VALUES(7874,'pt','Dragossauro Ameixa e TurquesaEste certificado lhe autoriza a pegar a sua montaria no curral. 
Advertência! Este certificado será válido por apenas 20 dias. Quando esse tempo estiver acabado, sua montaria será enviada de volta para a natureza e o seu certificado já não será válido. Você não poderá pegar a sua montaria de volta. Não se esqueça de deixar a sua montaria em um curral se for ficar fora por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7875,'pt','Dragossauro Ameixa e OrquídeaEste certificado lhe autoriza a pegar a sua montaria no curral.
Advertência! Este certificado será válido por apenas 20 dias. Quando esse tempo estiver acabado, sua montaria será enviada de volta para a natureza e o seu certificado já não será válido. Você não poderá pegar a sua montaria de volta. Não se esqueça de deixar a sua montaria em um curral se for ficar fora por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7876,'pt','Esse certificado o autoriza a pegar a sua montaria no curral.
Advertência! Esse certificado será válido por apenas 20 dias. Quando esse tempo estiver acabado, sua montaria será enviada de volta para a natureza e o seu certificado já não será válido. Você não poderá pegar a sua montaria de volta. Não se esqueça de deixar a sua montaria em um curral se for ficar fora por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7880,'pt','Este Amuleto costumava ser usado por todos os aventureiros que preferiam fazer amor a fazer a guerra. Cada um tem seu gosto.');
INSERT INTO "item_descriptions" VALUES(7881,'pt','Este anel lhe permitirá machucar ainda mais quando der surras bem merecidas em seus filhos.');
INSERT INTO "item_descriptions" VALUES(7882,'pt','Este martelo é perfeito para expressar seu pacifismo nos crânios de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(7883,'pt','Cheias de lã de Gobkool, estas botas são simplesmente fantásticas. Leves e mornas para a estação fria, e frescas para a estação quente, elas vão satisfazer até o mais “entediado” dos aventureiros.');
INSERT INTO "item_descriptions" VALUES(7884,'pt','Se você é o tipo da pessoa que sempre pensa positivo, esta capa é perfeita para você. É tão espessa e confortável que pode ser usada como uma cama improvisada, quando você se sentir extremamente sonolento. Seu cheiro de Kaliptus até repele insetos e criaturas não desejadas.');
INSERT INTO "item_descriptions" VALUES(7885,'pt','Usado em volta de seus quadris, este cinto fará você parecer com um aventureiro pacífico e lhe permitirá surpreender seus inimigos dando-lhes um golpe de espada nas costas.');
INSERT INTO "item_descriptions" VALUES(7886,'pt','Você certamente não parecerá mais esperto com este elmo. Entretanto, você parecerá muito ‘legal'' e no fim das contas, isto é tudo o que importa.');
INSERT INTO "item_descriptions" VALUES(7887,'pt','Este capacete para cabeça pertenceu ao famoso Koolich, famoso por seus pés de argila e lendário bom humor.');
INSERT INTO "item_descriptions" VALUES(7888,'pt','O Koolich usa esta sacola para manter frescos seus Kaliptus ou para sufocar Koalaks mais ousados.');
INSERT INTO "item_descriptions" VALUES(7889,'pt','Estas botas costumavam pertencer ao Koolich e, se você não acreditar, basta sentir o cheiro!! Estas botas são tão confortáveis que você poderá esquecer o quão miserável é a sua existência.');
INSERT INTO "item_descriptions" VALUES(7890,'pt','Este cajado é mesmo um osso oco de um ancestral de Koolich. Furado de ambos os lados, ele pode ser usado como um cano de Kaliptus, mas também como um bastão de pastor. Deus abençoe a tecnologia!');
INSERT INTO "item_descriptions" VALUES(7891,'pt','Este pequeno Wabbit é na verdade um filho secreto do notório Wa Wabbit. Talvez um dia ele ascenderá ao trono.');
INSERT INTO "item_descriptions" VALUES(10000051,'pt','Este pequeno Wabbit é na verdade um filho secreto do notório Wa Wabbit. Talvez um dia ele ascenderá ao trono.');
INSERT INTO "item_descriptions" VALUES(10000052,'pt','Este pequeno Wabbit é na verdade um filho secreto do notório Wa Wabbit. Talvez um dia ele ascenderá ao trono.');
INSERT INTO "item_descriptions" VALUES(10000053,'pt','Este pequeno Wabbit é na verdade um filho secreto do notório Wa Wabbit. Talvez um dia ele ascenderá ao trono.');
INSERT INTO "item_descriptions" VALUES(10000054,'pt','Este pequeno Wabbit é na verdade um filho secreto do notório Wa Wabbit. Talvez um dia ele ascenderá ao trono.');
INSERT INTO "item_descriptions" VALUES(7892,'pt','Willy Peninzias é uma criatura suja. Teve uma infância muito difícil, pelo que parece. Desde então, se vinga comendo todos os animais empalhados que ele topa.');
INSERT INTO "item_descriptions" VALUES(7902,'pt','Uma velha lenda extraída do famoso livro intitulado “Tudo Que Você Precisa Saber Sobre as Mulheres” diz que este cinto uma vez pertenceu a uma dama dourada, muito mais interessada em riqueza do que em poder. Na versão não censurada deste livro, também aprendemos que ela adorava piadas obscenas. Finalmente, ela não era tão diferente das outras mulheres...');
INSERT INTO "item_descriptions" VALUES(7911,'pt','Este pequeno Koalak parece inocente, mas ele esconde bem sua verdadeira personalidade. Infeliz quando era jovem, ele era golpeado por bumerangues no rosto ou no traseiro. É por isso que ele odeia bumerangues agora e os devora sem nem mesmo mastigá-los.');
INSERT INTO "item_descriptions" VALUES(10000006,'pt','Este pequeno Koalak parece inocente, mas ele esconde bem sua verdadeira personalidade. Infeliz quando era jovem, ele era golpeado por bumerangues no rosto ou no traseiro. É por isso que ele odeia bumerangues agora e os devora sem nem mesmo mastigá-los.');
INSERT INTO "item_descriptions" VALUES(7913,'pt','Este misterioso item esquecido por alguém costumava pertencer a um grande mago... Dizem que lhe permitia falar com certos animais...');
INSERT INTO "item_descriptions" VALUES(7920,'pt','Esta modesta varinha mágica permite aos Mestres de Jogo teletransportar aventureiros para uma área reservada a torneios.');
INSERT INTO "item_descriptions" VALUES(7921,'pt','Esta coroa é bem difícil de pegar. Sempre escapa entre seus dedos. Sem dúvida! É a Coroa de Tofu Real! Entretanto, não parece servir em sua cabeça pequena, sem mencionar a de um Iop!');
INSERT INTO "item_descriptions" VALUES(7997,'pt','Esta espada mágica foi forjada por rituais do Minotot.');
INSERT INTO "item_descriptions" VALUES(7999,'pt','Alguns aventureiros dizem que essa capa é tão áspera quanto a pele de um crocodilo. Outros dizem ser ainda mais áspera que as costas de uma Bwork fêmea. Certifique-se de vesti-la da maneira correta, se não quiser ser descascado como uma laranja.');
INSERT INTO "item_descriptions" VALUES(8000,'pt','Esta pequena criatura é um Bwork. Ele vem sendo mantido vivo preso dentro de um jarro há várias décadas. Então, ele tomou a forma do jarro e agora será um anão a vida inteira. Seu bom humor e o humor lendário fazem dele o companheiro perfeito para calabouços que você sabe que não pode vencer, ou para tumultuadas festas da sociedade.');
INSERT INTO "item_descriptions" VALUES(10000015,'pt','Esta pequena criatura é um Bwork. Ele vem sendo mantido vivo preso dentro de um jarro há várias décadas. Então, ele tomou a forma do jarro e agora será um anão a vida inteira. Seu bom humor e o humor lendário fazem dele o companheiro perfeito para calabouços que você sabe que não pode vencer, ou para tumultuadas festas da sociedade.');
INSERT INTO "item_descriptions" VALUES(8003,'pt','Este amuleto não se parece com nenhum outro, simplesmente por não existir nenhum amuleto como este.');
INSERT INTO "item_descriptions" VALUES(8004,'pt','Este magnífico anel é usado por muitos Koalaks que ousam roubá-lo de aventureiros que saem do banco em Astrub.');
INSERT INTO "item_descriptions" VALUES(8005,'pt','Este arco surpreendente permite que você roube a vida de seus oponentes algumas vezes. Não é nada demais, porém, continua sendo impressionante.');
INSERT INTO "item_descriptions" VALUES(8006,'pt','Estas botas são de pés de Koalok de verdade, que foram brutalmente arrancados. Então foi esvaziado o seu conteúdo e recoberto com pêlos de Koalok. Espantosas e atraentes, estas botas vão torná-lo o terror de Astrub.');
INSERT INTO "item_descriptions" VALUES(8007,'pt','Este manto o protegerá de muitos ataques, mas não de parecer ridículo.');
INSERT INTO "item_descriptions" VALUES(8008,'pt','Este cinto, feito de Kaliptus, espalha um bom cheiro pelo camponês, que pode escondê-lo de outros. Além disso, este cinto é perfeito para esconder suas gordurinhas.');
INSERT INTO "item_descriptions" VALUES(8009,'pt','Este capacete é adornado com grandes orelhas de Koalak que amplificam os sons emitidos por criaturas ao redor. Tenha cuidado, ele pode destruir seus tímpanos se seus amigos são adeptos de ventos de pânico.');
INSERT INTO "item_descriptions" VALUES(8014,'pt','Esta pequena criatura passa seus dias e noites escavando corpos em cemitérios para fazer novos amigos. O mais surpreendente é que parece dar certo.');
INSERT INTO "item_descriptions" VALUES(8015,'pt','Como o nome indica, este jovem Koalak está na metade do seu crescimento. Talvez nunca pare de crescer e se torne tão alto quanto você. Então, você será o animal de estimação dele.');
INSERT INTO "item_descriptions" VALUES(8067,'pt','Alguns aventureiros dizem que estas botas permitem caminhar sobre armadilhas sem ativá-las. Mas tenha cuidado, pois isso pode ser uma armadilha...');
INSERT INTO "item_descriptions" VALUES(8068,'pt','Esta esplêndida capa foi criada com ombreiras para fazer você, finalmente, parecer um verdadeiro campeão.');
INSERT INTO "item_descriptions" VALUES(8069,'pt','Com este imponente capacete, você, obviamente, ficará com um cabeção, se já não tiver um!');
INSERT INTO "item_descriptions" VALUES(8070,'pt','Com este cinto em volta dos quadris, você esconderá facilmente o que não mostra as suas vantagens.');
INSERT INTO "item_descriptions" VALUES(8071,'pt','Esta pequena criatura só aceita seguir campeões... Então ele o seguirá por alguns dias antes de descobrir que você é um impostor. A partir deste momento, você é quem seguirá como um pequeno animalzinho de estimação.');
INSERT INTO "item_descriptions" VALUES(8072,'pt','Ninguém sabe sobre o dragão que criou este Dofus. Dizem que ele ingeriu uma incrível quantidade de Kaliptus, botou o ovo e morreu de uma terrível prisão de ventre.');
INSERT INTO "item_descriptions" VALUES(8088,'pt','Esta varinha mágica feita de nada, possui uma mágica incrível. A lenda diz que pode mover seu possuidor, escolhe seu alvo e o protege até mesmo quando estiver morrendo.');
INSERT INTO "item_descriptions" VALUES(8089,'pt','Iots era um papagaio que repetia tudo que você dizia. Dizem que esta varinha mágica foi forjada em seu bico.');
INSERT INTO "item_descriptions" VALUES(8090,'pt','Este cajado já mordeu pessoas ou, talvez, as pessoas o tenham mordido. Não podemos lhes dizer com certeza.');
INSERT INTO "item_descriptions" VALUES(8091,'pt','Este pedaço de taquara vem da parte sul do país. Infelizmente, ele não se transformou em ouro quando estava lá.');
INSERT INTO "item_descriptions" VALUES(8092,'pt','O Ostwogoth não é afiado nem esperto, mas, quando tem adagas em suas hábeis mãos, ninguém se arrisca a enfrentá-lo.');
INSERT INTO "item_descriptions" VALUES(8093,'pt','Carregar estas adagas não fará de você um herói... Elas podem deixá-lo parecido com uma heroína se carregar nas suas calcinhas.');
INSERT INTO "item_descriptions" VALUES(8094,'pt','Esta espada ilustra perfeitamente o velho provérbio Iop ‘Por trás de um inimigo morto, está uma espada hilariante''.');
INSERT INTO "item_descriptions" VALUES(8095,'pt','Esta espada foi forjada de acordo com esteticismo específico para você decorar sua lareira luxuosa. Mas por ser bem eficiente em luta, também é muito usada. As pessoas não respeitam mais a arte.');
INSERT INTO "item_descriptions" VALUES(8096,'pt','Seu antigo dono costumava dançar com Moolobos. Ele foi comido rapidamente.');
INSERT INTO "item_descriptions" VALUES(8097,'pt','Este martelo fará você ver a vida com um tom mais rosa antes de esmagar sua cabeça em vários pedaços.');
INSERT INTO "item_descriptions" VALUES(8098,'pt','Este machado é muito especial. Sua lâmina vibratória toca belas músicas enquanto você dilacera a vida de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(8099,'pt','Esta arma foi mergulhada em uma fonte de raios puros e, então, foi borrifado pó de estrela. Mas diz o rumor que nada disto é verdade.');
INSERT INTO "item_descriptions" VALUES(8100,'pt','Este machado foi perfurado em diversos lugares, fazendo-o assobiar alegremente ao bater em seus inimigos. Mas ele silencia os gritos de dor de seus inimigos. Que pena!');
INSERT INTO "item_descriptions" VALUES(8101,'pt','Este machado foi forjado por Brouce Boulgoure quando ele tentou se tornar um padeiro para agradar seu amigo Xavier, o padeiro. Ele quis fazer uma pá de torta.++');
INSERT INTO "item_descriptions" VALUES(8103,'pt','Este arco é, de fato, o cabelo fossilizado de um Sadida que dormiu por muito tempo e no qual Aracnes teceram suas teias.');
INSERT INTO "item_descriptions" VALUES(8104,'pt','Este arco tem uma cor estranha, mas é perfeito para ser exibido no Zaap de Bonta... Você não se passará por um galo, mas, seguramente, atrairá todos os pintinhos!!! Às vezes incrível, às vezes asqueroso, ele pode até derrotar seus inimigos sem que você tenha de atirar ao menos uma flecha.');
INSERT INTO "item_descriptions" VALUES(8108,'pt','Tão leve quanto uma pena de Tofu, este amuleto pode ser usado ao redor do pescoço ou ao redor da testa, se você quiser ser original.');
INSERT INTO "item_descriptions" VALUES(8109,'pt','Este anel ridiculamente pequeno pode acabar sendo essencial. Realmente, seus inimigos podem ter tanta piedade de você, que acabarão contigo em vez de o deixarem agonizar. Vamos pensar positivo!');
INSERT INTO "item_descriptions" VALUES(8110,'pt','Ao contrário do que alguns aventureiros podem pensar, esta varinha mágica não é usada pelos Tofus (modo muito estúpido de se saber usar tal arma), mas contra os Tofus. Realmente, esta varinha mágica é feita de penas de Tofu que permitem aos caçadores simular a dança de acasalamento deles para pegá-los. O que mais estes terríveis caçadores inventarão para satisfazer seus instintos?');
INSERT INTO "item_descriptions" VALUES(8111,'pt','Leves e macios, esses chinelos são mornos no inverno e frios no verão. Infelizmente, eles não podem ser lavados em lavadoras de roupas.');
INSERT INTO "item_descriptions" VALUES(8112,'pt','Este misterioso manto foi cortado pela metade. Mas por que alguém cortaria isto pela metade? Ninguém sabe... apesar de todo mundo ter sua própria opinião sobre isto.');
INSERT INTO "item_descriptions" VALUES(8113,'pt','Este cinto é a ferramenta ideal para estrangular Tofus, mas caçadores também o usam para chicotear forasteiros que se aventuram em suas terras na época da caça. Portanto, aconselhamos a não brincar com os nossos amigos caçadores. Tofus não são os únicos numa situação ruim!');
INSERT INTO "item_descriptions" VALUES(8114,'pt','Este capacete, seguramente, se torna um item da moda que toda aventureira deveria ter. Qual o problema com este mundo?');
INSERT INTO "item_descriptions" VALUES(8116,'pt','Este capacete é perfeito para esconder suas acnes de adolescente ou sua cara feia ou angelical.');
INSERT INTO "item_descriptions" VALUES(8117,'pt','Mais dourada que Escaracapa clássica e menos preta que a Escaracapa preta, esta capa é perfeita para esconder seu crescimento. O Escarafeio costumava usá-la para esconder sua horrível corcunda. Hoje em dia, esta capa é muito usada para esconder a terrível aparência das costas. Nem é preciso dizer que esta capa é muito popular.');
INSERT INTO "item_descriptions" VALUES(8118,'pt','Esta varinha mágica é perfeita para limpar mobília antiga ou pessoas velhas.');
INSERT INTO "item_descriptions" VALUES(8119,'pt','Se você adora correr nu pelas praias da paradisíaca Ilha de Lua, certamente gostará deste cinto.');
INSERT INTO "item_descriptions" VALUES(8120,'pt','Usado em um torso peludo, este amuleto parece fantástico! Tufos de pêlo são a combinação perfeita para este amuleto.');
INSERT INTO "item_descriptions" VALUES(8121,'pt','Um Escarafeio é uma criatura estranha. Nasce concurda e feio, é motivo de piada entre os Escarafolhas. Pode ser esse o motivo que faz você se sentir tão perto dessa criatura.');
INSERT INTO "item_descriptions" VALUES(8122,'pt','Estas botas de escalada tornam fácil subir por penhascos ou lavrar seus campos sem usar um arado.');
INSERT INTO "item_descriptions" VALUES(8123,'pt','Este amuleto cheira a óleo de Girassol Selvagem e ervas. Você pode usá-lo como isca para pegar perigosos ruminantes que gostaria de aprisionar, como Gobballs ou sogras, por exemplo.');
INSERT INTO "item_descriptions" VALUES(8124,'pt','Este cinto é simplesmente excepcional, assim como a bermuda de linho presa a ele. Este cinto é projetado para aqueles que gostam de se livrar das roupas e agir depressa. Entretanto, tenha cuidado. Por motivos higiênicos, este cinto é proibido em piscinas públicas.');
INSERT INTO "item_descriptions" VALUES(8125,'pt','Se você precisa estar protegido do sol enquanto trabalha nos campos, então você precisa de um elmo Slob. Se você precisa estar protegido do sol enquanto trabalha nos campos e se você é pobre, tudo o que você precisa é do famoso Sombreiro do Fazendeiro.');
INSERT INTO "item_descriptions" VALUES(8126,'pt','Estas luvas roídas por traças são um verdadeiro tesouro. Elas parecem ser cobertas com pó de diamante, o que lhes dá uma extraordinária resistência. Elas têm um lado abrasivo perfeito para esfregar o traseiro de seus Gobballs ou daquela sua esposa.');
INSERT INTO "item_descriptions" VALUES(8127,'pt','Esta robusta, porém danificada foice não corta muito bem já que tem sido muito usada. Entretanto, é extremamente eficiente extrair tenras carnes superficiais e para arrancar as varizes de seus oponentes.');
INSERT INTO "item_descriptions" VALUES(8128,'pt','Estas botas são acolchoadas com palha de trigo, o que lhes permite absorver a transpiração e cultivar cogumelos tóxicos a um pequeno custo. Graças às suas suaves solas, elas foram recomendadas pelos melhores jogadores de Gobbol.');
INSERT INTO "item_descriptions" VALUES(8129,'pt','Atrás deste estúpido nome você encontrará um amuleto extremamente poderoso, feito com caninos e ossos de Boolobo, o que explica o terrível odor dele. Pode ser que ele não se adapte ao seu pescoço, mas se adaptará perfeitamente ao seu hálito.');
INSERT INTO "item_descriptions" VALUES(8130,'pt','Este terrível machado decapitou muitos aventureiros precipitados ainda que ele não corte muito bem. Realmente, uma dúzia de tentativas pode ser necessária para terminar de cortar um pescoço resistente.');
INSERT INTO "item_descriptions" VALUES(8131,'pt','Esta sacola é muito badalada entre os jovens alunos e é ideal para armazenar farinhas animais e vegetais. Uma vez aberta, desdobrada e descosturada, você poderá usá-la como uma saia se você não se importar em mostrar suas pernas cabeludas.');
INSERT INTO "item_descriptions" VALUES(8132,'pt','Este cinto é tudo, menos original. Entretanto, parece estar combinando com seu corte de cabelo.');
INSERT INTO "item_descriptions" VALUES(8133,'pt','Este capacete é perfeito para aqueles que querem ver o lado negro das coisas.');
INSERT INTO "item_descriptions" VALUES(8134,'pt','Se você não tem condições de comprar uma Caracapa Mastralis, mas você gosta de assustar Aracnes vestindo roupas pretas, esta é a capa que você precisa!');
INSERT INTO "item_descriptions" VALUES(8136,'pt','Este belo anel pode ser usado no seu dedão do pé. É perfeito para esconder suas verrugas e suas unhas encravadas.');
INSERT INTO "item_descriptions" VALUES(8146,'pt','Se você gosta de dançar e pisar nos pés dos seus parceiros, estas botas foram feitas para você!');
INSERT INTO "item_descriptions" VALUES(8147,'pt','Esta é uma versão melhorada do capacete de Crackler. Esta rocha fornece proteção eficiente contra rochas que deslizam, mas não contra a perda de cabelo.');
INSERT INTO "item_descriptions" VALUES(8148,'pt','Este martelo enorme é na verdade uma espada de Crackler, adornada com uma rocha de um lendário Crackler. Esta criação surpreendente surpreenderá seus oponentes, logo antes de esmagá-los.');
INSERT INTO "item_descriptions" VALUES(8149,'pt','Esta rocha adornada com pedras preciosas é perfeita para marcar os tempos ou a testa de seus inimigos para sempre.');
INSERT INTO "item_descriptions" VALUES(8150,'pt','De aparência modesta, este amuleto contém muitos segredos, incluindo um que conta os segredos que ele contém.');
INSERT INTO "item_descriptions" VALUES(8151,'pt','Este monstrinho o seguirá em todos os lugares e comerá os restos dos companheiros dele. Tanto apavorante quanto divertido, ele iluminará sua vida, talvez antes de tirá-la de você para sempre.');
INSERT INTO "item_descriptions" VALUES(10000044,'pt','Este monstrinho o seguirá em todos os lugares e comerá os restos dos companheiros dele. Tanto apavorante quanto divertido, ele iluminará sua vida, talvez antes de tirá-la de você para sempre.');
INSERT INTO "item_descriptions" VALUES(8152,'pt','O lendário Crackler usa este cinto em torno dos dedos dos pés e você em torno da cintura ou do tornozelo, talvez...');
INSERT INTO "item_descriptions" VALUES(8153,'pt','Este jovem Treechnid não podia mais permanecer em sua família, e como você, ele decidiu se rebelar. Hoje, ele o acompanha e contará todos os membros da família dele que você conseguirá exterminar.');
INSERT INTO "item_descriptions" VALUES(8154,'pt','Esta encantadora coisa pequena é, na verdade, um perigoso besouro. Humilhado por seus amigos quando era mais jovem, ele decidiu começar sua vingança e a ajudá-lo a chutar o traseiro de todo o Escarafolha que você encontrar.');
INSERT INTO "item_descriptions" VALUES(10000029,'pt','Esta encantadora coisa pequena é, na verdade, um perigoso besouro. Humilhado por seus amigos quando era mais jovem, ele decidiu começar sua vingança e a ajudá-lo a chutar o traseiro de todo o Escarafolha que você encontrar.');
INSERT INTO "item_descriptions" VALUES(10000030,'pt','Esta encantadora coisa pequena é, na verdade, um perigoso besouro. Humilhado por seus amigos quando era mais jovem, ele decidiu começar sua vingança e a ajudá-lo a chutar o traseiro de todo o Escarafolha que você encontrar.');
INSERT INTO "item_descriptions" VALUES(10000031,'pt','Esta encantadora coisa pequena é, na verdade, um perigoso besouro. Humilhado por seus amigos quando era mais jovem, ele decidiu começar sua vingança e a ajudá-lo a chutar o traseiro de todo o Escarafolha que você encontrar.');
INSERT INTO "item_descriptions" VALUES(10000032,'pt','Esta encantadora coisa pequena é, na verdade, um perigoso besouro. Humilhado por seus amigos quando era mais jovem, ele decidiu começar sua vingança e a ajudá-lo a chutar o traseiro de todo o Escarafolha que você encontrar.');
INSERT INTO "item_descriptions" VALUES(10000033,'pt','Esta encantadora coisa pequena é, na verdade, um perigoso besouro. Humilhado por seus amigos quando era mais jovem, ele decidiu começar sua vingança e a ajudá-lo a chutar o traseiro de todo o Escarafolha que você encontrar.');
INSERT INTO "item_descriptions" VALUES(8155,'pt','Esta criatura esplêndida é um parente distante do famoso Lenald da Ilha de Wabbits. Muito afobada, mas também muito mais indisciplinada, ela o ajudará durante suas lutas e sua inacreditável traição também ajudará você a derrotar os membros da própria família.');
INSERT INTO "item_descriptions" VALUES(10000055,'pt','Esta criatura esplêndida é um parente distante do famoso Lenald da Ilha de Wabbits. Muito afobada, mas também muito mais indisciplinada, ela o ajudará durante suas lutas e sua inacreditável traição também ajudará você a derrotar os membros da própria família.');
INSERT INTO "item_descriptions" VALUES(8162,'pt','Com esta abópota mágica na cabeça, você parece mais idiota do que o normal. Mas lembre-se da maldição de Al Howin... que os transforma em criaturas desfiguradas...
parece que esse item para a cabeça é a única coisa que pode protegê-los dessa terrível maldição.');
INSERT INTO "item_descriptions" VALUES(8163,'pt','Antes pertencente às autoridades das maiores cidades, este capacete agora é usado para assustar quem se rebela e quer saber mais sobre o universo que o rodeia.');
INSERT INTO "item_descriptions" VALUES(8181,'pt','Esta capa feita de uma pedra grande o transforma em uma pedra grande e bruta.');
INSERT INTO "item_descriptions" VALUES(8211,'pt','Obviamente, esta criatura parece ter escapado de um zoológico ou de uma ilha remota. É sábio e aumenta o estrago do seu mestre em luta. Sua maior particularidade (que ele às vezes compartilha com seu mestre) é um sopro de peixe podre. É sugerido alimentar à força com doces de menta de vez em quando, mesmo que os doces sejam em partes. Cuidado: esta pequena criatura é muito difícil de agradar. Ela não come nada além de peixe.');
INSERT INTO "item_descriptions" VALUES(8213,'pt','Este amuleto parece ter sido feito com uma pequena cabeça seca de Piwi. Aparentemente, é inestimável.');
INSERT INTO "item_descriptions" VALUES(8214,'pt','Este amuleto parece ter sido feito de uma pequena cabeça seca de Piwi. A aparência é inestimável.');
INSERT INTO "item_descriptions" VALUES(8215,'pt','Este amuleto parece ter sido feito com uma pequena cabeça seca de Piwi. Aparentemente, é inestimável.');
INSERT INTO "item_descriptions" VALUES(8216,'pt','Este amuleto parece ter sido feito de uma pequena cabeça seca de Piwi. Aparentemente, é inestimável.');
INSERT INTO "item_descriptions" VALUES(8217,'pt','Este amuleto parece ter sido feito com uma cabeça de Piwi. Parece que é inestimável.');
INSERT INTO "item_descriptions" VALUES(8218,'pt','Este amuleto parece ter sido feito com uma pequena cabeça seca de Piwi. A aparência não tem preço.');
INSERT INTO "item_descriptions" VALUES(8219,'pt','Este anel permitirá que seu amado a encontre, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8220,'pt','Este anel permitirá à sua amada encontrá-lo, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8221,'pt','Este anel permitirá que seu amado a encontre, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8222,'pt','Este anel permitirá que o seu amado a encontre, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8223,'pt','Este anel fará o seu amor te achar, mas ninguém te quer.');
INSERT INTO "item_descriptions" VALUES(8224,'pt','Este anel permite à seu amada encontrá-lo, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8225,'pt','Perfeitas para proteger seus pezinhos e esmagar pequenas criaturas rastejando entre as folhas de grama como Xelors ou Eniripsas por exemplo.');
INSERT INTO "item_descriptions" VALUES(8226,'pt','Elas são perfeitas para proteger seus pequenos pés e para esmagar pequenas criaturas que rastejam pela grama como Xelors ou Eniripsas, por exemplo.');
INSERT INTO "item_descriptions" VALUES(8227,'pt','Perfeitas para proteger seus pezinhos e esmagar pequenas criaturas rastejando entre as folhas de grama como Xelors ou Eniripsas por exemplo.');
INSERT INTO "item_descriptions" VALUES(8228,'pt','São perfeitas para proteger seus pezinhos e esmagar criaturas pequenas rastejando entre a grama como Xelors e Eniripsas, por exemplo.');
INSERT INTO "item_descriptions" VALUES(8229,'pt','São perfeitas para proteger para seus pés e das abobrinhas das criaturas pequenas rastejantes entre a grama como Xelors ou Eniripsas, por exemplo.');
INSERT INTO "item_descriptions" VALUES(8230,'pt','Elas são perfeitas para proteger o seu pequeno pé e para esmagar pequenas criaturas rastejando na grama como Xelors e Eniripsas por exemplo.');
INSERT INTO "item_descriptions" VALUES(8231,'pt','Se você for mesmo pequeno, esta capa feita com algumas penas de Piwi cobrirá o seu traseiro. Uma modesta proteção que chamará a atenção das pessoas para qualquer outra coisa que não seja o seu cabelo oleoso e suas grandes verrugas .');
INSERT INTO "item_descriptions" VALUES(8232,'pt','Se você for mesmo pequeno, esta capa feita com algumas penas de Piwi cobrirá o seu traseiro. Uma modesta proteção que chamará a atenção das pessoas para qualquer outra coisa que não seja o seu cabelo oleoso e suas grandes verrugas .');
INSERT INTO "item_descriptions" VALUES(8233,'pt','Se você é pequeno o bastante, esta capa feita com algumas penas de Piwi pode cobrir suas costas. Uma proteção modesta que atrairá a atenção das pessoas para outra coisa além do seu cabelo oleoso e grandes verrugas.');
INSERT INTO "item_descriptions" VALUES(8234,'pt','Se você for mesmo pequeno, esta capa feita com algumas penas de Piwi cobrirá o seu traseiro. Uma modesta proteção que chamará a atenção das pessoas para qualquer outra coisa que não seja o seu cabelo oleoso e suas grandes verrugas .');
INSERT INTO "item_descriptions" VALUES(8235,'pt','Se você for mesmo pequeno, esta capa feita com algumas penas de Piwi cobrirá o seu traseiro. Uma modesta proteção que chamará a atenção das pessoas para qualquer outra coisa que não seja o seu cabelo oleoso e suas grandes verrugas .');
INSERT INTO "item_descriptions" VALUES(8236,'pt','Se você for mesmo pequeno, esta capa feita com algumas penas de Piwi cobrirá o seu traseiro Uma proteção modesta que tirará atenção das pessoas a algo mais do que o seu cabelo gorduroso e as suas grandes verrugas.');
INSERT INTO "item_descriptions" VALUES(8237,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8238,'pt','Este cinto pequeno liberará seus quadris em uma luta. Então, ele servirá para conter suas tripas quando um agressivo javali das planícies o destripar nas profundezas da floresta.');
INSERT INTO "item_descriptions" VALUES(8239,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8240,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8241,'pt','Este pequeno cinto tirará seus quadris para uma luta. Então, ele poderá ser usado para segurar suas banhas quando um simples javali agressivo tentar rasgá-las.');
INSERT INTO "item_descriptions" VALUES(8242,'pt','Este pequeno cinto vai enfatizar o seu quadril durante uma luta. Logo, ele será usado para segurar as suas tripas quando um agressivo javali das planícies tiver rasgado você ao meio nas profundezas da floresta.');
INSERT INTO "item_descriptions" VALUES(8243,'pt','Com este chapéu, você ficará ridículo, mas também extremamente charmoso. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8244,'pt','Com este chapéu, você ficará ridículo, mas também extremamente charmoso. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8245,'pt','Com este chapéu, você ficará ridículo, mas também extremamente charmoso. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8246,'pt','Com este chapéu, você ficará ridículo, mas também extremamente charmoso. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8247,'pt','Com este chapéu, você parecerá ridículo, mas também vai mostrar todo o seu charme. A vida é cheia de escolhas.');
INSERT INTO "item_descriptions" VALUES(8248,'pt','Com este chapéu, você ficará ridículo, mas ao mesmo tempo extremamente fascinante. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8253,'pt','Este amuleto é normalmente confundido com uma sacola de brinquedos de sorte, quando, na verdade, é algo para você acertar como um alvo para tiro.');
INSERT INTO "item_descriptions" VALUES(8254,'pt','Oferecer uma aliança significa duas coisas: "Eu te amo" e "Vá lavar a louça". Perfeito para quem odeia repetir sempre a mesma coisa.');
INSERT INTO "item_descriptions" VALUES(8255,'pt','Muitos aventureiros iniciantes deverão se lembrar desta terrível e poderosa arma contra os montes de terra. Depois de encharcada, ela se torna leve e pode ser rolada e geralmente exige duas pessoas para isso.');
INSERT INTO "item_descriptions" VALUES(8256,'pt','Com estas botas, um Eniripsa pode caminhar sobre a água, algo bem inútil, já que eles podem voar, e isto sempre atrai a multidão. Outros podem sempre usar estas botas para arranhar os pés, enquanto caminham ou simplesmente os lavam.');
INSERT INTO "item_descriptions" VALUES(8257,'pt','Este cinto possibilitou que Vald tomasse o seu banho sem arriscar a vida. De fato, nenhum Iop aprendeu com sucesso a nadar.');
INSERT INTO "item_descriptions" VALUES(8258,'pt','Esta capa é perfeita para camuflagem em um ambiente natural, porém, só se ninguém o ver.');
INSERT INTO "item_descriptions" VALUES(8259,'pt','Nestas instruções, pode ser lido: “Ofereço este capacete ao seu marido. Junto à cabeça dele e arrastado pelos pés em sua cozinha. Você sabia que tem um chão claro e limpo”. É um resumo da concepção nova e moderna de como um casal deve ser e de como deve compartilhar as tarefas domésticas.');
INSERT INTO "item_descriptions" VALUES(8260,'pt','Esta bandana fará Iops parecerem mais belos do que nunca!');
INSERT INTO "item_descriptions" VALUES(8262,'pt','O Moolet contém uma estranha substância achada nas vísceras de um Moolobo. Alguns dizem que é a essência do monstro, mas outros dizem que é apenas alguns Kirball que ele comeu.');
INSERT INTO "item_descriptions" VALUES(8263,'pt','Tenha cuidado! Este anel fará o seu dedo feder. Um cheiro que pode encobrir outro e isso pode ser uma ótima coisa para você e seu círculo...');
INSERT INTO "item_descriptions" VALUES(8264,'pt','Estas botas ainda são movidas pelo apetite voraz do Moolobo. Se seus pés cheirarem a queijo, elas, provavelmente, os morderão.');
INSERT INTO "item_descriptions" VALUES(8265,'pt','O Moolobo tem um belo rabo longo e fofo, que se arrasta pelo chão. Cheios de inveja, alguns aventureiros o arrancaram e, agora, eles o usam na esperança de ficar mais viris.');
INSERT INTO "item_descriptions" VALUES(8266,'pt','Este cinto colorido tem um maravilhoso tufo de pêlos púrpura na frente e, se usá-lo ao contrário, você poderá passar por um Wabbit.');
INSERT INTO "item_descriptions" VALUES(8267,'pt','Enquanto desmembrava o Moolobo, caçadores descobriram que ele só tem um grande chifre cruzando seu crânio. Mas isto não parece aborrecer os Iops que orgulhosamente o usam.');
INSERT INTO "item_descriptions" VALUES(8268,'pt','Este colar protegeu o Minotoro de pegar pulgas, carrapatos e até mesmo piolhos. Pelo que parece, você realmente precisou disso.');
INSERT INTO "item_descriptions" VALUES(8269,'pt','Ao contrário do que alguns aventureiros possam pensar, este anel nunca foi usado pelo Minotoro, que era incapaz de pôr tal anel em seus cascos.');
INSERT INTO "item_descriptions" VALUES(8270,'pt','Esta pulseira protege completamente o braço de um Eniripsa, mas triplica o seu peso.');
INSERT INTO "item_descriptions" VALUES(8271,'pt','Este anel feito de couro e marfim torna fácil para você estimular seus companheiros.');
INSERT INTO "item_descriptions" VALUES(8272,'pt','Este colar protege as vértebras cervicais do Minotot dos socos letais do Wabbit.');
INSERT INTO "item_descriptions" VALUES(8273,'pt','Este colar tem uma pequena fivela, na qual o dono do Dragão-Porco podia prender uma corrente, a fim de levá-lo para um passeio noturno.');
INSERT INTO "item_descriptions" VALUES(8274,'pt','Este machado realmente decapitou um dos Minotoros mais perigosos da província de Amakna. O mais inacreditável nesta história é que você parece completamente indiferente a ela.');
INSERT INTO "item_descriptions" VALUES(8275,'pt','Este cetro, com uma cabeça de serpente feita de pedras preciosas em sua extremidade, lhe permite amedrontar jovens aventureiros e chutar seus traseiros rosados.');
INSERT INTO "item_descriptions" VALUES(8276,'pt','Estas terríveis botas feitas de couro e pêlo de Minotoro são, obviamente, muito pesadas para fazer você ganhar a lendária corrida da Baía de Amakna. Entretanto, elas permitirão que você esmague os pés dos outros competidores na linha de partida.');
INSERT INTO "item_descriptions" VALUES(8277,'pt','Estas incríveis sandálias lhe permitirão tomar banho nas águas mais perigosas sem o risco de machucar seus pés. Entretanto, tenha cuidado, dizem que elas arranham o fundo de banheiras.');
INSERT INTO "item_descriptions" VALUES(8278,'pt','Um bom par de chinelos e você se sentirá bem mais forte, mais poderoso e até mesmo mais eficiente de alguma maneira. Ainda que eles sejam apenas chinelos!');
INSERT INTO "item_descriptions" VALUES(8279,'pt','Pegue um Minotoro. Amarre-o com firmeza. Pegue um avião gigante e em uma só passagem, descasque sua parte de trás. Pronto! Você conseguiu seu Manto de Minotoro!');
INSERT INTO "item_descriptions" VALUES(8280,'pt','Esta é a capa perfeita para sair ou para praticar seu poder de sedução no baile de máscaras do Capitão Chafer.');
INSERT INTO "item_descriptions" VALUES(8281,'pt','Este manto não o tornará um Leitão, mas lhe permitirá vestir-se bem por uma noite, então, você poderá seduzir uma bela porca.');
INSERT INTO "item_descriptions" VALUES(8282,'pt','Este cinto flexível pode ser usado para chicotear o traseiro de crianças teimosas. Sua fivela poderia até marcar a pele delas, mas isso apenas as ensinaria uma lição de uma vez por todas.');
INSERT INTO "item_descriptions" VALUES(8283,'pt','O Minotot usou este forte cinto para conter a sua enorme pança, prevenindo-o de tombar toda vez que havia uma corrente de ar.');
INSERT INTO "item_descriptions" VALUES(8284,'pt','Este capacete passou de geração em geração na família Minotot. Isto explica parcialmente o motivo de cheirar a caspas em decomposição.');
INSERT INTO "item_descriptions" VALUES(8285,'pt','Com este enorme crânio, você parecerá um Grizbola de pêlo áspero eriçado, mas sem pêlos. Seus admiradores ficarão mudos.');
INSERT INTO "item_descriptions" VALUES(8286,'pt','De acordo com a lenda, esta capa coberta por escamas o protegerá de raios, feijões e, acima de tudo, das mulheres fatais....');
INSERT INTO "item_descriptions" VALUES(8287,'pt','Um anjinho como você poderia facilmente passar por um guerreiro impiedoso com tal capacete horripilante e desproporcional. Uma vez pregado a uma parede, será um cabideiro.');
INSERT INTO "item_descriptions" VALUES(8288,'pt','As mais pervertidas mentes de Amakna dizem que este cinto poderia ser usado como prótese. Ninguém entendeu o porquê e, felizmente, isto foi apenas um rumor falso. É apenas um simples Cinto de Dragonete.');
INSERT INTO "item_descriptions" VALUES(8289,'pt','Este anel, esculpido diretamente em uma escama gigante de Dragonete, protegerá uma pequena parte da sua falange. Provavelmente, o mais importante.');
INSERT INTO "item_descriptions" VALUES(8290,'pt','Feito de escamas de Dragonete, este amuleto protegerá eficazmente o seu pomo-de-adão ou suas amídalas. Ele fará toda a diferença em um campo de batalha.');
INSERT INTO "item_descriptions" VALUES(8291,'pt','Estas botas são perfeitas para matar Gobballs durante uma partida de Gobbol ou fazer seus inimigos sofrerem um pouco mais durante as sessões de espancamento.');
INSERT INTO "item_descriptions" VALUES(8292,'pt','Tão afiada quanto uma navalha, esta lâmina lhe permitirá se barbear de manhã, mas somente as axilas.');
INSERT INTO "item_descriptions" VALUES(8293,'pt','Este machado racha crânios tão facilmente quanto faria com uma manteiga.');
INSERT INTO "item_descriptions" VALUES(8294,'pt','Mais pesado que um crânio vazio de Munchor, porém menos sólido que um fêmur de Kirball das Cavernas, este martelo, ainda assim, é uma arma bastante perigosa.');
INSERT INTO "item_descriptions" VALUES(8295,'pt','Este arco é tão poderoso que pode mandar ovos podres de Dragonete acima da grande muralha de Brakmar. Que desperdício maravilhoso!');
INSERT INTO "item_descriptions" VALUES(8296,'pt','Esta varinha mágica parece ser muito mais eficiente quando usada como um cacetete ou como um Mata-Moskitos!');
INSERT INTO "item_descriptions" VALUES(8297,'pt','Em uma de suas extremidades, este cajado possui uma grande ponta e ninguém sabe de onde ela veio. Entretanto, alguns aventureiros bem informados sabem para onde ela deveria ir...');
INSERT INTO "item_descriptions" VALUES(8298,'pt','Shika costumava ajudar Farle a colher pegando as orelhas mágicas que caiam sob a foice dele. Ela costumava fazer um colar das orelhas. Apesar de estarem desprovidas de suas raízes e do resto de seu caule, estas orelhas mágicas continuavam a florescer a cada ano no mesmo período.');
INSERT INTO "item_descriptions" VALUES(8299,'pt','Este bracelete cobria os braços de Shika. Desta maneira, ele protegia Shika de queimaduras do sol e de bicadas de Corvos, que eram atraídos pela sua beleza estonteante. Os braceletes ainda estão impregnados com o doce suor dela.');
INSERT INTO "item_descriptions" VALUES(8300,'pt','Feito para medir, este cajado permitia que Shika fizesse os mais altos montes de palha de toda Amakna. A lenda diz que eles eram tão grandes que os marinheiros os usavam como marcas para saber se estavam se aproximando ou não da costa de Amaknean.');
INSERT INTO "item_descriptions" VALUES(8301,'pt','Estes tamancos foram criados para Shika para que ela não pisasse no solo arado quando semeava as planícies de Snossios. Ela acrescentou saltos altos nos tamancos para facilitar a corrida no restolho sem machucar seus tornozelos ou que o orvalho molhasse seus tamancos.');
INSERT INTO "item_descriptions" VALUES(8302,'pt','Flores dos tempos de colheita foram costuradas nesta capa feita de cereais mágicos. Guiada por tal mágica poderosa, Shika usou a capa como proteção contra raios durante noites tempestuosas.');
INSERT INTO "item_descriptions" VALUES(8303,'pt','Este cinto feito de couro costumava proteger as coisas de Shika, quando ela passava pelos campos de trigo para trazer de volta ao rebanho Gobballs perdidos. Coberto de pólen de cereais mágicos, a lenda diz que o cinto brilhava nas noites de luar e não deixava que Farle cortasse as pernas de sua esposa enquanto faziam a colheita nos campos de cereais.');
INSERT INTO "item_descriptions" VALUES(8304,'pt','Coberto com uma grande quantidade de flores, este chapéu fez Shika parecer feliz e resplandecente quando ela saáa ao nascer do sol para lavrar as Colinas da Igreja.');
INSERT INTO "item_descriptions" VALUES(8325,'pt','Se você quer proteger seu rostinho lindo do intemperismo, sugerimos este capacete. Ele faz um grande adulto forte também...');
INSERT INTO "item_descriptions" VALUES(8330,'pt','Este pequeno elmo permite ao Dragonete Voador atacar seus inimigos sem arriscar ser machucado ao contundir as cabeças deles. Ele foi usado por muito tempo nas maiores construções de Amakna. Este elmo tornou-se bastante popular depois que os Moolobos vindos da Montanha de Kruup invadiram Astrub. Não existe lógica nesta história... mas o que importa?');
INSERT INTO "item_descriptions" VALUES(8331,'pt','Com este chapéu, você ficará charmoso e atraente. Dizem até que você conseguirá conquistar um Astrubiano!');
INSERT INTO "item_descriptions" VALUES(8333,'pt','Esta misteriosa capa apareceu durante as temporadas frias e permite que impostores finjam ser velhos extremamente generosos.');
INSERT INTO "item_descriptions" VALUES(8334,'pt','Este chapéu permitirá que você esconda as cicatrizes em sua cabeça. Dessa forma, as crianças gostarão mais de você.');
INSERT INTO "item_descriptions" VALUES(8338,'pt','Esta espada estranha não o tornará invencível, mas pode ser usada para fatiar bolas de neve.');
INSERT INTO "item_descriptions" VALUES(8341,'pt','Estas botas tem cheiro de suco de abacaxi misturado com meias molhadas. A grande sacada é que quando você visitar seus amigos, eles nunca vão lhe pedir para tirar os sapatos.');
INSERT INTO "item_descriptions" VALUES(8366,'pt','Esta capa costumava pertencer a um famoso Capão, um pássaro de penas longas que adorava regozijar em frente ao Zaap de Bonta onde todas as galinhas ingênuas e imatura moravam.');
INSERT INTO "item_descriptions" VALUES(8411,'pt','Este amuleto amaldiçoado e coberto com bandagem pode ajudá-lo a superar a maldição do Labirinto do Minotoro, mas não há garantia... Pode ser apenas lixo de algum turista. Quem sabe.');
INSERT INTO "item_descriptions" VALUES(8412,'pt','Este anel feio e fedido é feito de bandagens de Mumminotor. Ele faz um ótimo Band Aind quando você corta seus dedos nas portas do Labirinto do Minotoro - possivelmente o pior de todos os seus problemas, mas um conforto.');
INSERT INTO "item_descriptions" VALUES(8413,'pt','A pedra no final deste martelo está enrolada em bandagens absorvente de Mumminotor para estes assassinatos caseiros.');
INSERT INTO "item_descriptions" VALUES(8414,'pt','Adagas muito bem forjadas que farão de você um valente lutador.');
INSERT INTO "item_descriptions" VALUES(8415,'pt','Acolchoadas e decoradas com bandagens de Mumminotor, estas botas são confortáveis e quentes. Podem até mesmo lembrá-lo das carícias de sua mãe.');
INSERT INTO "item_descriptions" VALUES(8416,'pt','Feita de bandagens dobradas de Mumminotor, esta capa dará a você um aspecto morto-vivo, triste e vagaroso. Você será a inveja da cidade.');
INSERT INTO "item_descriptions" VALUES(8417,'pt','Esta pequena pá pequena foi dada a um jovem Enutrof. Ele gostou tanto dela que a usou até sua morte.');
INSERT INTO "item_descriptions" VALUES(8418,'pt','A origem desta grande bandagem Mumminotor é desconhecida. Seu uso é muitas vezes misterioso, já que na verdade está com decomposição acelerada. Ótimo para as mentiras de primeiro de abril. Certifique-se de manter uma lista de todos os bons amigos que você tem e diga a eles para arrancar a bandagem.');
INSERT INTO "item_descriptions" VALUES(8419,'pt','O capitão Machab destripou o grande Kralove Branco, conhecido como Grobill Dick, com esta pá.');
INSERT INTO "item_descriptions" VALUES(8420,'pt','Os Dragonetes gostam de cavar túneis mas eles não usam pás. A comunidade Enutrof estudou e tentou responder este enigma, mas concluiu que era menos importante saber de onde isto veio do que usá-lo para bater em outra pessoa.');
INSERT INTO "item_descriptions" VALUES(8441,'pt','Bill queria uma auréola. Ele berrou tão alto, ficou com raiva e finalmente conseguiu. Um verdadeiro diabinho.');
INSERT INTO "item_descriptions" VALUES(8442,'pt','Brouce Boulgoure usou esta máscara para se infiltrar em uma guarida de ratos de Esgoto para cortar um olmo pelas raízes. Ele acabou matando todos os ratos da guarida já que ele não era tão discreto com seus tamancos de madeira.');
INSERT INTO "item_descriptions" VALUES(8443,'pt','Esta capa pode ser feita com qualquer tipo de pêlo, contanto que eles sejam os mais sujos possíveis. Eles são trançados juntos e, então, fixados graças a várias secreções. O cheiro não é uma opção.');
INSERT INTO "item_descriptions" VALUES(8444,'pt','Tão afiadas quanto danificadas, as lâminas destas adagas permitirão fatiar os membros dos seus inimigos com uma facilidade desconcertante. E tenha certeza que você levará uma quantidade impressionante de tiras de carne. Pena que elas não são enferrujadas, envenenadas nem incandescentes quando você precisar usá-las.');
INSERT INTO "item_descriptions" VALUES(8445,'pt','O rato que possuiu este colar pensou que se tornaria o chefe do seu clã. Ele foi devorado por um furioso Lenald.');
INSERT INTO "item_descriptions" VALUES(8446,'pt','Tenha cuidado ao colocar estas botas!! Ainda pode haver um pé ou dois do dono anterior dentro delas...');
INSERT INTO "item_descriptions" VALUES(8447,'pt','Diferentemente de seu primo branco Bontariano, o Rato Preto é discreto e usa um cinto de tecido simples. Mas ele também gosta de carregar muitas armas e isso faz um barulho terrível a cada passo que dá.');
INSERT INTO "item_descriptions" VALUES(8448,'pt','Gire este anel para a direita, se você for dar um aperto de mão em um inimigo, e para a esquerda, se for apertar as mãos de um amigo. Em todos os casos, não é aconselhado bater palmas se estiver usando este anel.');
INSERT INTO "item_descriptions" VALUES(8450,'pt','Esta arma é o símbolo do Rato Branco. Sabe-se que sua capacidade de cortar em fatias tanto inimigos como aliados com facilidade é a mesma.');
INSERT INTO "item_descriptions" VALUES(8451,'pt','Com este chapéu, o Rato Branco parece um Rato Branco Real de Bonta. Sem ele, se parece com um Rato Branco Real de Bonta sem chapéu.');
INSERT INTO "item_descriptions" VALUES(8452,'pt','Esta capa é o símbolo que identifica o rato branco da rede de esgotos de Bonta. É a recompensa que o rato recebe depois de um longo e difícil exame que, orgulhosamente, o utilizará até que a morte o faça... que normalmente não demora muito tempo.');
INSERT INTO "item_descriptions" VALUES(8453,'pt','Se você usar como colar, ele o protegerá das emissões tóxicas dos esgotos. Mas, usando como um cinto, ele protegerá seus aliados das emissões tóxicas.');
INSERT INTO "item_descriptions" VALUES(8454,'pt','Esta Luva pertencia a Julia Dilch, cozinheira do palácio de Bonta. Usou para enfrentar os Gobballs que resistiam antes de cortar suas gargantas, ou plantas selvagens que não entravam na tigela de salada, e os clientes que não comiam também.');
INSERT INTO "item_descriptions" VALUES(8455,'pt','Não é como Black Brakmariana pensa, que o Rato Branco é o mais discreto possível. Essa é a razão pela qual ele acolchoou os elos metálicos deste cinto com piche. Dessa maneira não faz qualquer barulho, a menos que a pessoa que o usar cair no chão, e isto acontece freqüentemente, já que este cinto é extremamente pesado.');
INSERT INTO "item_descriptions" VALUES(8456,'pt','Com estas botas, o seu equilíbrio será perfeito... até mesmo durante uma tempestade de vento.');
INSERT INTO "item_descriptions" VALUES(8457,'pt','Este chapéu não tem nada a ver com um Dora... Absolutamente nada! É inútil espalhar falsos rumores sobre o seu criador ser frouxo ou sem inspiração!!! Este chapéu tem uma bela aparência.');
INSERT INTO "item_descriptions" VALUES(8458,'pt','Esta capa colorida o transforma em um alvo ideal. Só aventureiros rápidos e espertos podem usá-la por muito tempo.');
INSERT INTO "item_descriptions" VALUES(8459,'pt','Este colar é posto em torno do pescoço do Senhor dos Ratos assim que ele nasce, para prevenir o roubo. Assim, quando ele se torna adulto, a única maneira de tirar o colar é decapitando-o. Bem, de alguma maneira, o colar ainda é roubado!');
INSERT INTO "item_descriptions" VALUES(8460,'pt','Este anel foi projetado no período em que o Senhor dos Ratos só possuía um dedo, depois de mutilar todos os outros. Os desafortunados senhores seguintes possuíam todos os dedos.');
INSERT INTO "item_descriptions" VALUES(8461,'pt','Os desenhos neste cinto realmente lhe dão a impressão de que você está queimando! O engana-olho é tão bom que a maior parte das pessoas que o usam realmente acredita que está queimando e corre por toda a parte gritando! Por incrível que pareça, isto corresponde exatamente ao ritual de cerimônia.');
INSERT INTO "item_descriptions" VALUES(8462,'pt','O primeiro Lorde Rato a morrer por se intrometer em uma piscina de lava derretida. Para prestar tributo a ele, seus lordes usavam estas botas. Tenha cuidado, elas não são à prova de fogo.');
INSERT INTO "item_descriptions" VALUES(8463,'pt','Os cogumelos incrementados neste capacete espalham um bom odor estimulante que faz você querer pegar raízes. Eles também são bastante gostosos, mas podem mandá-lo para um caixão.');
INSERT INTO "item_descriptions" VALUES(8464,'pt','No verão, o Treechnid Ancestral gosta de pegar sol, mas como sua madeira é acostumada a florestas escuras, ele não fica muito tempo. Esta capa é feita de sua casca descascada.');
INSERT INTO "item_descriptions" VALUES(8465,'pt','Ao redor de seu pescoço, este torque destacará sua barba. Se você não tiver barba, bem, a culpa é sua.');
INSERT INTO "item_descriptions" VALUES(8466,'pt','Nas noites em que você bebe demais, pode ser que veja o Moskito embutido neste anel piscar para você. Mas não conte aos seus amigos, ele só estará fingindo.');
INSERT INTO "item_descriptions" VALUES(8467,'pt','Com estes protetores de canela de madeira, suas pernas estarão altamente protegidas. Entretanto, você não pode usar botas com eles. Você pode usá-los quando estiver participando das competições de Gobbowl, eles o protegerão. Mas será difícil para você chutar a bola sem suas botas.');
INSERT INTO "item_descriptions" VALUES(8468,'pt','Este cinto deveria lhe dar a virilidade ancestral. Se isso era verdade ou não, o efeito expirou.');
INSERT INTO "item_descriptions" VALUES(8469,'pt','Este pedaço de madeira extraído bem do interior do Carvalho Mole é extremamente poderoso. De fato, ele pode até mesmo enfurecer o Carvalho Mole.');
INSERT INTO "item_descriptions" VALUES(8470,'pt','Este anel é de fezes de Carvalho Mole, em madeira, mas o cheiro permanece o mesmo.');
INSERT INTO "item_descriptions" VALUES(8471,'pt','Aos domingos, o Carvalho Mole tira um cochilo e, quando acorda, gosta que algum Trunknid obediente traga seus calçados de couro sem perguntas. Infelizmente, ele não tem nenhum pé, então eles ainda estão novinhos em folha.');
INSERT INTO "item_descriptions" VALUES(8472,'pt','Há 200 anos, alguns tecidos ficaram enfiados nos galhos de Carvalho Mole. Conforme as árvores cresciam, ficaram impregnando o tecido com a sua mágica. Este tecido agora é uma parte integrante deste grande pedaço de madeira e o torna difícil de manusear e inflamável; seu poder não pode ser negado.');
INSERT INTO "item_descriptions" VALUES(8473,'pt','No outono, o Carvalho Mole veste seu fio-dental para proteger suas preciosas bolotas. No verão, ele gosta de ficar nu.');
INSERT INTO "item_descriptions" VALUES(8474,'pt','Você pode usar este chapéu de todas as formas possíveis, ele ainda vai parecer estar de lado.');
INSERT INTO "item_descriptions" VALUES(8513,'pt','Coletar ‘pedaços'' de criaturas com o bisturi de Bworknroll lhe assegurará um bom trabalho, já que ele preserva a vitalidade dos membros arrancados. Use-o em uma luta para coletar as partes que você deseja.');
INSERT INTO "item_descriptions" VALUES(8521,'pt','A capa vermelha é o artefato favorito dos megalomaníacos. Uma vez em seus delicados ombros, eles acreditam que são o Super-Homem ou um mágico ultrapoderoso, até que encontram um Minotoror.');
INSERT INTO "item_descriptions" VALUES(8527,'pt','Estas botas feitas de pele de Duende foram criadas por Planbworksek para carregar o inimigo (se possível pelas costas) extremamente depressa. Com estas botas, ele salvou muitos companheiros Bwork em dificuldade.');
INSERT INTO "item_descriptions" VALUES(8530,'pt','Este chapéu mantém suas orelhas quentes e absorve o energético de seu bafo. O que mais você pode pedir?');
INSERT INTO "item_descriptions" VALUES(8531,'pt','Ninguém ousaria usar um chapéu desses! Ou ousaria...?');
INSERT INTO "item_descriptions" VALUES(8532,'pt','Ao usar esta capa, você demonstrará sua total indiferença por aqueles que estiverem por perto. Perfeita para pessoas malvadas.');
INSERT INTO "item_descriptions" VALUES(8533,'pt','O Flud não é realmente um chapéu. É mais um parasita que tende a se desenvolver nas cabeças de pessoas volúveis, barulhentas ou agressivas. Seu aspecto asqueroso faz as pessoas fugirem, forçando seu portador a gritar cada vez mais alto, o que é inútil, já que, de qualquer maneira, ele não tem nada a dizer.');
INSERT INTO "item_descriptions" VALUES(8534,'pt','Esta capa acolchoada absorve todos os barulhos ao redor e obriga seu portador a gritar o tempo todo.');
INSERT INTO "item_descriptions" VALUES(8535,'pt','Estas getas são tão leves que fazem seu proprietário correr e saltar por todos os lados quando uma luta começa. Aventureiros experientes simplesmente odeiam estas getas, que permitem a qualquer um entrar em uma luta sem ser convidado.');
INSERT INTO "item_descriptions" VALUES(8536,'pt','Este cinto deve ser usado extremamente apertado. Tão apertado, que ele força seu usuário a gaguejar, tremer e fazer nada enquanto for repetitivo.');
INSERT INTO "item_descriptions" VALUES(8537,'pt','Este pequeno anel não tem utilidade a não ser deixá-lo extremamente ofuscante. Agora as pessoas sentirão vontade de estar perto de você.');
INSERT INTO "item_descriptions" VALUES(8538,'pt','Após várias noites de trabalho duro, o mais famoso joalheiro de Astrub, também conhecido por crescer com Bworks, uma vez disse para uma multidão impressionada: ‘Vjo v6 dp com meu amu''. Mesmo o conhecido historiador Champo Lhyon não conseguiu decifrar a mensagem do joalheiro.');
INSERT INTO "item_descriptions" VALUES(8539,'pt','Até mesmo se você não souber manejar machados muito bem, você não se machucará com este já que sua lâmina está muito cega. Mas se você bater forte o bastante, pode até ser que você consiga cortar algumas árvores.');
INSERT INTO "item_descriptions" VALUES(8540,'pt','Esta é uma foice de média qualidade, mas você não deveria reclamar já que lhe foi dada como presente. Além disso, colhe trigo corretamente e isto é tudo o que se espera que ela faça.');
INSERT INTO "item_descriptions" VALUES(8558,'pt','Se você está planejando comunicar com Wabbits, isto pode ser o que você precisa. Se quer parecer bem, coloque em alguém próximo de você.');
INSERT INTO "item_descriptions" VALUES(8559,'pt','Hummmm mm mmmmmm mmmmm, mmm mmm mm mmmmmm mmmmm mmmmmmm mmmmmm mmm mmmm‘m mmmmm mmmm mmmmmmm.');
INSERT INTO "item_descriptions" VALUES(8561,'pt','Esse fofo Bebê Pandawa vai adorar viajar pelo mundo com você e ver com seus grandes olhos redondos. Este manso animal de estimação come arroz, mas também pode ser alimentado com avelãs.');
INSERT INTO "item_descriptions" VALUES(8569,'pt','Este gorro costumava pertencer a uma pequena Xelorett que tirava proveito da passagem do tempo. A lenda diz que ela roubava vários dias dos habitantes de Amakna. E tinha de distribuir alguns doces para compensar esta pequena trapaça.');
INSERT INTO "item_descriptions" VALUES(8574,'pt','Com ou sem bacon, este Dofus é delicioso.');
INSERT INTO "item_descriptions" VALUES(8575,'pt','Um famoso guerreiro Feca que viveu na selva de Pandala costumava dizer: ‘Para ganhar a guerra, você tem que ser a guerra''.');
INSERT INTO "item_descriptions" VALUES(8596,'pt','Esta espada afiada ficou com uma cor carmesim elegante após estripar milhares de Bworks. Antes, era apenas purpurina.');
INSERT INTO "item_descriptions" VALUES(8598,'pt','Estas lâminas têm buracos por toda a parte fazendo um belo barulho de assovio quando manuseada rapidamente. Os buracos também são úteis para tirar as entranhas de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(8599,'pt','Estas adagas foram forjadas por uma Ecaflipette manicure. Ele não gostava de espadas pesadas que não se adaptavam perfeitamente às unhas envernizadas.');
INSERT INTO "item_descriptions" VALUES(8604,'pt','Esta espada brilhante é perfeita para aparar flores, mesmo se elas se defenderem. Pode até mesmo cortar árvores.');
INSERT INTO "item_descriptions" VALUES(8605,'pt','Esta lâmina foi lubrificada para entrar no estojo mais facilmente. Entretanto, não pode ser limpada após uso e deve ser jogada fora, especialmente se coberta de sangue. Leve em consideração que o uso principal é protegê-lo.');
INSERT INTO "item_descriptions" VALUES(8607,'pt','É um grande cajado com pregos. Não espere por nada além de um simples cajado, ele arranca os dentes de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(8608,'pt','Rumores dizem que um Sadida chamado Fraye costumava usar este cajado para proteger sua esposa e filho de um punhado de Gobballs irados. Que pena que ele também confundiu sua família com os monstros durante a luta.');
INSERT INTO "item_descriptions" VALUES(8609,'pt','Este arco é leve, delicado, elegante e tem cheiro de flores de cerejeira. Mas se você abusar, pode também ser letal.');
INSERT INTO "item_descriptions" VALUES(8610,'pt','Se você mantiver este arco para cima e dizer alegremente "Pampulilu!", parecerá absolutamente ridículo.');
INSERT INTO "item_descriptions" VALUES(8611,'pt','Esta varinha mágica pertence a um famoso Grinegay que faz um excelente café, mas não consegue umas garotas');
INSERT INTO "item_descriptions" VALUES(8612,'pt','Com o Bidjiz, você permanecerá vivo provavelmente devido aos seus oponentes começarem a dançar quando eles verem a bola de disco no final desta varinha.');
INSERT INTO "item_descriptions" VALUES(8613,'pt','Criado como uma obra-prima de um ferreiro mágico, estas pás são muito ruins para escavar, exceto quando é a cabeça de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(8614,'pt','Esta pá é uma ótima invenção. Pode escavar um túmulo e ser deixado no topo como uma cruz, desde que só um aventureiro morre por vez.. Ou se você cavar para outros túmulos com suas mãos.');
INSERT INTO "item_descriptions" VALUES(8615,'pt','Este martelo esmaga facilmente crânios para alcançar o cérebro e agora está manchando com uma cor tomate vermelho.');
INSERT INTO "item_descriptions" VALUES(8616,'pt','Este martelo foi criado quando o Rei Stefan costumava reinar e aterrorizar milhões de pessoas.');
INSERT INTO "item_descriptions" VALUES(8617,'pt','Seu animal de estimação, nossa paixão.');
INSERT INTO "item_descriptions" VALUES(8618,'pt','Este estranha machado é criado para decapitar facilmente Bworks. A tranqüilidade com que também pode decapitar habitantes de Astrub indica que há uma ligação entre estes dois povos. Mas ninguém descobriu o que é ainda.');
INSERT INTO "item_descriptions" VALUES(8619,'pt','Graças a este chapéu de guerreiro, os Iops realmente são figuras simpáticas. O único problema é que ele esconde o campo de visão de evita de ouvir as palavras de seus inimigos. Este chapéu é desenvolvido para quem gosta de bater antes de pensar.');
INSERT INTO "item_descriptions" VALUES(8627,'pt','Colega e amigo do famoso Guy-Guy (parente próximo do Carvalho Mole), Sarr Ys é um menestrel cujas melodias encantadoras estão gravadas na memória de Amakna. Infelizmente, este brilhante artista teve um trágico acidente com Quaquak após uma farra numa noite de verão.');
INSERT INTO "item_descriptions" VALUES(8628,'pt','Este capacete dá auto-confiança e temeridade a quem usa. Graças a isso, você sempre manterá pensando que foi na verdade uma proeza. Lembre-se de tirá-lo de vez em quando para não entrar em situações inextricáveis!');
INSERT INTO "item_descriptions" VALUES(8629,'pt','Sempre que um oponente vem para encarar este capacete, ele vira quieto como um túmulo. Ninguém ousa perguntar o que acontece. Mas tudo bem, Srams não são tão sensíveis.');
INSERT INTO "item_descriptions" VALUES(8630,'pt','Este chapéu parece com o chapéu de Paperb e Sulik. Mas já que é muito confortável e os Xelors nunca tiram-no - mesmo para dormir, ele é comodamente chamado Chapeleiro de Lírio. Solta uma agradável água de lírio cujo cheiro ajuda a dormir. Entretanto, também provoca ronco e insuportáveis canções de sapinho durante a época do cio.');
INSERT INTO "item_descriptions" VALUES(8631,'pt','Graças a este chapéu, Eniripsas sempre sabem como lidar com emergências. Assim, todas as dicas de primeiros socorros são discretamente escritas no forro. Ninguém normalmente usa um chapéu ridículo assim mesmo em uma cerimônia escolar!');
INSERT INTO "item_descriptions" VALUES(8632,'pt','Dado o nome deste chapéu, nós poderíamos pensar que ele tem uma bela cor alaranjada. Bem, de modo algum! Além disso, este acessório da moda é mais uma máscara do que um chapéu. Então qual o motivo de os criadores chamarem desta forma? Para deixar o povo comentar!');
INSERT INTO "item_descriptions" VALUES(8633,'pt','As pontas afiadas saem deste gorro não só permitem machucar seu inimigo, mas também aumenta suas chances de ser golpeado na cabeça por um raio durante uma tempestade, Sacriers é a raça que adora machucar os outros tanto quanto eles mesmos. Um belho cheiro de carne grelhada: nada melhor para começar seu dia!');
INSERT INTO "item_descriptions" VALUES(8634,'pt','Graças a este chapéu, você se parecerá com uma besta excitada. Pessoas se aproximarão para admira o grande par em sua cabeça. Este amplo item também pode manter a comida fresca como feno para Gobballs ou pão para Tofus.');
INSERT INTO "item_descriptions" VALUES(8635,'pt','Este capacete pode fazer o usuário fazer promessas que instantaneamente esquece. É devido à pressão que ele exerce em parte de seu cérebro como a memória ou fala? Ninguém sabe de verdade. O que importa é levar em conta as palavras menos extravagantes.');
INSERT INTO "item_descriptions" VALUES(8636,'pt','Robbie Hood era um famoso Craque viveu nas florestas. Isto explica a cor verde de seu gorro para se camuflar no cenário. Ele queria levar a lei por toda a parte roubando dinheiro dos ricos por uma boa causa: ele mesmo!');
INSERT INTO "item_descriptions" VALUES(8637,'pt','Com este capuz, o Feca aumenta suas chances assim como a de seus aliados. Se seu grupo é guiado por um Feca usando um Capuz da Sorte, você estará realmente seguro para chegar a um lugar quase sem nenhum arranhão. E cheira tão ruim é perfeita para se proteger também.');
INSERT INTO "item_descriptions" VALUES(8638,'pt','Este capuz pode ser usado para se proteger do mau tempo assim como cozinhar bons pratos. O meio que este chapéu se move o bastante para trazer ar e manter o fogo cozinhando a altas temperaturas. E todos sabem, uma sopa é um prato que precisa ser cozinhado por um longo tempo ... agora sabemos o motivo dos Enutrofs terem pulso forte.');
INSERT INTO "item_descriptions" VALUES(8639,'pt','A capa flutuante é essencial para dar uma aura de guerreiro, especialmente se virar as costas para um inimigo. Alguns pensam que é reforçada por uma lâmina de metal capaz de afastar ataques astutos.');
INSERT INTO "item_descriptions" VALUES(8640,'pt','Cortada de um tecido liso e forte, esta capa dá aos Ecaflips a impressão de que são sempre os melhores, não importa o que acontece. Quando eles vencem, adoram usar esta peça de roupa e reivindicar a recompensa: "E agora, dê-me o dinheiro!"');
INSERT INTO "item_descriptions" VALUES(8641,'pt','Esta capa é tão leve e fina que um pequeno vento (de todos os tipos de vendo) pode levá-la... Não é nada, porém tenha cuidado após uma refeição de vegetais e bebidas fermentadas.');
INSERT INTO "item_descriptions" VALUES(8642,'pt','A cor escura desta capa torna fácil separar de outras roupas, ou qualquer outra cor. Já que é uma capa muito ampla, também pode proteger sua cabeça e seu nariz.');
INSERT INTO "item_descriptions" VALUES(8643,'pt','A Capa Sulitis deve ser delicadamente colocada nos ombros do usuário para evitar ter tendinites e endurecimento das juntas. As propriedades curativas desta peça de roupa são invejadas pelos Pandawas quem passam muito tempo carregando inimigos e aliados. Eles adorariam uma peça de roupa também!');
INSERT INTO "item_descriptions" VALUES(8644,'pt','Este item é usado para esconder o problema de peso dos Sadidas. Devido a eles passagem muito do tempo dormindo ao invés de praticar esportes, os personagens desta raça tendem a se tornar gordos. Se as Sadidettes tivessem um suprimento anti-fome perante os olhos dos homens, os Sadidas usariam esta capa para esconder.');
INSERT INTO "item_descriptions" VALUES(8645,'pt','Esta peça de roupa é parte essencial do estilo Sacrier. Eles usam como bandagem para as feridas, para limpar o sangue, para aquecer os pés durante as épocas frias. Não podemos dizer o suficiente - esta raça tem medo de terras geladas!');
INSERT INTO "item_descriptions" VALUES(8646,'pt','Esta capa suave é algumas vezes usada por Osamodettes como um chapéu de abas largas. Osamodas masculinos usam-na como uma capa. Graças ao desenho que decora esta peça de roupa, nesta raça de personagem foi herdada a reputação de franqueza. Assim, eles não podem rir de suas mangas, já que a graça é costurar esta capa!');
INSERT INTO "item_descriptions" VALUES(8647,'pt','Pandawas usam esta capa como proteção ao mau tempo e acessório de dança. Eles colocam no chão, no meio do círculo das dançarinas. Então, começam uma coreografia improvisada enquanto seus pés não tocam o chão já que a área é limitada por uma peça de roupa.');
INSERT INTO "item_descriptions" VALUES(8648,'pt','Esta capa leva o nome do Cra original que tinha um senso particular de direção. Ele podia se perder dentro de sua própria casa, mesmo que não fosse grande! Seu maior problema foi que ele tinha uma deformação nas funções cerebrais. Assim, para todos os lugares que ele olhava pareciam iguais: uma praia vasta, ao redor de palmeiras, banhado pela luz do sol.');
INSERT INTO "item_descriptions" VALUES(8649,'pt','As cores quentes e confortáveis desta capa levam o usuário a uma viagem imaginária, em países brilhantes, cheio de canyons criados pela erosão e áreas rochosas. É extremamente útil para esquecer dos dias frios, cinzentos e chuvosos.');
INSERT INTO "item_descriptions" VALUES(8650,'pt','Enutrofs têm o hábito de desenhar um mapa em sua capa. Eles vivem em uma bagunça que dificilmente podem encontrar banheiros e isto é um problema, especialmente quando deve responder a um chamado urgente da natureza.');
INSERT INTO "item_descriptions" VALUES(8651,'pt','Este belo cinto adiciona o prestígio da aparência dos Iops. Alguns dizem que a cruz no centro pode se tornar uma arma separável quando suas espadas não estão dentro de alcance. Obviamente é uma lenda. Só Srams são enganadores o bastante para estas práticas.');
INSERT INTO "item_descriptions" VALUES(8652,'pt','Quando um Ecaflip está entediado, ele normalmente leva suas cartas no cinto e começa a jogar solitária. Na luta, ele também pode usar as cartas como projéteis. Ele tira uma carta tão rápido quanto uma sombra, e sempre tem tempo para um joguinho!');
INSERT INTO "item_descriptions" VALUES(8653,'pt','O nome deste cinto vem do barulho que ele faz. Os ossos decorativos deste cinto, evitam os Srams, mesmo que invisíveis, de serem notados. Então, você pode facilmente ouvir um diálogo: "Surpreendente alguém usar o Cinto Clinkin? Você tem esperança!"');
INSERT INTO "item_descriptions" VALUES(8654,'pt','O som incessante deste tique-taque do sistema de relógio deste cinto evita que os Xelors duram quando as lutas são eternas. É altamente recomendável que você tire este cinto antes de ir dormir.');
INSERT INTO "item_descriptions" VALUES(8655,'pt','Embora acostumado a choradeira, este cinto permite a você carregar materiais médicos. As várias poções úteis para curar dor de garganta e infecções gerais são cuidadosamente dispostas. Assim, quando Eniripsas têm dor de garganta, eles não podem conjurar devidamente seus feitiços. E quando estão sem voz ... bem, são tão úteis quanto uma jaqueta de lã durante o calor.');
INSERT INTO "item_descriptions" VALUES(8656,'pt','As razões que levaram os designers deste acessório fashion a colocar uma cabeça de boneca perto da virilha são desconhecidas.
Muitas teorias ''tem sido propostas, mas todos sabem que é uma história já de conhecimento geral!');
INSERT INTO "item_descriptions" VALUES(8657,'pt','Guerreiros de uma tribo antiga famosa pela paixão pelo sangue, os Pados não poderiam ser os primeiros fiéis da deusa Sacrier. Embaixo desta aparência inofensiva, este cinto é um instrumento sofisticado real de tortura.');
INSERT INTO "item_descriptions" VALUES(8658,'pt','Osamodas são conhecidos por serem impulsivos. Eles tendem a serem mais sensíveis. As numerosas fivelas deste cinto são o significado de ajudar, então diminua sua espontaneidade. "Antes de liberar sua fúria e seus olhos expelirem sangue, toque todos os espinhos deste fantástico Cinto Diezzle!"');
INSERT INTO "item_descriptions" VALUES(8659,'pt','Este cinto ajuda Pandawas a ficar de pé (ou quase) quando estão eufóricos, na maior parte do tempo. Nestes momentos, eles tendem a se sentir como presos ao chão embora a gravidade não tenha qualquer ligação com isso. A gravidade é uma forma de manter ocupados os cientistas fazendo experiências com maçãs.');
INSERT INTO "item_descriptions" VALUES(8660,'pt','Este cinto permite a você segurar roupas largas (não se assuste com a sensibilidade das almas) e também oferece um alvo para aprendizes de Cras. Assim, eles aprenderáo a atirar direto no centro, mas nunca abaixo do cinto.');
INSERT INTO "item_descriptions" VALUES(8661,'pt','Cuidadosos, Fecas mantêm seus suprimentos de sobrevivência em uma pequena sacola, que principalmente inclui pão de Crackrock. É por isso que esta comida pode durar muito tempo. O Cinto Sekuritee garante uma sacola em volta da cintura, devido a isto há muitos acidentes com a queda da sacola, por negligência ou apenas estupidez.');
INSERT INTO "item_descriptions" VALUES(8662,'pt','Este cinto é um acessório da moda muito útil usado por Enutrofs. Graças ao mapa costurado nele, eles podem esconder seus soluços quando estão perdidos e procurando um banheiro.');
INSERT INTO "item_descriptions" VALUES(8663,'pt','Com essas botas, Iops são sempre os primeiros a chegar ao campo de batalha e a começar a vida em um lugar. É de um conhecimento comum que esses personagens dessa raça adoram divertir a multidão com as façanhas de guerreiros. Mas eles nunca levam a sério, pois sua negligência é inversamente proporcional à sua força.');
INSERT INTO "item_descriptions" VALUES(8664,'pt','Dizem que os Sadidas nunca se sentem solitários, já que eles invocam muitas bonecas como companhia. Graças a estes sapatos, você também pode dizer adeus a este sentimento de solidão! Você será capaz de falar com elas, exceto se relatarem seu jogo. Após colocá-los, você se sentirá muito bem, mesmo se estiver envergonhado.');
INSERT INTO "item_descriptions" VALUES(8665,'pt','Impregnada com um produto firmador, estas botas serão perfeitas para suas pernas tortas e lutas contra a natureza morta da complexão Sram. Este creme tem efeitos especiais nas Sramettes, mas parece ser absolutamente inútil em Srams. Poderia ser um problema hormonal?');
INSERT INTO "item_descriptions" VALUES(8666,'pt','Criada por um artista Xelor, estas botas devem permitir pintar mais depressa. E bem, elas conseguem! Entretanto, tendem a distorcer a visão e especialmente o senso de distância. Com estas botas, tudo parece estar mais perto. Aprecidaas pelos Sadidas, as pinturas deste Xelor são feitas de curvas generosas da mulher popular mais gorda.');
INSERT INTO "item_descriptions" VALUES(8667,'pt','Graças a estas botas, você sempre estará protegido de toxinas vindas do chão. Nós nunca suspeitamos de micróbios e outros germes. Alguns bons observadores dizem que estas botas parecem mais um dorminhoco do que botas. Mas bem, é o que os Eniripsas dizem. É devido ao seu pequeno tamanho que elas vêem tudo de um diferente ponto de vista?');
INSERT INTO "item_descriptions" VALUES(8668,'pt','O amor pelas plantas faz os Sadidas usar os únicos sapatos equipados com reconhecimento floral. Graças a este sistema, os usuários evitam esmagar plantas raras. Entretanto, não evita de pisas em vários tipos de excrementos se não olhar por onde anda.');
INSERT INTO "item_descriptions" VALUES(8669,'pt','Diferente das outras raças, Sacries adoram viver com um espinho no pé e não gostam de retirar. A dor que sentem lembra que estão vivos e dá energia para caçar os inimigos. Além disso, o sangue deixado para trás permite que eles sempre encontrem o caminho de casa.');
INSERT INTO "item_descriptions" VALUES(8670,'pt','Com estes sapatos, Osamodas podem marchar por amplos continentes, incluindo os mais remotos. Além disso, nós não sabemos qual o uso principal. Alguns dizem que pode ser usada para fazer ninhos de Tofu ou belos vasos para tirar vantagem das flores selvagens. Mas não é bem convincente. De qualquer forma, Botas Wana são os sapatos principais.');
INSERT INTO "item_descriptions" VALUES(8676,'pt','Vlad se apaixonou por esta maravilhosa espada. Ele participou da mais aterrorizante corrida Dragokart para conseguir dinheiro suficiente para comprá-la. Infelizmente, ele não sabia que esta espada era amaldiçoada...');
INSERT INTO "item_descriptions" VALUES(8677,'pt','Este coelhinho é o bicho de estimação favorito do famoso Mestre Nero Jack. Não se deixe levar pelas aparências, ele pode ser terrível em luta. Ele só come Cenouwawa e plantas.');
INSERT INTO "item_descriptions" VALUES(8678,'pt','Há muito tempo, Satanass era um patinador artístico deslizando em Holyball on Ice nos rinques da segunda divisão. Enquanto se recuperava de um ferimento no coccyx, teve uma revelação que mudou a sua vida: estava predestinado a ser o mais talentoso piloto de Dragokart desta geração! Eventualmente uma pequena batida pode causar sérios estragos.');
INSERT INTO "item_descriptions" VALUES(8693,'pt','Graças a este animal de estimação, todos do sexo oposto farão olhos de cachorrinho para você. Um conselho: não conte com os ovos antes da galinha! Você logo perceberá que sua amada está apenas hipnotizada pelo Fëanor. Nem pense que isto será uma vantagem: de agora em diante, sua pretendente comerá Dink cru e se esfregará em suas pernas... Você provavelmente viveu situações mais fascinantes, não é? Este animal de estimação só come peixe.');
INSERT INTO "item_descriptions" VALUES(8695,'pt','Como Brice disse: "Tamanho não importa, só a forma que você lida com ele".');
INSERT INTO "item_descriptions" VALUES(8697,'pt','description');
INSERT INTO "item_descriptions" VALUES(8698,'pt','description');
INSERT INTO "item_descriptions" VALUES(8699,'pt','Com esse chapéu, você sempre terá uma aparência como se tivesse levantado da cama naquele instante, mesmo se passar horas penteado seu cabelo. Alguém notou que o cabelo tipo casca do Tynril enrola quando o tempo está úmido, isso demonstra como está a previsão do tempo no mundo. Entretanto, ele teme o fogo. Então, tenha muito cuidado e mantenha-o longe das chamas se não quiser se tornar uma verdadeira tocha humana.');
INSERT INTO "item_descriptions" VALUES(8700,'pt','Este elmo parece ter sido feito de um Dofus Esmeralda quebrado. O Dofus ainda não está muito vazio e lhe dá a oportunidade de dar ao seu cabelo um ótimo xampu de ovo.');
INSERT INTO "item_descriptions" VALUES(8701,'pt','Esta suntuosa espada costumava pertencer a um famoso ladrão, conhecido por realizar crimes a todo o momento.');
INSERT INTO "item_descriptions" VALUES(8704,'pt','Se você chacoalhar estes dois pequenos sinos, pdoerá ser capaz de jogar uma música.');
INSERT INTO "item_descriptions" VALUES(8713,'pt','Em alguns países, parece que as Getas Bernacle são jogadas nos inimigos para insultar e provocar duelos. Mesmo que isto possa parecer familiar, não é diferente de bater em seu oponente com um par de luvas. A vantagem das Getas Bernacles é a invenção olfativa. Pandawas nunca foram famosos pela higiene dos pés...');
INSERT INTO "item_descriptions" VALUES(8714,'pt','Usar este anel é uma honra. Significa que você tem fé na deusa Cra, a única que sempre revelou como caçar com velocidade e eficiência.');
INSERT INTO "item_descriptions" VALUES(8715,'pt','A tagarelice dos Ecaflips é bem conhecida. Eles podem falar com quase tudo para fazê-lo jogar. Este anel celebra esta tagarelice incansável. Também pode ser usado como dados de reserva!');
INSERT INTO "item_descriptions" VALUES(8716,'pt','Osamodettes adoram este anel que dá um toque felino xtra ao seu caminhar. Assim, sempre que elas estão perto dos monstros, eles começam a se comportar como animais. Mas na verdade, são tão devotos quanto uma mãe leoa.');
INSERT INTO "item_descriptions" VALUES(8717,'pt','Fofoqueiros malévolos reivindicam este anel que é um acessório muito útil no mundo. As asas anexadas pode ser uma dor quando você precisa tirar um tecido do bolso. Agora, Iops não tem tecidos e nem bolsos ... então, é ideal. Exceto que atualmente espancam o inimigo a cada vez que passam por perto.');
INSERT INTO "item_descriptions" VALUES(8718,'pt','Fecas usam os mini escudos que estão neste anel como memorandos para escrever cartas de amor ou simplesmente lista de deveres. Esta jóia foi apelidada de escudo anti-esquecimento. Entretanto, não protege você de gaguejar ou sesear.');
INSERT INTO "item_descriptions" VALUES(8719,'pt','Graças a este item, Enutrofs podem se lembrar dos bons tempos quando quiserem. Eles só precisam extrair a pá de dentro. Para fazer a lembrança mais genuína, você precisa adicionar um cheiro específico.... Boa sorte!');
INSERT INTO "item_descriptions" VALUES(8720,'pt','A deusa Eniripsa deu este item para seus fiéis como sinal da união espiritual durante a sessão de iniciação de feitiço de raça. Incidentalmente Eniripsas também pode usá-lo como um bracelete esponja para limpar o langu de seus aliados.');
INSERT INTO "item_descriptions" VALUES(8721,'pt','Esta jóia tende a tornar Pandawas em serem zombadores, especialmente após o terceiro energético. Eles podem até mesmo ir tão rápido quanto os insultos dos outros. Mas não importa realmente... como diz o provérbio Pandawa "Eufórico não ouve o demônio".');
INSERT INTO "item_descriptions" VALUES(8722,'pt','Esta jóia com uma caveira era tradicionalmente oferecida para todas as crianças Sram para recompensar as traições e golpes abaixo da cintura. As outras raças parecem duvidas desta prática que tende a excitar demais as crianças e transformá-las em verdadeiros diabinhos.');
INSERT INTO "item_descriptions" VALUES(8723,'pt','Este anel é só uma jóia que pode dar tempo e é perfeitamente à prova d''água. Alguns acreditam que se você alargar e modificar os planos deste item, pode transformá-lo em um veículo capaz de se mover embaixo d''água. De onde eles tiram estas idéias?');
INSERT INTO "item_descriptions" VALUES(8724,'pt','Contrário ao rumor, os Sadias não deixam o cabelo cair... Este cabelo foi ajustado em torno deste maravilhoso anel para reforçar seus benefícios. Nunca corte! Graças ao Anel Relva, você será perfeito!');
INSERT INTO "item_descriptions" VALUES(8725,'pt','Se você vê um personagem que não é um Sacrier usando o Anel Ninewonwon, leve-o diretamente para um tratamento intensivo. Assim, esta jóia é extremamente nociva. Em geral, as pessoas perdem a paz de espírito quando encaram a piscina de sangue causada por este anel.');
INSERT INTO "item_descriptions" VALUES(8726,'pt','Estes sapatos permitem ao usuário dançar a noite toda, apesar de bolhas e pedras nos sapatos! Os sapatos dançam o ritmo da noite e faz o pequeno som de "beep beep" quando estão próximos de minérios preciosos. Por isso os Enutrofs são chamados de "Máquinas Musicais".');
INSERT INTO "item_descriptions" VALUES(8727,'pt','Quando Fecas estão envergonhados e desejam mudar de assunto, eles sempre mencionam as Botas de Ajuda. Eles falam sobre o caminho que pode marcar e todo tipo de terreno ideal para elas. Quando seus aliados estão com problemas no campo de batalha, estas confortáveis botas permitem evitar a ameaça.');
INSERT INTO "item_descriptions" VALUES(8728,'pt','As várias faixas em torno destes sapatos podem ser usadas como cordas caso arrebentem as de seu arco. Jovens Craettes também usam para cozinhar vegetais. Cheiro dos pés não parece incomodá-las.');
INSERT INTO "item_descriptions" VALUES(8818,'pt','Feito de tecido de Rei Mopy, esta capa tem pequenos buracos permitindo uma melhor dissipação do calor no caso de esforço excessivo, como durante ataques agressivos no pântano. Mesmo que esta capa deixe a umidade sair, ela mantém o calor. Desta forma, você fica seco, não importa a situação. Que pena que o mau cheiro é tão forte!!!');
INSERT INTO "item_descriptions" VALUES(8819,'pt','Mesmo que esta capa não seja tão poderosa quanto a do Rei Mopy, ainda tem o mesmo sistema de evacuação de calor. Você será capaz de encarar qualquer situação com esta capa, se puder lutar enquanto prende sua respiração... o fedor é insuportável!!');
INSERT INTO "item_descriptions" VALUES(8820,'pt','Graças a esta máscara, você encarará todos os tipos de perigo, sem medo! Mas é normal já que bloqueia sua visão.');
INSERT INTO "item_descriptions" VALUES(8821,'pt','A distância, este chapéu parece com abajur com dois buracos para os olhos. E de perto... Também.');
INSERT INTO "item_descriptions" VALUES(8822,'pt','Esta máscara não pode evitar nem curar dor de cabeça, mas pelo menos dá a você a oportunidade de se esconder elegantemente.');
INSERT INTO "item_descriptions" VALUES(8823,'pt','Esta máscara não pode evitar nem curar dor de cabeça, mas pelo menos dá a você a oportunidade de se esconder elegantemente. O toque sombrio simplesmente indica que você está de mau humor.. e que você não deve ser irritado e está pronto para distribuir pancadas em todos que não o respeitar!');
INSERT INTO "item_descriptions" VALUES(8824,'pt','Com isto, você se parecerá com um Snailmet. É claro, vai proteger sua cabeça de pancadas, mas é razão suficiente para babar assim? Você não precisa disso, continue em frente!');
INSERT INTO "item_descriptions" VALUES(8825,'pt','Maior, mais pesado e mais poderoso, esta maça faz um barulho grande quando esmaga os inimigos. Mas curiosamente, é mais leve e tem melhor pegada. No Coralator, nós costumávamos fazer isso, mas não tínhamos uma boa razão!');
INSERT INTO "item_descriptions" VALUES(8826,'pt','Apesar de seu pequeno tamanho a garota Zoth carrega um grande martelo. É a forma de reforçar sua estrutura muscular. Não precisa adicionar pesos para os pulsos e tornozelos para aumentar sua força. Arrastar este martelo já é o bastante!');
INSERT INTO "item_descriptions" VALUES(8827,'pt','O Guerreiro Zoth é usado para carregar dois machados, pois ele não pode ser alcançar o lado esquerdo do inimigo com sua mão direita. É difícil dizer se é um problema na imagem de seu corpo ou ser desajeitado desde o nascimento!');
INSERT INTO "item_descriptions" VALUES(8828,'pt','O Fregon é uma criatura alada estranha que tem muita energia como se tivesse gripe aviária e tanta inteligência quanto um Tofu. Não precisa dizer que não é apto para sobrevivência. Entretanto, algumas pessoas parecer adorar seu estranho corte de cabelo que parece uma vassoura dobrada. A natureza humana tem infinitos mistérios!');
INSERT INTO "item_descriptions" VALUES(8829,'pt','Este chapéu é grande o bastante para esconder a ridícula falta de cabelo da cabeça e da barba de Barbrossa. Mas não cobre cabeças muito grandes.');
INSERT INTO "item_descriptions" VALUES(8830,'pt','Sempre sonhou em ter o cabelo de Polly Darton? Apenas tenha esta impressionante, porém enfadonha, peruca em sua cabeça! Não só limpará a pista de dança do clube, mas amortecerá os golpes mortais em sua cabeça!');
INSERT INTO "item_descriptions" VALUES(8833,'pt','Este martelo pegou uma bela cor dos pedaços de Coralator usados para fazê-lo. Diferente do que as pessoas pensam, ele não foi originalmente usado para esmagar Iops ou inimigos. De fato, é um item feito à mão deixado por uma antiga civilização. Foi usado como aldrava, então as pessoas que tinham problemas de audição poderiam entender que alguém estava batendo na porta.');
INSERT INTO "item_descriptions" VALUES(8834,'pt','Este ramo foi usado para escovar algumas partes do corpo antes inacessíveis. Mas não se preocupe, a cor escura é autêntica, sem ligação com os vários tipos de depósitos contidos em cavidades inacessíveis do Treeckler.');
INSERT INTO "item_descriptions" VALUES(8835,'pt','Este ramo foi usado para escovar algumas partes do corpo antes inacessíveis. Isso poderia explicar o cheiro estranho impregnado.');
INSERT INTO "item_descriptions" VALUES(8836,'pt','Rotaflors usa seus caules para limpar as orelhas. Entretanto, escultores de cajados preferem usá-los como arma. A prova, se é necessário, é não haver explicação para gostos.');
INSERT INTO "item_descriptions" VALUES(8837,'pt','O Mestre Zoth pode derrotar qualquer um com este cajado. Ele não teme nenhum inimigo! E isso é normal já que ele não pode ver nada com este chapéu! Embora ele é uma técnica de luta muito útil, pode ser um problema durante as refeições. Com uma linha de visão limitada, o Mestre Zoth sempre tem problemas de comer sem se sujar todo...');
INSERT INTO "item_descriptions" VALUES(8838,'pt','Como ervas daninhas, o Tynril pode se multiplicar infinitamente graças um só pedaço de rizoma, após notar que alguns escultores criam um cajado de Tynril. Eles pensaram que podiam de forma fácil e barata vender os melhores licitantes. Mas não funcionou!');
INSERT INTO "item_descriptions" VALUES(8839,'pt','Esta máscara vodu é especialmente usada para cobrir a cara dos amados Kanniballs (como Thierry)! Mas eles normalmente erram o alvo de por isso ficam facilmente loucos!');
INSERT INTO "item_descriptions" VALUES(8840,'pt','Jav Kanniballs normalmente se sentem "azuis" e tingem seus pêlos de azul. Isso é devido ao final de uma triste história de amor ou o que? Difícil saber com certeza. Mas seria ótimo se eles pudessem usar a máscara e parar de cantar essa coisa melancólica.');
INSERT INTO "item_descriptions" VALUES(8841,'pt','Eles conseguiram tantos cartões amarelos pelos erros aos alvos que alguns Kanniballs decidiram pintar suas máscaras nesta cor.');
INSERT INTO "item_descriptions" VALUES(8842,'pt','Kanniball arqueiros não podiam se concentram e mirar direito a menos que estivessem muito nervosos. Para fazê-los ver em vermelho todo o tempo, eles pintaram suas máscaras desta cor.');
INSERT INTO "item_descriptions" VALUES(8843,'pt','Com este chapéu, o Crocodyl pensa que ele está muito na moda. Entretanto, se fosse possível, a moda nunca deveria ter sido tão insignificante. É melhor não tentar entender quão ridículo ele é, o Crocodyl é muito sensível...');
INSERT INTO "item_descriptions" VALUES(8844,'pt','Como um capuz real, este capuz tem as mesmas virtudes que a Capa do Rei Mopy. Tem micro-ventilação para melhorar drenagem do calor e sempre mantém sua cabeça fresca. Infelizmente, também tem os mesmos defeitos que a capa: cheiro nojento que alguém poderia cortá-lo com uma faca.');
INSERT INTO "item_descriptions" VALUES(8845,'pt','Embora seja menos eficiente que um capuz real, ele permite uma boa drenagem do suor. Talvez boa demais, na verdade. Como resultado, esteja você usando ou não, não faz nenhuma diferença.');
INSERT INTO "item_descriptions" VALUES(8846,'pt','O chapéu da garota de Zoth tem uma particularidade estranha para fazer ver coisas em dobro, isso explica o motivo de ela cecear...');
INSERT INTO "item_descriptions" VALUES(8847,'pt','Este capacete tem as mesmas vantagens de outros chapéus Zoth: protege do sol, não importa o quão quente esteja, de pancadas na cabeça e evita o usuário de ver o perigo restringindo seu campo de visão. De qualquer forma, é um capacete perfeito para gurreiros.');
INSERT INTO "item_descriptions" VALUES(8848,'pt','O chapéu do Mestre Zoth tem uma grande vantagem para restringir o campo visual mesmo mais do que outros capacetes. Graças a isso, você pode ter acesso à famosa técnica de luta chamada "doninha". A grosso modo, você só precisa acertar em volta com toda a sua força. Então, você se torna complemente imprevisível e certamente derrotará seus oponentes (ou pelo menos os surpreenderá o bastante para infligir danos com os ataques que acertarem).');
INSERT INTO "item_descriptions" VALUES(8849,'pt','Esta vara é bem popular entre as mulheres-tronco. Entretanto, se você seduz melhor outros tipos de mulhres, também é possível (mesmo que menos eficiente).');
INSERT INTO "item_descriptions" VALUES(8850,'pt','Se você é superticioso e sempre precisa bater na madeira, escolha esta Raiz Floramor! Por outro lado, você também pode tentar ser cuidado, não ver o ramo que está sentando e especialmente não colocar seus dedos no caminho!');
INSERT INTO "item_descriptions" VALUES(8854,'pt','Você diz que um Kraken, com o hálito mais imundo que já se viu, o segue aonde quer que você vá? Bem, lide com isso: é só uma minúscula inconveniência que vem com o chapéu!');
INSERT INTO "item_descriptions" VALUES(8855,'pt','Este escudo é certamente uma boa proteção, mas não seja todo. Não durará muito.');
INSERT INTO "item_descriptions" VALUES(8856,'pt','Quando Bherb pegava borboletas, ele colocava seu cinto Bherbal e as eliminava de forma saudável.');
INSERT INTO "item_descriptions" VALUES(8858,'pt','Estas botas criam um disfarça o barulho a cada passo, lembrando uma Trool no cio. Uma dolorosa lembrança de que você podia viver facilmente sem ela.');
INSERT INTO "item_descriptions" VALUES(8859,'pt','Este selo indica que o proprietário é um soberano da Turfeira Sem Fundo da ilha de Otomai. É difícil imaginar um reino mais pastoral...');
INSERT INTO "item_descriptions" VALUES(8860,'pt','Este anel foi tirado do dedo (ainda quente) de um Coralator abatido na hora. Sua mãe estava esperando-o para o jantar, até que ela viu seu bebê sendo transformado em túmulo. Coral é sensível e nem sempre como uma rocha, como as pessoas pensam.');
INSERT INTO "item_descriptions" VALUES(8861,'pt','Apenas Kimbos, com seus pés estranhos, podem se sentir confortáveis nestas sandálias. Entretanto, elas não são as únicas que podem se beneficiar de seus podereses. Mas tenha cuidado, não as usa de forma errada!');
INSERT INTO "item_descriptions" VALUES(8862,'pt','Parkinn Pan acreditava de verdade que ele podia voar graças a este cinto enfeitado com asas de Pikoko, mas não sabia que poucos Pikokos podem voar. Sempre que ele saltava da Árvore Keeholo se esborrachava no chão. Seu apelo "Queca" veio de "cair plano como uma panqueca".');
INSERT INTO "item_descriptions" VALUES(8863,'pt','Este amuleto é apenas um pedaço de madeira com um pedaço de tecido rasgado. Mas Zoth estão absolutamente convencidos de seus poderosos. Velhos tolos!');
INSERT INTO "item_descriptions" VALUES(8864,'pt','Esta corda de arco é feita de saliva de Snailmet, não tão seca e com uma elasticidade única. Entretanto, é viscosa e sua textura lembra ... bem, nada, é bem desagradável.');
INSERT INTO "item_descriptions" VALUES(8865,'pt','Esculpido em uma carapaça de Snailmet, este anel pode resistir a qualquer coisa ou qualquer um.');
INSERT INTO "item_descriptions" VALUES(8866,'pt','Traçando de tecidos de Zeht, esta capa tem um poder extraordinário de origem desconhecida.');
INSERT INTO "item_descriptions" VALUES(8867,'pt','Com esta capa, você será desejado para algumas vinagretes.');
INSERT INTO "item_descriptions" VALUES(8868,'pt','O Bico de Frengo nesta arma é absolutamente inútil e pode ser mais um obstáculo do que outra coisa.
Felizmente, ela é bem poderosa.');
INSERT INTO "item_descriptions" VALUES(8869,'pt','Estas botas são tão pesadas que devem ser categorizadas como armas. Assim, elas tornam letal o mais simples chute.');
INSERT INTO "item_descriptions" VALUES(8870,'pt','Esculpido em Treeclker Negro, este cinto não é flexível o bastante para deixar você livre para se movimentar, mas ao menos, protege bastante.');
INSERT INTO "item_descriptions" VALUES(8871,'pt','Esculpido em Treeckler Luz, este cinto não te protege bem, mas pelo menos, é flexível o bastante para deixá-lo livre para se movimentar.');
INSERT INTO "item_descriptions" VALUES(8872,'pt','Esta jóia não é preciosa, mas tem o tamanho perfeito para dosar a moorgale em uma bela belgroot saborosa com uma dica de Glaviooze.');
INSERT INTO "item_descriptions" VALUES(8873,'pt','Finalmente uma boa desculap para sentir o cheiro do mar!');
INSERT INTO "item_descriptions" VALUES(8874,'pt','Esta jóia algumas vezes tentou roubar um pouco de sua comida quando você estava comendo, então fique mais atento.');
INSERT INTO "item_descriptions" VALUES(8876,'pt','Esta capa estranha parecer ser feita de tinta preta, mas é bem estranha, comporta-se como tecido - não escorre. Parecem manchas, bem, isso não importa. Seu traseiro nunca ficará limpo novamente.');
INSERT INTO "item_descriptions" VALUES(8877,'pt','Uma vez em seu dedo, você não poderá retirá-lo jamais. Essas coisas são o caminho para o poder.');
INSERT INTO "item_descriptions" VALUES(8878,'pt','Este martelo não é útil, não é particularmente bom, não é muito ergonônico e não é poderoso. É tão leve, tão frágil, desbalanceado, brilhante demais e fedido. Mas pelo menos é colorido! Belas cores nunca machucaram ninguém neste mundo cruel!');
INSERT INTO "item_descriptions" VALUES(8879,'pt','Infelizmente, este anel só está polido do lado de foda. Você coloca em seu dedo através de um buraco cheio de fragmentos de rochas afiadas. É recomendado para Sacriers.');
INSERT INTO "item_descriptions" VALUES(8880,'pt','Este colar faz o usuário desejar gritar já que o bigode de Mufafah faz cócegas em seus mamilos.');
INSERT INTO "item_descriptions" VALUES(8881,'pt','Solo era é um inútil, como ele mesmo se descreve. Mas não tenha misericórdia, ele foi enforcado em público na praça principal da vila após roubar as calcinhas da mulher do chefe. Solo não era um sujeito inteligente, mas certamente um...');
INSERT INTO "item_descriptions" VALUES(8896,'pt','Este anel é um anel como nenhum anel deveria ser.');
INSERT INTO "item_descriptions" VALUES(8918,'pt','Na teoria, este capacete melhorado permite cavalgar mais rápido os Escarafolhas sem você perder sua peruca. Simplesmente inestimável!');
INSERT INTO "item_descriptions" VALUES(8919,'pt','Estas asas de madeira melhoradas foram acolchoadas e deixadas mais leves, além de um tecido de alta qualidade. Mas a estrutura ainda é de madeira e é difícil não quebrar!');
INSERT INTO "item_descriptions" VALUES(8924,'pt','Era uma vez, um homem chamado Rahm se perdeu na floresta. Já ouviu sobre Viet Rham?');
INSERT INTO "item_descriptions" VALUES(8925,'pt','Este estranho arco foi esculpido por uma Sadidette durante um passeio sonâmbulo bastante produtivo. Só de olha, já faz você ficar com sono - serve tanto para o arqueiro quanto para o alvo.');
INSERT INTO "item_descriptions" VALUES(8926,'pt','Estas adagas são perfeitas para puxar bananas e moer café. Alguns até as usam para esmagar maças e peras.');
INSERT INTO "item_descriptions" VALUES(8927,'pt','Há muito tempo lá viveu um louco Sram chamado Gaga... Este sujeito roubou de um pobre para dar a um rico.');
INSERT INTO "item_descriptions" VALUES(8928,'pt','Porkeez é melhor bebedor do que lutador, e deixe-me dizer a você que ele não conseguiu melhorar com o passar do tempo. Tudo igual, vai procurar uma rolha quando perde as adagas.');
INSERT INTO "item_descriptions" VALUES(8929,'pt','Isto não deve ser engano para o famoso cajado de nome similar. As lâminas neste implemento derramam sangue longe.');
INSERT INTO "item_descriptions" VALUES(8930,'pt','Muitos aventureiros orgulhosos recusaram esta arma por causa da cor. Muitos morreram por esta lâmina.');
INSERT INTO "item_descriptions" VALUES(8931,'pt','Esta espada costumava pertencer a um velho e poderoso Enutrof faminto. Como seu ego, ela é feita de ouro sólido.');
INSERT INTO "item_descriptions" VALUES(8932,'pt','Sorria! Diga xis! Perfeito! Foto tirada!');
INSERT INTO "item_descriptions" VALUES(8933,'pt','Ourag''han foi um velho Pandawa com pele tão suave que era conhecido como Slippiderm. Seu odor por outro lado fez com ele ficasse conhecido por outro nome. Ele batizou seu fiel machado da mesma forma.');
INSERT INTO "item_descriptions" VALUES(8934,'pt','Surge uma fúria quando um esquilo travesso rouba um grão de arroz durante um feriado de verão na ilha de Pandawa, Brouce Boulgour usava este machado para achatar e em cada bambu o esquilo saltava dentro. Os Pandawas na vila tem de alimentar metade do estoque de vinho de bambu para evitar de destruir toda a floresta. Acredite no velho Broucey.');
INSERT INTO "item_descriptions" VALUES(8935,'pt','Mesmo como uma jovem Iopette, Mel sonhava em caçar dragões. Com uma pá como espada e uma rocha como dragão, ela afia a pele das costas. A mera menção da pá agora deixa a pobre rocha com convulsões.');
INSERT INTO "item_descriptions" VALUES(8936,'pt','Esta é uma pá selvagem que tentou morder seu dono a cada vez que ele a pegava. Faz sons incomuns quando está feliz e só pode ser pacificada com sons suaves de harmonia.');
INSERT INTO "item_descriptions" VALUES(8937,'pt','Um Enutrof esperto tornou-se um pirata após notar que há mais tesouros para serem encontrados em corpos frescos do que em túmulos podres. Sua pá vermelha de sangue era o símbolo dos marinheiros destas águas com terror.');
INSERT INTO "item_descriptions" VALUES(8941,'pt','Esta espada ensinará a você que mesmo na maior maré de sorte existe um pouco de azar.');
INSERT INTO "item_descriptions" VALUES(8956,'pt','Esta espada ensinará a você que mesmo na maior maré de sorte existe um pouco de azar.');
INSERT INTO "item_descriptions" VALUES(8957,'pt','Esta espada ensinará a você que mesmo na maior maré de sorte existe um pouco de azar.');
INSERT INTO "item_descriptions" VALUES(8958,'pt','Você pediu uma boa arma para a deusa Ecaflip, mas tudo que conseguiu foi esta garra - que nem é tão afiada assim. É, talvez Ecaflip não seja uma deusa de verdade...');
INSERT INTO "item_descriptions" VALUES(8959,'pt','Você pediu uma boa arma para a deusa Ecaflip, mas tudo que conseguiu foi esta garra - que nem é tão afiada assim. É, talvez Ecaflip não seja uma deusa de verdade...');
INSERT INTO "item_descriptions" VALUES(8960,'pt','Você pediu uma boa arma para a deusa Ecaflip, mas tudo que conseguiu foi esta garra - que nem é tão afiada assim. É, talvez Ecaflip não seja uma deusa de verdade...');
INSERT INTO "item_descriptions" VALUES(8961,'pt','O povo supersticioso acredita que uma simples perna de coelho em volta do pescoço pode trazer sorte e fortuna. Graças a esta lendária espada, você será capaz de testar a teoria. Esta lâmina é extremamente afiada e não lembra em nada sua antiga espada.');
INSERT INTO "item_descriptions" VALUES(8962,'pt','O povo supersticioso acredita que uma simples perna de coelho em volta do pescoço pode trazer sorte e fortuna. Graças a esta lendária espada, você será capaz de testar a teoria. Esta lâmina é extremamente afiada...não lembra em nada sua antiga espada?');
INSERT INTO "item_descriptions" VALUES(8963,'pt','O povo supersticioso acredita que uma simples perna de coelho em volta do pescoço pode trazer sorte e fortuna. Graças a esta lendária espada, você será capaz de testar a teoria. Esta lâmina é extremamente afiada...não lembra em nada sua antiga espada?');
INSERT INTO "item_descriptions" VALUES(8964,'pt','"A sorte favore os destemidos", sussurrou os díscipulos de Ecaflip. Agora você está pronto, será capaz de mostrar como joga. Esta espada prestigiosa e pura é extremamente rara.');
INSERT INTO "item_descriptions" VALUES(8965,'pt','"A sorte favore os destemidos", sussurrou os discípulos de Ecaflip. Agora você está pronto, será capaz de mostrar como joga. Esta espada prestigiosa e pura é extremamente rara.');
INSERT INTO "item_descriptions" VALUES(8966,'pt','Esta espada representa a encarnação do deus da sorte Ecaflip. Ter uma dessas prova que você tem muita sorte.');
INSERT INTO "item_descriptions" VALUES(8989,'pt','Com este capacete, você pode ter a esperança de voar se girar na velocidade do som. Já para aterrissar, você terá dificuldades.');
INSERT INTO "item_descriptions" VALUES(8991,'pt','Esse anel frio e viscoso nunca se separará de seu dedo. Se você passar por uma ventania, entretanto, poderá controlar grandes poderes.');
INSERT INTO "item_descriptions" VALUES(8992,'pt','Esta lâmina corta trigo tão bem quanto inimigos, mas também faz seus aliados extremamente invejosos. Este é o destino de pessoas poderosas.');
INSERT INTO "item_descriptions" VALUES(8993,'pt','Esta espada mantém um poder imenso de muitas vítimas que preencheram os capítulos dos livros de história. Por outro lado, esta arma influencia gerando perigos mortais. Há alguém que possa domar esta força viciosa?');
INSERT INTO "item_descriptions" VALUES(9001,'pt','Este escudo lembrará seus oponentes que você cresceu nas terras de Sidimote. E que sozinho pode ser o bastante para afastá-los.');
INSERT INTO "item_descriptions" VALUES(9002,'pt','Este escudo é coberto com pimenta para permitir a você devastar os olhos dos demônios. Incontrolável.');
INSERT INTO "item_descriptions" VALUES(9003,'pt','O taverneiro da fábrica de energéticos de Feubuk em Bonta estava provavelmente bastante entediado quando teve a idéia de equipar seus vigias com escudos publicitários.');
INSERT INTO "item_descriptions" VALUES(9004,'pt','Para afastar o mal ou golpes fortes, este escudo de Akwadala deve servir.');
INSERT INTO "item_descriptions" VALUES(9005,'pt','Quando seus aliados perderem o fôlego, ou quando você quiser limpar o ar após um vento de pânico inesperado, este escudo pode salvar sua vida. A única coisa que você precisa fazer é movimentar energicamente em todas as direções, como você faz com um bebê faminto.');
INSERT INTO "item_descriptions" VALUES(9006,'pt','Originalmente este escudo foi usado como um banco pelos Sadidas para eles descansarem. Após arregaçar seus pés, ele te protegerá de muitos dos ataques, mas não da explosão de gargalhadas de seus oponentes.');
INSERT INTO "item_descriptions" VALUES(9007,'pt','Esta criação surpreendente cobre seu escudo nas Cuecas de Couro do Lançador Chafer, que foi fervida, limpada e esticada, então abraçou tão perfeitamente que o prencheu, com as curvas generosas de seu dono.. Eu acho que já é o bastante.');
INSERT INTO "item_descriptions" VALUES(9008,'pt','Este magnífico escudo contém alguns achados do Mar de Asse. Não apenas traz boa sorte, mas também pode ser usado como um frasco.');
INSERT INTO "item_descriptions" VALUES(9009,'pt','Escondido atrás deste escudo, alguns aventureiros ingênuos poderiam te enganar com um Treechnid e fugir gritando. Os ataques serão mais intensos, pensando que podem conseguir âmbar de você.');
INSERT INTO "item_descriptions" VALUES(9010,'pt','Perfeito se você quiser combinar com um Pandala, ou sobressair! A maior vantagem deste escudo consiste nele ser inteiramente coberto com pêlo Pandawa hipoalérgico, então você não precisa enrolar sua cueca e sua armadura em malas separadas quando for viajar nas férias.');
INSERT INTO "item_descriptions" VALUES(9011,'pt','Este escudo especial te protegerá do elemento Fogo e incidentalmente dará tempo a seus oponentes. Muito útil para conseguir tempo para derrotar!');
INSERT INTO "item_descriptions" VALUES(9012,'pt','Este escudo especial te protegerá do elemento Ar e incidentalmente dará muito tempo a seus oponentes. Tempo para fazer os últimos desejos!');
INSERT INTO "item_descriptions" VALUES(9013,'pt','Este escudo especial te protegerá do elemento Terra e incidentalmente dará muito tempo a seus oponentes. Tempo para fazer os últimos desejos!');
INSERT INTO "item_descriptions" VALUES(9014,'pt','Este escudo especial te protegerá do elemento Água e incidentalmente dará muito tempo a seus oponentes. Tempo para fazer os últimos desejos!');
INSERT INTO "item_descriptions" VALUES(9015,'pt','Este escudo costumava proteger lenhadores de árvores em queda. Ele rapidamente mudou. Você pode usá-lo para se proteger de inimigos em queda quem aterrissam sem avisar!');
INSERT INTO "item_descriptions" VALUES(9016,'pt','Esverdeado e fedorento, este escudo permanece a primeira escolha de proteção quando se luta com as criaturas do Monte Fedoranto.');
INSERT INTO "item_descriptions" VALUES(9017,'pt','Se o seu maior sonho é se tornar um diabinho, este é o escudo que você precisa. Passado de geração em geração, permitirá que você roube jovens aventureiros de Astrub sem se ferir.');
INSERT INTO "item_descriptions" VALUES(9018,'pt','Um famoso aventureiro passou toda a sua vida procurando as quatro partes deste escudo. Alguns dizem que quando a estiver completo, terá exatamente o efeito oposto de quebrar um espelho.');
INSERT INTO "item_descriptions" VALUES(9019,'pt','Nem todos os Wabbits são criaturinhas bonitas. De fato, todos os Wabbits são criaturas vis. Alguns esmagam cawwots com seus grandes escudos e tomam banho no suco.');
INSERT INTO "item_descriptions" VALUES(9020,'pt','Este escudo de pele será perfeito como uma luva. Não se esqueça de tratar suas verrugas e furúnculos de vez em quando para evitar desgastá-la.');
INSERT INTO "item_descriptions" VALUES(9021,'pt','Um jovem aventureiro uma vez sonhou em seu juntar à milícia de Bonta para proteger os oprimidos. Considerado moralmente inapropriado para o serviço, ele estava em contato co um alquimista de Amakna que levou vantagem de sua boa natureza, usando-o como um porquinho da índia com suas poções. Você ficará feliz em saber que é uma história que termina... bem, no meio é um pouco feliz. Ele se tornou tão forte que era mais conhecido como Capitão Amakna e este escudo com reputação de indestrutível foi forjado por ele. No fim.. bem, você não vai querer saber o fim.');
INSERT INTO "item_descriptions" VALUES(9022,'pt','Este enorme escudo salvou o famoso aventureiro Kloome de uma morte terrível: esmagado pelo peso de um Crackler que estava apaixonado por ele. A lenda não diz se ele sobreviveu aos efeitos colaterais desta história de amor com o Crackler.');
INSERT INTO "item_descriptions" VALUES(9023,'pt','Tão estranho quanto isto pode soar, alguns dizem que este escudo feito de madeira e pêlos, permite aos mais leves aventureiros voar por um breve momento... a última tentativa de surpreender os inimigos deles antes de desfalecerem estupidamente no chão.');
INSERT INTO "item_descriptions" VALUES(9024,'pt','O Chouque usou este escudo para proteger-se de bolas de canhão aliadas que seus amigos jogaram nele. Algumas histórias loucas dizem que estas bolas estavam vivas.');
INSERT INTO "item_descriptions" VALUES(9025,'pt','Embora inútil, este cheiro espalhará sua fama por toda a parte. Este escuro acompanhou muitos jovens aventureiros em suas primeiras missões - talvez é o motivo de poucos terem chegado aos trinta...');
INSERT INTO "item_descriptions" VALUES(9026,'pt','Este escudo é um tributo ao Manto de Bowisse já que ele em si era um tributo à famosa relíquia composta de três formas triangulares. Oh deus, esta história está me deixando com sono.');
INSERT INTO "item_descriptions" VALUES(9027,'pt','Esta pedra é na verdade feita da cabeça de um Crackler, esmagada pelo pé de um Minotoro. Uma combinação perfeita de cabeça grande e pés fedorentos!');
INSERT INTO "item_descriptions" VALUES(9028,'pt','O escudo de Terrdala deve ajudá-lo a mantê-lo salvo dos golpes fortes.');
INSERT INTO "item_descriptions" VALUES(9029,'pt','Para afastar o mal ou golpes fortes, este escudo de Akwadala deve servir.');
INSERT INTO "item_descriptions" VALUES(9030,'pt','Para afastar o mal ou golpes fortes, este escudo de Akwadala deve servir.');
INSERT INTO "item_descriptions" VALUES(9031,'pt','Neste tempo, o Mestre Gore era muito jovem e tinha tudo que precisava: dinheiro, mulheres e mais. Ele não era bem merecedor de tudo já que conseguiu sua força a partir deste belo anel. Até que um dia, ele atravessou a rua sem cuidado. E BAM! Acabou o Mestre Gore. Desde então, pessoas inescrupulosas passam-no para outras pessoas de mesmo nível.');
INSERT INTO "item_descriptions" VALUES(9117,'pt','Era apenas uma questão de tempo antes de eles começarem a fazer martelos com a cabeça deste idiota.');
INSERT INTO "item_descriptions" VALUES(9120,'pt','x');
INSERT INTO "item_descriptions" VALUES(9121,'pt','x');
INSERT INTO "item_descriptions" VALUES(9122,'pt','Uma vez que você coloca o Bloppish em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9123,'pt','Uma vez que você coloca o Bloppish em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9124,'pt','Uma vez que você coloca o Bloppish em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9125,'pt','Uma vez que você coloca o Bloppish em torno de seu dedo, é impossível livrar-se deste anel.');
INSERT INTO "item_descriptions" VALUES(9126,'pt','Kroula tinha um plano. Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9127,'pt','Kroula tinha um plano. Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9128,'pt','Kroula tinha um plano. Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9129,'pt','Kroula tinha um plano. Ele iria colocar este anel no dedão do pé, conseguir Blops para lamber seu pé e coletar litros de suco de Blop Real. Bem, o anel não entrou.');
INSERT INTO "item_descriptions" VALUES(9130,'pt','Este rascunho do Grande Ougaa é usado em volta do pescoço... Um olhar faminto e um cuidado atento são essenciais.');
INSERT INTO "item_descriptions" VALUES(9131,'pt','Uma jovem Craette chamada Colette uma vez perdeu a cabeça na Floresta Eltneg. A pobre garota cruzou o caminho da machadinha de Brouce Boulgoure e ele pensou que a garota era uma gigante. Sorte que ela não viveu, deveria ter morrido se descobrisse que foi confundida com uma gigante.');
INSERT INTO "item_descriptions" VALUES(9132,'pt','Seus dedos são jovens demais para entrar em boas casas noturnas? Ficam nervosos perto de garotas? Bem, coloque este anel, ele adicionará alguns anos à sua idade e fará você ter auto-confiança.');
INSERT INTO "item_descriptions" VALUES(9133,'pt','Balance seus dedos diante de quaisquer inimigos que são alérgicos a cogumelos. Deixa a luta mais rápida.');
INSERT INTO "item_descriptions" VALUES(9134,'pt','Este arco foi feito de costelas afiadas, finas e flexíveis que normalmente são usadas para fazer camas do que armas mortais. Agora eles costumam propor algo mais permanente para dormir. Quanta coincidência.');
INSERT INTO "item_descriptions" VALUES(9135,'pt','Este fungo em formato de trombeta foi usado para chamar o menestrel vagabundo Jon Lemons para a cena de batalha. Quando ele começou a cantar, todos que não taparam os ouvidos morreram na hora. Quando o som e a música insuportáveis começaram a ficar populares, os deuses bloquearam a trompa e transformaram-na em uma varinha mágica relativamente inofensiva.');
INSERT INTO "item_descriptions" VALUES(9136,'pt','Os três pontos deste cajado podem atrair particulas de Plasmogrine presentes na briza quadramental. Para fazer isso, alinhe-os com os ponteiros de um relógio Xelor invertido, conte até sessenta (experimente até seis se você for um Iop) e aperte suas bochechas. Você terá cinqüenta por cento de chance de fazer um raio.. e transformar seus inimigos em Kirballs torrados.');
INSERT INTO "item_descriptions" VALUES(9137,'pt','Estas facas foram usadas para lixar os pés de reis e rainhas, aliviando-os de vermes e fungos que pegam no pé de qualquer um.');
INSERT INTO "item_descriptions" VALUES(9138,'pt','As lâminas triplas deste machado têm sido usadas por muitos anos para cortar presunto e queijo três vezes mais rápido que o normal. Se você vir um guerreiro carregando uma, fuja o mais rápido possível... você provavelmente viu um canibal.');
INSERT INTO "item_descriptions" VALUES(9139,'pt','Estas botas sem artelho são perfeitas para dar uma boa lição a quem ousar falar palavras proibidas.');
INSERT INTO "item_descriptions" VALUES(9140,'pt','Contrário à errada concepção popular, os buracos nestes sapatos não estão lá para seus pés respirarem, mas para permitir que a desova do fungos dos seus pés escape e infecte os pés de outros aventureiros livres e felizes.');
INSERT INTO "item_descriptions" VALUES(9141,'pt','Se não estivesse tão embolorado, faria uma ótima toalha de mesa. Não se preocupe, você sempre pode secar a louça quando seus convidados não estiver olhando.');
INSERT INTO "item_descriptions" VALUES(9142,'pt','Mais um vidro na estrada? Ah, bem, estradas são longas, e as noites são curtas. Essa capa é normalmente usada para manter os ratos em alerta enquanto concluem seus turnos noturnos infindáveis. Acabarei com todos no final, você sabe.');
INSERT INTO "item_descriptions" VALUES(9143,'pt','Como o nome sugere, esta corrente mata qualquer mosca que estiver perto o bastante de seus doces. Apenas um pequeno conselho: nunca, jamais tente arrancar com seus dentes.');
INSERT INTO "item_descriptions" VALUES(9144,'pt','Como você pode evitar fungos entre na virilha? Bem, certifique de ir para um lugar menos particular... seus quadris! Com este cinto, você não resolverá nada, apenas moverá o problema de lugar.');
INSERT INTO "item_descriptions" VALUES(9145,'pt','Pegue um Olmeiro, tire a casaca, deixe-o por alguns meses em uma poça de lama, cubra-o com fungos infecciosos, deixe sobre sua cama por uma semana enquanto dorme no chão, bata nele regularmente com um Blop gordo. É tudo que você precisa saber para fazer um cinto de Olmeiro que fede. Está feliz agora?');
INSERT INTO "item_descriptions" VALUES(9146,'pt','A etiqueta no cinto diz... ''Sinto muito, mas se você está procurando um meio de conseguir os poderes de Ougaa, este cinto não serve para você.'' Bem, é ótimo, não é.');
INSERT INTO "item_descriptions" VALUES(9147,'pt','Leve um Dora, cubra-o com cuspe de Gobball e suor de Iop, deixe-o cozinhar por algumas semanas e você terá uma idéia dos efeitos tóxicos do Cogu Ombrero. Tente de afastar das máquinas pesas enquanto o usa. De fato, fique longe de qualquer coisa pesada.');
INSERT INTO "item_descriptions" VALUES(9148,'pt','Ao invés de parar de tomar suco de Blop impuro, Shika Ingalsse tomou até ficar eufórica. Um dia, como ela estava cambaleando e caindo nos campos dourados, Shika aterrissou com estas asas. Quem disse que suco de Blop impuro deve ser tomado com moderação?');
INSERT INTO "item_descriptions" VALUES(9149,'pt','Quando Lorkos sair para sua viagem no Labirinto de Minotoro, a primeira coisa que ele colocou foi seu Amublop. Ninguém jamais descobriu o motivo.');
INSERT INTO "item_descriptions" VALUES(9150,'pt','Quando Lorkos sair para sua viagem no Labirinto de Minotoro, a primeira coisa que ele colocou foi seu Amublop. Ninguém jamais descobriu o motivo.');
INSERT INTO "item_descriptions" VALUES(9151,'pt','Quando Lorkos sair para sua viagem no Labirinto de Minotoro, a primeira coisa que ele colocou foi seu Amublop. Ninguém jamais descobriu o motivo.');
INSERT INTO "item_descriptions" VALUES(9152,'pt','Quando Lorkos sair para sua viagem no Labirinto de Minotoro, a primeira coisa que ele colocou foi seu Amublop. Ninguém jamais descobriu o motivo.');
INSERT INTO "item_descriptions" VALUES(9153,'pt','Este Amublop custa muito mais que um simples Amublop, mas veja pelo lado bom... você venderá por um bom preço também, especialmente se for para um astrubiano.');
INSERT INTO "item_descriptions" VALUES(9154,'pt','Este Amublop custa muito mais que um simples Amublop, mas veja pelo lado bom... você venderá por um bom preço também, especialmente se for para um astrubiano.');
INSERT INTO "item_descriptions" VALUES(9155,'pt','Este Amublop custa muito mais que um simples Amublop, mas veja pelo lado bom... você venderá por um bom preço também, especialmente se for para um astrubiano.');
INSERT INTO "item_descriptions" VALUES(9156,'pt','Este Amublop custa muito mais que um simples Amublop, mas veja pelo lado bom... você venderá por um bom preço também, especialmente se for para um astrubiano.');
INSERT INTO "item_descriptions" VALUES(9157,'pt','Se você não colocasse montes de aditivos e cores artificiais nesta geléia, não teria nenhuma cor ou sabor. Agora quanta diversão deve ter?');
INSERT INTO "item_descriptions" VALUES(9158,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão que suas your ''Boot.. Bloops... Bloo...'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9159,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão que suas ''Boot.. Bloops... Bloo...'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9160,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão de suas ''Boot.. Bloops... Bloo...'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9161,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão que suas ''Boot.. Bloops... Bloo...'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9162,'pt','Diga a palavra Bloopts dez vezes bem rápido enquanto gira em círculos. Agora você sabe como é se sentir um Iop.');
INSERT INTO "item_descriptions" VALUES(9163,'pt','Diga a palavra Bloopts dez vezes bem rápido enquanto gira em círculos. Agora você sabe como é se sentir um Iop.');
INSERT INTO "item_descriptions" VALUES(9164,'pt','Diga a palavra Bloopts dez vezes bem rápido enquanto gira em círculos. Agora você sabe como é se sentir um Iop.');
INSERT INTO "item_descriptions" VALUES(9165,'pt','Diga a palavra Bloopts dez vezes bem rápido enquanto gira em círculos. Agora você sabe como é se sentir um Iop.');
INSERT INTO "item_descriptions" VALUES(9166,'pt','Algumas pessoas deixar a grama crescer sob seus pés. Com estas botas, você terá folhagem bastante para quatro casamentos e um funeral.');
INSERT INTO "item_descriptions" VALUES(9167,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9168,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9169,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9170,'pt','Por trás deste nome idiota está um cinto. Um cinto que não sabemos muito a respeito. Tem um formato original e habilidade mágica de esconder as piores camadas de gordura conhecidas pela ciência que garante que é o mais comum entre homens de meia idade.');
INSERT INTO "item_descriptions" VALUES(9171,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9172,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9173,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9174,'pt','O menor cantor de blues do mundo está tocando blues para este cinto na menor guitarra no mundo. Ele perdeu sua fivela. Se os cintos pudessem chorar, este choraria para sempre.');
INSERT INTO "item_descriptions" VALUES(9175,'pt','Se você apertar este cinto, pode desativar por completo seu sistema digestivo. Por quê você iria querer fazer uma cosa dessas é outra história.');
INSERT INTO "item_descriptions" VALUES(9176,'pt','Jon Lemon criou sua última e maior música quando estava sendo abatido pelo Bworker e esta lâmina. Era algo assim - ''Eu ouvi as notícias hoje oh cara, dez mil buracos em mimmm...'' Graças aos deuses que o Bworker teve um bom senso para anotar as palavras e a música.');
INSERT INTO "item_descriptions" VALUES(9177,'pt','Os três pontos deste bracelete representam as três maiores fraquezas do Bworker: sede de vingança, sede de vitória e bem, sede por líquidos.');
INSERT INTO "item_descriptions" VALUES(9178,'pt','Este anel é coberto por alguns fragmentos de nariz de shnoz do Bworker. A criatura imunda usa o pontos afiados para conseguir esta picareta perfeita.');
INSERT INTO "item_descriptions" VALUES(9179,'pt','Quando um certo Capitão Chafer encontrou o Bworker pela primeira vez, ele tomou a liberdade de dizer ''Uau, é sua bunda ou sua casa?'' Ninguém viu mais o bom Capitão, ou seu famoso modelo de roupa debaixo. Este amuleto foi criado em sua memória.');
INSERT INTO "item_descriptions" VALUES(9180,'pt','A história diz que o Bworker costurou esta capa com pele do traseiro de Rushu. A história seria plausível se o Bworker soubesse mesmo como costurar.');
INSERT INTO "item_descriptions" VALUES(9181,'pt','Este capacete tem muitos segredos. Já foi uma criatura pura e gentil, mas após muitos anos de violentas aventuras com o Bworker, pouco a pouco se tornou amargo e deformado. Então morreu.');
INSERT INTO "item_descriptions" VALUES(9182,'pt','Há muito tempo atrás, Danous Kwaide tinha uma piada engraça com o Bworker. Danous Kwaide começava. ''Qual a diferença entre suas botas furadas e...''Antes que ele tivesse tempo de terminar, o Bworker furou um buraco na cabeça de Danous.');
INSERT INTO "item_descriptions" VALUES(9183,'pt','Este cinto era usado nos banquetes de ovos Dofus que celebravam o dom dos seis ovos, como lembrado no Biibl, um texto antigo escrito por um bontariano. Muitas pessoas apenas pintam ovos comuns para se parecerem com Dofus e dão às outras, mas algumas vão mais além, usam este cinto doloroso por quarenta dias e noite que precedem a festa.');
INSERT INTO "item_descriptions" VALUES(9184,'pt','Apesar da aparência, este capacete não ajudará sua audição. Ajudará você a ver mais longe. Apenas tenha cuidado com ventos fortes ou você será levado como uma pena.');
INSERT INTO "item_descriptions" VALUES(9185,'pt','Este capacete não o tornará mais apavorante, e definitivamente nem mais poderoso... E se você pensar que por algum momento essas almas ingênuas confundirão você com Goultard, está pirado. Seu inimigos verão você com um sorriso no rosto, isso sim.');
INSERT INTO "item_descriptions" VALUES(9186,'pt','Além de seu amor por vasilhas de porcelana, nós conhecemos Flash Gorgone. Uma lenda diz que ele sempre estava com pressa e fugia de um Tofu... Ele aprendeu sua lição quando ele estava na cama uma manhã amarrado em seu cinto pelos tornozelos. Ainda lembro de sua coleção de porcelana como se fosse ontem.');
INSERT INTO "item_descriptions" VALUES(9187,'pt','Mestre Black Jack, o Eniripsa, era um dedicado seguidor da moda. Tanto que ele era capaz de costurar a pessoas de verdade depois de um tempo! Um amigo dos alfaiates, eles diz que sua inspiração para este capacete foi um alfaiate cruel que exterminou uma tribo de Ouginaks chamada os Macianos. Que história adorável.');
INSERT INTO "item_descriptions" VALUES(9188,'pt','Este sombreiro é o último traço por de trás de um Xelor sombrio e heróico que dizem ter desaparecido repentinamente. Da última vez que ele foi visto, estava fazendo serenata para sua amada. Eles dizem que os irmãos da noiva estavam por dentro da coisa toda. Outros dizem que ele estava vagando em uma dimensão paralela. O mistério mostra nenhum sinal de solução.');
INSERT INTO "item_descriptions" VALUES(9189,'pt','Se você tentar golpear os chifres de seus inimigos, sua cabeça começará a lembrar uma peneira! Chifres de XVII têm o mesmo efeito - eles fazem você esquecer tudo. Exceto a hora do janta, talvez.');
INSERT INTO "item_descriptions" VALUES(9190,'pt','Este capacete é perfeito para Cras que não pensam em coisas medianas. Apesar do cuidado, você parecerá um imbecil, estúpido mesmo. Normalmente este capacete é dado a combatentes aposentados que perderam uma grande porção de suas células cerebrais.');
INSERT INTO "item_descriptions" VALUES(9191,'pt','Esta lâmina foi roubada da janela da loja de um ferreiro onde estava por muitos anos. Espero que seja mais útil em suas mãos do que na loja, pois acho que sabemos que ninguém pagará nada por ela.');
INSERT INTO "item_descriptions" VALUES(9192,'pt','Quanto maior a gordura em seus quadris, mais atraente você ficará com este cinto.');
INSERT INTO "item_descriptions" VALUES(9193,'pt','Este amuleto lembrará você de dias felizes, dias de pique-nique, os dias antes de você se transformar .... Nisso.');
INSERT INTO "item_descriptions" VALUES(9194,'pt','Piolhos costumavam comer sua cabeça.Este novo capacete confeccionado nunca mais afastará estas criaturas nojentas. Agora eles esfolarão seu chapéu, como um rebanho pequeno, ao invés de sua cabeça.');
INSERT INTO "item_descriptions" VALUES(9195,'pt','Enrole na geléia de fruta, cubra a geléia e resista à tentação de comê-la. Este tratamento é a melhor diversão na medicina.');
INSERT INTO "item_descriptions" VALUES(9196,'pt','Feito de grãos de café, esta capa cheia a sovaco de Pikoko. Ela realmente faz o sangue correr antes da batalha... e é barata, também.');
INSERT INTO "item_descriptions" VALUES(9197,'pt','Coloque duas colheres de açúcar, mexa rápido e sacie sua sede com este chapéu revitalizante.');
INSERT INTO "item_descriptions" VALUES(9198,'pt','Se você se encontrar diante de um energético ou café sem gosto, coloque este anel lá por um tempo.');
INSERT INTO "item_descriptions" VALUES(9199,'pt','Olhe o que você fez. Só olhe. Tentando esmagar as xícaras de café com suas botas... O que você pensa que está fazendo?');
INSERT INTO "item_descriptions" VALUES(9202,'pt','Mesmo na morte, o Mestre Gore continua esculpindo itens que estavam estragados com a ordem cósmica do universo. Ele sempre reclamou que fez seu segundo anel tarde demais. Ele poderia ter viajado o mundo se o fizesse mais cedo. No final, um demônio roubou dele e escondeu em um mundo mortal para aventureiros fracos.');
INSERT INTO "item_descriptions" VALUES(9347,'pt','Pussin era um efeminado com um belo... colar.');
INSERT INTO "item_descriptions" VALUES(9366,'pt','Este tofu rosa será ideal para colocar nas costas nas festividades de Ano Novo. Feito de algodão ancestral e musse esticado de Sponge Mob, ele é leve e confortável como uma garotinha, este pedaço pode ser o primeiro em uma linha de tutus para uma futura estrela da dança.');
INSERT INTO "item_descriptions" VALUES(9394,'pt','Este capacete dará um estilo classe Mitcho para qualquer um que usá-lo. Tem um cheio forte de arbusto que seus amigos não poderiam ficar sem.');
INSERT INTO "item_descriptions" VALUES(9395,'pt','Este capacete foi usado pelo Kuri em pessoa por alguns anos. Antes que ela decidiu parar de usar, é isso.');
INSERT INTO "item_descriptions" VALUES(9396,'pt','Chamado ''Zawooin Ling'' na linguagem antiga dos Lenalds, os rumores dizem que este item foi forjado em um vulcão embaixo do Fogo de Pandara por Zeewon, um misterioso Wabbit.');
INSERT INTO "item_descriptions" VALUES(9402,'pt','As pequenas asas acopladas a estas pantufas darão a sensação de leveza aos seus pés. Mas tenha cuidado: não os use para jogar Goboliche... os Gobballs não gostariam de tomar uma espetada no traseiro.');
INSERT INTO "item_descriptions" VALUES(9403,'pt','As pequenas asinhas acopladas a este martelo fazem dele muito mais simples de manusear. De tão leve, ele pode até mesmo voar e acertar sua cabeça quando estiver dormindo... Tome cuidado!');
INSERT INTO "item_descriptions" VALUES(9404,'pt','O ferrão ao final desta capa irá preveni-lo de ter seu traseiro chutado por seus inimigos. Mas você também não poderá sentar sem se machucar...');
INSERT INTO "item_descriptions" VALUES(9405,'pt','Ao usar este chapéu, você deve estar ciente de que está aceitando o risco de ser acertado por um Moskito...');
INSERT INTO "item_descriptions" VALUES(9406,'pt','Estas nojentas orelhas de porco ainda estão quentes e são essenciais para seduzir qualquer porco nojento que estiver ao redor. Não ria, você nem imagina como poderá se sentir sozinho nos campos de Amakna');
INSERT INTO "item_descriptions" VALUES(9407,'pt','Atualmente muita gente chama esta capa de “Manto Saca-Rolha” e odeiam quem chama de qualquer outra coisa. Não importa como chamam esta capa, uma coisa é certa, é inútil para abrir garrafas!');
INSERT INTO "item_descriptions" VALUES(9408,'pt','Este anel o tornará um Porco Nojento que agradará seus amigos mais próximos');
INSERT INTO "item_descriptions" VALUES(9409,'pt','Este pequeno rabo em formato de sacarrolha trará a tona o melhor das pessoas que te cercam');
INSERT INTO "item_descriptions" VALUES(9410,'pt','Pode não ter um design tradicional, mas é bem elegante! Este chapéu mostrará aos outros o quão moderno você é');
INSERT INTO "item_descriptions" VALUES(9411,'pt','Esta capa protegerá sua retaguarda das queimaduras de sol. Seja cuidadoso, pois ela não pode ser usada nas costas de um vaqueiro qualquer.');
INSERT INTO "item_descriptions" VALUES(9412,'pt','A fivela deste cinto é extremamente resistente. Tanto que você não será capaz de soltá-la nunca mais. Isso é prova de que você é um verdadeiro xerife!');
INSERT INTO "item_descriptions" VALUES(9413,'pt','As esporas destas botas permitirão que você fatie seu Dragossauro quando achar que é hora de comê-lo.');
INSERT INTO "item_descriptions" VALUES(9414,'pt','Sua cabeça combinará facilmente com este enorme limão vazio e a semente no seu interior o fará se sentir em casa!');
INSERT INTO "item_descriptions" VALUES(9415,'pt','Esta capa foi feita a partir de cascas de diferentes frutar cítricas. É muito refrescante, mas infelizmente ela não brilha no escuro.');
INSERT INTO "item_descriptions" VALUES(9416,'pt','Se sua água se tornar sem sabor, apenas coloque o seu anel no dedo, seu dedo no copo de água e mexa vigorosamente antes que sua mão seja arrancada. Pronto! Uma deliciosa mistura de laranja-limão e sangue! O seu dedo? Ah...não se pode ter tudo na vida....');
INSERT INTO "item_descriptions" VALUES(9417,'pt','Se você sempre sonhou em passar por cima de seus inimigos em batalha, este cajado foi feito para você');
INSERT INTO "item_descriptions" VALUES(9418,'pt','O próximo barbeiro que tentar cortar o seu cabelo terá sorte de não quebrar a crista.');
INSERT INTO "item_descriptions" VALUES(9451,'pt','Este enorme pedaço de cristal pode ser usado com uma capa rígida, mas não pense que o fará mais forte... Bem, o próximo monstro que tentar comê-lo ficará engasgado.');
INSERT INTO "item_descriptions" VALUES(9452,'pt','Este anel fará o seu dedo radiante');
INSERT INTO "item_descriptions" VALUES(9453,'pt','Com este cinto em volta de seu quadril, ninguém o beliscará sem temer que seus dedos sejam arrancados');
INSERT INTO "item_descriptions" VALUES(9454,'pt','Este amuleto pode ser usado como um babador tanto para crianças como para os velhinhos.');
INSERT INTO "item_descriptions" VALUES(9455,'pt','Você pode usar este anel em qualquer dedo do pé se você precisar disfaeçar o mal cheiro dele.');
INSERT INTO "item_descriptions" VALUES(9456,'pt','Se você que as suas costas nunca receberam a devida atenção, apenas coloque esta longa capa que chamará a tenção de todos que o cercam.');
INSERT INTO "item_descriptions" VALUES(9457,'pt','Este chapéu tem cheiro de Rosas Demoníacas que te livra dos piolhos e também de qualquer outro parasita que se instale em sua cabeça.');
INSERT INTO "item_descriptions" VALUES(9461,'pt','Dizem que o Kimbo usa esta peruca para pagar tributo a um formoso, perfeitamente tosado jovem que ele encontrou na ilha. Que belo sorriso ele tinha! De qualquer forma, ele escondeu a peruca ridícula embaixo de seu coco.');
INSERT INTO "item_descriptions" VALUES(9463,'pt','Esta jóia é tão poderosa que matou um Moskito dentro de 30 passos, se só o cheiro não evitar de se aproximar!');
INSERT INTO "item_descriptions" VALUES(9464,'pt','Esse amuleto amedrontador foi escondido em uma mansão distante. Quando estava vivo, costumava sonhar com o mundo e todos os locais que pudesse ver. No final, o único lugar a que ele chegou foi seu pescoço. Pobre coisinha!');
INSERT INTO "item_descriptions" VALUES(9468,'pt','Esta perigosa pá roubará sua vitalidade, sua juventude, a água em seu corpo e seu precioso Troofles.');
INSERT INTO "item_descriptions" VALUES(9469,'pt','Feita com fungo, esta espada é perfeita para infectar o intestino de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(9471,'pt','Rosadinhos e Rosadinhas, este elegante acessório foi criado especialmente para vocês que estão em busca da alma gêmea. Os noivos podem usá-lo para mostrar ao mundo, discretamente, o quanto se amam.');
INSERT INTO "item_descriptions" VALUES(9479,'pt','No mínimo, o pino pregado neste chapéu vai encolher uma cabeça grande.');
INSERT INTO "item_descriptions" VALUES(9480,'pt','Quando um belo alvo aparece nas costas da sua capa, seus inimigos não vão ter desculpas para errar o ataque.');
INSERT INTO "item_descriptions" VALUES(9481,'pt','O pino pregado neste escudo pode ser usado como uma arma extra para combater e matar seus inimigos.');
INSERT INTO "item_descriptions" VALUES(9482,'pt','Se não quiser assustar seus amigos com a sua cara feia, é melhor se esconder por trás desse belo e convidativo escudo.');
INSERT INTO "item_descriptions" VALUES(9483,'pt','Quando os Iops ganham estrelas de seus professores por terem trabalhado bem, grudam-nas neste escudo. De tempos em tempos, eles grudam em si mesmos para se mostrar para seus colegas de escola.');
INSERT INTO "item_descriptions" VALUES(9484,'pt','Este escudo não é uma garantia total de proteção para o seu dono, mas é ótimo para perseguir fantasmas.');
INSERT INTO "item_descriptions" VALUES(9485,'pt','Estas três pequenas bolas na parte inferior da capa permitirão dar boas cabeçadas, isto se você aprender a dar piruetas!');
INSERT INTO "item_descriptions" VALUES(9486,'pt','Com ou sem esse chapéu, você vai parecer um palhaço... Mas, com ele, pelo menos você terá uma desculpa!');
INSERT INTO "item_descriptions" VALUES(9540,'pt','Esta capa protegerá seu pescoço do tempo frio e sua retaguarda de ventos baixos.');
INSERT INTO "item_descriptions" VALUES(9541,'pt','Este chapéu especial o fará parecer com o Padrinho. Você deveria se orgulhar!');
INSERT INTO "item_descriptions" VALUES(9542,'pt','Estes sapatos ficam muito mais brilhantes quando estão gastos. Eles são perfeitos para impressionar seus oponentes quando estiverem cara a cara.');
INSERT INTO "item_descriptions" VALUES(9543,'pt','Este pesado anel dará mais poder para as suas palmadas e mais paixão para o seu afago.');
INSERT INTO "item_descriptions" VALUES(9544,'pt','Esta temível arma mágica foi criada pelo famoso Hissering. Essa arma aumenta o poder mágico do seu usuário, mudando sua aparência e concedendo a ele novos feitiços. Com essa arma, você se tornará uma pessoa diferente e possuirá apenas um amigo... A própria arma.');
INSERT INTO "item_descriptions" VALUES(9545,'pt','Esta temível arma mágica foi criada pelo famoso Hissering. Essa arma aumenta o poder mágico do seu usuário, mudando sua aparência e concedendo a ele novos feitiços. Com essa arma, você se tornará uma pessoa diferente e possuirá apenas um amigo... A própria arma.');
INSERT INTO "item_descriptions" VALUES(9546,'pt','Esta temível arma mágica foi criada pelo famoso Hissering. Essa arma aumenta o poder mágico do seu usuário, mudando sua aparência e concedendo a ele novos feitiços. Com essa arma, você se tornará uma pessoa diferente e possuirá apenas um amigo... A própria arma.');
INSERT INTO "item_descriptions" VALUES(9547,'pt','Esta temível arma mágica foi criada pelo famoso Hissering. Essa arma aumenta o poder mágico do seu usuário, mudando sua aparência e concedendo a ele novos feitiços. Com essa arma, você se tornará uma pessoa diferente e possuirá apenas um amigo... A própria arma.');
INSERT INTO "item_descriptions" VALUES(9548,'pt','Esta temível arma mágica foi criada pelo famoso Hissering. Essa arma aumenta o poder mágico do seu usuário, mudando sua aparência e concedendo a ele novos feitiços. Com essa arma, você se tornará uma pessoa diferente e possuirá apenas um amigo... A própria arma.');
INSERT INTO "item_descriptions" VALUES(9549,'pt','O lema do alfaiate que fez este milagre era: "Mesmo no centro da ação, suas calças devem permanecer justas, graças a alta qualidade do suspensório de linho." É, realmente não é um bom lema...');
INSERT INTO "item_descriptions" VALUES(9566,'pt','Dizem que o primeiro Escudo dessa linhagem foi forjado em uma taverna em Pandala e que a própria deusa Pandawa deu sua contribuição. Alguns acham que o escudo protege de raios, enquanto outros falam que o escudo é feito de raios. Fato ou Ficção? Golpe de marketing dos forjadores? Quem sabe... apenas o tempo dirá.');
INSERT INTO "item_descriptions" VALUES(9567,'pt','Com esse chapéu você irá parecer um vingador mascarado, ou talvez vai parecer que você está usando um berço como chapéu. Você sabe como os Wabs são...');
INSERT INTO "item_descriptions" VALUES(9569,'pt','O pequeno pompom no final dessa capa é o maior roupão da história. É tão pequeno que ele pode até ser colocado embaixo da sua mobília. Não se esqueça de tirá-la quando estiver trabalhando nos campos.');
INSERT INTO "item_descriptions" VALUES(9575,'pt','Este cinto possui estampa dos dois lados e pode ser usado de acordo com o que você deseja ocultar ou mostrar...');
INSERT INTO "item_descriptions" VALUES(9576,'pt','Feitas a partir do couro de um Wabbit Preto, essas botas possuem um cheiro nada agradável, mas eles são tão confortáveis que você nem mesmo irá perceber o cheiro... Elas são ótimas para andar na mata.');
INSERT INTO "item_descriptions" VALUES(9582,'pt','Esse certificado permite a você pegar sua montaria no estábulo. Aviso! Esse certificado é válido apenas por 20 dias. Quando o tempo acabar, sua montaria será solta para a natureza e seu certificado não terá mais validade. Você não poderá recuperar sua montaria. Sempre deixe sua montaria no estábulo se você for ficar longe durante muito tempo.');
INSERT INTO "item_descriptions" VALUES(9594,'pt','Este Gobtubby parece perfeitamente normal... Entretanto, sua lã parece se tornar escura em alguns lugares... Dê um tempo e você ficará surpreso!');
INSERT INTO "item_descriptions" VALUES(10000069,'pt','Este Gobtubby parece perfeitamente normal... Entretanto, sua lã parece se tornar escura em alguns lugares... Dê um tempo e você ficará surpreso!');
INSERT INTO "item_descriptions" VALUES(9617,'pt','Esta pequena bola de pelo é mais resistente ao frio do que o Miau original. Ele se recusa a comer qualquer coisa diferente de peixe e carne.');
INSERT INTO "item_descriptions" VALUES(9619,'pt','Esta criatura é um pouco estúpida. A única maneira de fazê-lo avançar é colocando uma cenouwawa numa vara à sua frente. Felizmente, ele foi bem treinado e você vai ter nenhuma surpresa desagradável, como outras criaturas que posso citar. Esse coletor de alma irá se alimentar de restos de Wabbits.');
INSERT INTO "item_descriptions" VALUES(9620,'pt','Este Minimino foi trazido pelo próprio Minotot... Então ele agora é um Miniminotot. Infelizmente sua principal característica é se esfregar nas inocentes criaturas deixando nelas seus odores nojentos. Esta alma esfomeada se alimentará das sobras das criaturas das Ilhas do Minotoror.');
INSERT INTO "item_descriptions" VALUES(9623,'pt','Não se deixe enganar, os dentes pontudos desta criatura irão terminar em suas costas um dia, isso é certeza. Este animal de estimação só come peixe e carne.');
INSERT INTO "item_descriptions" VALUES(9624,'pt','Pegue um Dragoone rosa, mergulhe em um pote de tinta preta, jogue algum pó de ouro, role ele no óleo, e jogue um pouco de água e se ele não tiver morrido sufocado, você agora tem um Dragoone preto. Ele só somente vai se alimentar de restos de outros Dragonetes.');
INSERT INTO "item_descriptions" VALUES(10000005,'pt','Pegue um Dragoone rosa, mergulhe em um pote de tinta preta, jogue algum pó de ouro, role ele no óleo, e jogue um pouco de água e se ele não tiver morrido sufocado, você agora tem um Dragoone preto. Ele só somente vai se alimentar de restos de outros Dragonetes.');
INSERT INTO "item_descriptions" VALUES(9627,'pt','Certas aventuras escolhidas pelos deuses deverão usar este cajado para ajudar a vizinhança. Que nobre missão você tem pela frente!');
INSERT INTO "item_descriptions" VALUES(9652,'pt','Esta bandana é perfeita para absorver a transpiração ou mostra a sua "Atitude Aloha"');
INSERT INTO "item_descriptions" VALUES(9653,'pt','As asas que estão nesta capa o protegem seus insultos');
INSERT INTO "item_descriptions" VALUES(9654,'pt','Esta capa ressaltará a sua curvatura traseira, ou curvar de vez as suas costas.');
INSERT INTO "item_descriptions" VALUES(9655,'pt','As solas destas sandálias são mais robustas dos que as sandálias normais para certificar que resistirão ao peso dos Alowas.');
INSERT INTO "item_descriptions" VALUES(9656,'pt','Estas botas têm rodinhas que fazem a sua descida ladeira a baixo muito mais rápidas, aumentando sua queda. Você escolhe!');
INSERT INTO "item_descriptions" VALUES(9657,'pt','Quem deu a este cajado esta aparência estúpida? Bem, ninguém sabe... Mas você deverá brandí-la frente aos seus inimigos... Não importanto o quão estúpido pareça.');
INSERT INTO "item_descriptions" VALUES(9658,'pt','Este amuleto é um mero colar de flores. Ele supostamente exala um cheiro mágico e transforma um Alowa em Alowaniano.');
INSERT INTO "item_descriptions" VALUES(9659,'pt','Erala usou este amuleto por todo a sua infância. Ninguém sabe o que há dentro dele, nem ela mesma.');
INSERT INTO "item_descriptions" VALUES(9660,'pt','Dois rabos em um só corpo... Um sonho que finalmente virou realidade!');
INSERT INTO "item_descriptions" VALUES(9662,'pt','Aventureiros gostam de colecionar este tipo de anel mas ninguém sabe de verdade o motivo.');
INSERT INTO "item_descriptions" VALUES(9663,'pt','Elas deverão ser cobertas com pelos ruivos, com certeza são as orelhas mais aerodinâmicas que você já encontrou.');
INSERT INTO "item_descriptions" VALUES(9667,'pt','Slait agora pode andar em sua novo piso de madeira sem arranhá-lo');
INSERT INTO "item_descriptions" VALUES(9706,'pt','Essa arma é uma Shushumi e pode ser usada para adquirir fragmentos de Shushu dos monstros. Ao adquirir um fragmento, você pode tentar anexá-lo a uma arma, tornando-a mais poderosa.');
INSERT INTO "item_descriptions" VALUES(9707,'pt','Essa arma é uma Shushumi e pode ser usada para adquirir fragmentos de Shushu dos monstros. Ao adquirir um fragmento, você pode tentar anexá-lo a uma arma, tornando-a mais poderosa.');
