INSERT INTO "item_descriptions" VALUES(9758,'pt','Essa arma é uma Shushumi e pode ser usada para adquirir fragmentos de Shushu dos monstros. Ao adquirir um fragmento, você pode tentar anexá-lo a uma arma, tornando-a mais poderosa.');
INSERT INTO "item_descriptions" VALUES(9759,'pt','Essa arma é uma Shushumi e pode ser usada para adquirir fragmentos de Shushu dos monstros. Ao adquirir um fragmento, você pode tentar anexá-lo a uma arma, tornando-a mais poderosa.');
INSERT INTO "item_descriptions" VALUES(9785,'pt','Este pequeno capetinha irá acompanhá-lo na sua jornada, seja ela no Zaap de Asturb até mesmo nos lugares mais perigosos. Esse filhote possui uma boca suja e pode falar algumas besteiras, mas nada que um balde com água e sabão não resolva. Se você entrar em combates, certamente ele irá lhe ajudar!');
INSERT INTO "item_descriptions" VALUES(10000063,'pt','Este pequeno capetinha irá acompanhá-lo na sua jornada, seja ela no Zaap de Asturb até mesmo nos lugares mais perigosos. Esse filhote possui uma boca suja e pode falar algumas besteiras, mas nada que um balde com água e sabão não resolva. Se você entrar em combates, certamente ele irá lhe ajudar!');
INSERT INTO "item_descriptions" VALUES(9919,'pt','Transformar-se em uma coruja');
INSERT INTO "item_descriptions" VALUES(9921,'pt','Eles dizem que este bracelete é reluzente, mas somente quando você estiver em uma taverna no meio da noite.');
INSERT INTO "item_descriptions" VALUES(9922,'pt','Este cinto possui um poder magnético que e fecha muito bem a fivela. É normalmente usada como poteção adicional ao cinto de castidade.');
INSERT INTO "item_descriptions" VALUES(9923,'pt','Os giradores de cabeça serão pouco úteis para estes sapatos, a menos que você utilize seus pés de vez em quando - aí sim serão exatamente do que você precisa.');
INSERT INTO "item_descriptions" VALUES(9924,'pt','A lenda diz que esses chifres foram usados como condutor de eletricidade, concentrando eletricidade durante várias horas e depois projetando raios em qualquer pessoa que se aproximasse demais. Outra lenda diz que eles apenas fazem quem estiver vestindo ficar ridículo.');
INSERT INTO "item_descriptions" VALUES(9925,'pt','Este anel parece mais uma luva do que um anel de casamento, mas quem se importa, ninguem nunca mais irá mexer em sua mão da mesma maneira.');
INSERT INTO "item_descriptions" VALUES(9926,'pt','Esse machado de dois gumes pode derrotar duas cabeças com um golpe. O que equivale a um oitavo de uma hidra com dezesseis cabeças.');
INSERT INTO "item_descriptions" VALUES(9927,'pt','Se você vestir essas botas enquanto estiver escalando o Monte Jifu, é quase certeza que você irá ver alguns estranhos OVNI''s voando pelo céu.');
INSERT INTO "item_descriptions" VALUES(9928,'pt','Estas botas levam aproximadamente 12 horas para amarrar e um pouquinho mais de tempo para tirá-las. Isso lhe dará tempo suficiente para dormir um pouco quase todo dia, isso enquanto você for solteiro, desempregado e muito habilidoso com as mãos.');
INSERT INTO "item_descriptions" VALUES(9929,'pt','O tendão de Aquiles nem sempre fica embaixo dos joelhos, você sabe. De vez em quando fica logo abaixo da cintura. Neste caso, este pesado mas efetivo cinturão dará, a todos os fracos, uma mente serena e quilos de confiança.');
INSERT INTO "item_descriptions" VALUES(9930,'pt','Esta máscara não somente lhe deixará com a aparência de um canibal assassino e aterrorizante, como também irá proteger sua delicada e rósea buchecha de ventos fortes e do sol quente.');
INSERT INTO "item_descriptions" VALUES(9931,'pt','Longo nas costas, curto em cima, este corte de cabelo tem uma má reputação, mas com certeza você mudará isso.');
INSERT INTO "item_descriptions" VALUES(9933,'pt','Todo lutador sabe que a parte mais perigosa da luta livre é a platéia. Então quando cadeiras e garrafas vierem voando para o ringue, se cubra nesta capa de pelo de Pikoko e se encolha em posição fetal.');
INSERT INTO "item_descriptions" VALUES(9936,'pt','Este capacete é perfeito para as pessoas que têm uma aparência muito inofensiva. Isso pode ser muito perigoso no Mundo dos Doze.');
INSERT INTO "item_descriptions" VALUES(9937,'pt','Esta cartola vem junto com um bigode falso, o que é muito legal até que alguém lhe confunda com um grade ditador.');
INSERT INTO "item_descriptions" VALUES(9938,'pt','A lâmina desta espada ficou mergulhada em suco de vaga-lume concentrado por 18 meses para que ela brilhasse no escuro. A propósito, agora ela fede no escuro também.');
INSERT INTO "item_descriptions" VALUES(9939,'pt','Esta bengala feita de bambú flexivel definitivamente não serve como apoio... Ao invés disso tente ficar girando ela no ar!');
INSERT INTO "item_descriptions" VALUES(9942,'pt','Este anel é também conhecido como Anel da Escuridão, mas apesar de seus dois nomes, o anel não foi terminado. Mesmo assim, é poderoso o bastante para destruir um planeta de pequeno porte.');
INSERT INTO "item_descriptions" VALUES(9943,'pt','Diz a lenda que estes sapatos foram comidos por um minerador de ouro e que foi costurado devolta ao ser recuperado um tempo depois. Deve ser por isso que ele brilha tanto.');
INSERT INTO "item_descriptions" VALUES(9944,'pt','Este talismã é ao mesmo tempo um amuleto e uma gravata. Ele vai lhe deixar com um ar de cavalheiro mesmo quando você estiver na pior.');
INSERT INTO "item_descriptions" VALUES(9945,'pt','Newddha, o profeta, é famoso por recusar a herança de sua família para ir sentar embaixo de um coqueiro, esperando por iluminação espiritual. Ao invés disso, um côco gigante caiu em sua cabeça, onde ele se convenceu a deixar toda essa baboseira de lado.');
INSERT INTO "item_descriptions" VALUES(9957,'pt','You are in possession of Crocoburio''s soul. This blade, that you pulled out of the mythical stone in the depths of the marshes, can only to be handled by a select few. Passing it on to someone else would be an affront to the memory of Crocoburio himself.');
INSERT INTO "item_descriptions" VALUES(9961,'pt','Esse martelo de pedra foi inventado para fazer os ferreiros acreditarem que estão com um martelo de ótima qualidade. É recomendado que você não o toque, mesmo que não vá fazer nada.');
INSERT INTO "item_descriptions" VALUES(9972,'pt','Este martelo, para ser usado em uma forja, foi criado para um propósito específico, o que faz o uso dele pra qualquer outra coisa bem difícil. Apenas alguem desesperado ou nas margens da sociedade o usaria para criar armas.');
INSERT INTO "item_descriptions" VALUES(9974,'pt','Este talhador é para cortar manivelas, não velas. Você pode tentar pintar uma tela em sua cela,');
INSERT INTO "item_descriptions" VALUES(10054,'pt','Este anel ficou três anos imerso em excremento de Borcego. Pelo menos ainda é mágico.');
INSERT INTO "item_descriptions" VALUES(10055,'pt','Este amuleto deve evitar que Vampyres suguem o seu sangue. A idéia é que eles pensem que você é um Vampyre também.');
INSERT INTO "item_descriptions" VALUES(10056,'pt','Este cinto não somente brilha no escuro como também brilha no claro! Apesar de ser difícil de ter certeza.');
INSERT INTO "item_descriptions" VALUES(10058,'pt','Bram estava certo apesar de tudo, você deve tomar cuidado com pessoas excessivamente grandes que andam por aí com maquiagem e com capas compridas e brilhantes.');
INSERT INTO "item_descriptions" VALUES(10061,'pt','Dizem que a própria Condessa Bathory costumava usar estas botas. Conhecendo ela, estas botas devem ser macias e confortáveis... apenas espero que não tenha nenhuma surpresa nelas.');
INSERT INTO "item_descriptions" VALUES(10073,'pt','O legendário Dal-Uk-Went, aquele que unificou o reino Spamnico, tinha um escudo mágico! Sir-Dal, seu neto, forjou cópias para dar de recompensa aos seus melhores guerreiros. Este escudo é uma dessas cópias.');
INSERT INTO "item_descriptions" VALUES(10076,'pt','O legendário Dal-Uk-Went, aquele que unificou o reino Spamnico, concentrou todo o seu poder neste escudo para a infelicidade de seus inimigos. Anos depois, Sir-Dal, seu neto, forjou cópias para dar de recompensa aos seus melhores guerreiros... Mas este é o original e o mais poderoso de todos os escudos.');
INSERT INTO "item_descriptions" VALUES(10102,'pt','Esta máscara irá lhe proteger do sol pelo menos.');
INSERT INTO "item_descriptions" VALUES(10106,'pt','Este monstro assustador e sem remorso suga o sangue de suas vítimas, e você será o próximo se não tomar cuidado. O que ela gosta acima de tudo é de terminar de comer a carne que ainda esteja grudada em qualquer osso que ela encontre. Nós avisamos que ela era assustadora.');
INSERT INTO "item_descriptions" VALUES(10000070,'pt','Este monstro assustador e sem remorso suga o sangue de suas vítimas, e você será o próximo se não tomar cuidado. O que ela gosta acima de tudo é de terminar de comer a carne que ainda esteja grudada em qualquer osso que ela encontre. Nós avisamos que ela era assustadora.');
INSERT INTO "item_descriptions" VALUES(10107,'pt','Este mascote teve uma infância muito difícil e longa, começando pelo seu nome. Talvez isso tudo explique porque ele sempre ataca todos os Ouassingues que vê pela frente.');
INSERT INTO "item_descriptions" VALUES(10125,'pt','Este arco pertenceu a um bandido arqueiro que o usava para finalizar suas vítimas à distância, para não precisar sujar sua roupa. A mágica que dá vida a este item é tão poderosa que pode transformar a mais inocente das pessoas em um destemido bandido arqueiro.');
INSERT INTO "item_descriptions" VALUES(10126,'pt','Esta espada pertenceu a um duelista lendário que não conseguia perseguir seus inimigos. Ele aprendeu a arte da furtividade, e com isso, passou a atacar seus inimigos de surpresa. A mágica que dá vida a este item é tão poderosa que pode transformar a mais inocente das pessoas em um destemido duelista.');
INSERT INTO "item_descriptions" VALUES(10127,'pt','O bandido viajante que possuía este cajado era formidável em suas fugas! Ele usava seu confiável bastão para se apoiar enquanto praticava sua arte preferida - roubar. A mágica que dá vida a este item é tão poderosa que pode transformar a mais inocente das pessoas em um bandido ousado.');
INSERT INTO "item_descriptions" VALUES(10133,'pt','Há muito, muito tempo essa varinha pertenceu a um bandido feiticeiro que o usava para transformar seus inimigos em cinzas. A mágica que dá vida a este item é tão poderosa que pode transformar a mais inocente das pessoas em um destemido bandido feiticeiro.');
INSERT INTO "item_descriptions" VALUES(10155,'pt','Este amuleto lhe protegerá de qualquer perigo que lhe ameace, mas aumenta suas chances de se enforcar por qualquer motivo.');
INSERT INTO "item_descriptions" VALUES(10156,'pt','Estes chinelos são mais confortáveis do que seus calçados de costume, mas é difícil de dizer o porquê... Talvez os parasitas que a infestam massageiam seus pés.');
INSERT INTO "item_descriptions" VALUES(10157,'pt','Este cinto foi feito usando-se as sobras de carretéis de linho. Ele amarra sacos de lixo também.');
INSERT INTO "item_descriptions" VALUES(10158,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10159,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10160,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10161,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10162,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10163,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10164,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10165,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10166,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10167,'pt','Segure ele bem alto e com orgulho! Porque este troféu é tudo o que restará de sua glória depois que você se aposentar.');
INSERT INTO "item_descriptions" VALUES(10168,'pt','Ponch poliu suas botas todas as manhãs antes de montar em seu Dragossauro e sair em missões para salvar viúvas e orfãos. Principalmente viúvas... Ponch era muito charmoso.');
INSERT INTO "item_descriptions" VALUES(10169,'pt','Ponch usou este escudo orgulhosamente enquanto estava montado em seu Dragossauro, garantindo segurança para as ruas de Bonta.');
INSERT INTO "item_descriptions" VALUES(10170,'pt','Este elmo protege muito bem a cabeça do seu usuário caso ele caia de um Dragossauro. Ele tambem faz você parecer um idiota, mesmo se não for.');
INSERT INTO "item_descriptions" VALUES(10171,'pt','Essas luvas de couro sem dedos são perfeitas pra uma surra de primeira-classe.');
INSERT INTO "item_descriptions" VALUES(10172,'pt','Este amuleto irá alimentar uma lesma por dois, ou talvez três dias se acompanhado de um purê em sua cabeça.');
INSERT INTO "item_descriptions" VALUES(10173,'pt','As solas destas botas estão cobertas com uma meleca pegajosa e o interior com uma meleca escorregadia. Pelo menos não é o contrário.');
INSERT INTO "item_descriptions" VALUES(10174,'pt','Os poros nesta capa transpiram uma meleca pegajosa. Você irá parecer superior se deitar de costas e deixá-la carregá-lo pelo chão.');
INSERT INTO "item_descriptions" VALUES(10175,'pt','Este capacete viscoso e úmido irá nutrir seu coro cabeludo e manter seu cabelo brilhante, se não saudáveis. Os dois olhos em seu topo podem ser conectados a seu crânio se você aceitar em inserir as pontas dos nervos em suas orelhas.');
INSERT INTO "item_descriptions" VALUES(10180,'pt','Este medalhão age como chave para uma misteriosa e esquecida cidade.');
INSERT INTO "item_descriptions" VALUES(10181,'pt','Este anel foi encontrado em uma cidade misteriosa onde ninguem sabia de sua existência até que começaram a procurar freneticamente.');
INSERT INTO "item_descriptions" VALUES(10182,'pt','Este escudo irá refletir a luz do sol direto nos olhos de seu oponente. Ao invés de cegá-los com sua incrível sagacidade, cegue-os com esse escudo deslumbrante.');
INSERT INTO "item_descriptions" VALUES(10183,'pt','Essa máscara irá capturar a luz do sol e a concentrar no seu rosto assim você pode ficar atraente e moreno durante o ano todo, mesmo se viver no norte de Amakna.');
INSERT INTO "item_descriptions" VALUES(10184,'pt','Noke adorava colocar essa máscara e se esconder no bosque para assustar os viajantes perdidos. Ela morreu pouco tempo depois de ver seu reflexo em uma poça.');
INSERT INTO "item_descriptions" VALUES(10185,'pt','Noke sonhava em se tornar um grande lobo. Infelizmente, com essa capa, ela se parecia com um dos três porquinhos.');
INSERT INTO "item_descriptions" VALUES(10186,'pt','Esse colar com dentes de javali assustará os javalis e, com sorte, a sua sogra também!');
INSERT INTO "item_descriptions" VALUES(10187,'pt','Há muito tempo atrás, essas adagas foram usadas para acabar com um javali que sonhava em ser um cervo.');
INSERT INTO "item_descriptions" VALUES(10188,'pt','Este capacete foi um equipamento muito útil que o ajudou a traduzir a linguagem de Oxo. É também à prova de som.');
INSERT INTO "item_descriptions" VALUES(10189,'pt','Este anel costumava pertencer ao Rei Oxo. Ele gostava de fazer brincadeiras usando os raios solares refletidos por este anel. Costumava dizer "Olhe os raios lasers de Oxon!"');
INSERT INTO "item_descriptions" VALUES(10190,'pt','Não esqueça de colocar estas botas quando estiver com a cabeça nas nuvens, elas a manterão lá. Sabendo o quão legais elas são, não as use para dançar se quiser se manter com os pés no chão.');
INSERT INTO "item_descriptions" VALUES(10191,'pt','Este cinto é perfeito quando você precisa descansar e digerir seu velho Oxo Bucco.');
INSERT INTO "item_descriptions" VALUES(10223,'pt','This shovel is primarily intended for medical use, despite being used very controversially by the Enutrof known as Resat as a weapon of self defence.');
INSERT INTO "item_descriptions" VALUES(10414,'pt','Esta coroa geralmente é usada no dia da ceia que comemora o aniversário de rainhas ilustres. Seus poderes mágicos são tão fortes que podem mudar a cor da pessoa que a usa para laranja. Isto fará com que fique mais fácil de se esconder entre pessoas vestidas com esta cor.');
INSERT INTO "item_descriptions" VALUES(10544,'pt','Essa criatura de terras distantes foi domada pelo mestre aposentado e só come monstros blop. Talvez isso explique sua estranha aparência e seu hálito de Blop.');
INSERT INTO "item_descriptions" VALUES(10000047,'pt','Essa criatura de terras distantes foi domada pelo mestre aposentado e só come monstros blop. Talvez isso explique sua estranha aparência e seu hálito de Blop.');
INSERT INTO "item_descriptions" VALUES(10552,'pt','Este chapéu irá manter seus ouvidos protegidos contra o frio e piadas ruins.');
INSERT INTO "item_descriptions" VALUES(10553,'pt','Somente um jogador de Gobboliche teria a ideia de se disfarçar de Tofu para intimidar seus oponentes. Esse elmo aerodinâmico permite seu usuário correr como um míssil. Afinal de contas, talvez não seja uma ideia tão ruim assim.');
INSERT INTO "item_descriptions" VALUES(10554,'pt','São os óculos vermelhos que fazem esse elmo se tornar a melhor escolha para qualquer Esportista que se preze.');
INSERT INTO "item_descriptions" VALUES(10555,'pt','Esse imponente escudo carrega a marca de várias vitórias de Gobboliche. Embora tenha uma aparência intimidadora e robusta, ele não apresenta muita utilidade em uma batalha.');
INSERT INTO "item_descriptions" VALUES(10556,'pt','Esse imponente escudo se ajusta perfeitamente à juventude: estilo acima do conteúdo. Não ajudará em nada quando lutar, a menos que o inimigo enfrente você usando um balão.');
INSERT INTO "item_descriptions" VALUES(10557,'pt','Essa luva velha e gasta ajudará você a pegar bolas de Gobboliche, ou qualquer outro item redondo envolto em couro. O que você fará com isso é problema seu...');
INSERT INTO "item_descriptions" VALUES(10558,'pt','Com essas luvas em suas mãos, você poderá fingir que é um jogador famoso de Gobboliche quando estiver jogando com seus Miaus.');
INSERT INTO "item_descriptions" VALUES(10559,'pt','Partidas de Gobboliche são difíceis, e esse cinto foi feito para proteger o jogador de dores musculares. Entretanto, você também pode usá-lo como boia enquanto nada. Mas quem faria isso?');
INSERT INTO "item_descriptions" VALUES(10560,'pt','Algumas pessoas dizem que Gobboliche é um jogo para homens de verdade, assim como esse cinto. Ele tem protetores que amortecem golpes.');
INSERT INTO "item_descriptions" VALUES(10561,'pt','Essas botas já foram usadas por um bom tempo, você pode facilmente sentir o mau cheiro. Vista-as e você se parecerá como um verdadeiro jogador de Gobboliche.');
INSERT INTO "item_descriptions" VALUES(10562,'pt','Botas elegantes alimentam o fascínio dos fãs. Quando essas botas são polidas, elas ajudam nos seus dribles e, certamente, nenhum oponente o alcançará!... Isso tudo, enquanto a torcida grita! Sim, você aprendeu o básico do Gobboliche.');
INSERT INTO "item_descriptions" VALUES(10622,'pt','Essa espada permitiu Grute, o Bwork cortar seus oponentes em dois, o que geralmente é o suficiente pra fazer alguem desistir. Esta arma mágica continua com a personalidade de Grute. Se você a equipar, pode muito bem se tornar ele.');
INSERT INTO "item_descriptions" VALUES(10623,'pt','Grute, o Bwork não era muito esperto. Na verdade, ele era tão estúpido quanto duas tábuas. Felizmente, métodos de ensino tradicionais funcionam igualmente bem em Bworks do que em crianças. Após alguns bem merecidos golpes nas canelas ao longo dos anos, Grute se tornou um verdadeiro bruto.');
INSERT INTO "item_descriptions" VALUES(10624,'pt','Aqueles que tiveram que enfrentar Grute, o Bwork irão dizer "Não mire na cabeça, é vazia". Esse conselho tambem se aplica aqueles que enfrentam Iops, Goblins ou sogras.');
INSERT INTO "item_descriptions" VALUES(10625,'pt','As botas de Grute dão um aroma tão pestilento que você será capaz de derrotar inimigos com apenas um rápido chute em suas cabeças. Essas botas foram proibidas em situações de combate pela Convenção de Sufokia a um longo tempo atrás, uma convença que, pelo visto, salvou muitas, muitas vidas.');
INSERT INTO "item_descriptions" VALUES(10626,'pt','A vida de um soldado raso Chafer não é tão cor-de-rosa quanto você pensava. Apesar que não tenho certeza que você já tenha pensado nisso. Deus sabe que eu mesmo nunca pensei nisso, na vida de um bom, longo, alto, forte, soldado raso Chafer como Koksiks. Na verdade, muitas vezes fico acordado de noite, não pensando na vida de um soldado raso Chafer. Grandes rapazes.');
INSERT INTO "item_descriptions" VALUES(10627,'pt','Esse anel pertenceu ao próprio Koksiks, e é um belo de um anel. Ele me emprestou uma vez... Mas pegou de volta alguns meses depois. Ahh, quando eu penso nisso agora...');
INSERT INTO "item_descriptions" VALUES(10628,'pt','Você deveria ter visto Koksiks com essas botas. Uma visão a se admirar. Dançando. Nós dançamos uma vez, mas isso foi... A muito tempo atrás.');
INSERT INTO "item_descriptions" VALUES(10629,'pt','O soldado de infantaria Chafer Koksiks tinha duas sonhos na vida: escalar a montanha Crackler e se tornar um menestrel em tempo integral. A vida foi muito cruel com ele - ele terminou como apoio de Jon Lemon... Que fez seu nome, e toda sua carreira, tocando em shows de caridade não remunerados.');
INSERT INTO "item_descriptions" VALUES(10630,'pt','Este cajado se parece com uma lança... Na verdade, Goboff o Goblin o usava para cortar a parte de cima de ovos de Tofus Gigantes cozidos, quando esses pássaros existiam. O que ele usava para soldados tostados ninguem sabe. A arma mágica continua com o espírito de Goboff. Se você a equipar, capaz de se tornar ele.');
INSERT INTO "item_descriptions" VALUES(10631,'pt','Um ditado popular entre os goblins é "As vezes você pega o urso, as vezes o urso pega você". Se você olhar a um goblin com atenção, esse ditado é melhor resumido para "As vezes o urso pega você".');
INSERT INTO "item_descriptions" VALUES(10632,'pt','Goboff o Goblin adorava devorar ovos podres. Seu sistema digestiva poderia ser capaz de lider com esse hábito atroz, mas aqueles infelizes que sentiam o seu bafo caiam como Moskitos. Aqueles infelizes que não ficavam inconscientes imediatamente costumavam se segurar em seu cinto para impedi-los de cair no chão.');
INSERT INTO "item_descriptions" VALUES(10633,'pt','Goboff o Goblin era um jardineiro afiado. Ele amava mais do que tudo bater na cabeça de transgressores com seu rodo. Ele encontrou este anel no dedo de um rambler insolente que ousou pisar nas folhas de sua salada.');
INSERT INTO "item_descriptions" VALUES(10634,'pt','Kanniball Lektor usava esta arma para caçar suas presas, e jogar algumas flechas no caminho de seus filhos quando estava afim de brincar. Esta arma ainda contém o espírito de Kanniball Lektor. Se você a equipar, pode se tornar ele.');
INSERT INTO "item_descriptions" VALUES(10635,'pt','Quando as duas pequenas bolas neste amuleto colidem, elas produzem um pequeno som irritante, o que significa que um Kanniball está bem próximo. Quando você escuta este barulho, é normalmente muito tarde pra escapar, mas ainda há tempo para escolher o tempero com o qual você será devorado.');
INSERT INTO "item_descriptions" VALUES(10636,'pt','Este anel está cheio de temperos secretos, usados para dar sabor quando batido a mão. Os temperos são tão gostosos que assim que você colocar o anel na mão, corre o risco de morder seus próprios dedos.');
INSERT INTO "item_descriptions" VALUES(10637,'pt','Kanniball Lektor usou essas botas durante vários anos antes de trocá-las por um turista na Ilha da Lua. A fome justificou os meios.');
INSERT INTO "item_descriptions" VALUES(10638,'pt','O Pândita Stroy Zemol costumava acertar seus adversários com a parte lisa da lâmina de sua arma para nocautea-los sem causar arranhões. Amaldiçoado durante anos com piadas sobre seu nome, o Pândita não queria destruir todos, apenas deixá-los inconscientes por um tempo. Esta arma ainda contém o espírito de Stroy Zemol, e ao equipá-la, você poderia se tornar ele.');
INSERT INTO "item_descriptions" VALUES(10639,'pt','Stroy Zemol tinha uma irmã, Faye Pworme. Ela gostava de viajar sozinha explorando os túneis escuros e fedidos.');
INSERT INTO "item_descriptions" VALUES(10640,'pt','Este cinto é supostamente reversível, só que ninguém nunca ousou experimentá-lo, pois não querem ser os primeiros a descobrir que na verdade não é reversível.');
INSERT INTO "item_descriptions" VALUES(10641,'pt','Stroy Zemol criou estas botas sozinho, com alguns blocos de madeira e um pouco de tecido. Elas podem não parecer com outras botas, mas caramba, elas certamente são mágicas.');
INSERT INTO "item_descriptions" VALUES(10642,'pt','Faye Erdamp, o mineiro negro usava esta picareta para esculpir Kruup, a famosa mina sem fundo, que Gaddie viveu durante anos. Esta arma ainda está com o espírito de Faye Erdamp. Ao equipá-la, você pode se tornar ela.');
INSERT INTO "item_descriptions" VALUES(10643,'pt','Este anel muda de cor quando é mergulhado em caldo de peixe fervente. Isso explica porque Faye Erdamp o mineiro negro o amava tanto.');
INSERT INTO "item_descriptions" VALUES(10644,'pt','As solas dessas botas mágicas permitem que você quebre blocos de carvão criando as vibrações necessárias para quebrá-los. O guia de uso indica que é possível até que elas vibrem sozinhas, se música for tocada por perto.');
INSERT INTO "item_descriptions" VALUES(10645,'pt','Este cinto, reforçado com vários metais diferentes, era forte o bastante para suportar o peso de da enorme carga de Faye Erdamp, o mineiro negro. Ele deve ser tão util quanto para cargas mais leves, como a sua.');
INSERT INTO "item_descriptions" VALUES(10646,'pt','Boo');
INSERT INTO "item_descriptions" VALUES(10657,'pt','Este estranho animal é o resultado da mistura de diversos monstros de Amakna. A sua enorme tromba lhe permite localizar Ogres, mesmo escondidos em regiões aquáticas e levou anos para que Otomai criasse essa monstruosidade. Rez a lenda que Otomai o criou pois havia perdido algo importante e precisava de alguém para encontrar.
O processo de localizar pessoas ou itens é muito desgastante, e por isso, o animal precisa se alimentar da alma de outros montros.
O Caçador só se alimenta de criaturas da Ilha Otomai, pois lá é sua terra natal.');
INSERT INTO "item_descriptions" VALUES(10685,'pt','Equipado com este capacete de ouro, sua cabeça logo estará fazendo dinheiro e valendo seu peso em ouro.');
INSERT INTO "item_descriptions" VALUES(10686,'pt','Esta capa de tecido, revestida com uma fina camada de ouro, é mágica. Ela atrai atenção e reflete luz diretamente nas pupilas de tipinhos desonestos que tentam te apunhalar por trás. Indispensável se você tiver amigos Srams.');
INSERT INTO "item_descriptions" VALUES(10687,'pt','Este anel é tão pesado que aumenta em muitas vezes a inércia de seu punho quando você distribue pancadas em seus oponentes. Quando você começar a punir os camponeses, será praticamente impossível parar.');
INSERT INTO "item_descriptions" VALUES(10688,'pt','Este cinto é ideal para pendurar suas barras de ouro em torno de sua cintura, elas passam despercebidas.');
INSERT INTO "item_descriptions" VALUES(10784,'pt','Ninguem faz a menor idéia de que poderes este amuleto atrás, mas todos sabem o que ele leva: sua credibilidade.');
INSERT INTO "item_descriptions" VALUES(10785,'pt','Você já ouviu falar de Pedra Papel Tesoura, certo? Bem, este anel te protege do Papel.');
INSERT INTO "item_descriptions" VALUES(10794,'pt','Quente por dentro e fria por fora, essas botas irão permitir que você chute traseiros de bonecos de neve sem derreter suas nádegas.');
INSERT INTO "item_descriptions" VALUES(10797,'pt','Retirada de sua bainha, essa espada pode cortar presunto, Enutrofs, homens com uma perna só, dançarinas e Enutrofs dançarinos de uma perna só enrolados em um pedaço de presunto. Infelizmente, é inútil para derrotar monstros.');
INSERT INTO "item_descriptions" VALUES(10798,'pt','Este escudo não o protegerá de sua própria estupidez.');
INSERT INTO "item_descriptions" VALUES(10799,'pt','Tendo problemas em esconder sua adaga em sua cueca? Tudo bem, você pode guardá-la entre suas partes e este cinto!');
INSERT INTO "item_descriptions" VALUES(10800,'pt','Você poderá voar com essa capa em volta de seus ombros. Apenas feche seus olhos, feche seus punhos, abra sua boca, estique seus braços e pule de um penhasco gritando "EU POSSO VOAR!". Momentos depois, você acordará com duas pernas quebradas.');
INSERT INTO "item_descriptions" VALUES(10801,'pt','Este chapéu malfeito esconde sua calvície admiravelmente.
Infelizmente, não é grande o bastante para esconder sua falsa modéstia.');
INSERT INTO "item_descriptions" VALUES(10802,'pt','Mais dourado do que um Dragoone Preto, menos rosa do que um Dragoone Rosa, e mais raro do que um Dragoone Esqueleto, esta mascote irá atrair toda as atenções a você, mesmo se você for tão feio quanto um Piwi. Essa mascote devoradora de almas irá apenas comer os Dopples que podem ser encontrados nos templos de raça.');
INSERT INTO "item_descriptions" VALUES(10000045,'pt','Mais dourado do que um Dragoone Preto, menos rosa do que um Dragoone Rosa, e mais raro do que um Dragoone Esqueleto, esta mascote irá atrair toda as atenções a você, mesmo se você for tão feio quanto um Piwi. Essa mascote devoradora de almas irá apenas comer os Dopples que podem ser encontrados nos templos de raça.');
INSERT INTO "item_descriptions" VALUES(10818,'pt','Com essa arma de aparência básica, você irá sentir que sabe lutar.');
INSERT INTO "item_descriptions" VALUES(10828,'pt','They say sticks and stones may break your bones, but names will never hurt you. With this helmet on, you''ll certainly challenge that misconception...');
INSERT INTO "item_descriptions" VALUES(10830,'pt','Is that a Banana Cape in your pocket or are you just pleased to see me?');
INSERT INTO "item_descriptions" VALUES(10834,'pt','It doesn''t take much to make you look like an Ouginak. Watch out for fleas.');
INSERT INTO "item_descriptions" VALUES(10836,'pt','You wear this amulet proudly, as a symbol of your participation in this great sporting event. You need it to stay proud having been through a scrum with B.C. Trool.');
INSERT INTO "item_descriptions" VALUES(10846,'pt','Driven into a strange frenzy, any Tofus that you meet will want to rub up against your leg. Are you sure it''s the cape that attracts them?');
INSERT INTO "item_descriptions" VALUES(10847,'pt','Alto Dosto colocava essas confortáveis botas em seus amplos pés uma vez por ano, mas as retirava todos os dias, o que sugere que ela seja mágica.');
INSERT INTO "item_descriptions" VALUES(10848,'pt','These boots can also be used as anvils. Their former owner urges you not to dance while wearing them.');
INSERT INTO "item_descriptions" VALUES(10849,'pt','Este cinto é construído em torno de uma armação metálica magnética que atrai as bolsas dos descuidados para você');
INSERT INTO "item_descriptions" VALUES(10850,'pt','Klume had three weaknesses: Arachnees, being tickled, and tickly Arachnees.');
INSERT INTO "item_descriptions" VALUES(10851,'pt','This belt is still covered in flour, perhaps because Kloug the Dark Baker used it as an apron. Mind you, it might not be flour, it could be the powder he uses to soothe his embarrassing rash.');
INSERT INTO "item_descriptions" VALUES(10852,'pt','Alto Dosto roubou este amuleto de Ted Gonztipay, um sujeito sem absolutamente nenhum senso de humor.');
INSERT INTO "item_descriptions" VALUES(10853,'pt','This amulet allows you to knead the skin on your neck without using your hands.');
INSERT INTO "item_descriptions" VALUES(10854,'pt','Gontran Klume the smith traded a sword belonging to Dame Antium for this ring.');
INSERT INTO "item_descriptions" VALUES(10855,'pt','This ring has been dipped in a multitude of different yeasts. It is said that it is capable of transforming those who wear it into mould. Some adventurers don''t see any difference after slipping it on.');
INSERT INTO "item_descriptions" VALUES(10856,'pt','Hulkrap was a terrible bandit riddled with remorse, and felt obliged to give back what he''d stolen. This magical weapon is still imbued with the soul of Hulkrap the Bandit. You may be able to become him if you equip it.');
INSERT INTO "item_descriptions" VALUES(10857,'pt','This hammer was used to forge a Kriptonit zipper for Captain Chafer. This magical weapon is still imbued with the spirit of the Dark Smith Klume. By equipping it, you may be able to embody him.');
INSERT INTO "item_descriptions" VALUES(10858,'pt','Kloug liked to make himself appear generous by handing out bread to those who dared to speak to him. He used this wand to judge and punish the innocent. This weapon is still imbued with the magic of the Kloug the Dark Baker. You may be able to successfully embody him by equipping this weapon.');
INSERT INTO "item_descriptions" VALUES(10863,'pt','Tarzantula é incrivelmente mal comportada, ela pula por todos os lados, grita o tempo todo e morde qualquer um que encontra - mas você a ama do mesmo jeito, mesmo sem saber o porquê. Mãe Natureza a abençoou com um apetite voraz, e assim essa devoradora de almas adora comer Mosquitos e Larvas.');
INSERT INTO "item_descriptions" VALUES(10000068,'pt','Tarzantula é incrivelmente mal comportada, ela pula por todos os lados, grita o tempo todo e morde qualquer um que encontra - mas você a ama do mesmo jeito, mesmo sem saber o porquê. Mãe Natureza a abençoou com um apetite voraz, e assim essa devoradora de almas adora comer Mosquitos e Larvas.');
INSERT INTO "item_descriptions" VALUES(10864,'pt','Esse Cogu Cogu único foi criado por uma alcatéia de Boolobos, o que ainda não explica o motivo dele ter axilas tão peludas. Esse devorador de almas adora frutos do mar, e irá comer apenas criaturas da praia.');
INSERT INTO "item_descriptions" VALUES(10000064,'pt','Esse Cogu Cogu único foi criado por uma alcatéia de Boolobos, o que ainda não explica o motivo dele ter axilas tão peludas. Esse devorador de almas adora frutos do mar, e irá comer apenas criaturas da praia.');
INSERT INTO "item_descriptions" VALUES(10865,'pt','Tofulia foi atingida por raios 11 vezes enquanto crescia. Você irá tomar um choque sempre que encostar nela, e ela irá lhe dar um choque se não encostar nela. Cabe a você escolher. Esse devorador de almas detesta ratos, e irá avançar neles sempre que tiver a chance de comer.');
INSERT INTO "item_descriptions" VALUES(10866,'pt','Sting, o Prespic, adora alcachofras com sangue de Bherb, ama cabelo de Pikoko e as músicas de Jon Lemon. Ele parece gostar de sua companhia tambem. Esse devorador de almas devora apenas as criaturas da Selva Escura.');
INSERT INTO "item_descriptions" VALUES(10000067,'pt','Sting, o Prespic, adora alcachofras com sangue de Bherb, ama cabelo de Pikoko e as músicas de Jon Lemon. Ele parece gostar de sua companhia tambem. Esse devorador de almas devora apenas as criaturas da Selva Escura.');
INSERT INTO "item_descriptions" VALUES(10899,'pt','The Manitou Zoth was a former stevedore - he moved problems instead of solving them. In spite of that, the Zoth community were scared of him because he shouted louder than all the others, which was enough to make him the Zoth chief. This staff is still animated by his spirit. You may be able to successfully embody it if you equip this weapon.');
INSERT INTO "item_descriptions" VALUES(10904,'pt','Você ganhou este amuleto graças a sua incomparável capacidade em quebrar ovos sem fazer um omelete.');
INSERT INTO "item_descriptions" VALUES(10906,'pt','Criado a partir de uma das escamas do Grozilla, este é um escudo pesado com uma estatura excepcional. Apenas raros e temíveis lutadores podem usá-lo com orgulho.');
INSERT INTO "item_descriptions" VALUES(10907,'pt','Bem, ai está. Você conseguiu: Fez parte do maior exercício de controle de nascimento de dragões de todos os tempos. Como resultado, deverá comer omeletes durante todas as próximas semanas.');
INSERT INTO "item_descriptions" VALUES(10922,'pt','Este escudo mostra a todos os outros aventureiros que você foi um pioneiro em sua profissão.');
INSERT INTO "item_descriptions" VALUES(10923,'pt','Este escudo mostra a todos os outros aventureiros que você foi um pioneiro em sua profissão.');
INSERT INTO "item_descriptions" VALUES(10924,'pt','Este escudo mostra a todos os outros aventureiros que você foi um pioneiro em sua profissão.');
INSERT INTO "item_descriptions" VALUES(10925,'pt','Este escudo mostra a todos os outros aventureiros que você foi um pioneiro em sua profissão.');
INSERT INTO "item_descriptions" VALUES(10926,'pt','Este escudo mostra a todos os outros aventureiros que você foi um pioneiro em sua profissão.');
