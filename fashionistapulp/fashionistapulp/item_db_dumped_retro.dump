INSERT INTO "item_descriptions" VALUES(7076,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen. Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
INSERT INTO "item_descriptions" VALUES(7077,'de','Dieser gelbe, saugfähige Schild mit vielen Poren wurde aus den Überresten eines Tieres gefertigt, welches sich in einer Maskananas am Meeresgrunde verkrochen hatte.');
INSERT INTO "item_descriptions" VALUES(7078,'de','Dieser gute Schild hat einige Gefechte zuviel mitgemacht. In seinem Zustand ist er zu nichts mehr zu gebrauchen Aber vielleicht könnte Bouwada aus Pandala ihn wieder herrichten?');
