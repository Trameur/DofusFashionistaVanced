INSERT INTO "item_descriptions" VALUES(10000020,'pt','Soldado de brinquedo aposentado, esta criatura de metal ganhou vida. Ele o seguirá por todos os lugares e se arriscará para protegê-lo se você apenas se dar ao trabalho de lhe dar algo para comer regularmente. Mas não pense que ele levará golpes em seu lugar... ele não substituirá os novatos aventureiros de Astrub.');
INSERT INTO "item_descriptions" VALUES(7522,'pt','Você pode se aproximar deste bebê Minotoro, domesticado e limpo, e acariciá-lo sem pôr suas mãos em risco. Entretanto, permaneça prudente, às vezes, a natureza pode tomar conta dele. Portanto, o instinto destrutivo desta criatura pode retornar quando você menos esperar. Para evitar surpresas ruins, crie-o como você criaria seus próprios filhos, ou seja, batendo neles com gravetos.');
INSERT INTO "item_descriptions" VALUES(7523,'pt','Nenhum gato consegue resistir a esta adorável criatura de gengibre... nem mesmo o mais entediado deles!
(ESTE LENDÁRIO ANIMAL DE ESTIMAÇÃO NÃO PRECISA COMER).');
INSERT INTO "item_descriptions" VALUES(7524,'pt','Esta surpreendente criatura é o resultado do cruzamento entre um Miau Branco e um Miau Preto.');
INSERT INTO "item_descriptions" VALUES(7552,'pt','Às vezes, quando o verdadeiro amor une um guerreiro a um Dragossauro, coisas estranhas podem acontecer. Esta capa prova isto, já que possui asas de Dragossauro costuradas nela. O Dragossauro se sacrificou para a fabricação desta capa, oferecendo-a ao famoso trovador Pol Akartney no dia do casamento deles. Aparentemente, Jony Lenon até escreveu uma canção sobre isto.');
INSERT INTO "item_descriptions" VALUES(7553,'pt','Se você já sonhou parecer um Dragossauro, esta é sua oportunidade! Entretanto, se você quiser permanecer saudável, aconselhamos você a não usar este chapéu nas ruas de Amakna durante a época de Natal.');
INSERT INTO "item_descriptions" VALUES(7554,'pt','Seus amigos definitivamente ficarão com ciúmes. Estas botas o levarão à festa do embaixador para conseguir um daqueles maravilhosos chocolatinhos dourados.');
INSERT INTO "item_descriptions" VALUES(7555,'pt','Com este anel, seus amigos dirão de você ‘Ela é a tal perua''.');
INSERT INTO "item_descriptions" VALUES(7559,'pt','A lenda diz que o primeiro dono deste cinto costumava girar e girar toda vez que ele o colocava.');
INSERT INTO "item_descriptions" VALUES(7581,'pt','Essa mochila parece um abacaxi mágico, e talvez seja mesmo um abacaxi mágico transformado em mochila por alguma razão desconhecida. Isso já aconteceu antes...
Diferentemente da mochila de Cenouwawa, a Abacachila não é tão espaçosa, portanto você não pode colocar qualquer coisa nela. Além disso, ela é bem pesada.');
INSERT INTO "item_descriptions" VALUES(7650,'pt','Este martelo permite que o marceneiro faça uma ampla variedade de itens.');
INSERT INTO "item_descriptions" VALUES(7680,'pt','Este capacete não é nada além de um pedaço da cabeça de Ougaa. Ele era uma grande divindade venerada pelos Porcos. Acolchoado com tecido, penas e lã, qualquer um pode usar este capacete, desde que possa aguentar o cheio e o peso.');
INSERT INTO "item_descriptions" VALUES(7702,'pt','Este Au-au é diferente de todos os outros. Ele foi criado para caçar. O extraordinário nariz dele o ajudará a encontrar as maiores caças ou ajudará as maiores caças a te encontrarem.');
INSERT INTO "item_descriptions" VALUES(7703,'pt','Este pássaro negro é especialmente famoso pelo seu amor por cemitérios e por aventureiros de pele branca. Ele adora quebrar ossos que encontra em túmulos com seu enorme bico.');
INSERT INTO "item_descriptions" VALUES(10000004,'pt','Este pássaro negro é especialmente famoso pelo seu amor por cemitérios e por aventureiros de pele branca. Ele adora quebrar ossos que encontra em túmulos com seu enorme bico.');
INSERT INTO "item_descriptions" VALUES(7704,'pt','Este esquilo é um verdadeiro quebra-nozes. Deve-se admitir que isto possa ser tanto útil quanto doloroso.');
INSERT INTO "item_descriptions" VALUES(7705,'pt','Esta esplêndida criatura é parente do famoso Lenalds da Ilha dos Wabbits. Mais precipitada e incontrolável, ela lhe ajudará durante suas lutas e provará ser bastante traiçoeira se você não a tratar bem.');
INSERT INTO "item_descriptions" VALUES(7706,'pt','Bilby, um apelido vindo do seu verdadeiro nome, Bilbiblabaloo, é uma pequena geléia à procura de aventura. Particularmente presa a Vald, tem notáveis poderes (pelo menos, proporcionais ao seu tamanho). Esse animal de estimação só come flores.');
INSERT INTO "item_descriptions" VALUES(7707,'pt','Este javalizinho tem um focinho adaptado para procurar frutos de carvalho grandes. Por sorte, consegue achar facilmente.');
INSERT INTO "item_descriptions" VALUES(7708,'pt','Este pequeno Piwi não é como os outros. Basta dar uma olhada para a cor dele para que isto fique claro. Entretanto, ele parece compartilhar com os outros o mesmo interesse em bicar traseiros. Diz o rumor que algumas pessoas realmente gostam disto...');
INSERT INTO "item_descriptions" VALUES(10000007,'pt','Este pequeno Piwi não é como os outros. Basta dar uma olhada para a cor dele para que isto fique claro. Entretanto, ele parece compartilhar com os outros o mesmo interesse em bicar traseiros. Diz o rumor que algumas pessoas realmente gostam disto...');
INSERT INTO "item_descriptions" VALUES(7709,'pt','Este pequeno Piwi não é como os outros. Um simples olhar na sua cor e tudo fica claro. No entanto, ele parece compartilhar com os outros o mesmo interesse em bicar o traseiro. Dizem que há pessoas que são iguais a eles...');
INSERT INTO "item_descriptions" VALUES(10000086,'pt','Este pequeno Piwi não é como os outros. Um simples olhar na sua cor e tudo fica claro. No entanto, ele parece compartilhar com os outros o mesmo interesse em bicar o traseiro. Dizem que há pessoas que são iguais a eles...');
INSERT INTO "item_descriptions" VALUES(7710,'pt','Este pequeno Piwi não é como os outros. Uma simples olhada para a sua cor deixará isso claro. No entanto, ele parece compartilhar com os outros o mesmo interesse de bicar bundas. Dizem que algumas pessoas até gostam disso...');
INSERT INTO "item_descriptions" VALUES(7711,'pt','Este pequeno Piwi não é como os outros. Uma simples olhada na cor e isto fica claro. Entretanto, parece compartilhar com os outros o mesmo interesse em bicar. Dizem que algumas pessoas gostam disso...');
INSERT INTO "item_descriptions" VALUES(10000062,'pt','Este pequeno Piwi não é como os outros. Uma simples olhada na cor e isto fica claro. Entretanto, parece compartilhar com os outros o mesmo interesse em bicar. Dizem que algumas pessoas gostam disso...');
INSERT INTO "item_descriptions" VALUES(7712,'pt','Este pequeno Piwi não é como os outros. Uma simples olhada em sua cor deixa isso claro. Entretanto, ele parece compartilhar com os outros o mesmo interesse em bicar. Dizem que algumas pessoas gostam disso...');
INSERT INTO "item_descriptions" VALUES(10000046,'pt','Este pequeno Piwi não é como os outros. Uma simples olhada em sua cor deixa isso claro. Entretanto, ele parece compartilhar com os outros o mesmo interesse em bicar. Dizem que algumas pessoas gostam disso...');
INSERT INTO "item_descriptions" VALUES(7713,'pt','Este pequeno Piwi não é como os outros. Uma simples olhada na cor e isto fica claro. Entretanto, parece compartilhar com os outros o mesmo interesse em bicar. Dizem que algumas pessoas gostam disso...');
INSERT INTO "item_descriptions" VALUES(7714,'pt','Diz o rumor que esta tartaruga foi levantada por um Mestre nas Artes Marciais que parecia um Rato de Esgoto. Se alimentá-la com peixe, ela será boa com você e o ajudará a curar aventureiros feridos. Se alimentá-la com carne, ela ficará agressiva e o ajudará a lutar contra seus inimigos.');
INSERT INTO "item_descriptions" VALUES(7753,'pt','Esta varinha mágica vem diretamente das profundezas mais quentes da Terra. A pessoa que irá manejá-la, deveria se precaver contra violentas explosões.');
INSERT INTO "item_descriptions" VALUES(7754,'pt','Posto por Terrakourial, o Dragão da Terra, este Dofus concentra consideráveis poderes e não devia ser confiado a ninguém.');
INSERT INTO "item_descriptions" VALUES(7806,'pt','Este certificado o autoriza a pegar a sua montaria em um celeiro.
Atenção! Este certificado só é válido por 20 dias. Uma vez que o prazo terminar, sua montaria será solta na natureza e o certificado não será mais válido. Você não será capaz de recuperar a sua montaria. Não se esqueça de deixá-la em um celeiro, se for se ausentar por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7807,'pt','Este certificado autoriza a usar a montaria do curral. Aviso! Este certificado só é válido durante 20 dias. Uma vez expirado, sua montaria será retomada e seu certificado não terá mais validade. Você não poderá mais montar. Não se esqueça de deixar a sua montaria num curral se for sair por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7808,'pt','Este certificado lhe autoriza a pegar sua montaria em um celeiro.
Atenção! Este certificado só será válido por 20 dias. Uma vez que o prazo terminar, sua montaria será solta na natureza e o certificado não será mais válido. Você não será capaz de recuperar sua montaria. Não se esqueça de deixar sua montaria em um celeiro se você for se ausentar por muito tempo.');
INSERT INTO "item_descriptions" VALUES(7809,'pt','Este certificado autoriza a usar a montaria do curral. Aviso! Este certificado só é válido durante 20 dias. Uma vez expirado, sua montaria será pego de volta e seu certificado não terá mais validade. Você não poderá mais montar. Não se esqueça de deixar a sua montaria num curral se for sair por muito tempo.');
