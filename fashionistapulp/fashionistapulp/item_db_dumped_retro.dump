INSERT INTO "item_descriptions" VALUES(1125,'es','Este arco poco convencional fue especialmente diseñado por el autoproclamado rey de un pueblo de campesinos. A este rey le encantaba hacerse el graciosillo disparando dos flechas a la vez.');
INSERT INTO "item_descriptions" VALUES(1126,'es','Este arco poco convencional fue especialmente diseñado por el autoproclamado rey de un pueblo de campesinos. A este rey le encantaba hacerse el graciosillo disparando dos flechas a la vez.');
