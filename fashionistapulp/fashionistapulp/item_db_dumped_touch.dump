INSERT INTO "item_descriptions" VALUES(12688,'de','Diese Trophäe erhöht den angerichteten Luftschaden. So könnt ihr eurem Gegner den Chaossatz mit dem Flügelschlag und den dadurch ausgelösten Hurrikan anschaulich beweisen.');
INSERT INTO "item_descriptions" VALUES(12689,'en','This Trophy increases Water attack damage, but it won''t help you turn water into wine.');
INSERT INTO "item_descriptions" VALUES(12689,'fr','Ce Trophée augmente les dommages d''élément Eau mais il reste inutile si vous désirez mettre de l''eau dans votre vin.');
INSERT INTO "item_descriptions" VALUES(12689,'es','Este trofeo aumenta los daños del elemento agua, pero no vale de nada si te ahogas en un vaso.');
INSERT INTO "item_descriptions" VALUES(12689,'pt','Esse troféu aumenta os danos de ataque de Água, mas não transforma água em vinho.');
INSERT INTO "item_descriptions" VALUES(12689,'de','Diese Trophäe erhöht den angerichteten Wasserschaden. So könnt ihr eurem Gegner anschaulich beweisen, wie nah ihr am Wasser gebaut seid.');
