INSERT INTO "item_descriptions" VALUES(13772,'en','This Trophy helps you keep your feet on the ground. Warning: can prove painful if used in conjunction with a flying mount.');
INSERT INTO "item_descriptions" VALUES(13772,'fr','Ce Trophée vous permettra de toujours garder les pieds sur terre. Peut provoquer de terribles douleurs si vous utilisez une monture volante.');
INSERT INTO "item_descriptions" VALUES(13772,'es','Con este trofeo tendrás siempre los pies sobre la tierra. No obstante, te dolerá si utilizas una montura voladora.');
INSERT INTO "item_descriptions" VALUES(13772,'pt','Esse troféu faz com que você mantenha sempre os pés no chão. Atenção: ele poderá provocar dores terríveis se você utilizar uma montaria voadora.');
INSERT INTO "item_descriptions" VALUES(13772,'de','Mit dieser Trophäe bleibt ihr stets fest mit beiden Beinen auf der Erde. Solltet ihr jedoch ein fliegendes Reittier benutzen, bezahlt ihr dies mit unerträglichen Schmerzen.');
INSERT INTO "item_descriptions" VALUES(13773,'en','This Trophy helps you keep your feet on the ground. Warning: can prove painful if used in conjunction with a flying mount.');
INSERT INTO "item_descriptions" VALUES(13773,'fr','Ce Trophée vous permettra de toujours garder les pieds sur terre. Peut provoquer de terribles douleurs si vous utilisez une monture volante.');
INSERT INTO "item_descriptions" VALUES(13773,'es','Con este trofeo tendrás siempre los pies sobre la tierra. No obstante, te dolerá si utilizas una montura voladora.');
INSERT INTO "item_descriptions" VALUES(13773,'pt','Esse troféu faz com que você mantenha sempre os pés no chão. Atenção: ele poderá provocar dores terríveis se você utilizar uma montaria voadora.');
INSERT INTO "item_descriptions" VALUES(13773,'de','Mit dieser Trophäe bleibt ihr stets fest mit beiden Beinen auf der Erde. Solltet ihr jedoch die Fliege machen wollen, bezahlt ihr das mit unerträglichen Schmerzen.');
INSERT INTO "item_descriptions" VALUES(13774,'en','This Trophy helps you keep your feet on the ground. Warning: can prove painful if used in conjunction with a flying mount.');
