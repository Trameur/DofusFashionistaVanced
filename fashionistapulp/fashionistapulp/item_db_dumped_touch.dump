INSERT INTO "item_descriptions" VALUES(13778,'en','This Trophy helps you hold your own in the line of fire.');
INSERT INTO "item_descriptions" VALUES(13778,'fr','Ce Trophée vous permettra de mettre le feu au lac.');
INSERT INTO "item_descriptions" VALUES(13778,'es','Con este trofeo podrás decir que si alguien juego contigo, seguro que se va a quemar.');
INSERT INTO "item_descriptions" VALUES(13778,'pt','Com esse troféu, você vai poder ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(13778,'de','Dank dieser Trophäe seid ihr Feuer und Flamme.');
