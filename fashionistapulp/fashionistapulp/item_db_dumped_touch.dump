INSERT INTO "item_descriptions" VALUES(12649,'en','This Trophy will protect you from Air attacks, but not from Air spray.');
INSERT INTO "item_descriptions" VALUES(12649,'fr','Ce Trophée protège des attaques d''élément Air mais pas des courants d''air.');
INSERT INTO "item_descriptions" VALUES(12649,'es','Con este trofeo te protegerás de los ataques de elemento aire pero no de las corrientes de aire.');
INSERT INTO "item_descriptions" VALUES(12649,'pt','Esse troféu protege você contra ataques aéreos, mas não contra passarinhos.');
INSERT INTO "item_descriptions" VALUES(12649,'de','Diese Trophäe schützt euch vor allen Luftangriffen, aber nicht vor der Erkältungsgefahr bei Luftzügen.');
INSERT INTO "item_descriptions" VALUES(12650,'en','This Trophy will protect you from Air attacks, but not from Air spray.');
INSERT INTO "item_descriptions" VALUES(12650,'fr','Ce Trophée protège des attaques d''élément Air mais pas des courants d''air.');
INSERT INTO "item_descriptions" VALUES(12650,'es','Con este trofeo te protegerás de los ataques de elemento aire pero no de las corrientes de aire.');
INSERT INTO "item_descriptions" VALUES(12650,'pt','Esse troféu protege você contra ataques aéreos, mas não contra passarinhos.');
