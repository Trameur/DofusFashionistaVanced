INSERT INTO "item_descriptions" VALUES(12725,'en','This trophy increases Vitality. Its effects against impotence have never been proven.');
INSERT INTO "item_descriptions" VALUES(12725,'fr','Ce Trophée permet d''augmenter la Vitalité. Ses effets contre l''impuissance n''ont jamais pu être prouvés.');
INSERT INTO "item_descriptions" VALUES(12725,'es','Con este trofeo podrás aumentar la vitalidad. Aviso: sus efectos contra la impotencia nunca han sido demostrados.');
INSERT INTO "item_descriptions" VALUES(12725,'pt','Esse troféu aumenta a sua Vitalidade. Seus efeitos contra a impotência nunca foram provados.');
INSERT INTO "item_descriptions" VALUES(12725,'de','Diese Trophäe erhöht eure Vitalität. Leider hat sich die durchschnittliche Lebenserwartung der Abenteurer trotz dieser Trophäen nicht nennenswert verbessert.');
