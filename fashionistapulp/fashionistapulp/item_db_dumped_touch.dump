INSERT INTO "item_descriptions" VALUES(19401,'en','That playground bully who destroyed your sand castle traumatised you for life. Time for payback.');
INSERT INTO "item_descriptions" VALUES(19401,'fr','Cette terreur des bacs à sable qui avait écrasé votre château d''un poing vengeur vous a traumatisé à vie. Le temps est venu de lui faire payer cet affront.');
INSERT INTO "item_descriptions" VALUES(19401,'es','Aquel diablillo de los parques de arena que un día te chafó tu castillo de un puñetazo por pura malicia te traumatizó de por vida. Ha llegado el momento de vengarte por esta afrenta.');
INSERT INTO "item_descriptions" VALUES(19401,'pt','Aquele valentão do parquinho que destruiu seu castelo de areia o deixou traumatizado. Chegou a hora da vingança.');
INSERT INTO "item_descriptions" VALUES(19401,'de','Dieser Sandkasten-Schreck, der eure Sandburg mit einem vergeltenden Faustschlag zerstört hatte, hat euch fürs Leben traumatisiert. Es ist an der Zeit, ihn für diese Gemeinheit bezahlen zu lassen.');
INSERT INTO "item_descriptions" VALUES(19403,'en','That playground bully who destroyed your sand castle traumatised you for life. Time for payback.');
