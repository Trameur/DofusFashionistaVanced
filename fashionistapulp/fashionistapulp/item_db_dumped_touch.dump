INSERT INTO "item_descriptions" VALUES(19335,'en','Solid, but not unbreakable. That''s how your allies will describe you just before breaking your two big toes after your latest terrible joke.');
INSERT INTO "item_descriptions" VALUES(19335,'fr','Solide mais pas incassable. C''est avec ces mots que vos alliés vous décrivirent juste avant de vous casser les deux gros orteils suite à une mauvaise blague.');
INSERT INTO "item_descriptions" VALUES(19335,'es','Sólido, pero no irrompible: con esas palabras te describieron tus aliados justo antes de partirte los dedos gordos de los pies después de que soltaras un chiste malísimo.');
INSERT INTO "item_descriptions" VALUES(19335,'pt','Sólido, mas não inquebrável. É com estas palavras que seus aliados descrevem você logo antes de quebrar seus dois dedões do pé por causa de uma piada de mau gosto.');
INSERT INTO "item_descriptions" VALUES(19335,'de','Robust, aber nicht unkaputtbar. Genauso beschrieben euch eure Verbündeten, bevor sie euch nach einem schlechten Witz die beiden großen Zehen brachen.');
INSERT INTO "item_descriptions" VALUES(19337,'en','Solid, but not unbreakable. That''s how your allies will describe you just before breaking your two big toes after your latest terrible joke.');
