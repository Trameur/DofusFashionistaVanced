INSERT INTO "item_descriptions" VALUES(19347,'en','There''s no shame in fleeing when there''s no chance of winning.');
INSERT INTO "item_descriptions" VALUES(19347,'fr','Il n''y a aucune honte à fuir... lorsque l''on n''a aucune chance de gagner.');
INSERT INTO "item_descriptions" VALUES(19347,'es','Huir no es ninguna deshonra... cuando no hay posibilidad de ganar.');
INSERT INTO "item_descriptions" VALUES(19347,'pt','Não há vergonha alguma em fugir... quando não há a menor chance de vencer.');
INSERT INTO "item_descriptions" VALUES(19347,'de','Es ist keine Schande zu fliehen ... wenn es keine Chance auf Erfolg gibt.');
INSERT INTO "item_descriptions" VALUES(19349,'en','There''s no shame in fleeing when there''s no chance of winning.');
