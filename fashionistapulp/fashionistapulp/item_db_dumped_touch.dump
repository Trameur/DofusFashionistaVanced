INSERT INTO "item_descriptions" VALUES(12697,'de','Diese Trophäe erhöht den angerichteten Neutralschaden. Manchmal kann bei der Haltung "Ich bleib neutral" eben großer Schaden angerichtet werden!');
INSERT INTO "item_descriptions" VALUES(12698,'en','This Trophy increases Earth attack damage. Only Earthworms are impressed by this.');
INSERT INTO "item_descriptions" VALUES(12698,'fr','Ce Trophée augmente les dommages d''élément Terre. Seuls les vers de Terre seront impressionnés.');
INSERT INTO "item_descriptions" VALUES(12698,'es','Este trofeo aumenta los daños del elemento tierra. Solo impresionarás a los gusanos de tierra.');
INSERT INTO "item_descriptions" VALUES(12698,'pt','Esse troféu aumenta os danos de ataque da Terra. Apenas minhocas se impressionam com isso.');
INSERT INTO "item_descriptions" VALUES(12698,'de','Diese Trophäe erhöht den angerichteten Erdschaden. Die Regenwürmer werden beeindruckt sein!');
INSERT INTO "item_descriptions" VALUES(12701,'en','This Trophy increases Initiative instead of taking it.');
INSERT INTO "item_descriptions" VALUES(12701,'fr','Ce Trophée permet d''augmenter l''initiative à défaut d''en prendre.');
INSERT INTO "item_descriptions" VALUES(12701,'es','Este trofeo aumenta la iniciativa salvo que ya la tengas.');
INSERT INTO "item_descriptions" VALUES(12701,'pt','Esse troféu aumenta a iniciativa em vez de diminuí-la.');
INSERT INTO "item_descriptions" VALUES(12701,'de','Diese Trophäe erhöht eure Initiative selbst dann, wenn ihr nicht die Initiative ergreift.');
INSERT INTO "item_descriptions" VALUES(12702,'en','This Trophy increases Initiative instead of taking it.');
INSERT INTO "item_descriptions" VALUES(12702,'fr','Ce Trophée permet d''augmenter l''initiative à défaut d''en prendre.');
INSERT INTO "item_descriptions" VALUES(12702,'es','Este trofeo aumenta la iniciativa salvo que ya la tengas.');
INSERT INTO "item_descriptions" VALUES(12702,'pt','Esse troféu aumenta a iniciativa em vez de diminuí-la.');
INSERT INTO "item_descriptions" VALUES(12702,'de','Diese Trophäe erhöht eure Initiative selbst dann, wenn ihr nicht die Initiative ergreift.');
