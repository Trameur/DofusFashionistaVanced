INSERT INTO "item_descriptions" VALUES(12695,'en','This Trophy increases Neutral attack damage. It was invented by a famous ogre: Pete Aitchnutrool.');
INSERT INTO "item_descriptions" VALUES(12695,'fr','Ce trophée augmente les dommages d''élément Neutre. Il a été imaginé par un célèbre forgeur de hache : Giuseppe Hacheneutre.');
INSERT INTO "item_descriptions" VALUES(12695,'es','Este trofeo aumenta los daños del elemento neutral. Fue ideado por un célebre forjador de hachas: Pepe Hacheneutro');
INSERT INTO "item_descriptions" VALUES(12695,'pt','Esse troféu aumenta os danos de ataque Neutros. Ele foi inventado por um ogro famoso: Pete Aitchnutrool.');
INSERT INTO "item_descriptions" VALUES(12695,'de','Diese Trophäe erhöht den angerichteten Neutralschaden. Manchmal kann bei der Haltung "Ich bleib neutral" eben großer Schaden angerichtet werden!');
INSERT INTO "item_descriptions" VALUES(12696,'en','This Trophy increases Neutral attack damage. It was invented by a famous ogre: Pete Aitchnutrool.');
INSERT INTO "item_descriptions" VALUES(12696,'fr','Ce trophée augmente les dommages d''élément Neutre. Il a été imaginé par un célèbre forgeur de hache : Giuseppe Hacheneutre.');
INSERT INTO "item_descriptions" VALUES(12696,'es','Este trofeo aumenta los daños del elemento neutral. Fue ideado por un célebre forjador de hachas: Pepe Hacheneutro');
INSERT INTO "item_descriptions" VALUES(12696,'pt','Esse troféu aumenta os danos de ataque Neutros. Ele foi inventado por um ogro famoso: Pete Aitchnutrool.');
