INSERT INTO "item_descriptions" VALUES(12715,'en','This Trophy increases your Chance. It doesn''t seem to have any effect when you use cheesy chat-up lines though.');
INSERT INTO "item_descriptions" VALUES(12715,'fr','Ce Trophée permet d''augmenter sa Chance. Il ne semble pas fonctionner pour les tentatives de séduction désespérées.');
INSERT INTO "item_descriptions" VALUES(12715,'es','Con este trofeo podrás aumentar la suerte. No se han observado buenos resultados en los intentos desesperados de ligoteo.');
INSERT INTO "item_descriptions" VALUES(12715,'pt','Esse troféu aumenta a sua Chance. Mas não parece ter nenhum outro efeito quando você digita coisas bregas nos bate-papos.');
INSERT INTO "item_descriptions" VALUES(12715,'de','Diese Trophäe erhöht euer Glück. Leider gilt dies scheinbar nur fürs Spiel und nicht in der Liebe...');
