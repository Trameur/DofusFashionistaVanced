INSERT INTO "item_descriptions" VALUES(12712,'en','This trophy increases your Agility. You''re finally going to be able to climb on your high horse without falling off.');
INSERT INTO "item_descriptions" VALUES(12712,'fr','Ce Trophée permet d''augmenter son Agilité. Vous allez enfin réussir à monter sur une échelle sans tomber.');
INSERT INTO "item_descriptions" VALUES(12712,'es','Con este trofeo podrás aumentar la agilidad. Por fin vas a poder subirte a una escalera sin caerte.');
INSERT INTO "item_descriptions" VALUES(12712,'pt','Esse troféu aumenta a sua Agilidade. Você vai finalmente conseguir subir em seu cavalo sem levar um tombo.');
INSERT INTO "item_descriptions" VALUES(12712,'de','Diese Trophäe erhöht eure Flinkheit. Das heißt, ihr stolpert jetzt noch schneller als vorher über eure eigenen Füße!');
