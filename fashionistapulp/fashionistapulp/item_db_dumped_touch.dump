INSERT INTO "item_descriptions" VALUES(8222,'pt','Este anel permitirá que o seu amado a encontre, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8222,'de','Dank dieses Rings wird eure Mätresse euch finden können, wo auch immer ihr euch gerade aufhaltet.');
