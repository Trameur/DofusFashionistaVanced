INSERT INTO "item_descriptions" VALUES(13774,'es','Con este trofeo tendrás siempre los pies sobre la tierra. No obstante, te dolerá si utilizas una montura voladora.');
INSERT INTO "item_descriptions" VALUES(13774,'pt','Esse troféu faz com que você mantenha sempre os pés no chão. Atenção: ele poderá provocar dores terríveis se você utilizar uma montaria voadora.');
INSERT INTO "item_descriptions" VALUES(13774,'de','Mit dieser Trophäe bleibt ihr stets fest mit beiden Beinen auf der Erde. Solltet ihr jedoch ein fliegendes Reittier benutzen, bezahlt ihr dies mit unerträglichen Schmerzen.');
INSERT INTO "item_descriptions" VALUES(13775,'en','This Trophy allows you to keep your face utterly expressionless as you decimate the enemy.');
INSERT INTO "item_descriptions" VALUES(13775,'fr','Le Rube ou la Pandrista ? Ce Trophée ne vous aidera pas à prendre une décision.');
INSERT INTO "item_descriptions" VALUES(13775,'es','¿El guesfguiado o la Pandrista? En cualquier caso, este trofeo no te ayudará a decidirte.');
INSERT INTO "item_descriptions" VALUES(13775,'pt','Gribe ou Pandrista? Este troféu não te ajudará a tomar uma decisão.');
INSERT INTO "item_descriptions" VALUES(13775,'de','Schmubfem oder Pandrista? Diese Trophäe wird euch die Entscheidung nicht erleichtern!');
