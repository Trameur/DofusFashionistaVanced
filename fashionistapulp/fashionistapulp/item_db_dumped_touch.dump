INSERT INTO "item_descriptions" VALUES(19323,'en','You took it literally when she said to "get up and go".');
INSERT INTO "item_descriptions" VALUES(19323,'fr','Pour ne pas vous ramollir l''esprit, n''oubliez pas de rester psychorigide.');
INSERT INTO "item_descriptions" VALUES(19323,'es','Para que no se te ablande la mente, no te olvides de conservar tu rigidez mental.');
INSERT INTO "item_descriptions" VALUES(19323,'pt','Você levou ao pé da letra quando ela disse "se joga!".');
INSERT INTO "item_descriptions" VALUES(19323,'de','Damit euch nicht die Birne aufweicht, vergesst nicht, unnachgiebig zu bleiben.');
