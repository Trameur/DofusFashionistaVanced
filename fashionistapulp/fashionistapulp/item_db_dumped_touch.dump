INSERT INTO "item_descriptions" VALUES(19419,'en','Team up with some Bworks to become the group''s intellectual.');
INSERT INTO "item_descriptions" VALUES(19419,'fr','Alliez-vous avec des Bworks pour devenir l''intellectuel du groupe.');
INSERT INTO "item_descriptions" VALUES(19419,'es','Júntate con los bworks para convertirte en el intelectual del grupo.');
INSERT INTO "item_descriptions" VALUES(19419,'pt','Alie-se aos Bworks para se tornar o intelectual do grupo.');
INSERT INTO "item_descriptions" VALUES(19419,'de','Verbündet euch mit den Bworks, um zum Intellektuellen der Gruppe zu werden.');
