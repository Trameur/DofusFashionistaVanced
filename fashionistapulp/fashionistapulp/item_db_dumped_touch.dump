INSERT INTO "item_descriptions" VALUES(19373,'de','Ihr werdet euer ganzes Leben lang nach der Konstante der Luft suchen, ohne sie jemals zu finden.');
INSERT INTO "item_descriptions" VALUES(19375,'en','You tried different air styles, but that was before your thatch turned into thin air.');
INSERT INTO "item_descriptions" VALUES(19375,'fr','Vous chercherez toute votre vie la constante de l''air sans jamais la trouver.');
INSERT INTO "item_descriptions" VALUES(19375,'es','Buscarás toda tu vida la proporción «áirea», pero nunca la encontrarás.');
INSERT INTO "item_descriptions" VALUES(19375,'pt','Acho que você está precisando de novos ares.');
INSERT INTO "item_descriptions" VALUES(19375,'de','Ihr werdet euer ganzes Leben lang nach der Konstante der Luft suchen, ohne sie jemals zu finden.');
INSERT INTO "item_descriptions" VALUES(19377,'en','You''ve always strongly believed that blood is thicker than water. Which is why you never pour yourself a refreshing glass of blood.');
INSERT INTO "item_descriptions" VALUES(19377,'fr','Vous avez toujours pensé pouvoir vivre d''amour et d''eau fraîche. Mais vous passer des bains chauds en hiver était trop difficile.');
INSERT INTO "item_descriptions" VALUES(19377,'es','Siempre pensaste que, teniendo amor, te podrías pasar la vida llevándote jarros de agua fría, que te resbalaría... Pero privarse de los baños calientes en invierno era demasiado difícil.');
INSERT INTO "item_descriptions" VALUES(19377,'pt','Você sempre quis viver de amor e água fresca, mas ficar sem banho quente no inverno seria muito difícil.');
INSERT INTO "item_descriptions" VALUES(19377,'de','Ihr habt immer geglaubt, nur von Liebe und frischer Luft leben zu können. Euch im Winter aber in die heiße Wanne zu bekommen war zu schwierig.');
INSERT INTO "item_descriptions" VALUES(19379,'en','You''ve always strongly believed that blood is thicker than water. Which is why you never pour yourself a refreshing glass of blood.');
INSERT INTO "item_descriptions" VALUES(19379,'fr','Vous avez toujours pensé pouvoir vivre d''amour et d''eau fraîche. Mais vous passer des bains chauds en hiver était trop difficile.');
