INSERT INTO "item_descriptions" VALUES(13817,'en','Don''t throw this Trophy out with the bathwater.');
INSERT INTO "item_descriptions" VALUES(13817,'fr','Ne jetez pas ce Trophée avec l''eau du bain.');
INSERT INTO "item_descriptions" VALUES(13817,'es','Si no tienes impermeable ni paraguas, este trofeo te protegerá de más de un chaparrón.');
INSERT INTO "item_descriptions" VALUES(13817,'pt','Não jogue esse troféu pelo ralo.');
INSERT INTO "item_descriptions" VALUES(13817,'de','Mit dieser Trophäe werdet ihr wohl nie baden gehen.');
