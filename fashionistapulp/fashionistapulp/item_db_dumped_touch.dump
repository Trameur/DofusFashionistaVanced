INSERT INTO "item_descriptions" VALUES(19357,'pt','Com a evasão fiscal, é possível se proteger dos impostos e taxas que permitiriam que os pobres roubassem dos ricos.');
INSERT INTO "item_descriptions" VALUES(19357,'de','Durch Steuerhinterziehung kann man die Steuerabgaben vermeiden, die es den Armen ermöglichen würden, die Reichen zu bestehlen.');
INSERT INTO "item_descriptions" VALUES(19359,'en','Headbutting an enemy to stun them seemed like a good tactical move at the time. Then you realised that they were wearing a helmet, unlike you.');
INSERT INTO "item_descriptions" VALUES(19359,'fr','Cogner votre tête contre celle de votre adversaire afin de l''étourdir semblait être une action tactique intéressante. Jusqu''à ce que vous vous rappeliez qu''il avait un casque et pas vous.');
INSERT INTO "item_descriptions" VALUES(19359,'es','Darte un cabezazo contra la cocorota de tu adversario para aturdirlo te parecía una estrategia interesante. Al menos hasta que caíste en que él llevaba casco y tú no.');
INSERT INTO "item_descriptions" VALUES(19359,'pt','Bater a sua cabeça contra a do seu adversário a fim de atordoá-lo parecia ser uma tática interessante... Até você se dar conta de que ele tinha um capacete e você não.');
INSERT INTO "item_descriptions" VALUES(19359,'de','Dem Gegner eine Kopfnuss zu verpassen, um ihn zu betäuben, schien eine taktisch interessante Aktion zu sein. Bis euch bewusst wurde, dass er einen Helm trägt, und ihr nicht.');
INSERT INTO "item_descriptions" VALUES(19361,'en','Headbutting an enemy to stun them seemed like a good tactical move at the time. Then you realised that they were wearing a helmet, unlike you.');
INSERT INTO "item_descriptions" VALUES(19361,'fr','Cogner votre tête contre celle de votre adversaire afin de l''étourdir semblait être une action tactique intéressante. Jusqu''à ce que vous vous rappeliez qu''il avait un casque et pas vous.');
INSERT INTO "item_descriptions" VALUES(19361,'es','Darte un cabezazo contra la cocorota de tu adversario para aturdirlo te parecía una estrategia interesante. Al menos hasta que caíste en que él llevaba casco y tú no.');
INSERT INTO "item_descriptions" VALUES(19361,'pt','Bater a sua cabeça contra a do seu adversário a fim de atordoá-lo parecia ser uma tática interessante... Até você se dar conta de que ele tinha um capacete e você não.');
INSERT INTO "item_descriptions" VALUES(19361,'de','Dem Gegner eine Kopfnuss zu verpassen, um ihn zu betäuben, schien eine taktisch interessante Aktion zu sein. Bis euch bewusst wurde, dass er einen Helm trägt, und ihr nicht.');
INSERT INTO "item_descriptions" VALUES(19363,'en','Headbutting an enemy to stun them seemed like a good tactical move at the time. Then you realised that they were wearing a helmet, unlike you.');
INSERT INTO "item_descriptions" VALUES(19363,'fr','Cogner votre tête contre celle de votre adversaire afin de l''étourdir semblait être une action tactique intéressante. Jusqu''à ce que vous vous rappeliez qu''il avait un casque et pas vous.');
INSERT INTO "item_descriptions" VALUES(19363,'es','Darte un cabezazo contra la cocorota de tu adversario para aturdirlo te parecía una estrategia interesante. Al menos hasta que caíste en que él llevaba casco y tú no.');
INSERT INTO "item_descriptions" VALUES(19363,'pt','Bater a sua cabeça contra a do seu adversário a fim de atordoá-lo parecia ser uma tática interessante... Até você se dar conta de que ele tinha um capacete e você não.');
INSERT INTO "item_descriptions" VALUES(19363,'de','Dem Gegner eine Kopfnuss zu verpassen, um ihn zu betäuben, schien eine taktisch interessante Aktion zu sein. Bis euch bewusst wurde, dass er einen Helm trägt, und ihr nicht.');
INSERT INTO "item_descriptions" VALUES(19365,'en','Your technique is not to be the quickest, but to just delay everyone else so you''re not the slowest. This technique has already proven its value in countless government offices throughout the World of Twelve.');
INSERT INTO "item_descriptions" VALUES(19365,'fr','Votre technique n''est pas d''être le plus rapide, vous cherchez juste à ralentir les autres pour ne pas être le plus lent. Cette technique a déjà fait ses preuves dans toutes les administrations du Monde des Douze.');
INSERT INTO "item_descriptions" VALUES(19365,'es','Tu técnica no tiene por qué ser la más rápida: basta con que ralentices a los demás para no ser el más lento. Esta técnica ya se ha probado en todas las administraciones del Mundo de los Doce.');
INSERT INTO "item_descriptions" VALUES(19365,'pt','Sua técnica pode não ser a mais rápida, mas você procura atrasar todo mundo só para não ser o mais lento. Esta é uma técnica testada e aprovada por todos os serviços administrativos do Mundo dos Doze.');
INSERT INTO "item_descriptions" VALUES(19365,'de','Eure Technik besteht nicht darin, am schnellsten zu sein. Ihr versucht nur, die anderen zu verlangsamen, um nicht am langsamsten zu sein. Diese Technik hat sich bereits in allen Verwaltungen der Welt der Zwölf bewährt.');
INSERT INTO "item_descriptions" VALUES(19367,'en','Your technique is not to be the quickest, but to just delay everyone else so you''re not the slowest. This technique has already proven its value in countless government offices throughout the World of Twelve.');
