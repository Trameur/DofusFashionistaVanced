INSERT INTO "item_descriptions" VALUES(19329,'en','Sometimes it''s just better to be never than late.');
INSERT INTO "item_descriptions" VALUES(19329,'fr','Rien ne sert de mourir ; il faut fuir à point.');
INSERT INTO "item_descriptions" VALUES(19329,'es','De nada sirve caer, lo que conviene es huir a tiempo.');
INSERT INTO "item_descriptions" VALUES(19329,'pt','Às vezes, antes nunca é melhor do que tarde.');
INSERT INTO "item_descriptions" VALUES(19329,'de','Sterben bringt nichts. Man muss rechtzeitig fliehen.');
