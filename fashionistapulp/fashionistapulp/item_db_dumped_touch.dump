INSERT INTO "item_descriptions" VALUES(19389,'en','There where your Dragoturkey has passed, the grass will never grow again.');
INSERT INTO "item_descriptions" VALUES(19389,'fr','Là où passe votre Dragodinde, l''herbe ne repousse pas.');
INSERT INTO "item_descriptions" VALUES(19389,'es','Por donde pasa tu dragopavo, la hierba no vuelve a crecer.');
INSERT INTO "item_descriptions" VALUES(19389,'pt','Por onde o seu Dragoperu passa, a grama não volta a crescer.');
INSERT INTO "item_descriptions" VALUES(19389,'de','Dort, wo euer Dracotruter lang geht, wächst kein Gras mehr.');
