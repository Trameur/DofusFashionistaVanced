INSERT INTO "item_descriptions" VALUES(9712,'es','Esta arma es una fab''hurista. Roba fragmentos del alma de los fab''huritus de Rushu de los cadáveres de los monstruos derrotados. Cuando los hayas recuperado, podrás intentar incrustarlos en el arma para hacerla aún más poderosa.');
INSERT INTO "item_descriptions" VALUES(9712,'pt','Essa arma é uma Shushumi e pode ser usada para adquirir fragmentos de Shushu dos monstros. Ao adquirir um fragmento, você pode tentar anexá-lo a uma arma, tornando-a mais poderosa.');
INSERT INTO "item_descriptions" VALUES(9712,'de','Bei dieser Waffe handelt es sich um eine Shushette. Sie ist in der Lage, Seelenfragmente der Shushus von Rushu einzufangen, die von Monstern aufgenommen wurden. Diese können dann auf die Waffe aufgebracht werden, um sie noch mächtiger zu machen.');
INSERT INTO "item_descriptions" VALUES(9713,'en','This weapon is a Shushumi and can steal Rushu''s Shushus soul fragments from monsters. When you have a fragment, you can try to embed it in a weapon to make it more powerful.');
INSERT INTO "item_descriptions" VALUES(9713,'fr','Cette arme est une Shushette, elle est capable de voler les fragments d''âmes des Shushus de Rushu que possèdent les monstres. Une fois que vous les aurez récupérés, vous pourrez tenter de les incruster directement sur l''arme afin de la rendre plus puissante.');
INSERT INTO "item_descriptions" VALUES(9713,'es','Esta arma es una fab''hurista. Roba fragmentos del alma de los fab''huritus de Rushu de los cadáveres de los monstruos derrotados. Cuando los hayas recuperado, podrás intentar incrustarlos en el arma para hacerla aún más poderosa.');
