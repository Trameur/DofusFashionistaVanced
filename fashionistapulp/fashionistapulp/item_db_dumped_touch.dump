INSERT INTO "item_descriptions" VALUES(19431,'en','It helps to be cured, but not in the ham sense.');
INSERT INTO "item_descriptions" VALUES(19431,'fr','Mieux vaut être miraculé qu''acculé.');
INSERT INTO "item_descriptions" VALUES(19431,'es','Más vale ser milagrero que agorero.');
INSERT INTO "item_descriptions" VALUES(19431,'pt','É melhor ser miraculado do que encurralado.');
INSERT INTO "item_descriptions" VALUES(19431,'de','Es ist besser wundersam zu sein, als in die Enge getrieben zu werden.');
INSERT INTO "item_descriptions" VALUES(19433,'en','It helps to be cured, but not in the ham sense.');
INSERT INTO "item_descriptions" VALUES(19433,'fr','Mieux vaut être miraculé qu''acculé.');
INSERT INTO "item_descriptions" VALUES(19433,'es','Más vale ser milagrero que agorero.');
INSERT INTO "item_descriptions" VALUES(19433,'pt','É melhor ser miraculado do que encurralado.');
INSERT INTO "item_descriptions" VALUES(19433,'de','Es ist besser wundersam zu sein, als in die Enge getrieben zu werden.');
INSERT INTO "item_descriptions" VALUES(19435,'en','It helps to be cured, but not in the ham sense.');
INSERT INTO "item_descriptions" VALUES(19435,'fr','Mieux vaut être miraculé qu''acculé.');
INSERT INTO "item_descriptions" VALUES(19435,'es','Más vale ser milagrero que agorero.');
INSERT INTO "item_descriptions" VALUES(19435,'pt','É melhor ser miraculado do que encurralado.');
INSERT INTO "item_descriptions" VALUES(19435,'de','Es ist besser wundersam zu sein, als in die Enge getrieben zu werden.');
INSERT INTO "item_descriptions" VALUES(19437,'en','This Trophy will help you heal your allies by offering wise words: "an api a day keeps the doctor away; seven apis a week, you''ll no longer feel weak".');
INSERT INTO "item_descriptions" VALUES(19437,'fr','Ce Trophée vous aide à guérir vos alliés en distribuant de bons conseils : "un grand verre d''eau soigne tous les maux, un grand bol de sciure soigne toutes les fractures".');
INSERT INTO "item_descriptions" VALUES(19437,'es','Este trofeo te ayuda a curar a tus aliados repartiendo buenos consejos: «de agua un buen vaso, eso es mano de santo; y de serrín un cuenco te cura y te quita cualquier fractura».');
INSERT INTO "item_descriptions" VALUES(19437,'pt','Este troféu o ajudará a curar seus aliados ao distribuir bons conselhos: "um grande copo d''água cura qualquer mágoa, um grande prato de fritura cura qualquer fratura".');
INSERT INTO "item_descriptions" VALUES(19437,'de','Diese Trophäe hilft euch mit guten Ratschlägen, eure Verbündeten zu heilen: „Ein großes Glas Wasser heilt alle Leiden, eine große Schüssel Sägemehl heilt alle Frakturen“.');
INSERT INTO "item_descriptions" VALUES(19439,'en','This Trophy will help you heal your allies by offering wise words: "an api a day keeps the doctor away; seven apis a week, you''ll no longer feel weak".');
INSERT INTO "item_descriptions" VALUES(19439,'fr','Ce Trophée vous aide à guérir vos alliés en distribuant de bons conseils : "un grand verre d''eau soigne tous les maux, un grand bol de sciure soigne toutes les fractures".');
INSERT INTO "item_descriptions" VALUES(19439,'es','Este trofeo te ayuda a curar a tus aliados repartiendo buenos consejos: «de agua un buen vaso, eso es mano de santo; y de serrín un cuenco te cura y te quita cualquier fractura».');
INSERT INTO "item_descriptions" VALUES(19439,'pt','Este troféu o ajudará a curar seus aliados ao distribuir bons conselhos: "um grande copo d''água cura qualquer mágoa, um grande prato de fritura cura qualquer fratura".');
INSERT INTO "item_descriptions" VALUES(19439,'de','Diese Trophäe hilft euch mit guten Ratschlägen, eure Verbündeten zu heilen: „Ein großes Glas Wasser heilt alle Leiden, eine große Schüssel Sägemehl heilt alle Frakturen“.');
INSERT INTO "item_descriptions" VALUES(19441,'en','This Trophy will help you heal your allies by offering wise words: "an api a day keeps the doctor away; seven apis a week, you''ll no longer feel weak".');
INSERT INTO "item_descriptions" VALUES(19441,'fr','Ce Trophée vous aide à guérir vos alliés en distribuant de bons conseils : "un grand verre d''eau soigne tous les maux, un grand bol de sciure soigne toutes les fractures".');
INSERT INTO "item_descriptions" VALUES(19441,'es','Este trofeo te ayuda a curar a tus aliados repartiendo buenos consejos: «de agua un buen vaso, eso es mano de santo; y de serrín un cuenco te cura y te quita cualquier fractura».');
INSERT INTO "item_descriptions" VALUES(19441,'pt','Este troféu o ajudará a curar seus aliados ao distribuir bons conselhos: "um grande copo d''água cura qualquer mágoa, um grande prato de fritura cura qualquer fratura".');
INSERT INTO "item_descriptions" VALUES(19441,'de','Diese Trophäe hilft euch mit guten Ratschlägen, eure Verbündeten zu heilen: „Ein großes Glas Wasser heilt alle Leiden, eine große Schüssel Sägemehl heilt alle Frakturen“.');
INSERT INTO "item_descriptions" VALUES(19443,'en','This Trophy will be of no use to you whilst crossing the desert.');
INSERT INTO "item_descriptions" VALUES(19443,'fr','Ce Trophée ne vous sera d''aucune utilité lors de votre traversée du désert.');
INSERT INTO "item_descriptions" VALUES(19443,'es','Este trofeo no te será de ninguna utilidad para atravesar el desierto.');
INSERT INTO "item_descriptions" VALUES(19443,'pt','Este troféu não terá nenhuma utilidade durante a sua travessia do deserto.');
INSERT INTO "item_descriptions" VALUES(19443,'de','Diese Trophäe wird euch beim Desertieren keine Hilfe sein.');
INSERT INTO "item_descriptions" VALUES(19445,'en','This Trophy will be of no use to you whilst crossing the desert.');
INSERT INTO "item_descriptions" VALUES(19445,'fr','Ce Trophée ne vous sera d''aucune utilité lors de votre traversée du désert.');
INSERT INTO "item_descriptions" VALUES(19445,'es','Este trofeo no te será de ninguna utilidad para atravesar el desierto.');
INSERT INTO "item_descriptions" VALUES(19445,'pt','Este troféu não terá nenhuma utilidade durante a sua travessia do deserto.');
INSERT INTO "item_descriptions" VALUES(19445,'de','Diese Trophäe wird euch beim Desertieren keine Hilfe sein.');
INSERT INTO "item_descriptions" VALUES(19447,'en','This Trophy will be of no use to you whilst crossing the desert.');
INSERT INTO "item_descriptions" VALUES(19447,'fr','Ce Trophée ne vous sera d''aucune utilité lors de votre traversée du désert.');
INSERT INTO "item_descriptions" VALUES(19447,'es','Este trofeo no te será de ninguna utilidad para atravesar el desierto.');
INSERT INTO "item_descriptions" VALUES(19447,'pt','Este troféu não terá nenhuma utilidade durante a sua travessia do deserto.');
INSERT INTO "item_descriptions" VALUES(19447,'de','Diese Trophäe wird euch beim Desertieren keine Hilfe sein.');
INSERT INTO "item_descriptions" VALUES(19449,'en','If your enemies do not pass away, at least they shall not pass.');
INSERT INTO "item_descriptions" VALUES(19449,'fr','A défaut de trépasser, vos ennemis ne passeront pas.');
INSERT INTO "item_descriptions" VALUES(19449,'es','Tus enemigos no pasarán al otro barrio, pero, por lo menos, no pasarán.');
INSERT INTO "item_descriptions" VALUES(19449,'pt','Mesmo se os seus inimigos não passarem mal, daqui eles não passam.');
INSERT INTO "item_descriptions" VALUES(19449,'de','Außer ihr scheidet dahin, kommen eure Gegner nicht vorbei.');
INSERT INTO "item_descriptions" VALUES(19451,'en','If your enemies do not pass away, at least they shall not pass.');
INSERT INTO "item_descriptions" VALUES(19451,'fr','A défaut de trépasser, vos ennemis ne passeront pas.');
INSERT INTO "item_descriptions" VALUES(19451,'es','Tus enemigos no pasarán al otro barrio, pero, por lo menos, no pasarán.');
INSERT INTO "item_descriptions" VALUES(19451,'pt','Mesmo se os seus inimigos não passarem mal, daqui eles não passam.');
INSERT INTO "item_descriptions" VALUES(19451,'de','Außer ihr scheidet dahin, kommen eure Gegner nicht vorbei.');
INSERT INTO "item_descriptions" VALUES(19453,'en','If your enemies do not pass away, at least they shall not pass.');
INSERT INTO "item_descriptions" VALUES(19453,'fr','A défaut de trépasser, vos ennemis ne passeront pas.');
INSERT INTO "item_descriptions" VALUES(19453,'es','Tus enemigos no pasarán al otro barrio, pero, por lo menos, no pasarán.');
INSERT INTO "item_descriptions" VALUES(19453,'pt','Mesmo se os seus inimigos não passarem mal, daqui eles não passam.');
INSERT INTO "item_descriptions" VALUES(19453,'de','Außer ihr scheidet dahin, kommen eure Gegner nicht vorbei.');
INSERT INTO "item_descriptions" VALUES(19455,'en','You like to think of yourself as a nomad. Which is really just a nicer way of describing a coward.');
INSERT INTO "item_descriptions" VALUES(19455,'fr','Vous aimez vous définir comme nomade. Une façon polie de décrire un froussard.');
INSERT INTO "item_descriptions" VALUES(19455,'es','Te encanta definirte como nómada. Es una forma cortés de describir a un miedica.');
INSERT INTO "item_descriptions" VALUES(19455,'pt','Você gosta de se definir como um nômade, o que não passa de um eufemismo para "covarde".');
INSERT INTO "item_descriptions" VALUES(19455,'de','Es gefällt euch, als Nomade bezeichnet zu werden. Eine höfliche Ausdrucksweise, um einen Angsthasen zu bezeichnen.');
INSERT INTO "item_descriptions" VALUES(19457,'en','This Trophy emits little electric shocks to keep you active at all times. You can use it on your abs, in your underwear or in an aquarium, if you like to watch fish float.');
INSERT INTO "item_descriptions" VALUES(19457,'fr','Ce trophée émet de petites décharges électriques pour vous inciter à agir continuellement. Vous pouvez l''utiliser sur vos abdominaux, dans vos sous-vêtements, ou dans un aquarium si vous aimez les poissons qui flottent.');
INSERT INTO "item_descriptions" VALUES(19457,'es','Este trofeo emite pequeñas descargas eléctricas para incitarte a moverte continuamente. Puedes utilizarlo sobre tus abdominales, en la ropa interior o en un acuario, si te gustan los peces que flotan.');
INSERT INTO "item_descriptions" VALUES(19457,'pt','Este troféu emite pequenos choques elétricos para manter você ativo. Você pode usá-lo no abdômen, nas roupas de baixo ou em um aquário, se gostar de ver os peixes boiando.');
INSERT INTO "item_descriptions" VALUES(19457,'de','Diese Trophäe gibt kleine elektrische Entladungen ab, um euch ständig in Bewegung zu halten. Ihr könnt sie für eure Bauchmuskeln, in eurer Unterwäsche oder in einem Aquarium nutzen, wenn ihr die Fische gerne an der Oberfläche schwimmen seht.');
INSERT INTO "item_descriptions" VALUES(19513,'en','This amulet is really nothing more than an assortment of flowers woven together around a cord. But it was sold to you so effectively that you believe with all your heart that it will bring you beauty and prosperity.');
INSERT INTO "item_descriptions" VALUES(19513,'fr','Cette amulette n''est en réalité qu''un assortiment de fleurs accrochées autour d''un fil. Mais elle vous a été si bien vendue qu''au fond de votre cœur, vous êtes persuadé qu''elle vous apportera beauté et prospérité.');
INSERT INTO "item_descriptions" VALUES(19513,'es','Este amuleto en realidad no es más que un surtido de flores puestas en un hilo. Pero te lo han vendido tan bien que, en el fondo de tu corazón, tienes la convicción de que te traerá belleza y prosperidad.');
INSERT INTO "item_descriptions" VALUES(19513,'pt','Este amuleto nada mais é do que um monte de flores amarradas em um fio. Mas o vendedor foi tão convincente que, lá no fundo, você tem certeza de que ele lhe trará beleza e prosperidade.');
INSERT INTO "item_descriptions" VALUES(19513,'de','Dieses Amulett besteht eigentlich nur aus einer Reihe aufgefädelter Blumen. Aber es wurde euch wirklich gut verkauft und ihr glaubt fest daran, dass es euch Gesundheit und Wohlstand bringen wird.');
INSERT INTO "item_descriptions" VALUES(19614,'en','Is your sworn enemy arachneephobic? Well, you''re in luck – this is the perfect gift for their next birthday... which will be their last, fingers crossed.');
INSERT INTO "item_descriptions" VALUES(19614,'fr','Votre pire ennemi souffre d''araknophobie ? Félicitations, vous avez trouvé le cadeau idéal pour son prochain anniversaire... Avec un peu de chance, ce sera le dernier.');
INSERT INTO "item_descriptions" VALUES(19614,'es','¿Tu peor enemigo tiene araknofobia? Enhorabuena, has dado con el regalo ideal para su próximo cumpleaños... Con un pelín de suerte, será el último.');
INSERT INTO "item_descriptions" VALUES(19614,'pt','Seu pior inimigo sofre de araknofobia? Parabéns, você acabou de encontrar o presente ideal para o próximo aniversário dele... Com um pouco de sorte, será o último.');
INSERT INTO "item_descriptions" VALUES(19614,'de','Euer schlimmster Feind leidet unter Arachnophobie? Herzlichen Glückwunsch, ihr habt das perfekte Geschenk für seinen nächsten Geburtstag gefunden ... und mit ein bisschen Glück auch für seinen letzten.');
INSERT INTO "item_descriptions" VALUES(19616,'en','Supple and soft to the touch, these boots are incredibly comfortable. But be prepared to be asked to go barefoot by those who hate seeing those creepy crawlies scuttling across their floor.');
INSERT INTO "item_descriptions" VALUES(19616,'fr','Souples et douces au toucher, ces bottes sont très agréables à porter. Malheureusement, vous risquez de vous faire souvent marcher sur les pieds par ceux qui détestent les petites bêtes gambadant sur le plancher.');
INSERT INTO "item_descriptions" VALUES(19616,'es','Estas botas, ligeras y suaves al tacto, son de lo más cómodas. Lamentablemente, te arriesgas a que todo aquel que odie los bichitos que andan dando saltitos por el suelo te la tenga jurada.');
INSERT INTO "item_descriptions" VALUES(19616,'pt','Macias e suaves ao toque, essas botas são incrivelmente confortáveis. Infelizmente, é provável que seus pés sejam frequentemente pisoteados por pessoas que odeiam ver criaturinhas cheias de patas correndo pelo chão.');
INSERT INTO "item_descriptions" VALUES(19616,'de','Diese weichen, geschmeidigen Stiefel sind sehr angenehm zu tragen. Leider könnte es sein, dass euch dauernd Leute auf die Füße treten, die etwas gegen kleine, fellige Viecher haben.');
INSERT INTO "item_descriptions" VALUES(19618,'en','This hat was a roaring success at the last fashion show organised by the Brakmar Black Widows'' Association.');
INSERT INTO "item_descriptions" VALUES(19618,'fr','Cette coiffe a remporté un grand succès au dernier défilé de haute couture organisé par l''association des veuves noires de Brâkmar.');
INSERT INTO "item_descriptions" VALUES(19618,'es','Este tocado ha gozado de un gran éxito en el último desfile de alta costura organizado por la asociación de viudas negras de Brakmar.');
INSERT INTO "item_descriptions" VALUES(19618,'pt','Este chapéu foi um estouro no último desfile de moda organizado pela Associação de Viúvas-Negras de Brakmar.');
INSERT INTO "item_descriptions" VALUES(19618,'de','Diese Kopfbedeckung war auf der letzten Haute-Couture-Modenschau der schwarzen Witwen Brâkmars ein echter Hit.');
INSERT INTO "item_descriptions" VALUES(19620,'en','Some claim that this talisman corrects eyesight problems, while others assure us that it merely multiplies them. The truth, as is often the case, depends on your point of view.');
INSERT INTO "item_descriptions" VALUES(19620,'fr','Certains prétendent que ce talisman corrige les troubles de la vision ; d''autres assurent qu''il ne fait que multiplier les problèmes. Qui a tort, qui a raison ? Tout est une question de point de vue.');
INSERT INTO "item_descriptions" VALUES(19620,'es','Hay quien asegura que este talismán corrige los defectos de visión; otros afirman que no hace más que multiplicar los problemas. ¿Quién tiene razón y quién se equivoca? Depende de cómo se mire.');
INSERT INTO "item_descriptions" VALUES(19620,'pt','Alguns afirmam que este talismã cura problemas de visão. Outros garantem que ele apenas os multiplica. Quem tem razão? Tudo é apenas questão de ponto de vista.');
INSERT INTO "item_descriptions" VALUES(19620,'de','Einige behaupten, dieser Talisman könne bei Sehstörungen helfen. Andere meinen, er würde bloß für noch mehr Probleme sorgen. Wer recht hat? Das ist Ansichtssache.');
INSERT INTO "item_descriptions" VALUES(19622,'en','This frightening belt will cure your back problems. Just be careful not to lean back too hard while wearing it, or the arak-hai abdomen on the back could burst.');
INSERT INTO "item_descriptions" VALUES(19622,'fr','Cette ceinture à l''aspect effrayant soignera vos problèmes de dos. Faites tout de même attention à ne pas vous adosser trop fort lorsque vous la portez, l''abdomen d''arak-haï qui orne sa partie arrière risquerait d''exploser.');
INSERT INTO "item_descriptions" VALUES(19622,'es','Este cinturón de aspecto terrorífico curará tus problemas de espalda. Pero ten cuidado con apoyarla demasiado fuerte cuando lo lleves: el abdomen de arak-hai que lo decora por detrás podría reventar.');
INSERT INTO "item_descriptions" VALUES(19622,'pt','Este cinto de aparência assustadora curará seus problemas de coluna. Ainda assim, tome cuidado ao se sentar ou encostar na parede quando estiver com ele, pois o abdômen de Arak-hai que adorna a parte traseira poderia explodir.');
INSERT INTO "item_descriptions" VALUES(19622,'de','Dieser furchterregende Gürtel heilt all eure Rückenprobleme. Lehnt euch nur nicht zu weit zurück, wenn ihr ihn tragt, sonst könnte der Arach-Hai-Bauch explodieren, der sich an der Rückseite befindet.');
INSERT INTO "item_descriptions" VALUES(19624,'en','If you cross paths with Nevark the Hunter while wearing this cape, he may take you for the acolyte of Arachneeman and give you a good hiding. But you''re free to do what you want, after all.');
INSERT INTO "item_descriptions" VALUES(19624,'fr','Si vous croisez le chemin de Nevark le Chasseur en étant vêtu de cette cape, il risque de vous prendre pour l''acolyte d''Araknémane et de vous flanquer une bonne rouste. Mais vous êtes libre de faire ce que vous voulez, après tout.');
INSERT INTO "item_descriptions" VALUES(19624,'es','Si te cruzas en el camino de Nevark el Cazador mientras llevas esta capa, te arriesgas a que te tome por el compañero de Araknaman y a llevarte una buena paliza. Pero eres libre de hacer lo que quieras, por supuesto.');
INSERT INTO "item_descriptions" VALUES(19624,'pt','Se você cruzar o caminho de Nevark, o Caçador, vestindo esta capa, ele pode acabar confundindo você com o acólito do Arakneman e lhe dar uma surra. Mas a vida é sua, você é livre para fazer o que bem entender.');
INSERT INTO "item_descriptions" VALUES(19624,'de','Wenn ihr mit diesem Umhang Newark dem Jäger über den Weg lauft, könnte er euch für Arachneemans Komplizen halten und euch verprügeln. Aber na ja, ihr könnt natürlich tun und lassen, was ihr wollt.');
INSERT INTO "item_descriptions" VALUES(19785,'en','This headgear is a near-perfect reproduction of the Trooligophren''s head. The tailor who worked on this piece did a really good job of transcribing his weak-mindedness. The empty eyes and the mouth really bring out that dumbfounded look. So in other words, you''ll get recognised even when you''re wearing this headgear.');
INSERT INTO "item_descriptions" VALUES(19785,'fr','Cette coiffe est une reproduction quasi parfaite de la tête du Trooligophrène. Le tailleur qui a travaillé sur cette pièce a vraiment réussi à retranscrire sa faiblesse d''esprit. Ses yeux vides et sa bouche font vraiment ressortir son air ahuri. Tout ça pour dire que, même si vous portez cette coiffe, on vous reconnaîtra.');
INSERT INTO "item_descriptions" VALUES(19785,'es','Este tocado es una reproducción casi perfecta de la cabeza del Trooligofrénico. Quien trabajara esta pieza supo plasmar su falta de luces. Sus ojos vacíos y su boca reflejan muy bien su gesto embobado. De todas formas, aunque lleves este tocado, te reconocerán.');
INSERT INTO "item_descriptions" VALUES(19785,'pt','Este chapéu é uma reprodução quase perfeita da cabeça do Trooligofrênico. O alfaiate que trabalhou nesta peça realmente conseguiu transmitir com precisão a sua falta de discernimento. Seus olhos vazios e boca aberta destacam perfeitamente sua expressão perplexa. Tudo isso para dizer que, mesmo se você usar este chapéu, todo mundo vai te reconhecer.');
INSERT INTO "item_descriptions" VALUES(19785,'de','Diese Kopfbedeckung ist eine fast perfekte Nachbildung des Trooligophrens-Kopfes. Der Schneider, der an diesem Stück gearbeitet hat, hat den schwachen Verstand perfekt eingefangen. Seine leeren Augen und sein Mund heben seine begriffsstutzige Art wunderbar hervor. Aber trotz alldem wird man euch immer noch erkennen, wenn ihr diese Kopfbedeckung tragt.');
INSERT INTO "item_descriptions" VALUES(19787,'en','Not only does this ring give off an awful smell, but it also has a terrifying clump of hair that will tickle your nose whenever it gets the chance. Just don''t put the ring too close to your nose, in other words.');
INSERT INTO "item_descriptions" VALUES(19787,'fr','Non seulement cet anneau dégage une odeur épouvantable, mais en plus de cela, il dispose d''une touffe de poils terrifiante capable de vous chatouiller le nez dès qu''elle en aura l''occasion. En clair : n''approchez pas trop cet anneau de votre nez.');
INSERT INTO "item_descriptions" VALUES(19787,'es','Este anillo no solo desprende un olor espantoso, sino que, además, tiene una mata de pelos terrorífica que te hará cosquillas en la nariz en cuanto tenga ocasión. En pocas palabras: no te acerques mucho este anillo a la nariz.');
INSERT INTO "item_descriptions" VALUES(19787,'pt','Além de emanar um cheiro terrível, este anel tem um tufo de pelos assustador capaz de fazer cócegas no seu nariz sempre que tiver uma oportunidade. Em resumo: não aproxime muito este anel do seu nariz.');
INSERT INTO "item_descriptions" VALUES(19787,'de','Dieser Ring verströmt nicht nur einen entsetzlichen Geruch, er verfügt auch über ein furchterregendes Haarbüschel, das euch an der Nase kitzeln kann, sobald er Gelegenheit dazu hat. Im Klartext: Haltet diesen Ring von eurer Nase fern.');
INSERT INTO "item_descriptions" VALUES(19789,'en','Against all expectations, these boots don''t smell at all, and it only took three different shoemakers to get rid of their original stench. Make sure you don''t wear them to the first two shoemakers'' funerals. That would just be in bad taste.');
INSERT INTO "item_descriptions" VALUES(19789,'fr','Ces bottes sont, contre toute attente inodores, il n''aura fallu que trois cordonniers différents pour parvenir à se débarrasser de leur senteur d''origine. Attention à ne pas les porter a l''enterrement des deux premiers cordonniers. Terrible faute de goût.');
INSERT INTO "item_descriptions" VALUES(19789,'es','Contra todo pronóstico, estas botas son inodoras: han tenido que intervenir tres zapateros para quitarles su olor original. Procura no llevarlas en el entierro de los dos primeros zapateros. Sería de muy mal gusto.');
INSERT INTO "item_descriptions" VALUES(19789,'pt','Por incrível que pareça, estas botas são inodoras. Apenas três sapateiros diferentes foram necessários para se livrar do cheiro original. Cuidado para não usá-las no enterro dos dois primeiros sapateiros. Seria de muito mau gosto.');
INSERT INTO "item_descriptions" VALUES(19789,'de','Diese Stiefel sind wider Erwarten geruchlos. Es waren drei verschiedene Schuhmacher nötig, um ihren ursprünglichen Geruch zu beseitigen. Achtet darauf, sie nicht zur Beerdigung der ersten beiden Schuhmacher zu tragen. Das wäre wirklich geschmacklos.');
INSERT INTO "item_descriptions" VALUES(19791,'en','This cape was taken straight from the Troololens''s mane. It just goes to show that mixing boowolf blood and slobber apparently makes for a good hair care product, and the stench of it will make you stronger in every way.');
INSERT INTO "item_descriptions" VALUES(19791,'fr','Cette cape est directement extraite de la crinière du Troololens. Comme quoi, le mélange de sang et de bave de Mulou semble être un bon soin capillaire, l''odeur nauséabonde qui s''en dégage vous rendra plus fort sur tous les points');
INSERT INTO "item_descriptions" VALUES(19791,'es','Esta capa ha sido extraída directamente de la melena de Troololens. Al final va a resultar que la sangre y las babas de milubo son un buen producto de cuidado capilar: el olor nauseabundo que desprenden te hará más fuerte en todos los sentidos.');
INSERT INTO "item_descriptions" VALUES(19791,'pt','Esta capa é extraída diretamente da crina do Troololens. Aparentemente, a mistura de sangue e saliva de Milobo parece ser um bom tratamento capilar, e o cheiro nauseabundo que emana dela te tornará mais resistente em todos os aspectos.');
INSERT INTO "item_descriptions" VALUES(19791,'de','Dieser Umhang stammt direkt aus der Mähne des Troololens. Die Mischung aus Blut und WuWulf-Sabber scheint ein gutes Haarpflegemittel zu sein und der Übelkeit erregende Gestank, der davon ausgeht, macht euch rundum stärker.');
INSERT INTO "item_descriptions" VALUES(19793,'en','It was customary for Trool children to suck their thumbs until they reached adulthood. Looks like you''ll be able to keep this tradition alive. It would have been easier if you''d used your finger... Cleaner, too.');
INSERT INTO "item_descriptions" VALUES(19793,'fr','Il était coutume chez les enfants Trooll de sucer son pouce jusqu''à l''âge adulte. Il semblerait que vous puissiez faire perdurer cette tradition. La tâche aurait été plus simple en utilisant votre doigt... Plus propre aussi.');
INSERT INTO "item_descriptions" VALUES(19793,'es','Los niños trool tenían por costumbre chuparse el dedo gordo hasta la edad adulta. Parece ser que podrías perpetuar esta tradición. Aunque sería más sencillo si lo hicieras con el de la mano... Y más higiénico.');
INSERT INTO "item_descriptions" VALUES(19793,'pt','As crianças Trools costumavam chupar o polegar até a idade adulta. Parece que agora você pode continuar essa tradição. Seria mais fácil se você usasse seu próprio dedo... E também mais higiênico.');
INSERT INTO "item_descriptions" VALUES(19793,'de','Es war bei Trools üblich, dass die Kinder bis ins Erwachsenenalter am Daumen lutschen. Es scheint, als ob ihr diese Tradition aufrecht erhalten könntet. Die Arbeit wäre einfacher gewesen, wenn ihr euren Finger verwendet hättet ... Und hygienischer.');
INSERT INTO "item_descriptions" VALUES(19795,'en','This belt was once used as a loincloth that hid much more. It seems that over time, the cloth gradually wore away, much to the dismay of the other forest dwellers.');
INSERT INTO "item_descriptions" VALUES(19795,'fr','Cette ceinture était à l''époque un pagne qui cachait bien plus de choses. Il semblerait qu''avec le temps, le tissu a disparu petit à petit, pour le plus grand malheur des autres habitants de la forêt.');
INSERT INTO "item_descriptions" VALUES(19795,'es','Este cinturón era en su día un paño que ocultaba más cosas. Parece que, con el tiempo, el tejido ha ido acortándose, para la inmensa desgracia de los demás habitantes del bosque.');
INSERT INTO "item_descriptions" VALUES(19795,'pt','Antigamente, este cinto era uma tanga que escondia muito mais do que aparenta. Parece que, com o tempo, o tecido foi desaparecendo pouco a pouco, para o infortúnio dos outros habitantes da floresta.');
INSERT INTO "item_descriptions" VALUES(19795,'de','Dieser Gürtel war einmal ein Lendenschurz, der deutlich mehr bedeckte. Mit der Zeit er wohl Stück für Stück geschrumpft, sehr zum Leidwesen der anderen Bewohner des Waldes.');
INSERT INTO "item_descriptions" VALUES(19827,'en','As long as you''re wearing this ring on your finger, Gustiful will follow you everywhere. If you take it off, Gustiful will still follow you, because the little creature loves you no matter what.');
INSERT INTO "item_descriptions" VALUES(19827,'fr','Tant que vous portez cet anneau au doigt, Mimistrale vous suivra partout. Si vous le retirez, Mimistrale vous suivra quand même, car cette petite vous aime quoi qu''il en soit.');
INSERT INTO "item_descriptions" VALUES(19827,'es','Mientras lleves este anillo en el dedo, el mimistral te seguirá por todas partes. Si te lo quitas, el mimistral te seguirá igualmente, porque ese pequeñín te adora.');
INSERT INTO "item_descriptions" VALUES(19827,'pt','Enquanto você usar este anel no dedo, Mimistral seguirá você por toda parte. Se tirá-lo, Mimistral seguirá você do mesmo jeito, porque ele te ama.');
INSERT INTO "item_descriptions" VALUES(19827,'de','Solange ihr diesen Ring tragt, wird euch Mimistrale überallhin folgen. Auch wenn ihr ihn abnehmt, wird euch Mimistrale folgen, denn der Kleine hat euch wirklich ins Herz geschlossen.');
INSERT INTO "item_descriptions" VALUES(19829,'en','As long as you''re wearing this ring on your finger, Scorcheroo will follow you everywhere. If you take it off, Scorcheroo will still follow you, because the little creature loves you no matter what.');
INSERT INTO "item_descriptions" VALUES(19829,'fr','Tant que vous portez cet anneau au doigt, Flambourou vous suivra partout. Si vous le retirez, Flambourou vous suivra quand même, car cette petite vous aime quoi qu''il en soit.');
INSERT INTO "item_descriptions" VALUES(19829,'es','Mientras lleves este anillo en el dedo, el cangruido te seguirá por todas partes. Si te lo quitas, el cangruido te seguirá igualmente, porque ese pequeñín te adora.');
INSERT INTO "item_descriptions" VALUES(19829,'pt','Enquanto você usar este anel no dedo, Changuru seguirá você por toda parte. Se tirá-lo, Changuru seguirá você do mesmo jeito, porque ele te ama.');
INSERT INTO "item_descriptions" VALUES(19829,'de','Solange ihr diesen Ring tragt, wird euch Känglüh überallhin folgen. Auch wenn ihr ihn abnehmt, wird euch Känglüh folgen, denn der Kleine hat euch wirklich ins Herz geschlossen.');
INSERT INTO "item_descriptions" VALUES(19831,'en','As long as you''re wearing this ring on your finger, Amphibubble will follow you everywhere. If you take it off, Amphibubble will still follow you, because the little creature loves you no matter what.');
INSERT INTO "item_descriptions" VALUES(19831,'fr','Tant que vous portez cet anneau au doigt, Amphibulle vous suivra partout. Si vous le retirez, Amphibulle vous suivra quand même, car cette petite vous aime quoi qu''il en soit.');
INSERT INTO "item_descriptions" VALUES(19831,'es','Mientras lleves este anillo en el dedo, el anfiburbuja te seguirá por todas partes. Si te lo quitas, el anfiburbuja te seguirá igualmente, porque ese pequeñín te adora.');
INSERT INTO "item_descriptions" VALUES(19831,'pt','Enquanto você usar este anel no dedo, Anfibolha seguirá você por toda parte. Se tirá-lo, Anfibolha seguirá você do mesmo jeito, porque ele te ama.');
INSERT INTO "item_descriptions" VALUES(19831,'de','Solange ihr diesen Ring tragt, wird euch Amphiblase überallhin folgen. Auch wenn ihr ihn abnehmt, wird Amphiblase euch folgen, denn der Kleine hat euch wirklich ins Herz geschlossen.');
INSERT INTO "item_descriptions" VALUES(19833,'en','As long as you''re wearing this ring on your finger, Sweetapir will follow you everywhere. If you take it off, Sweetapir will still follow you, because the little creature loves you no matter what.');
INSERT INTO "item_descriptions" VALUES(19833,'fr','Tant que vous portez cet anneau au doigt, Tapipou vous suivra partout. Si vous le retirez, Tapipou vous suivra quand même, car cette petite vous aime quoi qu''il en soit.');
INSERT INTO "item_descriptions" VALUES(19833,'es','Mientras lleves este anillo en el dedo, el tapricioso te seguirá por todas partes. Si te lo quitas, el tapricioso te seguirá igualmente, porque ese pequeñín te adora.');
INSERT INTO "item_descriptions" VALUES(19833,'pt','Enquanto você usar este anel no dedo, Anteca seguirá você por toda parte. Se tirá-lo, Anteca seguirá você do mesmo jeito, porque ele te ama.');
INSERT INTO "item_descriptions" VALUES(19833,'de','Solange ihr diesen Ring tragt, wird euch Tapirlich überallhin folgen. Auch wenn ihr ihn abnehmt, wird Tapirlich euch folgen, denn der Kleine hat euch wirklich ins Herz geschlossen.');
INSERT INTO "item_descriptions" VALUES(19835,'en','It might not save your life, but it will spare you a few bruises. It''s the next best thing.');
INSERT INTO "item_descriptions" VALUES(19835,'fr','Il ne vous sauvera certainement pas la vie, mais vous épargnera quelques bleus. C''est toujours ça de pris.');
INSERT INTO "item_descriptions" VALUES(19835,'es','Seguramente no te salvará la vida, pero te ahorrará algún que otro moratón. Menos da una piedra.');
INSERT INTO "item_descriptions" VALUES(19835,'pt','Ele não vai salvar sua vida, mas vai poupar você de alguns roxos. Já é um bom começo.');
INSERT INTO "item_descriptions" VALUES(19835,'de','Er wird euch vermutlich nicht das Leben retten, aber er kann euch vor einigen blauen Flecken bewahren. Das ist nicht viel, aber immerhin.');
INSERT INTO "item_descriptions" VALUES(19837,'en','It might not save your life, but it will spare you a few bruises. It''s the next best thing.');
INSERT INTO "item_descriptions" VALUES(19837,'fr','Il ne vous sauvera certainement pas la vie, mais vous épargnera quelques bleus. C''est toujours ça de pris.');
