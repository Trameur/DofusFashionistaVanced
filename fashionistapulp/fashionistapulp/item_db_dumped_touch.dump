INSERT INTO "item_descriptions" VALUES(13790,'en','The good thing about this Trophy is that, if you hit an ally by mistake, there''s little chance they''ll be able to do anything about it.');
INSERT INTO "item_descriptions" VALUES(13790,'fr','Ce Trophée paralyse de honte vos coéquipiers à chaque fois que vous vous trompez de cible.
Dissuasif pour certains, amusant pour d''autres.');
INSERT INTO "item_descriptions" VALUES(13790,'es','Con este trofeo dejará a tu compañeros de piedra cada vez que te equivoques de objetivo.
Disuasivos para unos, divertido para otros.');
INSERT INTO "item_descriptions" VALUES(13790,'pt','Esse troféu paralisa seus aliados de vergonha cada vez que você erra o alvo. Desencorajador para alguns, divertido para outros.');
INSERT INTO "item_descriptions" VALUES(13790,'de','Eure Mitspieler werden jedes Mal schwach, wenn ihr mal wieder das Ziel verwechselt... Abschreckend für die einen, amüsant für die anderen.');
INSERT INTO "item_descriptions" VALUES(13791,'en','The good thing about this Trophy is that, if you hit an ally by mistake, there''s little chance they''ll be able to do anything about it.');
INSERT INTO "item_descriptions" VALUES(13791,'fr','Ce Trophée paralyse de honte vos coéquipiers à chaque fois que vous vous trompez de cible.
