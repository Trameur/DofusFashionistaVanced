INSERT INTO "item_descriptions" VALUES(8223,'fr','Cet anneau permettra à votre maîtresse de vous retrouver, où que vous soyez.');
INSERT INTO "item_descriptions" VALUES(8223,'es','Este anillo permitirá a tu amante encontrarte, sea cual sea el lugar donde te encuentres.');
INSERT INTO "item_descriptions" VALUES(8223,'pt','Este anel fará o seu amor te achar, mas ninguém te quer.');
INSERT INTO "item_descriptions" VALUES(8223,'de','Dank dieses Rings wird eure Mätresse euch finden können, wo auch immer ihr euch gerade aufhaltet.');
