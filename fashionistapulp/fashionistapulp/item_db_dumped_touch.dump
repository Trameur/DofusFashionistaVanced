INSERT INTO "item_descriptions" VALUES(12628,'en','This Trophy helps you slow down your opponent''s movements so you can catch them more quickly and humiliate them accordingly, by giving them a wedgie, for example.');
INSERT INTO "item_descriptions" VALUES(12628,'fr','Ce Trophée permet de mieux ralentir les déplacements des adversaires pour les rattraper plus rapidement et leur infliger une humiliation méritée, comme une fessée culotée par exemple.');
INSERT INTO "item_descriptions" VALUES(12628,'es','Con este trofeo podrás ralentizar los desplazamientos de los adversarios para alcanzarlos más rápidamente y darles una buena lección... como por ejemplo unos azotes en el trasero... ¡Qué humillación! Jajjjjajajaj...');
INSERT INTO "item_descriptions" VALUES(12628,'pt','Esse troféu permite que você reduza os movimentos do seu inimigo para capturá-lo mais facilmente e o humilhe apropriadamente, arrancando sua cueca, por exemplo.');
INSERT INTO "item_descriptions" VALUES(12628,'de','Diese Trophäe erleichtert es euch, eure Gegner zu lähmen. So könnt ihr sie leichter einholen, um ihnen ihre längst verdiente Lektion in Sachen Demut und Unterwürfigkeit zu verabreichen.');
INSERT INTO "item_descriptions" VALUES(12629,'en','This Trophy helps you slow down your opponent''s movements so you can catch them more quickly and humiliate them accordingly, by giving them a wedgie, for example.');
INSERT INTO "item_descriptions" VALUES(12629,'fr','Ce Trophée permet de mieux ralentir les déplacements des adversaires pour les rattraper plus rapidement et leur infliger une humiliation méritée, comme une fessée culotée par exemple.');
