INSERT INTO "item_descriptions" VALUES(12683,'en','This Trophy protects you from Neutral attacks, but it won''t make your enemies any more Neutral once the hostilities commence.');
INSERT INTO "item_descriptions" VALUES(12683,'fr','Ce Trophée protège des attaques d''élément Neutre mais n''empêchera pas vos adversaires de sortir de leur neutralité lorsque les hostilités débuteront.');
INSERT INTO "item_descriptions" VALUES(12683,'es','Con este trofeo te protegerás de los ataques de elemento neutral pero no impedirá a tus adversarios abandonar su neutralidad cuando comiencen las hostilidades.');
INSERT INTO "item_descriptions" VALUES(12683,'pt','Esse troféu protege você contra ataques neutros, mas não vai deixar seus inimigos nem um pouco neutros quando as hostilidades começarem.');
INSERT INTO "item_descriptions" VALUES(12683,'de','Diese Trophäe schützt vor Neutralschaden, verhindert jedoch nicht, dass Neutralgebliebene im Krisenfall Partei ergreifen.');
