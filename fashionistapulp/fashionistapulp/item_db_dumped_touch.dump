INSERT INTO "item_descriptions" VALUES(19841,'pt','Ele não vai salvar sua vida, mas vai poupar você de alguns roxos. Já é um bom começo.');
INSERT INTO "item_descriptions" VALUES(19841,'de','Er wird euch vermutlich nicht das Leben retten, aber er kann euch vor einigen blauen Flecken bewahren. Das ist nicht viel, aber immerhin.');
INSERT INTO "item_descriptions" VALUES(19845,'en','This sidekick has been entrusted to you. Care for it, love it, and it will love you back many times over.');
INSERT INTO "item_descriptions" VALUES(19845,'fr','Ce compagnon est confié à vos bons soins. Aimez-le et il vous rendra au centuple.');
INSERT INTO "item_descriptions" VALUES(19845,'es','Este compañero ha sido puesto a tu cuidado. Dale cariño y te lo devolverá con creces.');
INSERT INTO "item_descriptions" VALUES(19845,'pt','Este companheiro foi confiado aos seus cuidados. Ame-o e ele retribuirá em dobro.');
INSERT INTO "item_descriptions" VALUES(19845,'de','Man hat diesen Begleiter in eure Obhut gegeben. Wenn ihr ihm Zuneigung schenkt, wird er sie euch hundertfach zurückgeben.');
INSERT INTO "item_descriptions" VALUES(19847,'en','This sidekick has been entrusted to you. Care for it, love it, and it will love you back many times over.');
INSERT INTO "item_descriptions" VALUES(19847,'fr','Ce compagnon est confié à vos bons soins. Aimez-le et il vous rendra au centuple.');
INSERT INTO "item_descriptions" VALUES(19847,'es','Este compañero ha sido puesto a tu cuidado. Dale cariño y te lo devolverá con creces.');
INSERT INTO "item_descriptions" VALUES(19847,'pt','Este companheiro foi confiado aos seus cuidados. Ame-o e ele retribuirá em dobro.');
INSERT INTO "item_descriptions" VALUES(19847,'de','Man hat diesen Begleiter in eure Obhut gegeben. Wenn ihr ihm Zuneigung schenkt, wird er sie euch hundertfach zurückgeben.');
INSERT INTO "item_descriptions" VALUES(19849,'en','This sidekick has been entrusted to you. Care for it, love it, and it will love you back many times over.');
INSERT INTO "item_descriptions" VALUES(19849,'fr','Ce compagnon est confié à vos bons soins. Aimez-le et il vous rendra au centuple.');
INSERT INTO "item_descriptions" VALUES(19849,'es','Este compañero ha sido puesto a tu cuidado. Dale cariño y te lo devolverá con creces.');
INSERT INTO "item_descriptions" VALUES(19849,'pt','Este companheiro foi confiado aos seus cuidados. Ame-o e ele retribuirá em dobro.');
INSERT INTO "item_descriptions" VALUES(19849,'de','Man hat diesen Begleiter in eure Obhut gegeben. Wenn ihr ihm Zuneigung schenkt, wird er sie euch hundertfach zurückgeben.');
INSERT INTO "item_descriptions" VALUES(19851,'en','This sidekick has been entrusted to you. Care for it, love it, and it will love you back many times over.');
INSERT INTO "item_descriptions" VALUES(19851,'fr','Ce compagnon est confié à vos bons soins. Aimez-le et il vous rendra au centuple.');
INSERT INTO "item_descriptions" VALUES(19851,'es','Este compañero ha sido puesto a tu cuidado. Dale cariño y te lo devolverá con creces.');
INSERT INTO "item_descriptions" VALUES(19851,'pt','Este companheiro foi confiado aos seus cuidados. Ame-o e ele retribuirá em dobro.');
INSERT INTO "item_descriptions" VALUES(19851,'de','Man hat diesen Begleiter in eure Obhut gegeben. Wenn ihr ihm Zuneigung schenkt, wird er sie euch hundertfach zurückgeben.');
INSERT INTO "item_descriptions" VALUES(19913,'en','Besides following you across the world, MD-12 will be happy to carry the weight of the world on its shoulders so you don''t have to. Pretty useful, right?

(This legendary pet does not need to eat.)');
INSERT INTO "item_descriptions" VALUES(19913,'fr','En plus de vous suivre à la trace à travers le globe, MD-12 se fait un plaisir de porter le poids du monde sur ses épaules à votre place. Pratique !

(Ce familier légendaire n''a pas besoin de manger)');
INSERT INTO "item_descriptions" VALUES(19913,'es','Además de seguir tu rastro por todo el globo, MD-12 está encantado de llevar el peso del mundo sobre sus hombros por ti. ¡Muy práctico!

(Esta mascota legendaria no necesita alimentarse)');
INSERT INTO "item_descriptions" VALUES(19913,'pt','Além de seguir você por toda parte, em qualquer lugar do mundo, MD-12 carregará o peso do mundo nos ombros por você. Muito prático!

(Esta mascote lendária não precisa comer)');
INSERT INTO "item_descriptions" VALUES(19913,'de','MD-12 folgt euch nicht nur quer über den Globus, es bereitet ihm auch Vergnügen, die Last der Welt für euch zu schultern. Wie praktisch!

(Dieser legendäre Vertraute muss nicht essen.)');
INSERT INTO "item_descriptions" VALUES(19915,'en','An essential accessory for travelling around the World of Twelve, this backpack will also help you take only the essentials.');
INSERT INTO "item_descriptions" VALUES(19915,'fr','Accessoire indispensable pour arpenter le Monde des Douze, ce sac à dos vous ramène toujours à l''essentiel.');
INSERT INTO "item_descriptions" VALUES(19915,'es','Esta mochila es un accesorio imprescindible para recorrer el Mundo de los Doce y te recuerda siempre lo esencial.');
INSERT INTO "item_descriptions" VALUES(19915,'pt','Acessório indispensável para explorar o Mundo dos Doze, esta mochila traz de volta o que é essencial.');
INSERT INTO "item_descriptions" VALUES(19915,'de','Dieser Rucksack ist ein unerlässliches Accessoire, um die Welt der Zwölf zu bereisen, und bringt euch immer zum Kern der Sache zurück.');
INSERT INTO "item_descriptions" VALUES(19941,'en','The two rubies set into this ring represent the gaze of the goddess Inali. Minuscule flames dance in the gems. Could the spirit of a real Kitsou live within this ring?... It''s probably just a reflection of your own greed.');
INSERT INTO "item_descriptions" VALUES(19941,'fr','Les deux rubis encastrés dans cet anneau forment le regard d''une représentation de la déesse Inali. De minuscules flammes dansent dans les joyaux, se pourrait-il que l''esprit d''un véritable kitsou réside dans cet anneau ? ... Ce n''est probablement que le reflet de votre propre cupidité.');
INSERT INTO "item_descriptions" VALUES(19941,'es','Los dos rubíes engastados en este anillo forman la perspectiva de una representación de la diosa Inali. Minúsculas llamas bailan en las joyas, ¿será posible que el espíritu de un verdadero kitsu resida en este anillo?... No, probablemente no sea más que el reflejo de tu propia codicia.');
INSERT INTO "item_descriptions" VALUES(19941,'pt','Os dois rubis engastados neste anel compõem o olhar de uma representação da deusa Inali. Minúsculas chamas dançam na joia. Será que o espírito de um verdadeiro Kitsu reside neste anel? Provavelmente é apenas o reflexo da sua própria ganância.');
INSERT INTO "item_descriptions" VALUES(19941,'de','Die beiden Rubine, die in diesen Ring eingelassen sind, sollen die Augen der Göttin Inali darstellen. Winzige Flammen tanzen in den Juwelen. Könnte es sein, dass der Geist eines echten Kitsou diesem Ring innewohnt? Wahrscheinlich ist es doch nichts weiter als die Spiegelung eurer eigenen Gier.');
INSERT INTO "item_descriptions" VALUES(19943,'en','Each people has its own warrior caste, and the yokai are no exception with the onirakam. Truly vengeful demons, they collect the armour taken from the samurai they massacre. Despite its age, this reinforced belt will protect your delicate hips just as effectively as it did the very first day.');
INSERT INTO "item_descriptions" VALUES(19943,'fr','Chaque peuple possède sa caste de guerriers, les Yokai ne font pas exception avec l''existence des Onirakam. Véritables démons vengeurs, ils collectent des armures récoltées sur les samouraïs qu''ils ont massacrés. Malgré son âge, cette ceinture renforcée protégera vos hanches délicates avec autant d''efficacité qu''au premier jour.');
INSERT INTO "item_descriptions" VALUES(19943,'es','Cada pueblo posee su casta de guerreros, los yokais no son una excepción con la existencia de los onirakam. Verdaderos demonios vengadores, reúnen armaduras arrancadas a los samuráis que han masacrado. A pesar de su edad, este cinturón reforzado protegerá tus delicadas caderas con tanta eficacia como el primer día.');
INSERT INTO "item_descriptions" VALUES(19943,'pt','Cada povo tem sua casta de guerreiros, e os Yokais não fogem à regra com a existência dos Onirakam. Esses verdadeiros demônios vingativos colecionam armaduras tiradas dos samurais que massacram. Apesar de ser muito antigo, este cinto reforçado protegerá o seu delicado quadril com tanta eficiência quanto no primeiro dia em que foi fabricado.');
INSERT INTO "item_descriptions" VALUES(19943,'de','Jedes Volk hat seine Kriegerkaste. Die Yokai bilden da mit ihren Onirakam keine Ausnahme. Wie alle echten Rachedämonen nehmen auch sie die Rüstung der Samurais an sich, die sie niedergemetzelt haben. Trotz seines fortgeschrittenen Alters schützt dieser verstärkte Gürtel eure empfindlichen Hüften wie am ersten Tag.');
INSERT INTO "item_descriptions" VALUES(19945,'en','It took many tries to obtain this piece of armour able to protect its wearer''s flanks while still allowing for optimal mobility.');
INSERT INTO "item_descriptions" VALUES(19945,'fr','Il a fallu de nombreux essais pour obtenir cette pièce d''armure capable de protéger les flans de son porteur tout en lui offrant une mobilité optimale.');
INSERT INTO "item_descriptions" VALUES(19945,'es','Se necesitaron varias pruebas para obtener esta pieza de armadura capaz de proteger a los fans de su portador ofreciéndole una movilidad óptima.');
INSERT INTO "item_descriptions" VALUES(19945,'pt','Foram necessários muitos testes para obter esta peça de armadura capaz de proteger o quadril de quem a estiver usando e lhe oferecer ao mesmo tempo uma excelente mobilidade.');
INSERT INTO "item_descriptions" VALUES(19945,'de','Zahlreiche Anläufe waren nötig, um euch diese Rüstung zu beschaffen, die die Hüften ihres Trägers schützt und ihm dabei optimale Bewegungsfreiheit bietet.');
INSERT INTO "item_descriptions" VALUES(19947,'en','In addition to giving you an elegant eastern style, these geta will let you walk through ectoplasm without staining the rest of your outfit. If you''re cold, you can also wear these sandals with socks. It''s probably the only time you can wear socks with sandals and not look absolutely ridiculous.');
INSERT INTO "item_descriptions" VALUES(19947,'fr','Ces geta, en plus de vous donner un élégant style oriental, vous permettent de marcher dans de l''ectoplasme sans tacher le reste de votre tenue. Si vous avez froid, vous pouvez également porter ces sandales avec des chaussettes. Profitez-en, pour une fois ce ne sera pas une grave faute de goût.');
INSERT INTO "item_descriptions" VALUES(19947,'es','Estas getas, además de darte un elegante estilo orientas, te permiten caminar sobre ectoplasma sin mancharte el resto de tu indumentaria. Si tienes frío, también puedes ponerte estas sandalias con calcetines. Aprovecha, por una vez no será una falta grave de gusto.');
INSERT INTO "item_descriptions" VALUES(19947,'pt','Além de conferirem um elegante estilo oriental, estas sandálias lhe permitem pisar em ectoplasma sem manchar o resto da sua roupa. Se estiver com frio, você pode muito bem usar estas getas com meias. Aproveite, pois desta vez não ficará brega.');
INSERT INTO "item_descriptions" VALUES(19947,'de','Diese Geta ermöglichen es euch nicht nur, euch im orientalischen Stil zu kleiden und dabei elegant zu wirken. Ihr könnt damit auch durch Ektoplasma waten, ohne den Rest eures Gewands zu beschmutzen. Wenn euch kalt ist, könnt ihr diese Pantinen auch mit Socken tragen. Traut euch ruhig! In diesen Schuhen gelten Socken nicht als schlechter Stil.');
INSERT INTO "item_descriptions" VALUES(19949,'en','Don these boots and your legs will feel lighter and you''ll move around more discretely, giving off clouds of mist with every step. With a bit of practice, you too might inherit the nickname "mist rider".');
INSERT INTO "item_descriptions" VALUES(19949,'fr','Lorsque vous portez ces bottes, vos jambes semblent plus légères et vous vous déplacez plus discrètement en libérant des volutes de brume à chacun de vos pas. Avec un peu de maîtrise vous pourriez peut-être, vous aussi, hériter du titre de "chevaucheur de brume".');
INSERT INTO "item_descriptions" VALUES(19949,'es','Cuando te pones estas botas, tus piernas parecen más ligeras y te desplazas más discretamente liberando volutas de bruma con cada uno de tus pasos. Cuando domines la técnica, quizás tú también podrías heredar el título de «Cabalgador de bruma».');
INSERT INTO "item_descriptions" VALUES(19949,'pt','Quando você usa estas botas, suas pernas parecem mais leves, e você se move mais discretamente, liberando volutas de bruma a cada passo que dá. Com um pouco de treino, você talvez possa herdar também o título de Cavaleiro de Bruma.');
INSERT INTO "item_descriptions" VALUES(19949,'de','Wenn ihr diese Stiefel tragt, erscheinen euch eure Beine viel leichter! Ihr bewegt euch viel leiser und setzt bei jedem Schritt Nebelwölkchen frei. Mit ein bisschen Übung könntet vielleicht auch ihr den Titel „Nebelritter“ tragen.');
INSERT INTO "item_descriptions" VALUES(19951,'en','Despite the persistent smell of putrefaction coming from this bag, it was designed to be kept for many a long year. With it, you''ll have a friend to talk to whenever you''re feeling lonely.');
INSERT INTO "item_descriptions" VALUES(19951,'fr','Même s''il dégage une odeur de putréfaction tenace, ce sac mortuaire est fait pour être conservé des années durant. Si vous vous sentez seul vous aurez toujours sur vous un ami à qui parler.');
INSERT INTO "item_descriptions" VALUES(19951,'es','Aunque desprende un fuerte olor a putrefacción, esta bolsa mortuoria está hecha para ser conservada durante años. Si te sientes solo, llevarás siempre contigo un amigo con el que hablar.');
INSERT INTO "item_descriptions" VALUES(19951,'pt','Embora exale um cheiro de putrefação bastante forte, este saco mortuário foi feito para ser conservado durante anos. Quando você se sentir sozinho, sempre terá um amigo com quem conversar.');
INSERT INTO "item_descriptions" VALUES(19951,'de','Auch wenn von ihm ein hartnäckiger Verwesungsgestank ausgeht, dieser Totensack kann jahrelang aufbewahrt werden. Wenn ihr euch einsam fühlt, habt ihr immer einen Freund an eurer Seite, mit dem ihr euch unterhalten könnt.');
INSERT INTO "item_descriptions" VALUES(19953,'en','It is often said that the Kaonashi are the spirits of Twelvians who died in complete obscurity, which would explain their lack of a face. Obviously, this is patently false, but nothing is stopping you from wearing this mask and masquerading as one of your slightly naive friends'' late great-great grandfather. ');
INSERT INTO "item_descriptions" VALUES(19953,'fr','On dit souvent que les Kaonashi sont les esprits de douziens morts dans l''anonymat le plus total, ce qui expliquerait leur absence de visage. C''est bien entendu totalement faux, mais rien ne vous empêche de porter ce masque et de vous faire passer pour l''arrière-grand-père décédé de votre ami un peu naïf. ');
INSERT INTO "item_descriptions" VALUES(19953,'es','Se suele decir que los kaonashis son los espíritus de doceros muertos en el anonimato más total, lo que explicaría su ausencia de rostro. La verdad es que es totalmente falso, pero nada te impide ponerte esta máscara y hacerte pasar por el tatarabuelo fallecido de tu amigo que es un tanto ingenuo. ');
INSERT INTO "item_descriptions" VALUES(19953,'pt','Sempre dizem que os Kaonashis são espíritos de dozeanos mortos em total anonimato, o que explicaria a ausência de rosto deles. Óbvio, isso está completamente errado, mas não é nada que impeça você de usar esta máscara para se fazer passar pelo falecido tataravô daquele seu amigo meio ingênuo. ');
INSERT INTO "item_descriptions" VALUES(19953,'de','Man hört häufig, dass die Kaonashi Geister von Zwölfianern sind, die in vollständiger Anonymität gestorben sind. Das würde zumindest das Fehlen ihres Gesichts erklären. Das ist selbstverständlich total falsch. Aber nichts hindert euch daran, diese Maske zu tragen, und euch für den verstorbenen Urgroßvater eures furchtbar naiven Freunds auszugeben. ');
INSERT INTO "item_descriptions" VALUES(19957,'en','You can use this ring to puncture the Gobbowl Ball when you want to quietly enjoy a break in play.');
INSERT INTO "item_descriptions" VALUES(19957,'fr','Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19957,'es','Con este anillo se puede rajar la jalabola para disfrutar discretamente de una pausa durante el partido.');
INSERT INTO "item_descriptions" VALUES(19957,'pt','Você pode utilizar este anel para furar a Papabola quando quiser aproveitar tranquilamente um intervalo de jogo.');
INSERT INTO "item_descriptions" VALUES(19957,'de','Wenn es wieder dringend an der Zeit ist, eine Spielpause zu arrangieren, dann kommt dieser Ring zum unauffälligen Zerstechen des Fressballes wie gerufen!');
INSERT INTO "item_descriptions" VALUES(19959,'en','You can use this ring to puncture the Gobbowl ball when you want to quietly enjoy a break in play.');
INSERT INTO "item_descriptions" VALUES(19959,'fr','Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19959,'es','Con este anillo se puede rajar la jalabola para disfrutar discretamente de una pausa durante el partido.');
INSERT INTO "item_descriptions" VALUES(19959,'pt','Você pode utilizar este anel para furar a papabola quando quiser aproveitar tranquilamente um intervalo de jogo.');
INSERT INTO "item_descriptions" VALUES(19959,'de','Mit diesem Ring könnt ihr den Fressball aufschneiden, falls ihr mal eine unauffällige Spielunterbrechung braucht.');
INSERT INTO "item_descriptions" VALUES(19961,'en','[!] Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19961,'fr','Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
