INSERT INTO "item_descriptions" VALUES(13801,'de','Mit dieser Trophäe könnt ihr den anderen Abenteurern so richtig schön auf den Nerven herumtrampeln.
Nach eingehender Überlegung wird euch klar, dass all eure letzten Eroberungen im Besitz einer solchen Trophäe gewesen sein müssen.');
INSERT INTO "item_descriptions" VALUES(13802,'en','When the pressure gets too much, when people start throwing their weight around, and when you realise you''re a total pushover, it''s time to equip this Trophy.');
INSERT INTO "item_descriptions" VALUES(13802,'fr','Quand la pression devient trop forte, quand les lourds deviennent trop lourds et quand le poids de votre conscience dépasse le poids de vos années, il devient temps d''utiliser ce Trophée.');
INSERT INTO "item_descriptions" VALUES(13802,'es','Cuando la presión es demasiado fuerte, cuando los pesados son demasiado pesados y cuando el peso de tu conciencia sobrepasa el peso de tus años ha llegado el momento de utilizar este trofeo.');
INSERT INTO "item_descriptions" VALUES(13802,'pt','Quando a pressão fica forte demais, quando os pesados se tornam muito pesados e quando o peso da sua consciência ultrapassa o peso dos seus anos, é porque chegou a hora de usar esse troféu.');
INSERT INTO "item_descriptions" VALUES(13802,'de','Wenn der Druck unerträglich werden und alle Stricke reißen sollten oder wenn das Gewicht eurer Missetaten euch zu erdrückt droht, dann ist genau der richtige Zeitpunkt gekommen, diese Trophäe zu benutzen.');
INSERT INTO "item_descriptions" VALUES(13803,'en','When the pressure gets too much, when people start throwing their weight around, and when you realise you''re a total pushover, it''s time to equip this Trophy.');
INSERT INTO "item_descriptions" VALUES(13803,'fr','Quand la pression devient trop forte, quand les lourds deviennent trop lourds et quand le poids de votre conscience dépasse le poids de vos années, il devient temps d''utiliser ce Trophée.');
INSERT INTO "item_descriptions" VALUES(13803,'es','Cuando la presión es demasiado fuerte, cuando los pesados son demasiado pesados y cuando el peso de tu conciencia sobrepasa el peso de tus años ha llegado el momento de utilizar este trofeo.');
INSERT INTO "item_descriptions" VALUES(13803,'pt','Quando a pressão fica forte demais, quando os pesados se tornam muito pesados e quando o peso da sua consciência ultrapassa o peso dos seus anos, é porque chegou a hora de usar esse troféu.');
INSERT INTO "item_descriptions" VALUES(13803,'de','Wenn der Druck unerträglich werden und alle Stricke reißen sollten oder wenn das Gewicht eurer Missetaten euch zu erdrückt droht, dann ist genau der richtige Zeitpunkt gekommen, diese Trophäe zu benutzen.');
INSERT INTO "item_descriptions" VALUES(13804,'en','When the pressure gets too much, when people start throwing their weight around, and when you realise you''re a total pushover, it''s time to equip this Trophy.');
INSERT INTO "item_descriptions" VALUES(13804,'fr','Quand la pression devient trop forte, quand les lourds deviennent trop lourds et quand le poids de votre conscience dépasse le poids de vos années, il devient temps d''utiliser ce Trophée.');
INSERT INTO "item_descriptions" VALUES(13804,'es','Cuando la presión es demasiado fuerte, cuando los pesados son demasiado pesados y cuando el peso de tu conciencia sobrepasa el peso de tus años ha llegado el momento de utilizar este trofeo.');
INSERT INTO "item_descriptions" VALUES(13804,'pt','Quando a pressão fica forte demais, quando os pesados se tornam muito pesados e quando o peso da sua consciência ultrapassa o peso dos seus anos, é porque chegou a hora de usar esse troféu.');
INSERT INTO "item_descriptions" VALUES(13804,'de','Wenn der Druck unerträglich werden und alle Stricke reißen sollten oder wenn das Gewicht eurer Missetaten euch zu erdrückt droht, dann ist genau der richtige Zeitpunkt gekommen, diese Trophäe zu benutzen.');
INSERT INTO "item_descriptions" VALUES(13805,'en','Having the first turn gives you the limelight to commit the first fatal error, show everyone what an idiot you are, prove that you''re not a priority target, be the last man standing and come home a hero.');
INSERT INTO "item_descriptions" VALUES(13805,'fr','Agir en premier vous donnera l''opportunité de commettre la première bêtise, de passer pour un idiot, d''être ignoré comme cible prioritaire, de périr en dernier et donc d''être considéré comme un héros.');
INSERT INTO "item_descriptions" VALUES(13805,'es','Actuar el primero te dará la oportunidad de cometer el primer error, de pasar por un idiota, de que te ignoren como objetivo prioritario, de perecer en último lugar y por lo tanto de que te consideren como un héroe.');
INSERT INTO "item_descriptions" VALUES(13805,'pt','Agindo primeiro você terá a oportunidade de fazer a primeira burrada, de fazer papel de idiota, de ser ignorado como alvo prioritário, de morrer por último e, assim, ser considerado um herói.');
INSERT INTO "item_descriptions" VALUES(13805,'de','Als Erster zu handeln, bedeutet auch die erste Dummheit zu begehen, als Idiot abgestempelt zu werden, als Hauptziel unerkannt zu bleiben, als letzter zu sterben und schließlich als Held gefeiert zu werden.');
INSERT INTO "item_descriptions" VALUES(13806,'en','Having the first turn gives you the limelight to commit the first fatal error, show everyone what an idiot you are, prove that you''re not a priority target, be the last man standing and come home a hero.');
INSERT INTO "item_descriptions" VALUES(13806,'fr','Agir en premier vous donnera l''opportunité de commettre la première bêtise, de passer pour un idiot, d''être ignoré comme cible prioritaire, de périr en dernier et donc d''être considéré comme un héros.');
INSERT INTO "item_descriptions" VALUES(13806,'es','Actuar el primero te dará la oportunidad de cometer el primer error, de pasar por un idiota, de que te ignoren como objetivo prioritario, de perecer en último lugar y por lo tanto de que te consideren como un héroe.');
