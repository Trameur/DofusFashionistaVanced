INSERT INTO "item_descriptions" VALUES(13763,'en','This Trophy has the power to miraculously balance everything. Except, perhaps, your class spells.');
INSERT INTO "item_descriptions" VALUES(13763,'fr','Ce Trophée est assez puissant pour tout équilibrer. A part les sorts peut-être.');
INSERT INTO "item_descriptions" VALUES(13763,'es','Con este trofeo irás a la velocidad del rayo.');
INSERT INTO "item_descriptions" VALUES(13763,'pt','Esse troféu tem o poder de equilibrar todas as coisas. Menos os feitiços, talvez.');
INSERT INTO "item_descriptions" VALUES(13763,'de','Diese Trophäe ist so mächtig, dass sie alles ausgleichen kann, außer vielleicht die Zauber...');
