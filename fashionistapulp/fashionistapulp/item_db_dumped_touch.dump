INSERT INTO "item_descriptions" VALUES(13757,'en','This Trophy will show the world that Strength runs deep in your family.');
INSERT INTO "item_descriptions" VALUES(13757,'fr','Ce Trophée permet de prouver que la Force est très puissante dans votre famille.');
INSERT INTO "item_descriptions" VALUES(13757,'es','Con este trofeo podrás demostrar que la fuerza no falta en tu familia.');
INSERT INTO "item_descriptions" VALUES(13757,'pt','Com esse troféu, você vai poder provar que a Força é forte na sua família.');
INSERT INTO "item_descriptions" VALUES(13757,'de','Mit dieser Trophäe könnt ihr beweisen, dass die Macht in eurer Familie stark ist!');
