INSERT INTO "item_descriptions" VALUES(19353,'en','Use a good Fire attack with this Trophy, and you''ll be able to dodge and burn.');
INSERT INTO "item_descriptions" VALUES(19353,'fr','L''évasion fiscale permet de se protéger des impôts et des taxes qui permettraient aux pauvres de voler les riches.');
INSERT INTO "item_descriptions" VALUES(19353,'es','La evasión fiscal permite protegerse de impuestos y tasas, que es como los pobres roban a los ricos.');
INSERT INTO "item_descriptions" VALUES(19353,'pt','Com a evasão fiscal, é possível se proteger dos impostos e taxas que permitiriam que os pobres roubassem dos ricos.');
INSERT INTO "item_descriptions" VALUES(19353,'de','Durch Steuerhinterziehung kann man die Steuerabgaben vermeiden, die es den Armen ermöglichen würde, die Reichen zu bestehlen.');
INSERT INTO "item_descriptions" VALUES(19355,'en','Use a good Fire attack with this Trophy, and you''ll be able to dodge and burn.');
INSERT INTO "item_descriptions" VALUES(19355,'fr','L''évasion fiscale permet de se protéger des impôts et des taxes qui permettraient aux pauvres de voler les riches.');
INSERT INTO "item_descriptions" VALUES(19355,'es','La evasión fiscal permite protegerse de impuestos y tasas, que es como los pobres roban a los ricos.');
