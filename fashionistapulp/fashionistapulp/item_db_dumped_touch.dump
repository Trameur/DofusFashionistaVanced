INSERT INTO "item_descriptions" VALUES(13781,'en','This Trophy is your first step towards becoming less of a drip.');
INSERT INTO "item_descriptions" VALUES(13781,'fr','Nombreux sont les jeunes aventuriers qui pensent pouvoir vivre d''amour et d''eau fraîche. Les belles plantes peut-être.');
INSERT INTO "item_descriptions" VALUES(13781,'es','Con este trofeo le aguarás la fiesta a más de uno.');
INSERT INTO "item_descriptions" VALUES(13781,'pt','Muitos jovens aventureiros acham que podem viver de amor e água fresca. Se eles fossem plantas, talvez.');
INSERT INTO "item_descriptions" VALUES(13781,'de','Viele junge Abenteurer glauben noch immer, von Liebe, Luft und frischem Wasser leben zu können...');
INSERT INTO "item_descriptions" VALUES(13782,'en','This Trophy is your first step towards becoming less of a drip.');
