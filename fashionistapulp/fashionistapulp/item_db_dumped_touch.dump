INSERT INTO "item_descriptions" VALUES(1631,'pt','A história deste artefato vem de uma lenda muito antiga. Mas, hoje em dia, seu poder real é ainda desconhecido.');
INSERT INTO "item_descriptions" VALUES(1631,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
