INSERT INTO "item_descriptions" VALUES(13751,'en','This Trophy accepts no responsibility for runaway brains.');
INSERT INTO "item_descriptions" VALUES(13751,'fr','Ce Trophée n''est pas responsable de la fuite des cerveaux.');
INSERT INTO "item_descriptions" VALUES(13751,'es','Este trofeo no es responsable de la fuga de cerebros...');
INSERT INTO "item_descriptions" VALUES(13751,'pt','Esse troféu não é responsável pela fuga de cérebros.');
INSERT INTO "item_descriptions" VALUES(13751,'de','Diese Trophäe hat nichts mit der Abwanderung der Intelligenz zu tun.');
