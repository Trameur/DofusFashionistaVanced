INSERT INTO "item_descriptions" VALUES(19340,'en','This lucky charm increases your resistances. It might just save your life if you fall down the stairs.');
INSERT INTO "item_descriptions" VALUES(19340,'fr','Ce porte-bonheur permet d''augmenter ses résistances. Il vous sauvera peut-être la mise si vous tombez dans les escaliers.');
INSERT INTO "item_descriptions" VALUES(19340,'es','Este amuleto aumenta las resistencias. Quizás te salve si te caes por las escaleras.');
INSERT INTO "item_descriptions" VALUES(19340,'pt','Este amuleto da sorte permite aumentar suas resistências. Talvez ele salve a sua vida se você cair da escada.');
INSERT INTO "item_descriptions" VALUES(19340,'de','Dieser Glücksbringer erhöht die Resistenzen. Womöglich beschützt er euch auch, wenn ihr auf der Treppe stürzt.');
INSERT INTO "item_descriptions" VALUES(19341,'en','Knocking down so many enemies has made you a happy feller.');
INSERT INTO "item_descriptions" VALUES(19341,'fr','Le Culbuteur, c''est le surnom qui vous était donné lorsque vous retourniez votre veste sans avoir de veste.');
INSERT INTO "item_descriptions" VALUES(19341,'es','Chaquetero es el apodo que adquieres cuando cambias de chaqueta, aunque no tengas ninguna.');
INSERT INTO "item_descriptions" VALUES(19341,'pt','Você ganhou o apelido de "Virador" por causa do seu hábito de virar a casaca mesmo quando não está vestindo uma casaca.');
INSERT INTO "item_descriptions" VALUES(19341,'de','Der Kipper ist der Spitzname, den ihr erhalten habt, als ihr eure Meinung geändert habt, ohne überhaupt eine zu haben.');
INSERT INTO "item_descriptions" VALUES(19343,'en','Knocking down so many enemies has made you a happy feller.');
