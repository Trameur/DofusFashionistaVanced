INSERT INTO "item_descriptions" VALUES(19407,'en','You had a 99% chance of getting a glass half-empty, but yours was served to you half-full. How lucky is that?');
INSERT INTO "item_descriptions" VALUES(19407,'fr','Vous aviez 99% de chances d''avoir un verre à moitié vide et on vous a servi un verre à moitié plein. Quelle chance !');
INSERT INTO "item_descriptions" VALUES(19407,'es','Tenías una probabilidad del 99% de tener un vaso medio vacío y te han servido un vaso medio lleno. ¡Qué suerte!');
INSERT INTO "item_descriptions" VALUES(19407,'pt','Você tinha 99% de chances de ter um copo meio vazio, mas lhe serviram um copo meio cheio. Que sorte!');
INSERT INTO "item_descriptions" VALUES(19407,'de','Die Wahrscheinlichkeit, ein halbleeres Glas zu bekommen, lag bei 99 %, und man hat euch halbvolles Glas serviert. Was für ein Glück!');
INSERT INTO "item_descriptions" VALUES(19409,'en','You had a 99% chance of getting a glass half-empty, but yours was served to you half-full. How lucky is that?');
