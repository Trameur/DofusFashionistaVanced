INSERT INTO "item_descriptions" VALUES(13820,'en','Equip this Trophy and your worries will vanish into thin air.');
INSERT INTO "item_descriptions" VALUES(13820,'fr','Avec ce Trophée vous resterez dans l''air du temps.');
INSERT INTO "item_descriptions" VALUES(13820,'es','Si saltar por los aires no es lo tuyo, no lo dudes, este trofeo es para ti.');
INSERT INTO "item_descriptions" VALUES(13820,'pt','Com esse troféu, você vai se sentir nas nuvens.');
INSERT INTO "item_descriptions" VALUES(13820,'de','Mit dieser Trophäe geht euch nie die Luft aus.');
