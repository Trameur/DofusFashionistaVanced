INSERT INTO "item_descriptions" VALUES(8242,'pt','Este pequeno cinto vai enfatizar o seu quadril durante uma luta. Logo, ele será usado para segurar as suas tripas quando um agressivo javali das planícies tiver rasgado você ao meio nas profundezas da floresta.');
INSERT INTO "item_descriptions" VALUES(8242,'de','Dieser kleine Gürtel wird eure Hüften beim nächsten Kampf mit Sicherheit voll zur Geltung bringen. Später kann er dann auch dazu dienen, eure Eingeweide festzuhalten, wenn euch ein aggressiver Keiler der Ebenen den Bauch aufgeschlitzt haben sollte.');
INSERT INTO "item_descriptions" VALUES(8243,'en','With this hat on, you''ll look ridiculous but you''ll be just adorable. Life is a matter of choices.');
INSERT INTO "item_descriptions" VALUES(8243,'fr','Muni de ce petit chapeau sur la tête, vous aurez l''air bien ridicule, mais aussi terriblement irrésistible. La vie est une question de choix.');
INSERT INTO "item_descriptions" VALUES(8243,'es','Con este sombrerito en la cabeza tendrás un aspecto ridículo pero increíblemente irresistible. Para gustos...');
INSERT INTO "item_descriptions" VALUES(8243,'pt','Com este chapéu, você ficará ridículo, mas também extremamente charmoso. A vida é uma questão de escolhas.');
INSERT INTO "item_descriptions" VALUES(8243,'de','Mit diesem Hut auf dem Kopf werdet ihr zwar lächerlich, aber auch gleichzeitig unwiderstehlich aussehen. Tja, eine wahrhaft schwierige Wahl...');
