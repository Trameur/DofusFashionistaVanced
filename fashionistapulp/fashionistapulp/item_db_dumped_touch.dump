INSERT INTO "item_descriptions" VALUES(19395,'en','Monsters will bite you on the bum, and you''ll bite the dust. Seems like the monsters have it worse.');
INSERT INTO "item_descriptions" VALUES(19395,'fr','Les monstres vous mordront les fesses et vous mordrez la poussière. Pauvres monstres.');
INSERT INTO "item_descriptions" VALUES(19395,'es','Los monstruos te morderán las nalgas y tú morderás el polvo. Pobres monstruos.');
INSERT INTO "item_descriptions" VALUES(19395,'pt','Monstros vão morder seu traseiro e você vai comer poeira. Pobres monstros.');
INSERT INTO "item_descriptions" VALUES(19395,'de','Die Monster werden euch in den Hintern beißen und ihr in den Staub. Arme Monster.');
