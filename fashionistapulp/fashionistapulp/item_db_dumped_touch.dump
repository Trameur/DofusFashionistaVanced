INSERT INTO "item_descriptions" VALUES(13807,'pt','Agindo primeiro você terá a oportunidade de fazer a primeira burrada, de fazer papel de idiota, de ser ignorado como alvo prioritário, de morrer por último e, assim, ser considerado um herói.');
INSERT INTO "item_descriptions" VALUES(13807,'de','Als Erster zu handeln, bedeutet auch die erste Dummheit zu begehen, als Idiot abgestempelt zu werden, als Hauptziel unerkannt zu bleiben, als letzter zu sterben und schließlich als Held gefeiert zu werden.');
INSERT INTO "item_descriptions" VALUES(13808,'en','This Trophy protects you from falling earth. Handy if you spend your days hollowing out underground passageways.');
INSERT INTO "item_descriptions" VALUES(13808,'fr','Ce Trophée protège des chutes de terre. Très pratique pour labourer des plafonds en terre cuite.');
INSERT INTO "item_descriptions" VALUES(13808,'es','Gracias a este trofeo no te tragará la tierra pero puede que te dé un aire.');
INSERT INTO "item_descriptions" VALUES(13808,'pt','Esse troféu te protegerá contra as quedas de terra. Muito útil se você trabalha cavando túneis subterrâneos.');
INSERT INTO "item_descriptions" VALUES(13808,'de','Mit dieser Trophäe verliert ihr nie den Boden, oder besser gesagt die Erde unter den Füßen.');
INSERT INTO "item_descriptions" VALUES(13809,'en','This Trophy protects you from falling earth. Handy if you spend your days hollowing out underground passageways.');
