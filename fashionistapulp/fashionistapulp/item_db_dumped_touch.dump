INSERT INTO "item_descriptions" VALUES(19369,'es','Tu técnica no tiene por qué ser la más rápida: basta con que ralentices a los demás para no ser el más lento. Esta técnica ya se ha probado en todas las administraciones del Mundo de los Doce.');
INSERT INTO "item_descriptions" VALUES(19369,'pt','Sua técnica pode não ser a mais rápida, mas você procura atrasar todo mundo só para não ser o mais lento. Esta é uma técnica testada e aprovada por todos os serviços administrativos do Mundo dos Doze.');
INSERT INTO "item_descriptions" VALUES(19369,'de','Eure Technik besteht nicht darin, am schnellsten zu sein. Ihr versucht nur, die anderen zu verlangsamen, um nicht am langsamsten zu sein. Diese Technik hat sich bereits in allen Verwaltungen der Welt der Zwölf bewährt.');
INSERT INTO "item_descriptions" VALUES(19371,'en','You tried different air styles, but that was before your thatch turned into thin air.');
INSERT INTO "item_descriptions" VALUES(19371,'fr','Vous chercherez toute votre vie la constante de l''air sans jamais la trouver.');
INSERT INTO "item_descriptions" VALUES(19371,'es','Buscarás toda tu vida la proporción «áirea», pero nunca la encontrarás.');
INSERT INTO "item_descriptions" VALUES(19371,'pt','Acho que você está precisando de novos ares.');
INSERT INTO "item_descriptions" VALUES(19371,'de','Ihr werdet euer ganzes Leben lang nach der Konstante der Luft suchen, ohne sie jemals zu finden.');
INSERT INTO "item_descriptions" VALUES(19373,'en','You tried different air styles, but that was before your thatch turned into thin air.');
INSERT INTO "item_descriptions" VALUES(19373,'fr','Vous chercherez toute votre vie la constante de l''air sans jamais la trouver.');
