INSERT INTO "item_descriptions" VALUES(13793,'en','This Trophy sends small, regular jolts of electricity running through your muscles, preventing them from seizing up and stopping you from falling asleep at family dinners.');
INSERT INTO "item_descriptions" VALUES(13793,'fr','Ce Trophée diffuse à intervalles réguliers de petites décharges de foudre permettant aux muscles de se contracter et d''éviter de s''engourdir.
Juste assez pour ne pas s''endormir lors des repas de famille.');
INSERT INTO "item_descriptions" VALUES(13793,'es','Este trofeo envía, a intervalos regulares, pequeñas descargas para que los músculos se contraigan y que no acaben por entumecerse
Ideal para no dormirse en las comidas de familia.');
INSERT INTO "item_descriptions" VALUES(13793,'pt','Esse troféu envia pequenas descargas elétricas em intervalos regulares, fazendo com que os músculos se contraiam. É ideal para não pegar no sono durante os almoços de família.');
INSERT INTO "item_descriptions" VALUES(13793,'de','Diese Trophäe gibt in regelmäßigen Abständen kleine Blitzschläge ab, die dafür sorgen, dass sich eure Muskeln zusammenziehen.
Das ist genau das Richtige, um bei langen Familienessen nicht einzuschlafen.');
INSERT INTO "item_descriptions" VALUES(13794,'en','This Trophy sends small, regular jolts of electricity running through your muscles, preventing them from seizing up and stopping you from falling asleep at family dinners.');
