INSERT INTO "item_descriptions" VALUES(12718,'en','This Trophy increases your Intelligence. I wonder why the auctioneers at the Astrub Zaap have never thought to get one?');
INSERT INTO "item_descriptions" VALUES(12718,'fr','Ce Trophée permet d''augmenter l''Intelligence. Mais pourquoi n''est-il pas offert aux vendeurs à la criée du Zaap d''Astrub ?');
INSERT INTO "item_descriptions" VALUES(12718,'es','Con este trofeo podrás aumentar la inteligencia. ¿Y por qué no se lo habrán dado a los vendedores chillones del zaap de Astrub?');
INSERT INTO "item_descriptions" VALUES(12718,'pt','Esse troféu aumenta a sua Inteligência. Fico pensando por que os leiloeiros de Astrub Zaao nunca pensaram em comprar um desses.');
INSERT INTO "item_descriptions" VALUES(12718,'de','Diese Trophäe erhöht eure Intelligenz. Darum wisst ihr nun, dass ihr bei Pöbeleien den Stärkeren lieber nachgeben solltet. Weh tut es trotzdem...');
