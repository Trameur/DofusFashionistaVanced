INSERT INTO "item_descriptions" VALUES(13766,'en','This Trophy will make Chance your area of expert-tease.');
INSERT INTO "item_descriptions" VALUES(13766,'fr','Un artisan inspiré a gravé au burin sur ce Trophée : "Mâle heureux en combat, mâle heureux pendant les ébats" .');
INSERT INTO "item_descriptions" VALUES(13766,'es','Con este trofeo encontrarás tréboles de cuatro hojas a cada paso que des.');
INSERT INTO "item_descriptions" VALUES(13766,'pt','Um artesão inspirado gravou na base desse troféu a frase: "Eu tenho, você não tem".');
INSERT INTO "item_descriptions" VALUES(13766,'de','Ein äußerst inspirierter Handwerker gravierte Folgendes auf die Trophäe: "Lieber Arm dran, als Arm ab"');
INSERT INTO "item_descriptions" VALUES(13767,'en','This Trophy will make Chance your area of expert-tease.');
INSERT INTO "item_descriptions" VALUES(13767,'fr','Un artisan inspiré a gravé au burin sur ce Trophée : "Mâle heureux en combat, mâle heureux pendant les ébats" .');
INSERT INTO "item_descriptions" VALUES(13767,'es','Con este trofeo encontrarás tréboles de cuatro hojas a cada paso que des.');
INSERT INTO "item_descriptions" VALUES(13767,'pt','Um artesão inspirado gravou na base desse troféu a frase: "Eu tenho, você não tem".');
INSERT INTO "item_descriptions" VALUES(13767,'de','Ein äußerst inspirierter Handwerker gravierte Folgendes auf die Trophäe: "Lieber Arm dran, als Arm ab"');
INSERT INTO "item_descriptions" VALUES(13768,'en','In a fit of inspiration, an artisan used a chisel to engrave the following on this trophy: "Would you rather get lucky or luck out? Depends on where you are..."');
INSERT INTO "item_descriptions" VALUES(13768,'fr','Un artisan inspiré a gravé au burin sur ce Trophée : "Mâle heureux en combat, mâle heureux pendant les ébats".');
INSERT INTO "item_descriptions" VALUES(13768,'es','Con este trofeo encontrarás tréboles de cuatro hojas a cada paso que des.');
INSERT INTO "item_descriptions" VALUES(13768,'pt','Um artesão inspirado gravou na base desse troféu a frase: "Quem tem sorte no amor ao jogo tem azar no jogo do amor".');
INSERT INTO "item_descriptions" VALUES(13768,'de','Ein besonders inspirierter Künstler hat folgende Inschrift in diese Trophäe gemeißelt: „Ist dem Mann kein Kampf zu viel, genießt er auch das Liebesspiel.“');
INSERT INTO "item_descriptions" VALUES(13769,'en','This Trophy protects you from really cracking hits but also prevents you from scoring them yourself. You should take the opportunity to claim that you hate wanton violence and stand with your hands on your hips, tutting disapprovingly at everyone you see.');
INSERT INTO "item_descriptions" VALUES(13769,'fr','Ce Trophée vous protégera des coups les plus fourbes mais vous empêchera d''en commettre. Saisissez cette opportunité de ressembler à quelqu''un de bien.');
INSERT INTO "item_descriptions" VALUES(13769,'es','Con este trofeo te protegerá de los golpes más brutales pero no te dará la ocasión de asestarlos. Aprovecha la oportunidad de convertirte en una buena persona.');
INSERT INTO "item_descriptions" VALUES(13769,'pt','Esse troféu te protegerá contra os golpes mais sujos, mas também te impedirá de aplicá-los. Aproveite a oportunidade para agir como uma pessoa de bem.');
INSERT INTO "item_descriptions" VALUES(13769,'de','Diese Trophäe macht euch zu einem besseren Menschen... Sie beschützt euch vor den heimtückischsten Schlägen, verhindert jedoch, dass ihr brutal zurückschlagt.');
INSERT INTO "item_descriptions" VALUES(13770,'en','This Trophy protects you from really cracking hits but also prevents you from scoring them yourself. You should take the opportunity to claim that you hate wanton violence and stand with your hands on your hips, tutting disapprovingly at everyone you see.');
INSERT INTO "item_descriptions" VALUES(13770,'fr','Ce Trophée vous protégera des coups les plus fourbes mais vous empêchera d''en commettre. Saisissez cette opportunité de ressembler à quelqu''un de bien.');
