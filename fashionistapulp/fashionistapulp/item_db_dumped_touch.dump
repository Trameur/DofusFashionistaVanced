INSERT INTO "item_descriptions" VALUES(19383,'en','When attacked, you''ll fire back with anything: curses, taunts, bad jokes and banana skins.');
INSERT INTO "item_descriptions" VALUES(19383,'fr','Vous faites feu de tout bois lorsqu''il s''agit de prendre l''avantage sur votre adversaire : jurons, provocations, mauvaises blagues et peaux de bananes.');
INSERT INTO "item_descriptions" VALUES(19383,'es','Te gusta echar toda la carne en el asador para sacar ventaja a tu adversario: palabrotas, provocaciones, chistes malos e incluso pieles de plátano.');
INSERT INTO "item_descriptions" VALUES(19383,'pt','Ao ser atacado, você revidará com qualquer coisa: maldições, insultos, piadas ruins e cascas de banana. Admita: você gosta mesmo de ver o circo pegar fogo.');
INSERT INTO "item_descriptions" VALUES(19383,'de','Wenn es darum geht, die Oberhand über euren Gegner zu gewinnen, feuert ihr aus allen Rohren: Gefluche, Provokationen, schlechte Witze und Bananenschalen.');
