INSERT INTO "item_descriptions" VALUES(8238,'es','Este pequeño cinturón adornará maravillosamente tus caderas durante un combate. Después servirá para taparte las tripas cuando algún jabalí de las llanuras enfurecido te haya destripado en el bosque.');
INSERT INTO "item_descriptions" VALUES(8238,'pt','Este cinto pequeno liberará seus quadris em uma luta. Então, ele servirá para conter suas tripas quando um agressivo javali das planícies o destripar nas profundezas da floresta.');
