INSERT INTO "item_descriptions" VALUES(12707,'en','This Trophy increases Heals. It won''t make you look any more lively, though.');
INSERT INTO "item_descriptions" VALUES(12707,'fr','Ce Trophée permet d''augmenter les soins. Ce n''est pas avec ça que vous aurez l''air viril.');
INSERT INTO "item_descriptions" VALUES(12707,'es','Este trofeo aumenta las curas. Advertencia: disminución de la virilidad asegurada.');
INSERT INTO "item_descriptions" VALUES(12707,'pt','Esse troféu aumenta as curas. Mas não vai fazer você ficar mais bonito.');
INSERT INTO "item_descriptions" VALUES(12707,'de','Diese Trophäe verbessert die Heilung. Das heißt, sie lässt euch nicht gerade männlicher wirken!');
