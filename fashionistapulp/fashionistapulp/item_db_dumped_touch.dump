INSERT INTO "item_descriptions" VALUES(19425,'en','The saliva on your lips allows you to create a snailmet trail when you bite the dust.');
INSERT INTO "item_descriptions" VALUES(19425,'fr','La bave sur vos lèvres vous permettra de simuler le passage d''un Kaskargo lorsque vous mordrez la poussière.');
INSERT INTO "item_descriptions" VALUES(19425,'es','La baba de tus labios hará que simules el paso de un kasrakol cuando muerdas el polvo.');
INSERT INTO "item_descriptions" VALUES(19425,'pt','Ao ser derrotado e cair de cara no chão, a saliva em seus lábios permite simular um rastro de Krakol.');
INSERT INTO "item_descriptions" VALUES(19425,'de','Der Schaum vor dem Mund wird euch helfen, die Spuren eines Schnelms zu imitieren, wenn ihr in den Staub beißt.');
