INSERT INTO "item_descriptions" VALUES(13784,'en','The packaging this Trophy came in says that it works best when you have fresh air against your bare bottom. You can''t wait to try it out.');
INSERT INTO "item_descriptions" VALUES(13784,'fr','On raconte à propos de ce Trophée qu''il force son propriétaire à combattre les fesses à l''air.
Soudain, vous êtes pris d''une irrésistible envie de l''équiper.');
INSERT INTO "item_descriptions" VALUES(13784,'es','Con este trofeo siempre saldrás airoso dejando a tu enemigo con el culo al aire.');
INSERT INTO "item_descriptions" VALUES(13784,'pt','Dizem que esse troféu força seu dono a lutar com o traseiro pro ar. Você mal pode esperar para testá-lo.');
INSERT INTO "item_descriptions" VALUES(13784,'de','Man sagt dieser Trophäe nach, dass sie ihren Besitzer förmlich dazu zwingt, andere in der Luft zu zerreißen. Da bleibt euch die Luft weg, was?!');
INSERT INTO "item_descriptions" VALUES(13785,'en','The packaging this Trophy came in says that it works best when you have fresh air against your bare bottom. You can''t wait to try it out.');
