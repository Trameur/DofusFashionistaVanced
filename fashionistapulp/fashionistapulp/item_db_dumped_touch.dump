INSERT INTO "item_descriptions" VALUES(9161,'pt','Sua boca fica engraçada quando você diz o nome deste objeto? Bem, deixe dizer a você, se eu encontrar cara a cara o ladrão que suas ''Boot.. Bloops... Bloo...'', você terá tempo o bastante para correr enquanto eu descubro como pronunciar a palavra. Então pare de reclamar.');
INSERT INTO "item_descriptions" VALUES(9161,'de','Dass der Name dieses Schuhwerks unaussprechlich ist, sollte euch nicht weiter stören, zumal euch das unter gewissen Umständen durchaus von Nutzen sein kann. Zum Beispiel, wenn euch ein Brigandiner anschreit mit den Worten: "Her mit deinen Ploppen! Äh... Boppen... Äh... Bolpt.." Damit dürftet ihr genug Zeit gewinnden, um euch aus dem Staub zu machen.');
INSERT INTO "item_descriptions" VALUES(9162,'en','Say the word Bloopts ten times fast while spinning round in circles. Now you know what it feels like to be a Iop.');
INSERT INTO "item_descriptions" VALUES(9162,'fr','Prononcez dix-huit fois le mot "Bloptes" le plus rapidement possible. Voilà, vous avez l''air d''un Iop.');
INSERT INTO "item_descriptions" VALUES(9162,'es','Pronuncia lo más rápido que puedas la palabra «bloptas» dieciocho veces seguidas. Ya esta, ahora sí que te pareces a un yopuka.');
INSERT INTO "item_descriptions" VALUES(9162,'pt','Diga a palavra Bloopts dez vezes bem rápido enquanto gira em círculos. Agora você sabe como é se sentir um Iop.');
INSERT INTO "item_descriptions" VALUES(9162,'de','Wiederholt acht Mal schnell hintereinander das Wort "Blobtten"! Da steht ihr da wie ein Iop, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(9163,'en','Say the word Bloopts ten times fast while spinning round in circles. Now you know what it feels like to be a Iop.');
INSERT INTO "item_descriptions" VALUES(9163,'fr','Prononcez dix-huit fois le mot "Bloptes" le plus rapidement possible. Voilà, vous avez l''air d''un Iop.');
