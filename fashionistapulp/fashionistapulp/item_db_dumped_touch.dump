INSERT INTO "item_descriptions" VALUES(8716,'fr','Cet objet a bien fait son temps, vous pourrez peut-être en tirer quelque kamas auprès d''un commerçant affable.');
INSERT INTO "item_descriptions" VALUES(8716,'es','Este objeto ya vivió sus días de gloria, puedes sacarle unos kamas por él a algún afable comerciante.');
INSERT INTO "item_descriptions" VALUES(8716,'pt','Este item já deu o que tinha que dar. Talvez você consiga ganhar uns kamas com algum comerciante simpático.');
INSERT INTO "item_descriptions" VALUES(8716,'de','Das Objekt hat schon viele Jahre auf dem Buckel. Bei einem wohlwollenden Händler könnt ihr es vielleicht gegen ein paar Kamas eintauschen.');
INSERT INTO "item_descriptions" VALUES(8717,'en','This item has served its purpose well. You might be able to get a few kamas for it from a kindly merchant.');
