INSERT INTO "item_descriptions" VALUES(19967,'de','[!] Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19995,'en','[!] Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19995,'fr','Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19995,'es','[!] Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19995,'pt','[!] Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(19995,'de','[!] Cette bague permet d''éventrer la Boufballe lorsque vous voulez discrètement profiter d''un arrêt de jeu.');
INSERT INTO "item_descriptions" VALUES(20099,'en','We don''t always know how much the past has helped us. But we know even less of what the future has in store.
Whatever the case may be, this one looks bright.');
INSERT INTO "item_descriptions" VALUES(20099,'fr','On ne sait pas toujours à quel point le passé nous a apporté. Mais on sait encore moins ce que l''avenir nous réserve.
Quoi qu''il en soit, celui-ci s''annonce radieux.');
INSERT INTO "item_descriptions" VALUES(20099,'es','No siempre se sabe cuánto nos ha dado el pasado. Pero se sabe aún menos lo que nos depara el futuro.
Sea como fuere, este parece radiante.');
INSERT INTO "item_descriptions" VALUES(20099,'pt','Ainda não sabemos até onde o passado nos levou. Mas sabemos menos ainda até onde o futuro pode nos levar.
De toda forma, este parece radiante.');
INSERT INTO "item_descriptions" VALUES(20099,'de','Wir wissen nicht immer, wie sehr uns die Vergangenheit geprägt hat. Aber wir wissen noch weniger darüber, was die Zukunft für uns bereithält.
Aber wie dem auch sei, sie scheint strahlend zu sein.');
INSERT INTO "item_descriptions" VALUES(20541,'en','This well-made cape will make you look triumphant during battle – the perfect accessory to accompany the burning determination contained in each of your blows.');
INSERT INTO "item_descriptions" VALUES(20541,'fr','Cette cape de bonne manufacture vous accorde une allure triomphante au cœur de la bataille, comme pour accompagner la détermination ardente contenue dans chacun de vos coups.');
INSERT INTO "item_descriptions" VALUES(20541,'es','Esta capa de buena manufactura te da un aspecto triunfal en plena batalla, como para acompañar la determinación ardiente de cada uno de tus golpes.');
INSERT INTO "item_descriptions" VALUES(20541,'pt','Esta capa de boa qualidade deixa você com um ar triunfante no meio da batalha, como que para acompanhar a determinação ardente contida em cada um dos seus golpes.');
INSERT INTO "item_descriptions" VALUES(20541,'de','Dieser gut verarbeitete Umhang verleiht euch im Kampf eine triumphale Ausstrahlung, die die glühende Entschlossenheit begleitet, die in jedem eurer Schläge mitschwingt.');
INSERT INTO "item_descriptions" VALUES(20543,'en','Slip this ring on your finger to feel Hell Mina''s burning fury. Just imagine what it''d feel like to don the full set!');
INSERT INTO "item_descriptions" VALUES(20543,'fr','Il vous suffit de passer cet anneau à votre doigt pour ressentir la fureur brûlante d''Hell Mina. Imaginez alors ce qu''il en serait en endossant son équipement au complet !');
INSERT INTO "item_descriptions" VALUES(20543,'es','Te basta con ponerte este anillo en el dedo para sentir el furor ardiente de Hell Mina. ¡Imagina lo que sería llevar su equipamiento completo!');
INSERT INTO "item_descriptions" VALUES(20543,'pt','Basta colocar este anel no dedo para sentir o furor ardente de Hell Mina. Imagina como deve ser com o equipamento completo!');
INSERT INTO "item_descriptions" VALUES(20543,'de','Ihr müsst euch den Ring nur an den Finger stecken, um die brodelnde Wut Hell Minas zu spüren. Stellt euch also mal vor, wie es wäre, ihre vollständige Ausrüstung anzulegen!');
INSERT INTO "item_descriptions" VALUES(20545,'en','A simple belt bearing an evocative message: "Don''t get too close, or I''ll skewer you."');
INSERT INTO "item_descriptions" VALUES(20545,'fr','Une ceinture simple, mais au message évocateur : "Approche trop près et je t''embroche."');
INSERT INTO "item_descriptions" VALUES(20545,'es','Un cinturón sencillo, pero con un mensaje evocador: "Acércate más de la cuenta y te ensarto".');
INSERT INTO "item_descriptions" VALUES(20545,'pt','Um cinto simples, mas com uma mensagem sugestiva: "Aproxime-se demais e vai virar espetinho".');
INSERT INTO "item_descriptions" VALUES(20545,'de','Ein einfacher Gürtel mit bedeutsamer Nachricht: „Kommst du mir zu nah, wird dein schlimmster Albtraum wahr.“');
INSERT INTO "item_descriptions" VALUES(20547,'en','This ring is imbued with the power of malters, dark creatures capable of melting into the omnipresent obscurity of the Evil Forest. Unfortunately for you, its stealth power doesn''t work on Twelvians.
As a side note, there''s a rumour that a certain gobbowl player on the Bonta Blues team once tried to sneak into the women''s locker room wearing this ring. When he came out, the black and blue bruises covering his face clashed horribly with the blue of his jersey.');
INSERT INTO "item_descriptions" VALUES(20547,'fr','Cette bague est imprégnée du pouvoir des malters, de sombres créatures capables de se fondre dans l''obscurité omniprésente de la Forêt Maléfique. Malheureusement pour vous, son pouvoir de furtivité ne fonctionne pas sur les Douziens.
On raconte par ailleurs qu''un certain joueur de Boufbowl membre de l''équipe des Bleus de Bonta aurait tenté de s''infiltrer dans les vestiaires des femmes équipé de cette bague. Il en ressortit avec plus de bleus sur la face que sur son maillot.');
INSERT INTO "item_descriptions" VALUES(20547,'es','Este anillo está impregnado con el poder de los malters, unas criaturas oscuras capaces de fundirse en la negrura omnipresente del Bosque Maléfico. Por desgracia para ti, su poder de furtividad no funciona con los doceros.
Además, se dice que cierto jugador de jálabol del equipo de los Azules de Bonta intentó infiltrarse en el vestuario de mujeres equipado con este anillo. Pero, para azules, los moratones que se llevó por el cuerpo.');
INSERT INTO "item_descriptions" VALUES(20547,'pt','Este anel está impregnado do poder dos Malters, criaturas sombrias capazes de se camuflar na escuridão onipresente da Floresta Maléfica. Infelizmente para você, esse poder de furtividade não funciona em dozeanos.
Dizem inclusive que certo jogador de papabol dos azuis de Bonta tentou se infiltrar no vestiário feminino com ele no dedo. Ele voltou com mais azul de pancada do que no uniforme.');
INSERT INTO "item_descriptions" VALUES(20547,'de','Dieser Ring ist von der Macht der Malter durchdrungen – düstere Kreaturen, die mit der allgegenwärtigen Dunkelheit des Schattenwaldes verschmelzen können. Zu eurem Pech funktioniert diese Tarnfähigkeit nicht bei den Zwölfianern.
Es wird erzählt, dass ein gewisser Fressball-Spieler – ein Mannschaftsmitglied der Bonta-Blauen – versucht haben soll, mit diesem Ring in die Umkleidekabinen der Frauen einzudringen. Als er herauskam, war sein Gesicht blauer als sein Trikot.');
INSERT INTO "item_descriptions" VALUES(20549,'en','These boots give off the faint sound of rustling through dry leaves with every step you take, making every stroll a relaxing jaunt.');
INSERT INTO "item_descriptions" VALUES(20549,'fr','Ces bottes émettent un léger bruissement de feuilles mortes à chacun de vos pas, amplifiant l''aspect relaxant de la moindre de vos flâneries.');
INSERT INTO "item_descriptions" VALUES(20549,'es','Estas botas emiten un ligero crujido de hojas secas con cada paso, amplificando el aspecto relajante del más mínimo paseo.');
INSERT INTO "item_descriptions" VALUES(20549,'pt','Essas botas fazem um ligeiro barulhinho de folha seca a cada passo seu, amplificando o aspecto relaxante dos seus passeios.');
INSERT INTO "item_descriptions" VALUES(20549,'de','Diese Stiefel erzeugen bei jedem Schritt ein leises Geräusch von raschelndem Laub, was die entspannende Wirkung all eurer Spaziergänge noch verstärkt.');
INSERT INTO "item_descriptions" VALUES(20551,'en','This talisman is devoid of all magic now, but it still smells of petrichor, which has a calming effect on you.');
INSERT INTO "item_descriptions" VALUES(20551,'fr','Ce grigri autrefois magique est désormais dépourvu de toute aura, mais la douce senteur du pétrichor continue de s''échapper, vous emplissant d''un calme absolu.');
INSERT INTO "item_descriptions" VALUES(20551,'es','Este grisgrís antes mágico ahora carece de aura, pero sigue desprendiendo un dulce olor a petricor que te calma por completo.');
INSERT INTO "item_descriptions" VALUES(20551,'pt','Este talismã, outrora mágico, agora está desprovido de qualquer aura, mas o doce aroma de petricor continua a se espalhar pelo ar, preenchendo você com uma calma absoluta.');
INSERT INTO "item_descriptions" VALUES(20551,'de','Dieser eigentlich magische Glücksbringer hat keine Aura mehr, verströmt aber noch immer den zarten Duft des Petrichors, der euch mit absoluter Ruhe erfüllt.');
INSERT INTO "item_descriptions" VALUES(20619,'en','It will keep warm you during the long winter nights, and let you to organise barbecues in the summer. In any case, avoid going too close to haystacks or bundles of kindling with it; otherwise, you could be mistaken for a dangerous arsonist.');
INSERT INTO "item_descriptions" VALUES(20619,'fr','Il vous réchauffera durant les longues soirées d''hiver et vous permettra d''organiser des barbecues en été. Évitez tout de même de passer trop près des meules de foin ou des fagots de bois sec, sinon vous risquez d''être pris pour un dangereux pyromane.');
INSERT INTO "item_descriptions" VALUES(20619,'es','Te dará calor en las largas noches de invierno y te permitirá hacer barbacoas en verano. Pero procura no pasar con él cerca de un pajar o de haces de ramas secas, porque te expones a que te tomen por un peligroso pirómano.');
INSERT INTO "item_descriptions" VALUES(20619,'pt','Ele vai aquecer você nas longas noites de inverno e, no verão, vai assar a carne do churrasco. Mas procure não passar muito perto de montes de feno ou pilhas de lenha seca para não ser confundido com um piromaníaco perigoso.');
INSERT INTO "item_descriptions" VALUES(20619,'de','In langen Winternächten wärmt er euch, auf Grillpartys im Sommer spendet er Feuer. Vermeidet es aber, damit zu nah an Heuschobern oder trockenen Holzböden vorbeizugehen. Sonst hält man euch schon bald für einen gefährlichen Pyromanen.');
INSERT INTO "item_descriptions" VALUES(21593,'en','[!] Les boucliers, aussi lourds soient-ils, ne servent pas qu''à se protéger ou à pavoiser quand on est le chef du village. Pour preuve, en voilà un qui semble avoir été conçu par un craqueleur percé trop près du mur. Extrait d''un bloc de pierre ronce, il constituera le fleuron de votre collection.');
INSERT INTO "item_descriptions" VALUES(21593,'fr','Les boucliers, aussi lourds soient-ils, ne servent pas qu''à se protéger ou à pavoiser quand on est le chef du village. Pour preuve, en voilà un qui semble avoir été conçu par un craqueleur percé trop près du mur. Extrait d''un bloc de pierre ronce, il constituera le fleuron de votre collection.');
INSERT INTO "item_descriptions" VALUES(21593,'es','[!] Les boucliers, aussi lourds soient-ils, ne servent pas qu''à se protéger ou à pavoiser quand on est le chef du village. Pour preuve, en voilà un qui semble avoir été conçu par un craqueleur percé trop près du mur. Extrait d''un bloc de pierre ronce, il constituera le fleuron de votre collection.');
INSERT INTO "item_descriptions" VALUES(21593,'pt','[!] Les boucliers, aussi lourds soient-ils, ne servent pas qu''à se protéger ou à pavoiser quand on est le chef du village. Pour preuve, en voilà un qui semble avoir été conçu par un craqueleur percé trop près du mur. Extrait d''un bloc de pierre ronce, il constituera le fleuron de votre collection.');
INSERT INTO "item_descriptions" VALUES(21593,'de','[!] Les boucliers, aussi lourds soient-ils, ne servent pas qu''à se protéger ou à pavoiser quand on est le chef du village. Pour preuve, en voilà un qui semble avoir été conçu par un craqueleur percé trop près du mur. Extrait d''un bloc de pierre ronce, il constituera le fleuron de votre collection.');
INSERT INTO "item_descriptions" VALUES(21595,'en','Perfect to protect you while keeping an eye on your opponents and allies.');
INSERT INTO "item_descriptions" VALUES(21595,'fr','Idéal pour vous protéger tout en gardant un œil sur vos adversaires et alliés.');
INSERT INTO "item_descriptions" VALUES(21595,'es','Ideal para protegerte mientras vigilas a tus adversarios y aliados.');
INSERT INTO "item_descriptions" VALUES(21595,'pt','Ideal para se proteger sem tirar os olhos dos adversários e aliados.');
INSERT INTO "item_descriptions" VALUES(21595,'de','Einfach ideal, wenn ihr euch schützen und gleichzeitig eure Gegner und Verbündeten im Blick behalten wollt.');
INSERT INTO "item_descriptions" VALUES(21609,'en','"Vile intruder... You''re still alive, it seems.
My dear, did you grant this miserable insect the honour of a victory?
No matter. Those blessed by the grace of the Twelve shall all meet death, in the embrace of Dark Vlad''s flame!"');
INSERT INTO "item_descriptions" VALUES(21609,'fr','« Vil intrus... Tu es encore vivant, semble-t-il.
Ma chère, aurais-tu octroyé l''honneur d''une victoire à ce misérable insecte ?
Qu''importe. Ceux bénis par la grâce des Douze rencontreront tous la mort, dans l''étreinte de la flamme du Dark Vlad ! »');
INSERT INTO "item_descriptions" VALUES(21609,'es','«Vil intruso... Vives aún, por lo que parece.
Mi querida, ¿le has concedido el honor de una victoria a este insecto miserable?
Qué más da. ¡Todos los bendecidos por la gracia de los Doce sucumbirán al abrazo mortal de las llamas de Dark Vlad!».');
INSERT INTO "item_descriptions" VALUES(21609,'pt','"Intruso imundo... Parece que ainda está vivo.
Minha querida, você concedeu a honra de uma vitória a esse inseto miserável?
Não importa. Todos os que foram abençoados pela graça dos Doze encontrarão a morte no abraço da chama do Dark Vlad!"');
INSERT INTO "item_descriptions" VALUES(21609,'de','„Schäbiger Eindringling ... Wie es scheint, bist du noch am Leben.
Meine Liebe, solltest du diesem elendigen Insekt etwa die Ehre erwiesen haben, einen Sieg davonzutragen?
Wie dem auch sei. All jene, die mit der Gnade der Zwölf gesegnet sind, werden den Tod finden – umschlungen von Dark Vlads Flamme!“');
INSERT INTO "item_descriptions" VALUES(21611,'en','Before you put on this blood-and-sulphur-soaked tabard, make sure you really want to, because a fragment of the Incandescent One''s soul may still reside within it.
 
Now there''s a relationship that will send sparks flying!');
INSERT INTO "item_descriptions" VALUES(21611,'fr','Avant d''enfiler ce tabard imprégné de sang et de soufre, soyez sûr de vous : un fragment de l''âme de l''Incandescent y réside peut-être encore.
 
Voilà une relation qui doit faire des étincelles.');
INSERT INTO "item_descriptions" VALUES(21611,'es','Antes de ponerte este tabardo empapado en sangre y azufre, piénsatelo dos veces: un fragmento del alma del Incandescente puede residir aún en su interior.
 
Esta relación sí que echa chispas.');
INSERT INTO "item_descriptions" VALUES(21611,'pt','Antes de usar este tabardo sujo de sangue e enxofre, pense bem: um fragmento da alma do Incandescente talvez ainda esteja nele.
 
Eis uma relação que deve soltar faíscas.');
INSERT INTO "item_descriptions" VALUES(21611,'de','Bevor ihr diese in Blut und Schwefel getränkte Robe anzieht, solltet ihr auf Nummer sicher gehen: Womöglich enthält sie noch ein Seelenfragment des Flammenden.
 
Das zeugt von einer wahrlich feurigen Beziehung.');
INSERT INTO "item_descriptions" VALUES(21613,'en','When you meet Dark Vlad somewhere along your way, it''s best to run for your life and pray he doesn''t catch you, or you''ll end up like a grilled sausage.');
INSERT INTO "item_descriptions" VALUES(21613,'fr','Quand on rencontre le Dark Vlad au détour d''un sentier, mieux vaut prendre ses jambes à son cou et prier pour ne pas se faire attraper par le col, sous peine de finir comme une saucisse grillée.');
INSERT INTO "item_descriptions" VALUES(21613,'es','Si te cruzas con Dark Vlad por el camino, más vale que salgas por patas y reces para que no te agarre del cuello. O acabarás como una salchicha churruscada.');
INSERT INTO "item_descriptions" VALUES(21613,'pt','Quando encontrar Dark Vlad na curva de uma estrada, é melhor sair em disparada e rezar para que ele não pegue você pelo colarinho, senão você vai virar uma salsicha grelhada.');
INSERT INTO "item_descriptions" VALUES(21613,'de','Wenn man an einer Wegbiegung auf Dark Vlad trifft, sollte man besser die Beine in die Hand nehmen und beten, dass er einen nicht zu packen kriegt. Ansonsten könnte man als Grillwürstchen enden.');
INSERT INTO "item_descriptions" VALUES(21615,'en','Inside this wedding ring, you can make out an inscription engraved by a metal tip and the fire of passion: Hell Mina + Dark Vlad = <3.');
INSERT INTO "item_descriptions" VALUES(21615,'fr','À l''intérieur de cette alliance, vous pouvez discerner une inscription, gravée par une pointe en métal et le feu de la passion : Hell Mina +  Dark Vlad = <3');
INSERT INTO "item_descriptions" VALUES(21615,'es','En la cara interior de esta alianza puedes entrever una inscripción, grabada con una punta de metal y el fuego de la pasión: Hell Mina + Dark Vlad = <3');
INSERT INTO "item_descriptions" VALUES(21615,'pt','No interior desta aliança, você pode ver uma inscrição gravada por uma ponta de metal e pelo fogo da paixão: Hell Mina + Dark Vlad = <3');
INSERT INTO "item_descriptions" VALUES(21615,'de','Auf der Innenseite dieses Traurings könnt ihr eine Inschrift ausmachen, die mit einer Metallspitze und dem Feuer der Leidenschaft eingraviert wurde: Hell Mina + Dark Vlad = <3');
INSERT INTO "item_descriptions" VALUES(21617,'en','You may not have realised it, but the Ponym shield is named after the equally renowned e-ponym-ous Ponym shield.');
INSERT INTO "item_descriptions" VALUES(21617,'fr','Le bouclier Ponyme porte bien son nom, car il est tiré du fameux bouclier du même nom, le bouclier Ponyme.');
INSERT INTO "item_descriptions" VALUES(21617,'es','El escudo Mónimo se merece su nombre, ya que viene del famoso escudo del mismo nombre, el escudo Mónimo.');
INSERT INTO "item_descriptions" VALUES(21617,'pt','O Escudo Pônimo realmente faz jus ao nome, que foi tirado do famoso escudo de mesmo nome, o Escudo Pônimo.');
INSERT INTO "item_descriptions" VALUES(21617,'de','Der Gleichnam-Schild macht seinem Namen alle Ehre, denn er wurde nach dem berühmten gleichnamigen Schild „Gleichnam-Schild“ benannt.');
INSERT INTO "item_descriptions" VALUES(21619,'en','Under bleak skies as embers rise
The beetle''s steeled shell lies sealed
In shadowy realms where whispers dwell');
INSERT INTO "item_descriptions" VALUES(21619,'fr','Sous le ciel d''encre entre les cendres
Le fragile scarabée ferme sa carapace
Au royaume des ombres où dorment les mots.');
INSERT INTO "item_descriptions" VALUES(21619,'es','Bajo el cielo de seda entre las cenizas
El frágil escarabajo cierra su caparazón
En los dominios de las sombras donde duermen los sonidos');
INSERT INTO "item_descriptions" VALUES(21619,'pt','Sob o céu de tinta entre as cinzas,
O frágil escaravelho fecha sua carapaça,
No reino das sombras onde dormem as palavras.');
INSERT INTO "item_descriptions" VALUES(21619,'de','Unterm dunklen Himmel, in glimmernder Glut,
Verbarg sich der zarte Skarab in seinem Panzer
Im Reich der Schatten, wo Worte schlafen');
INSERT INTO "item_descriptions" VALUES(21621,'en','"Ruling means making it so your subjects cannot harm you... or even think about it."

— Danathor, Steward of Bonta');
INSERT INTO "item_descriptions" VALUES(21621,'fr','« Gouverner, c''est mettre vos sujets hors d''état de vous nuire, et même d''y penser. »

— Danathor, intendant de Bonta');
INSERT INTO "item_descriptions" VALUES(21621,'es','«Gobernar es impedir que tus súbditos te perjudiquen y que tampoco piensen en hacerlo».

— Danathor, intendente de Bonta');
INSERT INTO "item_descriptions" VALUES(21621,'pt','"Governar é impedir que seus súditos o prejudiquem ou até mesmo pensem em prejudicá-lo."

— Danathor, intendente de Bonta');
INSERT INTO "item_descriptions" VALUES(21621,'de','„Regieren heißt, dafür zu sorgen, dass euch eure Untertanen nicht schaden können, ja nicht einmal darüber nachdenken.“

– Danathor, Verwalter Bontas');
INSERT INTO "item_descriptions" VALUES(21623,'en','Scaly scales are as hard as Iops'' heads. This shield is covered in them, making it a must-have accessory for adventurers everywhere who like to jump carelessly into the fray.');
INSERT INTO "item_descriptions" VALUES(21623,'fr','Les écailles d''un Kailleu sont aussi dures qu''une tête de Iop. Ce bouclier en étant recouvert est un accessoire indispensable à tout aventurier aimant se jeter sans réfléchir dans la mêlée.');
INSERT INTO "item_descriptions" VALUES(21623,'es','Las escamas de un eskamoso son tan duras como la cabeza de un yopuka. Este escudo cubierto de ellas resulta ser un accesorio indispensable para cualquier aventurero al que le guste lanzarse al combate sin pensárselo ni un momento.');
INSERT INTO "item_descriptions" VALUES(21623,'pt','Escamas de Skamoso são tão duras quanto cabeça de Iop. Este escudo revestido é um acessório indispensável para qualquer aventureiro que adore se atirar no meio da pancadaria sem pensar duas vezes.');
INSERT INTO "item_descriptions" VALUES(21623,'de','Schuppi-Schuppen sind genauso hart wie der Schädel eines Iops. Dieser Schild ist ein unerlässliches Accessoire für jeden Abenteurer, der sich gern ohne weiter darüber nachzudenken in den Nahkampf stürzt.');
INSERT INTO "item_descriptions" VALUES(21625,'en','This shield was originally a plaything for sailors, who would toss it about when they were bored at sea.
You can still use it to protect yourself from a few blows, though – especially if they don''t hit you.');
INSERT INTO "item_descriptions" VALUES(21625,'fr','Ce bouclier est à l''origine un passe-temps pour marins, qui se font des passes avec lorsqu''ils s''ennuient en mer.
Vous pourrez toutefois vous protéger de quelques coups avec, surtout s''ils ne vous atteignent pas.');
INSERT INTO "item_descriptions" VALUES(21625,'es','Este escudo era originalmente un pasatiempo para los marineros, que se lo pasaban cuando estaban aburridos en el mar.
Aunque con él podrás protegerte de los golpes, sobre todo si no te alcanzan.');
INSERT INTO "item_descriptions" VALUES(21625,'pt','Este escudo é originalmente um passatempo para marinheiros, que o lançam entre si quando estão entediados no mar.
No entanto, você poderá se proteger de alguns golpes com ele, especialmente se eles não te atingirem.');
INSERT INTO "item_descriptions" VALUES(21625,'de','Eigentlich ist dieser Gegenstand kein Schild, sondern eine Art Wurfscheibe, mit der sich Seemänner auf besonders langweiligen Strecken die Zeit vertrieben haben.
Er schützt dennoch ganz gut vor Hieben, vor allem, wenn der Gegner nicht trifft.');
INSERT INTO "item_descriptions" VALUES(21627,'en','Revenge is a dish best served cold, as Hell Mina knows full well. That''s why she brings her Porribane along to every battle.');
INSERT INTO "item_descriptions" VALUES(21627,'fr','La vengeance est un plat qui se mange froid, et cela Hell Mina l''a bien compris. C''est pourquoi son Écu Hell l''accompagne dans chacune de ses batailles');
INSERT INTO "item_descriptions" VALUES(21627,'es','La venganza es un plato que se sirve frío, y Hell Mina lo tiene claro. Por eso su escuhell la acompaña en todas sus batallas.');
INSERT INTO "item_descriptions" VALUES(21627,'pt','A vingança é um prato que se come frio, e Hell Mina sabe muito bem disso. Por isso, ela carrega seu escudo Hell em todas as suas batalhas.');
INSERT INTO "item_descriptions" VALUES(21627,'de','Rache ist süß – besonders wenn man lange auf sie warten musste. Das ist Hell Mina wohl bewusst. Deshalb schleppt sie ihren Hellfeenden Wappenschild bei all ihren Kämpfen mit, auf dass er ihr helfen möge, endlich Rache zu nehmen – wenn nötig mit Feenkraft.');
INSERT INTO "item_descriptions" VALUES(21629,'en','If you were hoping this shield would "unlock your inner alpha", you''re definitely on the wrong track.
On the contrary, it reminds you of how primitive those who believe in the concept are.
But you''re nothing like that, right?');
INSERT INTO "item_descriptions" VALUES(21629,'fr','Si vous aviez espoir que ce bouclier réveille en vous une nature de mâle alpha, vous faites fausse route.
Il vous rappelle au contraire à quel point ce concept et ceux qui y adhèrent sont primitifs.
Heureusement, vous n''êtes pas comme ça, n''est-ce pas ?');
INSERT INTO "item_descriptions" VALUES(21629,'es','Si estabas esperando que este escudo despertase en ti un instinto de macho alfa, estás muy equivocado.
Más bien, te recuerda lo primitivos que son ese concepto y quienes se aferran a él.
Por fortuna, tú no eres así, ¿verdad?');
INSERT INTO "item_descriptions" VALUES(21629,'pt','Se você esperava que este escudo despertasse em você uma natureza de macho alfa, está enganado.
Pelo contrário: ele lhe lembra como são primitivos esse conceito e aqueles que nele acreditam.
Ainda bem que você não é assim, né?');
INSERT INTO "item_descriptions" VALUES(21629,'de','Wenn ihr die Hoffnung hegt, dass dieser Schild das Alpha-Männchen in euch wecken könnte, liegt ihr leider falsch.
Stattdessen ruft er euch nämlich in Erinnerung, wie primitiv dieses Konzept und jene, die ihm anhängen, wirklich sind.
Aber glücklicherweise seid ihr ja selbst nicht so, oder?');
CREATE TABLE item_extra_info (
            item INTEGER PRIMARY KEY,
            pods INTEGER,
            FOREIGN KEY (item) REFERENCES items(id)
        );
