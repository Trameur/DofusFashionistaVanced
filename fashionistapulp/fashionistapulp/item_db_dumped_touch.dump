INSERT INTO "item_descriptions" VALUES(12692,'en','This Trophy increases Fire attack damage. According to the label, it''s guaranteed to get you all fired up.');
INSERT INTO "item_descriptions" VALUES(12692,'fr','Ce Trophée augmente les dommages d''élément Feu. L''étiquette qui y était accrochée indiquait : "Grâce à lui vous êtes tout feu tout flamme et le coeur de votre ennemi s''enflamme".');
INSERT INTO "item_descriptions" VALUES(12692,'es','Este trofeo aumenta los daños del elemento fuego. En la etiqueta puede leerse: «Ardiente y resplandeciente, mata a tus enemigos en caliente».');
INSERT INTO "item_descriptions" VALUES(12692,'pt','Esse troféu aumenta os danos de ataque de Fogo. De acordo com a etiqueta, ele garante no mínimo uma labareda.');
INSERT INTO "item_descriptions" VALUES(12692,'de','Diese Trophäe erhöht den angerichteten Feuerschaden. Wenn ihr so Feuer und Flamme für euren Gegner seid, dann kann es sein, dass der das gar nicht gut findet.');
INSERT INTO "item_descriptions" VALUES(12693,'en','This Trophy increases Fire attack damage. According to the label, it''s guaranteed to get you all fired up.');
INSERT INTO "item_descriptions" VALUES(12693,'fr','Ce Trophée augmente les dommages d''élément Feu. L''étiquette qui y était accrochée indiquait : "Grâce à lui vous êtes tout feu tout flamme et le coeur de votre ennemi s''enflamme".');
INSERT INTO "item_descriptions" VALUES(12693,'es','Este trofeo aumenta los daños del elemento fuego. En la etiqueta puede leerse: «Ardiente y resplandeciente, mata a tus enemigos en caliente».');
INSERT INTO "item_descriptions" VALUES(12693,'pt','Esse troféu aumenta os danos de ataque de Fogo. De acordo com a etiqueta, ele garante no mínimo uma labareda.');
INSERT INTO "item_descriptions" VALUES(12693,'de','Diese Trophäe erhöht den angerichteten Feuerschaden. Wenn ihr so Feuer und Flamme für euren Gegner seid, dann kann es sein, dass der das gar nicht gut findet.');
INSERT INTO "item_descriptions" VALUES(12694,'en','This Trophy increases Fire attack damage. According to the label, it''s guaranteed to get you all fired up.');
