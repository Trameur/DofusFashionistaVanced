INSERT INTO "item_descriptions" VALUES(8236,'pt','Se você for mesmo pequeno,  esta capa feita com algumas penas de Piwi cobrirá o seu traseiro Uma proteção modesta que tirará atenção das pessoas a algo mais do que o seu cabelo gorduroso e as suas grandes verrugas.');
INSERT INTO "item_descriptions" VALUES(8236,'de','Nur wenn ihr klein genug seid, wird dieser Umhang aus zusammenbefestigten Tofufedern ausreichen, euer Hinterteil zu verbergen. Es ist zwar nur ein bescheidener Schutz, doch wird er viel dazu beitragen, die Aufmerksamkeit der anderen von euren fettigen Haaren oder dicken Warzen abzulenken');
INSERT INTO "item_descriptions" VALUES(8237,'en','This small belt will accentuate your hips if you''re fighting in front of important people. It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
INSERT INTO "item_descriptions" VALUES(8237,'fr','Cette petite ceinture mettra vos hanches en valeur l''espace d''un combat. Elle servira ensuite à contenir vos tripes lorsqu''un sanglier des plaines un peu énervé vous aura éventré au fin fond des bois.');
INSERT INTO "item_descriptions" VALUES(8237,'es','Este pequeño cinturón adornará maravillosamente tus caderas durante un combate. Después servirá para taparte las tripas cuando algún jabalí enfurecido te haya destripado en el bosque.');
INSERT INTO "item_descriptions" VALUES(8237,'pt','Este pequeno cinto deixará seus quadris mais livres durante uma luta. Então, ele será usado para firmar seu abdome quando um javali agressivo planejar rasgá-lo mata a dentro.');
INSERT INTO "item_descriptions" VALUES(8237,'de','Dieser kleine Gürtel wird eure Hüften beim nächsten Kampf mit Sicherheit voll zur Geltung bringen. Später kann er dann auch dazu dienen, eure Eingeweide festzuhalten, wenn euch ein aggressiver Keiler der Ebenen den Bauch aufgeschlitzt haben sollte.');
INSERT INTO "item_descriptions" VALUES(8238,'en','This small belt will accentuate your hips if you''re fighting in front of important people. It''s also handy for holding your guts in if a plain boar rips you open in the depths of a forest.');
