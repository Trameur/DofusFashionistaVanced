INSERT INTO "item_descriptions" VALUES(12637,'en','This Trophy allows you to escape from anyone who''s trying to limit your actions. It doesn''t work against lawyers.');
INSERT INTO "item_descriptions" VALUES(12637,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de limiter vos actions. Ne fonctionne pas contre les banquiers.');
INSERT INTO "item_descriptions" VALUES(12637,'es','Con este trofeo podrás escaparte de todos aquellos que quieran limitarte tus acciones. No funciona contra los banqueros.');
INSERT INTO "item_descriptions" VALUES(12637,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando limitar suas ações. Ele não funciona contra advogados.');
INSERT INTO "item_descriptions" VALUES(12637,'de','Diese Trophäe ermöglicht es euch, allen Versuchen eure Handlungsfähigkeit einzuschränken, zu entrinnen. Bankangestellte sind leider gegen sie immun.');
INSERT INTO "item_descriptions" VALUES(12638,'en','This Trophy allows you to escape from anyone who''s trying to limit your actions. It doesn''t work against lawyers.');
INSERT INTO "item_descriptions" VALUES(12638,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de limiter vos actions. Ne fonctionne pas contre les banquiers.');
INSERT INTO "item_descriptions" VALUES(12638,'es','Con este trofeo podrás escaparte de todos aquellos que quieran limitarte tus acciones. No funciona contra los banqueros.');
INSERT INTO "item_descriptions" VALUES(12638,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando limitar suas ações. Ele não funciona contra advogados.');
INSERT INTO "item_descriptions" VALUES(12638,'de','Diese Trophäe ermöglicht es euch, allen Versuchen eure Handlungsfähigkeit einzuschränken, zu entrinnen. Bankangestellte sind leider gegen sie immun.');
INSERT INTO "item_descriptions" VALUES(12639,'en','This Trophy allows you to escape from anyone who''s trying to limit your actions. It doesn''t work against lawyers.');
INSERT INTO "item_descriptions" VALUES(12639,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de limiter vos actions. Ne fonctionne pas contre les banquiers.');
INSERT INTO "item_descriptions" VALUES(12639,'es','Con este trofeo podrás escaparte de todos aquellos que quieran limitarte tus acciones. No funciona contra los banqueros.');
INSERT INTO "item_descriptions" VALUES(12639,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando limitar suas ações. Ele não funciona contra advogados.');
INSERT INTO "item_descriptions" VALUES(12639,'de','Diese Trophäe ermöglicht es euch, allen Versuchen eure Handlungsfähigkeit einzuschränken, zu entrinnen. Bankangestellte sind leider gegen sie immun.');
INSERT INTO "item_descriptions" VALUES(12640,'en','This Trophy enables you to do a bit more damage to an opponent when you push them against a tree, some debris or another enemy with a goatee.');
INSERT INTO "item_descriptions" VALUES(12640,'fr','Ce Trophée permet de faire un peu plus mal à vos adversaires lorsque vous les poussez contre un arbre, du marbre ou un autre adversaire glabre.');
INSERT INTO "item_descriptions" VALUES(12640,'es','Con este trofeo podrás hacerle más pupa a tus adversarios cuando los empujes contra un árbol, contra el mármol u otro adversario imberbe.');
INSERT INTO "item_descriptions" VALUES(12640,'pt','Esse troféu lhe permite causar um pouco mais de danos em adversários quando você os empurra contra uma árvore, detritos ou contra um inimigo com cavanhaque.');
INSERT INTO "item_descriptions" VALUES(12640,'de','Diese Trophäe erhöht den angerichteten Schubsschaden. Nur ein kleiner Schubs für euch, aber ein großer Schmerz für die Gegnerheit.');
INSERT INTO "item_descriptions" VALUES(12641,'en','This Trophy enables you to do a bit more damage to an opponent when you push them against a tree, some debris or another enemy with a goatee.');
INSERT INTO "item_descriptions" VALUES(12641,'fr','Ce Trophée permet de faire un peu plus mal à vos adversaires lorsque vous les poussez contre un arbre, du marbre ou un autre adversaire glabre.');
INSERT INTO "item_descriptions" VALUES(12641,'es','Con este trofeo podrás hacerle más pupa a tus adversarios cuando los empujes contra un árbol, contra el mármol u otro adversario imberbe.');
INSERT INTO "item_descriptions" VALUES(12641,'pt','Esse troféu lhe permite causar um pouco mais de danos em adversários quando você os empurra contra uma árvore, detritos ou contra um inimigo com cavanhaque.');
INSERT INTO "item_descriptions" VALUES(12641,'de','Diese Trophäe erhöht den angerichteten Schubsschaden. Nur ein kleiner Schubs für euch, aber ein großer Schmerz für die Gegnerheit.');
INSERT INTO "item_descriptions" VALUES(12642,'en','This Trophy enables you to do a bit more damage to an opponent when you push them against a tree, some debris or another enemy with a goatee.');
INSERT INTO "item_descriptions" VALUES(12642,'fr','Ce Trophée permet de faire un peu plus mal à vos adversaires lorsque vous les poussez contre un arbre, du marbre ou un autre adversaire glabre.');
INSERT INTO "item_descriptions" VALUES(12642,'es','Con este trofeo podrás hacerle más pupa a tus adversarios cuando los empujes contra un árbol, contra el mármol u otro adversario imberbe.');
INSERT INTO "item_descriptions" VALUES(12642,'pt','Esse troféu lhe permite causar um pouco mais de danos em adversários quando você os empurra contra uma árvore, detritos ou contra um inimigo com cavanhaque.');
INSERT INTO "item_descriptions" VALUES(12642,'de','Diese Trophäe erhöht den angerichteten Schubsschaden. Nur ein kleiner Schubs für euch, aber ein großer Schmerz für die Gegnerheit.');
INSERT INTO "item_descriptions" VALUES(12643,'en','This Trophy lessens your suffering a little when your opponents push you against a tree, a person, an animal or just something really big and hard. It does not protect you from blows, not even those dealt by calloused hands.');
INSERT INTO "item_descriptions" VALUES(12643,'fr','Ce Trophée permet de moins souffrir lorsque vos adversaires ou vos alliés vous poussent contre un arbre, une personne, une bestiole ou encore tout simplement un gros truc dur. Ne protège pas des gifles même celles prodiguées par des mains calleuses.');
INSERT INTO "item_descriptions" VALUES(12643,'es','Con este trofeo sufrirás menos cuando tus adversarios o tus aliados te empujen contra un árbol, una persona, un animal o simplemente contra un cosa grande y dura. No protege de las cachetadas provenientes de manos callosas.');
INSERT INTO "item_descriptions" VALUES(12643,'pt','Esse troféu diminui um pouco o seu sofrimento quando seus adversários empurram você contra uma árvore, pessoa, animal ou qualquer um que seja grande e fortão. Ele não o protege contra socos, nem mesmo aqueles desferidos por mãos cheias de calos.');
INSERT INTO "item_descriptions" VALUES(12643,'de','Diese Trophäe schützt euch vor Schubsschaden, wenn euch Gegner oder Verbündete mal wieder gegen den nächsten Baum klatschen wollen, oder Monster oder gar Baummonster.');
INSERT INTO "item_descriptions" VALUES(12644,'en','This Trophy lessens your suffering a little when your opponents push you against a tree, a person, an animal or just something really big and hard. It does not protect you from blows, not even those dealt by calloused hands.');
INSERT INTO "item_descriptions" VALUES(12644,'fr','Ce Trophée permet de moins souffrir lorsque vos adversaires ou vos alliés vous poussent contre un arbre, une personne, une bestiole ou encore tout simplement un gros truc dur. Ne protège pas des gifles même celles prodiguées par des mains calleuses.');
INSERT INTO "item_descriptions" VALUES(12644,'es','Con este trofeo sufrirás menos cuando tus adversarios o tus aliados te empujen contra un árbol, una persona, un animal o simplemente contra un cosa grande y dura. No protege de las cachetadas provenientes de manos callosas.');
INSERT INTO "item_descriptions" VALUES(12644,'pt','Esse troféu diminui um pouco o seu sofrimento quando seus adversários empurram você contra uma árvore, pessoa, animal ou qualquer um que seja grande e fortão. Ele não o protege contra socos, nem mesmo aqueles desferidos por mãos cheias de calos.');
INSERT INTO "item_descriptions" VALUES(12644,'de','Diese Trophäe schützt euch vor Schubsschaden, wenn euch Gegner oder Verbündete mal wieder gegen den nächsten Baum klatschen wollen, oder Monster oder gar Baummonster.');
INSERT INTO "item_descriptions" VALUES(12645,'en','This Trophy lessens your suffering a little when your opponents push you against a tree, a person, an animal or just something really big and hard. It does not protect you from blows, not even those dealt by calloused hands.');
INSERT INTO "item_descriptions" VALUES(12645,'fr','Ce Trophée permet de moins souffrir lorsque vos adversaires ou vos alliés vous poussent contre un arbre, une personne, une bestiole ou encore tout simplement un gros truc dur. Ne protège pas des gifles même celles prodiguées par des mains calleuses.');
INSERT INTO "item_descriptions" VALUES(12645,'es','Con este trofeo sufrirás menos cuando tus adversarios o tus aliados te empujen contra un árbol, una persona, un animal o simplemente contra un cosa grande y dura. No protege de las cachetadas provenientes de manos callosas.');
INSERT INTO "item_descriptions" VALUES(12645,'pt','Esse troféu diminui um pouco o seu sofrimento quando seus adversários empurram você contra uma árvore, pessoa, animal ou qualquer um que seja grande e fortão. Ele não o protege contra socos, nem mesmo aqueles desferidos por mãos cheias de calos.');
INSERT INTO "item_descriptions" VALUES(12645,'de','Diese Trophäe schützt euch vor Schubsschaden, wenn euch Gegner oder Verbündete mal wieder gegen den nächsten Baum klatschen wollen, oder Monster oder gar Baummonster.');
INSERT INTO "item_descriptions" VALUES(12646,'en','This Trophy protects you from Critical Hits in critical places at critical moments. Once it''s equipped, you will suffer a side effect which will really get on your friends'' nerves: You won''t be able to accept criticism.');
INSERT INTO "item_descriptions" VALUES(12646,'fr','Ce Trophée protège des coups critiques dans les endroits critiques lors des situations critiques. Une fois équipé, vous subirez un effet secondaire désagréable pour vos proches : vous ne subirez plus la critique.');
INSERT INTO "item_descriptions" VALUES(12646,'es','Este trofeo te protegerá de los golpes críticos, en los lugares críticos, en las situaciones críticas. Una vez equipado, experimentarás un efecto secundario desagradable para los que te conocen: no te afectarán las críticas.');
INSERT INTO "item_descriptions" VALUES(12646,'pt','Esse troféu protege você contra acertos críticos, em locais críticos e momentos críticos. Quando equipá-lo, você vai sofrer um efeito colateral que, com certeza, vai deixar seus amigos nervosos: não aceitará críticas.');
INSERT INTO "item_descriptions" VALUES(12646,'de','Diese Trophäe schützt euch vor kritischen Treffern an allen kritischen Körperstellen in kritischen Situationen. Allerdings hat dies auch einen unerwünschten Nebeneffekt für euer Umfeld: ihr habt dadurch nämlich massiv an Kritikfähigkeit eingebüßt...');
INSERT INTO "item_descriptions" VALUES(12647,'en','This Trophy protects you from Critical Hits in critical places at critical moments. Once it''s equipped, you will suffer a side effect which will really get on your friends'' nerves: You won''t be able to accept criticism.');
INSERT INTO "item_descriptions" VALUES(12647,'fr','Ce Trophée protège des coups critiques dans les endroits critiques lors des situations critiques. Une fois équipé, vous subirez un effet secondaire désagréable pour vos proches : vous ne subirez plus la critique.');
INSERT INTO "item_descriptions" VALUES(12647,'es','Este trofeo te protegerá de los golpes críticos, en los lugares críticos, en las situaciones críticas. Una vez equipado, experimentarás un efecto secundario desagradable para los que te conocen: no te afectarán las críticas.');
