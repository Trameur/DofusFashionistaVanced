INSERT INTO "item_descriptions" VALUES(13760,'en','This Trophy will make you so brainy that you''ll score a clean 3 on the Bwork Intelligence Scale, which runs from negative infinity to 1.');
INSERT INTO "item_descriptions" VALUES(13760,'fr','Ce Trophée vous rendra plus astucieux et vous permettra d''atteindre un score de 3 sur l''échelle de l''intelligence Bwork dont les bornes sont comprises entre moins l''infini et 1.');
INSERT INTO "item_descriptions" VALUES(13760,'es','Este trofeo te hará más inteligente y te ayudará a alcanzar una puntuación de 3 en la escala de inteligencia bwork, cuyos límites se sitúan entre el menos infinito y 1.');
INSERT INTO "item_descriptions" VALUES(13760,'pt','Esse troféu vai te deixar mais inteligente e, assim, você poderá alcançar o nível 3 na escala de inteligência Bwork, cujos limites se situam entre menos infinito e 1.');
INSERT INTO "item_descriptions" VALUES(13760,'de','Mit dieser Trophäe könnt ihr noch zu einem echten Pfiffikus werden. Auf der Bwork-Intelligenzskale von minus Unendlich bis 1 könnt ihr ein Niveau von 3 erreichen. Toll, oder?!');
INSERT INTO "item_descriptions" VALUES(13761,'en','This Trophy will make you so brainy that you''ll score a clean 3 on the Bwork Intelligence Scale, which runs from negative infinity to 1.');
