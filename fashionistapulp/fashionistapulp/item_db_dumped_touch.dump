INSERT INTO "item_descriptions" VALUES(8655,'pt','Este item já deu o que tinha que dar. Talvez você consiga ganhar uns kamas com algum comerciante simpático.');
INSERT INTO "item_descriptions" VALUES(8655,'de','Das Objekt hat schon viele Jahre auf dem Buckel. Bei einem wohlwollenden Händler könnt ihr es vielleicht gegen ein paar Kamas eintauschen.');
INSERT INTO "item_descriptions" VALUES(8656,'en','This item has served its purpose well. You might be able to get a few kamas for it from a kindly merchant.');
INSERT INTO "item_descriptions" VALUES(8656,'fr','Cet objet a bien fait son temps, vous pourrez peut-être en tirer quelque kamas auprès d''un commerçant affable.');
