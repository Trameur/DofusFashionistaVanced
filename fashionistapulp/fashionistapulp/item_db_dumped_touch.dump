INSERT INTO "item_descriptions" VALUES(13754,'en','This Trophy lets you play doctors and nurses with your allies, or with your enemies, if the fight''s too boring for words.');
INSERT INTO "item_descriptions" VALUES(13754,'fr','Ce Trophée vous permet de jouer au docteur avec vos alliés ou avec vos ennemis si vos combats sont trop faciles.');
INSERT INTO "item_descriptions" VALUES(13754,'es','Con este trofeo podrás jugar a los médicos con tus aliados y hasta con tus enemigos si el combate te resulta muy fácil.');
INSERT INTO "item_descriptions" VALUES(13754,'pt','Com esse troféu, você poderá brincar de médico com seus aliados ou inimigos, caso o combate esteja muito fácil.');
INSERT INTO "item_descriptions" VALUES(13754,'de','Dank dieser Trophäe könnt ihr mit euren Verbündeten oder mit euren Feinden Dokterspiele betreiben, wenn euch die Kämpfe zu leicht fallen.');
