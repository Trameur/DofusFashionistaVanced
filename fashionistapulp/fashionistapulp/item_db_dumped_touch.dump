INSERT INTO "item_descriptions" VALUES(13823,'en','Wind up this Trophy and you''ll be going strong all night! You''re never too old for the generation game.');
INSERT INTO "item_descriptions" VALUES(13823,'fr','La publicité de ce Trophée est plutôt explicite : "Pour une poignée de Kamas seulement, combattez l''impuissance et retrouvez votre vigueur d''antan."
A ne pas mettre entre toutes les mains.');
INSERT INTO "item_descriptions" VALUES(13823,'es','El anuncio de este trofeo es bastante claro: «Por tan solo un puñado de kamas, lucha contra la impotencia y recupero tu vigor de antaño».');
INSERT INTO "item_descriptions" VALUES(13823,'pt','A propaganda desse troféu já diz tudo: "Por apenas um punhado de Kamas, vença a impotência e recupere o seu vigor de antigamente."');
INSERT INTO "item_descriptions" VALUES(13823,'de','Die Werbung für diese Trophäe ist unmissverständlich: "Fühlt ihr euch machtlos? Dann holt euch jetzt, für nur eine Handvoll Kamas, eure verlorengegangene Macht wieder!"
Nicht für Jedermann geeignet!');
