INSERT INTO "item_descriptions" VALUES(13814,'en','This Trophy could save your life when your sect is on fire.');
INSERT INTO "item_descriptions" VALUES(13814,'fr','Ce Trophée pourrait vous sauver la vie dans le feu de l''action.');
INSERT INTO "item_descriptions" VALUES(13814,'es','Este trofeo te salvará la vida en caliente.');
INSERT INTO "item_descriptions" VALUES(13814,'pt','Esse troféu poderá te salvar contra o fogo de palha.');
INSERT INTO "item_descriptions" VALUES(13814,'de','Mit dieser Trophäe könnt ihr stets die Eisen aus dem Feuer holen.');
