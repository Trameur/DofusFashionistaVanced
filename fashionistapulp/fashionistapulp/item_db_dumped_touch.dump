INSERT INTO "item_descriptions" VALUES(13811,'en','This Trophy stops you from taking sides in combat and prevents you from potentially hurting yourself by casting a spell.');
INSERT INTO "item_descriptions" VALUES(13811,'fr','Ce Trophée vous empêchera de prendre des décisions en combat et vous ne pourrez plus vous blesser en tentant de lancer un sort.');
INSERT INTO "item_descriptions" VALUES(13811,'es','Debido a este trofeo no podrás tomar decisiones en combate aunque esto, a veces, hará que te veas con el agua al cuello.');
INSERT INTO "item_descriptions" VALUES(13811,'pt','Esse troféu te impedirá de tomar decisões em combate e você não se machucará mais quando tentar lançar um feitiço.');
INSERT INTO "item_descriptions" VALUES(13811,'de','Diese Trophäe hindert euch daran, Kampfentscheidungen zu treffen und senkt die Verletzungsgefahr, wenn ihr versucht einen Zauber zu wirken.');
