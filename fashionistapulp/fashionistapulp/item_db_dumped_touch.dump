INSERT INTO "item_descriptions" VALUES(8218,'pt','Este amuleto parece ter sido feito com uma pequena cabeça seca de Piwi. A aparência não tem preço.');
INSERT INTO "item_descriptions" VALUES(8218,'de','Dieses Amulett scheint aus einem kleinen getrockneten Piepmatzkopf zu bestehen. Heutzutage gibt es wohl keine Grenze mehr, wie weit manche für gutes Aussehen zu gehen bereit sind.');
INSERT INTO "item_descriptions" VALUES(8219,'en','This ring will allow your lover find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8219,'fr','Cet anneau permettra à votre maîtresse de vous retrouver, où que vous soyez.');
INSERT INTO "item_descriptions" VALUES(8219,'es','Este anillo permitirá a tu amante encontrarte, sea cual sea el lugar donde te encuentres.');
INSERT INTO "item_descriptions" VALUES(8219,'pt','Este anel permitirá que seu amado a encontre, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8219,'de','Dank dieses Rings wird eure Mätresse euch finden können, wo auch immer ihr euch gerade aufhaltet.');
INSERT INTO "item_descriptions" VALUES(8220,'en','This ring will allow your lover find you, no matter where you are.');
INSERT INTO "item_descriptions" VALUES(8220,'fr','Cet anneau permettra à votre maîtresse de vous retrouver, où que vous soyez.');
INSERT INTO "item_descriptions" VALUES(8220,'es','Este anillo permitirá a tu amante encontrarte, sea cual sea el lugar donde te encuentres.');
INSERT INTO "item_descriptions" VALUES(8220,'pt','Este anel permitirá à sua amada encontrá-lo, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8220,'de','Dank dieses Rings wird eure Mätresse euch finden können, wo auch immer ihr euch gerade aufhaltet.');
