INSERT INTO "item_descriptions" VALUES(8224,'pt','Este anel permite à seu amada encontrá-lo, não importa onde você esteja.');
INSERT INTO "item_descriptions" VALUES(8224,'de','Dank dieses Rings wird eure Mätresse euch finden können, wo auch immer ihr euch gerade aufhaltet.');
INSERT INTO "item_descriptions" VALUES(8225,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8225,'fr','Parfaites pour protéger votre petite voûte plantaire, ces sandales sont en outre parfaites pour écraser les petites créatures qui rampent entre les brins d''herbe, comme les Xélors ou les Eniripsas par exemple.');
INSERT INTO "item_descriptions" VALUES(8225,'es','Son perfectas para proteger la planta de tus pies. Estas sandalias también son prácticas para aplastar las pequeñas criaturas que reptan entre los mazorrales, como los xelors y los aniripsas por ejemplo...');
INSERT INTO "item_descriptions" VALUES(8225,'pt','Perfeitas para proteger seus pezinhos e esmagar pequenas criaturas rastejando entre as folhas de grama como Xelors ou Eniripsas por exemplo.');
INSERT INTO "item_descriptions" VALUES(8225,'de','Diese Schuhe sind perfekt dazu geeignet, kleine, kriechende Kreaturen zu zertreten, die zwischen den Grashalmen herumkriechen. Aber passt auf, dass ihr nicht versehentlich Xéloren oder Eniripsas dabei erwischt.');
INSERT INTO "item_descriptions" VALUES(8226,'en','They''re perfect for protecting your little feet and squashing small creatures that crawl through the grass, like Xelors or Eniripsas for example.');
INSERT INTO "item_descriptions" VALUES(8226,'fr','Parfaites pour protéger votre petite voûte plantaire, ces sandales sont en outre parfaites pour écraser les petites créatures qui rampent entre les brins d''herbe, comme les Xélors ou les Eniripsas par exemple.');
INSERT INTO "item_descriptions" VALUES(8226,'es','Son perfectas para proteger la planta de tus pies. Estas sandalias también son prácticas para aplastar las pequeñas criaturas que reptan entre los mazorrales, como los xelors y los aniripsas por ejemplo...');
INSERT INTO "item_descriptions" VALUES(8226,'pt','Elas são perfeitas para proteger seus pequenos pés e para esmagar pequenas criaturas que rastejam pela grama como Xelors ou Eniripsas, por exemplo.');
