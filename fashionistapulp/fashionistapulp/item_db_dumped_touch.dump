INSERT INTO "item_descriptions" VALUES(12704,'en','This Trophy increases the maximum weight you''re able to carry. It doesn''t make a heavy heart any easier to bear though.');
INSERT INTO "item_descriptions" VALUES(12704,'fr','Ce Trophée permet d''augmenter le poids maximum portable. Mais il n''est pas assez puissant pour vous aider à supporter le poids de votre conscience.');
INSERT INTO "item_descriptions" VALUES(12704,'es','Este trofeo aumenta el peso máximo que puedes cargar. Pero no es lo suficientemente potente para ayudarte a soportar el peso de tu conciencia.');
INSERT INTO "item_descriptions" VALUES(12704,'pt','Esse troféu aumenta o peso máximo que você pode carregar. Mas ele não alivia o peso da consciência.');
INSERT INTO "item_descriptions" VALUES(12704,'de','Diese Trophäe erhöht die Anzahl an Pods, die ihr tragen könnt. Aber das bedeutet noch lange nicht, dass sie die schweren Schuldgefühle erleichtern kann, die euer Gewissen so drücken!');
