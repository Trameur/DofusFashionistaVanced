INSERT INTO "item_descriptions" VALUES(12722,'en','This trophy increases your Strength. Unfortunately, it doesn''t increase strength of mind though.');
INSERT INTO "item_descriptions" VALUES(12722,'fr','Ce Trophée permet d''augmenter la Force. Attention cet objet ne peut pas convenir pour remplacer un cerveau déficient.');
INSERT INTO "item_descriptions" VALUES(12722,'es','Con este trofeo podrás aumentar la fuerza. Aviso: este objeto no sirve para reemplazar un cerebro defectuoso.');
INSERT INTO "item_descriptions" VALUES(12722,'pt','Esse troféu aumenta a sua Força. Infelizmente, ele não aumenta o poder da sua mente.');
INSERT INTO "item_descriptions" VALUES(12722,'de','Diese Trophäe erhöht eure Stärke. Ihr solltet euch jedoch nicht allzuviel über eure Siege bei Pöbeleien einbilden. Schließlich heißt es nicht umsonst: "Der Klügere gibt nach"... und nicht der Stärkere.');
