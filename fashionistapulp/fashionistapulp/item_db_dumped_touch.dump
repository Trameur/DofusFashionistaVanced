INSERT INTO "item_descriptions" VALUES(12634,'en','This Trophy allows you to escape from anyone who''s trying to prevent you from reaching your destination. This doesn''t work against those who are trying to prevent you from reaching your destiny though.');
INSERT INTO "item_descriptions" VALUES(12634,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de vous empêcher d''atteindre votre destination. Ne fonctionne pas contre ceux qui vous empêchent d''atteindre votre destinée.');
INSERT INTO "item_descriptions" VALUES(12634,'es','Con este trofeo podrás escaparte de todos aquellos que quieran impedirte alcanzar tu destinación. Por otra parte, no funciona contra aquellos que quieran impedirte alcanzar tu destino.');
INSERT INTO "item_descriptions" VALUES(12634,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando evitar que você chegue a algum lugar. Mas ele não funciona contra aqueles que estão tentando evitar que você chegue ao seu destino.');
INSERT INTO "item_descriptions" VALUES(12634,'de','Diese Trophäe ermöglicht es euch, all denen zu entkommen, die euch daran hindern wollen, euren Bestimmungsort zu erreichen. Das bedeutet aber noch lange nicht, dass ihr deswegen auch an euer Ziel kommt...');
INSERT INTO "item_descriptions" VALUES(12635,'en','This Trophy allows you to escape from anyone who''s trying to prevent you from reaching your destination. This doesn''t work against those who are trying to prevent you from reaching your destiny though.');
INSERT INTO "item_descriptions" VALUES(12635,'fr','Ce Trophée permet d''échapper à tous ceux qui essayent de vous empêcher d''atteindre votre destination. Ne fonctionne pas contre ceux qui vous empêchent d''atteindre votre destinée.');
INSERT INTO "item_descriptions" VALUES(12635,'es','Con este trofeo podrás escaparte de todos aquellos que quieran impedirte alcanzar tu destinación. Por otra parte, no funciona contra aquellos que quieran impedirte alcanzar tu destino.');
INSERT INTO "item_descriptions" VALUES(12635,'pt','Esse troféu lhe permite fugir de qualquer um que esteja tentando evitar que você chegue a algum lugar. Mas ele não funciona contra aqueles que estão tentando evitar que você chegue ao seu destino.');
INSERT INTO "item_descriptions" VALUES(12635,'de','Diese Trophäe ermöglicht es euch, all denen zu entkommen, die euch daran hindern wollen, euren Bestimmungsort zu erreichen. Das bedeutet aber noch lange nicht, dass ihr deswegen auch an euer Ziel kommt...');
