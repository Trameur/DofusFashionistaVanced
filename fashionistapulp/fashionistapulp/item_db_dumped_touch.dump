INSERT INTO "item_descriptions" VALUES(12625,'en','This Trophy lets you escape when the opportune moment presents itself.');
INSERT INTO "item_descriptions" VALUES(12625,'fr','Ce Trophée permet de se sauver au bon comme au mauvais moment.');
INSERT INTO "item_descriptions" VALUES(12625,'es','Con este trofeo podrás largarte tanto en los buenos como en los malos momentos.');
INSERT INTO "item_descriptions" VALUES(12625,'pt','Esse troféu permite que você escape quando o momento oportuno se apresentar.');
INSERT INTO "item_descriptions" VALUES(12625,'de','Diese Trophäe ermöglicht es euch, Reißaus zu nehmen, wenn sich ein P vor die sicher geglaubte Lage schiebt oder gar ein K auf euch  zu kommt.');
