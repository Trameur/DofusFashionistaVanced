INSERT INTO "item_descriptions" VALUES(19413,'en','That pitiful slip on a banana skin was just a stunt to make your friends laugh. No one believed you, but everyone had a good laugh anyway.');
INSERT INTO "item_descriptions" VALUES(19413,'fr','Cette chute lamentable sur une peau de banane était une cascade destinée à faire rire vos amis. Personne ne vous croit, mais tout le monde a bien rigolé.');
INSERT INTO "item_descriptions" VALUES(19413,'es','Aquella lamentable caída por una piel de plátano era una situación pensada para que tus amigos se partieran de risa. Nadie te cree, pero todos se rieron de lo lindo.');
INSERT INTO "item_descriptions" VALUES(19413,'pt','Aquela escorregada na casca de banana era só uma acrobacia para fazer seus amigos rirem. Ninguém acreditou, mas todo mundo achou engraçado.');
INSERT INTO "item_descriptions" VALUES(19413,'de','Dieser jämmerliche Sturz auf einer Bananenschale war beabsichtigt, um eure Freunde vor Lachen zum Weinen bringen. Niemand glaubt euch, aber alle haben herrlich gelacht.');
