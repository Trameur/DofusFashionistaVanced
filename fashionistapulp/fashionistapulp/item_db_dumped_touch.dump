INSERT INTO "item_descriptions" VALUES(12631,'en','This Trophy enables you to oppress your aggressors more easily. It also seems to work on digressers.');
INSERT INTO "item_descriptions" VALUES(12631,'fr','Ce Trophée permet d''engourdir plus facilement les dégourdis. Il semble fonctionner sur les gourdes également.');
INSERT INTO "item_descriptions" VALUES(12631,'es','Con este trofeo podrás atontar a los más espabilados. También parece funcionar con los zoquetes.');
INSERT INTO "item_descriptions" VALUES(12631,'pt','Esse troféu permite que você oprima seus agressores mais facilmente. Ele parece funcionar em qualquer um.');
INSERT INTO "item_descriptions" VALUES(12631,'de','Diese Trophäe macht müde Männer m...träge. Frauen auch.');
