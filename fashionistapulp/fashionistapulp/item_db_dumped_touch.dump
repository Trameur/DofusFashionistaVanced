INSERT INTO "item_descriptions" VALUES(12686,'en','This Trophy increases Air attack damage in those who are full of hot air.');
INSERT INTO "item_descriptions" VALUES(12686,'fr','Ce Trophée augmente les dommages d''élément Air de ceux qui ne manquent pas d''air.');
INSERT INTO "item_descriptions" VALUES(12686,'es','Este trofeo aumenta los daños del elemento aire de los que tienen muchos aires.');
INSERT INTO "item_descriptions" VALUES(12686,'pt','Esse troféu aumenta os danos de ataque de Ar naqueles que gostam de café a vácuo.');
INSERT INTO "item_descriptions" VALUES(12686,'de','Diese Trophäe erhöht den angerichteten Luftschaden. So könnt ihr eurem Gegner den Chaossatz mit dem Flügelschlag und dadurch ausgelösten Hurrikan anschaulich beweisen.');
INSERT INTO "item_descriptions" VALUES(12687,'en','This Trophy increases Air attack damage in those who are full of hot air.');
