INSERT INTO "extra_lines" VALUES(21629,X'8005953E000000000000005D948C374C616E6365206C6520736F727420426F75636C69657220496EC3A96272616E6C61626C6520617520646562757420647520636F6D62617494612E','fr');
INSERT INTO "extra_lines" VALUES(21629,X'80059546000000000000005D948C3F4C616E7A6120656C2068656368697A6F2045736375646F20496E7175656272616E7461626C6520616C207072696E636970696F2064656C20636F6D6261746594612E','es');
INSERT INTO "extra_lines" VALUES(21629,X'80059541000000000000005D948C3A4C616EC3A761206F206665697469C3A76F2045736375646F20496E6162616CC3A176656C206E6F20696EC3AD63696F20646F20636F6D6261746594612E','pt');
INSERT INTO "extra_lines" VALUES(21629,X'80059548000000000000005D948C415769726B74207A7520426567696E6E20646573204B616D706665732064656E205A617562657220556E6572736368C3BC747465726C696368657220536368696C6494612E','de');
CREATE TABLE item_descriptions (
            item INTEGER,
            language TEXT,
            description TEXT,
            PRIMARY KEY (item, language),
            FOREIGN KEY (item) REFERENCES items(id)
        );
INSERT INTO "item_descriptions" VALUES(42,'en','This basic sword won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(42,'fr','Epée de simple facture, elle ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(42,'es','Espada de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(42,'pt','Esta espada clássica não fará de você um herói, pode ter certeza!');
INSERT INTO "item_descriptions" VALUES(42,'de','Dieses Schwert einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(47,'en','This well-forged sword is ideal for beginners.');
INSERT INTO "item_descriptions" VALUES(47,'fr','Une épée bien forgée, intéressante pour les novices.');
INSERT INTO "item_descriptions" VALUES(47,'es','Una espada bien forjada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(47,'pt','Uma espada bem forjada, ideal para os novatos.');
INSERT INTO "item_descriptions" VALUES(47,'de','Dieses liebevoll geschmiedete Schwert ist besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(53,'en','Forged by a Fencing Master, this sword will make a hero of you if you know how to handle it... However, be careful, the sword comes with a curse - it always falls down a well. Eventually, here or there, it''ll fall down a well. Don''t even try to avoid wells... you could be in a bloody desert and THIS SWORD WOULD FALL DOWN A WELL. Got it?');
INSERT INTO "item_descriptions" VALUES(53,'fr','Cette épée très prisée des jeunes Iops, vous permettra peut-être de faire vos preuves. Mais attention, leur propriétaire, une fois équipé, finit toujours par perdre l''Epée d''Alle.');
INSERT INTO "item_descriptions" VALUES(53,'es','Puede que esta espada muy buscada por los jóvenes yopukas te permita hacer tus pruebas. Pero cuidado, una vez que su propietario se haya equipado con ella, acabará inevitablemente por volverse un poco chiflado.');
INSERT INTO "item_descriptions" VALUES(53,'pt','Forjada por um mestre na esgrima, esta espada fará de você um herói, se souber como manuseá-la... Esta espada, muito apreciada por jovens lops, pode permitir que você prove seu valor. Mas cuidado, uma vez equipada, tira pontos do seu possuidor.');
INSERT INTO "item_descriptions" VALUES(53,'de','Dieses von jungen Iops sehr gepriesene Schwert ist das Erkennungszeichen eines wahren Kriegers. Doch Vorsicht: Nach längerem Tragen kann es leicht vorkommen, dass man es irgendwann einfach irgendwo fallen lässt.');
INSERT INTO "item_descriptions" VALUES(58,'en','This sword, soaked in a young Boowolf''s tears, is said to bring luck and is supposed to fill warriors with courage on the battlefield. Ah, the naivety of terror.');
INSERT INTO "item_descriptions" VALUES(58,'fr','Il s''agit d''une épée ayant baigné dans les larmes d''un jeune Mulou. Beaucoup de guerriers pensent qu''ainsi bénie, leur arme apportera chance et courage sur les champs de bataille.');
INSERT INTO "item_descriptions" VALUES(58,'es','Se trata aquí de una espada que ha sido bañada en lágrimas de un joven mediulubo. Muchos guerreros piensan que al estar bendita de esta manera, su arma les traerá suerte y valor en los campos de batalla.');
INSERT INTO "item_descriptions" VALUES(58,'pt','Essa espada está ensopada com as lágrimas de um jovem Boolofo. Muitos guerreiros acreditam que traz sorte e dá coragem no campo de batalha.');
INSERT INTO "item_descriptions" VALUES(58,'de','Dieses Schwert wurde in den Tränen eines jungen WuWulfs getränkt. Viele Krieger glauben, das bringe ihnen Glück und Mut auf dem Schlachtfeld. Sie sind ja so naiv...');
INSERT INTO "item_descriptions" VALUES(60,'en','This is an extremely well-forged sword, and will make you a worthy adversary. Your enemies will pant audibly when you enter the arena.');
INSERT INTO "item_descriptions" VALUES(60,'fr','D''excellente facture, l''épée d''Ha fera de vous un vaillant combattant. Sa seule vue angoisse doublement le plus courageux des adversaires.');
INSERT INTO "item_descriptions" VALUES(60,'es','De excelente factura, la espada Dha hará de ti un valiente guerrero. Incluso los más valientes de tus adversarios se estremecerán al verla.');
INSERT INTO "item_descriptions" VALUES(60,'pt','Esta bela espada faz de você um lutador corajoso. A mera visão desta espada causa agonia no mais imponente dos inimigos.');
INSERT INTO "item_descriptions" VALUES(60,'de','Dieses Schwert ausgezeichneter Machart wird aus euch einen tapferen Krieger machen. Denn der alleinige Anblick entmutigt gleich doppelt auch die tapfersten eurer Gegner.');
INSERT INTO "item_descriptions" VALUES(65,'en','The sword Goultard was quenched in the blood of a Dragon Pig. The hero who can resist the sword''s powerful stench will find himself climbing the social ladder very quickly indeed.');
INSERT INTO "item_descriptions" VALUES(65,'fr','L''épée Goultard a été trempée dans le sang d''un Dragon Cochon. Le héros qui supportera l''odeur dégagée par cette puissante épée pourra se hisser à la hauteur des plus grands.');
INSERT INTO "item_descriptions" VALUES(65,'es','La espada Gúltar ha sido sumergida en sangre de Dragocerdo. El héroe que consiga soportar el olor que desprende esta poderosa espada podrá rivalizar con los más grandes.');
INSERT INTO "item_descriptions" VALUES(65,'pt','A Espada Goultard foi mergulhada em sangue de Dragão Porco. O herói que resiste ao cheiro desta poderosa será capaz de avançar na escada social.');
INSERT INTO "item_descriptions" VALUES(65,'de','Da es gleich nach dem Schmieden im Blut eines Schweinedrachens abgeschreckt wurde, hat das Goultard einen eigentümlichen Geruch an sich. Riecht es nach Drachendung? Nach Schweineurin? Schwer zu sagen. Hat sich jedoch der Träger erst einmal an den Gestank gewöhnt, kann er sich mit diesem mächtigen Schwert mit den besten aller Kämpfer messen.');
INSERT INTO "item_descriptions" VALUES(66,'en','This sword captures the sights, the sounds and the smells of Badoul, the brave, bloodthirsty and above all punctual warrior who one day left his clan due to artistic differences.');
INSERT INTO "item_descriptions" VALUES(66,'fr','Cette épée appartenait au célèbre Badoul, vaillant guerrier ayant perdu la boule lors d''un combat.');
INSERT INTO "item_descriptions" VALUES(66,'es','Esta espada pertenecía al célebre Badulo, un valiente guerrero que perdió la cabeza durante un combate.');
INSERT INTO "item_descriptions" VALUES(66,'pt','Esta espada pertenceu ao famoso Badoul, valente guerreiro que, durante uma luta, adormeceu em sua cadeira de balanço.');
INSERT INTO "item_descriptions" VALUES(66,'de','Dieses Schwert gehörte einst dem tapferen Badoul, der nach einem Kopftreffer geistig umnachtet ist.');
INSERT INTO "item_descriptions" VALUES(67,'en','Sharp and diabolical: these were the wide-eyed words of the succubus who fathered this deadly little minx. Minx? Fathered? Damn, that was the page about Vald''s sister. Sorry about that.');
INSERT INTO "item_descriptions" VALUES(67,'fr','Tranchante et infernale : tels ont été les mots de la succube qui l''a forgée. À moins que ce ne soit les mots utilisés par Vald pour décrire sa sœur, plus personne ne sait.');
INSERT INTO "item_descriptions" VALUES(67,'es','Afilada e infernal: estas fueron las palabras del súcubo que la forjó. A no ser que sean las palabras que utilizó Vald para describir a su hermana.. ya nadie sabría decir con certeza cuál es la historia auténtica.');
INSERT INTO "item_descriptions" VALUES(67,'pt','Afiada e diabólica: essas são as palavras do súcubo que a forjou. A menos que estas foram as palavras que Vald usou para descrever sua irmã, ninguém sabe de verdade.');
INSERT INTO "item_descriptions" VALUES(67,'de','Höllisch scharf: so äußerte sich der Succubus zufrieden mit seinem Werk nach Erschaffung dieser Waffe. Vielleicht waren das aber auch die Worte, mit denen Vald seine Schwester beschrieb. So genau weiß man das nicht mehr.');
INSERT INTO "item_descriptions" VALUES(74,'en','This amulet increases the wearer''s Strength.');
INSERT INTO "item_descriptions" VALUES(74,'fr','Cette amulette augmente la force de son porteur');
INSERT INTO "item_descriptions" VALUES(74,'es','Este amuleto aumenta la fuerza de su portador.');
INSERT INTO "item_descriptions" VALUES(74,'pt','Este amuleto aumenta a força do seu portador.');
INSERT INTO "item_descriptions" VALUES(74,'de','Dieses Amulett erhöht die Stärke seines Trägers.');
INSERT INTO "item_descriptions" VALUES(82,'en','This amulet increases the wearer''s Vitality.');
INSERT INTO "item_descriptions" VALUES(82,'fr','Cette amulette augmente la vitalité de son porteur.');
INSERT INTO "item_descriptions" VALUES(82,'es','Este amuleto aumenta la vitalidad de su portador.');
INSERT INTO "item_descriptions" VALUES(82,'pt','Este amuleto aumenta a vitalidade do seu portador.');
INSERT INTO "item_descriptions" VALUES(82,'de','Dieses Amulett erhöht die Vitalität seines Trägers.');
INSERT INTO "item_descriptions" VALUES(89,'en','This basic bow won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(89,'fr','Arc de simple facture, il ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(89,'es','Arco de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(89,'pt','Sem chance de se tornar uma lenda com este clássico arco.');
INSERT INTO "item_descriptions" VALUES(89,'de','Dieser Bogen einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(95,'en','This basic pair of daggers won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(95,'fr','Dagues de simple facture, elles ne feront pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(95,'es','Dagas de sencilla factura, no convertirán a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(95,'pt','Estas adagas básicas não farão de você um herói, pode ter certeza!');
INSERT INTO "item_descriptions" VALUES(95,'de','Diese Dolche einfachster Machart werden aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(101,'en','This ring increases the wearer''s Wisdom.');
INSERT INTO "item_descriptions" VALUES(101,'fr','Cet anneau renforce la sagesse de son porteur.');
INSERT INTO "item_descriptions" VALUES(101,'es','Este anillo refuerza la sabiduría de su portador.');
INSERT INTO "item_descriptions" VALUES(101,'pt','Este anel reforça a sabedoria de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(101,'de','Dieser Ring erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(110,'en','This ring increases the wearer''s chance.');
INSERT INTO "item_descriptions" VALUES(110,'fr','Cet anneau renforce la chance de son porteur.');
INSERT INTO "item_descriptions" VALUES(110,'es','Este anillo refuerza la suerte de su portador.');
INSERT INTO "item_descriptions" VALUES(110,'pt','Este anel reforça a sorte de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(110,'de','Dieser Ring erhöht das Glück seines Trägers.');
INSERT INTO "item_descriptions" VALUES(119,'en','This ring increases the wearer''s Agility.');
INSERT INTO "item_descriptions" VALUES(119,'fr','Cet anneau augmente l''agilité de son porteur.');
INSERT INTO "item_descriptions" VALUES(119,'es','Este anillo aumenta la agilidad de su portador.');
INSERT INTO "item_descriptions" VALUES(119,'pt','Este anel aumenta a agilidade de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(119,'de','Dieser Ring erhöht die Flinkheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(127,'en','These exceptional boots will grant you an extra Movement Point in combat. However, the smell of Bowisse''s feet will quickly stop you in your tracks again if you accidentally bring them too close to your nose.');
INSERT INTO "item_descriptions" VALUES(127,'fr','Ces bottes exceptionnelles vous permettront de gagner un point de mouvement durant les combats.
Attention cependant aux odeurs qu''elles dégagent, car elles ont appartenu au tristement célèbre Bowisse.');
INSERT INTO "item_descriptions" VALUES(127,'es','Estas Botas excepcionales te permitirán ganar un punto de movimiento durante los combates. 
Pero ten cuidado con el olor que desprenden porque pertenecieron al desgraciadamente famoso Bowis.');
INSERT INTO "item_descriptions" VALUES(127,'pt','Com estas botas excepcionais, você ganhará um ponto de movimento durante as lutas. Mas tenha cuidado para não inalar o cheiro que exalam, porque elas pertenceram ao notório Bowisse.');
INSERT INTO "item_descriptions" VALUES(127,'de','Diese außergewöhnlichen Stiefel erhöhen eure Bewegungsrate im Kampf. Doch hütet euch vor dem furchtbaren Gestank, den sie absondern. Sie haben nämlich einst dem berüchtigten Bowissen gehört.');
INSERT INTO "item_descriptions" VALUES(129,'en','These boots are so comfortable that they instantly increase your concentration.');
INSERT INTO "item_descriptions" VALUES(129,'fr','Ces bottes sont si confortables qu''elles permettent au héros qui les chausse d''accroître sa concentration.');
INSERT INTO "item_descriptions" VALUES(129,'es','Estas botas son tan cómodas que permiten que el héroe que las calza se concentre mejor.');
INSERT INTO "item_descriptions" VALUES(129,'pt','Estas botas são tão confortáveis que aumentam a concentração do portador.');
INSERT INTO "item_descriptions" VALUES(129,'de','Diese Stiefel nehmen ihrem Träger einige geistige Arbeit ab, weshalb sie ein Muss für jeden Iop sind.');
INSERT INTO "item_descriptions" VALUES(130,'en','These boots are perfect for that special coup de grace.');
INSERT INTO "item_descriptions" VALUES(130,'fr','Ces bottes sont idéales lorsqu''il s''agit d''asséner un coup de grâce.');
INSERT INTO "item_descriptions" VALUES(130,'es','Estas botas son ideales cuando se trata de rematar a un adversario.');
INSERT INTO "item_descriptions" VALUES(130,'pt','Estas botas são perfeitas para dar um toque de graça.');
INSERT INTO "item_descriptions" VALUES(130,'de','Diese Stiefel sind einfach ideal, wenn es mal wieder darum geht, einem Gegner den Gnadenstoß zu verpassen.');
INSERT INTO "item_descriptions" VALUES(132,'en','This basic wand won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(132,'fr','Baguette de simple facture, elle ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(132,'es','Varita de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(132,'pt','Esta varinha mágica básica não fará de você um herói, pode ter certeza!');
INSERT INTO "item_descriptions" VALUES(132,'de','Dieser Stab einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(138,'en','This basic staff won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(138,'fr','Bâton de simple facture, il ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(138,'es','Bastón de sencilla factura, no convertirá a tu héroe en leyenda.');
INSERT INTO "item_descriptions" VALUES(138,'pt','Este cajado clássico não fará de você um herói, pode ter certeza!');
INSERT INTO "item_descriptions" VALUES(138,'de','Dieser Stock einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(145,'en','This basic hammer won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(145,'fr','Marteau de simple facture, il ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(145,'es','Martillo de sencilla factura, no hará de tu héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(145,'pt','Este martelo básico não fará de você um herói, pode ter certeza!');
INSERT INTO "item_descriptions" VALUES(145,'de','Dieser Hammer einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(151,'en','This basic shovel won''t make a hero out of you, that''s for sure.');
INSERT INTO "item_descriptions" VALUES(151,'fr','Pelle de simple facture, elle ne fera pas de votre héros une légende.');
INSERT INTO "item_descriptions" VALUES(151,'es','Pala de simple factura, no hará de su héroe una leyenda.');
INSERT INTO "item_descriptions" VALUES(151,'pt','Esta pá básica não fará de você um herói, pode ter certeza!');
INSERT INTO "item_descriptions" VALUES(151,'de','Diese Schaufel einfachster Machart wird aus eurem Charakter bestimmt keinen Helden machen.');
INSERT INTO "item_descriptions" VALUES(156,'en','This Power Belt will render you particularly powerful during fights but its weight will considerably decrease your Agility.');
INSERT INTO "item_descriptions" VALUES(156,'fr','La Ceinture de Puissance rend son porteur particulièrement puissant lors des combats, mais son poids réduit de manière conséquente son agilité.');
INSERT INTO "item_descriptions" VALUES(156,'es','El cinturón de Potencia incrementa la potencia de su dueño durante los combates aunque su peso reduce sustancialmente su agilidad.');
INSERT INTO "item_descriptions" VALUES(156,'pt','Com esse cinto de poder, você ficará especialmente poderoso durante batalhas, mas seu peso diminui consideravelmente sua agilidade.');
INSERT INTO "item_descriptions" VALUES(156,'de','Dieser Gürtel erhöht erheblich die Kampfkraft seines Trägers. Leider wirkt sich sein hohes Gewicht dabei ein wenig negativ auf dessen Flinkheit aus. Aber wer will schon vor dem Gegner weglaufen?');
INSERT INTO "item_descriptions" VALUES(157,'en','The Gougnole is made of a moon stone that was marinated for 5,000 years in a barrel of beer. This has inevitably endowed it with terrific powers.');
INSERT INTO "item_descriptions" VALUES(157,'fr','La Gougnole a été créée dans de la pierre de lune ayant trempé 5000 ans dans un baril de bière. Inévitablement, cela lui a conféré de terribles pouvoirs.');
INSERT INTO "item_descriptions" VALUES(157,'es','El Etirujo ha sido creado con piedra de luna que estuvo al remojo durante 5000 años dentro de un barril de cerveza. Inevitablemente, eso le confirió terribles poderes.');
INSERT INTO "item_descriptions" VALUES(157,'pt','O Gougnole foi feito da pedra de lua que permaneceu 5 mil longos anos em um barril de cerveja.
Inevitavelmente, este tratamento o dotou com terríveis poderes.');
INSERT INTO "item_descriptions" VALUES(157,'de','Das Geschnapsel wurde aus einem Stück Mondstein gefertigt, welches über 5.000 Jahre in einem Fass Schnaps verbracht hatte. Da ist fast vorprogrammiert, dass dies dem Amulett große Macht verleiht.');
INSERT INTO "item_descriptions" VALUES(158,'en','The Golden Destiny will considerably increase your Vitality and Agility.');
INSERT INTO "item_descriptions" VALUES(158,'fr','La Destinée Dorée permet au héros qui la porte d''augmenter considérablement sa vitalité et son agilité.');
INSERT INTO "item_descriptions" VALUES(158,'es','El Destino Dorado permite aumentar considerablemente la agilidad y la vitalidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(158,'pt','Com o Destino Dourado, o herói pode aumentar consideravelmente sua vitalidade e agilidade.');
INSERT INTO "item_descriptions" VALUES(158,'de','Die goldene Zukunft erhöht erheblich die Flinkheit und Vitalität ihres Trägers.');
INSERT INTO "item_descriptions" VALUES(159,'en','People say the famous blacksmith Boulgur made this brooch. Yes, the guy who created weapons for the gods.');
INSERT INTO "item_descriptions" VALUES(159,'fr','On dit que cette broche a été créée par l''illustre forgeron Boulgur, qui a la réputation de forger les armes des dieux.');
INSERT INTO "item_descriptions" VALUES(159,'es','Dicen que este broche ha sido creado por el ilustre herrero Bulguro que tiene fama de forjar las armas de los dioses.');
INSERT INTO "item_descriptions" VALUES(159,'pt','Dizem que este broche foi feito pelo famoso ferreiro Boulgur, aquele que criou armas para os deuses.');
INSERT INTO "item_descriptions" VALUES(159,'de','Man sagt, diese Brosche sei vom berühmten Schmied Bulgur höchstpersönlich gefertigt worden, dem man nachsagt, sogar die mächtigen Waffen der Götter zu schmieden.');
INSERT INTO "item_descriptions" VALUES(160,'en','This amulet, cast in a mixture of celestial eggs and milky stardust, must be kept refrigerated.');
INSERT INTO "item_descriptions" VALUES(160,'fr','Cet objet a été moulé à partir d''un mélange d''œufs célestes et de poussières d''étoiles lactées. À conserver au frais.');
INSERT INTO "item_descriptions" VALUES(160,'es','Este objeto ha sido moldeado a partir de una mezcla de huevos celestes y polvo de estrellas lácteas. Consérvese en frío.');
INSERT INTO "item_descriptions" VALUES(160,'pt','Este objeto foi conjurado a partir de uma mistura de ovos celestiais com pó lácteo de estrela. Manter refrigerado.');
INSERT INTO "item_descriptions" VALUES(160,'de','Dieser seltene Gegenstand wurde aus einer Mischung aus Sternenstaub der Milchstraße und Himmelseiern hergestellt. Daher immer kühl aufbewahren!');
INSERT INTO "item_descriptions" VALUES(161,'en','This powerful amulet will certainly make a name for you.');
INSERT INTO "item_descriptions" VALUES(161,'fr','Cette puissante amulette a tout pour rendre son porteur célèbre.');
INSERT INTO "item_descriptions" VALUES(161,'es','Este poderoso amuleto lo tiene todo para que su portador se vuelva famoso.');
INSERT INTO "item_descriptions" VALUES(161,'pt','Este poderoso amuleto certamente fará seu portador famoso.');
INSERT INTO "item_descriptions" VALUES(161,'de','Dieses mächtige Amulett wird mit Sicherheit den Träger zu einer Berühmt-Berüchtigtheit machen.');
INSERT INTO "item_descriptions" VALUES(163,'en','A well-carved wand, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(163,'fr','Une baguette bien sculptée, intéressante pour les novices.');
INSERT INTO "item_descriptions" VALUES(163,'es','Una varita muy bien esculpida, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(163,'pt','Uma varinha mágica bem esculpida, recomendada para novatos.');
INSERT INTO "item_descriptions" VALUES(163,'de','Ein wohlgeschnitzter Stab, der besonders für Anfänger interessant ist.');
INSERT INTO "item_descriptions" VALUES(180,'en','This wand comes from the Syrastass Limbo. The legends say that it can make entire fields of daisies bloom, if asked politely by its bearer.');
INSERT INTO "item_descriptions" VALUES(180,'fr','Cette baguette provient des Limbes de Syrastass. La légende raconte qu''elle permet de faire fleurir des champs entiers de pâquerettes à la simple demande de son porteur.');
INSERT INTO "item_descriptions" VALUES(180,'es','Esta varita viene del Limbo de Syrastass. Cuenta la leyenda que su portador puede hacer que florezcan campos enteros de margaritas con la simple fuerza de su voluntad.');
INSERT INTO "item_descriptions" VALUES(180,'pt','Esta varinha vem do Limbo de Syrastass. Diz a lenda que se pode fazer campos inteiros de margaridas florescerem, a pedido de seu proprietário.');
INSERT INTO "item_descriptions" VALUES(180,'de','Dieser Stab stammt aus dem tiefsten Limbo von Syrastass. Der Legende nach kann er auf bloßen Wunsch seines Trägers ganze Felder von Osterglocken zum Erblühen bringen.');
INSERT INTO "item_descriptions" VALUES(181,'en','Helle from High in the Sky blessed this wand. It gives its bearer Agility and Vitality in combat.');
INSERT INTO "item_descriptions" VALUES(181,'fr','Cette baguette fut bénie par Helle du haut des cieux. Elle procure à son porteur agilité et vitalité dans les batailles.');
INSERT INTO "item_descriptions" VALUES(181,'es','Esta varita ha sido bendecida por Hella desde lo más alto del cielo. Proporciona agilidad y vitalidad a su portador durante las batallas.');
INSERT INTO "item_descriptions" VALUES(181,'pt','Esta varinha foi abençoada por Helle do Alto dos Céus. Ela dá a seu portador agilidade e vitalidade durante as lutas.');
INSERT INTO "item_descriptions" VALUES(181,'de','Dieser Stab wurde von Helle aus den obersten Himmelsphären gesegnet. Er verleiht daher seinem Träger Flinkheit und Vitalität im Kampf.');
INSERT INTO "item_descriptions" VALUES(183,'en','A well-carved staff, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(183,'fr','Un bâton bien taillé, intéressant pour les novices.');
INSERT INTO "item_descriptions" VALUES(183,'es','Un bastón bien tallado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(183,'pt','Um cajado bem esculpido, recomendável para novatos.');
INSERT INTO "item_descriptions" VALUES(183,'de','Dieser schön zurechtgeschnitzte Stock ist besonders für Anfänger gut geeignet.');
INSERT INTO "item_descriptions" VALUES(188,'en','This staff increases Wisdom. It has one awkward side effect... I''m sure you can guess.');
INSERT INTO "item_descriptions" VALUES(188,'fr','Ce bâton augmente la sagesse de son porteur. Peut entraîner une hypertrophie.');
INSERT INTO "item_descriptions" VALUES(188,'es','Este bastón aumenta la sabiduría de quien lo posea. Puede provocar una hipertrofia.');
INSERT INTO "item_descriptions" VALUES(188,'pt','Este cajado aumenta a vitalidade de quem possuí-lo. Pode guiá-lo a uma forma de hipertrofia.');
INSERT INTO "item_descriptions" VALUES(188,'de','Dieser Stab erhöht die Weisheit seines Trägers. Risiken und Nebenwirkungen: Kann zu einer Hypertrophie führen, daher nur in Maßen verwenden.');
INSERT INTO "item_descriptions" VALUES(194,'en','This staff increases Vitality and can be eaten if required.');
INSERT INTO "item_descriptions" VALUES(194,'fr','Ce bâton augmente la vitalité de son porteur et peut, le cas échéant, être mangé.');
INSERT INTO "item_descriptions" VALUES(194,'es','Este bastón aumenta la vitalidad de quien lo posea. También es comestible.');
INSERT INTO "item_descriptions" VALUES(194,'pt','Este cajado aumenta a vitalidade de quem possuí-lo e pode ser comido, se necessário.');
INSERT INTO "item_descriptions" VALUES(194,'de','Dieser Stock erhöht nicht nur die Vitalität seines Trägers, er kann notfalls sogar gegessen werden.');
INSERT INTO "item_descriptions" VALUES(200,'en','The God Rod is a fearsome weapon. Warriors have been known to win battles in their sleep with the aid of this... fearsome weapon.');
INSERT INTO "item_descriptions" VALUES(200,'fr','Le God Rod est une arme terrible. Très puissant, il permet à son porteur de se montrer digne des meilleurs lorsqu''il a une petite baisse de régime.');
INSERT INTO "item_descriptions" VALUES(200,'es','El God Rod es un arma terrible. Es tan poderosa que logra que su portador sea de los mejores hasta cuando le da un bajón.');
INSERT INTO "item_descriptions" VALUES(200,'pt','A Vara Deus é uma arma perigosa. Muito poderosa, seu portador pode ser louvável até mesmo em caso de exaustão.');
INSERT INTO "item_descriptions" VALUES(200,'de','Der Gott-Stock ist eine extrem mächtige Waffe. Selbst wenn ihr gerade mal eine kleine Schwäche verspürt, dann wird seine große Macht euch immer noch den Besten der Besten mindestens ebenbürtig sein lassen.');
INSERT INTO "item_descriptions" VALUES(201,'en','The Hook was found on a corpse, near a huge, decomposing Crocodyl.');
INSERT INTO "item_descriptions" VALUES(201,'fr','Le Hook a été retrouvé sur un cadavre, près d''un énorme Crocodaille en décomposition.');
INSERT INTO "item_descriptions" VALUES(201,'es','El Hook ha sido encontrado en un cadáver, cerca de un enorme cocodrail en descomposición.');
INSERT INTO "item_descriptions" VALUES(201,'pt','O Hook foi encontrado em um corpo, perto do grande Crocodyl em decomposição.');
INSERT INTO "item_descriptions" VALUES(201,'de','Hook wurde bei einer Leiche gefunden, die direkt neben den Überresten eines gewaltigen, halb-verwesten Crocodylls lag.');
INSERT INTO "item_descriptions" VALUES(202,'en','This sword was blessed by the tears of the angel Raziel. Terribly destructive, it''s powerful enough to help you fend off the most fearsome of enemies.');
INSERT INTO "item_descriptions" VALUES(202,'fr','Cette épée a été bénie par les larmes de l''ange Raziel. Terriblement destructrice elle est suffisamment puissante pour permettre à son porteur d''affronter le plus terrible des adversaires.');
INSERT INTO "item_descriptions" VALUES(202,'es','Esta espada ha sido bendecida con las lágrimas del ángel Raziel. Es terriblemente destructora y suficientemente poderosa para permitir que su portador se pueda enfrentar al más terrible de los adversarios.');
INSERT INTO "item_descriptions" VALUES(202,'pt','Esta espada foi abençoada pelas lágrimas de Raziel, o anjo. Terrivelmente destrutiva, é poderosa o bastante para atacar os mais fortes inimigos.');
INSERT INTO "item_descriptions" VALUES(202,'de','Dieses Schwert wurde durch die Tränen des Engels Raziel geweiht. Es ist einfach nur himmlisch zerstörerisch und seine Macht reicht aus, um auch die mächtigsten aller Gegner mühelos besiegen zu können.');
INSERT INTO "item_descriptions" VALUES(203,'en','If you ever work out how to get this incredible item around your waist, you''ll be one of the luckiest heroes in the universe. It used to belong to the strongest and most attractive of the bearded heroes of old.');
INSERT INTO "item_descriptions" VALUES(203,'fr','Si vous avez ce formidable objet autour des reins, c''est que vous êtes l''un des héros les plus chanceux de cet univers. Cette ceinture appartenait au héros barbu le plus fort et séduisant de tous les temps.');
INSERT INTO "item_descriptions" VALUES(203,'es','Si tienes este increíble objeto alrededor de la cintura es que eres uno de los héroes más afortunados de este universo. Este cinturón pertenecía al héroe barbudo más fuerte y seductor de todos los tiempos.');
INSERT INTO "item_descriptions" VALUES(203,'pt','Se tiver este incrível item em volta da cintura, quer dizer que você é um dos heróis mais sortudos deste universo. Este cinto pertenceu ao mais forte e mais atraente herói barbudo.');
INSERT INTO "item_descriptions" VALUES(203,'de','Wenn ihr diesen großartigen Gürtel um die Taille tragt, so bedeutet dies, dass ihr ein echtes Glückskind seid. Dieser Gürtel gehörte nämlich einst einem berühmt-berüchtigten haarigen Riesen, dem stärksten Helden und unwiderstehlichstem Frauenhelden aller Zeiten.');
INSERT INTO "item_descriptions" VALUES(204,'en','This living staff roamed the darkest corners of Amakna for aeons. Now it sleeps deeply, only waking up every 300 years to move to a different place or to look for a different owner. It favours the stench of small, sweaty tunnels.');
INSERT INTO "item_descriptions" VALUES(204,'fr','Ce bâton vivant a traîné dans les endroits les plus sombres de l''univers d''Amakna. Il se réveille tous les 300 ans pour changer d''endroit ou de propriétaire, préférant emprunter les petits tunnels tout sombres, qui ne sentent pas très bon.');
INSERT INTO "item_descriptions" VALUES(204,'es','Este bastón viviente ha estado en los lugares más oscuros del universo de Amakna. Se despierta cada 300 años para cambiar de sitio o de dueño. Prefiere pasar por los pequeños túneles muy oscuros que no huelen muy bien.');
INSERT INTO "item_descriptions" VALUES(204,'pt','Este cajado animado vagou pelos locais mais sombrios do universo de Amakna. Ele desperta a cada 300 anos para se mover para um local diferente ou procurar um novo dono, prefere os túneis pequenos e escudos que não cheiram muito bem.');
INSERT INTO "item_descriptions" VALUES(204,'de','Dieser lebende Stecken hängt immer an den düsterlichsten Orten von ganz Amakna herum. Alle 300 Jahre ändert er Ort und Besitzer, wobei er es vorzieht, immer möglichst dunkle und übelriechende Tunnel und Gänge zu nehmen.');
INSERT INTO "item_descriptions" VALUES(206,'en','These well-forged daggers are recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(206,'fr','Des dagues bien forgées, intéressantes pour les novices.');
INSERT INTO "item_descriptions" VALUES(206,'es','Unas dagas bien forjadas, interesantes para los novatos.');
INSERT INTO "item_descriptions" VALUES(206,'pt','Adagas bem forjadas, ideais para iniciantes.');
INSERT INTO "item_descriptions" VALUES(206,'de','Diese liebevoll geschmiedeten Dolche sind besonders für Anfänger sehr gut geeignet.');
INSERT INTO "item_descriptions" VALUES(212,'en','These well-forged daggers will make a worthy adversary of you.');
INSERT INTO "item_descriptions" VALUES(212,'fr','D''excellente facture, les Dagues de Croclage feront de vous un vaillant combattant.');
INSERT INTO "item_descriptions" VALUES(212,'es','De excelente factura, estas Dagas de Croclage harán de ti un valiente guerrero.');
INSERT INTO "item_descriptions" VALUES(212,'pt','Adagas muito bem forjadas que farão de você um valente lutador.');
INSERT INTO "item_descriptions" VALUES(212,'de','Diese hervorragend gearbeiteten Dolche werden aus euch einen tapferen Kämpfer machen. Bestimmt!');
INSERT INTO "item_descriptions" VALUES(218,'en','Bashers are formidable daggers favoured by assassins who must dispatch the most bloodthirsty of warriors.');
INSERT INTO "item_descriptions" VALUES(218,'fr','Les Bashers sont de redoutables dagues d''assassin. Celui qui les possède est capable de rivaliser avec le plus sanguinaire des guerriers.');
INSERT INTO "item_descriptions" VALUES(218,'es','Las Bashers son unas temibles dagas de asesino. El que las posea es capaz de rivalizar con el más sanguinario de los guerreros.');
INSERT INTO "item_descriptions" VALUES(218,'pt','As Basheres são adagas formidáveis para infiltradores. Os que as possuem podem vencer os mais sanguinários dos guerreiros.');
INSERT INTO "item_descriptions" VALUES(218,'de','Basher sind fürchterliche Waffen, gut geeignet für jeden Meuchelmörder. Ihr Träger wird mit ihnen manch einem blutrünstigen Kämpfer mindestens ebenbürtig sein.');
INSERT INTO "item_descriptions" VALUES(219,'en','These Blessdags once belonged to the renowned Ogre ''Dark Hand'' who died while fighting a Bimd''Oole paladin. Apparently, his blood animates their twisted blades.');
INSERT INTO "item_descriptions" VALUES(219,'fr','Les Blessdags viennent du célèbre Ogre la Main Sombre qui périt en affrontant un paladin du Bimd''Oule. Il paraît que son sang anime ces dagues malsaines.');
INSERT INTO "item_descriptions" VALUES(219,'es','Las Blessdags pertenecían al célebre Ogro Mano Oscura que murió luchando contra un paladín del Bimd''Ulo. Dicen que su sangre es la que le da vida a estas malvadas dagas.');
INSERT INTO "item_descriptions" VALUES(219,'pt','As Blessadagas pertenceram ao renomado Ogro “Mão Escura”, que morreu enquanto lutava contra o cavaleiro do Bimd''Oole. Aparentemente, o sangue dele anima estas belas adagas doentes.');
INSERT INTO "item_descriptions" VALUES(219,'de','Die Blessurdolche gehörten einst dem berüchtigten Dunkelhand-Oger, der umkam, als er einen Bimd Oul-Paladin angriff. Man munkelt, sein Blut würde nun diese bösartigen Dolche beleben, doch konnte das bis heute noch niemand beweisen.');
INSERT INTO "item_descriptions" VALUES(220,'en','The Chakra Style... a pair of daggers that once belonged to the greatest female thief of all time. Chakra was the first to open the doors of the Osaroth Temple and steal the precious relics hidden within.');
INSERT INTO "item_descriptions" VALUES(220,'fr','Chakra Style est une paire de dagues ayant appartenu à l''une des plus grandes voleuses de tous les temps. Chakra fut la première à pouvoir forcer les portes du temple d''Osaroth et à y dérober de précieuses reliques.');
INSERT INTO "item_descriptions" VALUES(220,'es','Las Chakra Style son un par de dagas que pertenecieron a una de las mayores ladronas de todos los tiempos. Chakra fue la primera en conseguir forzar las puertas del templo de Osaroth para robar las preciosas reliquias que había dentro.');
INSERT INTO "item_descriptions" VALUES(220,'pt','O Estilo de Chakra é um par de adagas que pertenceram à maior ladina de todos os tempos. Chakra foi a primeira a conseguir arrombar as portas do Templo de Osaroth e roubar as relíquias preciosas escondidas lá.');
INSERT INTO "item_descriptions" VALUES(220,'de','Chakra Style sind zwei Schwesterdolche, die einst einer berüchtigten Diebin Amaknas gehörten. Sie war so gut, dass sie es sogar schaffte, die Schlösser der Türen zum Tempel Osaroths zu knacken und einige der wertvollsten Reliquien von dort mitgehen zu lassen!');
INSERT INTO "item_descriptions" VALUES(222,'en','A well-forged hammer, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(222,'fr','Un marteau bien travaillé, intéressant pour les novices.');
INSERT INTO "item_descriptions" VALUES(222,'es','Un martillo bien trabajado, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(222,'pt','Um martelo bem forjado, interessante para iniciantes.');
INSERT INTO "item_descriptions" VALUES(222,'de','Ein wohlgeschmiedeter Hammer, der gerade für Anfänger sehr interessant ist.');
INSERT INTO "item_descriptions" VALUES(228,'en','This hammer increases its bearer''s intelligence.');
INSERT INTO "item_descriptions" VALUES(228,'fr','Ce marteau augmente l''intelligence du héros qui le porte.');
INSERT INTO "item_descriptions" VALUES(228,'es','Este martillo aumenta la inteligencia del héroe que lo posea.');
INSERT INTO "item_descriptions" VALUES(228,'pt','Este martelo aumenta a inteligência de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(228,'de','Dieser Hammer erhöht die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(233,'en','Kaiser was the name of the dastardly Dragon Pig who destroyed Bounkaïda Village many years ago. When the militia got the better of this monster, the smiths used his remains to make weapons. This hammer is one of them.');
INSERT INTO "item_descriptions" VALUES(233,'fr','Kaiser est le nom d''un Dragon Cochon qui jadis dévasta le village de Bounkaïda. Lorsque la milice eut enfin raison du monstre, les forgerons créèrent de nombreuses armes à partir des restes de la bête. Ce marteau en fait partie.');
INSERT INTO "item_descriptions" VALUES(233,'es','Kaiser es el nombre de un Dragocerdo que antiguamente devastó el pueblo de Bunkaida. Cuando la milicia consiguió finalmente acabar con el monstruo, los herreros crearon numerosas armas a partir de los restos del animal. Este martillo forma parte de ellas.');
INSERT INTO "item_descriptions" VALUES(233,'pt','Kaiser era o nome do Dragão Porco que destruiu a Vila de Bounkaïda há muito tempo. Quando a milícia já tinha conseguido extrair o melhor deste monstro, os ferreiros usam os restos de Kaiser para criar várias armas. Este martelo é uma delas.');
INSERT INTO "item_descriptions" VALUES(233,'de','Kaiser ist der Name des Schweinedrachens, welcher einst das Dorf Bounkaïda dem Erdboden gleichmachte. Nachdem ihn die Milizen endlich überwältigt hatten, nutzten viele Schmiede Teile des Drachens, um daraus Waffen zu machen. U.a. entstand dabei dieser Hammer.');
INSERT INTO "item_descriptions" VALUES(234,'en','Ragnarok is powerful enough to raise a storm. It can also raise the temper of your friends if you don''t know how to use it properly.');
INSERT INTO "item_descriptions" VALUES(234,'fr','Le Ragnarok est un marteau très puissant, capable de déchaîner des tempêtes ou les foudres de vos alliés si vous leur tapez dessus.');
INSERT INTO "item_descriptions" VALUES(234,'es','El Ragnarok es un martillo muy poderoso, capaz de desencadenar tormentas o también capaz de atormentar a tus aliados si no sabes utilizarlo.');
INSERT INTO "item_descriptions" VALUES(234,'pt','O Ragnarok é poderoso o bastante para invocar uma tempestade. Também é verdade que, se você enfrentá-lo, despertará a ira de suas forças aliadas.');
INSERT INTO "item_descriptions" VALUES(234,'de','Ragnarok ist ein wirklich sehr mächtiger Hammer, der in der Lage ist Unwetter auszulösen... oder vor Wut blitzende Augen bei euren Verbündeten, falls diese versehentlich von ihm getroffen wurden.');
INSERT INTO "item_descriptions" VALUES(235,'en','This hammer once belonged to the guardian of the Door of Hell. He prevented the living from coming in, the dead from going out and the living dead from urinating through the letterbox. Dirty monkeys!');
INSERT INTO "item_descriptions" VALUES(235,'fr','Ce marteau était détenu par le gardien de la Porte des Enfers. Il empêchait les vivants d''y entrer, les morts d''en sortir et les morts-vivants de bouger.');
INSERT INTO "item_descriptions" VALUES(235,'es','Este martillo pertenecía al guardián de la Puerta de los Infiernos. Impedía que los vivos entrasen, que los muertos saliesen y que los muerto vivos se moviesen.');
INSERT INTO "item_descriptions" VALUES(235,'pt','Este martelo pertenceu ao guardião da Porta do Inferno. Ele prevenia os vivos de entrarem, os mortos de saírem e os mortos-vivos de se moverem.');
INSERT INTO "item_descriptions" VALUES(235,'de','Dieser Hammer hat einst dem Wächter zum Tor der Hölle gehört. Er verhinderte damit, dass die Lebenden dort hineingehen, die Toten herauskommen und sich die lebenden Toten überhaupt vom Fleck bewegen.');
INSERT INTO "item_descriptions" VALUES(236,'en','Barabas is a fearsome weapon: it allows its wearer to move with stealth and ease and most importantly, to become even deadlier in close combat.');
INSERT INTO "item_descriptions" VALUES(236,'fr','Barabas est redoutable : il permet à son porteur de se déplacer plus facilement, et surtout d''être plus efficace en combat rapproché.');
INSERT INTO "item_descriptions" VALUES(236,'es','Barabas es una temible arma: permite que su portador se desplace más fácilmente y sobre todo, ser más eficaz en el combate de cuerpo a cuerpo.');
INSERT INTO "item_descriptions" VALUES(236,'pt','Barabas é uma arma perigosa: ela permite ao seu portador mover-se mais facilmente e, acima de tudo, ser mais eficiente em combates corpo-a- corpo.');
INSERT INTO "item_descriptions" VALUES(236,'de','Barabas ist wirklich furchterregend: Er ermöglicht es dem Träger, sich leichtfüßig zu bewegen und ist sehr wirkungsvoll im Nahkampf.');
INSERT INTO "item_descriptions" VALUES(237,'en','Sargasse once belonged to a child with fearsome powers. No one has seen it since it was reportedly traded for a bag of marbles.');
INSERT INTO "item_descriptions" VALUES(237,'fr','Sargasse était détenue par un enfant aux terribles pouvoirs. On ne sait pas ce qu''est devenue cette arme lorsqu''elle fut échangée à un aventurier contre un sac de billes.');
INSERT INTO "item_descriptions" VALUES(237,'es','Un niño con terribles poderes guardaba Sargas como un tesoro. No se sabe lo que pasó con esta arma desde que un aventurero se la cambió por una bolsa de canicas.');
INSERT INTO "item_descriptions" VALUES(237,'pt','Sargasse pertenceu a uma criança com terríveis poderes. Nenhum rastro dela podia ser encontrado até o momento; tinha sido trocado por um saco de bolas de gude.');
INSERT INTO "item_descriptions" VALUES(237,'de','Sargass befand sich einst in den Händen eines Kindes mit furchterregenden Kräften. Allerdings weiß niemand, wer diese Waffe nun besitzt, seitdem das Kind sie bei einem Abenteurer gegen einen Sack Murmeln eingetauscht hat.');
INSERT INTO "item_descriptions" VALUES(239,'en','A well-balanced shovel, recommended for beginners.');
INSERT INTO "item_descriptions" VALUES(239,'fr','Une pelle bien équilibrée, intéressante pour les novices.');
INSERT INTO "item_descriptions" VALUES(239,'es','Una pala bien equilibrada, interesante para los novatos.');
INSERT INTO "item_descriptions" VALUES(239,'pt','Uma pá bem equilibrada, interessante para novatos.');
INSERT INTO "item_descriptions" VALUES(239,'de','Eine gut ausgewogene Schaufel, die besonders für Anfänger gut geeignet ist.');
INSERT INTO "item_descriptions" VALUES(245,'en','An extremely well-forged shovel, this tool will make a worthy adversary of you.');
INSERT INTO "item_descriptions" VALUES(245,'fr','D''excellente facture, la pelle de rapage fera de vous un vaillant combattant.');
INSERT INTO "item_descriptions" VALUES(245,'es','De excelente factura, la pala de raspage hará de ti un luchador audaz.');
INSERT INTO "item_descriptions" VALUES(245,'pt','Uma pá bem forjada que despertará um valente guerreiro adormecido em você.');
INSERT INTO "item_descriptions" VALUES(245,'de','Diese Schaufel hervorragender Machart wird aus eurem Charakter bestimmt einen tapferen Kämpfer machen.');
INSERT INTO "item_descriptions" VALUES(250,'en','Halfway between an axe and a shovel, Axel was one of the seven weapons used by the demon Kajlir to overcome the Brotherhood of the Enutrofs, vicious adventurers searching for the Crimson Dofus.');
INSERT INTO "item_descriptions" VALUES(250,'fr','Mi-hache, mi-pelle, Ares fut l''une des sept armes utilisées par le démon Kajlir pour venir à bout de la Confrérie des Enutrofs collectionneurs de Dofus Pourpres.');
INSERT INTO "item_descriptions" VALUES(250,'es','Medio hacha, medio pala, Ares fue una de las siete armas utilizadas por el demonio Kajlir para acabar con la ACDP (la cofradía de los Anutrofs Coleccionistas de Dofus Púrpuras).');
INSERT INTO "item_descriptions" VALUES(250,'pt','Algo entre um machado e uma pá, Ares foi uma das sete armas usadas pelo demônio Kajlir para dominar a Fraternidade dos Enutrofs coletores do Dofus Púrpuro.');
INSERT INTO "item_descriptions" VALUES(250,'de','Ares mit seinem seltsamen Aussehen auf halbem Wege zwischen einer Axt und einer Schaufel war eine der sieben Waffen, die der Dämon Kajlir zum Besiegen der "Bruderschaft der Purpur-Dofus sammelnden Enutrofs" verwendet hat.');
INSERT INTO "item_descriptions" VALUES(251,'en','Greybeard was the favourite weapon of the demon-dwarf Assan Cehef who terrorised countless villages with his surprise attacks.');
INSERT INTO "item_descriptions" VALUES(251,'fr','Barbe Grise était l''arme favorite du démon nain Assan Cehef, qui terrorisa de nombreux villageois, attaquant sans crier "gare", ni "train".');
INSERT INTO "item_descriptions" VALUES(251,'es','Barba Gris era el arma favorita del demonio enano Tehle Fónika, que aterrorizó a numerosos campesinos atacándoles a cobro revertido y gritando «¡Si te mueves, te cuelgo!».');
INSERT INTO "item_descriptions" VALUES(251,'pt','Barba Grisalha foi a arma favorita do demônio anão Assan Cehef, que aterrorizou muitos moradores de vilarejos atacando de surpresa.');
INSERT INTO "item_descriptions" VALUES(251,'de','Graubart war die Lieblingswaffe des Dämonenzwerges (oder Zwergdämonen?), der viele Dorfbewohner terrorisierte. Ohne "Vorsicht" zu rufen griff er ihre Dörfer an und zwar ohne Rücksicht, so dass sie danach die Nachsicht hatten.');
INSERT INTO "item_descriptions" VALUES(253,'en','This belt increases its wearer''s Vitality, increasing their chances of surviving a fight.');
INSERT INTO "item_descriptions" VALUES(253,'fr','Cette ceinture augmente la vie de son porteur, pour plus de sûreté en plein combat.');
INSERT INTO "item_descriptions" VALUES(253,'es','Este cinturón aumenta la vida del que lo lleve puesto, para mayor seguridad en pleno combate.');
INSERT INTO "item_descriptions" VALUES(253,'pt','Este cinto aumenta a vida de quem o usar. Isso certamente será para você se sentir mais seguro durante as lutas.');
INSERT INTO "item_descriptions" VALUES(253,'de','Dieser Gürtel erhöht die Lebenskraft seines Trägers und garantiert so eine geringfügig längere Haltbarkeit im Kampf.');
INSERT INTO "item_descriptions" VALUES(257,'en','This belt increases its wearer''s Strength.');
INSERT INTO "item_descriptions" VALUES(257,'fr','Cette ceinture augmente la force de son porteur.');
INSERT INTO "item_descriptions" VALUES(257,'es','Este cinturón aumenta la fuerza de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(257,'pt','Este cinto aumenta a força de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(257,'de','Dieser Gürtel erhöht die Stärke seines Trägers.');
INSERT INTO "item_descriptions" VALUES(261,'en','This belt increases its wearer''s Agility.');
INSERT INTO "item_descriptions" VALUES(261,'fr','Cette ceinture augmente l''agilité de son porteur.');
INSERT INTO "item_descriptions" VALUES(261,'es','Este cinturón aumenta la agilidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(261,'pt','Este cinto aumenta a agilidade do seu portador.');
INSERT INTO "item_descriptions" VALUES(261,'de','Dieser Gürtel erhöht die Flinkheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(267,'en','The Disconcerting Bow is not new by any means, but it can be very useful.');
INSERT INTO "item_descriptions" VALUES(267,'fr','L''arc déroutant est un objet de base, mais son utilité n''est pas à négliger.');
INSERT INTO "item_descriptions" VALUES(267,'es','El Arco Desconcertante es un objeto básico, pero no se debe despreciar su utilidad.');
INSERT INTO "item_descriptions" VALUES(267,'pt','O Arco Perturbador é uma arma básica mas isso não significa que ela não se deve ao interesse...');
INSERT INTO "item_descriptions" VALUES(267,'de','Dieser Bogen mag zwar sehr einfach gehalten sein, doch ist er trotzdem sehr nützlich.');
INSERT INTO "item_descriptions" VALUES(270,'en','Xaver is an efficient bow. It once belonged to the great baker Xavier. Between two batches, he used it to distribute bread to the monsters around his bakery.');
INSERT INTO "item_descriptions" VALUES(270,'fr','Le Xaveur est un arc efficace. Il appartenait au grand Xavier le Boulanger. Entre deux fournées, il partait distribuer des pains aux monstres entourant sa boulangerie.');
INSERT INTO "item_descriptions" VALUES(270,'es','El Javiador es un arco eficaz. Pertenecía al gran Javier el Panadero. Entre dos hornadas, se marchaba a repartir tortas entre los monstruos que rodeaban su panadería.');
INSERT INTO "item_descriptions" VALUES(270,'pt','O Xaveur é um arco eficiente. Ele já pertenceu uma vez ao Grande Padeiro Xavier. Entre duas remessas, ele tomava o tempo de distribuir pão aos monstros que cercavam sua padaria.');
INSERT INTO "item_descriptions" VALUES(270,'de','Der Xaveur ist ein sehr wirkungsvoller Bogen. Er gehörte einst Xaver, dem Bäcker. Dieser pflegte immer an alle Monstern in der Umgebung seiner Bäckerei Brote zu vergeben, bevor er die nächste Fuhre in den Ofen schub.');
INSERT INTO "item_descriptions" VALUES(271,'en','This hammer is a beautiful, strange and fascinating weapon. Make sure you get nice and close to your enemy before you use it - that''s the way Chafers like it, after all!');
INSERT INTO "item_descriptions" VALUES(271,'fr','Une belle arme étrange et fascinante, elle vous permettra de vous battre au corps à corps comme le ferait le meilleur des Chafers.');
INSERT INTO "item_descriptions" VALUES(271,'es','Esta es una bonita arma. Extraña y fascinante te permitirá luchar en cuerpo a cuerpo como lo haría el mejor de los chafers.');
INSERT INTO "item_descriptions" VALUES(271,'pt','Uma bela, estranha e fascinante arma que lhe permitirá lutar corpo a corpo, da maneira como o melhor dos Chafers faria.');
INSERT INTO "item_descriptions" VALUES(271,'de','Diese schöne und faszinierende Waffe erlaubt epische Schlachten im Nahkampf, wie ein echter Chafer sie führen würde.');
INSERT INTO "item_descriptions" VALUES(272,'en','This bow is powerful enough to shoot an arrow to the moon.');
INSERT INTO "item_descriptions" VALUES(272,'fr','Cet arc est assez puissant pour envoyer une flèche sur la lune.');
INSERT INTO "item_descriptions" VALUES(272,'es','Este arco es suficientemente potente como para enviar una flecha sobre la luna.');
INSERT INTO "item_descriptions" VALUES(272,'pt','Este arco é poderoso o suficiente para disparar uma flecha na lua.');
INSERT INTO "item_descriptions" VALUES(272,'de','Dieser Bogen hat sogar genug Zugkraft, um Pfeile bis auf den Mond zu schießen.');
INSERT INTO "item_descriptions" VALUES(273,'en','The Yamato String has thrilled many a monster''s heart. It''s a fine weapon, able to send an arrow flying to the most oblique spots.');
INSERT INTO "item_descriptions" VALUES(273,'fr','La Corde de Yamato a fait vibrer plus d''un coeur de monstre. Arme fine, elle est capable de diriger sa flèche dans les endroits les plus cachés.');
INSERT INTO "item_descriptions" VALUES(273,'es','La Cuerda de Yamato hizo vibrar a más de un corazón de monstruo. Es un arma refinada capaz de dirigir su flecha en los más recónditos lugares.');
INSERT INTO "item_descriptions" VALUES(273,'pt','A Corda de Yamato tocou muitos corações de monstros. É uma boa arma, capaz de apontar a flecha na direção dos locais mais escondidos.');
INSERT INTO "item_descriptions" VALUES(273,'de','Yamatos Sehne hat bereits mehr als ein Monsterherz zum Vibrieren gebracht. Mit dieser feinen Waffe lässt sich ein Pfeil selbst in die verborgensten Stellen plazieren.');
INSERT INTO "item_descriptions" VALUES(278,'en','A ring set with a rare stone. Do I need to explain the name?');
INSERT INTO "item_descriptions" VALUES(278,'fr','Anneau serti d''une pierre rare. Il doit son nom aux différentes pierres nécessaires à sa confection.');
INSERT INTO "item_descriptions" VALUES(278,'es','Este anillo está engastado con una piedra rara. Las distintas piedras que componen su nombre son imprescindibles para su creación.');
INSERT INTO "item_descriptions" VALUES(278,'pt','Um anel com uma pedra rara. Deve seu nome às diferentes pedras usadas para criá-lo.');
INSERT INTO "item_descriptions" VALUES(278,'de','In diesen Ring ist ein sehr seltener geschliffener Stein eingelegt. Der Felsenring trägt seinen Namen aufgrund der vielen unterschiedlichen Gesteine und Metalle, die zu seiner Anfertigung nötig sind.');
INSERT INTO "item_descriptions" VALUES(279,'en','If we are to believe one renowned adventurer, this amulet contains a tear from a Gobball, which has the same properties and stench as Gobball Leather tea.');
INSERT INTO "item_descriptions" VALUES(279,'fr','Selon un illustre aventurier, cette amulette contient une larme de Bouftou, à l''odeur et aux propriétés semblables à celles des décoctions de cuir de bouftou.');
INSERT INTO "item_descriptions" VALUES(279,'es','Según un ilustre aventurero, este amuleto contiene una lágrima de jalató. Su olor y sus propiedades son semejantes a las que producen las decocciones del cuero de un jalató.');
INSERT INTO "item_descriptions" VALUES(279,'pt','De acordo com um renomado aventureiro, este amuleto contém uma lágrima de Papatudo, que possui as mesmas propriedades e o mesmo cheiro obtidos com a decocção de couro de Papatudo.');
INSERT INTO "item_descriptions" VALUES(279,'de','Laut Bericht eines bekannten Abenteurers enthält dieses Amulett eine Fresssackträne, deren Geruch und Eigenschaften denen von abgekochtem Fresssackleder ähnelt.');
INSERT INTO "item_descriptions" VALUES(280,'en','Collectors prize this necklace, you will certainly get a good price for it.');
INSERT INTO "item_descriptions" VALUES(280,'fr','Ce collier est recherché par les collectionneurs, vous en tirerez un bon prix.');
INSERT INTO "item_descriptions" VALUES(280,'es','Este collar es muy rebuscado por los coleccionistas, conseguirás venderlo por un buen precio.');
INSERT INTO "item_descriptions" VALUES(280,'pt','Este colar é apreciado pelos colecionadores, você certamente conseguirá um excelente preço.');
INSERT INTO "item_descriptions" VALUES(280,'de','Diese Halskette ist von Sammlern heiß begehrt und bringt bestimmt viel Geld ein.');
INSERT INTO "item_descriptions" VALUES(294,'en','The only thing as solid as a Crackler is a Crackler, that''s why this Crackler hunting shovel is made of Crackler Stone.');
INSERT INTO "item_descriptions" VALUES(294,'fr','La seule chose qui soit aussi solide qu''un Craqueleur, c''est un Craqueleur, voilà pourquoi cette pelle destinée à la chasse aux craqueleurs est en Pierre de Craqueleur.');
INSERT INTO "item_descriptions" VALUES(294,'es','Lo único que puede ser tan sólido como un crujidor, es un crujidor. Esa es la razón por la cual esta pala, diseñada para cazar crujidores, está hecha con piedra de crujidor.');
INSERT INTO "item_descriptions" VALUES(294,'pt','A única coisa tão sólida quanto um Crackler é um Crackler, é por isso que esta pá, projetada para a caça de Crackler, é feita de Pedra de Crackler.');
INSERT INTO "item_descriptions" VALUES(294,'de','Das einzige, was genauso hart ist wie ein Krachler, ist ein Krachler. Genau aus diesem Grund wurde diese speziell für die Krachler-Jagd entwickelte Schaufel aus Krachlergestein hergestellt.');
INSERT INTO "item_descriptions" VALUES(298,'en','These sandals are made from the feathers of boiled Tofu and the sole from Tofu Beak, a very resistant material. Protracted wearing can render the wearer as daft as a Tofu.');
INSERT INTO "item_descriptions" VALUES(298,'fr','Ces sandales sont faites à partir de plumes de Tofu bouilli, et la semelle est en Bec de Tofu inusable. Pour des raisons encore inexpliquées, elles rendent parfois leur porteur un peu débile...comme un Tofu.');
INSERT INTO "item_descriptions" VALUES(298,'es','Estas sandalias están hechas con plumas de tofu cocido y la suela es de pico de tofu inalterable. Por motivos todavía inexplicados, hacen que su portador se vuelva un poco tonto... como un tofu.');
INSERT INTO "item_descriptions" VALUES(298,'pt','Estas sandálias são feitas das penas de Tofu cozido e a sola é feita de um bico de Tofu, um material muito resistente. Por razões inexplicáveis, elas às vezes fazem o portador... tão idiota quanto um Tofu de verdade.');
INSERT INTO "item_descriptions" VALUES(298,'de','Diese Sandalen bestehen aus zermahlenen Tofu-Federn und die Sohle aus unabnutzbaren Tofuschnäbeln. Allerdings kann es aus noch ungeklärter Ursache manchmal vorkommen, dass ihr Träger mitunter ein wenig schwach im Kopf wird... wie ein Tofu eben.');
INSERT INTO "item_descriptions" VALUES(299,'en','Attack is the best defence. With these anti-aggression boots, you will easily send muggers packing. And those guys who come up to you at crossroads to clean your mount''s teeth.');
INSERT INTO "item_descriptions" VALUES(299,'fr','La meilleure défense c''est l''attaque, ces bottes anti-agression vous permettront d''exterminer un groupe d''agresseurs sans aucune difficulté.');
INSERT INTO "item_descriptions" VALUES(299,'es','La mejor defensa es el ataque, estas botas anti agresión te permitirá acabar con un grupo de agresores sin ninguna dificultad.');
INSERT INTO "item_descriptions" VALUES(299,'pt','A melhor defesa é o ataque. Com estas botas antiagressão, você exterminará facilmente os agressores.');
INSERT INTO "item_descriptions" VALUES(299,'de','Die beste Verteidigung ist immer noch der Angriff! Diese Schuhe werden es euch ermöglichen, ganze Gruppen von Aggressoren ohne Probleme aus dem Weg zu treten.');
INSERT INTO "item_descriptions" VALUES(318,'en','This staff used to be very handy for Amakna breeders who wanted to keep their flocks of Tabis in one place. It doesn''t actually do much, but it is very light. Great for running after Gobballs.');
INSERT INTO "item_descriptions" VALUES(318,'fr','Ce bâton servait à l''origine aux éleveurs d''Amakna qui voulaient contrôler plus facilement leurs troupeaux de Tabis, ce bâton est en effet si léger, qu''il permet à son porteur de courir après les Tabis égarés sans se fatiguer.');
INSERT INTO "item_descriptions" VALUES(318,'es','Los ganaderos de Amakna utilizaban este bastón cuando querían controlar más fácilmente a sus rebaños de Tabis, este bastón es tan ligero que permite correr detrás de los Tabis que se quieren escapar sin ni siquiera cansarse.');
INSERT INTO "item_descriptions" VALUES(318,'pt','Este cajado costumava ser muito usado pelos criadores de Amakna, que queriam manter juntos seus rebanhos de Tabis. Este cajado é tão leve que você pode perseguir facilmente seu Tabis perdido. Sem peso para carregar, sem corridas cansativas. Perfeito!');
INSERT INTO "item_descriptions" VALUES(318,'de','Dieser Stock diente ursprünglich den Hirten Amaknas dazu, ihre Tabiherden zu dirigieren. Er ist nämlich so leicht, dass der Träger jedem entlaufenen Tabi nachrennen kann, ohne jemals müde zu werden.');
INSERT INTO "item_descriptions" VALUES(323,'en','This amulet gives the wearer special abilities: they will be possessed by a mysterious aura, which flows through their bodies and increases their physical abilities tenfold.');
INSERT INTO "item_descriptions" VALUES(323,'fr','Cette amulette donne des facultés très particulières à son porteur, en effet ce dernier se voit comme transporté par une aura mystérieuse parcourant son corps, ce qui généralement a pour effet de décupler ses capacités physiques.');
INSERT INTO "item_descriptions" VALUES(323,'es','Este amuleto proporciona facultades muy particulares a su portador, pues este se verá como transportado por un aura misteriosa que irá recorriendo su cuerpo, lo cual generalmente acaba aumentando sus capacidades físicas.');
INSERT INTO "item_descriptions" VALUES(323,'pt','Esse tipo de amuleto dá habilidades especiais a quem possuí-lo; ele pode deixá-lo fascinado por uma misteriosa aura que corre pelo seu corpo e normalmente aumenta dez vezes as habilidades físicas.');
INSERT INTO "item_descriptions" VALUES(323,'de','Dieses Amulett verleiht dem Träger außergewöhnliche Fähigkeiten. Er wird förmlich spüren können, wie eine mysteriöse Aura seinen Körper umhüllt, welche alle Grenzen seiner physischen Kräfte sprengt.');
INSERT INTO "item_descriptions" VALUES(324,'en','This amulet turns pink when you''re feeling perky. Rumour has it that it also increases your chances of finding good items tenfold.');
INSERT INTO "item_descriptions" VALUES(324,'fr','Cette amulette a la faculté de devenir rose les jours où son porteur est d''humeur guillerette. On raconte qu''elle décuple également vos chances de trouver de bons objets.');
INSERT INTO "item_descriptions" VALUES(324,'es','Este amuleto tiene la facultad de volverse rosa los días en que su portador esté de humor vivaracha. Dicen que aumenta también tus posibilidades de encontrar buenos objetos.');
INSERT INTO "item_descriptions" VALUES(324,'pt','Este amuleto fica rosa quando você está de bom humor. Dizem que ele aumenta dez vezes as chances de seu personagem encontrar bons itens.');
INSERT INTO "item_descriptions" VALUES(324,'de','Dieses Amulett färbt sich rosa, wenn der Träger guter Laune ist. Man sagt ihm ebenfalls nach, die Chancen für das Finden guter Gegenstände zu erhöhen.');
INSERT INTO "item_descriptions" VALUES(325,'en','Handmade by one of the greatest Sram jewellers, this amulet is made of small skulls carved in bone, helping its wearer escape perilous situations.');
INSERT INTO "item_descriptions" VALUES(325,'fr','Cette amulette confectionnée à partir de petits crânes taillés dans de l''os, par un des plus grands bijoutiers Sram, est unique en son genre. Elle permet à son porteur de s''évader plus facilement lors des situations périlleuses.');
INSERT INTO "item_descriptions" VALUES(325,'es','Este amuleto confeccionado por uno de los más grandes joyeros sram a partir de pequeñas calaveras talladas en el hueso, es único. Permite que su portador se escape más fácilmente de situaciones peligrosas.');
INSERT INTO "item_descriptions" VALUES(325,'pt','Este amuleto, feito à mão por um dos maiores joalheiros entre os discípulos de Sram, é composto de pequenos crânios cravados em osso. É, de fato, um amuleto exclusivo que permite ao possuidor escapar mais facilmente de situações perigosas.');
INSERT INTO "item_descriptions" VALUES(325,'de','Dieses Amulett enthält kleine Schädelchen, die von einem der größten Sram-Juweliere aus Knochen herausgearbeitet wurden. Es erlaubt dem Träger, leichter aus einer gefährlichen Lage zu entkommen.');
INSERT INTO "item_descriptions" VALUES(326,'en','The Deulegarnoulle Amulet comes from the Nordic regions... It''ll increase your summoning powers.');
INSERT INTO "item_descriptions" VALUES(326,'fr','Cette amulette provient des régions nordiques, elle confère a son porteur la capacité d''invoquer plus facilement des créatures.');
INSERT INTO "item_descriptions" VALUES(326,'es','Este amuleto proviene de las regiones nórdicas, le confiere a su portador la capacidad de invocar criaturas más fácilmente.');
INSERT INTO "item_descriptions" VALUES(326,'pt','O amuleto de Deulegarnoulle vem das regiões nórdicas; ele dá ao seu portador a capacidade de invocar criaturas mais facilmente.');
INSERT INTO "item_descriptions" VALUES(326,'de','Diese Halskette stammt aus dem Norden Amaknas und erleichtert dem Träger das Beschwören von Kreaturen.');
INSERT INTO "item_descriptions" VALUES(327,'en','This blade was first forged for the Karne Riders, but it was unfortunately too heavy for those weak goblins. 
It''s a very light weapon for normal beings, however, light enough to deliver rapid blows in succession.');
INSERT INTO "item_descriptions" VALUES(327,'fr','Cette lame forgée à l''origine pour les Chevaucheurs de Karne, était en fait bien trop lourde pour ces faibles gobelins. Elle n''en reste pas moins très légère pour un individu normal, ce qui lui permet de frapper très vite.');
INSERT INTO "item_descriptions" VALUES(327,'es','Esta hoja forjada en su origen para los cabalgadores de karne era en realidad demasiado pesada para estos frágiles goblins. Sin embargo, resulta muy ligera para un individuo normal, lo cual le permite golpear con mucha rapidez.');
INSERT INTO "item_descriptions" VALUES(327,'pt','Esta lâmina foi primeiramente forjada para os Ginetes Karnes, mas infelizmente era muito pesada para estes fracos duendes. Mas ela é uma arma muito leve para humanos normais, leve o bastante para dar golpes rápidos.');
INSERT INTO "item_descriptions" VALUES(327,'de','Diese Klinge wurde ursprünglich für die Raubritter von Kleppripp geschmiedet. Obwohl es sich herausstellte, dass sie viel zu schwer für diese schwachen Goblinoiden war, kann ein normaler Abenteurer mit ihr sehr schnell zuschlagen, da dieses Schwert sehr leicht in der Hand liegt.');
INSERT INTO "item_descriptions" VALUES(328,'en','This strange double-bladed sword was originally used to prune trees and cut through dense forests. The lumberjacks soon realised that it was also an excellent weapon against other creatures.');
INSERT INTO "item_descriptions" VALUES(328,'fr','Cette lame double à la forme bien étrange servait à l''origine à élaguer les arbres pour progresser dans les forêts denses. Les bûcherons se sont vite aperçus qu''elle constituait une arme de choix pour exterminer toute forme de menace.');
INSERT INTO "item_descriptions" VALUES(328,'es','Esta hoja doble con una forma muy extraña servía en su origen como machete para poder avanzar en los bosques densos. Los leñadores se dieron rápidamente cuenta de que constituía un arma genial para romper las armaduras de sus adversarios.');
INSERT INTO "item_descriptions" VALUES(328,'pt','Esta estranha lâmina dupla foi originalmente usada para derrubar árvores e explorar florestas densas. Os lenhadores logo entenderam que ela também era uma arma excelente contra todos os tipos de ameaça.');
INSERT INTO "item_descriptions" VALUES(328,'de','Dieses Schwert mit doppelter Klinge diente ursprünglich dazu, Äste von Bäumen abzuschneiden, um sich einen Weg durch den Dschungel zu bahnen. Allerdings stellten die Holzfäller sehr schnell fest, dass sie der ideale Begleiter war, um mit jeglicher Art von Bedrohung auf dem Weg fertigzuwerden.');
INSERT INTO "item_descriptions" VALUES(329,'en','As its name indicates, this bow will help you on your path to consistent victory. A skilled Cra architect without an ounce of imagination later stole the same name for one of his monuments.');
INSERT INTO "item_descriptions" VALUES(329,'fr','Comme son nom l''indique, cet arc permet de gagner facilement un combat. Un grand architecte Crâ sans imagination a même utilisé le nom de cet arc pour nommer une de ses constructions.');
INSERT INTO "item_descriptions" VALUES(329,'es','Como lo indica su nombre, este arco permite ganar fácilmente un combate. Incluso un gran arquitecto ocra sin imaginación utilizó este nombre para una de sus horribles construcciones.');
INSERT INTO "item_descriptions" VALUES(329,'pt','Como seu nome indica, este arco lhe ajudará a ganhar facilmente uma luta. Um grande arquiteto sem nenhum pingo de imaginação, usou o mesmo nome em um de seus monumentos.');
INSERT INTO "item_descriptions" VALUES(329,'de','Wie der Name besagt, lässt sich mit diesem Bogen leicht jeder Kampf gewinnen. Ein bekannter und phantasieloser Crâ-Architekt hat später diesen Namen übernommen, um ihn einer seiner Bauten zu verleihen.');
INSERT INTO "item_descriptions" VALUES(331,'en','This is the bow of choice in the region. From what people say, you''ll find treasure where its arrows fall. You have to make sure you fire them towards the end of a rainbow, but I still think it''s crazy.');
INSERT INTO "item_descriptions" VALUES(331,'fr','C''est l''arc le plus recherché de tout Amakna, on raconte que là où ses flèches retombent, on peut trouver un trésor. Étrangement, il ne semble être efficace que lorsque pluie et rayons de soleil se mêlent.');
INSERT INTO "item_descriptions" VALUES(331,'es','Este arco es el más buscado de toda Amakna, algunos cuentan que donde caen sus flechas se puede hallar un tesoro. Cosa extraña, parece que solo es eficaz cuando la lluvia se mezcla a los rayos del sol.');
INSERT INTO "item_descriptions" VALUES(331,'pt','É uma escolha de arco em Amakna. As pesoas dizem que você pode encontrar um tesouro onde as flechas caem. Estranhamente, só é eficiente quando os raios solares são refratados pela chuva...');
INSERT INTO "item_descriptions" VALUES(331,'de','Dies ist einer der meistgesuchtesten Bögen ganz Amaknas. Der Legende nach soll man nämlich an der Stelle, wo der Pfeil landet, einen Schatz finden können. Seltsamerweise scheint dies nur dann zu funktionieren, wenn Regen fällt und Sonnenstrahlen das Ganze bescheinen.');
INSERT INTO "item_descriptions" VALUES(332,'en','Joan was a little crazy, always hearing Tabis burping she said... They confiscated her bow - for her own good, mind you - and finally decided to burn her at the stake altogether. She burnt great, she did. Really something else... And I''ve seen a few burnings, me... I still have her singed kneecap if you want... come... hey! Where... ahhhh!');
INSERT INTO "item_descriptions" VALUES(332,'fr','Jeanne était un peu folle, elle entendait des Tabis roter dans sa tête. Pour éviter qu''elle ne se blesse avec son arc, il lui a été confisqué et on a décidé de la brûler vive pour réchauffer l''ambiance lors de l''inauguration de la taverne.');
INSERT INTO "item_descriptions" VALUES(332,'es','Juana estaba un poco loca, oía tabis eructar dentro de su cabeza. Para evitar que se lastimara con su arco, se lo quitaron y decidieron quemarla viva para calentar el ambiente el día de la inauguración de la taberna.');
INSERT INTO "item_descriptions" VALUES(332,'pt','Como Joana costumava ouvir soluços de Tabis em sua cabeça, as pessoas pensavam que ela era um pouco louca. E, para evitar que ela se ferisse, confiscaram seu arco e, finalmente, decidiram queimá-la para agitar as coisas duante a cerimônia de abertura da taverna.');
INSERT INTO "item_descriptions" VALUES(332,'de','Jeanne war ein wenig verrückt. Sie hörte ständig in Ihrem Kopf Tabis rülpsen. Um zu verhindern, dass sie sich mit ihrem Bogen selbst verletzt, wurde er ihr abgenommen und man beschloß, sie anläßlich der Einweihung der Taverne lebendig zu verbrennen, um die Atmosphäre etwas zu aufzulockern.');
INSERT INTO "item_descriptions" VALUES(333,'en','Originally made to be eaten, this baguette became a fearsome weapon when Xavier the Baker left it in the oven for 234 years. Why did he leave it for so long? Well, he reached a point where he''d had enough of making cheese sandwiches, and so he started handing out knuckle sandwiches to the monsters around the bakery instead. He had so much fun, he forgot all about the baguette.');
INSERT INTO "item_descriptions" VALUES(333,'fr','À l''origine destinée à être mangée, cette baguette est devenue une arme redoutée. En effet, Xavier le Boulanger l''a oubliée dans son four pendant 234 ans alors qu''il était parti distribuer des pains aux monstres autour de sa boulangerie.');
INSERT INTO "item_descriptions" VALUES(333,'es','En su origen era comestible pero con el paso del tiempo se convirtió en una temible arma, pues Javier el Panadero la olvidó en su horno durante 234 años cuando se había marchado a repartir tortas a los monstruos que se encontraban alrededor de su panadería.');
INSERT INTO "item_descriptions" VALUES(333,'pt','Originalmente feito para ser consumido, este bastão se tornou uma arma perigosa. Xavier, o Padeiro, o esqueceu em seu forno durante 234 anos, quando ele saiu para dar pão aos monstros ao redor da sua padaria.');
INSERT INTO "item_descriptions" VALUES(333,'de','Dieses einfache Stockbrot wurde zu einer gefürchteten Waffe, nachdem es Xaver der Bäcker während des Monsterfütterns zum Warmhalten in den tiefsten Punkt seines Ofens geschoben hatte und erst 234 Jahre später aus Zufall dort wiederfand.');
INSERT INTO "item_descriptions" VALUES(334,'en','This wand once belonged to Liriel, an Eniripsa who died of an overdose of strawberries, after losing his wings in a pain so excruciating that your heart would stop beating if I told you any more. Collectors are surprisingly desperate to get hold of this wand, given that it''s said to be cursed.');
INSERT INTO "item_descriptions" VALUES(334,'fr','Cette baguette appartenait à l''Eniripsa Liriel qui mourût d''une overdose de fraises dans d''atroces souffrances, perdant ses ailes dans un râle de douleur à vous glacer le sang. Les collectionneurs s''arrachent cette baguette réputée maudite.');
INSERT INTO "item_descriptions" VALUES(334,'es','Esta varita pertenecía a la aniripsa Liriel que se murió de una sobredosis de fresas en una lenta y horrible agonía durante la cual perdió sus alas gritando como una desesperada. Los coleccionistas estarían dispuestos a matar para conseguir esta varita maldita.');
INSERT INTO "item_descriptions" VALUES(334,'pt','Esta varinha mágica uma vez pertenceu a Liriel, um discípulo de Eniripsa, que morreu por overdose de morango e perdeu suas asas em uma dor martirizante, um fim terrível que deve ter feito seu sangue gelar. Os coletores estão desesperados para conseguir esta varinha mágica; dizem ser amaldiçoada.');
INSERT INTO "item_descriptions" VALUES(334,'de','Dieser Stab gehörte einer Eniripsa namens Liriel, die nach einer Überdosis Erdbeeren in furchtbarer Agonie das Leben aushauchte. Beim Ausfallen ihrer Flügel stieß sie einen schrecklichen Schmerzenschrei aus, der einem durch Mark und Bein ging. Nun ist dieser angeblich verfluchte Stab bei Sammlern heiß begehrt.');
INSERT INTO "item_descriptions" VALUES(335,'en','Without their staff, the Bwork Magi are as harmless as Tofus. Need I say more about the power of this weapon?');
INSERT INTO "item_descriptions" VALUES(335,'fr','Sans leur bâton, les Bwork Mages sont aussi inoffensifs que les Tofus sans leur Bécos. Voilà qui en dit long sur la puissance de ce bâton.');
INSERT INTO "item_descriptions" VALUES(335,'es','Sin su bastón, los bwork magos son tan inofensivos como los tofus sin sus picos. Esto te dará una visión más clara del poder que encierra este bastón.');
INSERT INTO "item_descriptions" VALUES(335,'pt','Sem este cajado, os Bworks Magos são tão indefesos quanto Tofus. Isso nos diz o quão poderosa é essa arma.');
INSERT INTO "item_descriptions" VALUES(335,'de','Ohne ihren Stecken sind Bwork Magi genauso ungefährlich, wie Tofus ohne ihre Küsse. Damit sollte ja klar sein, dass in diesem Stecken große Macht drin steckt.');
INSERT INTO "item_descriptions" VALUES(336,'en','This staff can levitate Cawwots! Mind you, that''s not much use in fights.');
INSERT INTO "item_descriptions" VALUES(336,'fr','Ce bâton a la faculté de pouvoir faire léviter les Cawottes, on se demande bien à quoi cela peut servir en combat.');
INSERT INTO "item_descriptions" VALUES(336,'es','Este bastón tiene la facultad de hacer levitar las zanahowias. Uno puede preguntarse para qué demonios le sirve hacer eso durante un combate.');
INSERT INTO "item_descriptions" VALUES(336,'pt','Este Cajado faz o Cenouwawa levitar... Não é muito útil durante as lutas, mas pode ser de bom uso alguma hora.');
INSERT INTO "item_descriptions" VALUES(336,'de','Dieser Stock hat die Fähigkeit, Kawotten schweben zu lassen. Da fragt man sich doch, was in aller Welt das bringen soll...');
INSERT INTO "item_descriptions" VALUES(337,'en','The Bwork Archer Bow is extremely simple to use. It was designed with the Bwork Archers in mind... A bloody Tofu could use it... The catch is that you have to be as strong as a Crackler to string it.');
INSERT INTO "item_descriptions" VALUES(337,'fr','C''est un arc très simple à utiliser, il a été conçu pour s''adapter à l''intelligence d''un Bwork Archer, ce qui le rend presque utilisable par un Tofu. En revanche, il nécessite une force de Craqueleur pour être bandé.');
INSERT INTO "item_descriptions" VALUES(337,'es','Este es un arco de uso muy sencillo, ha sido diseñado para adaptarse a la inteligencia de un bwork arquero, por lo cual incluso un tofu podría utilizarlo. En cambio, es necesario tener la fuerza de un crujidor para tensarlo.');
INSERT INTO "item_descriptions" VALUES(337,'pt','O Arco de Bwork Arqueiro é simples de usar. Ele foi projetado para se adaptar aos Bwork Arqueiros não-muito-espertos, o que indica que um Tofu quase poderia usá-lo... Entretanto, você deve ser tão forte quanto um Crackler para curvá-lo.');
INSERT INTO "item_descriptions" VALUES(337,'de','Dieser Bogen ist sehr einfach zu gebrauchen. Er wurde schließlich auch bei der Entwicklung an die Intelligenz des Bwork-Bogenschützen angepasst, weshalb er beinahe schon von einem Tofu gehandhabt werden kann. Im Gegenzug braucht man allerdings die Stärke eines Krachlers, um ihn zu spannen.');
INSERT INTO "item_descriptions" VALUES(339,'en','This blade once belonged to Metzger the butcher, who used it to cut up bones. A Chafer managed to steal it from him and the blade became a fearsome weapon in his hands. Whole families of shoe salesmen went out of business, not to mention the glove trade... just terrible.');
INSERT INTO "item_descriptions" VALUES(339,'fr','Cette lame appartenait à Metzger le boucher, elle avait été forgée pour découper les os. Le Chafer a cependant réussi à lui dérober son outil, devenu maintenant une arme très redoutée qui est à l''origine de nombreuses amputations.');
INSERT INTO "item_descriptions" VALUES(339,'es','Esta cuchilla pertenecía a Metzger, el carnicero. Ha sido forjada para poder cortar huesos. Sin embargo un chafer consiguió robarle esta herramienta que actualmente se ha vuelto famosa por haber sido la causa de numerosas amputaciones.');
INSERT INTO "item_descriptions" VALUES(339,'pt','Esta lâmina pertenceu a Metzger, o Açougueiro, que a usou para esculpir ossos. Porém, o Chafer conseguiu roubá-la do Açougueiro e, então, a lâmina caiu nas mãos dele como uma terrível arma, responsável por muitas amputações.');
INSERT INTO "item_descriptions" VALUES(339,'de','Dieses Schwert benutzte Buh Tscher, der Metzger, um damit Knochen zu spalten. Doch dem Chafer gelang es einst, ihm dieses Werkzeug zu rauben. In seinen Händen stellt das Schwert nun eine äußerst gefährliche Waffe dar, auf deren Konto schon mehrere Dutzend Totalamputationen gehen.');
INSERT INTO "item_descriptions" VALUES(340,'en','These daggers allow you to steal anything and everything, anything from everyone, or everything from anyone, or everyone from any...no that doesn''t work... They''re great, though.');
INSERT INTO "item_descriptions" VALUES(340,'fr','Ces dagues permettent selon la légende de voler tout et n''importe quoi, mais surtout n''importe quoi à n''importe qui, où l''inverse, mais plus personne ne se souvient de la légende avec exactitude.');
INSERT INTO "item_descriptions" VALUES(340,'es','Estas dagas permiten, según cuenta la leyenda, robar cualquier cosa a cualquier persona o al revés, pero ya nadie recuerda muy bien la leyenda.');
INSERT INTO "item_descriptions" VALUES(340,'pt','Estas adagas permitem que você roube qualquer coisa e, acima de tudo, de qualquer pessoa, ou vice-versa... ninguém lembra da história direito.');
INSERT INTO "item_descriptions" VALUES(340,'de','Diese Dolche geben ihrem Träger die Macht, alles und nichts von jedermann zu stehlen, genauer: irgendwas von irgendwem. Oder war es umgekehrt? Wir werden es wohl nie erfahren...');
INSERT INTO "item_descriptions" VALUES(341,'en','These legendary daggers are a true collector''s item for any self-respecting Sram. They are so revered that even some of these rats refuse to steal them.');
INSERT INTO "item_descriptions" VALUES(341,'fr','Ces dagues légendaires constituent de vraies pièces de collection pour tout Sram qui se respecte, elles sont tellement vénérées, que certains Srams se refusent à les voler.');
INSERT INTO "item_descriptions" VALUES(341,'es','Estas dagas legendarias constituyen verdaderas piezas de colección para cualquier sram que se respete, son tan veneradas que algunos srams se niegan a robarlas.');
INSERT INTO "item_descriptions" VALUES(341,'pt','Estas lendárias adagas são verdadeiros itens de colecionador para qualquer Sram que se preze. Elas são tão veneradas que alguns Srams se recusam a roubá-las.');
INSERT INTO "item_descriptions" VALUES(341,'de','Diese legendären Dolche sind ein echtes Sammlerstück für jeden Sram, der etwas auf sich hält. Sie werden von manchen sogar so sehr verehrt, dass sie gar nicht versuchen, diese Dolche zu stehlen. Das will etwas heißen!');
INSERT INTO "item_descriptions" VALUES(342,'en','This very special hammer was made of Kwak Beaks. That''s why it''s so prickly when it knocks you head over heels!');
INSERT INTO "item_descriptions" VALUES(342,'fr','Ce marteau très particulier a été confectionné à partir de becs de Kwaks, ce qui explique pourquoi il pique très fort lorsque l''on se prend un coup de ce marteau.');
INSERT INTO "item_descriptions" VALUES(342,'es','Este martillo muy particular se hizo con picos de kwaks, esto explica por qué pincha mucho cuando a uno le golpean con él.');
INSERT INTO "item_descriptions" VALUES(342,'pt','Este martelo muito especial foi feito de bicos de Kwaks. Por isso, ele é tão pontudo que pode cortá-lo ao meio!');
INSERT INTO "item_descriptions" VALUES(342,'de','Dieser eigentümliche Hammer wurde ganz aus Kwack-Schnäbeln gebaut, was auch erklärt, warum es so sehr sticht, wenn man Schläge damit abbekommt.');
INSERT INTO "item_descriptions" VALUES(346,'en','According to some legends, this ring protects against bad weather. In reality, this has never been proven because it has never rained in Amakna.');
INSERT INTO "item_descriptions" VALUES(346,'fr','Selon certaines légendes, cet anneau protège son porteur des intempéries. Mais ceci n''a jamais encore pu être prouvé, puisqu''il ne pleut jamais en Amakna.');
INSERT INTO "item_descriptions" VALUES(346,'es','Algunas leyendas cuentan que este anillo protege de las intemperies al que lo lleve puesto. Pero eso todavía no ha sido demostrado ya que en Amakna nunca llueve.');
INSERT INTO "item_descriptions" VALUES(346,'pt','De acordo com algumas lendas, este anel fornece boa proteção contra tempos ruins. De fato, isto nunca foi provado, porque nunca houve um dia chuvoso em Amakna.');
INSERT INTO "item_descriptions" VALUES(346,'de','Wenn man gewissen Geschichten Glauben schenken darf, sollen diese Ringe den Träger vor Unwettern schützen. Jedoch konnte dies bisher noch nicht nachgewiesen werden, da es in Amakna niemals regnet.');
INSERT INTO "item_descriptions" VALUES(347,'en','This shovel is a very efficient tool for cutting nutsedge, a type of weed. It''s also an excellent weapon for taking care of the weeds you''ll find in the inns of Amakna.');
INSERT INTO "item_descriptions" VALUES(347,'fr','Cette pelle de jardinier est particulièrement efficace pour couper les rhizomes, des mauvaises herbes. C''est également une excellente arme dès qu''il s''agit de couper autre chose que des rhizomes.');
INSERT INTO "item_descriptions" VALUES(347,'es','Esta pala de jardinero es especialmente eficaz para cortar los rhizomas, o las malas hierbas. Es una excelente arma también cuando se trata de cortar otra cosa que los rhizomas.');
INSERT INTO "item_descriptions" VALUES(347,'pt','Esta pá é uma ferramenta excelente para um jardineiro cortar rizomas, um tipo de erva daninha. Também é uma arma excelente para cortar qualquer coisa.');
INSERT INTO "item_descriptions" VALUES(347,'de','Diese Gartenschaufel ist besonders tauglich, wenn es darum geht, Rhizome, wie sie bei vielen Unkräutern vorkommen, abzutrennen. Allerdings ist sie gleichfalls hervorragend dazu geeignet, alles andere von allem anderen abzutrennen.');
INSERT INTO "item_descriptions" VALUES(348,'en','These boots once belonged to a cook who was always in a big rush. He spent his time criss-crossing the land of Amakna looking for celery-tea.');
INSERT INTO "item_descriptions" VALUES(348,'fr','Ces bottes appartenaient à un cuisinier très pressé, qui allait chercher son céleri et son thé à toute vitesse à travers la campagne d''Amakna.');
INSERT INTO "item_descriptions" VALUES(348,'es','Estas botas pertenecieron a Rap y a Dhez, el primero tenía por costumbre hablar a una velocidad insuperable para proferir insultos salvajes sin que nadie le entendiese. En cambio Dhez, se pasaba las tardes escuchando música Chill Out para relajarse tras una dura jornada laboral. Parece que ambos rasgos dejaron huella sobre estas botas que te proporcionarán velocidad y calma a la hora de luchar contra un rival.');
INSERT INTO "item_descriptions" VALUES(348,'pt','Estas botas pertenceram a um cozinheiro sempre muito apressado. Ele sempre corria por toda Amakna para encontrar aipo e chá.');
INSERT INTO "item_descriptions" VALUES(348,'de','Diese Stiefel gehörten einst einem Koch, der ständig alle Angestellten in der Gegend herumscheuchte... "Nächster Gang, gebt alles!", weil er ein schauderhaftes Organisationstalent hatte. Man hörte ihn immer bereits von Weitem krakelen: "Y''arriva,y''arriva, es kommt gleich!"');
INSERT INTO "item_descriptions" VALUES(354,'en','This kind of sword is forged for the bodyguards of a renowned and wealthy shopkeeper. Its main use consists of frightening thieves but when murder is required - a tenacious burglar, a fussy customer - you''ll find it equal to the task.');
INSERT INTO "item_descriptions" VALUES(354,'fr','Ce type d''épée était forgé pour les gardes d''un commerçant aussi riche que réputé. Plutôt destinée à effrayer les voleurs, elle n''en reste pas moins redoutable pour achever les voleurs ou les clients honnêtes, mais un peu usants.');
INSERT INTO "item_descriptions" VALUES(354,'es','Este tipo de espada fue forjada para los guardias de un comerciante rico y famoso. Aunque su función inicial consistía en asustar a los ladrones, no deja de ser una arma temible para rematar a los ladrones o a los clientes honrados pero un poco pelmas.');
INSERT INTO "item_descriptions" VALUES(354,'pt','Este tipo de espada foi forjado para os guarda-costas de um lojista famoso e rico. Seu principal uso consiste em amedrontar gatunos, mas ela também pode ser eficiente em acabar com corsários, ou com honestos, mas importunos clientes.');
INSERT INTO "item_descriptions" VALUES(354,'de','Diese Schwertart wurde speziell für die Leibgarde eines reichen und berüchtigten Händlers angefertigt. Sie sollte zwar mehr zur Abschreckung dienen als zum echten Kampf, doch war sie dennoch gut geeignet, etwaige Diebe oder manchmal auch ehrliche Kunden niederzustrecken, was auf Dauer allerdings recht anstrengend ist.');
INSERT INTO "item_descriptions" VALUES(355,'en','This ring increases Strength and Chance.');
INSERT INTO "item_descriptions" VALUES(355,'fr','Cet anneau apporte force et courage à son porteur.');
INSERT INTO "item_descriptions" VALUES(355,'es','Este anillo proporciona fuerza y valentía.');
INSERT INTO "item_descriptions" VALUES(355,'pt','Este anel dá força e coragem ao seu portador.');
INSERT INTO "item_descriptions" VALUES(355,'de','Dieser Ring bringt seinem Träger Stärke und Mut.');
INSERT INTO "item_descriptions" VALUES(356,'en','This simple belt increases stamina.');
INSERT INTO "item_descriptions" VALUES(356,'fr','Cette ceinture rend son porteur plus résistant et endurant.');
INSERT INTO "item_descriptions" VALUES(356,'es','Este cinturón vuelve más resistente a quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(356,'pt','Este simples cinto aumenta a resistência de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(356,'de','Dieser Gürtel erhöht die Ausdauer seines Trägers im Kampf und damit meist auch seine Lebensdauer.');
INSERT INTO "item_descriptions" VALUES(357,'en','This sword symbolises a body part of which Ecaflips are particularly proud. If you don''t feel it''s hypocrisy to take it, be my guest.');
INSERT INTO "item_descriptions" VALUES(357,'fr','Epée symbolisant la partie de leur corps dont les Ecaflips sont le plus fier. Cette épée résume bien la façon de faire des joueurs.');
INSERT INTO "item_descriptions" VALUES(357,'es','Esta espada simboliza la parte del cuerpo de la que los zurcaráks están más orgullosos. También resume perfectamente la filosofía de los jugadores.');
INSERT INTO "item_descriptions" VALUES(357,'pt','Esta Espada simboliza a parte do corpo que os seguidores de Ecaflip mais se orgulham. Ela resume bem o estado de espírito que os jogadores estão.');
INSERT INTO "item_descriptions" VALUES(357,'de','Dieses Schwert symbolisiert das Körperteil, auf das Ecaflips am stolzesten sind. Warum, dürfte nun klar sein.');
INSERT INTO "item_descriptions" VALUES(358,'en','The Infernal Tail is really... infernal. If you don''t use it properly, it will drive your enemies and teammates completely crazy. Before long, you won''t have any teammates left, just enemies. Nobody has ever been known to use it properly, so, well, you''ve been warned.');
INSERT INTO "item_descriptions" VALUES(358,'fr','La Queue Infernale est vraiment infernale... De quoi rendre votre adversaire ou vos coéquipiers complètement fous, et surtout de transformer vos coéquipiers en adversaires si vous vous y prenez mal. En revanche, le cas inverse ne semble jamais se produire.');
INSERT INTO "item_descriptions" VALUES(358,'es','La Cola Infernal es verdaderamente infernal... Con ella harás que tus adversarios o que tus compañeros se vuelvan completamente locos, o que tus compañeros se conviertan en adversarios si no sabes usarla. En cambio, nunca se dará el caso contrario.');
INSERT INTO "item_descriptions" VALUES(358,'pt','A Cauda Infernal é realmente infernal... Pode deixar loucos seus inimigos e companheiros de equipe. Tenha cuidado, pois isso pode tornar seus companheiros em inimigos, se você não souber usar corretamente. Apesar de tudo, o inverso nunca acontece.');
INSERT INTO "item_descriptions" VALUES(358,'de','Der Höllenschwanz macht einem das Leben zur Hölle... und mit ihm könnt ihr Freund wie Feind in den Wahnsinn treiben. Mitunter lässt sich damit auch leicht Freund zu Feind machen - das Umgekehrte ist allerdings scheinbar noch nicht vorgekommen.');
INSERT INTO "item_descriptions" VALUES(359,'en','A long time ago, King Allister gave this ring to Isidor, a smart cat, renowned for his incomparable Agility.');
INSERT INTO "item_descriptions" VALUES(359,'fr','Cet anneau a été offert il y bien longtemps à Isidor, un chat malin, par le roi Allister, qui reconnu l''agilité inégalable de cet Ecaflip.');
INSERT INTO "item_descriptions" VALUES(359,'es','Este anillo le fue regalado hace mucho tiempo a Isidoro-es-genial por el rey Allister, que reconoció la agilidad inigualable de este zurcarák.');
INSERT INTO "item_descriptions" VALUES(359,'pt','Há muito tempo, o Rei Alister Snoc deu este anel para Isidor, um gato esperto, famoso por sua agilidade incomparável.');
INSERT INTO "item_descriptions" VALUES(359,'de','Vor langer, langer Zeit wurde Isidor dieser Ring vom König Alister Snoc verliehen, der die unvergleichliche Flinkheit dieses Ecaflips erkannt hatte.');
INSERT INTO "item_descriptions" VALUES(436,'en','This staff is carved out of a huge Treechnid Root, and its main use is in close combat. The only problem for the owner is that its roots regenerate when in contact with water... That includes rain, by the way.');
INSERT INTO "item_descriptions" VALUES(436,'fr','Ce bâton taillé dans une grosse racine d''Abraknyde est très efficace au corps à corps, attention à ne pas le laisser au contact de l''eau, il pourrait reprendre racines et se retourner contre son maître.');
INSERT INTO "item_descriptions" VALUES(436,'es','Este bastón, tallado en una enorme raíz de abráknido, es muy eficaz en el cuerpo a cuerpo. Pero que no se te ocurra acercarlo al agua, podría retoñar y volverse contra ti.');
INSERT INTO "item_descriptions" VALUES(436,'pt','Este bastão feito de uma raiz grande é útil durante combates corpo a corpo. O único problema para o usuário é que ele pode regenerar suas raízes quando em contato com água...');
INSERT INTO "item_descriptions" VALUES(436,'de','Dieser Stock, der aus einer dicken Astaknydenwurzel herausgearbeitet wurde, ist sehr effektiv im Nahkampf. Allerdings sollte man dabei immer aufpassen, dass er nicht nass wird, da er sich sonst wieder im Boden verwurzelt und den Träger angreift.');
INSERT INTO "item_descriptions" VALUES(454,'en','This perfectly-forged axe is the perfect gift for lumberjacks who always blame their tools.');
INSERT INTO "item_descriptions" VALUES(454,'fr','Cette hache est indispensable au bûcheron s''il veut correctement exercer son métier. Le cas échéant, elle peut également lui permettre de se débarrasser de quelques monstres...');
INSERT INTO "item_descriptions" VALUES(454,'es','Esta hacha es indispensable para los leñadores si quieren ejercer correctamente su oficio. También puede permitirles acabar con algunos monstruos...');
INSERT INTO "item_descriptions" VALUES(454,'pt','Este machado é essencial para lenhadores que querem trabalhar devidamente no meio profissional. Também pode protegê-los de monstros quando necessário.');
INSERT INTO "item_descriptions" VALUES(454,'de','Diese Axt ist unverzichtbar für jeden Holzfäller, der seinen Beruf ausüben will. Doch im Notfall kann sie auch durchaus dazu dienen, ein paar aufgetauchte Monster wieder loszuwerden.');
INSERT INTO "item_descriptions" VALUES(455,'en','This ridiculously small hammer was used by Zokrim the peasant. Every day at dawn, he would work on his useless, meandering fences which still stretch all over his territory like confused spider webs.');
INSERT INTO "item_descriptions" VALUES(455,'fr','Ce ridicule petit marteau servait à Zokrim le paysan, qui s''en servait pour planter ses piquets de clôtures à l''aurore. Personne ne sait pourquoi Zokrim plantait ses piquets à l''aurore, mais la légende raconte qu''il avait de bonnes raisons.');
INSERT INTO "item_descriptions" VALUES(455,'es','Este ridículo martillito era de Zokrim el campesino. Lo utilizaba para plantar sus estacas de cercado durante la aurora. Nadie sabe por qué Zokrim plantaba sus estacas durante la aurora, pero cuenta la leyenda que tenía buenas razones.');
INSERT INTO "item_descriptions" VALUES(455,'pt','Este martelo ridiculamente pequeno foi usado por Zokrim, o camponês. Ele usou para construir uma cerca na alvorada. Ninguém sabe o motivo de Zokim construí-la na alvorada. Mas a lenda diz que ele tinha bons motivos.');
INSERT INTO "item_descriptions" VALUES(455,'de','Dieser lächerliche kleine Hammer diente dem Bauern Zokrim dazu, die Zaunpfähle für seine Weiden bei Einsetzen der Morgenröte in den Boden zu schlagen. Warum er dies immer nur bei Einsetzen der Morgenröte zu tun pflegte, weiß niemand, aber der Legende nach hatte er einen sehr guten Grund dafür.');
INSERT INTO "item_descriptions" VALUES(456,'en','This axe enables you to easily cut down trees, even the biggest ones. It is, above all, appreciated for its heavy weight which can cut a Bwork into three pieces. The only requirement is that you are strong enough to lift it!');
INSERT INTO "item_descriptions" VALUES(456,'fr','Cette hache permet de couper facilement les arbres, même les plus gros. Elle est surtout appréciée pour son poids important qui lui permet de couper un Bwork en trois facilement, pour peu que son porteur soit capable de la soulever.');
INSERT INTO "item_descriptions" VALUES(456,'es','Esta hacha permite cortar fácilmente los árboles, incluso los más gruesos. Es sobre todo apreciada por su importante peso que le permite cortar fácilmente un bwork en tres, bueno... solamente si eres capaz de levantarla.');
INSERT INTO "item_descriptions" VALUES(456,'pt','Este machado lhe permite cortar facilmente árvores, até as maiores. Ele é, acima de tudo, apreciado pelo seu grande peso, que permite cortar um Bwork em três. O único requisito é você ser forte o suficiente para erguer este machado!');
INSERT INTO "item_descriptions" VALUES(456,'de','Mit dieser Axt lassen sich leicht Bäume fällen - sogar die Dicksten ohne große Mühe. Doch wird sie vor allem für ihr großes Gewicht geschätzt. Mit ihr lässt sich beispielsweise ein Bwork in drei Teile schlagen, ehe es dieser überhaupt mitbekommt. Man müsste jetzt nur noch schaffen, diese Waffe hochzubekommen.');
INSERT INTO "item_descriptions" VALUES(458,'en','Some say the Chafer is sensitive and distinguished, because his amulet carries the skulls of his dead cousins. Others say he''s a beastly creature, because it was he who killed them.');
INSERT INTO "item_descriptions" VALUES(458,'fr','Le Chafer est quelqu''un de sensible et distingué, il garde toujours avec lui une amulette faite des crânes de ses cousins tombés au combat. Le plus étrange, c''est que le Chafer n''a jamais eu de cousins.');
INSERT INTO "item_descriptions" VALUES(458,'es','El chafer es una criatura sensible y refinada, siempre lleva consigo un amuleto hecho con las calaveras de sus primos caídos en combate. Lo más extraño es que el chafer nunca tuvo primos.');
INSERT INTO "item_descriptions" VALUES(458,'pt','O Capitão Chafer é muito sensível e distinto e sempre usa um amuleto feito dos crânios de seus primos mortos em combate. O mais estranho é que ele não tem primos...');
INSERT INTO "item_descriptions" VALUES(458,'de','Der Chafer ist ein sehr feinfühliges und vornehmes Wesen, weshalb er immer ein Amulett mit den Schädeln seiner im Kampf gefallenen Cousins bei sich trägt. Seltsam ist nur, dass niemand jemals von diesen Cousins des Chafers gehört hat.');
INSERT INTO "item_descriptions" VALUES(462,'en','Though you can kill the Treechnids, their wood never truly dies... this makes it incredibly difficult to work. All the same, killing a Treechnid with an arrow made of the root of one of its brothers will really hit hard, and if they don''t die, you can be sure it''ll ruin their lives forever! Good show!');
INSERT INTO "item_descriptions" VALUES(462,'fr','Le bois d''Abraknyde étant toujours vivant une fois coupé, cet arc est très difficile à utiliser. Cependant, il n''y a pas mieux pour ridiculiser un Abraknyde, que de le tuer avec un arc issu des racines de ses propres frères.');
INSERT INTO "item_descriptions" VALUES(462,'es','Ya que la madera de abráknido sigue viva incluso después de cortarla, este arco es muy difícil de usar. Sin embargo, no hay nada mejor para ridiculizar a un abráknido que matarlo con un arco hecho a partir de las raíces de sus propios hermanos.');
INSERT INTO "item_descriptions" VALUES(462,'pt','A madeira de Arvraknídeo ainda continua viva mesmo depois de ter sido cortada e isto a faz ser de uso muito difícil. Matar um Arvraknídeo com um arco feito da raiz de um de seus irmãos é, sem dúvida, a melhor maneira de ridicularizar tal criatura, se você realmente quiser isso...');
INSERT INTO "item_descriptions" VALUES(462,'de','Da das Holz eines Astaknyden selbst abgeschnitten noch lebendig ist, ist es nicht einfach, diesen Bogen zu gebrauchen. Doch gibt es nichts besseres um einen Astaknyden zu verspotten, als ihn mit einem Bogen zu töten, der aus den Wurzeln der eigenen Brüder gemacht wurde.');
INSERT INTO "item_descriptions" VALUES(469,'en','This wand makes use of the magic properties of the Treechnid Root. Beware of the side effects of this living wand, it can sometimes turn against its owner.');
INSERT INTO "item_descriptions" VALUES(469,'fr','Cette baguette utilise les propriétés magiques de la Racine d''Abraknyde qui est encore vivante, méfiez-vous des effets néfastes de cette baguette, il lui arrive parfois de se retourner contre son maître.');
INSERT INTO "item_descriptions" VALUES(469,'es','Esta varita utiliza las propiedades mágicas de la raíz de abráknido todavía en vida, ten cuidado con los efectos nefastos que puede producir, a veces se vuelve contra su amo.');
INSERT INTO "item_descriptions" VALUES(469,'pt','Esta varinha usa as propriedades mágicas da Raiz de Arvraknídeo. Cuidado com os efeitos negativos desta varinha viva, às vezes pode virar contra seu dono.');
INSERT INTO "item_descriptions" VALUES(469,'de','Die Macht dieses Stabes beruht auf den magischen Eigenschaften der noch lebendigen Astaknydenwurzeln. Darum solltet ihr immer auf der Hut sein vor üblen Überraschungen. Der Stab kann sich nämlich manchmal auch gegen den Träger wenden.');
INSERT INTO "item_descriptions" VALUES(478,'en','This axe has Woodee the Lumberjane to thank for its name... She knew how to turn on the charm and divert the lumberjacks'' attention, running in and stealing all the best trees for herself while they scurried off to pay ridiculous prices for rosebuds, sugarcane and those little snow globes that you shake... as soppy as wells they were.');
INSERT INTO "item_descriptions" VALUES(478,'fr','Cette hache doit son nom à Woodee la Bûcheronne, qui savait user de ses charmes pour détourner l''attention des autres Bûcherons et ainsi garder secret l''emplacement des rares Charmes dont elle voulait préserver l''existence.');
INSERT INTO "item_descriptions" VALUES(478,'es','Esta hacha debe su nombre a Woody la Leñadora que sabía utilizar sus encantos para atraer la atención de los demás leñadores y de esta manera guardar secreto el emplazamiento de los escasos carpes cuya existencia quería preservar.');
INSERT INTO "item_descriptions" VALUES(478,'pt','Este machado deve seu nome à Woodee, a Lenhadora... Ela sabia perfeitamente como usar seu charme para desviar a atenção dos lenhadores e, assim, manter secreta a localização dos raros feitiços que ela queria preservar.');
INSERT INTO "item_descriptions" VALUES(478,'de','Der Ursprung des Namens dieser Axt ist auf die Holzfällerin Woodee Woodschrecker zurückzuführen, die ihren ganzen Charme dafür aufwandte, die Aufmerksamkeit der anderen Holzfäller zu erregen, um so die Position der letzten Hainbuchen geheimzuhalten, deren Existenz sie schützen wollte.');
INSERT INTO "item_descriptions" VALUES(482,'en','An Enutrof builder who''d had a few drinks too many at the tavern realised one night that this shovel could do more than dig holes in the ground.');
INSERT INTO "item_descriptions" VALUES(482,'fr','Après une soirée un peu trop arrosée à la taverne qui a débouché sur une bagarre, un Enutrof s''est aperçu que cette pelle conçue à l''origine pour les grands travaux de construction était une excellente arme.');
INSERT INTO "item_descriptions" VALUES(482,'es','Después de una noche demasiado alcoholizada que acabó con una pelea general en la taberna, un anutrof se dio cuenta de que esta pala, en su origen diseñada para los grandes obras de construcción, era una excelente arma.');
INSERT INTO "item_descriptions" VALUES(482,'pt','Um Enutrof que bebeu muitas na taverna, percebeu um dia que esta pá, originalmente projetada para o trabalho de construção, também era uma excelente arma para lutas de bebedores de Cerveja.');
INSERT INTO "item_descriptions" VALUES(482,'de','Ein Enutrof, der wohl in der Taverne ein wenig über seinen Durst getrunken hatte, stellte eines Tages fest, dass sich diese ursprünglich zum Ausheben unterirdischer Gänge konzipierte Schaufel auch hervorragend dazu eignet, die dicken Schädel von Gegnern zu bearbeiten.');
INSERT INTO "item_descriptions" VALUES(497,'en','An essential tool for collecting ore.');
INSERT INTO "item_descriptions" VALUES(497,'fr','Outil indispensable à la collecte des minerais.');
INSERT INTO "item_descriptions" VALUES(497,'es','Herramienta indispensable para la extracción de minerales.');
INSERT INTO "item_descriptions" VALUES(497,'pt','Ferramenta indispensável para a coleta de minerais.');
INSERT INTO "item_descriptions" VALUES(497,'de','Dieses Werkzeug ist zum Abbau von Erz einfach unentbehrlich.');
INSERT INTO "item_descriptions" VALUES(502,'en','This axe is the only tool that can cut down enchanted trees. It''s the silver bullet of axes.');
INSERT INTO "item_descriptions" VALUES(502,'fr','Cette hache est une des seules à pouvoir couper des arbres envoûtés, on peut donc par extension, affirmer qu''elle peut trancher tout ce qui est envoûté, vivant ou non.');
INSERT INTO "item_descriptions" VALUES(502,'es','Esta hacha es una de las únicas en poder cortar árboles embrujados, por lo cual podemos afirmar que por extensión, puede cortar todo lo que está embrujado, que esté vivo o no.');
INSERT INTO "item_descriptions" VALUES(502,'pt','Este era o único machado que pode cortar árvores encantadas. O que quer dizer que se pode cortar tudo que é encantado, vivo ou não.');
INSERT INTO "item_descriptions" VALUES(502,'de','Diese Axt ist eine der wenigen, die in der Lage sind, auch verzauberte Bäume zu fällen. Das bedeutet, dass sie alles zerschneidet, was magisch ist – ganz gleich, ob lebendig oder nicht.');
INSERT INTO "item_descriptions" VALUES(515,'en','This axe once belonged to the renowned lumberjack, Brouce Boulgoure. He used to be married to Kassiopee Baine, another great lumberjack''s daughter. Many''s the time this weapon protected him when he was alone in the forest.');
INSERT INTO "item_descriptions" VALUES(515,'fr','Cette hache a appartenu à Brouce Boulgoure le fameux Bûcheron, marié jadis avec Kassiopée Baine, fille d''un autre grand Bûcheron. Cette arme lui permit de se défendre maintes fois lorsqu''il partait la nuit couper des forêts entières.');
INSERT INTO "item_descriptions" VALUES(515,'es','Esta hacha perteneció a Brus Bulguro, el famoso Leñador, casado con Kasiope Baine, hija de otro gran Leñador. Esta arma le permitió defenderse en muchas ocasiones cuando se marchaba de noche para cortar bosques enteros.');
INSERT INTO "item_descriptions" VALUES(515,'pt','Este machado pertenceu ao famoso Lenhador Brouce Boulgoure. Ele era casado com Kassiopee Baine, filha de outro grande Lenhador. Esta arma freqüentemente o protegia à noite, quando ele cortava florestas inteiras.');
INSERT INTO "item_descriptions" VALUES(515,'de','Diese Axt gehörte einmal dem berühmten Holzfäller Bruce Bulgour, der Kassiopoe Benn, die Tochter eines anderen großen Holzfällers, geheiratet hatte. Mit dieser Waffe pflegte er sich des Nachts zu verteidigen, wenn er loszog, um ganze Wälder niederzumähen.');
INSERT INTO "item_descriptions" VALUES(592,'en','This bow once belonged to Ivan Nowe, a foolhardy Cra who had a cruel habit of attacking stray Tofus. This bow first puzzles the enemy before efficiently killing them.');
INSERT INTO "item_descriptions" VALUES(592,'fr','Cet arc a appartenu à Ivan Nowé, un Crâ téméraire, qui a pourfendu plus d''un Tofu égaré. Cet arc a la particularité de faire des coups pour le moins surprenants qui laissent perplexes puis agonisants les ennemis.');
INSERT INTO "item_descriptions" VALUES(592,'es','Este arco perteneció a Ivan Nowe, un ocra temerario que combatió a más de un Tofu perdido. Este arco tiene la particularidad de producir efectos muy extraños al ser disparado, pues deja perplejos y agonizantes a sus enemigos.');
INSERT INTO "item_descriptions" VALUES(592,'pt','Este arco uma vez pertenceu a Ivan Nowé, um ousado discípulo de Cra que já tinha roubado mais do que um Tofu vagabundo. Este arco pode infligir danos surpreendentes que confundem os inimigos e depois os mata.');
INSERT INTO "item_descriptions" VALUES(592,'de','Dieser Bogen gehörte Ivan Hau, einem kampferprobten Crâ, der bereits mehr als einen entlaufenen Tofu niedergestreckt hat. Dieser Bogen hat die Besonderheit, den Gegner durch besondere Trickschüsse zu überraschen, die ihn erst perplex machen und dann sterbend zu Boden fallen lassen.');
INSERT INTO "item_descriptions" VALUES(610,'en','This delicate but original whitish amulet is made of Crab.');
INSERT INTO "item_descriptions" VALUES(610,'fr','Cette amulette blanchâtre est confectionnée avec du Crabe, ce qui en fait une amulette très fragile mais originale.');
INSERT INTO "item_descriptions" VALUES(610,'es','Este amuleto blanquecino está hecho con cangrejo, lo cual hace de él un amuleto muy frágil pero original.');
INSERT INTO "item_descriptions" VALUES(610,'pt','Este delicado, porém original, amuleto esbranquiçado é feito de Caranguejo.');
INSERT INTO "item_descriptions" VALUES(610,'de','Dieses weißliche Amulett wurde aus Krebsschalen gefertigt, was es zwar sehr zerbrechlich, aber auch originell erscheinen lässt.');
INSERT INTO "item_descriptions" VALUES(616,'en','This amulet, set with fish scales, is supposed to bring its wearer good luck when he puts out to sea on stormy nights.');
INSERT INTO "item_descriptions" VALUES(616,'fr','Cette amulette, sertie d''écailles de poisson, est censée porter chance à son propriétaire lorsqu''il part en mer les jours de tempête.');
INSERT INTO "item_descriptions" VALUES(616,'es','Este amuleto, engastado con escamas de pescado, atrae supuestamente la suerte a su propietario cuando sale al mar los días de tempestad.');
INSERT INTO "item_descriptions" VALUES(616,'pt','Este amuleto, enfeitado com escamas de peixe, traz sorte ao seu portador quando ele sai para o mar em dias tempestuosos.');
INSERT INTO "item_descriptions" VALUES(616,'de','Dieser Halskette aus großen Fischschuppen sagt man nach, dass sie den Träger selbst bei stürmischem Seegang vor Unheil bewahren soll.');
INSERT INTO "item_descriptions" VALUES(617,'en','Many sailors have been impressed by this terrifying amulet. All you have to do is put it on and you''ll be a feared warrior.');
INSERT INTO "item_descriptions" VALUES(617,'fr','Cette amulette terrifiante a impressionné plus d''un marin, la porter sur soi suffit à faire de vous une personne redoutée.');
INSERT INTO "item_descriptions" VALUES(617,'es','Este terrorífico amuleto ha impresionado a más de un marinero, llevarlo contigo es suficiente para hacer de ti una temible persona.');
INSERT INTO "item_descriptions" VALUES(617,'pt','Vários navegadores ficaram impressionados com este amuleto aterrorizante. Tudo que você tem de fazer é colocá-lo para se tornar um temido combatente.');
INSERT INTO "item_descriptions" VALUES(617,'de','Dieses furchterregende Amulett hat bereits mehr als einen Seemann beeindruckt. Schon das bloße Tragen verbreitet Angst und Schrecken.');
INSERT INTO "item_descriptions" VALUES(619,'en','This staff allowed Paile Ingalsse, breeder of Gobballs, to summon the Tofus that kept his flocks safe. After a tragic accident, he discovered that it was also a fierce weapon.');
INSERT INTO "item_descriptions" VALUES(619,'fr','Ce bâton permettait à Farle Ingalsse, éleveur de Bouftous, d''invoquer plus facilement des Tofus gardiens de troupeaux. Au fil du temps, ce bâton s''est révélé être une excellente arme de combat.');
INSERT INTO "item_descriptions" VALUES(619,'es','Este bastón le permitía al criador de jalatós, Farle Ingals, invocar más fácilmente a tofus guardianes de rebaños. Con el paso del tiempo, este bastón resultó ser una excelente arma de combate.');
INSERT INTO "item_descriptions" VALUES(619,'pt','Com este cajado, Farle Ingals, um criador de Papatudo, podia invocar mais facilmente os Tofus guardiões de rebanho. Com o passar do tempo, o cajado se revelou uma excelente arma de combate.');
INSERT INTO "item_descriptions" VALUES(619,'de','Mit diesem Stecken konnte der Fresssackhirte Farle Ingalsse Tofus beschwören, die seine Herden bewachten. Im Laufe der Zeit stellte sich heraus, dass dieser Stecken gleichfalls eine hervorragende Waffe im Kampf abgibt.');
INSERT INTO "item_descriptions" VALUES(620,'en','Thanks to this sword, the celebrated sailor Mobby Diquerivurs sliced the tentacles off the equally famous Giant Kralove of Moon Island, much feared for his habit of smothering drunken sailors.');
INSERT INTO "item_descriptions" VALUES(620,'fr','Cette épée a permis au célèbre marin Mobby Diqueriveurse, de découper en tranches, les tentacules du célèbre Kralamoure Géant de l''île de Moon, réputé pour étouffer les marins saouls et saouler les marins étouffés.');
INSERT INTO "item_descriptions" VALUES(620,'es','Esta espada ha permitido al célebre marinero Moby Chic, poder cortar en lonchas los tentáculos del célebre Kralamar Gigante de Isla de Moon, famoso por asfixiar a los marineros borrachos.');
INSERT INTO "item_descriptions" VALUES(620,'pt','Graças a esta espada, o famoso marinheiro Mobby Diqueriveurse fatiou os tentáculos do não menos famoso Kralamor Gigante da Ilha da Lua, conhecido por sufocar marinheiros eufóricos.');
INSERT INTO "item_descriptions" VALUES(620,'de','Mit diesem Säbel konnte der berühmte Seemann Mobbly Dickmann die Tentakel des für das Ersticken betrunkener Seebären berüchtigten Riesenkrakamors der Moon-Insel in Scheiben tranchieren.');
INSERT INTO "item_descriptions" VALUES(629,'en','This delightful hat will make your adventurer the belle of the ball... the masked ball, that is (ha ha ha)!');
INSERT INTO "item_descriptions" VALUES(629,'fr','Ce magnifique chapeau permettra à votre héros d''être la plus belle pour aller danser au bal masqué (hohé hohé).');
INSERT INTO "item_descriptions" VALUES(629,'es','Este magnífico sombrero le permitirá a tu héroe ser el más hermoso para ir a bailar o a la playa (ho, hohohohooo...).');
INSERT INTO "item_descriptions" VALUES(629,'pt','Seu herói será a Rainha do Equilíbrio com esse magnífico chapéu.');
INSERT INTO "item_descriptions" VALUES(629,'de','Dieser wunderschöne Hut wird euch sicherlich wieder eine Auszeichnung zum bestverkleidetsten Abenteurer auf dem jährlichen Kindermaskenball bescheren. Einfach stylisch!');
INSERT INTO "item_descriptions" VALUES(638,'en','Fishing a Somoon is quite a miracle but don''t worry, with this amulet around your neck, there''s no such word as "can''t".');
INSERT INTO "item_descriptions" VALUES(638,'fr','Pêcher un Somoon relève de l''exploit, mais avec cette amulette sur soi, plus rien n''est impossible.');
INSERT INTO "item_descriptions" VALUES(638,'es','Pescar Salmoon es una verdadera hazaña, pero si llevas este amuleto, ya nada es imposible.');
INSERT INTO "item_descriptions" VALUES(638,'pt','Pescar um Somoon é quase um milagre, mas não se preocupe, com este amuleto em volta do pescoço, não há palavras como "não posso".');
INSERT INTO "item_descriptions" VALUES(638,'de','Einen Somoon zu fischen ist kaum machbar, doch mit diesem Amulett ist für den Träger nichts mehr unmöglich.');
INSERT INTO "item_descriptions" VALUES(639,'en','This Amulet of the Depths was found in the submerged shipwreck of the renowned Kralove fisherman, Tom Fawyer, also famous for his lousy jokes at the pirates'' bar.');
INSERT INTO "item_descriptions" VALUES(639,'fr','Cette amulette a été retrouvée dans l''épave échouée du célèbre pêcheur de Kralamoure, Moby Diqueriveurse, qui était également populaire pour ses boutades vaseuses au bar des pirates.');
INSERT INTO "item_descriptions" VALUES(639,'es','Este amuleto ha sido encontrado entre los restos del barco encallado del célebre pescador de Kralamares, Moby Chic, también famoso en el bar de los piratas por contar siempre chistes malos.');
INSERT INTO "item_descriptions" VALUES(639,'pt','O Amuleto das Profundezas foi encontrado nos destroços submersos do navio do renomado pescador Kralamorus, Moby Diqueriveurse, também famoso por suas piadas ruins no bar dos piratas.');
INSERT INTO "item_descriptions" VALUES(639,'de','Dieses Amulett wurde im auf Grund gelaufenen Wrack des bekannten Krakamor-Fischers, Moby Drifftick, gefunden, der in einem großen Umkreis für seine lausigen Witze in der Piratenbar bekannt war.');
INSERT INTO "item_descriptions" VALUES(640,'en','Fishermen used this bow to clean the vermin off the coastlines of Amakna... The cowards usually committed the pesticide from the windows of the local bars.');
INSERT INTO "item_descriptions" VALUES(640,'fr','Cet arc permettait aux pêcheurs de nettoyer les rivages de toute la vermine environnante sans avoir à se lever de leur siège, et cela depuis la fenêtre du bar des pirates.');
INSERT INTO "item_descriptions" VALUES(640,'es','Este arco les permitía a los pescadores eliminar a toda la chusma de las costas vecinas sin tener que levantarse de su silla, pues disparaban desde la ventana del bar de los piratas.');
INSERT INTO "item_descriptions" VALUES(640,'pt','Este arco permitiu aos pescadores limpar as praias, matando os animais daninhos das redondezas... dos Piratas Trancam Janelas, sem ter de levantar de suas cadeiras...');
INSERT INTO "item_descriptions" VALUES(640,'de','Dieser Bogen wurde für Fischer entwickelt, welche die Küste von herumlungerndem Ungeziefer befreien wollten, ohne dafür von ihrem Sitz aufstehen zu müssen. Und dies auch noch durch das Fenster ihrer Lieblingskneipe hindurch. Wahnsinn!');
INSERT INTO "item_descriptions" VALUES(657,'en','This staff allowed Shika Ingalsse, leader of Gobballs, to summon the Tofus that kept her flocks safe. After a tragic accident, she discovered that it was also a fierce weapon.');
INSERT INTO "item_descriptions" VALUES(657,'fr','Ce bâton permettait à Shika Ingalsse, éleveuse de Tofus, d''invoquer plus facilement des Tofus gardiens de troupeaux. Au fil du temps, ce bâton s''est révélé être une excellente arme de combat.');
INSERT INTO "item_descriptions" VALUES(657,'es','Este bastón le permitía a la criadora de Tofus, Shika Ingals, invocar más fácilmente a Tofus guardianes de rebaños. Con el paso del tiempo, este bastón resultó ser una excelente arma para el combate.');
INSERT INTO "item_descriptions" VALUES(657,'pt','Este cajado permitiu a Shika Ingalsse, uma criadora de Tofus, invocar facilmente Tofus que mantinham os rebanhos seguros. Com o passar dos dias, este cajado provou ser uma excelente arma de luta.');
INSERT INTO "item_descriptions" VALUES(657,'de','Mit diesem Stecken kann die Tofuhirtin Shika Ingalsse Tofus beschwören, welche die Herden bewachen. Im Laufe der Zeit stellte sich heraus, dass dieser Stecken gleichfalls eine hervorragende Waffe im Kampf abgibt.');
INSERT INTO "item_descriptions" VALUES(658,'en','This staff allowed Gramine Ingalsse, leader of Gobballs, to summon the Tofus that kept his flocks safe. After a tragic accident, he discovered that it was also a fierce weapon.');
INSERT INTO "item_descriptions" VALUES(658,'fr','Ce bâton permettait à Gramine Ingalsse, éleveuse de Tabis, d''invoquer plus facilement des Tofus gardiens de troupeaux. Au fil du temps, ce bâton s''est révélé être une excellente arme de combat.');
INSERT INTO "item_descriptions" VALUES(658,'es','Este bastón le permitía a la criadora de Tabis, Gramine Ingals, invocar más fácilmente a Tofus guardianes de rebaños. Con el paso del tiempo, este bastón resultó ser una excelente arma para el combate.');
INSERT INTO "item_descriptions" VALUES(658,'pt','Este cajado permitiu a Gramine Ingalsse, uma criadora de Tabis, invocar facilmente Tofus que mantinham os rebanhos seguros. Com o passar dos dias, o cajado provou ser uma excelente arma de luta.');
INSERT INTO "item_descriptions" VALUES(658,'de','Mit diesem Stecken kann die Tabihirtin Gramine Ingalsse Tofus beschwören, welche die Herden bewachen. Im Laufe der Zeit stellte sich heraus, dass dieser Stecken gleichfalls eine hervorragende Waffe im Kampf abgibt.');
INSERT INTO "item_descriptions" VALUES(674,'en','"There''s nothing wrong with this axe... Seriously, nothing. Really." The wise words of Brouce Boulgoure, lumberjack extraordinaire. Its Cherry Wood shaft cushions vibrations when you''re cutting trees down or splitting Bworks'' skulls.');
INSERT INTO "item_descriptions" VALUES(674,'fr','"Cette hache a tout pour plaire" disait le fameux slogan de Brouce Boulgoure le célèbre bûcheron. En effet, son manche en Bois de Merisier permet d''amortir les vibrations lors de l''abattage des arbres ou des bworks au crâne un peu trop solide.');
INSERT INTO "item_descriptions" VALUES(674,'es','«Esta hacha es la más mejor» decía el famoso eslogan de Brus Bulguro el célebre leñador. Pues su mango de madera de cerezo silvestre permite amortiguar las vibraciones producidas por la tala de los árboles o por el contacto con los cráneos de bwork demasiado duros.');
INSERT INTO "item_descriptions" VALUES(674,'pt','‘Este machado só tem vantagens''. Este era o lema famoso de Brouce Boulgoure – Madeireiro famoso. Seu cabo feito de cerejeira, emite vibrações quando você está cortando árvores ou rachando crânios.');
INSERT INTO "item_descriptions" VALUES(674,'de','"Diese Axt hat alles, was eine gute Axt haben muss", lobte sie einmal der bekannte Holzfäller Bruce Bulgour. In der Tat. Sie lässt sich leicht und kontrolliert durch die Luft schwingen und der Griff aus echtem Vogelkirschenholz absorbiert die auftretenden Vibrationen beim Spalten massiver Baumstämme oder dicker Bworkschädel.');
INSERT INTO "item_descriptions" VALUES(675,'en','This axe doesn''t look special, but it gets the job done. Brouce Boulgoure the lumberjack won the Bwork Dwarf tree-cutting championship with this modest tool - that''s saying something.');
INSERT INTO "item_descriptions" VALUES(675,'fr','Cette hache à l''aspect rudimentaire, n''en est pas moins efficace. C''est avec cet outil que Brouce Boulgoure le Bûcheron a gagné le concours de tranchage de Bworks nains. Voilà qui en dit long sur l''efficacité de cette hache.');
INSERT INTO "item_descriptions" VALUES(675,'es','Esta hacha aparentemente rudimentaria, no deja de ser increíblemente eficaz. Fue con esta herramienta que Brus Bulguro ganó el concurso de Corte de Bworks Enanos. Eso demuestra su eficacia.');
INSERT INTO "item_descriptions" VALUES(675,'pt','Este machado tem uma aparência simples, mas não o faz menos eficiente. Brouce Boulgoure foi o Madeireiro que ganhou a competição de Cortes de Anões Bworks com esta ferramenta. O qual nos conta muito bem sobre a eficiência desse machado.');
INSERT INTO "item_descriptions" VALUES(675,'de','Diese gewöhnlich erscheinende Axt ist sehr wirkungsvoll. Mit ihr gewann Bruce Bulgour nämlich einst den Wettkampf im Bworkzwergspalten. Das nur als kleine Erinnerung an die Wirksamkeit dieser Axt.');
INSERT INTO "item_descriptions" VALUES(676,'en','This axe''s special feature is that it never gets rusty, so don''t be surprised when hungry lumberjacks start licking the sweet tree sap from its blade.');
INSERT INTO "item_descriptions" VALUES(676,'fr','Cette hache a la particularité de ne jamais rouiller, pour éviter de désagréables surprises lorsque les Bûcherons gourmands décident de lécher le sirop d''érable sur la lame après une éprouvante journée d''abattage d''érables.');
INSERT INTO "item_descriptions" VALUES(676,'es','Esta hacha tiene la particularidad de nunca oxidarse, para evitar desagradables sorpresas cuando los golosos Leñadores deciden lamer el jarabe de Arce sobre su filo tras una agotadora jornada de tala.');
INSERT INTO "item_descriptions" VALUES(676,'pt','Este machado nunca enferruja, poupa você de surpresas desagradáveis quando lenhadores ambiciosos começam a cuspir na lâmina após trabalhar duro em um longo dia cortando árvores.');
INSERT INTO "item_descriptions" VALUES(676,'de','Diese Axt hat den großen Vorteil, nicht zu rosten. Das vermeidet sicherlich unliebsame Überraschungen bei allen Naschkatzen unter den Holzfällern, die gern am Ende ihres anstrengenden Tagewerkes den süßen Ahornsirup von den Axtblättern ablecken.');
INSERT INTO "item_descriptions" VALUES(677,'en','This cloak once belonged to Zokrim, an old pirate. He must have been rather unlucky.');
INSERT INTO "item_descriptions" VALUES(677,'fr','Cette cape a appartenu à un vieux pirate du nom de Zokrim. Il devait être plutôt malchanceux...');
INSERT INTO "item_descriptions" VALUES(677,'es','Esta capa perteneció a un viejo pirata llamado Zokrim. Qué poca suerte tuvo...');
INSERT INTO "item_descriptions" VALUES(677,'pt','Este manto uma vez pertenceu a Zokrim, um velho pirata. Ele ter ser sem sorte...');
INSERT INTO "item_descriptions" VALUES(677,'de','Dieser Umhang gehörte einst einem alten Piraten namens Zokrim. Er soll nicht nur ein schräger Vogel, sondern vor allem ein ganz schöner Pechvogel gewesen sein...');
INSERT INTO "item_descriptions" VALUES(694,'en','Ignemikahl the Fire Dragon created the Crimson Dofus. I would tell you that it stinks of sulphur... but it stinks of so many other things too.');
INSERT INTO "item_descriptions" VALUES(694,'fr','C''est le Dragon du Feu Ignemikhal qui créa le Dofus Pourpre, un Œuf dont le moins qu''on puisse dire, c''est qu''il sent le soufre - mais il sent bien d''autres choses encore...');
INSERT INTO "item_descriptions" VALUES(694,'es','Ignemikhal, el dragón de fuego, creó el dofus Púrpura, un huevo que huele a azufre que da asco... Aunque la verdad, también huele a muchas cosas más...');
INSERT INTO "item_descriptions" VALUES(694,'pt','Ignemikhal, o Dragão do Fogo, que criou o Dofus Púrpuro. O mínimo que podemos dizer deste ovo é que ele cheira a enxofre – mas também cheira a muitas outras coisas...');
INSERT INTO "item_descriptions" VALUES(694,'de','Dieses Ei wurde vom Feuerdrachen Ignemikhal gelegt. Das Mindeste, was man von ihm behaupten kann, ist, dass es mächtig nach Schwefel stinkt. Aber das ist auch bloß das Mindeste...');
INSERT INTO "item_descriptions" VALUES(696,'en','Besides its has-been look, the Slob Headgear is great for those high-noon duels... keeps some sun out of your eyes.');
INSERT INTO "item_descriptions" VALUES(696,'fr','La Coiffe du Ploukosse, sous ses dehors "has been", est très efficace lors des combats pour un simple chapeau de paille.');
INSERT INTO "item_descriptions" VALUES(696,'es','Aunque parezca haber pasado de moda, el Sombrero del Paletoso es muy eficaz para poder dormirte en las pajas en pleno combate.');
INSERT INTO "item_descriptions" VALUES(696,'pt','Apesar da aparência brega, a Touca-Suja é muito eficiente durante as lutas, pelo menos para um mero chapéu.');
INSERT INTO "item_descriptions" VALUES(696,'de','Das Grobianium macht zwar den Anschein, die letzten 10 Modewechsel übersprungen zu haben, aber dafür ist es sehr wirkungsvoll im Kampf... für einen simplen Strohhut jedenfalls.');
INSERT INTO "item_descriptions" VALUES(698,'en','The Sortingat Hogwat comes from a famous School of Magic. This lively creature has met the greatest wizards of our time, like Mrs Magoa AlaGale, Mr Doublegore and the renowned Misk''arry Rotter.');
INSERT INTO "item_descriptions" VALUES(698,'fr','Le Choipo Podlard vient d''une grande école de magie. Créature vivante, il a rencontré les plus grands magiciens de notre temps, tels que Mme Magoa AlaGale, Mr Doublegore et le célèbre Remy Krokeur.');
INSERT INTO "item_descriptions" VALUES(698,'es','El sombrero de Selección de Hoguarts ha sido creado en una gran escuela de magia. Es un objeto con vida propia y ha conocido a los magos más famosos de la historia, como la Señora Magonagal, el Señor Doblegore y el célebre Javi Popers.');
INSERT INTO "item_descriptions" VALUES(698,'pt','O Sortingat Hogwat vem de uma famosa Escola de Magia. Esta criatura vivente conheceu os grandes mágicos de nosso tempo, como a Sra. Magoa AlaGale, Sr. Doublegore e o renomado Remy Krokeur.');
INSERT INTO "item_descriptions" VALUES(698,'de','Sprehs Hut enthält mächtige Magie. Lebendig und doch unsterblich hat er daher bereits die größten Magier aller Zeiten kennengelernt, wie beispielsweise Meinerve Mons Goanidgähr, Rumpelmore von der Alm und den berühmten haarigen Zocker.');
INSERT INTO "item_descriptions" VALUES(699,'en','The Troma is as shady as an eraserhead made of Bherb hairs, and that''s saying something (if you don''t know what an eraserhead made of Bherb hairs looks like, refer to the great books of the Hen Pens).');
INSERT INTO "item_descriptions" VALUES(699,'fr','Le Troma est aussi craignos qu''un Rasboul en poil de Bitouf. (Pour ceux qui ne savent pas ce qu''est un Rasboul en poil de bitouf, référez-vous aux grands livres des Craps à Poules).');
INSERT INTO "item_descriptions" VALUES(699,'es','El Etreuma es tan peligroso como un Afeitabola en pelo de pollufo. (Para los que no saben lo que es un Afeitabola en pelo de pollufo, consúltese el libro de los Craps para Gallinas).');
INSERT INTO "item_descriptions" VALUES(699,'pt','O Troma é tão desagradável quanto um Rasgabola feito de pelos de Bitufo. (Se você não souber como é um Rasgabola feito de pelos de Bitufo, consulte os grandes livros de Hen Pens).');
INSERT INTO "item_descriptions" VALUES(699,'de','Der Troma ist genauso zwielichtig und furchterregt wie ein Krallkopf mit Tschwantzfehdern. (Alle, die nicht wissen, was ein Krallkopf mit Tschwantzfehdern ist, können dies im großen Buch des Tschuftmann Gurus nachlesen.)');
INSERT INTO "item_descriptions" VALUES(701,'en','The Oiram has many fans throughout the World who just love its classy look. This hat once belonged to a plumber who spent his days cleaning pipes. He was quite stylish himself.');
INSERT INTO "item_descriptions" VALUES(701,'fr','Le Oiram a fait de nombreux adeptes de part le monde, du fait de son côté très classieux... Ce chapeau a longtemps été porté par un plombier qui passait son temps à sauter et courir...');
INSERT INTO "item_descriptions" VALUES(701,'es','El Oiram tiene adeptos en el mundo entero gracias a su aspecto elegante... Este sombrero perteneció durante mucho tiempo a un fontanero que no dejaba de saltar y correr en todas las direcciones...');
INSERT INTO "item_descriptions" VALUES(701,'pt','O Oiram tem muitos entusiastas em todo o mundo graças à sua aparência refinada... Este chapéu pertenceu a um encanador que passou seu tempo correndo e pulando...');
INSERT INTO "item_descriptions" VALUES(701,'de','Der Oiram hat bereits viele Anhänger auf allen Teilen der Welt gefunden, da er einfach klasse aussieht...Bevor er in eure Hände kam, wurde er lange Zeit von einem durchgeknallten Klempner getragen, der es liebte, damit durch die Gegend zu rennen und zu hüpfen.');
INSERT INTO "item_descriptions" VALUES(702,'en','This demon skull, constructed from various bones, gives its bearer a graceful and elegant look. Even your lover will be sick with envy.');
INSERT INTO "item_descriptions" VALUES(702,'fr','Ce crâne de démon reconstruit à partir d''ossements divers et variés apporte grâce et élégance à son porteur... Vos amies vont vous jalouser...');
INSERT INTO "item_descriptions" VALUES(702,'es','Este cráneo de demonio reconstruido a partir de huesos diversos y variados procura gracia y elegancia a quien lo lleve puesto... Tus amigas te envidiarán mucho...');
INSERT INTO "item_descriptions" VALUES(702,'pt','Este crânio de demônio, reconstruído de vários ossos, tornando-o gracioso e elegante... Suas amigas sentirão inveja...');
INSERT INTO "item_descriptions" VALUES(702,'de','Dieser Dämonenschädel, der aus den unterschiedlichsten Knöchelchen zusammengefügt wurde, wird seinen  Träger mit Anmut und Eleganz verleihen... Eure Freundinnen werden vor Neid platzen.');
INSERT INTO "item_descriptions" VALUES(703,'en','This magical hat, which looks like an upside-down wicker fruit basket, is in fact... a magical upside-down fruit basket hat. It will certainly impress the neighbours, especially if they are Bwork Magus apprentices.');
INSERT INTO "item_descriptions" VALUES(703,'fr','Ce chapeau, en forme de corbeille à fruits en osier renversée, est en fait une corbeille à fruits renversée magique. Ce qui ne manquera pas d''impressionner votre entourage, surtout s''il est composé d''apprentis Bworks Mages.');
INSERT INTO "item_descriptions" VALUES(703,'es','Este sombrero en forma de cesta de mimbre para fruta volcada es una cesta de mimbre para fruta volcada mágica. Impresionará a tu entorno, sobre todo si este está compuesto por aprendices bworks magos.');
INSERT INTO "item_descriptions" VALUES(703,'pt','Este chapéu, que parece com uma cesta de frutas feita de vime de cabeça para baixo, é, na realidade, uma cesta mágica de frutas de cabeça para baixo. Certamente impressionará pessoas ao seu redor, especialmente se elas forem aprendizes de Bworks Magos.');
INSERT INTO "item_descriptions" VALUES(703,'de','Dieser Hut ist nichts anderes als ein umgedrehter, magischer Früchtekorb. Damit werdet ihr bestimmt eure gesamte Umgebung beeindrucken können, vor allem, wenn es sich dabei um junge Bwork Magus-Lehrlinge handelt.');
INSERT INTO "item_descriptions" VALUES(704,'en','With this hat made from Chafer leather briefs, the female Bwork Magi won''t be able to resist you. That''s not a good thing, mind - many are known to wear long, red beards and none are known for their femininity.');
INSERT INTO "item_descriptions" VALUES(704,'fr','Ce chapeau, confectionné à partir de Slips en cuir de Chafer Lancier tressés entre eux, vous rendra de toute évidence irrésistible auprès des femelles Bwork Mages, réputées pour leur féminité débordante, accentuée par leur barbe rousse.');
INSERT INTO "item_descriptions" VALUES(704,'es','Este sombrero hecho a base de slips de cuero de chafer lancero trenzados entre ellos, te volverá, sin duda alguna, irresistible con las hembras bwork magas, célebres por su desbordante feminidad, acentuada por su barba pelirroja.');
INSERT INTO "item_descriptions" VALUES(704,'pt','Com este chapéu feito das cuecas de couro de Chafer, a bwork maga não resistirá a você. Claro que você conhece estas damas: elas usam barbas vermelhas e são famosas por sua feminilidade transbordante.');
INSERT INTO "item_descriptions" VALUES(704,'de','Mit diesem Hut aus miteinander verknoteten Chafer-Lederunterhosen seid ihr der neue Star... Zumindest bei den weiblichen Bwork Magi mit ihren roten Bärten und ihrer überwältigenden Weiblichkeit...');
INSERT INTO "item_descriptions" VALUES(705,'en','If what you''re looking for is a bit of trauma, you''ll find great relief in this magnificent coconut. We remind you that a free straw and many a mouthful of fresh coconut-flavoured goodness are waiting for you inside.');
INSERT INTO "item_descriptions" VALUES(705,'fr','Si vous voulez être traumatisé, il vous faut absolument cette magnifique noix de coco trouée. Nous rappelons à l''utilisateur que l''intérieur est équipé d''une paille et de boissons rafraîchissantes.');
INSERT INTO "item_descriptions" VALUES(705,'es','Si quieres estar traumatizado, necesitas absolutamente esta magnífica nuez de coco perforada. Recordamos al usuario que el interior de esta máscara está equipada con una pajita y con bebidas refrescantes.');
INSERT INTO "item_descriptions" VALUES(705,'pt','Você precisa deste magnífico côco com buracos para ficar traumatizado. Nós lembramos ao usuário que uma palha, assim como bebidas frescas estão à sua disposição no interior.');
INSERT INTO "item_descriptions" VALUES(705,'de','Wenn ihr auf der Suche nach extremen Erfahrungen seid, wird euch diese tromatisierende Gesichtsmaske den echten Kick geben. Aber keine Sorge, es ist gar nicht so schlimm, wie es aussieht. Das Innere ist gepolstert und sogar mit einem Strohhalm und Cocktails versehen.');
INSERT INTO "item_descriptions" VALUES(706,'en','Hung ''Short Memory'' Lekahurse owned a magnificent crystal ball - his grandpa gave it to him. He wisely decided to hold on to it for the rest of his life. In fact, he put it on his hat which he never took off again, until one day, a jealous breeze took it away. He followed, and the breeze seemed to mock him, suspending the hat in the air, and whipping it away just as his searching fist approached. Not without a sense of decency, the wind took him home for a brief visit once a season and when it sensed the poor man was close to the end, took him to the edge of a cliff, hung the hat there for a moment and down Lekahurse tumbled, at peace at last.');
INSERT INTO "item_descriptions" VALUES(706,'fr','Hugne "le sans mémoire" possédait une magnifique boule de crystal que lui avait donné son pépé. Bien décidé à la conserver toute sa vie, il la plaça sur son chapeau, qu''il ne quittait jamais... Il est mort de fatigue, en essayant de la retrouver.');
INSERT INTO "item_descriptions" VALUES(706,'es','Hugne «el sin memoria» poseía una magnífica bola de crystal que le había regalado su abuelito. Ya que estaba decidido en conservarla toda su vida, se la puso sobre un sombrero que no se quitaba nunca... Se murió de cansancio, intentando encontrarla.');
INSERT INTO "item_descriptions" VALUES(706,'pt','Hugne ‘Memória Curta‘ possuiu uma magnífica bola de cristal, que seu vovô havia lhe dado. Bem decidido mantê-la pelo resto de sua vida, ele a pôs no chapéu que nunca tirava... Ela foi tão bem guardada, que ele morreu de fadiga tentando encontrá-la.');
INSERT INTO "item_descriptions" VALUES(706,'de','Hugne, der Gedächtnislose, besaß einst eine wunderschöne Kristallkugel, die er von seinem Großvater geerbt hatte. Da er sie zur Erinnerung stets bei sich tragen wollte, befestigte er sie an der Spitze seines Hutes, auf dass sie ihn immer begleiten würde... Doch dann vergaß er sie und starb an Erschöpfung beim Versuch, sie wiederzufinden.');
INSERT INTO "item_descriptions" VALUES(707,'en','With this Minotoror Horn hat, you''ll have no problem passing yourself off as a Minotoror if your confidence in your own powers is failing. This trickery only works on simple-minded creatures such as Iops and Tofus.');
INSERT INTO "item_descriptions" VALUES(707,'fr','Ce chapeau en Corne de Minotoror est très efficace pour impressionner ses adversaires en se faisant passer pour un Minotoror. Cette ruse ne semble fonctionner que sur les adversaires simplets. Un Iop ou un Tofu devrait faire l''affaire.');
INSERT INTO "item_descriptions" VALUES(707,'es','Este sombrero en cuerno de Minotauroro es muy eficaz para impresionar a sus adversarios haciéndose pasar por un minotauroro. Esta argucia solo parece funcionar con los adversarios más ingenuos. Así que debería colar con los yopuka o los tofus.');
INSERT INTO "item_descriptions" VALUES(707,'pt','Este chapéu, feito de chifres de Minotoro, é muito eficiente se você for impressionar seus adversários se passando por um Minotoro. Este truque só funciona com criaturas estúpidas como os discípulos de Iop e Tofus.');
INSERT INTO "item_descriptions" VALUES(707,'de','Dieser Hut aus Minotororhörnern ist sehr praktisch, um Gegnern vorzutäuschen, man sei ein gefährlicher Minotoror. Doch leider funktioniert diese List nur bei geistig etwas beschränkten Gegnern. Bei Iops und Tofus sollte das demnach gut klappen.');
INSERT INTO "item_descriptions" VALUES(708,'en','This hat gives whoever wears it a jolly appearance... jolly but incredibly stupid. In life, you can''t have it all – as the wearer of this hat clearly demonstrates.');
INSERT INTO "item_descriptions" VALUES(708,'fr','Ce chapeau donne à son porteur une allure guillerette, mais également un peu stupide. On ne peut pas tout avoir dans la vie, le porteur de ce chapeau en est d''ailleurs un excellent exemple.');
INSERT INTO "item_descriptions" VALUES(708,'es','Este sombrero da a su portador un aspecto vivaracho, aunque un poco estúpido. Uno no puede tenerlo todo en la vida, el portador de este sombrero llega a ser un excelente ejemplo de todo esto.');
INSERT INTO "item_descriptions" VALUES(708,'pt','Este chapéu dá ao portador uma aparência alegre, porém boba.  Ele é um ótimo exemplo de que não se pode ter tudo.');
INSERT INTO "item_descriptions" VALUES(708,'de','Dieser Hut verleiht seinem Träger ein keckes, wenn auch etwas dümmliches Aussehen. Man kann im Leben nicht alles haben ‒ der Träger dieser Kopfbedeckung ist dafür das beste Beispiel.');
INSERT INTO "item_descriptions" VALUES(709,'en','This hat once belonged to Lorko, a lumberjack. He challenged the famous Brouce Boulgoure to an elm-uprooting duel in Liroye Merline''s clearing.');
INSERT INTO "item_descriptions" VALUES(709,'fr','Ce chapeau appartenait à Lorko, un Bûcheron réputé qui n''a pas hésité à défier le célèbre Bûcheron Brouce Boulgoure, lors d''un fameux duel de déracinage d''Orme à mains nues dans la clairière de Liroye Merline.');
INSERT INTO "item_descriptions" VALUES(709,'es','Este sombrero pertenecía a Lorko, un reputado leñador que no dudó en desafiar al célebre leñador Brus Bulguro durante un famoso duelo de arrancamiento de olmos con las manos en un claro de Liroye Merlín.');
INSERT INTO "item_descriptions" VALUES(709,'pt','Este chapéu pertencia a Lorko, um lenhador. Ele desafiou o famoso Bruce Bulgur para lutar com ele em um duelo de levantamento de raiz de Olmo na clareira de Lerroá Merlin.');
INSERT INTO "item_descriptions" VALUES(709,'de','Dieser Hut gehörte Lorko, einem berühmten Holzfäller. Ohne zu zögern hat er den berühmten Holzfäller Bruce Bulgour zu einem aufsehenerregenden Duell herausgefordert, in dessen Verlauf mehrere Ulmen auf der Lichtung von Liroye Merlin mit bloßen Händen gerodet wurden.');
INSERT INTO "item_descriptions" VALUES(710,'en','The Korko Klako is a beautifo hato worno by the mo handso Sadido.');
INSERT INTO "item_descriptions" VALUES(710,'fr','Lo Korko Klako ost ouno chapo kilo bo. Tros ostotiko, tros bolo, il so porto par los plus bo dos Sadida.');
INSERT INTO "item_descriptions" VALUES(710,'es','Ol Korko Klako os un sombroro moy bonoto. Moy ostótico, moy hormoso, solo poro los mos guopos do los sadidas.');
INSERT INTO "item_descriptions" VALUES(710,'pt','O Korko Klako é um chapéu maravilhoso que foi usado por muitos Sadidas.');
INSERT INTO "item_descriptions" VALUES(710,'de','Do Korko Klako is o Huto und o sehr bo. So genioso, so tollo, so praktiko, doso och die bosten oller Sadidos do Korko Klako ofsetzoen wolln.');
INSERT INTO "item_descriptions" VALUES(711,'en','This magnificent leather mask once belonged to Jouik Krampe, cousin of Zeurg. They were both fond of tight leather clothes. A bit like Captain Chafer, only not as depraved.');
INSERT INTO "item_descriptions" VALUES(711,'fr','Ce magnifique masque en cuir appartenait à Jouik Krampe, cousin de Zeurg. Tous deux étaient très portés sur les vêtements en cuir moulant. Un peu comme le Captain Chafer, la perversité en moins.');
INSERT INTO "item_descriptions" VALUES(711,'es','Esta magnífica máscara de cuero pertenecía a Juik Kramp, primo de Zeurg. Los dos eran muy aficionados a las prendas de cuero pegadas al cuerpo. Igual que Capitán Chafer, pero sin ser unos pervertidos.');
INSERT INTO "item_descriptions" VALUES(711,'pt','Esta magnífica máscara de couro pertenceu a Jouik Krampe, primo de Zorgue. Eles gostavam de roupas de couro bem apertadas. Assim como o Capitão Chafer, mas não tão pervertido.');
INSERT INTO "item_descriptions" VALUES(711,'de','Diese hübsche Ledermaske gehörte einst Jouik Krampe, dem Cousin von Zeurks. Beide pflegten stets in hautenger Lederkleidung herumzulaufen. In etwa so wie der Chafer-Offizier, nur ein kleines bisschen weniger pervers.');
INSERT INTO "item_descriptions" VALUES(712,'en','This hat is so original that you will soon think you''re fantastic, unique and on top of the World. It is said that in bygone days, Rakmar Bilgout used it to charm the queen of the Gobballs. He didn''t hesitate to cut her throat open afterwards... Nothing to do with the hat I hope.');
INSERT INTO "item_descriptions" VALUES(712,'fr','Ce chapeau confectionné à partir d''oreilles cousues entre elles, vous rendra tout simplement unique tant il est original. On raconte qu''il a jadis permis à Rakmar Bilgout de séduire la reine des Bouftous, pour ensuite l''égorger plus facilement.');
INSERT INTO "item_descriptions" VALUES(712,'es','Este sombrero ha sido creado a partir de orejas cosidas entre ellas, hará sencillamente de ti una persona única de lo original que es. Se dice que antiguamente permitió a Rakma Bilgut seducir a la reina de los jalatós, para luego degollarla más fácilmente.');
INSERT INTO "item_descriptions" VALUES(712,'pt','Este chapéu é tão original que você pensará ser único. Dizem que antigamente Rakmar Bilgout o usava para seduzir a rainha dos Papatudo. Depois disso, ele não tinha qualquer dificuldade em cortar a garganta dela.');
INSERT INTO "item_descriptions" VALUES(712,'de','Dieser Hut aus zusammengenähten Ohren ist so originell, dass ihr damit nur einzigartig aussehen könnt. Man erzählt, dass ihn einst Rakmar Bilgout getragen haben soll, um die Königin der Fresssäcke damit zu verführen. Sobald er sein Ziel erreicht hatte, soll er ihr die Kehle durchgeschnitten haben.');
INSERT INTO "item_descriptions" VALUES(732,'en','This magnificent wedding ring was stolen from Silimelle, a female brewer, during a boozy meal at the inn. See what happens when you accept drinks from strangers?');
INSERT INTO "item_descriptions" VALUES(732,'fr','Cette magnifique alliance a été volée à Silimelle la Brasseuse de Bière, lors d''une soirée un peu trop arrosée à la taverne. Voilà ce qui arrive lorsque l''on paie des coups à des inconnus...');
INSERT INTO "item_descriptions" VALUES(732,'es','Esta magnífica alianza fue robada a Silimella, la Cervecera, durante una noche demasiado alcoholizada en la taberna. Esto es lo que ocurre cuando se pagan rondas a desconocidos...');
INSERT INTO "item_descriptions" VALUES(732,'pt','Este maravilhoso anel de casamento foi roubado de Silimelle, a Fermentadora de Cerveja, durante uma refeição regada na Pousada. Pode acontecer com qualquer um que compre bebidas estranhas...');
INSERT INTO "item_descriptions" VALUES(732,'de','Dieser wunderschöne Ehering wurde der Bierbrauerin Silimelle während eines feucht-fröhlichen Gelages in der Taverne gestohlen. Das kommt davon, wenn man sich Unbekannten gegenüber spendabel zeigt...');
INSERT INTO "item_descriptions" VALUES(733,'en','Without any doubt, Ragalde was one of the most foolhardy Iop warriors. With these magic boots, he slew a great number of enemies.');
INSERT INTO "item_descriptions" VALUES(733,'fr','Ragalde était sûrement un des Guerriers Iop les plus téméraires, ces bottes magiques lui ont permis d''occire bon nombre d''indésirables.');
INSERT INTO "item_descriptions" VALUES(733,'es','Ragalde fue sin duda uno de los guerreros yopuka más atrevidos, estas botas mágicas le permitieron cargarse a una cantidad impresionante de alimaña.');
INSERT INTO "item_descriptions" VALUES(733,'pt','Sem sombra de dúvida, Ragalde foi o mais apressado dos guerreiros Iop. Com estas botas mágicas, ele matava um grande número de inimigos.');
INSERT INTO "item_descriptions" VALUES(733,'de','Ragalde gehörte mit zu den tollkühnsten Iops, falls man bei Iops diesen Begriff überhaupt benutzen kann. Mit diesen Stiefeln hat er eine große Anzahl von Kreaturen aller Art niedergestreckt, die sich bei ihm unbeliebt gemacht hatten.');
INSERT INTO "item_descriptions" VALUES(734,'en','This belt is the weapon of choice for crowd control in Amakna prison and at the annual town fair.');
INSERT INTO "item_descriptions" VALUES(734,'fr','Cette ceinture permettait aux gardes du Château d''Amakna de contenir les émeutes et autres débordements lors des fêtes populaires.');
INSERT INTO "item_descriptions" VALUES(734,'es','Los guardias del Castillo de Amakna utilizaban este cinturón para contener los disturbios y demás excesos de entusiasmo durante las fiestas populares.');
INSERT INTO "item_descriptions" VALUES(734,'pt','Com este cinto, os guardas do Castelo Amakna podem conter tumultos e impedir que as coisas saiam do controle durante celebrações populares.');
INSERT INTO "item_descriptions" VALUES(734,'de','Dieser Gürtel erlaubt es, den Wächtern des Schlosses von Amakna alle Unruhestifter bei Unruhen oder Volksfesten direkt in Gewahrsam zu nehmen. Wie praktisch, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(737,'en','Greener than a sick Tofu, the Emerald Dofus was created by Aerafal, the Air Dragon. To have created such a green thing, he must certainly have been feeling airsick. That bodes well for its powers, doesn''t it?');
INSERT INTO "item_descriptions" VALUES(737,'fr','Plus vert qu''un Tofu malade, le Dofus Émeraude fut créé par Aerafal, le Dragon de l''Air. Pour créer quelque chose d''aussi vert, il devait avoir le mal de l''air. Un comble, non ?');
INSERT INTO "item_descriptions" VALUES(737,'es','El dofus Esmeralda es más verde que un tofu enfermo y fue creado por Aerafal, el dragón del aire. Seguro que este dragón se mareaba volando... Un colmo, ¿no te parece?');
INSERT INTO "item_descriptions" VALUES(737,'pt','Mais verde que um Tofu doente, o Dofus Esmeralda foi criado por Aerafal, o Dragão do Ar. Para criar algo tão verde, ele devia sofrer de enjoos quando voava. É o cúmulo, não?');
INSERT INTO "item_descriptions" VALUES(737,'de','Dieser Smaragd-Dofus ist noch grüner als ein kranker Tofu. Das Ei wurde von Aerafal, dem Luftdrachen gelegt. Doch damit es so grün wurde, muss dieser ganz schön luftkrank gewesen sein ... Der Gipfel der Seltsamkeit, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(739,'en','The Turquoise Dofus was created by Aguabrial, the Water Dragon. Isn''t it incredible what a Dragon can do with some water?');
INSERT INTO "item_descriptions" VALUES(739,'fr','Le Dofus Turquoise fut créé par Aguabrial, le Dragon de l''Eau. Quand on y pense, c''est fou ce qu''un Dragon peut faire avec de l''eau...');
INSERT INTO "item_descriptions" VALUES(739,'es','El dofus Turquesa fue creado por Aguabrial, el dragón del agua. Cuando uno se para a pensar, es increíble lo que puede hacer un dragón con el agua...');
INSERT INTO "item_descriptions" VALUES(739,'pt','O Dofus Turquesa foi criado por Aguabrial, o Dragão da Água. É incrível o que um Dragão pode fazer com a água...');
INSERT INTO "item_descriptions" VALUES(739,'de','Dieser Dofus wurde von Aguabrial, dem Wasserdrachen gelegt. Wahnsinn, was ein Drache mit Wasser alles anstellen kann...');
INSERT INTO "item_descriptions" VALUES(742,'en','"I am the eggman, I am the Dofus. Waka fu ku." The last words recorded by the renowned axe smith-cum-minstrel, Jon Lemon. Soon after, he was crushed by a giant Tofu egg.');
INSERT INTO "item_descriptions" VALUES(742,'fr','"Ce bâton a dû faire, toutes les guerres, pour être aussi fort aujourd''hui" tels ont été les derniers mots de Francisque Kabroule, le célèbre Ménestrel Forgeur de Haches, avant de périr écrasé par un œuf de Tofu géant.');
INSERT INTO "item_descriptions" VALUES(742,'es','«Si tengo que morir, que sea debajo de ti» cantaba el célebre trovador Badiz Mustabante antes de ser aplastado por un huevo de tofu gigante. Ya iba siendo hora...');
INSERT INTO "item_descriptions" VALUES(742,'pt','"A lalaôôôô..... Estava atravessanto o deserto do Saara, veio um Tofu e sentou na minha cara"... Esse foi o último sucesso do famoso músico Jon Lemon antes do seu acidente com o Tofu.');
INSERT INTO "item_descriptions" VALUES(742,'de','"Alles wird vorübergehen... Es wird alles mal vorübergehen", schrien voller Angst "Die Rot Behosten", eine berühmt-berüchtigte Gruppe fahrender, mit dem gehörnten Stecken bewaffneter Sänger. Damit versuchten sie sich Mut zu machen, bevor sie vom gigantischen Ei eines Riesentofus zermalmt wurden.');
INSERT INTO "item_descriptions" VALUES(744,'en','This cloak is an often underestimated one-of-a-kind. It is made of Green Larva Skin, giving it a most pleasant, rugged appearance.');
INSERT INTO "item_descriptions" VALUES(744,'fr','Cette cape est comme son porteur, unique en son genre et trop souvent sous-estimée.
Elle est constituée d''un assemblage de peaux de larves vertes, ce qui lui donne un aspect rugueux des plus sympathique.');
INSERT INTO "item_descriptions" VALUES(744,'es','Esta capa es, como su portador, única y demasiado a menudo subestimada. Está hecha con un ensamblaje de pieles de larvas verdes lo cual le da un aspecto rugoso simpatiquísimo.');
INSERT INTO "item_descriptions" VALUES(744,'pt','Como seu portador, este manto é único e é freqüentemente subestimado. Ele é feito de peles de larvas verdes, o que lhe dá o mais agradável aspecto áspero.');
INSERT INTO "item_descriptions" VALUES(744,'de','Dieser Umhang verhält sich wie sein Träger: er ist absolut einzigartig und wird häufig völlig unterschätzt. 
Er besteht aus vielen zusammengenähten Häuten grüner Larven, was ihm einen pelzigen Eindruck verleiht, der den Umhang so richtig sympathisch macht.');
INSERT INTO "item_descriptions" VALUES(754,'en','Marinated in pure blood for many long years, this cloak has acquired a ruby red colour that is very pleasing to the eye. This cloak is much favoured during the Al Howin''s Day celebrations.');
INSERT INTO "item_descriptions" VALUES(754,'fr','Cette cape rouge sang a baigné dans le sang pendant des années. Ce type de cape est très prisée lors des Fêtes Dalouhines.');
INSERT INTO "item_descriptions" VALUES(754,'es','Esta capa de color rojo sangre estuvo metida en un baño de hemoglobina durante años. ¡Todos quieren una para las fiestas de Haluín!');
INSERT INTO "item_descriptions" VALUES(754,'pt','Esta capa é tão vermelha quanto o sangue que foi chupado durante anos. Esse tipo de capa é muito apreciado durante as celebrações de Dalouhine.');
INSERT INTO "item_descriptions" VALUES(754,'de','Dieser blutrote Umhang wurde jahrelang in Blut getaucht. Darum ist er auch so begehrt im Rahmen des HelloTeeny - Festes.');
INSERT INTO "item_descriptions" VALUES(758,'en','This cloak can only be worn by the great dispensers of justice... It''s not very popular.');
INSERT INTO "item_descriptions" VALUES(758,'fr','Cette cape ne peut être portée que par les grands justiciers d''Amakna, c''est à dire presque personne.');
INSERT INTO "item_descriptions" VALUES(758,'es','Solamente los grandes justicieros de Amakna pueden ponérsela... o sea casi nadie.');
INSERT INTO "item_descriptions" VALUES(758,'pt','Este manto só pode ser usado pelos grandes justiceiros... Você também poderia dizer que quase ninguém o veste.');
INSERT INTO "item_descriptions" VALUES(758,'de','Dieser Umhang kann nur von wirklich reinen Wesen getragen werden, die sich der Wahrheit und Gerechtigkeit verschworen haben und zu den Rächern Amaknas wurden. Also so gut wie von niemandem...');
INSERT INTO "item_descriptions" VALUES(759,'en','This magnificent cloak was made with the feathers of the very last Cheeken of Amakna. It''s a real rarity that collectors dream of hanging on their living room wall.');
INSERT INTO "item_descriptions" VALUES(759,'fr','Cette magnifique cape a été confectionnée avec les plumes du dernier Poolay d''Amakna. Véritable rareté, les collectionneurs rêvent de l''avoir dans leur collection.');
INSERT INTO "item_descriptions" VALUES(759,'es','Esta magnífica capa ha sido confeccionada con las plumas del último pohoyo de Amakna. Son escasísimas y los coleccionistas sueñan con tener una en su colección.');
INSERT INTO "item_descriptions" VALUES(759,'pt','Este magnífico manto foi feito com as penas do último Frengo de Amakna. É uma verdadeira raridade que coletores sonham em adicionar a sua coleção.');
INSERT INTO "item_descriptions" VALUES(759,'de','Dieser fein gearbeitete Umhang wurde aus den Federn des letzten Heenchens von Amakna gefertigt. Eine echte Seltenheit also, die von vielen Sammlern heiß begeht wird.');
INSERT INTO "item_descriptions" VALUES(764,'en','This small amulet will delight inexperienced adventurers.');
INSERT INTO "item_descriptions" VALUES(764,'fr','Cette petite amulette ravira les héros débutants.');
INSERT INTO "item_descriptions" VALUES(764,'es','Este pequeño amuleto encantará a los héroes novatos.');
INSERT INTO "item_descriptions" VALUES(764,'pt','Este pequeno amuleto alegrará os iniciantes.');
INSERT INTO "item_descriptions" VALUES(764,'de','Dieses kleine Amulett wird alle Möchtegernabenteurer glücklich machen.');
INSERT INTO "item_descriptions" VALUES(765,'en','This scythe once belonged to Farle Ingalsse himself. It is sharp enough to mow any kind of cereal and any kind of monsters hidden in cereal fields.');
INSERT INTO "item_descriptions" VALUES(765,'fr','Cette Faux a appartenu à Farle Ingalsse en personne, elle est suffisamment aiguisée pour faucher tous les types de céréales et tous les types de monstres qui se cachent dans les champs de céréales.');
INSERT INTO "item_descriptions" VALUES(765,'es','Esta guadaña perteneció a Farle Ingals en persona, está suficientemente afilada para segar cualquier tipo de cereal y todo tipo de monstruos que se esconden en los campos de cereales.');
INSERT INTO "item_descriptions" VALUES(765,'pt','Esta foice pertenceu ao Farle Ingalsse em pessoa, é afiada o suficiente para ceifar qualquer tipo de cereal e qualquer tipo de monstro escondido nos campos de cereais.');
INSERT INTO "item_descriptions" VALUES(765,'de','Diese Sense hat Farle Ingalsse höchstpersönlich benutzt. Ursprünglich für das Mähen jeglicher Art von Getreide konzipiert, kann man mit ihr gleichzeitig alle Arten von Monstern ummähen, die sich in den Getreidefeldern versteckt halten.');
INSERT INTO "item_descriptions" VALUES(766,'en','This amulet increases the damage of inexperienced adventurers.');
INSERT INTO "item_descriptions" VALUES(766,'fr','Cette amulette permet d''occasionner plus de dégâts pour les aventuriers qui débutent.');
INSERT INTO "item_descriptions" VALUES(766,'es','Este amuleto convierte la vitalidad en potencia y permite ocasionar más daños.');
INSERT INTO "item_descriptions" VALUES(766,'pt','Este amuleto permite que você cause mais danos se for um aventureiro iniciante.');
INSERT INTO "item_descriptions" VALUES(766,'de','Dieses Amulett verwandelt die Lebenskraft seines Trägers in Schlagkraft und erhöht so den angerichteten Schaden.');
INSERT INTO "item_descriptions" VALUES(767,'en','Don''t mind its stuck-up name, this ring can only make your hero stronger. Okay, his chin will shrink too, but hey, who cares!');
INSERT INTO "item_descriptions" VALUES(767,'fr','Malgré un nom pompeux, cet anneau rend juste un peu plus fort, et un peu plus bête.');
INSERT INTO "item_descriptions" VALUES(767,'es','A pesar de su nombre pomposo, este anillo solo te vuelve más fuerte y un poco más estúpido.');
INSERT INTO "item_descriptions" VALUES(767,'pt','Não acredite em seu nome pomposo, este anel só torna seu herói um pouco mais forte, e tolo.');
INSERT INTO "item_descriptions" VALUES(767,'de','Trotz dieses pompösen Namens macht einen dieser Ring bloß ein wenig stärker und ein wenig dümmer.');
INSERT INTO "item_descriptions" VALUES(768,'en','This ring influences your fate. You''ll be tougher but less lucky. In other words, you improve your chances of living a long time and ruin your chances of living happily.');
INSERT INTO "item_descriptions" VALUES(768,'fr','Cet anneau influe sur le cours de votre destinée, il vous rend plus résistant, mais moins chanceux. Vous augmentez vos chances de vivre longtemps en diminuant vos chances de vivre heureux.');
INSERT INTO "item_descriptions" VALUES(768,'es','Este anillo influye sobre el curso de tu destino, te vuelve más resistente, pero menos afortunado. Aumentarás tus posibilidades de vivir más tiempo a la vez que disminuyes tus posibilidades de vivir feliz.');
INSERT INTO "item_descriptions" VALUES(768,'pt','Este anel influencia o seu destino; você fica mais resistente, mas menos sortudo. Em outras palavras, você aumenta as suas chances de viver muito tempo e diminui as chances de viver feliz.');
INSERT INTO "item_descriptions" VALUES(768,'de','Dieser Ring beeinflußt stark euer Schicksal. Er macht euch widerstandsfähiger, bringt euch aber ebenfalls Unglück. Im Klartext: er erhöht eure Chancen, länger zu leben, verringert jedoch gleichzeitig eure die Chancen, glücklich zu sein.');
INSERT INTO "item_descriptions" VALUES(769,'en','These boots bring good fortune. Unfortunately, they decrease your resistance.');
INSERT INTO "item_descriptions" VALUES(769,'fr','Les bottes qui portent chance. Le problème c''est qu''elles vous rendent moins résistant en combat.');
INSERT INTO "item_descriptions" VALUES(769,'es','Estas botas traen suerte. El problema es que te vuelven menos resistente en combate.');
INSERT INTO "item_descriptions" VALUES(769,'pt','Botas que trazem sorte. Infelizmente, elas diminuem sua resistência em lutas.');
INSERT INTO "item_descriptions" VALUES(769,'de','Diese Stiefel bringen Glück. Dummerweise senken sie auch eure Fähigkeit, Schläge im Kampf einzustecken.');
INSERT INTO "item_descriptions" VALUES(770,'en','This magnificent pair of boots will make you more agile, but they won''t help you think.');
INSERT INTO "item_descriptions" VALUES(770,'fr','Cette magnifique paire de bottes vous rendra plus agile, mais ne vous aidera pas à réfléchir.');
INSERT INTO "item_descriptions" VALUES(770,'es','Este magnífico par de botas te volverá más ágil. pero no te ayudará a pensar.');
INSERT INTO "item_descriptions" VALUES(770,'pt','Este magnífico par de botas deixa você mais ágil, mas não ajuda a pensar.');
INSERT INTO "item_descriptions" VALUES(770,'de','Dieses wunderschöne Paar Stiefel macht euch geschickter, aber beim Nachdenken hilft es euch nichts.');
INSERT INTO "item_descriptions" VALUES(772,'en','According to what people say, this legendary cloak makes you almost invisible when combined with the fencers'' legendary sword, the Dart Onion, and to the legendary hat of the Six Rams of the Rahk Shepherds.');
INSERT INTO "item_descriptions" VALUES(772,'fr','On prétend que cette cape légendaire permet de devenir presque invincible si on la combine à l''épée légendaire des escrimeurs, le Dard Tagnan et au chapeau légendaire des Six Rameaux de Bergers Rahks.');
INSERT INTO "item_descriptions" VALUES(772,'es','Cuentan que esta legendaria capa permite volverse casi invencible si se combina con la espada legendaria de los esgrimidores, el Dar Takán y el sombrero legendario de Kurro Minéjez.');
INSERT INTO "item_descriptions" VALUES(772,'pt','De acordo com o que as pessoas dizem, este lendário manto faz você se tornar quase invisível se você combiná-lo à lendária espada dos esgrimistas, a Dard Tagnan, e ao lendário chapéu dos Seis Rameaux de Bergers Rahks.');
INSERT INTO "item_descriptions" VALUES(772,'de','Mit diesem legendären Mantel wird man so gut wie unbesiegbar, wenn man ihn mit der legendärsten Waffe aller Fechtmeister, dem Dart Tagnan des Muskeltieres, und der berühmten Baronen-Kugel des Mönches von Hausen kombiniert.');
INSERT INTO "item_descriptions" VALUES(773,'en','This light cloak comes from the Patitalian Country, a place where people communicate with their limbs. This explains the incredible lightness and complete freedom of movement given by the cloak.');
INSERT INTO "item_descriptions" VALUES(773,'fr','Cette cape vient du pays des Patitaliennes, un endroit où l''on parle avec les mains. Cela explique la grande liberté de mouvement laissée par celle-ci. Elle est en outre d''une légèreté surprenante.');
INSERT INTO "item_descriptions" VALUES(773,'es','Esta capa viene del país de las Pastasitaliani, un lugar donde se habla con las manos. Lo cual explica la gran libertad de movimiento que esta procura. Además es muy ligera.');
INSERT INTO "item_descriptions" VALUES(773,'pt','Este leve manto vem do País de Patitalianos, um lugar onde as pessoas conversam com suas mãos. Isto explica a total liberdade de movimento dada pelo manto. Além disso, é surpreendentemente leve.');
INSERT INTO "item_descriptions" VALUES(773,'de','Dieser Umhang kommt aus dem fernen Land Pastatalieni, einem seltsamen Ort, wo man mit den Händen spricht. Das erklärt auch zu einem Großteil, warum er einem soviel Bewegungsfreiheit erlaubt. Zudem ist er auch noch überraschend leicht.');
INSERT INTO "item_descriptions" VALUES(774,'en','Coming from the Mount Taigue, this cape ended up poisoning its former female owner... Strangely enough, if you wear it, it will increase your resistance.');
INSERT INTO "item_descriptions" VALUES(774,'fr','Venant du Mont Taigüe ou du monde Aigüe selon la manière dont vous le prononcez, cette cape a conduit à l''empoisonnement de son ancienne propriétaire, mais bizarrement elle augmente la résistance de son porteur.');
INSERT INTO "item_descriptions" VALUES(774,'es','Viene del monte Eide y cosa extraña, condujo al envenenamiento de su anterior propietaria aunque hoy en día aumente la resistencia del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(774,'pt','Vinda do Monte Taigüe, esta capa acabou envenenando sua ex-proprietária... Mas ela aumenta, estranhamente, a resistência do seu portador.');
INSERT INTO "item_descriptions" VALUES(774,'de','Dieser vom Mont Agues stammende Mantel führte letztendlich dazu, dass der frühere Besitzer vergiftet wurde und verstarb. Dabei soll der Mantel doch eigentlich die Lebenskraft seines Trägers stärken. Seltsam.');
INSERT INTO "item_descriptions" VALUES(775,'en','This cape has been made with infinite care and attention, it allows the wearer to find the enemy''s weak point.');
INSERT INTO "item_descriptions" VALUES(775,'fr','Tissée magiquement avec un soin infini, la Cape Abilité permet à son porteur de discerner les points faibles de ses adversaires pour leur porter des coups destructeurs.');
INSERT INTO "item_descriptions" VALUES(775,'es','Ha sido tejida con magia e infinito cuidado. La Capa Bilidad permite que su portador encuentre los puntos débiles de sus adversarios para poder alcanzarles y causarles daños destructores.');
INSERT INTO "item_descriptions" VALUES(775,'pt','Este é um manto feito com atenção e cuidado infinitos, que permite ao seu portador encontrar os pontos fracos de seus inimigos.');
INSERT INTO "item_descriptions" VALUES(775,'de','Dieser auf magische Art und Weise mit großer Sorgfalt gewobene Mantel gibt dem Träger die Fähigkeit, selbst die kleinsten Schwachstellen des Gegners aufzudecken und seine zerstörerischen Schläge genau dorthin zu plazieren.');
INSERT INTO "item_descriptions" VALUES(776,'en','A certain Mulba used this item to carry half her kitchen with her on a long, difficult quest to find the Seven Crystal Hens which fell from the stars. This cloak will make you strong and brave.');
INSERT INTO "item_descriptions" VALUES(776,'fr','Ayant appartenu à une certaine Mulba, qui s''en servait pour transporter des objets encombrants dans sa quête des Sept Poules de Cristal venues des étoiles, cette cape augmente considérablement la force.');
INSERT INTO "item_descriptions" VALUES(776,'es','Ha pertenecido a una tal Mulba que la utilizaba para transportar objetos que le estorbaban en su búsqueda de Siete Ollas de Cristal que se cayeron de unas estrellas, esta capa aumenta la fuerza de forma considerable.');
INSERT INTO "item_descriptions" VALUES(776,'pt','Uma certa Mulba a usou para transportar itens incômodos, durante a sua missão para achar as Sete Galinhas de Cristal que caíram das estrelas. Este manto aumenta consideravelmente a força.');
INSERT INTO "item_descriptions" VALUES(776,'de','Dieser Umhang gehörte einst einer gewissen Mulba, die damit beschwerliche Gegenstände transportierte, die im Rahmen ihrer Suche nach den Sieben Kristalldoubeln überirdischen Ursprunges anfielen. Man sagt außerdem, dass dieser Umhang auch erheblich die Stärke seines Trägers erhöhen soll.');
INSERT INTO "item_descriptions" VALUES(777,'en','The battery cock whose feathers made this cape fought its killers for several days and nights before finally dying of exhaustion. Let me tell you, killing that crazy chicken nearly finished them off too.');
INSERT INTO "item_descriptions" VALUES(777,'fr','Le Coq ayant donné ses plumes pour la confection de cette cape s''est débattu pendant plusieurs jours et plusieurs nuits avant de finalement tomber à bout de force et de se laisser déplumer. "Hû !" s''exclama son propriétaire, lui aussi à bout de souffle.');
INSERT INTO "item_descriptions" VALUES(777,'es','El gallo que «regaló» sus plumas para poder crear esta capa no fue fácil de atrapar, de hecho su granjero y legítimo propietario anduvo corriendo tras él varias horas sin resultado hasta que decidió armar una trampa con tres botones, un alambre y un viejo calzón gastado... Más vale maña que fuerza.');
INSERT INTO "item_descriptions" VALUES(777,'pt','Antes desta capa ser feita, o galo lutou vários dias e noites até que morreu de exaustão. Então, o dono o depenou, coletando as preciosas penas em um choro exaustivo, mas satisfeito.');
INSERT INTO "item_descriptions" VALUES(777,'de','Morgenappell auf der Hühnerfarm: "All'' inn'' Rei'' "! Da sich der alte Hahn auch nach 20 "Rei'' "-Rufen nicht blicken ließ, sollte er gerupft werden. Doch er entging der Strafe, da er nach 3 Tagen Hetzjagd tot umfiel. "...Rei'' "schrie der Besitzer.');
INSERT INTO "item_descriptions" VALUES(778,'en','This authentic bad guy cloak proves you belong to the gang of the diabolic Mori Arty. It is said that his bad luck equalled his astounding intelligence. Only true bad guys can wear it.');
INSERT INTO "item_descriptions" VALUES(778,'fr','Cette authentique cape de méchant est une preuve de votre appartenance à la bande du diaboliquement génial Mori Arty, dont on raconte que seule sa malchance égalait sa stupéfiante intelligence. Ne peut être portée que par les plus grands méchants.');
INSERT INTO "item_descriptions" VALUES(778,'es','Esta auténtica capa de malo demuestra que perteneces a la pandilla del diabólicamente genial Mori Arty del cual se dice que era tan desafortunado como inteligente. Solamente los más malos pueden ponérsela.');
INSERT INTO "item_descriptions" VALUES(778,'pt','Este autêntico manto maligno é uma prova que você pertence à diabólica quadrilha do Mori Arty. Dizem que a má sorte dele se igualou à sua espantosa inteligência. Apenas verdadeiros sujeitos maus podem usá-lo.');
INSERT INTO "item_descriptions" VALUES(778,'de','Dieser echte Mantel des Grauens ist das Beweisstück für eure Angehörigkeit zu der Bande des diabolischen und genialen Professors M. Man sagt, allein sein ständiges Pech wäre seiner unglaublichen Intelligenz ebenbürtig. Dieser Mantel kann nur von den bösesten aller Bösewichte getragen werden.');
INSERT INTO "item_descriptions" VALUES(779,'en','This cloak looks ordinary... but isn''t. It can make its wearer invisible to the eyes of those who are not looking at him. Really impressive!');
INSERT INTO "item_descriptions" VALUES(779,'fr','Cette cape d''apparence quelconque n''est en fait pas tout à fait quelconque. Elle rendrait invisible son porteur aux yeux de ceux qui ne le regardent pas. Impressionnant !');
INSERT INTO "item_descriptions" VALUES(779,'es','Aunque parezca normal y corriente, esta capa no es una cualquiera. Dicen que el que la lleve puesta se volverá invisible y que nadie podrá verlo si no miran para él. ¡Impresionante!');
INSERT INTO "item_descriptions" VALUES(779,'pt','Este manto de aparência qualquer, não é ordinário. Ele pode tornar o usuário invisível aos olhos de quem não estiver olhando para ele. Realmente impressionante!');
INSERT INTO "item_descriptions" VALUES(779,'de','Dieser gewöhnlich erscheinende Mantel ist keineswegs gewöhnlich. Denn er kann seinen Träger vor den Augen all derer verstecken, die ihn gerade nicht ansehen. Wahrlich beeindruckend!');
INSERT INTO "item_descriptions" VALUES(781,'en','This superb cloak once belonged to the Great Stratequerre. This renowned and expert strategist lord of war, hungry for the universe conquest, soon gave up his plans after having arrayed himself in the cloak. Really strange!');
INSERT INTO "item_descriptions" VALUES(781,'fr','Cette superbe cape a appartenu au Grand Stratéquerre. Ce célèbre seigneur de guerre et fin stratège, avide de conquête de l''univers, a bien vite abandonné tous ses projets après avoir revêtu cette cape. Étrange !');
INSERT INTO "item_descriptions" VALUES(781,'es','Esta magnífica capa perteneció al gran estratega Estrateguerra que creaba pesados artefactos de guerra para con ellos poder dominar el universo... Al ponerse esta capa abandonó todos sus maquiavélicos proyectos, qué extraño...');
INSERT INTO "item_descriptions" VALUES(781,'pt','Este belo manto uma vez pertenceu ao Grande Stratequerre. Este famoso e experiente estrategista de guerra, faminto por conquistas universais, desistiu de seus planos após vestir seu manto. Muito estranho!');
INSERT INTO "item_descriptions" VALUES(781,'de','Dieser wunderschöne Umhang wurde speziell für den großen Strategen General Itou Lascione angefertigt. Doch kaum zog er seinen Umhang an, schon gab er seine Pläne zur Beherrschung des Universums auf und begann seine neue Laufbahn als Gärtner. Seltsam, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(782,'en','This very special axe was originally designed to teach budding lumberjacks the art of chopping. When it is well used, it can split a young carefree Treechnid in two, provided that such a Treechnid exists.');
INSERT INTO "item_descriptions" VALUES(782,'fr','Cette hache est assez particulière, elle est à la base destinée à l''apprentissage du métier de Bûcheron. Correctement utilisée, elle peut sectionner en deux un jeune Abraknyde trop insouciant, ce qui avouons-le, est très rare.');
INSERT INTO "item_descriptions" VALUES(782,'es','Esta hacha es bastante particular, en un principio se usaba para el aprendizaje del oficio de leñador. Si se utiliza correctamente, puede partir en dos un joven abráknido demasiado temerario, aunque haya que confesarlo, ese caso se da muy raras veces.');
INSERT INTO "item_descriptions" VALUES(782,'pt','Este machado é muito especial e era originalmente designado para o treinamento da profissão de lenhador. Quando bem usado, pode dividir um jovem Arvraknídeo descuidado em dois, desde que tal Arvraknídeo exista...');
INSERT INTO "item_descriptions" VALUES(782,'de','Diese Axt ist recht außergewöhnlich. Sie diente zwar ursprünglich dazu, jungen Holzhackern das Handwerk beizubringen, doch wenn sie korrekt gehandhabt wird, kann sie sogar junge, unerfahrene Astaknyden in zwei Teile spalten. Das ist doch ziemlich bemerkenswert, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(783,'en','This amulet, made exclusively of precious wood, is highly prized and loved by lumberjacks who usually exaggerate its abilities to offset the cost of the material.');
INSERT INTO "item_descriptions" VALUES(783,'fr','Cette amulette, exclusivement fabriquée à partir de bois précieux, est très prisée des Bûcherons qui lui attribuent bien souvent des pouvoirs qu''elle n''a pas.');
INSERT INTO "item_descriptions" VALUES(783,'es','Este amuleto, exclusivamente hecho con madera preciosa, es muy rebuscado por los Leñadores. Pues a menudo  le atribuyen poderes que no tiene.');
INSERT INTO "item_descriptions" VALUES(783,'pt','Este amuleto, feito somente de madeira preciosa, é apreciado por lenhadores que, normalmente, exageram em suas habilidades para falar sobre os poderes que eles de fato não têm.');
INSERT INTO "item_descriptions" VALUES(783,'de','Dieses Amulett besteht einzig und allein aus seltenen Edelhölzern und wird besonders von Holzfällern sehr geschätzt. Diese messen ihm allerdings oftmals mehr Kräfte bei, als es in Wirklichkeit hat.');
INSERT INTO "item_descriptions" VALUES(784,'en','Mulish Cat was a renowned Ecaflip, and the most stupid in his class. In combat, the only match for his nonexistent intelligence was his bewildering luck.');
INSERT INTO "item_descriptions" VALUES(784,'fr','Le Chat Buté est le surnom donné à un célèbre Ecaflip. Aucun Ecaflip n''aura été plus têtu que lui, et en combat seule sa chance le sauvait de son inexistante intelligence. 
"Qui qu''c''est qu''y''est buté comme un caillou ?", s''exclamait-il souvent.');
INSERT INTO "item_descriptions" VALUES(784,'es','El Gato con Gotas era el apodo que se le había dado a un famoso zurcarák. Este era famoso por echarse unas gotitas de aguardiente en la leche del desayuno. Decía que eso era muy saludable y probablemente hubiera vivido muchos años si no se hubiera caído tontamente desde aquel puente... pues ese triste año, Amakna había sufrido los daños de la sequía, el Gato también.');
INSERT INTO "item_descriptions" VALUES(784,'pt','“Gato Teimoso” era o nome de um famoso discípulo de Ecaflip. Ele era o mais teimoso da sua classe e, durante as lutas, apenas a sorte dele podia salvá-lo de sua inexistente inteligência.');
INSERT INTO "item_descriptions" VALUES(784,'de','Der "geprügelte Kater" ist der Spitzname, der einem berühmten Ecaflip gegeben wurde. Kein anderer Ecaflip war dickköpfiger als er. Allein schieres Glück rettete ihm bei mehr als einem Kampf das Leben, welches er aufgrund eines bedenklichen Mangels an Intelligenz zu verlieren drohte.');
INSERT INTO "item_descriptions" VALUES(785,'en','The tradition of passing this ring down from grandfather to grandson gives it incredible power. This one is but a pale imitation of the original, but even so, it is much sought-after by collectors, whether they are Enutrof or not.');
INSERT INTO "item_descriptions" VALUES(785,'fr','Cet anneau, transmis de Grand père Enutrof en Père Enutrof, procure à son porteur une formidable force. Celui-ci n''en est qu''une pâle copie, mais il saura tout de même satisfaire les collectionneurs, qu''ils soient Enutrof ou non.');
INSERT INTO "item_descriptions" VALUES(785,'es','Este anillo, transmitido de Abuelo Anutrof a Padre Anutrof, ofrece a su dueño una fuerza increíble. Se trata aquí de una pálida imitación, saciará sin embargo el apetito de los coleccionistas, ya sean anutrof o no.');
INSERT INTO "item_descriptions" VALUES(785,'pt','É um anel que é passado de Avô para Pai na sociedade Enutrof e que dá ao portador uma incrível força. Este aqui é uma imitação pálida, mas mesmo assim pode satisfazer colecionadores, sejam eles Enutrofs ou não.');
INSERT INTO "item_descriptions" VALUES(785,'de','Dieser Ring, der über viele Generationen hinweg von Enutrof-Großväterchen zu Enutrof-Väterchen weitergegeben wurde, erhöht die Stärke seines Trägers beträchtlich. Dieses Examplar hier ist bloß eine billige Kopie des Originals, doch wird es den Sammler dennoch zufrieden stellen, egal ob Enutrof oder nicht.');
INSERT INTO "item_descriptions" VALUES(786,'en','The jeweller''s hand slipped while shaping this amulet, which imparts more intelligence to the wearer but in exchange, imparts a tear-inducing migraine, making it almost impossible to see anything.');
INSERT INTO "item_descriptions" VALUES(786,'fr','Née d''une erreur de manipulation d''un bijoutier, cette amulette augmente l''intelligence de son porteur. En revanche, elle donne généralement un puissant mal de crâne qui a pour effet d''amoindrir la condition physique de son propriétaire.');
INSERT INTO "item_descriptions" VALUES(786,'es','Fruto de un error de manipulación por parte de un joyero, este amuleto aumenta la inteligencia de su portador. En cambio, produce generalmente un fuerte dolor de cabeza, lo cual disminuye la condición física de su propietario.');
INSERT INTO "item_descriptions" VALUES(786,'pt','O joalheiro cometeu um engano quando criou este amuleto que transmite mais inteligência ao possuidor, porém, em troca, dá a ele/ela uma grave enxaqueca enfraquecendo sua condição física.');
INSERT INTO "item_descriptions" VALUES(786,'de','Dieser Anhänger, der durch Zufall bei einem falschen Handgriff des Juweliers entstanden ist, erhöht die Intelligenz seines Trägers. Allerdings verursacht er ebenfalls dröhnende Kopfschmerzen, die seine körperliche Verfassung verschlechtern.');
INSERT INTO "item_descriptions" VALUES(787,'en','This strange little ring can increase the Agility of the wearer in exchange for Chance points.');
INSERT INTO "item_descriptions" VALUES(787,'fr','Cet étrange petit anneau a la faculté d''augmenter l''agilité de son porteur, pourtant étrangement frappé d''un manque de chance.');
INSERT INTO "item_descriptions" VALUES(787,'es','Este extraño anillito tiene la facultad de aumentar la agilidad de su portador, sin embargo  disminuye la suerte de este.');
INSERT INTO "item_descriptions" VALUES(787,'pt','Este pequeno anel estranho pode aumentar a agilidade do seu portador em troca de pontos de sorte.');
INSERT INTO "item_descriptions" VALUES(787,'de','Dieser seltsame kleine Ring besitzt die Fähigkeit, die Flinkheit seines Trägers zu hören, doch scheint er auch gleichzeitig Unglück anzuziehen.');
INSERT INTO "item_descriptions" VALUES(789,'en','This belt is all the rage among young Amaknians. A follower of Sadida, couturier by trade, is behind this fashion. When he sold it for the first time, he said: "Life is short, play hard!"');
INSERT INTO "item_descriptions" VALUES(789,'fr','Cette ceinture fait fureur auprès de la jeune population d''Amakna. Un couturier Sadida en est à l''origine. Lors de sa première vente, il s''exclama : "La vie est courte, jouez durement !".');
INSERT INTO "item_descriptions" VALUES(789,'es','Este cinturón causó furor entre los jóvenes de Amakna. Fue un sastre sadida el que lo creó. Cuando hizo su primera venta se exclamó: «¡La vida es corta, jugad duramente!».');
INSERT INTO "item_descriptions" VALUES(789,'pt','Este cinto é a última moda entre os jovens de Amakna. Um costureiro - discípulo de Sadida - está por trás dessa moda. Quando ele vendeu o seu primeiro cinto, disse: “A vida é curta, jogue duro!”.');
INSERT INTO "item_descriptions" VALUES(789,'de','Dieser Gürtel ist besonders bei der Jugend von Amakna sehr beliebt. Das liegt am hervorragenden Werbespruches des Sadida-Schusters bei dessen Verkauf: "Das Leben ist so kurz, bleibt hart am Ball". Inwieweit dies inspirieren soll, ist allerdings fraglich.');
INSERT INTO "item_descriptions" VALUES(790,'en','The magic effects of this cape are often overestimated, which inevitably causes heavy losses in adventurers, such as the notorious minstrel Jon Lemon.');
INSERT INTO "item_descriptions" VALUES(790,'fr','Les effets magiques de cette cape sont souvent surestimés, ce qui a causé la perte de nombreux aventuriers, notamment, le tristement célèbre Ménestrel Francisque Kabroule.');
INSERT INTO "item_descriptions" VALUES(790,'es','Los efectos mágicos de esta capa son a menudo sobreestimados. Eso causó la pérdida de muchos aventureros, principalmente, la del tristemente famoso trovador Badiz Mustabante.');
INSERT INTO "item_descriptions" VALUES(790,'pt','Os efeitos mágicos desta capa são freqüentemente superestimados, o que, inevitavelmente, causou a perda de numerosos aventureiros, entre eles, o notório trovador Jony Lenon.');
INSERT INTO "item_descriptions" VALUES(790,'de','Die magische Kraft dieses Mantels wurde lange Zeit hinweg zu Unrecht überbewertet, was zum Verschwinden von so manch einem Abenteurer geführt hat, unter anderem auch des berühmt-berüchtigten Minnesänger O''Heins.');
INSERT INTO "item_descriptions" VALUES(791,'en','This is a staff made of living Treechnid Roots. But watch out... it has a tendency to turn on its master. When it does decide to attack the same target as you, it can be very deadly.');
INSERT INTO "item_descriptions" VALUES(791,'fr','C''est un Bâton en racines d''Abraknyde encore vivantes. Attention, ce dernier a une fâcheuse tendance à se retourner contre son maître. Il peut être très efficace lorsqu''il décide de s''attaquer à la même cible que celle de son maître.');
INSERT INTO "item_descriptions" VALUES(791,'es','Se trata de un bastón de raíces de abráknido todavía vivitas y coleando. Ten cuidado porque tiene cierta tendencia en volverse contra su amo. Puede ser muy eficaz cuando decide atacar al mismo blanco que el de su amo.');
INSERT INTO "item_descriptions" VALUES(791,'pt','Este é um cajado feito de raízes de Arvraknídeo, que ainda estão vivas. Mas tenha cuidado já que este cajado tem uma tendência a se rebelar contra seu mestre. Ele pode ser muito eficiente quando decide atacar o mesmo alvo que seu mestre.');
INSERT INTO "item_descriptions" VALUES(791,'de','Dieser Stab besteht aus lebendigen Astaknydenwurzeln. Vorsicht, diese haben die ärgerliche Angewohnheit, sich manchmal gegen ihren Träger zu wenden. Doch wenn sie sich mal dazu entscheiden, dasselbe Ziel wie der Träger anzugreifen, kann dieser Stecken sehr effektiv sein.');
INSERT INTO "item_descriptions" VALUES(819,'en','Holy Swords are awarded to young warriors during their training.');
INSERT INTO "item_descriptions" VALUES(819,'fr','Une épée sainte distribuée aux jeunes guerriers durant leur formation.');
INSERT INTO "item_descriptions" VALUES(819,'es','Esta es una espada santa que se entrega a los jóvenes guerreros durante su formación.');
INSERT INTO "item_descriptions" VALUES(819,'pt','Uma espada sagrada dada a guerreiros jovens durante o treinamento.');
INSERT INTO "item_descriptions" VALUES(819,'de','Dies ist ein heiliges Schwert, das jungen Kriegern im Laufe ihrer Ausbildung gegeben wird.');
INSERT INTO "item_descriptions" VALUES(822,'en','The Knight Sword is an efficient and sturdy sword. Properly used, it can inflict serious damage upon your enemies.');
INSERT INTO "item_descriptions" VALUES(822,'fr','L''épée du Chevalier est une épée solide et efficace, bien utilisée elle peut causer de gros dommages à vos ennemis.');
INSERT INTO "item_descriptions" VALUES(822,'es','La Espada del Caballero es una espada sólida y eficaz, si la usas de forma adecuada podrás causar enormes daños a tus adversarios.');
INSERT INTO "item_descriptions" VALUES(822,'pt','A espada do Cavaleiro é uma arma sólida e eficiente. Se for bem usada, causa sérios danos aos seus inimigos.');
INSERT INTO "item_descriptions" VALUES(822,'de','Das Schwert des Ritters ist stabil und wirksam. Darum fügt es euren Gegnern auch großen Schaden zu.');
INSERT INTO "item_descriptions" VALUES(825,'en','This basic sword can usually be handled by the most cretinous of Bworks, that is to say the ones who are incapable of using a bow or a staff... Some of these geniuses even mistake the blade for the handle. The tradition in this case is for the Bwork to poke its own eyes out with its fingers... Lovely!');
INSERT INTO "item_descriptions" VALUES(825,'fr','Cette épée d''apparence rudimentaire est très appréciée des Bworks les plus débiles, qui ne savent pas se servir d''un arc ou d''un bâton, certains confondent même la lame et le manche ce qui ne manque pas de faire rire leurs adversaires.');
INSERT INTO "item_descriptions" VALUES(825,'es','Esta espada aparentemente rudimentaria es muy apreciada por los bworks más estúpidos que no saben servirse de un arco o de un bastón, incluso algunos confunden el filo con el mango lo cual provoca la risa de sus adversarios.');
INSERT INTO "item_descriptions" VALUES(825,'pt','Esta espada de aparência rudimentar satisfaz os Bworks mais idiotas, ou seja, os que são incapazes de usar um arco ou um cajado... Alguns deles até confundem a lâmina com o punho. Os inimigos não conseguem deixar de dar boas risadas.');
INSERT INTO "item_descriptions" VALUES(825,'de','Diese grobe Klinge ist wegen ihrer Einfachheit sehr beliebt bei den Dümmsten aller Bworks, die noch nicht einmal die Funktionsweise eines Bogens oder eines Stockes verstehen. Trotzdem verwechseln einige von ihnen hin und wieder das Heft mit der Klinge, was meist starke Lachanfälle ihrer Gegner zur Folge hat.');
INSERT INTO "item_descriptions" VALUES(828,'en','This bow fires its arrows so rapidly that the whistling sound travels for miles. A sound piece of advice: if you want to be discreet, equip it with a silencer.');
INSERT INTO "item_descriptions" VALUES(828,'fr','Cet arc tire si rapidement ses flèches, que l''on entend ces dernières partir de très loin. Pensez donc à l''équiper d''un silencieux, si c''est la discrétion que vous recherchez.');
INSERT INTO "item_descriptions" VALUES(828,'es','Este arco dispara tan rápido sus flechas que se las oye desde muy lejos. Por lo cual piensa en equiparlo con un silenciador si necesitas ser discreto.');
INSERT INTO "item_descriptions" VALUES(828,'pt','Este arco atira suas flechas tão rapidamente que o barulho do assobio se alastra por uma grande distância. Em relação ao som, se quiser ser o mais discreto possível, equipe-o com um silenciador.');
INSERT INTO "item_descriptions" VALUES(828,'de','Dieser Bogen verschießt so schnelle Pfeile, dass man sie bereits von Weitem anfliegen hört. Denkt also immer daran, einen Schalldämpfer zu verwenden, wenn ihr unbemerkt bleiben möchtet.');
INSERT INTO "item_descriptions" VALUES(829,'en','Due to its restricted range, this bow is not very popular... Use it to weaken your enemies before finishing them off with a close-range weapon or a crafty spell.');
INSERT INTO "item_descriptions" VALUES(829,'fr','À cause de sa faible portée, cet arc n''est pas très efficace, mais il permet tout de même d''affaiblir suffisamment l''ennemi avant de l''achever avec une autre arme ou magie.');
INSERT INTO "item_descriptions" VALUES(829,'es','Por culpa de su escaso alcance, este arco no es muy eficaz aunque permita debilitar suficientemente al enemigo antes de rematarlo con otra arma o con la magia.');
INSERT INTO "item_descriptions" VALUES(829,'pt','Este arco não é muito eficiente, devido ao seu alcance limitado, mas você ainda pode debilitar o inimigo antes de matá-lo com outra arma ou feitiço.');
INSERT INTO "item_descriptions" VALUES(829,'de','Aufgrund der geringen Reichweite ist dieser Bogen nicht sehr wirkungsvoll. Dennoch kann man mit ihm die Gegner genügend schwächen, bevor man ihnen mit einer anderen Waffe oder mit Magie den Gnadenstoß verpasst.');
INSERT INTO "item_descriptions" VALUES(830,'en','This wand increases the bearer''s intelligence.');
INSERT INTO "item_descriptions" VALUES(830,'fr','Cette baguette permet à son porteur d''augmenter son intelligence.');
INSERT INTO "item_descriptions" VALUES(830,'es','Esta varita permite aumentar la inteligencia de quien la posea.');
INSERT INTO "item_descriptions" VALUES(830,'pt','Esta varinha aumenta a inteligência de seu portador.');
INSERT INTO "item_descriptions" VALUES(830,'de','Dieser Stab erhöht die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(833,'en','This wand increases the bearer''s Wisdom.');
INSERT INTO "item_descriptions" VALUES(833,'fr','Cette baguette permet à son porteur d''augmenter sa sagesse.');
INSERT INTO "item_descriptions" VALUES(833,'es','Esta varita permite aumentar la sabiduría de quien la posea.');
INSERT INTO "item_descriptions" VALUES(833,'pt','Esta varinha aumenta a sabedoria de seu portador.');
INSERT INTO "item_descriptions" VALUES(833,'de','Dieser Stab erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(836,'en','This ring, made of Treechnid Bark, has great powers but carries great responsibility with it. However, in spite of its value, it is said to be cursed.');
INSERT INTO "item_descriptions" VALUES(836,'fr','Cet anneau, forgé dans de l''écorce d''Abraknyde possède de grands pouvoirs et implique donc de grandes responsabilités. Cependant, malgré sa valeur, des rumeurs laissent entendre qu''il est maudit.');
INSERT INTO "item_descriptions" VALUES(836,'es','Este anillo fue forjado en la corteza de abráknido. Posee grandes poderes e implica por lo tanto grandes responsabilidades. Sin embargo, a pesar de su valor, existen rumores que cuentan que está maldito.');
INSERT INTO "item_descriptions" VALUES(836,'pt','Este anel, feito de casca de Arvraknídeo, tem grandes poderes e implica grandes responsabilidades. Entretanto, apesar de seu valor, dizem que ele é amaldiçoado.');
INSERT INTO "item_descriptions" VALUES(836,'de','Dieser Ring, der aus Astaknydenrinde gefertigt wurde, besitzt große Kräfte und legt damit dem Träger auch große Verantwortung auf. Doch trotz seines großen Wertes gibt es Gerüchte, die besagen, er sei verflucht.');
INSERT INTO "item_descriptions" VALUES(837,'en','These boots increase your Strength but they affect your Intelligence. They could even turn you into a Iop in case of prolonged and regular use.');
INSERT INTO "item_descriptions" VALUES(837,'fr','Ces bottes augmentent la force de leur porteur, mais risquent de le rendre un peu idiot au bout d''un certain temps, voire de le transformer en Iop en cas d''utilisation régulière et prolongée');
INSERT INTO "item_descriptions" VALUES(837,'es','Estas botas aumentan la fuerza del que las lleva pero pueden hacer que se vuelva un poco idiota al cabo de un cierto tiempo e incluso pueden transformarlo en yopuka si las utiliza demasiado a menudo y de forma prolongada.');
INSERT INTO "item_descriptions" VALUES(837,'pt','Estas botas aumentam a sua força, mas também o transformam em um perfeito idiota. Elas poderiam até mesmo transformá-lo em um Iop, no caso de uso regular e prolongado.');
INSERT INTO "item_descriptions" VALUES(837,'de','Diese Stiefel erhöhen beachtlich die Stärke seines Trägers, doch verdummt dieser im Laufe der Zeit dabei auch ein wenig. Bei regelmäßiger, langjähriger Verwendung endet er dann letzten Endes als Iop.');
INSERT INTO "item_descriptions" VALUES(841,'en','This ring increases AP in exchange for some Strength, Intelligence, Agility and Chance.');
INSERT INTO "item_descriptions" VALUES(841,'fr','Cet anneau permettra a votre héros d''augmenter ses PA, en contrepartie de sa force et de son intelligence.');
INSERT INTO "item_descriptions" VALUES(841,'es','Este anillo permitirá aumentar los PA de tu héroe, en contrapartida de su fuerza e inteligencia.');
INSERT INTO "item_descriptions" VALUES(841,'pt','Este anel aumenta os PA de quem possuí-lo em troca dos pontos de força e inteligência.');
INSERT INTO "item_descriptions" VALUES(841,'de','Dieser Ring erhöht die AP seines Trägers im Austausch gegen seine Stärke und Intelligenz.');
INSERT INTO "item_descriptions" VALUES(849,'en','This small ring increases Strength.');
INSERT INTO "item_descriptions" VALUES(849,'fr','Ce petit anneau donne de la Force à son porteur.');
INSERT INTO "item_descriptions" VALUES(849,'es','Este pequeño anillo procura fuerza a su portador.');
INSERT INTO "item_descriptions" VALUES(849,'pt','Este pequeno anel dá força a quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(849,'de','Dieser kleine Ring erhöht die Stärke seines Trägers.');
INSERT INTO "item_descriptions" VALUES(850,'en','Amaknian collectors are desperate to get their fingers into this ring, though it''s not worth a penny.');
INSERT INTO "item_descriptions" VALUES(850,'fr','Étrangement, les collectionneurs Amaknéens s''arrachent cet anneau alors qu''il ne vaut pas tripette.');
INSERT INTO "item_descriptions" VALUES(850,'es','Curiosamente, los coleccionistas amakneanos se disputan este anillo a pesar de que no valga un churro.');
INSERT INTO "item_descriptions" VALUES(850,'pt','Os coletores Amaknianos estão desesperados para conseguir pegar este anel, ainda que ele não valha nem um centavo.');
INSERT INTO "item_descriptions" VALUES(850,'de','Seltsamerweise stürzen sich die Sammler Amaknas auf diesen Ring, obwohl er keinen Pfifferling wert ist.');
INSERT INTO "item_descriptions" VALUES(851,'en','This small ring increases Life.');
INSERT INTO "item_descriptions" VALUES(851,'fr','Ce petit anneau augmente la vie de son porteur.');
INSERT INTO "item_descriptions" VALUES(851,'es','Este pequeño anillo aumenta la vida de su portador.');
INSERT INTO "item_descriptions" VALUES(851,'pt','Esse pequeno anel aumenta a vida de quem o usar.');
INSERT INTO "item_descriptions" VALUES(851,'de','Dieser kleine Ring erhöht die Lebenskraft seines Trägers.');
INSERT INTO "item_descriptions" VALUES(854,'en','This small amulet increases Strength.');
INSERT INTO "item_descriptions" VALUES(854,'fr','Cette petite amulette augmente la force de son porteur');
INSERT INTO "item_descriptions" VALUES(854,'es','Este amuleto aumenta la fuerza de su portador.');
INSERT INTO "item_descriptions" VALUES(854,'pt','Este pequeno amuleto aumentará a força de quem usá-lo.');
INSERT INTO "item_descriptions" VALUES(854,'de','Dieses kleine Amulett erhöht die Stärke seines Trägers.');
INSERT INTO "item_descriptions" VALUES(856,'en','This small amulet increases Agility.');
INSERT INTO "item_descriptions" VALUES(856,'fr','Cette petite amulette augmente l''agilité de son porteur.');
INSERT INTO "item_descriptions" VALUES(856,'es','Este amuleto aumenta la agilidad de su portador.');
INSERT INTO "item_descriptions" VALUES(856,'pt','Com este pequeno amuleto, você aumenta sua agilidade.');
INSERT INTO "item_descriptions" VALUES(856,'de','Dieses kleine Amulett erhöht die Flinkheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(860,'en','This basic belt increases luck.');
INSERT INTO "item_descriptions" VALUES(860,'fr','Cette modeste ceinture augmente la chance de son porteur.');
INSERT INTO "item_descriptions" VALUES(860,'es','Este modesto cinturón aumenta la suerte de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(860,'pt','Este simples cinto aumenta a sorte de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(860,'de','Dieser ärmlich aussehende Gürtel erhöht geringfügig das Glück seines Trägers. Aber immerhin besser als nichts, oder?');
INSERT INTO "item_descriptions" VALUES(862,'en','These sandals increase the intelligence of the wearer. They are also eternally fashionable. They are finished off with a breathable walnut sole for exquisite grip.');
INSERT INTO "item_descriptions" VALUES(862,'fr','Ces bottes permettent d''augmenter l''intelligence de leur porteur, tout en lui conférant un style vraiment à la mode par les temps qui courent grâce à leur semelle en Bois de Noyer qui offre une adhérence remarquable.');
INSERT INTO "item_descriptions" VALUES(862,'es','Estas botas permiten aumentar la inteligencia del que las lleva al mismo tiempo que le confiere un estilo muy a la moda gracias a su suela de madera de nogal que ofrece una adherencia increíble.');
INSERT INTO "item_descriptions" VALUES(862,'pt','Estas sandálias aumentam a inteligência de quem possuí-las. Elas também permitem que ele/ela fique na moda; as solas de nozes garantem uma incrível aderência.');
INSERT INTO "item_descriptions" VALUES(862,'de','Diese Stiefel erhöhen die Intelligenz ihres Trägers und verleihen ihm dabei auch noch einen modischen Touch. Das Kirschbaumholz der Sohlen passt sich einfach nur wunderbar dem Schuhbett an.');
INSERT INTO "item_descriptions" VALUES(863,'en','These boots increase the Agility of the wearer so that he can get into character as a Tofu every time he feels like making a fool of himself.');
INSERT INTO "item_descriptions" VALUES(863,'fr','Ces bottes permettent d''augmenter l''agilité de leur porteur, afin qu''il puisse se prendre pour un Tofu plus facilement, lorsque l''envie lui prend de faire l''idiot.');
INSERT INTO "item_descriptions" VALUES(863,'es','Estas botas permiten aumentar la agilidad del que las lleva. De esta manera podrá imitar a un Tofu cuando le entren ganas de hacer el imbécil.');
INSERT INTO "item_descriptions" VALUES(863,'pt','Estas botas aumentam a agilidade do portador de forma que possa agir facilmente como um Tofu todas as vezes que ele se sentir como um.');
INSERT INTO "item_descriptions" VALUES(863,'de','Diese Stiefel erhöhen die Flinkheit ihres Trägers. Da kann man ihn doch glatt mit einem Tofu verwechseln, vor allem wenn er sich mal wieder durch seine eigene Dummheit vor allen anderen lächerlich gemacht hat.');
INSERT INTO "item_descriptions" VALUES(864,'en','These boots increase your luck in finding powerful items such as Gobball Slobber.');
INSERT INTO "item_descriptions" VALUES(864,'fr','Ces bottes augmentent la chance de leur porteur afin de l''aider à trouver des objets très puissants, comme de la bave de Bouftou par exemple.');
INSERT INTO "item_descriptions" VALUES(864,'es','Estas botas aumentan la suerte del que las lleva para ayudarle a encontrar objetos muy poderosos, como por ejemplo la baba de jalató.');
INSERT INTO "item_descriptions" VALUES(864,'pt','Estas botas aumentam a sorte de quem possuí-las, para encontrar itens poderosos como saliva de Papatudo.');
INSERT INTO "item_descriptions" VALUES(864,'de','Diese Stiefel erhöhen das Glück ihres Trägers. Dadurch wird dieser leichter an seltene Gegenstände herankommen, wie zum Beispiel Fresssackspeichel.');
INSERT INTO "item_descriptions" VALUES(867,'en','Made of Dreggon remains, this splendid amulet is impressive enough to make your bravest enemies run home sobbing.');
INSERT INTO "item_descriptions" VALUES(867,'fr','Cette splendide amulette confectionnée à partir de restes de Dragoeuf, est suffisamment impressionnante pour faire battre en retrait la majorité des ennemis normalement constitués.');
INSERT INTO "item_descriptions" VALUES(867,'es','Este espléndido amuleto confeccionado a partir de restos de dragohuevo, es lo suficientemente impresionante como para alejar a la mayoría de los enemigos.');
INSERT INTO "item_descriptions" VALUES(867,'pt','Este esplêndido amuleto feito de restos de Dragovo é impressionante o suficiente para fazer a maioria dos valentes inimigos bater em retirada.');
INSERT INTO "item_descriptions" VALUES(867,'de','Dieses herrliche Amulett wurde aus den Überresten von Dracheiern handgefertigt und verfügt über eine solch eindrucksvolle Macht, dass der größte Teil der alltäglichen Gegner lieber den Rückzug antritt.');
INSERT INTO "item_descriptions" VALUES(890,'en','These boots are made of Gobball leather. Thanks to the smell they give off, breeders can approach and kill Gobblies with the greatest of ease.');
INSERT INTO "item_descriptions" VALUES(890,'fr','Ces bottes sont confectionnées en cuir de Bouftou, elles permettent aux éleveurs de s''approcher plus facilement des Bouftons pour les tuer, grâce à l''odeur qu''elles dégagent.');
INSERT INTO "item_descriptions" VALUES(890,'es','Estas botas están hechas con cuero de jalató; permiten que los ganaderos puedan acercarse más fácilmente a los jalatines para matarlos gracias al olor que desprenden.');
INSERT INTO "item_descriptions" VALUES(890,'pt','Com estas botas feitas de couro de Paparneiro, os criadores podem se aproximar e matar outros Paparneiros com mais facilidade, graças ao odor que elas exalam.');
INSERT INTO "item_descriptions" VALUES(890,'de','Diese Stiefel sind aus Fresssackleder geschustert und dünsten einen sehr speziellen Geruch aus, der es den Züchtern erlaubt, sich den Fresssäcken einfacher zu nähern und sie zu überwältigen.');
INSERT INTO "item_descriptions" VALUES(894,'en','These daggers were created for cutting roots and young saplings in spring time but they were soon decommissioned in favour of quite a different purpose.');
INSERT INTO "item_descriptions" VALUES(894,'fr','Ces dagues étaient particulièrement bien adaptées pour couper les racines ou les jeunes pousses, elles ont été détournées de leur usage pour en faire des armes presque mortelles.');
INSERT INTO "item_descriptions" VALUES(894,'es','Estas dagas fueron especialmente diseñadas para cortar raíces o pequeños brotes, ahora se usan para otros propósitos y se volvieron unas armas casi letales.');
INSERT INTO "item_descriptions" VALUES(894,'pt','Estas adagas foram particularmente bem adaptadas para cortar raízes e brotos, mas elas começaram a ser usadas como armas quase mortais.');
INSERT INTO "item_descriptions" VALUES(894,'de','Einst waren diese Dolche speziell dazu geschaffen worden, Wurzeln und junge Triebe zu stutzen, doch dann bemerkte man, dass sie auch als nahezu tödliche Waffe taugen...');
INSERT INTO "item_descriptions" VALUES(898,'en','These modest-looking daggers are extremely dangerous. They are easily hidden down the pants which makes them a weapon of choice for murderous eunuchs throughout the land. The words chicken and egg come to mind.');
INSERT INTO "item_descriptions" VALUES(898,'fr','Ces dagues d''apparence modeste sont cependant très dangereuses. Elles sont de plus facilement dissimulables, ce qui en fait une arme de choix pour les assassins.');
INSERT INTO "item_descriptions" VALUES(898,'es','Estas dagas aparentemente modestas son sin embargo muy peligrosas. Además son fáciles de esconder las vuelve ideales para los asesinos.');
INSERT INTO "item_descriptions" VALUES(898,'pt','Estas simples adagas são, no entanto, muito perigosas. Elas podem ser facilmente escondidas e são, conseqüentemente, a escolha de arma para infiltradores.');
INSERT INTO "item_descriptions" VALUES(898,'de','Diese gewöhnlich erscheinenden Dolche sind extrem scharf. Sie sind leicht zu verstecken, weshalb sie auch eine bevorzugte Waffe für Meuchelmörder sind.');
INSERT INTO "item_descriptions" VALUES(903,'en','These boots gave Klime the shoemaker such agility that he was able to ride Gobballs. He died when he mistook a Jelly for a Gobball, having spent an evening drinking in the tavern.');
INSERT INTO "item_descriptions" VALUES(903,'fr','L''agilité que confèrent ces bottes permettait à Klime le cordonnier de monter facilement sur le dos de n''importe quel Bouftou. Il est mort en confondant un Bouftou avec une Gelée, après une soirée trop arrosée passée à la taverne.');
INSERT INTO "item_descriptions" VALUES(903,'es','Gracias a la agilidad que confieren estas botas, Klim, el zapatero, montaba fácilmente a lomos de cualquier jalató. Se murió al confundir un jalató con una gelatina, tras una noche demasiado alcoholizada en la taberna.');
INSERT INTO "item_descriptions" VALUES(903,'pt','Com a agilidade conferida por essas botas, Klim, o sapateiro, podia montar facilmente sobre qualquer Papatudo. Ele acabou se dando mal após confundir uma Gelatina com um Papatudo, depois de tomar todas na taberna.');
INSERT INTO "item_descriptions" VALUES(903,'de','Die Flinkheit, die er mit diesen Stiefeln erlangte, ermöglichte es dem Schuhmacher R.Klimm, problemlos auf den Rücken eines jeden Fresssackes zu klettern. Leider verstarb er ziemlich früh, weil er nach einer durchzechten Nacht in der Taverne einen Fresssack mit einem Gelee verwechselte.');
INSERT INTO "item_descriptions" VALUES(907,'en','With these boots, Hogmeiser used to chase off the only human beings he couldn''t stand the sight of: children. Fortunately for them, the weight of the footwear prevented him from ever catching a single one.');
INSERT INTO "item_descriptions" VALUES(907,'fr','Ces bottes permettaient à Hogmeiser de poursuivre les seuls êtres vivants qu''il ne supportait pas, les enfants. Heureusement pour eux, la lourdeur de ces bottes l''empêchait de leur botter le derrière.');
INSERT INTO "item_descriptions" VALUES(907,'es','Estas botas permitían a Hogmeiser perseguir a los únicos seres vivientes que no soportaba, los niños. Afortunadamente para ellos, estas botas eran tan pesadas que no conseguía patearles el trasero.');
INSERT INTO "item_descriptions" VALUES(907,'pt','Com estas botas, Hogmeiser perseguiu os únicos seres humanos que ele não suportava: crianças. Felizmente para elas, o peso destas botas o prevenia de chutar seus traseiros.');
INSERT INTO "item_descriptions" VALUES(907,'de','Diese Stiefel erlaubt es Hogmeiser, die einzigen Wesen Amaknas zu verfolgen, die er nicht ausstehen konnte, nämlich Kinder. Zum Glück für diese waren die Stiefel allerdings so schwer, dass er ihnen damit noch nicht mal einen Tritt in den Allerwertesten verpassen konnte.');
INSERT INTO "item_descriptions" VALUES(910,'en','These boots belonged to Hogmeiser for many years, before he actually lost them on a stupid bet with Grizmine. The moral of this story is... never gamble with an Ecaflip.');
INSERT INTO "item_descriptions" VALUES(910,'fr','Ces bottes ont appartenu à Hogmeiser pendant des années, avant qu''il ne les perdent lors d''un pari stupide avec Grizmine. La morale de l''histoire, c''est qu''il ne faut jamais jouer avec un Ecaflip.');
INSERT INTO "item_descriptions" VALUES(910,'es','Estas botas pertenecieron durante años a Hogmeiser, antes de que las perdiese en una apuesta estúpida con Grizmoh Guay. Moraleja: Nunca juegues con un zurcarák.');
INSERT INTO "item_descriptions" VALUES(910,'pt','Estas botas pertenceram a Hogmeiser muitos anos atrás, antes de ele perder uma estúpida aposta com Grizmine. A moral desta história é: nunca jogue com um Ecaflip.');
INSERT INTO "item_descriptions" VALUES(910,'de','Diese Stiefel gehörten jahrelang Hogmeiser, doch verlor er sie eines Tages aufgrund einer dummen Wette mit Griesgrahm. Und die Moral von der Geschicht: spiel niemals mit den Ecaflips nicht.');
INSERT INTO "item_descriptions" VALUES(912,'en','These magnificent Hogmeiser boots are finely peppered with precious stones, protecting you against magic attacks. Brouce Boulgoure himself used them to crush the Treechnid King''s head many years ago, just to liven up the opening of the Trool Fair.');
INSERT INTO "item_descriptions" VALUES(912,'fr','Ces magnifiques bottes d''Hogmeiser sont recouvertes d''une fine couche de pierres précieuses, pour les rendre insensibles à certaines attaques magiques. C''est avec ces bottes que Brouce Boulgoure a écrasé la tête du Roi des Abraknydes il y a très longtemps, pour animer l''ouverture de la foire du Trool.');
INSERT INTO "item_descriptions" VALUES(912,'es','Estas magníficas botas de Hogmeiser están revestidas con una capa fina de piedras preciosas para que resistan a determinados ataques mágicos. Estas botas son las que Brus Bulguro utilizó para aplastar la cabeza del rey de los abráknidos hace mucho tiempo, para animar la apertura de la Feria del Trool.');
INSERT INTO "item_descriptions" VALUES(912,'pt','Estas magníficas botas de Hogmeiser são finalmente cobertas com pedras preciosas e assim protegidas contra alguns ataques mágicos. Bruce Bulgure, o próprio, usou-as para esmagar a cabeça do Rei dos Arvraknídeos muito tempo atrás, e agora revive apenas na abertura da Feira de Trool.');
INSERT INTO "item_descriptions" VALUES(912,'de','Diese wunderschönen Hogmeiser Stiefel sind voll vergoldet und von einer dünnen Schicht aus Edelsteinen bedeckt, die sie unempfindlich gegen bestimmte magischen Angriffe machen. Übrigens war es genau ein solches Stiefelpaar, welches Bruce Bulgour benutzte, als er anläßlich der Eröffnung des Jahrmarktes des Trools den Kopf des Königs der Astaknyden zermalmte.');
INSERT INTO "item_descriptions" VALUES(916,'en','Silicate made this amulet on a wintry morning for a famous adventurer named Rimb Vardi, who was hunting down an old Bwork Magus. The bungling magic that followed was the root of many a natural disaster.');
INSERT INTO "item_descriptions" VALUES(916,'fr','Silicate a confectionné cette Amulette un matin d''hiver, pour un célèbre aventurier du nom de Rimb Vardi, qui pourchassait un vieux Bwork Mage, responsable de plusieurs catastrophes naturelles déclenchées par sa magie trop approximative.');
INSERT INTO "item_descriptions" VALUES(916,'es','Silicato realizó este amuleto una mañana de invierno, para un famoso aventurero llamado Rimb Vardi, que perseguía a un viejo bwork mago, responsable de varias catástrofes naturales que su magia, demasiado aproximativa, había desencadenado.');
INSERT INTO "item_descriptions" VALUES(916,'pt','Silicate fez este amuleto numa manhã de inverno para um famoso aventureiro chamado Rimb Vardi, que estava caçando um antigo Bwork Mago. Este último foi responsável por muitos desastres naturais causados por sua mágica duvidosa.');
INSERT INTO "item_descriptions" VALUES(916,'de','Silikat hat diese Halskette eines Wintermorgens für den berühmten Abenteurer Rimb Vardi gefertigt, als dieser einen alten Bwork Magus verfolgte, der mit seiner zweifelhaften Magie bereits mehrere Naturkatastrophen verursacht hatte.');
INSERT INTO "item_descriptions" VALUES(917,'en','This brooch was made one autumn morning in the depths of a Beech and Elm forest, near the Olag-Lacustre Island. It is considered to be a true relic by a great many lumberjacks.');
INSERT INTO "item_descriptions" VALUES(917,'fr','Cette Broche a été confectionnée un matin d''automne au milieu d''une forêt de Hêtres et d''Ormes non loin de l''île d''Olag-lacustre. Elle est considérée par nombre de bûcherons comme une véritable relique.');
INSERT INTO "item_descriptions" VALUES(917,'es','Este broche ha sido realizado una mañana de otoño en medio de un bosque de hayas y olmos no muy lejos de la isla de Olag-lacustre. Muchos leñadores la consideran como una auténtica reliquia.');
INSERT INTO "item_descriptions" VALUES(917,'pt','Este Broche foi confeccionado em uma manhã de outono no meio de uma floresta de Faias e Olmos, próxima à Ilha de Olag-lacustre. É considerada uma verdadeira relíquia por um grande número de lenhadores.');
INSERT INTO "item_descriptions" VALUES(917,'de','Diese Brosche wurde eines Morgens inmitten eines großen Laubwaldes aus Buchen und Ulmen in der Nähe der Insel von Olag-Lacustre erschaffen. In den Augen vieler Holzfäller ist sie eine echte Reliquie.');
INSERT INTO "item_descriptions" VALUES(919,'en','These powerful daggers, forged from Ancestral Amber according to ancient techniques, were used during the colonization of Moon Island. It soon became wild again.');
INSERT INTO "item_descriptions" VALUES(919,'fr','Ces puissantes dagues, forgées à l''ancienne à partir d''Ambre Ancestrale, ont servi pendant la colonisation de l''île de Moon, avant que cette dernière ne redevienne sauvage.');
INSERT INTO "item_descriptions" VALUES(919,'es','Estas magníficas dagas, forjadas a partir de ámbar ancestral y usando antiguos métodos, sirvieron durante la colonización de Isla de Moon, antes de que esta se volviera otra vez salvaje.');
INSERT INTO "item_descriptions" VALUES(919,'pt','Estas poderosas adagas, tradicionalmente forjadas a partir do Âmbar Ancestral, foram usadas durante a colonização da Ilha da Lua, antes de ela tornar-se novamente selvagem.');
INSERT INTO "item_descriptions" VALUES(919,'de','Diese äußerst mächtigen Dolche, die nach altem Wissen mit Hilfe von uraltem Bernstein geschmiedet wurden, haben ihrem Träger bei der Kolonisierung der Moon-Insel gut gedient. Doch letzten Endes wurde die Insel dann wieder der Verwilderung überlassen. Urig, aber wahr.');
INSERT INTO "item_descriptions" VALUES(923,'en','This battle axe was forged by Kademlia Boulgoure to fight against the most terrifying Treechnids. Legend has it that this legendary weapon killed more Treechnids in a night than there are trees in Amakna.');
INSERT INTO "item_descriptions" VALUES(923,'fr','Cette hache de guerre a été forgée par Kademlia Boulgoure, pour combattre les plus terrifiants Abraknydes. La légende raconte que cette arme légendaire a tué en une nuit plus d''Abraknydes qu''il n''existe d''arbres en Amakna.');
INSERT INTO "item_descriptions" VALUES(923,'es','Esta hacha de guerra ha sido forjada por Kademlia Bulguro para luchar contra los más terroríficos abráknidos. Cuenta la leyenda que esta arma legendaria ha matado, en una noche, a más abráknidos que árboles hay en Amakna.');
INSERT INTO "item_descriptions" VALUES(923,'pt','Este machado de batalha foi forjado por Kademlia Boulgoure para lutar contra o mais terrível Arvraknídeo. A lenda diz que esta lendária arma matou mais Arvraknídeos em uma noite do que as árvores existentes em Amakna.');
INSERT INTO "item_descriptions" VALUES(923,'de','Diese Kriegsaxt wurde von Kademlia Boulgour geschmiedet, um die gefährlichsten aller Astaknyden niederstrecken zu können. Der Legende nach soll sie mit dieser legendären Waffe eines Nachts mehr Astaknyden niedergestreckt haben, als es in ganz Amakna Bäume gibt!');
INSERT INTO "item_descriptions" VALUES(927,'en','This battle-axe was forged by Kademlia Boulgoure to fight against the Ancestral Treechnid. Only the best warriors can handle it.');
INSERT INTO "item_descriptions" VALUES(927,'fr','Cette hache de guerre a été forgée par Kademlia Boulgoure, pour combattre l''Abraknyde Ancestral. Seuls les meilleurs guerriers sont à même de pouvoir l''utiliser.');
INSERT INTO "item_descriptions" VALUES(927,'es','Esta hacha ha sido forjada por Kademlia Bulguro, para combatir el Abráknido Ancestral. Solo los mejores guerreros pueden utilizarla.');
INSERT INTO "item_descriptions" VALUES(927,'pt','Este machado de guerra foi forjado por Kademlia Boulgoure para lutar contra o Arvraknídeo Ancestral. Só os melhores guerreiros podem usá-lo.');
INSERT INTO "item_descriptions" VALUES(927,'de','Diese Kriegsaxt wurde von Kademlia Boulgour geschmiedet, um die gefährlichsten aller Astaknyden, nämlich die Ur-Astaknyden, niederstrecken zu können. Nur die besten aller Krieger sind in der Lage, diese Waffe überhaupt zu führen.');
INSERT INTO "item_descriptions" VALUES(928,'en','Ogralimde was a great warrior who derived his strength from his master Adyol, an exceptionally intelligent and powerful Bwork Magus. This apprentice never surpassed his master.');
INSERT INTO "item_descriptions" VALUES(928,'fr','Ogralimde était un grand guerrier qui devait sa force à Adyol son maître, un puissant Bwork Mage d''une intelligence surprenante. Mais l''élève n''a jamais dépassé le maître, contrairement à ce que raconte la légende.');
INSERT INTO "item_descriptions" VALUES(928,'es','Ogralimde era un gran guerrero que debía su fuerza a Adyol su maestro, un poderoso bwork mago cuya inteligencia era sorprendente. Pero, a pesar de lo que cuenta la leyenda, el alumno nunca superó al maestro.');
INSERT INTO "item_descriptions" VALUES(928,'pt','Ogralimde era um grande guerreiro que devia sua força a seu mestre Adyol, um Bwork Mago excepcionalmente inteligente e poderoso. Mais um fato, ao contrário da lenda, o aprendiz nunca superou o mestre.');
INSERT INTO "item_descriptions" VALUES(928,'de','Ogralimde war ein großer Krieger. Seine Ausbildung hatte er seinem Meister Adyol, einem mächtigen und erschreckend intelligenten Bwork Magus, zu verdanken. Jedoch hat im Gegensatz zu den üblichen Erzählungen hier niemals der Schüler seinen Meister übertroffen.');
INSERT INTO "item_descriptions" VALUES(933,'en','This cloak increases life.');
INSERT INTO "item_descriptions" VALUES(933,'fr','Cette cape augmente la vie de son porteur.');
INSERT INTO "item_descriptions" VALUES(933,'es','Esta capa aumenta la vida del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(933,'pt','Este manto aumenta a vida de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(933,'de','Dieser Umhang erhöht die Lebenspunkte seines Trägers.');
INSERT INTO "item_descriptions" VALUES(936,'en','This cloak increases chance.');
INSERT INTO "item_descriptions" VALUES(936,'fr','Cette cape augmente la chance de son porteur.');
INSERT INTO "item_descriptions" VALUES(936,'es','Esta capa aumenta la suerte del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(936,'pt','Este manto aumenta a sorte de seu portador.');
INSERT INTO "item_descriptions" VALUES(936,'de','Dieser Umhang erhöht das Glück seines Trägers.');
INSERT INTO "item_descriptions" VALUES(940,'en','The Farter protects you from physical damage.');
INSERT INTO "item_descriptions" VALUES(940,'fr','Le Louffeur prévient des dégâts physiques.');
INSERT INTO "item_descriptions" VALUES(940,'es','El Depedador te protege contra los daños físicos.');
INSERT INTO "item_descriptions" VALUES(940,'pt','O Farter protege contra danos físicos.');
INSERT INTO "item_descriptions" VALUES(940,'de','Poupsi beschützt den Träger vor körperlichem Schaden.');
INSERT INTO "item_descriptions" VALUES(941,'en','The Komintot increases the Wisdom of the wearer.');
INSERT INTO "item_descriptions" VALUES(941,'fr','Le Komintot permet d''augmenter la sagesse de son porteur.');
INSERT INTO "item_descriptions" VALUES(941,'es','El Komuntot permite aumentar la sabiduría de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(941,'pt','O Komintot aumenta a sabedoria de quem possuí-lo.');
INSERT INTO "item_descriptions" VALUES(941,'de','Dieses schöne Stirnband erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(942,'en','The Smoother resists magic damage.');
INSERT INTO "item_descriptions" VALUES(942,'fr','Le Lisseur prévient des dégâts magiques.');
INSERT INTO "item_descriptions" VALUES(942,'es','El Alisador te protege contra los daños mágicos.');
INSERT INTO "item_descriptions" VALUES(942,'pt','O Aplainador interrompe danos mágicos.');
INSERT INTO "item_descriptions" VALUES(942,'de','Lizzy beschützt den Träger vor magischem Schaden.');
INSERT INTO "item_descriptions" VALUES(944,'en','This headband increases Vitality.');
INSERT INTO "item_descriptions" VALUES(944,'fr','Ce Bandeau permet d''augmenter la vitalité de son porteur.');
INSERT INTO "item_descriptions" VALUES(944,'es','Este pañuelo permite aumentar la vitalidad de quien lo lleve puesto.');
INSERT INTO "item_descriptions" VALUES(944,'pt','Esta bandana aumenta a vitalidade de quem usá-la.');
INSERT INTO "item_descriptions" VALUES(944,'de','Dieses Stirnband erhöht die Vitalität seines Trägers.');
INSERT INTO "item_descriptions" VALUES(946,'en','This cloak increases Wisdom.');
INSERT INTO "item_descriptions" VALUES(946,'fr','Cette cape augmente la sagesse de son porteur.');
INSERT INTO "item_descriptions" VALUES(946,'es','Esta capa aumenta la sabiduría del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(946,'pt','Este manto aumenta a sabedoria de seu portador.');
INSERT INTO "item_descriptions" VALUES(946,'de','Dieser Umhang erhöht die Weisheit seines Trägers.');
INSERT INTO "item_descriptions" VALUES(948,'en','This magnificent cloak is a clever mix of Treechnid essence and nice familial Gobball.');
INSERT INTO "item_descriptions" VALUES(948,'fr','Cette magnifique cape est un brillant mélange entre l''essence d''Abraknyde et le bon Bouftou des familles.');
INSERT INTO "item_descriptions" VALUES(948,'es','Esta magnífica capa es una sabia mezcla entre la esencia de abráknido y el buen jalató de siempre.');
INSERT INTO "item_descriptions" VALUES(948,'pt','Este magnífico manto é uma engenhosa mistura de essência de Arvraknídeo com um bom Papatudo doméstico.');
INSERT INTO "item_descriptions" VALUES(948,'de','Solchermaßen gewappnet könnt ihr glatt durch den ganzen Wald stolzieren, ohne erkannt zu werden. Doch seht euch vor! Es kann schnell passieren, dass den Astaknyden bei eurem Anblick der Saft in die Krone schießt.');
INSERT INTO "item_descriptions" VALUES(952,'en','This cloak was made of hairs and other organic elements taken from Boowolves. I can smell its power from here.');
INSERT INTO "item_descriptions" VALUES(952,'fr','Cette cape a été confectionné grâce à des poils et autres élèments organiques de diverses Mulous... On peut dire qu''elle respire la puissance.');
INSERT INTO "item_descriptions" VALUES(952,'es','Esta capa ha sido creada con pelos y otros elementos orgánicos de varios mediulubos... Se puede decir que su olor es poderoso y duradero.');
INSERT INTO "item_descriptions" VALUES(952,'pt','Este manto foi feito de pêlos e outros elementos orgânicos de Boolobos... Você pode sentir o cheiro de poder...');
INSERT INTO "item_descriptions" VALUES(952,'de','Dieser Umhang wurde aus dem Fell und diversen anderen organischen Teilen von tollwütigen WuWulfs angefertigt... darum kann man von ihm durchaus behaupten, er würde im wahrsten Sinne des Wortes eine Aura der Macht verbreiten.');
INSERT INTO "item_descriptions" VALUES(953,'en','With this handmade cloak of Tofu feathers, you will be able to run faster and escape from tackle zones with the grace of a shotgun-blasted pigeon.');
INSERT INTO "item_descriptions" VALUES(953,'fr','Cette cape, cousue main avec des plumes de Tofus, permet au héros qui la porte de courir plus vite et de s''échapper plus facilement des zones de tacle.');
INSERT INTO "item_descriptions" VALUES(953,'es','Esta capa, cosida con plumas de tofus, permite que el héroe que la lleve puesta corra más rápido y se escape más fácilmente de las zonas de placaje.');
INSERT INTO "item_descriptions" VALUES(953,'pt','Com este manto de penas de Tofu feito à mão, você será capaz de correr mais rápido e escapar de zonas de ataque.');
INSERT INTO "item_descriptions" VALUES(953,'de','Dieser mit Tofu-Federn besetzte Umhang erlaubt es seinem Träger, sehr schnell zu rennen und sehr leicht aus Gerangeln mit Angreifern zu entkommen. Jedoch sollte man damit nicht erwarten, einen heldenhaften Eindruck zu hinterlassen...');
INSERT INTO "item_descriptions" VALUES(954,'en','The legendary Poak Cloak was specially embroidered for warriors who live for close combat situations.');
INSERT INTO "item_descriptions" VALUES(954,'fr','La Samoulaille est une cape légendaire, brodée par les tailleurs pour les guerriers préférant les combats au corps à corps.');
INSERT INTO "item_descriptions" VALUES(954,'es','La Samulay es una capa legendaria, bordada por los mejores sastres para los guerreros que prefieren los combates de cuerpo a cuerpo.');
INSERT INTO "item_descriptions" VALUES(954,'pt','A Samoulaille é um manto lendário, costurado por alfaiates para facilitar o combate corpo-a-corpo.');
INSERT INTO "item_descriptions" VALUES(954,'de','Das Samttuchai ist ein legendärer Umhang, der von den besten Schneidern ausschließlich für eine Gruppe von Kriegern angefertigt wird, die einen eigenen Kampfstil entwickelt haben und nur den Nahkampf für ehrenvoll halten.');
INSERT INTO "item_descriptions" VALUES(955,'en','Hairdressers use the Cape Hillary to tie up their hair. Will you?');
INSERT INTO "item_descriptions" VALUES(955,'fr','La cape Hilère est un type de cape très demandée par les coiffeurs. Ils adorent se rouler dedans. Elle rend les cheveux de son porteur plus résistants aux chocs.');
INSERT INTO "item_descriptions" VALUES(955,'es','La capa Ylar es un tipo de capa muy pedida por los peluqueros. Les encanta revolcarse en ella. Hace que los pelos del que la lleve puesta se vuelvan más resistentes.');
INSERT INTO "item_descriptions" VALUES(955,'pt','A Capa Hillary é um tipo de capa muito apreciada por cabeleireiros. Eles adoram se enrolar nela. Ela torna o cabelo do seu portador mais resistente a choques.');
INSERT INTO "item_descriptions" VALUES(955,'de','Hillar Cape ist besonders bei Frisören besonders beliebt, da sie sich und ihre Kunden gern darin einrollen. Dadurch sollen angeblich die Haare widerstandsfähiger und kräftiger werden.');
INSERT INTO "item_descriptions" VALUES(956,'en','This cloak increases your range, allowing distant targets to be attacked... or naive adventurers to be dumbfounded into unsuspecting admiration. Haha!');
INSERT INTO "item_descriptions" VALUES(956,'fr','Cette cape augmente la portée de son porteur, lui permettant d''atteindre des cibles très éloignées, ou d''impressionner les aventuriers un peu naïfs.');
INSERT INTO "item_descriptions" VALUES(956,'es','Esta capa aumenta el alcance del que la lleve puesta, permitiéndole a su vez atinar los blancos muy alejados o impresionar a los aventureros un poco ingenuos.');
INSERT INTO "item_descriptions" VALUES(956,'pt','Este manto aumenta o alcance de ação do portador, permitindo-lhe alcançar alvos bem distantes... ou impressionar aventureiros ingênuos.');
INSERT INTO "item_descriptions" VALUES(956,'de','Dieser Mantel erhöht die Reichweite seines Trägers, wodurch selbst weit entfernte Ziele durch seine Zauber erfasst, oder die naiven Anfänger unter den Abenteurer gehörig beeindruckt werden können.');
INSERT INTO "item_descriptions" VALUES(957,'en','The Gobb increases damage and Vitality, but it gives off a nasty odour, too. Don''t be surprised if the Gobballs think you''re one of the gang.');
INSERT INTO "item_descriptions" VALUES(957,'fr','La Boufteuse augmente les dégâts et la vitalité de son porteur. Cependant elle dégage une forte odeur, et il n''est pas rare qu''un bouftou vous prenne pour l''un des siens.');
INSERT INTO "item_descriptions" VALUES(957,'es','La Jalatada aumenta los daños y la vitalidad del que la lleve puesta. Sin embrago, desprende un fuerte olor y puede ser que algún jalató piense que eres uno de los suyos.');
INSERT INTO "item_descriptions" VALUES(957,'pt','A Papatosa aumenta os danos e a vitalidade de seu portador. Mas ela exala um cheiro forte e não é raro que um Papatudo pense que você é um deles.');
INSERT INTO "item_descriptions" VALUES(957,'de','Das Fresssacktuch erhöht den durch seinen Träger angerichteten Schaden und seine Vitalität. Dummerweise sondert es einen strengen Geruch ab. Daher könnte es durchaus vorkommen, dass ein Fresssack euch mit einem seiner Artgenossen verwechselt.');
INSERT INTO "item_descriptions" VALUES(958,'en','This cloak is certainly one of the most powerful of its kind in the World. It increases all the characteristics of its wearer.');
INSERT INTO "item_descriptions" VALUES(958,'fr','Cette cape est certainement l''une des plus puissantes au monde. Elle augmente toutes les caractéristiques de son porteur.');
INSERT INTO "item_descriptions" VALUES(958,'es','Esta capa es sin duda alguna una de las más poderosas del mundo. Aumenta todas las características del que la lleve puesta.');
INSERT INTO "item_descriptions" VALUES(958,'pt','Este manto é certamente uma das armas mais poderosas do mundo. Ele aumenta todas as características de seu portador.');
INSERT INTO "item_descriptions" VALUES(958,'de','Dieses Gewand gehört zu den Mächtigsten der ganzen Welt. Es verstärkt merklich die Kräfte seines Trägers. Ist es nicht gerade voll im Trend, als Tourist durch die Schlachtfelder zu stolzieren?');
INSERT INTO "item_descriptions" VALUES(967,'en','This magnificent cloak increases AP, as well as Vitality and Wisdom.');
INSERT INTO "item_descriptions" VALUES(967,'fr','Cette magnifique cape augmente les points d''action de son porteur. Elle augmente également sa vitalité et sa sagesse.');
INSERT INTO "item_descriptions" VALUES(967,'es','Esta magnífica capa aumenta los puntos de acción del que la lleve puesta. También aumenta su vitalidad y su sabiduría.');
INSERT INTO "item_descriptions" VALUES(967,'pt','Este magnífico manto aumenta os pontos de ação do portador, assim como sua vitalidade e sabedoria.');
INSERT INTO "item_descriptions" VALUES(967,'de','Dieser wunderschöne Umhang erhöht die AP, Vitalität und Weisheit seines Trägers. Ein Feuerwerk der Sinne eben!');
INSERT INTO "item_descriptions" VALUES(969,'en','This magnificent Crown once belonged to the notorious Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(969,'fr','Cette magnifique couronne a appartenu au tristement célèbre Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(969,'es','Esta magnífica corona perteneció al tristemente célebre Wey Wabbit.');
INSERT INTO "item_descriptions" VALUES(969,'pt','Esta Coroa magnífica uma vez pertenceu a um famoso Wei Wabbit.');
INSERT INTO "item_descriptions" VALUES(969,'de','Diese wunderschöne Krone gehörte einst dem berühmt-berüchtigten Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'en','This staff once belonged to the notorious Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'fr','Ce bâton appartenait au tristement célèbre Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'es','Este bastón pertenecía al tristemente célebre Wey Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'pt','Este cajado uma vez pertenceu a um famoso Wei Wabbit.');
INSERT INTO "item_descriptions" VALUES(970,'de','Dieser Stecken gehörte einst dem berüchtigten Wa Wabbit.');
INSERT INTO "item_descriptions" VALUES(971,'en','This cloak once belonged to the notorious Wa Wabbit. It is still imbued with his perspiration which will bring back a few memories of the amazing fight every time you put it on.');
INSERT INTO "item_descriptions" VALUES(971,'fr','Cette cape appartenait au tristement célèbre Wa Wabbit. Elle est encore imprégnée de sa transpiration, ce qui vous permettra de vous remémorer ce magnifique combat à chaque fois que vous la porterez.');
INSERT INTO "item_descriptions" VALUES(971,'es','Esta capa pertenecía al tristemente célebre Wey Wabbit. Todavía está impregnada por su transpiración, lo cual te permitirá recordar siempre aquel magnífico combate cada vez que te la pongas.');
INSERT INTO "item_descriptions" VALUES(971,'pt','Esta capa uma vez pertenceu a um famoso Wei Wabbit. Ainda está impregnado com a sua transpiração, que o fará se lembrar da surpreendente luta cada vez você usá-la.');
INSERT INTO "item_descriptions" VALUES(971,'de','Dieses königliche Gewand hat einmal der berühmte Wa Wabbit besessen. Vollgesogen mit seinem Schweiß und anderen Absonderungen wird es euch beim Tragen immer an ihn erinnern... Wie schön!');
INSERT INTO "item_descriptions" VALUES(972,'en','If a dragon really did lay this egg, then she must have been a right sweetheart. Especially since its main purpose seems to be to attract adventurers to the Wa Wabbit''s island so he can nick all their garb and gear before humiliating them. All in all, it''s quite a good way to obtain the latest sets without having to leave the house.');
INSERT INTO "item_descriptions" VALUES(972,'fr','Si un dragon avait véritablement pondu cet oeuf, il serait très aimable. Plus en tout cas que le Wa Wabbit, qui s''en sert pour attirer les aventuriers sur son île afin de les dépouiller de leur équipement et, accessoirement, de leur fierté. Un moyen ingénieux et peu onéreux de se procurer les équipements dernier cri sans bouger de chez soi.');
INSERT INTO "item_descriptions" VALUES(972,'es','Si un dragón hubiese puesto este huevo, tendría muy buena vista, pero seguro que no menos que el Wey Wabbit, quien lo utiliza para atraer a los aventureros a su isla para robarles todo sus equipo y, si puede ser, su orgullo. Un medio ingenioso y bastante barato de conseguir sets de moda sin moverse de casa.');
INSERT INTO "item_descriptions" VALUES(972,'pt','Se um dragão realmente pôs este ovo, ele certamente tinha uma vista perfeita, ao contrário do Wei Wabbit, que costuma atacar as árvores da ilha ao confundi-las com invasores. É isso que dá não querer usar óculos: sem enxergar direito, você fica desconfiado e pensa que tudo é armação.');
INSERT INTO "item_descriptions" VALUES(972,'de','Wenn dieses Ei tatsächlich von einem Drachen gelegt wurde, dann wäre dieser bestimmt sehr freundlich. Naja, auf jeden Fall freundlicher als der Wa Wabbit, der sich dieses Dofus bedient, um haufenweise Abenteurer auf seine Insel zu locken, um sie dort um ihre Ausrüstung und nebenbei auch um ihren Stolz zu bringen. Das ist eine geniale und wenig kostspielige Lösung, um sich immer die neuesten Sets zu besorgen, ohne dabei die Insel verlassen zu müssen.');
INSERT INTO "item_descriptions" VALUES(976,'en','A distinctive feature of the Pumpkwin is that it prevents the dispersion of magic particles, making it a good magic insulator. That''s why some warriors use this vegetable as headgear.');
INSERT INTO "item_descriptions" VALUES(976,'fr','La citwouille a la particularité d''empêcher la dispersion des particules de magie, cela en fait un très bon isolant magique. C''est d''ailleurs pour cela que certains guerriers se servent de ce légume comme couvre-chef.');
INSERT INTO "item_descriptions" VALUES(976,'es','La calawaza tiene la particularidad de evitar la dispersión de partículas de magia, esto hace de ella un buen aislante mágico. Por eso algunos guerreros utilizan esta legumbre como sombrero.');
INSERT INTO "item_descriptions" VALUES(976,'pt','Uma característica distintiva do Olantewn é que previne a dispersão de partículas mágicas, o que faz dele, portanto, um bom isolador mágico. É por isso que alguns guerreiros usam este legume como um elmo.');
INSERT INTO "item_descriptions" VALUES(976,'de','Ein Küwbiss hat die eigentümliche Eigenschaft, magische Partikel zu zerstreuen und abzulenken. Daher ist er auch ein guter magischer Isolator. Vielleicht tragen deswegen manche Krieger dieses Gemüse auf ihrem Kopf mit sich herum, wer weiß.');
INSERT INTO "item_descriptions" VALUES(1019,'en','Wearing this hat creates a very special look, halfway between ridiculous and comical.');
INSERT INTO "item_descriptions" VALUES(1019,'fr','Porter ce casque signifie adopter une apparence unique... À mi-chemin entre le ridicule et le comique.');
INSERT INTO "item_descriptions" VALUES(1019,'es','Llevar este casco significa adoptar un look único... A medio camino entre lo cómico y lo ridículo.');
INSERT INTO "item_descriptions" VALUES(1019,'pt','Com este capacete, você terá uma aparência muito especial, estará na metade do caminho entre ser ridículo e cômico.');
INSERT INTO "item_descriptions" VALUES(1019,'de','Mit diesem Fliegerhelm auf dem Kopf seht ihr wirklich einzigartig aus... auf halbem Wege zwischen "einfach nur lächerlich" und "zum Totlachen".');
INSERT INTO "item_descriptions" VALUES(1021,'en','For those who have always dreamt of flying like a Kwak, go back to bed because these wings will turn you into a public menace and an idiot.');
INSERT INTO "item_descriptions" VALUES(1021,'fr','Pour ceux qui ont toujours rêvé de voler comme un Kwak, allez vous recoucher, car ces ailes ne feront de vous qu''un danger public doublé d''un idiot.');
INSERT INTO "item_descriptions" VALUES(1021,'es','Quienes hayan soñado desde siempre con poder volar como un kwak, pueden regresar a sus quehaceres porque estas alas solamente les convertirán en un peligro público y encima estúpido.');
INSERT INTO "item_descriptions" VALUES(1021,'pt','Para as pessoas que sempre sonharam em voar como um Kwak, voltem para a cama porque estas asas os transformarão numa ameaça pública e em idiotas.');
INSERT INTO "item_descriptions" VALUES(1021,'de','All diejenigen, die schon immer davon geträumt haben wie ein Kwack durch die Lüfte zu segeln – hört endlich auf zu träumen! Denn diese lächerlichen Holzflügel machen aus euch nur eine Gefahr für die Allgemeinheit sowie euch zum Gespött derselben.');
INSERT INTO "item_descriptions" VALUES(1027,'en','One day, the infamously crazy T. Bun Stek found two strange yet impressive knives... No one could figure out what they were for. He used the very same knives to sacrifice half his livestock to the Gods and soon after they bellowed the answer from the heave''s. He was slaughtering a particularly noisy cow at that very moment... The poor guy didn''t hear a word.');
INSERT INTO "item_descriptions" VALUES(1027,'fr','L''illustre fou Stek Dardar aurait commandé ces couteaux étranges et redoutables. Nul n''en connaissait l''utilité jusqu''à ce qu''il tente d''offrir à manger à son dieu.');
INSERT INTO "item_descriptions" VALUES(1027,'es','El ilustre loco Stek Rokefor encargó hacer estos extraños y temibles cuchillos. Nadie sabía para qué servían hasta que intentó regalar comida a su dios.');
INSERT INTO "item_descriptions" VALUES(1027,'pt','Estas facas estranhas e terríveis pertenceram ao famoso e louco Stek Dardar. Seu uso era um mistério para todos até que ele ofereceu comida ao seu deus.');
INSERT INTO "item_descriptions" VALUES(1027,'de','Der verrückte Erfinder Stek Dardar soll diese seltsamen und äußerst gefährlichen Messer bestellt haben. Niemand wußte wozu, bis er eines Tages seinem Gott einen riesigen Haufen blutigen Fleisches opferte.');
INSERT INTO "item_descriptions" VALUES(1030,'en','This pair of daggers is in fact a magic game. Designed to entertain young Ecaflips, it was taken off the market when a visiting Sram decided to join. She was only a child... Shame on you... shame on us all.');
INSERT INTO "item_descriptions" VALUES(1030,'fr','Cette paire de dagues est en fait un jouet magique. Créé pour amuser les jeunes Ecaflips, sa production fut interdite après qu''un enfant adepte de Sram prit part au jeu.');
INSERT INTO "item_descriptions" VALUES(1030,'es','Este par de dagas es en realidad un magnífico juguete. Ha sido creado para los jóvenes zurcaráks, su producción ha sido prohibida cuando un niño adepto de Sram se puso a jugar con ellos.');
INSERT INTO "item_descriptions" VALUES(1030,'pt','Este par de adagas na verdade é um jogo mágico. Criado para entreter jovens discípulos de Ecaflip, ele foi banido quando uma criança seguidora de Sram participou do jogo.');
INSERT INTO "item_descriptions" VALUES(1030,'de','Dieses Paar Dolche ist in Wirklichkeit ein magisches Spielzeug, welches ursprünglich für junge Ecaflips gedacht war. Nachdem jedoch einmal der Sohn eines Sram-Anhängers mitspielte, wurden die dreißigschwänzigen Katzendolche allerdings schnell wieder verboten.');
INSERT INTO "item_descriptions" VALUES(1031,'en','These magnificent daggers once belonged to the cruellest Sramette Amakna ever saw. Well, one of the most cruel. Actually, she was just a tiny bit more cruel than the others. No, I''m exaggerating there. She wasn''t quite as cruel as the others. That''s still quite an achievement though.');
INSERT INTO "item_descriptions" VALUES(1031,'fr','Ces magnifiques dagues auraient appartenu à la Sramette la plus cruelle qu''Amakna ait connu. Enfin, l''une des plus cruelles... En fait, juste un peu plus que les autres, enfin au moins autant que les autres, ce qui est déjà pas mal !');
INSERT INTO "item_descriptions" VALUES(1031,'es','Estas magníficas dagas pertenecieron a la sramita más cruel que Amakna haya conocido. Bueno, una de las más crueles... En realidad solo lo era un poco más que las demás, vamos o por lo menos tanto como las demás, lo cual ya es bastante.');
INSERT INTO "item_descriptions" VALUES(1031,'pt','Estas magníficas adagas pertenceram à Sramette mais cruel que Amakna já viu... Na verdade, ela era apenas um pouco mais cruel que os outros, se não, pelo menos tão cruel quanto os outros, o que já é muito bom!');
INSERT INTO "item_descriptions" VALUES(1031,'de','Diese fein gearbeiteten Dolche sollen einmal der grausamsten Sram von ganz Amakna gehört haben. Jedenfalls einer der Grausamsten... Naja, ein wenig grausamer als alle anderen oder zumindest genauso grausam wie sie, was bereits nicht schlecht ist.');
INSERT INTO "item_descriptions" VALUES(1033,'en','This dagger was originally used by the secret brotherhood of Rowler. This guild wanted to plunge Amakna into chaos. They finally disappeared when the island where they hid and schemed was submerged by the waves.');
INSERT INTO "item_descriptions" VALUES(1033,'fr','Cette dague était utilisée autrefois par la confrérie secrète de Fon. Cette guilde voulait plonger Amakna dans le chaos. Finalement, elle coula en premier quand l''île qui les cachait fut submergée par les flots.');
INSERT INTO "item_descriptions" VALUES(1033,'es','Esta daga la utilizaban antaño los hermanos de la cofradía secrete de Fon Taneda. Este gremio quería hundir a Amakna en el caos total. Al final, fue la cofradía la que se hundió primero cuando la isla en la que se oscultaban fue barrida del mapa por un tsunami.');
INSERT INTO "item_descriptions" VALUES(1033,'pt','Esta adaga foi originalmente usada pela irmandade secreta de Fon. Esta guilda queria mergulhar Amakna em um estado de caos. A Irmandade de Fon finalmente desapareceu quando a ilha em que eles se escondiam submergiu pelas ondas.');
INSERT INTO "item_descriptions" VALUES(1033,'de','Dieser Dolch wurde einst vom geheimen Orden Unta deMer gebraucht. Man sagt, dieser Orden habe beabsichtigt, Amakna ins Chaos zu stürzen. Doch seit dem Zeitpunkt, an dem angeblich Teile Sufokias untergingen, ward keiner mehr von ihnen gesehen.');
INSERT INTO "item_descriptions" VALUES(1039,'en','These Sram daggers are beguilingly shaped, leading one to wonder whether they''re daggers at all. When the piercing truth is revealed, it is often too late.');
INSERT INTO "item_descriptions" VALUES(1039,'fr','Cette dague Sram possède une forme particulièrement fourbe. Tellement fourbe qu''on se demande si c''est vraiment une dague. Lorsque la réponse vient, il est souvent trop tard...');
INSERT INTO "item_descriptions" VALUES(1039,'es','Esta daga sram tiene una forma particularmente engañadora. Tan engañadora que uno puede preguntarse si realmente se trata de una daga. Y cuando se consigue la respuesta, suele ser demasiado tarde.');
INSERT INTO "item_descriptions" VALUES(1039,'pt','Esta adaga Sram tem uma forma enganadora, as pessoas se perguntarão se é realmente uma adaga. Quando encontrarem a resposta, será tarde demais...');
INSERT INTO "item_descriptions" VALUES(1039,'de','Dieser Sramdolch besitzt bereits ein schurkenhaftes Aussehen. Sogar dermaßen beschurkt, dass man sich die berechtigte Frage stellen kann, ob es sich dabei überhaupt noch um einen Dolch handelt. Bis man die Antwort gefunden hat, ist es jedoch oft schon zu spät.');
INSERT INTO "item_descriptions" VALUES(1040,'en','Ortimus Contrari is a legendary assassin. If I told you how he carried out his contracts... you''d want to kill yourself even before he got to you.');
INSERT INTO "item_descriptions" VALUES(1040,'fr','Ortimus Contrari est une légende parmi les assassins. Il exécute toujours ses contrats d''une manière totalement opposée aux méthodes traditionnelles. N''en demandez pas plus, vous pourriez mourir dans l''instant.');
INSERT INTO "item_descriptions" VALUES(1040,'es','Ortimus Contrari es una leyenda que los asesinos suelen contar entre ellos. Dicen que Ortimus cumple con sus contratos de una forma totalmente opuesta a los métodos tradicionales. No pidas más explicaciones, podrías morirte al instante.');
INSERT INTO "item_descriptions" VALUES(1040,'pt','Ortimus Contrari é um infiltrado lendário. O modo que ele executava seus contratos era completamente oposto aos métodos tradicionais. Nem tente saber mais sobre isto, você se arrependeria no mesmo instante...');
INSERT INTO "item_descriptions" VALUES(1040,'de','Ortimus Contrari ist selbst unter Meuchelmördern eine Legende. Denn Insider wissen, dass er seine Aufträge stets auf eine Art und Weise erledigt, die sich grundlegend von den traditionellen Methoden unterscheidet. Mehr solltet ihr zu eurer eigenen Sicherheit darüber jedoch nicht wissen, da ihr sonst sofort sterben müsstet!');
INSERT INTO "item_descriptions" VALUES(1041,'en','The legends tell of a famous Iop who left his island home and travelled across the sea to find work as an interpreter for the Kings of Amakna. He took to the job full of hope, enthusiasm and diligence, dazzling Ecaflips and Fecas alike with his vibrant wordplay and passion for good grammar. Unfortunately, on his way to the castle, he stumbled over a rock that turned out to be a Mega Crackler, and this broken sword was the only trace they found of him, or his equipment.');
INSERT INTO "item_descriptions" VALUES(1041,'fr','Cette épée fut donnée à Souzé Schel, un jeune Iop, lors de son adoubement. Malheureusement, lors de sa première mission de chevalier, il glissa sur une pierre qui se trouvait être un craqueleur...');
INSERT INTO "item_descriptions" VALUES(1041,'es','Esta espada ha sido un regalo para la armadura de gala de un joven yopuka llamado Bajo Skalera. Desafortunadamente, durante su primera misión como caballero, resbaló sobre una piedra. En realidad, aquella piedra era el dedo meñique del pie de un crujidor...');
INSERT INTO "item_descriptions" VALUES(1041,'pt','Um jovem seguidor de lop, Souze Schel, recebeu essa espada para seu treino. Infelizmente, durante sua primeira missão, ele tropeçou em uma pedra que, na verdade, era um crackler...');
INSERT INTO "item_descriptions" VALUES(1041,'de','Dieses Schwert wurde dem jungen Iop Blackcat zu seinem Ritterschlag verliehen. Leider stürzte dieser gleich bei seiner ersten Mission als Ritter und zerschmetterte sein Schwert. Er hatte nämlich einen Krachler für einen harmlosen Stein gehalten.');
INSERT INTO "item_descriptions" VALUES(1043,'en','This shovel is made of a very rare wood. According to the legend, young girls fall into an eternal sleep when they touch this weapon. Note that in case of repeated contact, valiant heroes can also be affected.');
INSERT INTO "item_descriptions" VALUES(1043,'fr','Cette pelle est faite d''un bois très rare. Selon la légende, toute jeune fille au contact de cette pelle tombera dans un sommeil éternel. Notez bien qu''en cas de contacts répétés, l''effet est applicable à n''importe qui.');
INSERT INTO "item_descriptions" VALUES(1043,'es','Esta pala está hecha con una madera muy rara. Según la leyenda, cualquier joven muchacha que roce esta pala con sus cabellos, entrará en un sueño eterno. Téngase en cuenta de que en caso de contactos repetidos, los efectos se aplican a cualquiera.');
INSERT INTO "item_descriptions" VALUES(1043,'pt','Esta pá é feita de um tipo de madeira muito raro. De acordo com a lenda, jovens meninas caíram em profundo sono no toque desta pá. Note que no caso de repetidos contatos, corajosos heróis podem também ser afetados.');
INSERT INTO "item_descriptions" VALUES(1043,'de','Diese Schaufel besteht aus einem sehr seltenen Dornenholz. Einer Legende nach soll jede junge Frau beim bloßen Berühren dieser Schaufel in einen ewig andauernden Schlaf fallen. Was hingegen nicht in der Legende erwähnt wird, ist das *gähn*... jeder andere auch *gähn*... bei *gähn*... längerem Kontakt... zzzZZZzzz.');
INSERT INTO "item_descriptions" VALUES(1047,'en','What can be better than an eco-friendly shovel to clear your garden of weeds? This shovel is THE best way of getting rid of daisies. It''s also great to feed them to your enemies.');
INSERT INTO "item_descriptions" VALUES(1047,'fr','Quoi de mieux qu''une pelle écologique pour mettre un terme aux mauvaises herbes ? Cette pelle est LA réponse, avec elle vous pourrez aisément arracher des pissenlits et les faire manger à vos ennemis, en commençant par la racine !');
INSERT INTO "item_descriptions" VALUES(1047,'es','Esta pala está enredaderada ¿Quién la desenredaderará? El buen desenredaderador que la desenredadere buen desenredaderador será... Además, con ella ¡podrás eliminar las malas hierbas!');
INSERT INTO "item_descriptions" VALUES(1047,'pt','O que pode ser melhor que uma pá ecológica para se livrar de ervas daninhas? Esta pá é A solução para arrancar margaridas e fazer seus inimigos comê-las.');
INSERT INTO "item_descriptions" VALUES(1047,'de','Die Mischmaschschaufel ist DIE Lösung für all eure kleinen Gärtnereiproblemchen. Mit ihr könnt ihr sämtliche Radieschen aus dem Garten ausbuddeln und stolz euren Gegnern zeigen, und zwar mit der Wurzel voraus!');
INSERT INTO "item_descriptions" VALUES(1053,'en','The Woukuis family forged this shovel during the war between the Elle-Poma and the Touge-Woukuis. The one problem is that it covers your hands with grease. It''s also very popular with unmarried warriors who spend a lot of time alone. Dunno why.');
INSERT INTO "item_descriptions" VALUES(1053,'fr','Cette pelle fut créée et utilisée par la famille Woukuis dans la guerre intestine entre les groupes Elle-Poma et Touge-Woukuis, concurrents directs d''exportation de tofus grillés. C''est une arme redoutable, son seul défaut est de rendre les mains grasses.');
INSERT INTO "item_descriptions" VALUES(1053,'es','Esta pala ha sido creada y utilizada por la familia Wukis durante la guerra intestina que hubo entre los grupos Ukis y Dukis, competidores directos de exportación de tofus asados. Es un arma temible, su único defecto es que te deja las manos grasientas.');
INSERT INTO "item_descriptions" VALUES(1053,'pt','A família Woukuis forjou e usou esta pá durante a guerra infame entre dois grupos – Elle-Poma e Touge-Woukuis –, que competiam pela exportação de tofus grelhados. É uma arma temível e só tem uma desvantagem – ela cobre as mãos de graxa.');
INSERT INTO "item_descriptions" VALUES(1053,'de','Diese Schaufel wurde vom Familienbetrieb "Wookil Ltd." im Laufe des internen Kleinkrieges zwischen den Gruppierungen der G-Stanck Wookil Ltd. und den A-Stanck Schwarzbrader entwickelt, deren langjährige Fehde auf einen Streit an den Rechten zum Export von gegrillten Tofus zurückgeht. Es ist eine sehr gefährliche Waffe. Ihr einziger Nachteil sind die ewig fettigen Hände bei ihrem Gebrauch.');
INSERT INTO "item_descriptions" VALUES(1054,'en','Half trowel and half shovel, the Trovel went out of fashion with builders and was remarketed as a weapon. Easy to handle and to put away thanks to its size, it''s the ideal accessory for any Enutrof that''s fond of a drink.');
INSERT INTO "item_descriptions" VALUES(1054,'fr','Croisement entre une pelle et une truelle, la pelle-truelle perdit son caractère utile pour devenir une arme incontournable. Rapide à manier et à ranger grâce à sa petite taille, c''est l''accessoire idéal de tout Enutrof aimant l''alcool.');
INSERT INTO "item_descriptions" VALUES(1054,'es','Esta herramienta es un cruce entre una pala y una paleta, la Pala Paleta perdió su carácter útil para convertirse en un arma famosísima. Se maneja con rapidez y se puede guardar  fácilmente gracias a su pequeño tamaño, es el accesorio ideal de cualquier anutrof al que le guste el alcohol.');
INSERT INTO "item_descriptions" VALUES(1054,'pt','Uma mistura de uma espátula e uma pá, a pá-espátula perdeu suas características úteis para se tornar uma arma indispensável. Fácil de manejar e guardar graças ao seu tamanho, é o acessório ideal para qualquer seguidor de Enutrof que é fã de álcool.');
INSERT INTO "item_descriptions" VALUES(1054,'de','Ursprünglich diente diese Kreuzung aus Schaufel und Maurerkelle als praktisches Multifunktionswerkzeug beim Bau von neuen Gebäuden. Doch dies änderte sich schnell, als sie Kill-Schrill in die Hände fiel. Dank ihrer geringen Größe und hervorrangenden Handlichkeit ist es eine perfekte und sehr überraschende Mordwaffe. Zumindest für einen ständig zugedröhnten Enutrof mit Nervenzuckungen.');
INSERT INTO "item_descriptions" VALUES(1056,'en','These ghastly shovels are hand-crafted by the islanders of Koutoulou who use whatever materials come to hand to make them. Useless for digging holes, their main purpose is to ward off imaginary spirits and naughty children.');
INSERT INTO "item_descriptions" VALUES(1056,'fr','Les habitants de l''île Koutoulou fabriquent artisanalement ces pelles affreuses avec du bric et du broc (surtout du broc). Pitoyables pour creuser, elles sont uniquement destinées à faire peur aux esprits et aux enfants pas assez sages.');
INSERT INTO "item_descriptions" VALUES(1056,'es','Los habitantes de la isla Kutulú fabrican artesanalmente estas terribles palas con materias de aquí y de allí (pero sobre todo del allí). Malísimas para excavar, están hechas solamente para asustar a los espíritus y a los niños revoltosos.');
INSERT INTO "item_descriptions" VALUES(1056,'pt','Estas pás medonhas são feitas à mão pelos moradores da ilha que desprezam o trabalho manual. Inútil para cavar buracos, seu propósito principal é assustar espíritos e crianças desobedientes.');
INSERT INTO "item_descriptions" VALUES(1056,'de','Die Einwohner der Insel Kuhdungluh pflegen schon seit langer Zeit das Handwerk, diese häßlichen Schaufeln aus Schnicks und Schnacks (besonders aus Schnacks) herzustellen. Sie taugen absolut nicht zum Graben, sollen aber angeblich lebensnotwendig auf dieser Insel sein. Vermutlich wieder einmal nur, um Geistern und unartigen Kindern Angst einzujagen.');
INSERT INTO "item_descriptions" VALUES(1059,'en','This shovel is much favoured by the potato farmers of the region. It can be used for all kinds of crops however.');
INSERT INTO "item_descriptions" VALUES(1059,'fr','Cette pelle est la petite favorite des cultivateurs de champs, surtout de pomme de tewe. Rien ne vous empêche cependant de retourner d''autres types de patate avec.');
INSERT INTO "item_descriptions" VALUES(1059,'es','Esta pala es la preferida de los agricultores, sobre todo de los cosechadores de patatas. 
Aunque nada te impide usarla para desnucar a tus enemigos.');
INSERT INTO "item_descriptions" VALUES(1059,'pt','É a pá favorita dos fazendeiros, e especialmente de fazendeiros cultivadores de batata. Mas você pode usá-la para outros tipos de cultivo também.');
INSERT INTO "item_descriptions" VALUES(1059,'de','Diese Schaufel ist der Liebling aller Gärtner und Bauern. Sie ist beispielsweise hervorragend dazu geeignet, Kartoffeln auszugraben. Doch nichts hindert euch daran, damit auch Radieschen auszugraben und sie euren Gegner stolz mit der Wurzel voran zu präsentieren.');
INSERT INTO "item_descriptions" VALUES(1061,'en','A weapon created by Dha, this aerodynamic mace hurts the very air as it cleaves through and splits your enemies skulls open... Are you convinced yet?');
INSERT INTO "item_descriptions" VALUES(1061,'fr','Une des armes fétiches créées par Ha. Cette masse, à l''aérodynamisme calculé, fend deux fois plus vite l''air, et donc deux fois plus vite les crânes. Au moins deux bonnes raisons pour posséder cette arme.');
INSERT INTO "item_descriptions" VALUES(1061,'es','Se trata de una de las armas predilectas creadas por Da. Esta maza, tiene una aerodinámica calculada y parte dos veces mejor el aire, por lo cual también parte dos veces más rápidamente los cráneos. Dos buenas razones para poseer esta arma.');
INSERT INTO "item_descriptions" VALUES(1061,'pt','Uma arma criada por Ha. Esta Maça, com uma forma aerodinâmica especial, é ideal para rachar os crânios de seus inimigos... Uma razão muito boa para possuir esta arma.');
INSERT INTO "item_descriptions" VALUES(1061,'de','Dies ist wieder einmal eine dieser hervorragend gearbeiteten Dualwaffen. Dieser Streitkolben mit dem perfekten Luftwiderstandsfaktor pflügt doppelt so schnell wie andere durch die Luft – und zerschmettert daher doppelt so schnell die Schädel der Gegner. Das sind mindestens zwei gute Gründe, diese Waffe zu besitzen.');
INSERT INTO "item_descriptions" VALUES(1065,'en','Rumour has it that this hammer is one of a kind, handmade by the ancient Xelor Smiths. Some people are convinced it is a copy, only carrying a convincing forgery of the Xelor rune... Go find out for yourself, hit someone over the head with it!');
INSERT INTO "item_descriptions" VALUES(1065,'fr','On dit que ce marteau est une pièce unique, car fabriqué de façon artisanale par d''anciens forgeurs Xelor. Certains racontent cependant qu''il s''agirait d''une lettre composant l''enseigne d''un forgeron. Testez-le donc sur une tête et faites votre choix.');
INSERT INTO "item_descriptions" VALUES(1065,'es','Dicen que este martillo es una pieza única porque ha sido fabricado de forma artesanal por los antiguos forjadores xelor. En cambio algunos cuentan que se trata de una de las letras del cartel publicitario de un herrero. Pruébalo sobre una cabeza y saca tus propias conclusiones.');
INSERT INTO "item_descriptions" VALUES(1065,'pt','Como os antigos ferreiros Xelor fizeram manualmente este martelo, as pessoas consideram uma peça única. Algumas pessoas consideram ser uma letra formando o sinal de uma ferraria. Tente bater na cabeça de alguém e veja você mesmo...');
INSERT INTO "item_descriptions" VALUES(1065,'de','Es wird diesem Hammer nachgesagt, er sei ein Unikat und nach altem Brauch von den Xélor-Schmieden erschaffen worden. Manche behaupten hingegen, es handele sich dabei gar nicht um einen Hammer, sondern um einen Buchstaben mit der Form des Stempels eines Schmiedes. Wenn ihr nun wissen wollt, wer Recht hat, dann probiert ihn doch einfach auf dem Schädel eines Gegners aus und trefft eure Entscheidung.');
INSERT INTO "item_descriptions" VALUES(1069,'en','Before being struck by lightning for the last time, the creator of this mace truly thought it would allow him forecast the weather. Much later, it was discovered that the tool was better at giving than taking blows.');
INSERT INTO "item_descriptions" VALUES(1069,'fr','Cette masse permet à son porteur de connaître le temps qu''il fera. Du moins, son inventeur le pensait-il avant de mourir foudroyé. On s''aperçut bien plus tard que cette masse était aussi habile à recevoir les coups qu''à les distribuer.');
INSERT INTO "item_descriptions" VALUES(1069,'es','Esta maza le permitió al gran Thuno hacerse con el corazón de su dulcinea llamada Damelklavel... se acercó a su balcón, trepó por las hiedras y le propinó un buen golpe en la cocorota. La leyenda no cuenta cómo hizo para sacarle el corazón... a veces es mejor no saber ciertas cosas.');
INSERT INTO "item_descriptions" VALUES(1069,'pt','Esta maça permite que você determine qual o clima na área. Isso era pelo menos o que o seu inventor pensou antes de ser atingido por um raio. Muitos anos depois, as pessoas entenderam que esta maça era uma arma poderosa, capaz de receber e também de distribuir.');
INSERT INTO "item_descriptions" VALUES(1069,'de','Dieser Streithammer ist besonders für die Zerschlagung von Sphären geeignet. Als zusätzlicher Effekt wird der Träger auch sehr wetterfühlig. Doch seinen Schöpfer konnte diese Eigenschaft nicht schützen; er wurde von einem Blitz erschlagen. Erst sehr viel später fand man heraus, dass der Hammer Schläge jeder Art und insbesondere Blitzschläge anzuziehen scheint.');
INSERT INTO "item_descriptions" VALUES(1073,'en','According to the legend, Outar Great Bwork ordered these fearsome hammers from a village of Xelors with the promise of sparing the townspeople if the hammers were well made. When he received the hammers, he destroyed the village. He needed to try his new weapons after all.');
INSERT INTO "item_descriptions" VALUES(1073,'fr','Outar Grand Bwork aurait commandé ces marteaux redoutables à un village Xélor contre un traité de paix: s''ils étaient efficaces, le village serait épargné. Quand les marteaux furent livrés, le village fut rasé. Après tout, il fallait bien les essayer !');
INSERT INTO "item_descriptions" VALUES(1073,'es','Dicen que el bwork King Lacadog ha encargado hacer estos temibles martillos a un pueblo xelor a cambio de un tratado de paz: si estos eran eficaces, el pueblo sería salvado. Cuando entregaron los martillos, el pueblo fue arrasado. Al fin de cuentas, ¡Había que probarlos!');
INSERT INTO "item_descriptions" VALUES(1073,'pt','De acordo com a lenda, o Grande Bwork de Outar enviou esses apavorantes martelos para uma vila de seguidores de Xelor, fazendo a promessa de que a vila deles iria sobreviver se os martelos fossem eficientes. Quando ele recebeu os martelos, ele destruiu a vila. Ele tinha que testar as suas novas armas apesar de tudo.');
INSERT INTO "item_descriptions" VALUES(1073,'de','Nüscht, der Großbwork, soll einer Legende nach einst die Anfertigung dieser gefürchteten Hämmer veranlaßt haben. Dabei stellte er einem ganzen Dorf der Xélor ein Ultimatum: Nur wenn sich diese Hämmer als wirkungsvoll herausstellen sollten, würde er das Dorf verschonen. Doch kaum wurden die Hämmer geliefert, wurde das Dorf dem Erdboden gleichgemacht. Woran sonst sollte der Großbwork schließlich die Wirksamkeit der Hämmer überprüfen?');
INSERT INTO "item_descriptions" VALUES(1075,'en','According to the legend, Outar Great Bwork ordered these fearsome hammers from a village of Xelors with the promise of sparing the townspeople if the hammers were well made. When he received the hammers, he destroyed the village. He needed to try his new weapons after all.');
INSERT INTO "item_descriptions" VALUES(1075,'fr','Outar Grand Bwork aurait commandé ces marteaux redoutables à un village Xélor contre un traité de paix: s''ils étaient efficaces, le village serait épargné. Quand les marteaux furent livrés, le village fut rasé. Après tout, il fallait bien les essayer !');
INSERT INTO "item_descriptions" VALUES(1075,'es','Dicen que el Bwork King Lacadog ha encargado hacer estos temibles martillos a un pueblo xelor a cambio de un tratado de paz: si estos eran eficaces, el pueblo sería salvado. Cuando entregaron los martillos, el pueblo fue arrasado. Al fin de cuentas, ¡Había que probarlos!');
INSERT INTO "item_descriptions" VALUES(1075,'pt','O grande Bwork Outar solicitou estes terríveis martelos à vila Xelor em troca de um tratado de paz. Se os martelos fossem eficientes, ele pouparia a vila. Quando os recebeu, a vila foi aniquilada. Bem, ele tinha de experimentar, não é?');
INSERT INTO "item_descriptions" VALUES(1075,'de','Nüscht, der Großbwork, soll einer Legende nach einst die Anfertigung dieser gefürchteten Hämmer veranlaßt haben. Dabei stellte er einem ganzen Dorf der Xélor ein Ultimatum: Nur wenn sich diese Hämmer als wirkungsvoll herausstellen sollten, würde er das Dorf verschonen. Doch kaum wurden die Hämmer geliefert, wurde das Dorf dem Erdboden gleichgemacht. Woran sonst sollte der Großbwork schließlich die Wirksamkeit der Hämmer überprüfen?');
INSERT INTO "item_descriptions" VALUES(1077,'en','This mace is the sole heritage left by the pacific Aj Taye tribe. Roll it on aching muscles and the pain will disappear. Big bullies will tell you it''s quite good at making pain appear as well.');
INSERT INTO "item_descriptions" VALUES(1077,'fr','Cette masse est l''héritage de l''ancienne tribu pacifique Aj Taye. Cela explique sa principale utilité : en la roulant sur les muscles endoloris la douleur disparaît. Les brutes épaisses vous diront qu''elle marche aussi très bien pour la faire apparaître.');
INSERT INTO "item_descriptions" VALUES(1077,'es','Esta maza es la herencia de la antigua tribu pacífica Getay. Eso explica su principal utilidad: haciéndola rodar sobre los músculos doloridos, el dolor desaparece. Incluso los más brutos te dirán que también puede hacerlo aparecer.');
INSERT INTO "item_descriptions" VALUES(1077,'pt','Esta maça é a herança deixada pela pacífica tribo Aj Taye. Role-a em músculos doloridos e a dor desaparecerá. Os brigões lhe dirão que ela também é muito efetiva para fazê-la aparecer.');
INSERT INTO "item_descriptions" VALUES(1077,'de','Die Spuren dieses Hammers lassen sich bis zum alten, friedlichen Stamm der Thays zurückführen. Man sagt, man hätte ihn benutzt, um ihn  über schmerzhafte Muskeln zu rollen, bis der Schmerz verschwindet. Doch die Barbaren der Neuzeit nutzen ihn genau umgekehrt. Sie schlagen lachend damit auf die Muskeln der Gegner ein, bis der Schmerz auftritt.');
INSERT INTO "item_descriptions" VALUES(1079,'en','This mace is the sole heritage left by the pacific Aj Taye tribe. Roll it on aching muscles and the pain will disappear. Big bullies will tell you it''s quite good at making pain appear as well.');
INSERT INTO "item_descriptions" VALUES(1079,'fr','Cette masse est l''héritage de l''ancienne tribu pacifique Aj Taye. Cela explique sa principale utilité : en la roulant sur les muscles endoloris la douleur disparaît. Les brutes épaisses vous diront qu''elle marche aussi très bien pour la faire apparaître.');
INSERT INTO "item_descriptions" VALUES(1079,'es','Esta maza es la herencia de la antigua tribu pacífica Getay. Eso explica su principal utilidad: haciéndola rodar sobre los músculos doloridos, el dolor desaparece. Incluso los más brutos te dirán que también puede hacerlo aparecer.');
INSERT INTO "item_descriptions" VALUES(1079,'pt','Esta maça é a herança deixada pela pacífica tribo Aj Taye. Passe ela em músculos dolorosos e a dor irá desaparecer. Grandes tiranos lhe dirão que ela também é eficiente para fazer a dor aparecer.');
INSERT INTO "item_descriptions" VALUES(1079,'de','Die Spuren dieses Hammers lassen sich bis zum alten, friedlichen Stamm der Thays zurückführen. Man sagt, man hätte ihn benutzt, um ihn  über schmerzhafte Muskeln zu rollen, bis der Schmerz verschwindet. Doch die Barbaren der Neuzeit nutzen ihn genau umgekehrt. Sie schlagen lachend damit auf die Muskeln der Gegner ein, bis der Schmerz auftritt.');
INSERT INTO "item_descriptions" VALUES(1083,'en','This hammer is so ridiculous that your enemy will laugh his head off. This should give you just enough time to beat it off with the very same hammer... Is that ironic?');
INSERT INTO "item_descriptions" VALUES(1083,'fr','Ce marteau est tellement ridicule que votre ennemi explosera de rire en vous voyant. Vous donnant juste assez de temps pour l''exploser vraiment.');
INSERT INTO "item_descriptions" VALUES(1083,'es','Este martillo es tan ridículo que tu enemigo se partirá de la risa al verte. Eso te dará tiempo suficiente para reventarle el cráneo.');
INSERT INTO "item_descriptions" VALUES(1083,'pt','Este martelo é tão ridículo que o seu oponente irá rir dele, dando-lhe tempo para matar ele!');
INSERT INTO "item_descriptions" VALUES(1083,'de','Dieser Hammer ist dermaßen lächerlich, dass sich euer Gegner bei seinem Anblick sofort kaputtlacht, während ihr ihn damit kaputtmacht.');
INSERT INTO "item_descriptions" VALUES(1084,'en','With this fearsome Hammer you will be able to prove the popular belief that muscles are more important than intelligence. This logic only works for people who are weaker than you, however. As we say ourselves... Strong is... never wrong.');
INSERT INTO "item_descriptions" VALUES(1084,'fr','Ce terrible marteau vous permettra enfin de prouver que les personnes pensant que le muscle prime sur le cerveau ont tort! (Ceci n''est valable uniquement sur des personnes moins fortes, les autres, n''oubliez pas, ont TOUJOURS raison)');
INSERT INTO "item_descriptions" VALUES(1084,'es','Como lo indica su nombre, este martillo ha pertenecido a un Xelor llamado Tohr... Se murió electrocutado por un rayo cuando intentaba utilizar su arma para cobijarse de la lluvia. Triste final...');
INSERT INTO "item_descriptions" VALUES(1084,'pt','Com este temível Martelo você poderá provar às pessoas que pensam que o músculo supera o cérebro que estão erradas. Isso não vale para pessoas fracas, de resto não esqueça que eles estão SEMPRE corretos.');
INSERT INTO "item_descriptions" VALUES(1084,'de','Dieser gewaltige Hammer wird euch helfen, alle Menschen, die denken, dass Stärke über Verstand siegt, eines Besseren zu belehren! (Hier das Kleingedruckte: Allerdings gilt dies nur für diejenigen, die schwächer sind als ihr. Stärkere haben bekanntlich IMMER Recht...)');
INSERT INTO "item_descriptions" VALUES(1085,'en','Falistos are Xelor demons. They betrayed their old principles and increased their strength by forging more and more powerful hammers. After spreading chaos across the land, they were defeated and banished underground. But some of the weapons they forged remained intact.');
INSERT INTO "item_descriptions" VALUES(1085,'fr','Les Falistos sont des démons Xélors. Ayant renié leurs anciens principes, ils ont développé leur force en forgeant des marteaux toujours plus puissants. Après avoir apporté le chaos, ils furent battus et bannis sous terre. Mais quelques armes subsistèrent.');
INSERT INTO "item_descriptions" VALUES(1085,'es','Los Falistos eran demonios Xelors. Rechazaron sus antiguos principios y desarrollaron su fuerza forjando martillos cada vez más potentes. Después de haber aportado el caos, fueron derrotados y exiliados bajo tierra. Pero algunas de sus armas siguen en circulación.');
INSERT INTO "item_descriptions" VALUES(1085,'pt','Falistos são demônios de Xelors. Eles traíram seus antigos princípios e desenvolveram sua força forjando martelos cada vez mais poderosos. Depois que eles trouxeram o caos, foram derrotados e banidos para o subterrâneo. Mas algumas das armas que eles forjaram permanecem intactas...');
INSERT INTO "item_descriptions" VALUES(1085,'de','Die Falistos sind außergewöhnliche Schmiede (die Qualität ihrer Hämmer ist dafür Beweis genug). Es handelt sich um ehemals dämonische Anhänger Xélors, die ihren Gott verlassen haben. Diese Tat hatte jedoch schwere Folgen: nämlich ihre ständige höllische Verspätung!');
INSERT INTO "item_descriptions" VALUES(1087,'en','This ring slightly increases intelligence.');
INSERT INTO "item_descriptions" VALUES(1087,'fr','Cet anneau permet d''augmenter légèrement l''intelligence de son porteur.');
INSERT INTO "item_descriptions" VALUES(1087,'es','Este anillo puede aumentar levemente la inteligencia de su dueño.');
INSERT INTO "item_descriptions" VALUES(1087,'pt','Graças a este anel, o nível de inteligência do portador é sensivelmente aumentado.');
INSERT INTO "item_descriptions" VALUES(1087,'de','Dieser Ring erhöht geringfügig die Intelligenz seines Trägers.');
INSERT INTO "item_descriptions" VALUES(1088,'en','This mask is the faithful replica, only a bit bigger, of the ones proudly worn by important Kanniballs.');
INSERT INTO "item_descriptions" VALUES(1088,'fr','Ce masque est la réplique exacte, en un peu plus grand, de ceux que portent fièrement les Kannibouls importants.');
INSERT INTO "item_descriptions" VALUES(1088,'es','Esta máscara es la réplica exacta, un poco más grande, de las que llevan con orgullo los kaníbolas importantes.');
INSERT INTO "item_descriptions" VALUES(1088,'pt','Esta máscara é uma réplica fiel, só um pouco maior que a máscara que orgulhosamente pertenceu a Kanniballs importantes.');
INSERT INTO "item_descriptions" VALUES(1088,'de','Diese Maske ist eine exakte, nur leicht vergrößerte Imitation der Masken, die stolz von den wichtigen Kannibällen getragen werden.');
INSERT INTO "item_descriptions" VALUES(1093,'en','This bow is specifically designed to hunt birds. Light and easy to handle, you''ll be able to sneak up on an eagle.');
INSERT INTO "item_descriptions" VALUES(1093,'fr','Cet arc est spécialement conçu pour chasser les oiseaux. Léger et facile à manier, il vous permettra de voler dans les plumes de n''importe qui ou presque.');
INSERT INTO "item_descriptions" VALUES(1093,'es','Este arco fue especialmente diseñado para cazar pájaros. Ligero y de uso sencillo, te permitirá cazar un pájaro con dos tiros, o algo así...');
INSERT INTO "item_descriptions" VALUES(1093,'pt','Este arco é especialmente projetado para caçar pássaros. Leve e fácil de manejar, será possível para você atacar quase qualquer um.');
INSERT INTO "item_descriptions" VALUES(1093,'de','Dieser Bogen wurde speziell entworfen, um Vögel zu jagen. Er ist so leicht und einfach zu bedienen, dass damit all eure Feinde bald Federn lassen müssen.');
INSERT INTO "item_descriptions" VALUES(1097,'en','"With a Gobball, no waste at all!" Such was the motto of a visionary shopkeeper who specialised in recycling gobball carcasses. This bow is one of his finest products – not for aesthetic reasons, but simply because it''s a fearsome weapon.');
INSERT INTO "item_descriptions" VALUES(1097,'fr','"Avec un Bouftou, on peut faire tout !" tel était le slogan d''un marchand dont la spécialité était le recyclage de Bouftou. Cet arc est l''un de ses produits, pas très esthétique, il n''en est pas moins redoutable.');
INSERT INTO "item_descriptions" VALUES(1097,'es','«¡Con un jalató, puedes hacerlo tó!». Este era el eslogan de un comerciante del sur cuya especialidad consistía en reciclar jalatós. Aunque no sea muy estético, no deja de ser un arma temible.');
INSERT INTO "item_descriptions" VALUES(1097,'pt','"Com um Papatudo, dá para fazer tudo!" era o slogan de um mercador especializado em reciclagem de Papatudo. Este arco é um dos seus melhores produtos, não por razões estéticas, mas por ser uma arma perigosa.');
INSERT INTO "item_descriptions" VALUES(1097,'de','„Mit einem Fresssack kann man alles machen!“ – So lautete der Slogan eines Händlers, dessen Spezialität die Wiederverwertung von Fresssäcken war. Dieser Bogen ist eines seiner Produkte. Nicht sehr ästhetisch, aber trotzdem furchterregend.');
INSERT INTO "item_descriptions" VALUES(1102,'en','The Eniripsa Mie Dopan made this series of sharpened wands to fight against the rising level of burglaries in the area. It can travel through time and nip any aggression in the bud. They often appear in hospitals, disguised as nurses asking stuff like, ''Have you seen so and so... well, he hasn''t been born yet. Yeah a real nasty character.''');
INSERT INTO "item_descriptions" VALUES(1102,'fr','L''eniripsa Mie Dopan confectionna cette série de baguettes piquantes pour lutter contre les vols. Capable en théorie de remonter le temps pour empêcher une agression, elle finit généralement dans l''oeil d''un démon.');
INSERT INTO "item_descriptions" VALUES(1102,'es','La aniripsa Migadepan confeccionó esta serie de varitas punzantes para luchar contra los robos. En teoría es capaz de remontar el tiempo para impedir una agresión, en general acaba plantándose en el ojo de algún demonio.');
INSERT INTO "item_descriptions" VALUES(1102,'pt','O Eniripsa Mie Dopan fez uma série de varinhas pontiagudas para roubar na luta. Na teoria, este tipo de varinha deve voltar a tempo de evitar qualquer agressão, mas geralmente termina no olho de um demônio.');
INSERT INTO "item_descriptions" VALUES(1102,'de','Der Eniripsa Mie Däpan fertigte eine ganze Reihe dieser spitzen Stäbe an, um gegen Diebstähle vorzugehen. Theroretisch sollen die Stäbe die Macht haben, in der Zeit zurückzureisen, um Überfälle zu verhindern. Doch in der Praxis landeten sie alle im Auge eines mächtigen und mächtig darüber erbosten Dämonen.');
INSERT INTO "item_descriptions" VALUES(1107,'en','This heavy Wand shattered more than one soul''s skull. Iop priests use it to send repentant sinners to heaven with a bang.');
INSERT INTO "item_descriptions" VALUES(1107,'fr','Cette lourde baguette a fracassé plus d''un crâne de pécheur. Les prêtres Iop l''utilisant pour absoudre radicalement et définitivement un repenti.');
INSERT INTO "item_descriptions" VALUES(1107,'es','Esta pesada varita ha destrozado más de un cráneo de pecador. Los sacerdotes yopukas la utilizan para absolver radical y definitivamente a los arrepentidos.');
INSERT INTO "item_descriptions" VALUES(1107,'pt','Esta pesada varinha mágica quebrou mais que crânio do pescador. Os padres de Iop a usam para converter as pessoas definitivamente.');
INSERT INTO "item_descriptions" VALUES(1107,'de','Dieser schwere Stab hat bereits mehr als nur einen Sünderschädel zertrümmert. Es waren nämlich Iop-Priester, die sich seiner bedienten, um auf radikale und endgültige Weise Reuigen die Absolution zu erteilen.');
INSERT INTO "item_descriptions" VALUES(1110,'en','This staff is a replica of a legendary artefact, but with slightly lesser powers. It sends out light if it falls on the ground and it can distort your voice to any pitch you desire. The latter feature is useful for luring enemies into mortal traps... just don''t try to kill them with it when they fall for your trick.');
INSERT INTO "item_descriptions" VALUES(1110,'fr','Ce bâton est la réplique d''un artefact légendaire, un peu de pouvoir en moins. Capable d''émettre de la lumière lors d''un choc sur le sol (Oh!), de déformer un peu votre voix (Wah!), il vous fera passer pour ce que vous n''êtes pas : un grand mage.');
INSERT INTO "item_descriptions" VALUES(1110,'es','Este bastón es una réplica de un artefacto legendario, pero sin su poder. Era capaz de emitir una luz cuando chocaba contra el suelo (¡Oh!) y de deformar un poco tu voz (¡Wah!), te hará pasar por lo que no eres: un gran mago.');
INSERT INTO "item_descriptions" VALUES(1110,'pt','Este cajado é uma cópia de um artefato lendário com menos poder. Ele pode produzir relâmpagos com um simples impacto no chão (Oh!) ou distorcer a sua voz (Wah!) e, então, você poderá ser confundido com alguém que você não é: um grande mago.');
INSERT INTO "item_descriptions" VALUES(1110,'de','Dieser Stock ist ein genaues Duplikat eines legendären Artefaktes, nur etwas weniger mächtig. Doch da er bei einem Schlag auf den Boden waberndes Licht produziert (Oh!) und die Stimme seines Trägers verändert (Wah!), wird er allen anderen etwas vorgaukeln, was gar nicht stimmt: Nämlich dass ihr ein großer Magier seid.');
INSERT INTO "item_descriptions" VALUES(1116,'en','A type of bow only made in the far North of Amakna, the I Kea Bow is a cheap, conveniently flat-packed weapon. Its effectiveness will strongly depend on the owner''s ability to follow poorly translated instruction manuals.');
INSERT INTO "item_descriptions" VALUES(1116,'fr','Type d''arc fabriqué seulement dans le grand nord d''Amakna, le Kéha est un arc peu cher, à monter soi-même. Ses performances dépendent ainsi fortement de la maîtrise de l''assembleur.');
INSERT INTO "item_descriptions" VALUES(1116,'es','Se trata de un arco fabricado únicamente en el gran norte de Amakna, el Diquea es un poco caro y debes montarlo tú solo, por lo cual su calidad depende mucho de tu propia habilidad en materia de bricolaje.');
INSERT INTO "item_descriptions" VALUES(1116,'pt','Um tipo de arco feito somente no extremo Norte de Amakna, o Kea é barato e já vem pronto para montar. Seus talentos dependerão fortemente da habilidade do possuidor para montá-lo corretamente.');
INSERT INTO "item_descriptions" VALUES(1116,'de','Dieses Sondermodell eines Bogens, welches es nur im hohen Norden Amaknas zu kaufen gibt, ist spottbillig. Allerdings muss man es auch selbst zusammenbauen, so dass das Endergebnis stark von der Kompetenz des Bastlers abhängt.');
INSERT INTO "item_descriptions" VALUES(1118,'en','The instructions for the making of this 100% biodegradable bow have been found in the ruins of Din by an adventurer apparently renowned for his mastery of the whip. I never trusted those Greenies... Many die each year in passionate and misguided embraces with sleeping Treechnids.');
INSERT INTO "item_descriptions" VALUES(1118,'fr','Le plan de fabrication de cet arc 100% biodégradable fut retrouvé au fond des ruines de Din par un aventurier apparemment célèbre pour son fouet. Rien ne dit s''il a troqué sa vieille babiole claquante contre ce magnifique arc.');
INSERT INTO "item_descriptions" VALUES(1118,'es','El esquema de fabricación de este arco 100% reciclable ha sido hallado en las ruinas de Din por un aventurero aparentemente famoso por su manejo del látigo. Nada indica que haya cambiado su vieja tralla de cuero por este magnífico arco.');
INSERT INTO "item_descriptions" VALUES(1118,'pt','As instruções para a fabricação deste arco 100% biodegradável foram encontradas nas ruínas de Din por um aventureiro aparentemente conhecido por seu chicote. A propósito, não sabemos se ele trocou sua extraordinária e velha bugiganga por este maravilhoso arco.');
INSERT INTO "item_descriptions" VALUES(1118,'de','Der Bauplan dieses uralten Bogens wurde in den Tiefen der Ruinen von Din von einem Abenteurer gefunden, der wegen seiner Peitsche gefürchtet war. Es ist allerdings nicht bekannt, ob die Gerüchte wahr sind, er habe sein altes, krachmachendes Lederding gegen diesen wunderschönen, biologisch abbaubaren Bogen eingetauscht.');
INSERT INTO "item_descriptions" VALUES(1122,'en','Take an old worn bow, dust it with magical cure, ask a dragon to blow on it and you''ll have an enchanted bow. Be careful however, theorising with fairy recipes is all very well, but in practice, dragons take a malicious pleasure in blowing on everything but the bow.');
INSERT INTO "item_descriptions" VALUES(1122,'fr','Prenez un vieil arc usé, saupoudrez-le de poudre de perlinpinpin, demandez à un dragon de souffler sur le tout et vous obtenez un arc enchanteur. Cette recette de conte ne marche pas vraiment, les dragons visant étrangement toujours à coté.');
INSERT INTO "item_descriptions" VALUES(1122,'es','Toma un viejo arco usado, échale polvo de arena mágica, pídele a un dragón que sople encima y conseguirás este arco encantador. En realidad, esta receta de cuento de hadas no funciona, los dragones tienen muy mala puntería al soplar...');
INSERT INTO "item_descriptions" VALUES(1122,'pt','Pegue um velho arco usado, borrife-o com cura mágica, peça a umDragão para soprar nele e você terá um arco encantado. Entretanto, tenha cuidado, pois teorizar é muito fácil no que diz respeito a contos de fada, mas, na prática, Dragões têm uma maliciosa satisfação em soprar onde querem, exceto no arco.');
INSERT INTO "item_descriptions" VALUES(1122,'de','Nehmen Sie einen alten, gebrauchten Bogen, streuen Sie etwas Wunderpulver darauf und bittet einen Drachen, seinen Odem darauf zu hauchen. Sie erhalten dann einen verzauberten Bogen. Doch dieses märchenhafte Rezept funktioniert leider nicht wirklich... Drachen zielen nämlich immer daneben.');
INSERT INTO "item_descriptions" VALUES(1128,'en','This unconventional bow has been created for the self-proclaimed king of a village of lowly peasants, who liked to show off by shooting two arrows at once.');
INSERT INTO "item_descriptions" VALUES(1128,'fr','Cet arc peu conventionnel fut conçu spécialement pour le roi auto proclamé d''un village de paysans, qui adorait se faire remarquer en tirant deux flèches simultanément.');
INSERT INTO "item_descriptions" VALUES(1128,'es','Este arco poco convencional fue especialmente diseñado por el autoproclamado rey de un pueblo de campesinos. A este rey le encantaba hacerse el graciosillo disparando dos flechas a la vez.');
INSERT INTO "item_descriptions" VALUES(1128,'pt','Este arco é bastante incomum, e foi criado para o rei ser proclamado na aldeia dos fazendeiros que o adoraram por atirar duas flechas ao mesmo tempo.');
INSERT INTO "item_descriptions" VALUES(1128,'de','Dieser etwas unkonventionelle Bogen wurde speziell für den selbsternannten König eines Bauerndorfes entwickelt, weil dieser es liebte, zur Show zwei Pfeile gleichzeitig zu verschießen.');
INSERT INTO "item_descriptions" VALUES(1132,'en','It''s the symbol of purity and stupidity. Just like its creator who nevertheless gave it tremendous magic powers.');
INSERT INTO "item_descriptions" VALUES(1132,'fr','Cette œuvre d''art symbolise l''alliance de la pureté... et de la stupidité. Son créateur devait l''être un peu aussi, car il lui conféra d''énormes pouvoirs magiques.');
INSERT INTO "item_descriptions" VALUES(1132,'es','Esta obra de arte simboliza la alianza de la pureza... con la estupidez. Su creador tenía que serlo un poco también ya que le confirió enormes poderes mágicos.');
INSERT INTO "item_descriptions" VALUES(1132,'pt','É o símbolo da pureza e... da estupidez. Assim como seu criador, que lhe deu tremendos poderes mágicos.');
INSERT INTO "item_descriptions" VALUES(1132,'de','Dieses wahre Kunstwerk symbolisiert die Verbindung von Reinheit... und Dummheit. Übrigens scheint der Schöpfer dieses Stabes beides in hohem Maße besessen zu haben, denn er verlieh diesem Gegenstand enorme magische Kräfte.');
INSERT INTO "item_descriptions" VALUES(1134,'en','This stick was the key to the emancipation of the Eniripsa housewives: a fearsome weapon against both monsters and hard-to-reach dust.');
INSERT INTO "item_descriptions" VALUES(1134,'fr','L''émancipation des ménagères Eniripsa de moins de 50 ans commença grâce à cette baguette: redoutable à la fois pour les monstres et pour la poussière. Pratique non ?');
INSERT INTO "item_descriptions" VALUES(1134,'es','La emancipación de las amas de casa aniripsa de menos de 50 años empezó gracias a esta varita: a la vez temida por los monstruos y muy eficaz contra el polvo. Muy práctico, sí señora.');
INSERT INTO "item_descriptions" VALUES(1134,'pt','Este bastão foi a chave para a emancipação das donas de casa Eniripsa com menos de 50anos: uma arma apavorante contra monstros e poeira. Conveniente, não é?');
INSERT INTO "item_descriptions" VALUES(1134,'de','Die Emanzipation der Eniripsa-Hausfrauen unter 50 begann dank dieses Stabes. Gleichzeitig wirksam gegen Staub und gegen Monster. Praktisch, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(1138,'en','Houvette invented these wands to claim back her Enutrof husband from the liquid grip of the bar where he spent his evenings. She also used them to spice up their relationship, but nobody knows exactly how.');
INSERT INTO "item_descriptions" VALUES(1138,'fr','Houvette inventa ces baguettes pour ramener son mari Enutrof du bar où il passait ses journées. Bien utilisées, celles-ci permettaient de redonner du piquant à leur couple, mais nul ne dit comment.');
INSERT INTO "item_descriptions" VALUES(1138,'es','Huveta inventó estas varitas para que su marido anutrof regresara del bar donde se pasaba días enteros. Bien utilizadas, estas permitían poner picante a su pareja, pero nadie dijo cómo exactamente.');
INSERT INTO "item_descriptions" VALUES(1138,'pt','Nitle inventou estas varinhas mágicas para trazer de volta seu marido, um discípulo de Enutrof, do bar onde ele passava dias inteiros. Bem usadas, ela as usou para apimentar seu relacionamento, mas ninguém sabe exatamente como...');
INSERT INTO "item_descriptions" VALUES(1138,'de','Houvrette entwickelte diesen "Stab", um damit ihren Ehemann, einen Enutrof, von seiner Lieblingskneipe wieder nach Hause zu bringen. Man munkelt, er habe zudem wieder viel Schwung in ihre Beziehung gebracht, doch niemand weiß genaueres dazu.');
INSERT INTO "item_descriptions" VALUES(1146,'en','According to the tag, this wand has the power to make people obey whoever is holding it. The instructions say you have to shake it rapidly near your adversary. If it doesn''t work, try and poke him in the eye with it.');
INSERT INTO "item_descriptions" VALUES(1146,'fr','Selon l''étiquette, cette baguette aurait l''étrange pouvoir de faire obéir les gens. Le mode d''emploi stipule simplement de l''agiter fortement devant une personne. En cas de mauvais fonctionnement, l''agiter sur la personne marche bien aussi.');
INSERT INTO "item_descriptions" VALUES(1146,'es','Si nos fiamos de lo que pone en la etiqueta, esta varita tiene el extraño poder de someter a la gente. Las instrucciones de uso estipulan que debe ser enérgicamente agitada delante de la persona a la que se quiera someter. Si no funciona bien, agítala directamente sobre la cabeza de la persona en cuestión... ya verás como también resulta muy efectivo.');
INSERT INTO "item_descriptions" VALUES(1146,'pt','De acordo com a etiqueta, esta varinha mágica teria o estranho poder de fazer pessoas obedecerem ao seu dono. As instruções só aconselham agitá-lo fortemente na frente de seu adversário. Caso isto não funcione corretamente, você também pode atingir a cabeça dele(a) com isto. Que útil!');
INSERT INTO "item_descriptions" VALUES(1146,'de','Man sagt, dieser Stab habe die Macht, andere zu beherrschen. Laut Anleitung soll man ihn heftig vor dem Gesicht der Zielperson hin- und herschütteln. Aber mit dem Stab auf sie eindreschen, funktioniert meist genauso gut.');
INSERT INTO "item_descriptions" VALUES(1149,'en','Most young Fecas have a staff quite similar to this one. It''s gone beyond a trend now, and has become a ritual of sorts. Has no one ever told them how ridiculous they look?');
INSERT INTO "item_descriptions" VALUES(1149,'fr','La plupart des jeunes Féca possèdent de nombreux bâtons comme celui-ci, plus qu''une mode c''est presque un nouveau rituel. Quelqu''un devrait quand même leur dire qu''ils sont ridicules.');
INSERT INTO "item_descriptions" VALUES(1149,'es','La mayor parte de los jóvenes feca poseen numerosos bastones como este, más allá de ser una simple moda, se trata de un nuevo ritual. Aunque alguien debería decirles que son ridículos.');
INSERT INTO "item_descriptions" VALUES(1149,'pt','A maioria dos jovens Fecas tem cajados parecidos com esse aqui. Mais que uma moda, é quase um novo ritual. Por favor, digam-lhes que estão ridículos!');
INSERT INTO "item_descriptions" VALUES(1149,'de','Eine Vielzahl jugendlicher Fécas besitzt irgendwo einen solchen Stecken. Das kann man schon beinahe nicht mehr eine neue Modeerscheinung nennen, das ist bereits so eine Art zwanghaftes Ritual geworden. Jemand sollte ihnen wirklich mal sagen, dass sie damit einfach nur lächerlich aussehen.');
INSERT INTO "item_descriptions" VALUES(1153,'en','A short-sighted, grumbling, fortune telling, smelly old Feca accidentally created this powerful weapon when her staff rammed into her crystal ball as she slipped from the kitchen table. She''d read her own fortune long before and, well, she more or less lived on that table... wonder what it was she thought was going to kill her... well, I guess she wasn''t the best fortune teller.');
INSERT INTO "item_descriptions" VALUES(1153,'fr','Une vieille Féca voyante malvoyante inventa accidentellement cette puissante arme lorsqu''elle fit rencontrer son bâton et sa boule de cristal à l''occasion d''une chute qu''elle ne sut prévoir.');
INSERT INTO "item_descriptions" VALUES(1153,'es','Una vieja feca invidente inventó por accidente esta poderosa arma cuando su bastón y su bola de cristal chocaron entre sí tras una caída que la vieja no supo predecir.');
INSERT INTO "item_descriptions" VALUES(1153,'pt','Uma velha cartomante Feca com visão limitada, acidentalmente, criou esta poderosa arma quando, ao cair, seu cajado colidiu com a sua bola de cristal. Bem, existem coisas que ninguém consegue prever...');
INSERT INTO "item_descriptions" VALUES(1153,'de','Eine schlecht sehende Féca-Seherin erschuf zufällig diese mächtige Waffe, indem sie bei einem unvorhergesehenen Sturz ihre Kristallkugel auf ihren Stock fallen ließ.');
INSERT INTO "item_descriptions" VALUES(1163,'en','The success of the Wa Wabbit Staff lead to the creation of a host of cheap copies. Today, there are far more fakes than originals.');
INSERT INTO "item_descriptions" VALUES(1163,'fr','Le succès du bâton du Wa Wabbit a contribué à l''apparition de divers bâtons, comme celui-ci, dont le nom singe le premier. Ceci afin de le vendre plus facilement. Une technique bien connue de certains promoteurs immobiliers.');
INSERT INTO "item_descriptions" VALUES(1163,'es','El éxito del bastón del Wey Wabbit contribuyó a la aparición de diversos bastones como este. Su nombre se asemeja al del bastón del wey, de esta manera se podía vender más fácilmente. Una técnica muy extendida entre algunos promotores inmobiliarios.');
INSERT INTO "item_descriptions" VALUES(1163,'pt','O sucesso do Cajado de Wei Wabbit contribuiu para a criação de vários cajados, incluindo este. Foi dado a eles o mesmo nome, para vendê-los mais facilmente. Bem como fazem alguns criadores de bens.');
INSERT INTO "item_descriptions" VALUES(1163,'de','Der Erfolg des Wa Wabbit-Steckens führte zum Auftauchen einer großen Anzahl an Fälschungen auf dem Markt. Alles mit dem Ziel, diesen noch leichter verkaufen zu können. Ist ja schließlich eine altbekannte Technik der Immobilienmakler.');
INSERT INTO "item_descriptions" VALUES(1330,'en','It is an original creation of the silversmith John-Lay Nonne, and now one of the most sought after jewels on the continent.');
INSERT INTO "item_descriptions" VALUES(1330,'fr','Création originale de l''orfèvre John Les Nonnes, c''est aujourd''hui un des bijoux les plus classiques.');
INSERT INTO "item_descriptions" VALUES(1330,'es','Es una creación original del orfebre John Limon, hoy en día se trata de una de la joyas más clásicas.');
INSERT INTO "item_descriptions" VALUES(1330,'pt','Criação original do ourives John Les Nonnes, agora é umas das jóias mais clássicas.');
INSERT INTO "item_descriptions" VALUES(1330,'de','Diese originelle Schöpfung des Goldschmiedes John Les Nonnes gehört heute zu den absoluten Schmuckklassikern.');
INSERT INTO "item_descriptions" VALUES(1331,'en','Oly was a female Iop with only one ability - cooking. It is said that Iop himself gave her this medal in order to compensate for her weaknesses in battle. Only pure-hearted people can wear it.');
INSERT INTO "item_descriptions" VALUES(1331,'fr','Oly était une disciple de Iop dont le seul talent était la cuisine. On rapporte que Iop en personne lui aurait donné cette médaille, pour compenser ses trop grandes faiblesses en combat. Cependant seuls les coeurs purs peuvent la porter.');
INSERT INTO "item_descriptions" VALUES(1331,'es','Lacena era una discípula de Yopuka cuyo único talento consistía en cocinar. Dicen que el mismo Yopuka le dio esta medalla para compensar sus puntos débiles en el combate. Sin embargo, solo los corazones puros pueden llevarla.');
INSERT INTO "item_descriptions" VALUES(1331,'pt','Oly era uma seguidora de Iop com um único talento; ela era boa na cozinha. Dizem que o próprio Iop deu a ela esta medalha a fim de compensá-la por suas fraquezas em luta. Apenas pessoas de coração puro podem usar esta medalha.');
INSERT INTO "item_descriptions" VALUES(1331,'de','Olivia, von allen nur Oly genannt, war eine Anhängerin von Iop, deren einziges echtes Talent das Kochen war. Man munkelt, Iop höchstpersönlich habe ihr diese Medaille zugesteckt, um ihre Schwäche im Kampf auszugleichen. Denn nur Streiter reinen Herzens können diese Medaille tragen.');
INSERT INTO "item_descriptions" VALUES(1350,'en','This bow was created by a wizard who was fond of his cider. In order to ease his crippling hangovers, he invented this water-type bow.');
INSERT INTO "item_descriptions" VALUES(1350,'fr','Cet arc a été créé par un magicien porté sur la bouteille. Afin de résoudre son problème, il a inventé cet arc spécialisé dans l''eau.');
INSERT INTO "item_descriptions" VALUES(1350,'es','Este arco ha sido creado por un mago que le tenía un cariño muy especial a su botella. Para acabar con su dependencia sentimental, inventó este arco especializado en el agua.');
INSERT INTO "item_descriptions" VALUES(1350,'pt','Este arco foi criado por um mago que gostava de beber. Para resolver esse problema, ele inventou este arco do tipo água.');
INSERT INTO "item_descriptions" VALUES(1350,'de','Diesen Bogen hat ein Erz-Magier erbaut, der sich nie von seinem Flachmann trennen konnte. Um das Problem in den Griff zu bekommen, erfand er diesen mit mächtiger Wassermagie verzauberten Bogen.');
INSERT INTO "item_descriptions" VALUES(1351,'en','As the saying goes "With a bow, it''s make or break". Wise men avoid this bow. The rumour is it has the evil eye.');
INSERT INTO "item_descriptions" VALUES(1351,'fr','"Avec un arc, ça passe ou ça casse", dit le proverbe. Les sages éviteront cet arc, il serait soi-disant porteur du mauvais oeil...');
INSERT INTO "item_descriptions" VALUES(1351,'es','«Con semejante arco, te largas o te mato» dice el refrán. Los más sabios evitarán esta arma, pues dicen que atrae el mal de ojo...');
INSERT INTO "item_descriptions" VALUES(1351,'pt','É Como diz o ditado: “Com um arco, ou se faz ou quebra”. Homens sábios evitam este arco. Dizem que dá mau-olhado.');
INSERT INTO "item_descriptions" VALUES(1351,'de','"Knapp vorbei ist auch daneben", so sagt das Sprichwort. Weise Krieger meiden diesen Bogen. Es heißt nämlich, er gäbe einem den Bösen Klick beim Schießen.');
INSERT INTO "item_descriptions" VALUES(1352,'en','This bow carries the forces of earth and water. Woe betide him who cannot control at least one of the two.');
INSERT INTO "item_descriptions" VALUES(1352,'fr','Cet arc prend sa force aussi bien de la terre que de l''eau. Malheur à ceux qui ne maîtrisent ni l''un ni l''autre...');
INSERT INTO "item_descriptions" VALUES(1352,'es','Este arco saca su poder tanto de la tierra como del agua. Pobre del que no domine el uno ni el otro.');
INSERT INTO "item_descriptions" VALUES(1352,'pt','Este arco carrega as forças da terra e da água. A desgraça sucede àquele que não consegue controlar pelo menos uma das duas forças...');
INSERT INTO "item_descriptions" VALUES(1352,'de','Dieser Bogen bezieht seine Stärke aus Erde und Wasser. Unheil all jenen, die auf Feuer und Luft schwören!');
INSERT INTO "item_descriptions" VALUES(1353,'en','All the pulleys of this bow were sawn off. It used to be a symbol of the conflict between Good and Evil.
Touch it and you''ll feel the supreme justice of the ancient lawmakers running through your fingertips.');
INSERT INTO "item_descriptions" VALUES(1353,'fr','Cet arc, dont toutes les poulies ont été sciées, était, il y a fort longtemps, le symbole de la lutte du bien contre le mal.
Encore aujourd''hui, on peut sentir en lui la flamme des anciens justiciers.');
INSERT INTO "item_descriptions" VALUES(1353,'es','Antiguamente, este arco era el símbolo de la lucha del bien contra el mal. Hoy en día todavía se puede sentir, al tocarlo, una agradable sensación de poder y de superioridad social... Aunque será mejor no enseñarlo si te paseas solo por los bajos fondos de la ciudad de Bonta.');
INSERT INTO "item_descriptions" VALUES(1353,'pt','Todas as partes deste arco foram serradas. Costumava ser um símbolo do conflito entre o Bem e o Mal.
Toque-o e você será capaz de sentir o fervor dos antigos disseminadores de justiça.');
INSERT INTO "item_descriptions" VALUES(1353,'de','Dieser Bogen, dessen Rollen alle poliert wurden, war vor langer, langer Zeit das Symbol des Kampfes zwischen Gut und Böse. Selbst heute noch glimmt in ihm die Flamme der früheren Rächer des Unheils.');
INSERT INTO "item_descriptions" VALUES(1354,'en','Hick was an cursed Cra: he couldn''t stop hiccupping. One day he threw his bow into the fire and decided to use a sword instead. The curse strangely disappeared at that exact moment.');
INSERT INTO "item_descriptions" VALUES(1354,'fr','Hick était un Crâ maudit : il n''arrivait jamais à se débarrasser de son hoquet. Cependant, il finit un jour par jeter son arc au feu pour le remplacer par une épée, et son mal disparu mystérieusement...');
INSERT INTO "item_descriptions" VALUES(1354,'es','Hips era un ocra maldito: no conseguía librarse de su hipo. Sin embargo un día acabó echando su arco al fuego para reemplazarlo por una espada y su mal desapareció misteriosamente.');
INSERT INTO "item_descriptions" VALUES(1354,'pt','Hick era um Cra amaldiçoado: ele não conseguia parar de soluçar... Um dia, ele jogou seu arco no fogo e decidiu usar uma espada. A maldição, estranhamente, desapareceu naquele exato momento...');
INSERT INTO "item_descriptions" VALUES(1354,'de','Hick war ein verwunschener Crâ. Er konnte machen, was er wollte – er wurde seinen Schluckauf nicht mehr los. Eines Tages tauschte er seinen Feuerbogen gegen ein Schwert. Unbegreiflicherweise verschwand das ihn plagende Übel am gleichen Tag.');
INSERT INTO "item_descriptions" VALUES(1355,'en','The man who created this bow, a certain Marc Hidsad, never really knew how to use it. He usually hurt himself just as much as his enemies.');
INSERT INTO "item_descriptions" VALUES(1355,'fr','Le créateur de cet arc, un certain Marc Hidsad, n''a jamais très bien su s''en servir. Il pouvait tout autant infliger de sévères blessures à ses ennemis que de se blesser lui-même.');
INSERT INTO "item_descriptions" VALUES(1355,'es','El creador de este arco, un noble llamado Desade, nunca supo muy bien cómo manipularlo. Al igual que podía infligir tremendos daños a sus enemigos, también podía herirse él mismo.');
INSERT INTO "item_descriptions" VALUES(1355,'pt','O homem que criou este arco, um certo Marc Hidsad, nunca soube realmente como usá-lo. Ele poderia machucar seriamente o seu oponente tanto quanto ele mesmo.');
INSERT INTO "item_descriptions" VALUES(1355,'de','Der Mann, der diesen Bogen erschaffen hat – ein gewisser Mark Hidsad – hat niemals richtig gelernt, damit umzugehen. Die meiste Zeit verletzte er seine Gegner genauso schwer wie sich selbst.');
INSERT INTO "item_descriptions" VALUES(1356,'en','Rika Zarouil The Female Baker was renowned for having been the smallest Eniripsa in the whole World of Amakna. She made her loaves in small cardboard furnaces and used this old bread to impale many a hero.');
INSERT INTO "item_descriptions" VALUES(1356,'fr','Rika Zarouil la boulangère fut connue pour avoir été l''eniripsa la plus petite de la contrée. Elle faisait son pain dans des petits-fours en carton et se battait avec des demi-baguettes.');
INSERT INTO "item_descriptions" VALUES(1356,'es','El panadero Raguiñano fue famoso por haber sido el primer aniripsa en hacer su pan con  levadura biológica. Como su invento no tuvo ningún éxito, ha tenido que vender su panadería y empezar una nueva vida como actor de teatro ambulante. Qué triste.');
INSERT INTO "item_descriptions" VALUES(1356,'pt','Rika Zarouil, a padeira, é famosa por ter sido o menor discípulo de Eniripsa em todo o mundo de Amakna. Ela fez seu pão em pequenas fornalhas de papelão e pode lutar com metade de um bastão.');
INSERT INTO "item_descriptions" VALUES(1356,'de','Die Bäckerin Rika Zarouil war dafür bekannt, die kleinste Eniripsa im Umkreis zu sein. Ihr Brot wurde in einem Stöfchen gebacken, und in den Kampf zog sie mit ihrem berühmten, halben Stäbchenbaguette.');
INSERT INTO "item_descriptions" VALUES(1357,'en','A mischievous sculptor tried to make people think his wands were daggers, calling them Wangers at first, and then simply Wangs. His plan didn''t work, but his wands most definitely do.');
INSERT INTO "item_descriptions" VALUES(1357,'fr','Un sculpteur un peu farceur tenta de faire passer ses baguettes pour des dagues. Son stratagème n''eu aucun succès mais ses baguettes, elles, en eurent.');
INSERT INTO "item_descriptions" VALUES(1357,'es','Un escultor un poco bromista quiso hacer pasar sus varitas por dagas. Su estratagema no tuvo ningún éxito pero sus dagas sí que lo tuvieron...');
INSERT INTO "item_descriptions" VALUES(1357,'pt','Um perverso escultor tentou fazer as pessoas pensarem que suas varinhas eram adagas. O estratagema dele não foi eficiente, mas as varinhas eram.');
INSERT INTO "item_descriptions" VALUES(1357,'de','Ein spaßhafter Stabschnitzer versuchte einst, seine geschnitzten Stäbe als Dolche zu verkaufen. Doch die List zeigte keinerlei Erfolg. Trotzdem sind die Stolche eine elegante und wirkungsvolle Waffe.');
INSERT INTO "item_descriptions" VALUES(1359,'en','The origins of this wand remain quite obscure. I can tell you that it''s great for finding parking on a rainy Monday in Amakna town... Just points in the direction you need to go... It does one-way streets and everything!');
INSERT INTO "item_descriptions" VALUES(1359,'fr','Les origines de cette baguette restent obscures. Cependant, elle a toujours aidé ses heureux possesseurs à trouver les chemins les moins encombrés d''Amakna, ce qui peut servir les jours de grande influence sur le domaine du bouftou royal.');
INSERT INTO "item_descriptions" VALUES(1359,'es','Los orígenes de esta varita siguen siendo muy oscuros. Sin embargo, es muy apreciada por los aventureros ya que con ella pueden encender hogueras, quemarse las sanguijuelas, los pelos del pecho y además es muy útil para encontrar su camino en las noches muy oscuras... Por cierto, por mucho que sople el viento, no se apaga nunca.');
INSERT INTO "item_descriptions" VALUES(1359,'pt','A origem desta varinha é obscura. No entanto, ela sempre ajudou seus proprietários a acharem as estradas menos congestionadas de Amakna, o que pode ser útil no domínio do Papatudo Real.');
INSERT INTO "item_descriptions" VALUES(1359,'de','Die Geschichte dieses Stabes liegt im Dunkeln. Doch hat dieser zumeist "AGAW" genannte Stab seinem Träger mehr als nur einmal geholfen, die am wenigsten verstopften Wege Amaknas zu finden. Das kann sehr nützlich sein, besonders wenn im Reich des königlichen Fresssacks mal wieder hohes Verkehrsaufkommen herrscht.');
INSERT INTO "item_descriptions" VALUES(1360,'en','This wand was created many years ago in the forging flames of Dyin Ard. You''d be well-advised to have a bucket of water at hand just to keep control of the mini-inferno.');
INSERT INTO "item_descriptions" VALUES(1360,'fr','Cette baguette fut créée il y a de nombreuses années dans les flammes de la forge de Mort Dur. Cette arme nécessite d''avoir toujours de l''eau à côté de soi pour pouvoir maitriser son feu intérieur...');
INSERT INTO "item_descriptions" VALUES(1360,'es','Esta varita ha sido creada, hace muchísimos años en las llamas de la forja del Muro Doro. Esta arma requiere tener agua a tu alcance para poder dominar su fuego interior...');
INSERT INTO "item_descriptions" VALUES(1360,'pt','Esta varinha mágica foi criada muitos anos atrás nas chamas da forja de Dyin Ard. É aconselhado ter água sempre à mão só para mantê-la sob controle.');
INSERT INTO "item_descriptions" VALUES(1360,'de','Dieser Stab wurde vor vielen Jahren in den Flammen der Schmiede von Mo''Der geschmiedet. Daher ist es auch stark angeraten, immer einen Eimer Wasser in der Nähe zu haben, um notfalls sein inneres Feuer wieder löschen zu können.');
INSERT INTO "item_descriptions" VALUES(1361,'en','The Sylvian Wand gives you sharp sight. You''ll probably use it for picking out a good escape route.');
INSERT INTO "item_descriptions" VALUES(1361,'fr','La Baguette Sylvien a l''étrange pouvoir de conférer une vue perçante à son porteur. Charge ensuite à celui ci d''être suffisamment agile pour pouvoir fuir le danger.');
INSERT INTO "item_descriptions" VALUES(1361,'es','La Varita Prismática tiene el extraño poder de conferir una vista agudísima al que la posea. Luego le tocará a esta persona ser lo suficientemente rápida para poder escapar del peligro que se acerque.');
INSERT INTO "item_descriptions" VALUES(1361,'pt','A Varinha Mágica de Sylvian dá uma visão afiada ao seu portador; fará você ágil o suficiente para escapar do perigo.');
INSERT INTO "item_descriptions" VALUES(1361,'de','Der Stab der Sylvan besitzt die sonderbare Macht, seinem Träger eine hervorragende Sehschärfe zu bescheren. Jetzt fehlt nur noch genügend Flinkheit, um sich rechtzeitig aus dem Staub zu machen.');
INSERT INTO "item_descriptions" VALUES(1362,'en','The vampiric stake is, in fact, the wand of a vampire who retired long ago from social life and slaughtering. This strange piece of wood has nevertheless inherited a few qualities from its former master...');
INSERT INTO "item_descriptions" VALUES(1362,'fr','Le pieu vampirique est en fait la baguette d''un vampire depuis longtemps retiré de la vie sociale et de la boucherie. Cet étrange bout de bois a cependant gardé quelques-uns des avantages de son ancien maître...');
INSERT INTO "item_descriptions" VALUES(1362,'es','La estaca vampírica es en realidad la varita de un vampiro que se retiró desde hace tiempo de la vida social y de la carnicería. Sin embargo, este extraño trozo de madera ha conservado algunas de las ventajas de su antiguo amo...');
INSERT INTO "item_descriptions" VALUES(1362,'pt','A estaca vampírica nada mais é que uma varinha de um vampiro que desistiu de viver em sociedade e de ser açougueiro. Este estranho pedaço de madeira guardou algumas qualidades do antigo mestre...');
INSERT INTO "item_descriptions" VALUES(1362,'de','Dieser Vampirpflock ist eigentlich der Zauberstab eines Vampirs, der sich völlig aus dem gesellschaftlichen Leben zurückgezogen und schon seit Jahren kein Blut mehr gesaugt hat. Ein paar der Vorzüge, die es zu Zeiten seines alten Meisters besaß, weist dieses seltsame Stück Holz aber immer noch auf.');
INSERT INTO "item_descriptions" VALUES(1363,'en','On top of its unbearable name, this staff has many ways to get on its owner''s nerves.');
INSERT INTO "item_descriptions" VALUES(1363,'fr','Outre son nom insupportable, ce bâton possède bien d''autres moyens de rendre son propriétaire fou de rage.');
INSERT INTO "item_descriptions" VALUES(1363,'es','Además de su insoportable nombre, este bastón tiene muchas más formas de hacer que su dueño se vuelva loco de ira.');
INSERT INTO "item_descriptions" VALUES(1363,'pt','Além do seu nome insuportável, este cajado tem muitas outras maneiras de afetar os nervos do seu portador.');
INSERT INTO "item_descriptions" VALUES(1363,'de','Neben seinem unerträglichen Namen besitzt dieser Stock noch viele andere Eigenschaften, um seinen Träger vor Wut schier zum Platzen zu bringen.');
INSERT INTO "item_descriptions" VALUES(1364,'en','This staff will help its owner forget about their worries and their strife. Unfortunately, it sometimes causes them to lose some of their memory and become subject to frequent lapses in concentration. Reserved for sages only.');
INSERT INTO "item_descriptions" VALUES(1364,'fr','Ce bâton fait oublier tous les soucis et les mauvaises pensées de son propriétaire. Malheureusement, il perd aussi parfois une partie de sa mémoire et devient sujet à des pertes de concentration de plus en plus fréquentes. À réserver aux sages...');
INSERT INTO "item_descriptions" VALUES(1364,'es','Este bastón hace que su dueño olvide todos sus problemas y sus pensamientos negativos. Desfortunadamente, también pierde a veces una parte de su memoria y provoca problemas de concentración cada vez más frecuentes. Reservado para los más sabios...');
INSERT INTO "item_descriptions" VALUES(1364,'pt','Todas as suas preocupações e pensamentos ruins desapareceram, graças a este cajado... assim como, às vezes, também desaparece uma parte da sua memória. Em breve, você pode ser incapaz de se concentrar. Apenas para homens sábios.');
INSERT INTO "item_descriptions" VALUES(1364,'de','Dieser Stock lässt einen Sorgen und Kummer vergessen. Leider geht dabei mit der Zeit auch ein Großteil des Gedächtnisses verloren, während gleichzeitig die Konzentrationsfähigkeit nachlässt. Daher ist er ausschließlich den Weisen vorbehalten...');
INSERT INTO "item_descriptions" VALUES(1365,'en','They say it was this staff that made a fearsome warrior of Heds; they say it was magic and could shoot fire. Ever heard of All Bran? Eight bowls of this stuff a day and you''d be shooting fire too, buddy.');
INSERT INTO "item_descriptions" VALUES(1365,'fr','Hête était vraiment un guerrier redoutable avec son bâton. Il était tellement efficace qu''on prétendait que son bâton était magique et qu''il lançait des flammes...');
INSERT INTO "item_descriptions" VALUES(1365,'es','Torrón era un temible guerrero con su bastón. Incluso algunos decían que era inmortal... hasta el día en que se murió asfixiado. Se había olvidado de respirar.');
INSERT INTO "item_descriptions" VALUES(1365,'pt','Leta foi um guerreiro formidável, graças a esse cajado. Sua eficácia era tamanha que diziam que seu cajado era mágico e lançava chamas...');
INSERT INTO "item_descriptions" VALUES(1365,'de','Wood war ungeschlagen im Umgang mit seinem Stock. Wenn er mal loslegte, dann war die Atmosphäre um ihn herum wie elektrisch aufgeladen, das rhythmische Trommeln seiner Schläge dröhnte durch die Luft, und Gegner in seiner Umgebung wurden wie von Geisterhand umhergewirbelt.');
INSERT INTO "item_descriptions" VALUES(1366,'en','This staff is commonly used by gobbherds during the trading season to fend off the Bworks, who like to snack on the Gobball herds around this time. The prized dish is the gobbherd himself.');
INSERT INTO "item_descriptions" VALUES(1366,'fr','Bâton couramment utilisé lors de la transhumance par les bouftiers. Les bworks aiment déguster ces troupeaux de bouftous en fines tranches lors de l''apéritif (le plat principal étant constitué du bouftier lui-même).');
INSERT INTO "item_descriptions" VALUES(1366,'es','Se trata aquí de un bastón muy utilizado por los jalateros durante la trashumancia. Pues a los bworks les encanta saborear los rebaños de jalatós cortados en finas lonchas para el aperitivo (el plato fuerte llegaba a ser el propio jalatero).');
INSERT INTO "item_descriptions" VALUES(1366,'pt','Geralmente, este cajado é usado por Papastores durante a transumância. Bworks gostam de Papatudo em finas fatias como aperitivo e, como prato principal, o próprio Papastor.');
INSERT INTO "item_descriptions" VALUES(1366,'de','Ein solcher Hirtenstock wird üblicherweise von den Bwork-Fresssackhirten für den Almabtrieb verwendet. Bworks lieben es nämlich, Fresssäcke in feine Scheibchen geschnitten als Vorspeise zu genießen (in nicht wenigen Fällen wird dann der Hirte selbst als Hauptgericht serviert).');
INSERT INTO "item_descriptions" VALUES(1367,'en','This staff once belonged to the beautiful Dina Mite, renowned for her explosive voice. In her day, she was a cracker too.');
INSERT INTO "item_descriptions" VALUES(1367,'fr','Ce bâton a appartenu à la très belle Dina ''Mythe'', qui était surtout connue pour ses formes avantageuses et son caractère explosif... Bref c''était une vraie bombe.');
INSERT INTO "item_descriptions" VALUES(1367,'es','Este bastón perteneció a la elegante y bella Dina Mita. Esta era sobre todo famosa por sus curvas encantadoras y su carácter... explosivo. Vamos, que era una auténtica bomba.');
INSERT INTO "item_descriptions" VALUES(1367,'pt','Este cajado pertenceu à bela Dina “Mito”, conhecida por sua graça... Em resumo, um verdadeiro bebê.');
INSERT INTO "item_descriptions" VALUES(1367,'de','Dieser Stock gehörte einst der hübschen Dina. Mit ihren üppigen Kurven und ihrem hoch-explosiven Charakter schuf sie einen echten Mythos um sich und den sie überallhin begleitenden Stock herum. Sie war aber auch eine echte Granate, heißt es.');
INSERT INTO "item_descriptions" VALUES(1368,'en','Apparently, this staff belonged to one of the 110 Amaknian firefighters it took to put out the fire started deliberately by the reckless Red Wyrmling. There were definite signs of arson about.');
INSERT INTO "item_descriptions" VALUES(1368,'fr','"Les 110" est le surnom donné aux 110 valeureux pompiers Amakniens, qui ont notamment combattu le feu d''un Dragonnet en mal de sensations fortes. Cette lance aurait appartenu à l''un d''eux. S''en servir demande courage et force.');
INSERT INTO "item_descriptions" VALUES(1368,'es','Este bastón perteneció a uno de los valientes bomberos de Amakna que combatieron el fuego de un Dragonito en mal de sensaciones fuertes. Necesitarás valor y fuerza para poder usar este bastón.');
INSERT INTO "item_descriptions" VALUES(1368,'pt','Aparentemente, esse cajado pertenceu a um dos 110 bombeiros Amaknianos necessários para apagar o incêndio causado pelos Wyrmling Vermelhos. Havia sinais de incêndio criminoso.');
INSERT INTO "item_descriptions" VALUES(1368,'de','Die sagenumwobenen "112er" waren nichts anderes als eine mutige Brandbekämpfungstruppe in Amakna, die unter anderem sogar gefährliche Drachennestlingsfeuer löschen konnten. Anscheinend hat dieser Stock einmal einem von ihnen gehört. Zu seinem Einsatz braucht man viel Mut und Stärke.');
INSERT INTO "item_descriptions" VALUES(1369,'en','These knives have been specially conceived to be used in luxury restaurants. However, because of their rather strange appearance, the owner decided to resell them to a travelling knife thrower.');
INSERT INTO "item_descriptions" VALUES(1369,'fr','Ces couteaux étaient à l''origine censés servir dans un restaurant de luxe. Mais devant leur look plutôt... étrange, le patron du restaurant a préféré les revendre à un lanceur de couteaux ambulant.');
INSERT INTO "item_descriptions" VALUES(1369,'es','Se supone que estos cuchillos eran de cocina y eran para un lujoso restaurante, pero cuando el chef se percató del aspecto más bien extraño que tenían, los vendió a un lanzador de cuchillos ambulante.');
INSERT INTO "item_descriptions" VALUES(1369,'pt','Estas facas foram especialmente concebidas para serem usadas em um restaurante de luxo. Mas, por causa da aparência bastante estranha delas, o dono decidiu revendê-las para um lançador de facas viajante.');
INSERT INTO "item_descriptions" VALUES(1369,'de','Diese Messer sollten anfangs in einem bekannten Luxusrestaurant eingesetzt werden. Doch bei ihrem eher... seltsamen... Aussehen, hat es der Restaurantbesitzer letzten Endes doch vorgezogen, sie an einen fahrenden Messerwerfer zu verkaufen.');
INSERT INTO "item_descriptions" VALUES(1370,'en','The hilt of this weapon is greasy and slippery but it really does look fab.');
INSERT INTO "item_descriptions" VALUES(1370,'fr','La poignée de cette arme est grasse et glissante, mais elle a vraiment un look génial.');
INSERT INTO "item_descriptions" VALUES(1370,'es','La empuñadura de esta arma está grasienta y resbala mucho, pero tiene una pinta muy chula.');
INSERT INTO "item_descriptions" VALUES(1370,'pt','O punho desta arma é gorduroso e escorregadio, mas realmente parece sensacional.');
INSERT INTO "item_descriptions" VALUES(1370,'de','Das Heft dieser Waffe fühlt sich stets fettig und glitschig an, doch vom Aussehen her ist sie einfach unübertroffen.');
INSERT INTO "item_descriptions" VALUES(1371,'en','Eulasse was a gobbherd in Amakna who one day found these dirty daggers in the Gobball dung heap. Be careful with them, the hilts are still a bit slippery...');
INSERT INTO "item_descriptions" VALUES(1371,'fr','Eulasse était un bouftier du nord d''Amakna qui trouva un jour, au milieu du fumier de ses bouftous, une paire de dagues légèrement salies.
Que celui qui les porte fasse attention : le manche glisse, il est facile de manquer son coup.');
INSERT INTO "item_descriptions" VALUES(1371,'es','Kaka era un jalatero del norte de Amakna que un día encontró en medio del estiércol de sus jalatós, un par de dagas ligeramente manchadas. Quien las use que tenga mucho cuidado: el mango resbala por lo cual es muy fácil fallar su ataque con ellas.');
INSERT INTO "item_descriptions" VALUES(1371,'pt','Eulasse era um Papastor de Amakna. Mas, um dia, ele achou no monte de esterco de seus Papatudo um par de adagas ligeiramente sujas. Tenha cuidado se for usar estas adagas, pois o punho é um pouco escorregadio...');
INSERT INTO "item_descriptions" VALUES(1371,'de','Öhl war ein alter Fresssackhirte im Norden Amaknas, der eines Tages inmitten eines noch dampfenden Fresssack-Dunghaufens ein Paar stark verschmutzter Dolche fand. Eine Warnung an jeden der sie nun trägt: ihr Griff ist sehr rutschig, darum kann es leicht vorkommen, dass sie einem aus der Hand gleiten.');
INSERT INTO "item_descriptions" VALUES(1372,'en','Otof''Mai''We was a hermit, a legendary disciple of Sram, who spent his life avoiding all sorts of contact with others. When he died, his favourite daggers were found next to his body. Only the nimblest of men can control them.');
INSERT INTO "item_descriptions" VALUES(1372,'fr','Qui ne connait pas Aj''Deh''Là, l''ermite, légendaire disciple de Sram qui avait passé sa vie à refuser tout contact avec les autres. À sa mort, on retrouva ses dagues fétiches à côté de son corps, et seuls les plus agiles purent les apprivoiser.');
INSERT INTO "item_descriptions" VALUES(1372,'es','Olina era una legendaria discípula de Sram que se pasó la vida entera buscando una nueva fuente de riqueza que según ella revolucionaría los métodos de producción. Estas dagas han sido encontradas junto a su cadáver... la pobre se había caído dentro de un pozo de barro negro y viscoso. Los del pueblo taparon el agujero al día siguiente para evitar que se repitieran otros accidentes tan estúpidos como este.');
INSERT INTO "item_descriptions" VALUES(1372,'pt','Otof''Mai''We foi um eremita, um legendário discípulo de Sram, que passou a vida evitando todo contato com outros. Quando ele morreu, suas adagas favoritas foram encontradas próximas do seu corpo. Apenas o mais sagaz dos homens poderia controlá-las.');
INSERT INTO "item_descriptions" VALUES(1372,'de','Niemand kennt das Ende von Abdul Abhau O''da Abu Putt, einem alten Einsiedler-Sram, der schon immer ein wenig an Verfolgungswahn litt. Er erwartete stets, durch ein Mitglied seiner eigenen Familie erdolcht zu werden, daher vermied er jeden Kontakt mit der Außenwelt. Nach seinem Tod fand man seine Lieblingsdolche neben seiner Leiche liegen und nur die Flinksten konnten sich noch einen von ihnen schnappen.');
INSERT INTO "item_descriptions" VALUES(1373,'en','Any Enutrof worthy of the name has a beard and old Krys Nosheive was no exception. One day his wife, Mrs Nosheive, bought him a razor, and he decided he would rather use it as a weapon.');
INSERT INTO "item_descriptions" VALUES(1373,'fr','Krys Razepa était un vieux disciple d''Enutrof qui portait la barbe, comme tous les disciples d''Enutrof dignes de ce nom. Lorsque madame Razepa, sa femme, lui offrit un rasoir, il préféra l''utiliser pour combattre...');
INSERT INTO "item_descriptions" VALUES(1373,'es','Nosa Afeyta era una vieja discípula Anutrof que tenía barba, como todos los discípulos de Anutrof dignos de su condición. Cuando el señor Afeyta le regaló este cuchillo para su cumpleaños, ella prefirió utilizarlo para luchar...');
INSERT INTO "item_descriptions" VALUES(1373,'pt','Todo discípulo de Enutrof merecedor do nome tem barba, e o velho Krys Nosheive não era uma exceção. Um dia, sua esposa, Sra. Nosheive, comprou-lhe uma navalha, mas ele decidiu usá-la como arma.');
INSERT INTO "item_descriptions" VALUES(1373,'de','Krys Rasni war ein alter Enutrof-Anhänger mit dichtem Bart, wie jeder wahre Enutrof, der etwas auf sich hält. Darum zog er es vor, die Rasierklingen, die ihm seine Frau Bartbara Rasni zu schenken pflegte, ausschließlich im Kampf zu gebrauchen.');
INSERT INTO "item_descriptions" VALUES(1374,'en','Penn was an ancient scribe of Amakna... centuries ago. He had the strange habit of carving stone using daggers instead of chisels. These magnificent and resistant daggers belonged to him.');
INSERT INTO "item_descriptions" VALUES(1374,'fr','Tylo était un scribe amaknéen qui vécut il y a des siècles de cela. Il avait la particularité de graver ses cahiers de pierre non pas avec des burins mais avec des dagues. Nous reste de lui cette superbe dague, impressionnante de résistance aux chocs.');
INSERT INTO "item_descriptions" VALUES(1374,'es','Ligra Fía era un escriba amakneano que vivió hace muchos siglos. Tenía la particularidad de grabar sus cuadernos de piedra con esta daga en vez de utilizar un buril. De este ilustre personaje solo nos ha quedado esta hermosa daga, cuya resistencia a los choques es impresionante.');
INSERT INTO "item_descriptions" VALUES(1374,'pt','Penn era um antigo escriba de Amakna... há vários séculos. Ele tinha o estranho hábito de esculpir em pedra usando adagas em vez de cinzéis. Essa magnífica e resistente adaga pertencia a ele.');
INSERT INTO "item_descriptions" VALUES(1374,'de','Vor langer, langer Zeit verwendete ein bekannter Schreiber Amaknas einen Dolch namens "Tint". Normalerweise benutzte er ihn, um Steinplatten zu gravieren. Darum war sein Dolch besonders widerstandsfähig gebaut, und bei einem Angriff erledigte er problemslos drei gefährliche Räuber. Gerührt ritzte er für die Nachwelt "Mit Tint killte er" in den Dolch hinein und setzte seinen Namen dahinter.');
INSERT INTO "item_descriptions" VALUES(1375,'en','Terophyle the Iop was capable of lifting enormous stones... It''s not really proof of intelligence to you or I, but a Iop who can capture the idea of picking up something round is already a king among his people.');
INSERT INTO "item_descriptions" VALUES(1375,'fr','Térophyle était un disciple de Iop capable de soulever des masses impressionnantes. Mais malheureusement pour lui, comme tous les Iop trop musclés, l''intelligence n''était pas son fort...');
INSERT INTO "item_descriptions" VALUES(1375,'es','Al-Terófilo era un discípulo Yopuka capaz de levantar pesos impresionantes. Pero desafortunadamente para él, igual que para todos los yopukas demasiado musculosos, la inteligencia no era su fuerte.');
INSERT INTO "item_descriptions" VALUES(1375,'pt','Terophyle era um discípulo de Iop capaz de mover pedras impressionantes... Não é realmente uma prova de inteligência, mas nós não devemos esquecer o fato de que ele era um discípulo de Iop.');
INSERT INTO "item_descriptions" VALUES(1375,'de','Bodi Beilder war ein junger Iop, der dafür berühmt war, gewaltige Gewichte hochstemmen zu können. Unglücklicherweise für ihn gehörte Intelligenz nicht zu seinen Stärken, wie es bei den meisten muskulösen Iops der Fall ist.');
INSERT INTO "item_descriptions" VALUES(1376,'en','This axe might be heavy, but it will take down Trools in a flash. The magic runes it contains can also burn enemies.');
INSERT INTO "item_descriptions" VALUES(1376,'fr','Cette hache, parfois lourde à manier, est parfaite pour terrasser les Trools : les runes magiques qu''elle contient permettent en effet de brûler les ennemis.');
INSERT INTO "item_descriptions" VALUES(1376,'es','Esta hacha, a veces difícil de manejar, es perfecta para acabar con los Trools: las runas mágicas que lleva grabadas permiten quemar a los enemigos.');
INSERT INTO "item_descriptions" VALUES(1376,'pt','Este machado, certas vezes pesado para manusear, é ideal para derrubar Troold. As runas mágicas que ele contém também podem incendiar inimigos.');
INSERT INTO "item_descriptions" VALUES(1376,'de','Diese recht schwere Axt ist ideal, um Trolle zu bekämpfen. Denn die magischen Runen auf ihren Blättern verbrennen diese Gegner gleich an Ort und Stelle.');
INSERT INTO "item_descriptions" VALUES(1377,'en','Hure was a young priest who used weapons freely to spread the word of God. His favourite weapon was an axe on which he inscribed numerous meaningful quotations. His final blows were always accompanied by a blood-curdling supplications, which ended, each word like a hot pin in the victim''s ear, with the phrase "And, you will know my name is The Lord when I lay my vengeance upon thee!"');
INSERT INTO "item_descriptions" VALUES(1377,'fr','Huré était un jeune prêtre qui ne reculait pas devant les armes pour faire progresser la foi. Son arme de prédilection était une hache sur laquelle il avait dessiné de nombreux traits, dont la signification est perdue à jamais...');
INSERT INTO "item_descriptions" VALUES(1377,'es','Mahn era un sacerdote que no vacilaba en usar las armas para que progresara la fe en Amakna. Su arma predilecta era un hacha sobre la cual dibujó numerosas rayas cuya significación se ha perdido para siempre...');
INSERT INTO "item_descriptions" VALUES(1377,'pt','Hure foi um jovem padre que adorava usar armas para espalhar a palavra. Sua arma favorita era um machado em que ele gravou inúmeras linhas... seu significado está perdido para sempre.');
INSERT INTO "item_descriptions" VALUES(1377,'de','Schraxtfur war der Name, den ein junger Priester seiner mächtigen Axt gegeben hatte. Er zögerte nicht, mit seiner mächtigen Axt alle Andersgläubigen niederzustrecken, woraufhin er jedes Mal einen Strich auf das Blatt malte. Wozu dies genau dienen sollte, hat jedoch noch keiner herausgefunden...');
INSERT INTO "item_descriptions" VALUES(1378,'en','Created for young, bloodthirsty warriors, this battle axe makes a deafening noise when it strikes another weapon.');
INSERT INTO "item_descriptions" VALUES(1378,'fr','Cette hache de combat, réservée aux jeunes guerriers, comme son nom l''indique, a la particularité de produire un son strident particulièrement désagréable lorsqu''elle entrechoque une autre arme.');
INSERT INTO "item_descriptions" VALUES(1378,'es','Esta hacha de combate, reservada para los jóvenes guerreros, tiene la particularidad; como su nombre lo indica; de producir un sonido estridente y particularmente desagradable cuando choca contra otra arma.');
INSERT INTO "item_descriptions" VALUES(1378,'pt','Este machado de batalha é designado para jovens guerreiros que têm, como o seu nome indica, a particularidade de fazer um barulho estridente e desagradável cada vez que bate em outra arma.');
INSERT INTO "item_descriptions" VALUES(1378,'de','Ramms schwere Steinaxt besteht trotz ihres verwirrenden Namen aus reinem Metall. Sie hat die Eigenschaft, beim Aufschlag auf das Ziel oder auf andere Waffen einen unangenehm lauten, schrillen Ton von sich zu geben.');
INSERT INTO "item_descriptions" VALUES(1383,'en','It took many, many years and many, many smiths to forge this hammer. The result is a magnificent weapon which has unfortunately inherited a particular concept of efficiency from its creators.');
INSERT INTO "item_descriptions" VALUES(1383,'fr','Ce marteau a été forgé pendant des années et des années, par des dizaines de forgerons. Au final, on retrouve une arme splendide, mais qui a malheureusement hérité de ses concepteurs une certaine idée de la vitesse.');
INSERT INTO "item_descriptions" VALUES(1383,'es','Este martillo ha sido forjado durante años y años, por decenas de herreros. Al final, llega a ser una espléndida arma, pero que heredó desgraciadamente de una determinada idea de la velocidad por parte de sus creadores.');
INSERT INTO "item_descriptions" VALUES(1383,'pt','Levou muitos e muitos anos para ferreiros forjarem este martelo. Enfim, ele é uma arma magnífica que infelizmente herdou a velocidade padrão de seus criadores.');
INSERT INTO "item_descriptions" VALUES(1383,'de','Dieser Hammer ging viele Jahrzehnte lang durch die Hände Dutzender Schmiede, die jeweils ein wenig daran weitergearbeitet haben. Das Endergebnis kann sich wirklich sehen lassen, doch hat der Hammer leider von den vielen Erschaffern auch deren Vorstellungen einer kurzen Zeitdauer geerbt.');
INSERT INTO "item_descriptions" VALUES(1393,'en','This Hammer was made from a clock, the famous clock swallowed by the Crocodyl when it devoured the hand of Captain Hawkfish. Though the clock has been located, the hand is still missing. Hawkfish''s hand that is... the clock was in surprisingly good... oh, forget it.');
INSERT INTO "item_descriptions" VALUES(1393,'fr','Ce marteau a été fabriqué à partir d''une horloge, la fameuse horloge avalée par le Crocodaille qui avait dévoré la main du Captain'' Brochet. Si on a pu récupérer l''horloge, on ne sait en revanche pas ce qu''il est advenu de la main...');
INSERT INTO "item_descriptions" VALUES(1393,'es','Este martillo se fabricó a partir de un reloj, el famoso reloj tragado por el cocodrail que había devorado la mano del capitán Garfeo. Aunque se pudo recuperar el reloj, no se sabe lo que ha ocurrido con la mano...');
INSERT INTO "item_descriptions" VALUES(1393,'pt','Este Martelo foi feito de um relógio, o famoso relógio tragado pelo Crocodyl que devorou a mão de Capitão Hawkfish. Entretanto, botamos a mão no relógio, a mão ainda está faltando...');
INSERT INTO "item_descriptions" VALUES(1393,'de','Dieser Hammer wurde aus Teilen eines Uhrwerkes gebaut. Nämlich des Uhrwerkes, das vom Crocodyll verschlungen wurde, welches gleichfalls die Hand von Käpt''n Gurk verspeist hatte. Während man das Uhrwerk heil wiedergefunden hat, weiß niemand genau, was aus der Hand des Kapitäns geworden ist.');
INSERT INTO "item_descriptions" VALUES(1399,'en','Just like the amulet of the same name, the Aclou Mallet can transform your vital energy into strength. To be used in moderation.');
INSERT INTO "item_descriptions" VALUES(1399,'fr','Tout comme l''amulette du même nom, le Maillet Aclou a la particularité de transformer votre énergie vitale en puissance. À consommer avec modération...');
INSERT INTO "item_descriptions" VALUES(1399,'es','Como el amuleto del mismo nombre, la maza Clavito tiene la particularidad de transformar tu energía vital en potencia. Consúmase con moderación...');
INSERT INTO "item_descriptions" VALUES(1399,'pt','Assim como o amuleto de mesmo nome, o Aclou Mallet pode transformar sua energia vital em força. Use com moderação.');
INSERT INTO "item_descriptions" VALUES(1399,'de','Wie auch das Amulett des gleichen Namens wandelt Elnags Schlägel eure Lebensenergie direkt in magische Energie um. Nur in Maßen zu verwenden!');
INSERT INTO "item_descriptions" VALUES(1403,'en','This hammer once belonged to Aha, a young Osamodas who wasted all his days telling painful one-liners. The hammer couldn''t break open a hazelnut, but it''s useful for breaking the ice from time to time.');
INSERT INTO "item_descriptions" VALUES(1403,'fr','Ce marteau a appartenu à Tau, un jeune disciple d''Osamodas qui passait son temps à raconter des blagues stupides. Son marteau, tout comme lui, ne rend pas très intelligent, mais peut parfois détendre l''atmosphère...');
INSERT INTO "item_descriptions" VALUES(1403,'es','Este martillo perteneció a Haimito, un joven discípulo de Osamodas que se pasaba el tiempo contando chistes estúpidos. Su martillo, no te volverá más inteligente que Haimito pero a veces puede apaciguar tensiones.');
INSERT INTO "item_descriptions" VALUES(1403,'pt','Este martelo pertenceu a Tau, um jovem discípulo de Osamodas que passava todo o seu tempo contando piadas estúpidas. Conseqüentemente, este martelo realmente não faz pessoas ficarem inteligentes, mas pode atenuar a atmosfera às vezes.');
INSERT INTO "item_descriptions" VALUES(1403,'de','Dieser Hammer gehörte früher Otto, einem jungen Osamodas, der den lieben langen Tag lang nur Witze erzählte. Sein Hammer ist genau wie er. Er erhöht nicht gerade die Intelligenz seiner Umgebung, doch kann er tierisch entspannend auf sie wirken.');
INSERT INTO "item_descriptions" VALUES(1404,'en','So you like animals? So did Toh''Lo. He devoted his whole life to helping them out. This hammer kind of represents his relationship with animals, a communion as shaky as a lame Gobball on a freshly gravelled driveway.');
INSERT INTO "item_descriptions" VALUES(1404,'fr','Vous aimez les animaux ? Toh''Lo aussi. Il leur avait même voué sa vie. Ce marteau raconte un peu son histoire , une grande communion avec les bêtes...');
INSERT INTO "item_descriptions" VALUES(1404,'es','¿Te gustan los animales? A Besti también. Incluso les había dedicado su vida. Este martillo cuenta un poco su historia: una gran comunión con los animales, tan ágil como un jalató cojo con solo 2 dedos en cada pata.');
INSERT INTO "item_descriptions" VALUES(1404,'pt','Você gosta de animais? Toh''Lo também. Ele até dedicou sua vida a esta causa. Este martelo de certo modo representa sua vida: uma grande comunhão com animais, uma comunhão tão instável quanto um gobball manco com apenas 2 dedos do pé.');
INSERT INTO "item_descriptions" VALUES(1404,'de','Mögt ihr Tiere? Zum Beispiel Minotorors? Tonhammeri auch. Er hat ihnen sogar sein Leben gewidmet. Dieser Hammer erzählt ein wenig seine traurige Geschichte. Beispielsweise, wie er in Gemeinschaft mit seinen Tieren lebte und mit ihnen auf die Jagd ging, genauso flink, wie ein humpelnder Fresssack auf 2 Hufen. Einfach rührend!');
INSERT INTO "item_descriptions" VALUES(1426,'en','Layte, the creator of this shovel, was a devoted disciple of Iop. You can guess what this guy''s major flaw was.');
INSERT INTO "item_descriptions" VALUES(1426,'fr','Thart'', le créateur de cette pelle, était un disciple de Iop. Un nom prédestiné, pour un Iop, n''est-ce pas ?');
INSERT INTO "item_descriptions" VALUES(1426,'es','Patarta fue el creador de esta pala, era un discípulo de Yopuka. Un nombre predestinado para un yopuka. ¿Verdad?');
INSERT INTO "item_descriptions" VALUES(1426,'pt','Thart, o criador desta pá, era um discípulo de Iop. Um nome profético para um destes discípulos, não é?');
INSERT INTO "item_descriptions" VALUES(1426,'de','Kuch Henweg, der Erschaffer dieser Schaufel, war ein typischer Iop. Jahrelang suchte er nach einem Schreiber, der ihm seinen Namen auf die Schaufel ritzen würde. Doch kam es nie dazu, weil er stets alle Schreiber während seiner unkontrollierbaren Jähzornattacken mit seiner Schaufel henwegzuschaufeln pflegte...');
INSERT INTO "item_descriptions" VALUES(1427,'en','This shovel is used by the Kanniball High Priests of Moon Island to invoke Zebuth, one of their gods who is often depicted as a cow. Only vile characters use it.');
INSERT INTO "item_descriptions" VALUES(1427,'fr','Cette pelle est utilisée par les grands prêtres Kannibouls de l''île de Moon pour invoquer Zébuth, une de leurs divinités souvent représentée sous une forme bovine. Seuls les personnages vils peuvent utiliser cette arme.');
INSERT INTO "item_descriptions" VALUES(1427,'es','Los sacerdotes kaníbolas de Isla de Moon utilizan esta pala para invocar a Zebuth, una de sus divinidades a menudo representada bajo una forma vacuna. Solo los personajes viles pueden utilizar esta arma.');
INSERT INTO "item_descriptions" VALUES(1427,'pt','Esta pá é usada pelos Grandes Sacerdotes Kanniball da Ilha da Lua para invocar o Zebuth, um de seus deuses freqüentemente descritos como um bovino. Somente pessoas vis podem usar esta arma.');
INSERT INTO "item_descriptions" VALUES(1427,'de','Diese Schaufel wird von den kannibällischen Priestern der Moon-Insel ausschließlich dazu genutzt, Zebub zu beschwören, eine Gottheit mit dem Kopf einer Kuh. Wozu das? Wer weiß... Achtung: Nur Charaktere böser Gesinnung können diese Waffe führen!');
INSERT INTO "item_descriptions" VALUES(1430,'en','This shovel, created by Mechba, is used by Enutrof followers to knock nuts from trees. On the battlefield, it has a similar function. Yowza!');
INSERT INTO "item_descriptions" VALUES(1430,'fr','Cette pelle est utilisée par les Enutrof pour cueillir des fruits dans les arbres, mais elle peut s''avérer une arme de combat redoutable. Comme dirait son créateur, Mechba : ''eche est beche, ma pelle''.');
INSERT INTO "item_descriptions" VALUES(1430,'es','Esta pala era utilizada por los anutrofs para recoger frutas en los árboles, pero también puede resultar un arma de combate temible. Como diría su creador, el viejo Joudi: «Ezta ez mi pala, eczizten muzas como ezta, pero ezta ez la mía y ez la máz bonita».');
INSERT INTO "item_descriptions" VALUES(1430,'pt','Esta pá, criada por Mechba, é usada pelos discípulos de Enutrof para colher frutas das árvores. Também é uma terrível arma de batalha.');
INSERT INTO "item_descriptions" VALUES(1430,'de','Deils Schippe ist so kunstvoll gefertigt und wunderschön anzusehen, dass alle Frauen bei ihrem Anblick schwach werden. Allerdings sollte man niemals vergessen, dass es sich dabei um eine blanke, scharfe Waffe handelt. Oder mit den Worten Deils ausgedrückt: "Sie ist so scharf, sie ist so schick, sie ist so hip, meine Schipp''!"');
INSERT INTO "item_descriptions" VALUES(1432,'en','Gaston Houze, gardener and disciple of Enutrof, planted too many plants. It had to be said... There, I''ve said it. What''s more this worn spade is the evidence of his dirty business. Never talk to this thing, it''ll tell you stories, don''t believe a word, it''ll have you digging yourself into your own grave before you know it... and then where will you be? I hate this damn thing.');
INSERT INTO "item_descriptions" VALUES(1432,'fr','Gaston Houze, jardinier disciple d''Enutrof, avait tendance à toujours trop abuser des plantes. Cette arme en est la preuve : puissante, elle aura tendance à vous jouer des tours et à mettre à mal votre intelligence.');
INSERT INTO "item_descriptions" VALUES(1432,'es','Kolokón era un jardinero discípulo de Anutrof, tenía cierta tendencia en abusar demasiado de las plantas. Esta arma lo demuestra: es tan poderosa que te puede dar mareos y engañar tu sentido de la percepción.');
INSERT INTO "item_descriptions" VALUES(1432,'pt','Gaston Houze, um jardineiro discípulo de Enutrof, fazia grandes amontoados para as plantas. Esta arma é uma boa prova disto; poderosa, ela pregará peças em você e aquecerá sua inteligência.');
INSERT INTO "item_descriptions" VALUES(1432,'de','Fel, ein alter Enutrof-Gärtner, pflegte überall im Übermaß Blumen zu pflanzen und jedem damit auf die Nerven zu gehen. Daher bekam alles, was er je anrührte, den Spitznamen "Fels Gartenschau". Seine Waffe ist kein bisschen besser: Sie ist zwar mächtig, doch tut sie alles im Überfluß und steigert nicht gerade die Intelligenz ihres Trägers.');
INSERT INTO "item_descriptions" VALUES(1433,'en','This shovel was once a self-defence weapon used by a small group of female Enutrof''s followers. Once they had even this puny pile of power in their clutches, they turned into horrible crea.......');
INSERT INTO "item_descriptions" VALUES(1433,'fr','Cette pelle fut l''arme d''autodéfense d''un petit groupe d''Enutrofettes. Ces dames, une fois l''instrument de puissance entre leurs mains, changèrent du tout au tout et tentèrent de conquérir le monde.');
INSERT INTO "item_descriptions" VALUES(1433,'es','Esta pala fue el arma de defensa personal de un pequeño grupo de anutrofitas. Estas damas, una vez el instrumento de potencia entre sus manos, cambiaron completamente e intentaron conquistar el mundo.');
INSERT INTO "item_descriptions" VALUES(1433,'pt','Esta pá foi uma arma de defesa pessoal usada por um grupo pequeno de seguidoras de Enutrof. Uma vez que estas senhoras tinham esse poder em suas mãos, falavam para elas mesmas que a conquista do mundo não era apenas história dos homens.');
INSERT INTO "item_descriptions" VALUES(1433,'de','Hin war ein exzentrischer Enutrof Richter, der statt eines Hammers immer seine Schaufel verwendete, um Urteilssprüche zu verkünden. Da er auch gleichfalls unerkannterweise der Henker des Ortes war, konnte er mit ihr auch gleich das Urteil vollstrecken. Praktisch, nicht wahr?');
INSERT INTO "item_descriptions" VALUES(1435,'en','Very heavy shovel. For fa... um, big boned adventurers.');
INSERT INTO "item_descriptions" VALUES(1435,'fr','Pelle très lourde, donc réservée à l''usage des aventuriers les plus gr... larges.');
INSERT INTO "item_descriptions" VALUES(1435,'es','Muy pesada, por lo tanto está reservada para los aventureros más gor... desarrollados.');
INSERT INTO "item_descriptions" VALUES(1435,'pt','Pá muito pesada. Para aventureiros gor... hum, robustos.');
INSERT INTO "item_descriptions" VALUES(1435,'de','Diese extrem schwere Schaufel ist besonders für fe... ähm... starke Abenteurer geeignet.');
INSERT INTO "item_descriptions" VALUES(1436,'en','Ikan was Churros the Warrior''s little fish. The shovel doesn''t look a thing like the creature, but the smell is almost identical.');
INSERT INTO "item_descriptions" VALUES(1436,'fr','Ikan était le petit poisson de Chourros le guerrier. Il est important de préciser que le nom de cette pelle n''a aucun rapport avec ce poisson, mais plutôt avec son odeur...');
INSERT INTO "item_descriptions" VALUES(1436,'es','Kran era la mascota de un aventurero muy famoso en Amakna llamado Shikteniku. Esta pala sirvió para el entierro de Kran, que había sido picado por un moskito mientras que Shikteniku satisfacía una necesidad natural...');
INSERT INTO "item_descriptions" VALUES(1436,'pt','Ikan era o peixinho de Chourros, o guerreiro. Note que o nome desta pá não tem relação com o peixe, e sim com seu cheiro.');
INSERT INTO "item_descriptions" VALUES(1436,'de','Ikan war der kleine Fisch von Chourros dem Krieger. Man muss beachten, dass der Name dieser Schaufel keinen Bezug auf diesen Fisch, sondern eher auf seinen Geruch hat ...');
INSERT INTO "item_descriptions" VALUES(1438,'en','This pick is considered a lucky charm, although anyone depending on a pick to make their living has usually seen that boat sail a long time ago.');
INSERT INTO "item_descriptions" VALUES(1438,'fr','Cette pioche est considérée dans de nombreux clans comme un talisman portant chance.');
INSERT INTO "item_descriptions" VALUES(1438,'es','Este pico es considerado en numerosos clanes como un talismán que trae suerte.');
INSERT INTO "item_descriptions" VALUES(1438,'pt','Esta picareta é considerada um talismã da sorte.');
INSERT INTO "item_descriptions" VALUES(1438,'de','Dieser Pickel wird von vielen Bergarbeiter-Clans als mächtiger Glücksbringer angesehen.');
INSERT INTO "item_descriptions" VALUES(1439,'en','This pick seems to bring the evil eye upon you. With a few alterations here and there, perhaps you could have a great pick on your hands.');
INSERT INTO "item_descriptions" VALUES(1439,'fr','Cette pioche a tendance à attirer le mauvais oeil. Cependant, il parait qu''il n''y manquerait pas grand chose pour qu''elle devienne une grande pioche');
INSERT INTO "item_descriptions" VALUES(1439,'es','Este pico tiende a atraer el mal de ojo. Sin embargo, parece que falta no mucho para que se convierta en un gran pico.');
INSERT INTO "item_descriptions" VALUES(1439,'pt','Esta picareta parece atrair mau-olhado. Entretanto, dizem que não demoraria muito para transformá-la em uma ótima picareta.');
INSERT INTO "item_descriptions" VALUES(1439,'de','Dieser Pickel neigt dazu, Murphys Auge auf den Träger zu werfen. Allerdings würde, so sagt man, gar nicht viel fehlen, damit diesem der ganz große Wurf gelänge.');
INSERT INTO "item_descriptions" VALUES(1474,'en','This ultra-powerful amulet is the fruit of the expert time-mastery of an old Xelor.');
INSERT INTO "item_descriptions" VALUES(1474,'fr','Cette amulette surpuissante est le fruit du travail sur la maîtrise du temps d''un très vieux Xélor.');
INSERT INTO "item_descriptions" VALUES(1474,'es','Este poderosísimo amuleto es el fruto del trabajo de un viejo Xelor sobre el dominio del tiempo.');
INSERT INTO "item_descriptions" VALUES(1474,'pt','Este amuleto extremamente poderoso é o fruto do trabalho de um seguidor do velho Xelor nos tempos de maestria.');
INSERT INTO "item_descriptions" VALUES(1474,'de','Dieses überaus mächtige Amulett ist das Ergebnis der langen Arbeit eines sehr alten Xélor-Anhängers zur Meisterung der Zeit.');
INSERT INTO "item_descriptions" VALUES(1475,'en','The Pretty Blade has been crafted by the renowned blacksmith Dave-LoL, just before he died for the sake of the prettiest girl in the kingdom, a Iop. It is said that the efficiency of the blade is only matched by the grace of the wearer.');
INSERT INTO "item_descriptions" VALUES(1475,'fr','La Zulie Lame a été forgée par le célèbre forgeron Dave-Lol avant de mourir, pour la plus jolie des iopettes du royaume. On dit que cette lame n''a d''égal que la beauté de son porteur.');
INSERT INTO "item_descriptions" VALUES(1475,'es','La Bunita Hoja ha sido crafteada por el célebre herrero Dave-LoL antes de morirse por la más bunita de las yopukitas del reino. Dicen que solamente la belleza de su portador puede igualar la eficiencia de esta espada.');
INSERT INTO "item_descriptions" VALUES(1475,'pt','A Espada Elegante foi forjada pelo famoso ferreiro Dave-LoL, pouco antes de ele morrer por causa da menina mais bonita do reino, uma seguidora feminina de Iop. Diz-se que a eficiência dessa espada se adapta apenas à boa-vontade do portador.');
INSERT INTO "item_descriptions" VALUES(1475,'de','Das zöne Zwert von Zulie wurde vom berühmten Waffenschmied Dave-LoL kurz vor seinem Tode geschmiedet, der es Zulie, der zönsten Iopine des Reiches vermachte. Man sagt, die Schönheit dieses Schwertes könne sich nur mit der Schönheit seines Trägers messen... Und wenn sie nicht gestorben sind, dann zönen sie noch heute.');
INSERT INTO "item_descriptions" VALUES(1476,'en','This powerful pendant contains the life-blood of the Crackler, that is to say all the items he gathered before he was killed by some jealous adventurer.');
INSERT INTO "item_descriptions" VALUES(1476,'fr','Cette puissante amulette contient toute la vie du Craqueleur, tous les objets qu''il a récoltés avant de mourir sous les coups de butoir d''aventuriers attirés par ses richesses.');
INSERT INTO "item_descriptions" VALUES(1476,'es','Este poderoso amuleto contiene toda la vida del crujidor, todos los objetos que ha reunido antes de morir bajo los golpes de aventureros sedientos de sus riquezas.');
INSERT INTO "item_descriptions" VALUES(1476,'pt','Este poderoso amuleto contém a vida do Crackler, quer dizer, todos os itens que ele juntou antes de morrer sob golpes de aventureiros que desejavam seus tesouros.');
INSERT INTO "item_descriptions" VALUES(1476,'de','Dieses mächtige Amulett enthält das gesamte Leben eines Krachlers, mitsamt allen Gegenständen, die dieser ins Herz geschlossen hatte. Zumindest bevor er unter den brutalen Schlägen gieriger Abenteurer nach langem Leiden sein Leben aushauchte.');
INSERT INTO "item_descriptions" VALUES(1477,'en','Mulette was a little female Ecaflip dogged by bad luck... until her grandmother presented her with this amulet.');
INSERT INTO "item_descriptions" VALUES(1477,'fr','Mulette était une petite Ecaflipette qui n''a jamais eu de chance dans sa vie, jusqu''au jour où sa grand-mère lui offrit cette amulette.');
INSERT INTO "item_descriptions" VALUES(1477,'es','Amulata era una pequeña zurcarák que nunca tuvo suerte en su vida, hasta el día en que su abuela le regaló este amuleto.');
INSERT INTO "item_descriptions" VALUES(1477,'pt','Mulette era uma pequena Ecaflip vencida pela má sorte, até que sua avó ofereceu este amuleto.');
INSERT INTO "item_descriptions" VALUES(1477,'de','Mulette ist ein kleines Ecaflippchen, das in ihrem Leben noch niemals eine Glückssträhne hatte, bis sie eines Tages dieses Amulett von ihrer Großmutter bekam.');
INSERT INTO "item_descriptions" VALUES(1478,'en','This pendant will make you feel more harmonious.');
INSERT INTO "item_descriptions" VALUES(1478,'fr','Ce pendentif aide son porteur à se retrouver en paix avec le monde qui l''entoure.');
INSERT INTO "item_descriptions" VALUES(1478,'es','Este colgante ayuda a su portador a encontrar la paz en el mundo que le rodea.');
INSERT INTO "item_descriptions" VALUES(1478,'pt','Este pingente fará você sentir uma paz com o mundo ao seu redor.');
INSERT INTO "item_descriptions" VALUES(1478,'de','Dieser Anhänger ermöglicht es seinem Träger, in Frieden und Harmonie mit der Umgebung zu leben.');
INSERT INTO "item_descriptions" VALUES(1479,'en','This legendary Hammer has already proved itself in Amakna. It belonged to the powerful Cardboard Twot who used it to transform his opponents into confetti and papier-mâché.');
INSERT INTO "item_descriptions" VALUES(1479,'fr','Ce marteau légendaire a déjà fait ses preuves en Amakna, appartenant au puissant Twote en Carton, qui n''hésita jamais à s''en servir, pour réduire ses adversaires en patte à mâcher et confettis.');
INSERT INTO "item_descriptions" VALUES(1479,'es','Este martillo legendario ya hizo sus pruebas en Amakna. Pertenecía al potente Twote de Cartón, que no dudó nunca en utilizarlo para convertir a sus adversarios en tortilla sin patatas.');
INSERT INTO "item_descriptions" VALUES(1479,'pt','Este lendário Martelo já demonstrou sua capacidade em Amakna. Ele pertenceu ao poderoso Twot em Papelão que o usou por vontade própria para transformar seus oponentes em confete e papel machê.');
INSERT INTO "item_descriptions" VALUES(1479,'de','Dieser legendäre Hammer ging  in Amakna bereits durch viele Hände. Er gehörte einst Hautscheputt, der nie auch nur eine Sekunde zögerte, seine Gegner damit zu Klump zu schlagen.');
INSERT INTO "item_descriptions" VALUES(1480,'en','This pendant will make you feel at peace with the World.');
INSERT INTO "item_descriptions" VALUES(1480,'fr','Ce pendentif aide son porteur à se retrouver en paix avec le monde qui l''entoure.');
INSERT INTO "item_descriptions" VALUES(1480,'es','Este colgante ayuda a su portador a encontrar la paz en el mundo que le rodea.');
INSERT INTO "item_descriptions" VALUES(1480,'pt','Este pendente fará você se sentir em paz com o mundo.');
INSERT INTO "item_descriptions" VALUES(1480,'de','Dieser Anhänger ermöglicht es seinem Träger, in Frieden und Harmonie mit der Umgebung zu leben.');
INSERT INTO "item_descriptions" VALUES(1481,'en','This pendant will make you grant you greater understanding of the World around you.');
INSERT INTO "item_descriptions" VALUES(1481,'fr','Ce pendentif aide son porteur à se retrouver en paix avec le monde qui l''entoure.');
INSERT INTO "item_descriptions" VALUES(1481,'es','Este colgante ayuda a su portador a encontrar la paz en el mundo que le rodea.');
INSERT INTO "item_descriptions" VALUES(1481,'pt','Este pingente o fará se sentir em paz com o mundo à volta.');
INSERT INTO "item_descriptions" VALUES(1481,'de','Dieser Anhänger ermöglicht es seinem Träger, in Frieden und Harmonie mit der Umgebung zu leben.');
INSERT INTO "item_descriptions" VALUES(1482,'en','This is an extremely useful amulet, but it turns its wearer as white as a Gobball.');
INSERT INTO "item_descriptions" VALUES(1482,'fr','Cette amulette est extrêmement utile, mais rend son porteur blanc comme un bouftou.');
INSERT INTO "item_descriptions" VALUES(1482,'es','Este amuleto es extremadamente útil, pero hace que su portador se vuelva blanco como un jalató.');
INSERT INTO "item_descriptions" VALUES(1482,'pt','Este amuleto é extremamente útil, mas ele deixa seu portaor tão branco quanto um Papatudo.');
INSERT INTO "item_descriptions" VALUES(1482,'de','Dieses Amulett ist sehr nützlich, doch erscheint sein Träger damit noch weißer als ein Fresssack.');
INSERT INTO "item_descriptions" VALUES(1483,'en','A mysterious symbol of a mysterious organization... by the way, it doesn''t exist and you''ve never heard of it, understand?');
INSERT INTO "item_descriptions" VALUES(1483,'fr','Symbole mystérieux d''un organisme mystérieux. D''ailleurs il n''existe pas, et vous n''en avez jamais entendu parler !');
INSERT INTO "item_descriptions" VALUES(1483,'es','Se trata del símbolo de un misterioso organismo. De hecho no existe ¡Y jamás has oído hablar de él!');
INSERT INTO "item_descriptions" VALUES(1483,'pt','Um símbolo misterioso de uma organização misteriosa... a propósito, não existe e você nunca ouviu falar, entendeu?');
INSERT INTO "item_descriptions" VALUES(1483,'de','Ein mysteriöses Symbol eines mysteriösen Geheimbundes. Ihr habt nichts gehört und der Bund existiert auch nicht. Ihr habt diese Beschreibung auch niemals gelesen. Sie zerstört sich selbsttätig in 5...4...3...2...1.');
INSERT INTO "item_descriptions" VALUES(1485,'en','This amulet is said to be a modified version of the Golden Destiny... which is really strange when you think that these two amulets have nothing in common except their ridiculous appearance.');
INSERT INTO "item_descriptions" VALUES(1485,'fr','Cette amulette, est une amélioration de La Destinée Dorée. Étrangement, elles n''ont rien en commun, excepté leur aspect assez ridicule, il faut le reconnaître.');
INSERT INTO "item_descriptions" VALUES(1485,'es','Este amuleto es un perfeccionamiento de El Destino Dorado. Aunque parezca extraño, no tienen nada en común, excepto su aspecto bastante ridículo, hay que reconocerlo.');
INSERT INTO "item_descriptions" VALUES(1485,'pt','Este amuleto é o modelo modificado do Destino Dourado, o que é muito estranho quando você pensa que esses dois amuletos não têm nada em comum a não ser o seu aspecto ridículo.');
INSERT INTO "item_descriptions" VALUES(1485,'de','Dieses Amulett ist eine verbesserte Version der Goldenen Zukunft. Seltsamerweise haben beide überhaupt nichts gemein, mit Ausnahme ihres lächerlichen Aussehens.');
INSERT INTO "item_descriptions" VALUES(1486,'en','Holy was a female Iop, intent on spreading Evil throughout the land. Renowned for her incredible composure, she would never get angry except when people compared her to someone named Oly.');
INSERT INTO "item_descriptions" VALUES(1486,'fr','Holy était une disciple de Iop qui avait juré de terrasser le mal où qu''il soit. D''un calme redoutable, elle ne s''énervait jamais sauf quand on la comparait à une certaine Oly.');
INSERT INTO "item_descriptions" VALUES(1486,'es','Manduca era una discípula de Yopuka que había prometido derrotar el mal dondequiera que esté. Mantenía una calma increíble, nunca se enfadaba aparte cuando la comparaban con una tal Lacena.');
INSERT INTO "item_descriptions" VALUES(1486,'pt','Holy era uma seguidora de Iop, que tinha a intenção de derrubar o Mal por toda a parte. Conhecida por sua incrível compostura, ela nunca ficava furiosa, exceto quando comparavam-na com alguém chamado Oly.');
INSERT INTO "item_descriptions" VALUES(1486,'de','Holy war eine Anhängerin von Iop, die den Schwur ablegte, das Böse mitsamt der Wurzel herauszureißen, wo auch immer es sich verstecken mag. Ihre vollkommene Selbstbeherrschung und gefährliche Ruhe konnte einzig dadurch gebrochen werden, dass man sie mit einer gewissen Oly verglich.');
INSERT INTO "item_descriptions" VALUES(1487,'en','Not only is this belt elegant, it also massages you as you walk... You''d be surprised what a back rub can do for your murderous instinct.');
INSERT INTO "item_descriptions" VALUES(1487,'fr','Cette ceinture, en plus d''habiller d''une manière élégante, procure à son porteur un effet massant vraiment agréable. L''heureux propriétaire, moins stressé, est alors plus apte à réfléchir.');
INSERT INTO "item_descriptions" VALUES(1487,'es','Este cinturón, además de favorecerte mucho, te proporcionará unos masajes muy agradables. Al reducir la ansiedad, te resultará más fácil sumirte en profundas reflexiones.');
INSERT INTO "item_descriptions" VALUES(1487,'pt','Este cinto não é apenas elegante, mas também relaxante. Realmente, ele massageia o seu portador. Mais feliz e bem menos estressado, o portador fica em melhores condições para pensar.');
INSERT INTO "item_descriptions" VALUES(1487,'de','Dieser tolle Gürtel kleidet ihn nicht nur elegant, er massiert auch noch seinen Träger. Der glückliche Besitzer leidet dadurch viel weniger unter Stress und kann so besser nachdenken.');
INSERT INTO "item_descriptions" VALUES(1488,'en','This strange name refers to an equally strange item made from previous amulets... goodness knows how. We know just as little about the circumstances in which it was found.');
INSERT INTO "item_descriptions" VALUES(1488,'fr','Sous ce nom étrange se cache un objet tout aussi étrange, né on ne sait trop comment de précédentes amulettes. On ignore tout des circonstances dans lesquelles elle a été découverte.');
INSERT INTO "item_descriptions" VALUES(1488,'es','Este nombre extraño designa un objeto igual de extraño nacido, no se sabe bien cómo, de anteriores amuletos. Las circunstancias de su descubrimiento siguen sin conocerse.');
INSERT INTO "item_descriptions" VALUES(1488,'pt','Este estranho nome vem de um estranho objeto feito, só Deus sabe, de amuletos prévios. Nós não sabemos nada das circunstâncias nas quais ele foi encontrado...');
INSERT INTO "item_descriptions" VALUES(1488,'de','Hinter diesem seltsamen Namen versteckt sich ein ebenso seltsamer Gegenstand, der irgendwie aus den vorhergehenden Amuletten hervorgegangen ist. Über die genauen Umstände seiner Entdeckung ist nichts bekannt.');
INSERT INTO "item_descriptions" VALUES(1489,'en','With this near-perfect pin, you''ll have the Wisdom of an Irish salmon. It''s great for group therapy sessions among friends. Don''t forget to bring some tissues, though, it can get emotional!');
INSERT INTO "item_descriptions" VALUES(1489,'fr','Hète était l''un des plus grands guerriers d''Amakna. La légende dit qu''il tirait sa sagesse de la broche qu''il portait toujours sur lui.');
INSERT INTO "item_descriptions" VALUES(1489,'es','Heta era uno de los más grandes guerreros de Amakna. Cuenta la leyenda que sacaba su fuerza del broche que llevaba siempre puesto.');
INSERT INTO "item_descriptions" VALUES(1489,'pt','Mhete foi um dos mais valentes guerreiros de Amakna. A lenda diz que a sua sabedória vinha do broche que usava.');
INSERT INTO "item_descriptions" VALUES(1489,'de','Hète war einer der größten Krieger ganz Amaknas. Der Legende nach zog er all seine Weisheit aus dieser Brosche, die er immer bei sich trug.');
INSERT INTO "item_descriptions" VALUES(1490,'en','The creator of this chain, someone called Ken Aton, was renowned for his strange habits. He spent all his time hunting the Minotoror for his coat which he wanted to make into a merkin.');
INSERT INTO "item_descriptions" VALUES(1490,'fr','Son créateur, un certain Ken Aton, était très célèbre pour ses habitudes assez étranges. Il passait ses journées à chasser le Minotoror pour se fabriquer une moquette pectorale.');
INSERT INTO "item_descriptions" VALUES(1490,'es','Su creador, un tal Ken Aton, era muy conocido por sus extrañas costumbres. Se pasaba el día intentando cazar al Minotauroro para hacerse una moqueta pectoral.');
INSERT INTO "item_descriptions" VALUES(1490,'pt','Seu criador, um tal Ken Aton, era famoso por seus hábitos estranhos. Ele gastou todo o seu tempo caçando o Minotoro para fazer uma proteção peitoral para si mesmo.');
INSERT INTO "item_descriptions" VALUES(1490,'de','Der Erschaffer, ein gewisser Ken Aton, war für seine seltsamen Gewohnheiten bekannt. Er verbrachte ganze Tage damit, Minotorors zu jagen, um daraus für sich selbst diverse Oberkörperbekleidungen herzustellen.');
INSERT INTO "item_descriptions" VALUES(1491,'en','The Liche was a dirty creature known for infiltrating the ranks of valiant warriors in order to steal food. Marmalade and toast was his favourite. But one day, the warriors saw through its little game and the Liche had to run away.');
INSERT INTO "item_descriptions" VALUES(1491,'fr','La Liche était une sale créature connue pour s''incruster dans les groupes de valeureux guerriers afin de subtiliser une part du butin. Un jour, son petit manège fut découvert et elle dut prendre la fuite.');
INSERT INTO "item_descriptions" VALUES(1491,'es','El Lich era una asquerosa criatura conocida por acoplarse a los grupos de valientes guerreros para robarles una parte del botín. Un día, su maniobra fue descubierta y tuvo que darse a la fuga.');
INSERT INTO "item_descriptions" VALUES(1491,'pt','O Liche era uma criatura imunda conhecida por se infiltrar nos grupos de guerreiros valentes para roubar uma parte das pilhagens. Mas um dia os guerreiros descobriram este joguinho e o Liche fugiu...');
INSERT INTO "item_descriptions" VALUES(1491,'de','Der Licha ist eine dreckige Kreatur, die dafür bekannt ist, sich bei Gruppen aus tapferen Streitern einzuschmuggeln, um sich einen Teil der Beute anzueignen. Eines Tages flog er damit auf und ist seitdem auf der Flucht.');
INSERT INTO "item_descriptions" VALUES(1493,'en','It is said that this ring emerged out of a Sacrier''s grinning, pus-stuffed wound. Niiice.');
INSERT INTO "item_descriptions" VALUES(1493,'fr','On dit que cet anneau serait issu d''une des nombreuses blessures reçues par un Sacrieur.');
INSERT INTO "item_descriptions" VALUES(1493,'es','Dícese que este anillo nació fruto de una de las numerosas heridas sufridas por un sacrógrito.');
INSERT INTO "item_descriptions" VALUES(1493,'pt','Dizem que este anel é o resultado de vários ferimentos recebidos por um Sacrieur.');
INSERT INTO "item_descriptions" VALUES(1493,'de','Man sagt, dieser Ring sei aus einer der vielen Wunden eines Sacrieurs herausgewachsen.');
INSERT INTO "item_descriptions" VALUES(1494,'en','The main function of this pretty ring was to help Osamodas recognise their Tofus during fights.');
INSERT INTO "item_descriptions" VALUES(1494,'fr','Ce joli anneau avait comme fonction première de permettre aux Osamodas de reconnaître leur tofu dans les combats.');
INSERT INTO "item_descriptions" VALUES(1494,'es','Este hermoso anillo dio la posibilidad a los osamodas de reconocer a su tofu en cada combate.');
INSERT INTO "item_descriptions" VALUES(1494,'pt','A função principal deste belo anel é permitir que Osamodas reconheçam seus tofus durante as lutas.');
INSERT INTO "item_descriptions" VALUES(1494,'de','Die ursprüngliche Funktion dieses Ringes war es, den Osamodas das Erkennen ihres Tofus beim Kampfe zu erleichtern.');
INSERT INTO "item_descriptions" VALUES(1495,'en','This small modest-looking ring was created by Degun. He was more famous for shouting his head off without the slightest reason and his violent aversion to the Liche than for his talent as a jeweller.');
INSERT INTO "item_descriptions" VALUES(1495,'fr','Ce petit anneau qui ne paye pas de mine a été crée par Degun. Ce bijoutier était plus connu pour ses coups de gueule envers tout le monde et sa cruelle aversion pour la Liche, que pour sa créativité en matière d''orfévrerie.');
INSERT INTO "item_descriptions" VALUES(1495,'es','Este pequeño anillo que no tiene nada del otro mundo lo creó Degun. Este joyero saltó a la fama por su mala follá con la gente que le rodeaba y por su consideración despectiva y cruel por el Lich y no por su creatividad en materia de orfebrería.');
INSERT INTO "item_descriptions" VALUES(1495,'pt','Este pequeno anel de aparência modesta foi criado por Degun. Ele era mais conhecido por gritar toda vez que podia e por sua aversão cruel a Liche do que por sua criatividade com jóias.');
INSERT INTO "item_descriptions" VALUES(1495,'de','Dieser kleine Ring, der nicht nach viel aussieht, wurde von Degun hergestellt. Degun ist übrigens besser bekannt für seine plötzlichen Jähzornanfälle und seine starke Abneigung gegen den Licha, als für seine Handwerkskünste.');
INSERT INTO "item_descriptions" VALUES(1496,'en','This ring was made to increase its wearers luck during card games.');
INSERT INTO "item_descriptions" VALUES(1496,'fr','Cet anneau a été créé pour augmenter la chance de son porteur lors de parties de cartes.');
INSERT INTO "item_descriptions" VALUES(1496,'es','Este anillo fue creado para aumentar la suerte de su dueño durante las partidas de cartas.');
INSERT INTO "item_descriptions" VALUES(1496,'pt','Este anel foi criado para aumentar a sorte de seu portador durante as brincadeiras com cards.');
INSERT INTO "item_descriptions" VALUES(1496,'de','Dieser Ring wurde angefertigt, um seinem Träger Glück bein Kartenspiel zu bringen.');
INSERT INTO "item_descriptions" VALUES(1497,'en','Rings forged during Xelor''s temporal journeys.');
INSERT INTO "item_descriptions" VALUES(1497,'fr','Anneaux engendrés lors des voyages temporels de Xélor.');
INSERT INTO "item_descriptions" VALUES(1497,'es','Anillos engendrados durante los viajes de Xelor a través del tiempo.');
INSERT INTO "item_descriptions" VALUES(1497,'pt','Anéis forjados durante as viagens temporais dos Xelor.');
INSERT INTO "item_descriptions" VALUES(1497,'de','Dieser Ring entstand während einer Xélor-Zeitreise.');
INSERT INTO "item_descriptions" VALUES(1498,'en','These rings were cooled from the forge with the tears of Enutrof, shed over his lost shovel. Must have been some shovel!');
INSERT INTO "item_descriptions" VALUES(1498,'fr','Anneaux créés à partir de larmes d''Enutrof ayant perdu sa pelle. Cela donne une idée du désespoir dans lequel peut être plongé le bonhomme.');
INSERT INTO "item_descriptions" VALUES(1498,'es','Anillos creados con las lágrimas de un anutrof que perdió su pala. Lo que demuestra la desesperación en la que se encontraba sumido el pobre hombre.');
INSERT INTO "item_descriptions" VALUES(1498,'pt','Estes anéis foram forjados das lágrimas do Enutrof, que havia perdido sua pá. Você pode dizer que o sujeito foi muito miserável naquele momento!');
INSERT INTO "item_descriptions" VALUES(1498,'de','Diese Ringe wurden in den Tränen eines Enutrofs abgeschreckt, der seine Schaufel verloren hatte. Das gibt einen Eindruck von der tiefen Verzweiflung dieses armen Menschen.');
INSERT INTO "item_descriptions" VALUES(1499,'en','This ring is meant for Enutrofs only. It was enchanted by their God so that the followers would be the only ones to wear it. It allows all god-fearing Enutrofs to be even luckier than usual in treasure hunts.');
INSERT INTO "item_descriptions" VALUES(1499,'fr','Cet anneau est destiné aux seuls Enutrofs. Leur dieu l''a enchanté pour qu''il ne soit porté que par ses disciples. Il permettra à tout Enutrof qui se respecte, d''avoir beaucoup plus de chance pour découvrir des trésors.');
INSERT INTO "item_descriptions" VALUES(1499,'es','Este anillo solo lo pueden llevar los anutrof. Su dios lo ha hechizado para que solamente sus discípulos puedan ponérselo. La suerte de descubrir tesoros caerá del lado de los anutrof de pura cepa.');
INSERT INTO "item_descriptions" VALUES(1499,'pt','Este anel é destinado a pertencer somente aos Enutrofs. Foi encantado pelo Deus deles, de forma que os discípulos fossem os únicos capazes de usá-lo. Permite a qualquer Enutrof que se preze ter mais sorte na caça ao tesouro.');
INSERT INTO "item_descriptions" VALUES(1499,'de','Dieser Ring ist nur für Enutrofs bestimmt. Ihr Gott hat ihn mit einem Zauber versehen, damit er einzig von seinen Anhänger getragen werden kann. Er wird Enutrofs viel Glück bringen und sie neue Schätze entdecken lassen.');
INSERT INTO "item_descriptions" VALUES(1500,'en','Made of many different fibres, this magnificent cloak is unique - just look at that patchwork of colour and the way the light plays on its surface.');
INSERT INTO "item_descriptions" VALUES(1500,'fr','Cette splendide cape, tissée à partir de divers éléments fibreux de toute nature, est une pièce unique de par sa couleur et ses reflets.');
INSERT INTO "item_descriptions" VALUES(1500,'es','Esta maravillosa capa, tejida con diversos elementos de fibra de todo tipo, es una pieza única por su color y sus reflejos.');
INSERT INTO "item_descriptions" VALUES(1500,'pt','Este magnífico manto, feito com muitas fibras diferentes, é uma peça sem igual por causa de sua cor e do modo como a luz brinca em sua superfície.');
INSERT INTO "item_descriptions" VALUES(1500,'de','Dieser tolle Umhang wurde von Hand aus verschiedenen Naturfasern gewoben, was ihn zu einem Unikat macht, sei es durch die satten Farben oder die lebendigen Schattierungen.');
INSERT INTO "item_descriptions" VALUES(1501,'en','This wedding ring will satisfy the most mercenary of fathers-in-law.');
INSERT INTO "item_descriptions" VALUES(1501,'fr','Cette alliance symbolise l''union entre deux âmes follement amoureuses l''une de l''autre. Inutile de conter fleurette caché derrière les buissons, cette fois c''est pour de bon, vous allez pouvoir vous afficher sans scrupules.');
INSERT INTO "item_descriptions" VALUES(1501,'es','Esta alianza te permitirá unirte al ser de tus sueños... Se acabaron los breves revolcones a escondidas detrás de los matorrales, esta vez es la buena, vais a poder mostraros sin escrúpulos.');
INSERT INTO "item_descriptions" VALUES(1501,'pt','Essa aliança simboliza a união entre duas almas perdidamente apaixonadas. Foi-se o tempo dos encontros escondidos atrás de arbustos. Agora vocês podem aparecer em público sem vergonha.');
INSERT INTO "item_descriptions" VALUES(1501,'de','Dieser Trauring wird das Bündnis mit dem Wesen eurer Träume besiegeln... Also: Schluss mit den kleinen Schäferstündchen hinter den Büschen! Dieses Mal geht es ums Ganze, was ihr mit diesem Ring auch jedermann zeigen könnt.');
INSERT INTO "item_descriptions" VALUES(1503,'en','It is said that to create this wand, it is put into a warm corpse, which is then buried shortly afterwards. No one dares to imagine by what route exactly the wand is put into the dead body.');
INSERT INTO "item_descriptions" VALUES(1503,'fr','Pour la fabrication de cette baguette lugubre, on dit qu''il faut mettre la baguette dans le corps d''un cadavre frais, et l''enterrer peu après. Mais personne n''ose imaginer comment faire.');
INSERT INTO "item_descriptions" VALUES(1503,'es','Para la fabricación de esta lúgubre varita, dicen que hay que meterla dentro de un cadáver fresco y enterrarlo poco después. Pero nadie osaría imaginar cómo hacer eso...');
INSERT INTO "item_descriptions" VALUES(1503,'pt','Na criação esta varinha foi posta num cadáver recente, e então rapidamente enfiada. Ninguém imaginaria como exatamente a varinha foi posta no corpo do morto.');
INSERT INTO "item_descriptions" VALUES(1503,'de','Es heißt, dass es zur Herstellung dieses schaurigen Gegenstandes nötig sei, das Holz des Stabes in einen frischen Kadaver einzuführen, welcher dann anschließend beerdigt werden muss. Doch wagte es bisher noch niemand, diese Rezeptur auszuprobieren.');
INSERT INTO "item_descriptions" VALUES(1504,'en','Billy-Ray Red Neck was renowned throughout the countryside. One day, as he was yodelling at the top of his voice, someone cut off his head, which is why he got the nickname. The dagger was found but nobody looked for the murderer... Billy-Ray was famous for singing out of tune.');
INSERT INTO "item_descriptions" VALUES(1504,'fr','O''Bert cou rouge était célèbre dans la campagne profonde. Un jour où il chantait à tue-tête il fut tué, la tête tranchée. D''où son surnom. La dague coupable fut retrouvée, mais personne ne chercha son propriétaire. O''Bert chantait vraiment trop mal.');
INSERT INTO "item_descriptions" VALUES(1504,'es','Yumbo era un anutrof famoso porque nunca se cambiaba de ropa interior, su olor insoportable hizo que lo expulsaran de la mayor parte de las minas existentes en Amakna. Un día, los del pueblo decidieron atraparlo a la fuerza y forzarlo a lavar sus calzones en el río bajo la amenaza de esta daga.');
INSERT INTO "item_descriptions" VALUES(1504,'pt','O''Bert Pescoço Vermelho era famoso no país. Um dia, como ele estava cantando com toda a sua voz, alguém cortou sua cabeça, o que explica o apelido dele. A adaga do infiltrador foi encontrada, mas ninguém procurou seu proprietário. O''Bert era famoso por cantar desafinado.');
INSERT INTO "item_descriptions" VALUES(1504,'de','O''Bert Rotkehl war im ganzen Umkreis für seinen schrecklichen Gesang berühmt-berüchtigt. Eines Tages, als er wieder einmal aus voller Lautstärke seinen Gesang in die schutzlosen Wälder und Wiesen hinaus-Crâ-kehlte, wurde ihm selbige von einem Unbekannten durchgeschnitten. Daher auch sein Spitzname. Der für den Mord verwendete Dolch wurde schnell wiedergefunden, doch niemand machte sich die Mühe, den Schuldigen ausfindig zu machen. O''Bert sang einfach zu schauderhaft.');
INSERT INTO "item_descriptions" VALUES(1511,'en','According to the legend describing the Dantesque fight after which he was raised to the rank of God himself, Ecaflip used a weapon made by the ancient principle: "a tail for a life". This series of swords was forged as a tribute to him.');
INSERT INTO "item_descriptions" VALUES(1511,'fr','La légende veut qu''Ecaflip, lors du dantesque combat qui l''éleva au rang de dieu, utilisa une arme constituée de ses propres queues, chacune issue de l''une de ses vies.');
INSERT INTO "item_descriptions" VALUES(1511,'es','Cuenta la leyenda que un zurcarák utilizó, durante el dantesco combate que lo elevó al rango de dios, una arma hecha con sus propias colas, cada una correspondía a una de sus vidas.');
INSERT INTO "item_descriptions" VALUES(1511,'pt','De acordo com a lenda descrevendo a luta de Dantesque, depois da qual ele elevou seu grau ao de Deus, o Ecaflip usou uma arma feita depois da idéia-mestra: ‘um rabo por uma vida''. Esta série de espadas foi forjada como um tributo a ele.');
INSERT INTO "item_descriptions" VALUES(1511,'de','Der Legende nach soll Ecaflip im Laufe der epischen Schlacht, die ihm den Rang eines Gottes bescherte, eine Waffe verwendet haben, die aus seinen eigenen Schwänzen bestand. Nämlich einen für jedes Leben, das er besaß.');
INSERT INTO "item_descriptions" VALUES(1559,'en','This ring is in fact an outgrowth of the Soft Oak, uprooted during a storm. It''s yours now – but keep it away from its master, as he could decide to take back what''s his.');
INSERT INTO "item_descriptions" VALUES(1559,'fr','Cet anneau est en fait une excroissance du Chêne Mou, arrachée lors d''une tempête. Maintenant il est à vous, mais évitez de trop l''approcher de son maître, il pourrait décider de se retourner contre vous.');
INSERT INTO "item_descriptions" VALUES(1559,'es','Este anillo era en un principio una excrecencia del Roble Blando que se arrancó durante una tempestad. Ahora es tuyo, pero procura no acercarlo demasiado a su maestro, pues podría volverse contra ti.');
INSERT INTO "item_descriptions" VALUES(1559,'pt','Este anel é uma excrescência do Carvalho Mole, arrancada durante uma tempestade. É seu agora, mas mantenha-o longe do mestre dele, pois ele pode decidir se voltar contra você.');
INSERT INTO "item_descriptions" VALUES(1559,'de','Dieser Ring ist in Wirklichkeit eine Auswucherung des Weich-Eichs, die bei einem Sturm abgerissen wurde. Jetzt gehört er euch, aber haltet ihn lieber von seinem Meister fern, sonst wendet er sich womöglich noch gegen euch.');
INSERT INTO "item_descriptions" VALUES(1574,'en','This sword belonged to the late lamented Kih Besans, known as the Yench Carver. This was his main hobby... Pointless to mention that some people waste their lives.');
INSERT INTO "item_descriptions" VALUES(1574,'fr','Cette épée appartenait au regretté Kih Bésans, dit le découpeur de Yench. C''etait, en effet, sa principale occupation d''amusement. Comme quoi, un rien amuse.');
INSERT INTO "item_descriptions" VALUES(1574,'es','Esta espada pertenecía a Kih Besans (que en paz descanse), llamado el Trinchador de Canes. Pues efectivamente, esa era su principal diversión. Pobres animalitos.');
INSERT INTO "item_descriptions" VALUES(1574,'pt','Esta espada pertenceu ao Kih Besans, conhecido como o escultor Yench. Este era o seu passatempo principal... sem motivo algum, ele começava a rir do nada...');
INSERT INTO "item_descriptions" VALUES(1574,'de','Dieses Schwert gehörte einst dem inzwischen verstorbenen Kih Besans, den man überall nur den Yench-Schnitter nannte. Dies war nämlich seine Lieblingsbeschäftigung. Da sieht man es wieder: Manche Leute kann ein Nichts erfreuen.');
INSERT INTO "item_descriptions" VALUES(1602,'en','This ring allows the Dark Treechnid to be very stylish when it goes dancing. And as life is kind, there are many parties in the Dark Forest.');
INSERT INTO "item_descriptions" VALUES(1602,'fr','Cet anneau permet à l''Abraknyde Sombre, de sortir en soirée tout en étant vraiment très chic. Et comme la vie est bien faite, c''est toujours la soirée dans la Forêt Sombre.');
INSERT INTO "item_descriptions" VALUES(1602,'es','Este anillo le permite al abráknido oscuro salir de marcha nocturna conservando al mismo tiempo un aspecto muy chic. Y como la vida está bien hecha, siempre es de noche en el Bosque Oscuro.');
INSERT INTO "item_descriptions" VALUES(1602,'pt','Este anel deixa o Arvraknídeo Sombrio muito elegante quando ele sai para as suas noitadas. E como a vida é boa, é sempre noite na Floresta Sombria.');
INSERT INTO "item_descriptions" VALUES(1602,'de','Dieser Ring erlaubt es dem Schatten-Astaknyden, abends auszugehen und dabei unheimlich gut auszusehen. Und weil es das Leben so gut mit ihm meint, ist im Düsterwald immer Abend.');
INSERT INTO "item_descriptions" VALUES(1619,'en','The Treemu is an elegant amulet. If you''re planning on putting it on, we advise you not to wear any other clothes, as it makes silk look like the wool off a Gobball''s backside.');
INSERT INTO "item_descriptions" VALUES(1619,'fr','L''Abramu est une amulette très élégante. Si vous avez l''intention de la porter nous vous conseillons de vous promener nu afin de bien mettre en valeur ce précieux bijoux. Vous verrez, les dames n''y résistent pas.');
INSERT INTO "item_descriptions" VALUES(1619,'es','El Abramú es un amuleto muy elegante. Si tienes la intención de ponértelo, te aconsejamos llevarlo desnudo para poner en valor esta preciosa joya. Ya verás, las mujeres no te resistirán.');
INSERT INTO "item_descriptions" VALUES(1619,'pt','O Treemu é um tipo de amuleto refinado. Um pequeno conselho se você pretende usá-lo: dê um pequeno passeio tão nu quanto no dia em que você nasceu para realçar sua preciosa jóia. As damas adorarão, sem sombra de dúvida...');
INSERT INTO "item_descriptions" VALUES(1619,'de','Das Astamu ist ein äußerst elegantes Amulett. Solltet ihr vorhaben, es anzulegen, so raten wir euch dazu, völlig unbekleidet herumzulaufen, damit es so richtig zur Geltung kommt. Ihr werdet sehen: Keine Frau kann da noch widerstehen.');
INSERT INTO "item_descriptions" VALUES(1620,'en','This bow looks as if it were still alive and can almost shoot arrows on its own like a big boy. It could have been the perfect bow for people who are clumsy with their hands but, unfortunately, the arrow always has to be loaded the right way.');
INSERT INTO "item_descriptions" VALUES(1620,'fr','Cet arc semble encore vivant et peut presque tirer des flèches tout seul, comme un grand. Il aurait pu être l''arc idéal des personnes dotées de deux mains gauches, mais malheureusement, il faut toujours encocher la flèche dans le bon sens.');
INSERT INTO "item_descriptions" VALUES(1620,'es','Este arco parece estar vivo todavía y casi puede lanzar flechas sin la ayuda de nadie, como una persona mayor. Hubiese podido ser el arco ideal para las personas que no tienen brazos, pero desafortunadamente, siempre habrá que armar el arco poniendo la flecha en el buen sentido.');
INSERT INTO "item_descriptions" VALUES(1620,'pt','Este arco parece estar vivo e quase pode atirar flechas sozinho como um rapazinho. Pode ser o arco perfeito para as pessoas que são desajeitadas com as mãos mas, infelizmente, a flecha sempre tem que ser encaixada do jeito certo.');
INSERT INTO "item_descriptions" VALUES(1620,'de','Dieser Bogen scheint so richtig lebendig zu sein. Beinahe erwartet man, dass er die Pfeile von allein losschießen wird, ganz wie ein Großer. Er wäre daher ein idealer Bogen für alle Abenteurer mit zwei linken Händen, wenn die Pfeile nicht auch noch richtig herum eingelegt werden müssten....');
INSERT INTO "item_descriptions" VALUES(1621,'en','The Skill Boots increase Agility and Intelligence to the detriment of your Strength and Chance. Contrary to what many people believe, they won''t defeat your opponent for you.');
INSERT INTO "item_descriptions" VALUES(1621,'fr','Les bottes de Maîtrise augmentent l''agilité et l''intelligence de leur lanceur au détriment de la force et de la chance. Contrairement à ce que l''on pourrait croire, elle ne vous permettent pas de maitriser votre adversaire.');
INSERT INTO "item_descriptions" VALUES(1621,'es','Las botas de Dominación aumentan la agilidad y la inteligencia de quien las lleve puestas pero en detrimento de la fuerza y de la suerte. A pesar de lo que se podría pensar, no permiten dominar a tu adversario.');
INSERT INTO "item_descriptions" VALUES(1621,'pt','As Botas de Perícia aumentam a agilidade e a inteligência do usuário, em detrimento da força e da sorte. Ao contrário do que as pessoas acreditam, elas não permitem que você submeta o seu oponente.');
INSERT INTO "item_descriptions" VALUES(1621,'de','Die Stiefel der Meisterschaft erhöhen die Flinkheit und Intelligenz, verringern allerdings die Stärke und das Glück ihres Trägers. Der Name mag allerdings ein wenig missverständlich sein, da diese Stiefel nicht für euch die Gegner meistern werden – dies müßt ihr schon selbst erledigen...');
INSERT INTO "item_descriptions" VALUES(1622,'en','These Power Boots increase Strength and Chance to the detriment of your Intelligence and Agility. Contrary to what many people believe, they won''t bring you incredible power.');
INSERT INTO "item_descriptions" VALUES(1622,'fr','Les bottes de puissance augmentent la force et la chance de leur lanceur au détriment de l''intelligence et de l''agilité. Contrairement à ce que l''on pourrait croire, elle ne confèrent pas à leur porteur, une puissance démente.');
INSERT INTO "item_descriptions" VALUES(1622,'es','Las botas de potencia aumentan la fuerza y la suerte de quien las lleve puestas pero en detrimento de la inteligencia y de la agilidad. A pesar de lo que se podría pensar, no confieren un poder infinito al que las lleva puestas.');
INSERT INTO "item_descriptions" VALUES(1622,'pt','Essas botas de poder aumentam a força do portador e a chance, mas diminuem a inteligência e a agilidade. Ao contrário do que as pessoas acreditam, elas não podem dar um poder incrível.');
INSERT INTO "item_descriptions" VALUES(1622,'de','Die Stiefel der Macht erhöhen die Sträke und das Glück, verringern allerdings die Intelligenz und und die Flinkheit ihres Trägers. Der Name mag allerdings ein wenig missverständlich sein, da diese Stiefel dem Träger nicht gerade viel Macht verleihen...');
INSERT INTO "item_descriptions" VALUES(1623,'en','The Anticipation Boots increase Strength and Agility to the detriment of your Intelligence and Chance. Contrary to what many people believe, these boots do not enable you to anticipate your enemies'' next moves.');
INSERT INTO "item_descriptions" VALUES(1623,'fr','Les bottes d''Anticipation augmentent la force et l''agilité de leur lanceur au détriment de l''intelligence et de la chance. Contrairement à ce que l''on pourrait croire, elles ne vous permettent pas d''anticiper les actions de vos adversaires.');
INSERT INTO "item_descriptions" VALUES(1623,'es','Las botas de Anticipación aumentan la fuerza y la agilidad de quien las lleve puestas pero en detrimento de la inteligencia y de la suerte. A pesar de lo que se podría pensar, no permiten prever las acciones de tus adversarios.');
INSERT INTO "item_descriptions" VALUES(1623,'pt','Estas botas de Antecipação aumentam a sua força e agilidade em detrimento da inteligência e sorte. Ao contrário do que a maioria das pessoas acredita, estas botas não permitem antecipar os movimentos dos seus inimigos.');
INSERT INTO "item_descriptions" VALUES(1623,'de','Die Stiefel der Vorhersehung erhöhen die Stärke und Flinkheit, verringern allerdings die Intelligenz und das Glück ihres Trägers. Der Name mag allerdings ein wenig missverständlich sein, da diese Stiefel nicht fürs Hellsehen oder Vorhersagen vorgesehen sind...');
INSERT INTO "item_descriptions" VALUES(1624,'en','These boots once belonged to the great knight Nexus - the poor bugger was frozen for eternity.');
INSERT INTO "item_descriptions" VALUES(1624,'fr','Ces bottes ont appartenu à Nexus, grand chevalier figé à jamais.');
INSERT INTO "item_descriptions" VALUES(1624,'es','Estas botas han pertenecido a Nexus, un gran caballero que ha sido petrificado para siempre.');
INSERT INTO "item_descriptions" VALUES(1624,'pt','Estas botas pertenceram a Nexus, um grande cavaleiro congelado pela eternidade.');
INSERT INTO "item_descriptions" VALUES(1624,'de','Diese Stiefel gehörten Nexus, dem größten Ritter, der er jemals erstarrte.');
INSERT INTO "item_descriptions" VALUES(1628,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1628,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
INSERT INTO "item_descriptions" VALUES(1628,'es','Este artefacto debe su historia a una leyenda antiquísima, pero hoy ya nadie conoce su poder.');
INSERT INTO "item_descriptions" VALUES(1628,'pt','A história deste artefato vem de uma lenda muito antiga. Mas, hoje em dia, seu verdadeiro poder ainda é desconhecido.');
INSERT INTO "item_descriptions" VALUES(1628,'de','Die Geschichte dieses Artefakt wurde in einer sehr alten Legende mal erwähnt, doch heutzutage kennt niemand mehr seine Kräfte.');
INSERT INTO "item_descriptions" VALUES(1629,'en','The story of this artefact originates from a very ancient legend but its real power is yet to be revealed.');
INSERT INTO "item_descriptions" VALUES(1629,'fr','Cet Artefact doit son histoire à une très ancienne légende, mais aujourd''hui, nul ne connaît son pouvoir.');
