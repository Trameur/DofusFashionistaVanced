#: .\chardata\templates\chardata\changelog_content.html:356
msgid "April 2026"
msgstr "April 2026"

#: .\chardata\templates\chardata\changelog_content.html:359
msgid "Docker support & security fixes"
msgstr "Docker-Unterstützung und Sicherheitskorrekturen"

#: .\chardata\templates\chardata\changelog_content.html:361
msgid "Docker support added for local development; Python upgraded to 3.14"
msgstr ""
"Docker-Unterstützung für lokale Entwicklung hinzugefügt; Python auf 3.14 "
