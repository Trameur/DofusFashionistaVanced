msgstr "No pudimos encontrar la página que buscas."

#: chardata/templates/chardata/404.html:21
#, python-format
msgid ""
"You can go back to the <a href=\"%(home_url)s\">home</a> page instead, or "
"send us a message <a href=\"%(contact_url)s\">here</a> if this keeps "
"happening."
msgstr ""
"Puedes volver a la página de <a href=\"%(home_url)s\">inicio</a>, o "
"enviarnos un mensaje <a href=\"%(contact_url)s\">aquí</a> si el problema "
"continua."

