#: .\chardata\templates\chardata\projdetails.html:103
#, python-format
msgid ""
" You already have a project on %(version)s, and you can find it <a "
"href=\"%(load_proj_link)s\">here</a>. <a href=\"%(login_link)s\">Log in</a> "
"to keep several projects per version. "
